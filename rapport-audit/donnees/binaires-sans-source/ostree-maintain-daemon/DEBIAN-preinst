#!/bin/bash
set -e

CONF_FILE="/ostree/pkgs/system-ovl.conf"
TMP_FILE="/tmp/MaintainMode.txt"

if [ -f $CONF_FILE ];then
    grep -E "^(Mode|NextMode|RealtimeMaintain|MaxCommitNumberInRepo|ShutdownMaxBlockSecond|fontSize|fontColor|fontPos|save_maintain_data)=" "$CONF_FILE" > "$TMP_FILE" || true
fi


