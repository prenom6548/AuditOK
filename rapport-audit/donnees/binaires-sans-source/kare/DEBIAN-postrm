#!/bin/bash

KARE_CUPS_STRING="ServerBin /opt/system/lib/cups"
KARE_CUPS_SHARE_STRING="DataDir /opt/system/resource/cups"
cups_file_conf="/etc/cups/cups-files.conf"

if grep -q "$KARE_CUPS_STRING" "$cups_file_conf"; then
    sed -i "\#^${KARE_CUPS_STRING}\$#d" "$cups_file_conf"
    sed -i "\#^${KARE_CUPS_SHARE_STRING}\$#d" "$cups_file_conf"
    systemctl restart cups.service
fi

