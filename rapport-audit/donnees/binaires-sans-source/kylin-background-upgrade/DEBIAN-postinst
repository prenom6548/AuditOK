#!/bin/bash

DISTROVERSIONPATH="/etc/os-release"
LOCALSILENTTIMER="/var/lib/kylin-background-upgrade/kylin-background-upgrade-silent.timer"

systemctl --global enable kylin-background-upgrade-manul.timer

if grep -q 'PRETTY_NAME="Kylin V11"' "$DISTROVERSIONPATH"; then
    echo "Kylin V11"
else
    cp $LOCALSILENTTIMER /usr/lib/systemd/user/ >/dev/null 2>&1 || true 
    systemctl --global enable kylin-background-upgrade-silent.timer
fi
