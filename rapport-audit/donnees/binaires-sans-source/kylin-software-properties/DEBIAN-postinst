#!/bin/bash

pkill -f /usr/bin/kylin-software-properties-service || true
dbus-send --system --type=method_call --dest=com.kylin.software.properties /com/kylin/software/properties com.kylin.software.properties.interface.restartDbus >/dev/null 2>&1 || true


systemctl daemon-reload || true
systemctl enable kylin-source-update-timer.timer || true

#加白
python3 /usr/share/kylin-update-rescue/add_white.py >/dev/null 2>&1 || true

systemctl enable kylin-update-rescue.timer || true

