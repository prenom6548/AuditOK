#!/bin/bash
# postinst script for kmre to modify docker's daemon.json
#

bip=0
dockerdaemonpath="/etc/docker/daemon.json"
if [[ -f "${dockerdaemonpath}" ]]; then
	if [ `grep -c "bip" ${dockerdaemonpath}` -ne '0' ];then
		bip=1
	fi
fi

if [ ${bip} -eq 0 ];then
	: > ${dockerdaemonpath}
	echo "{" >> ${dockerdaemonpath}
	echo "    \"bip\": \"128.128.0.1/16\"" >> ${dockerdaemonpath}
	echo "}" >> ${dockerdaemonpath}
fi

exit 0
