#!/bin/bash
packageName=app.web.openkylincommunity
shellKey=.sh
for file in `ls /home/`
do
    if [ -d /home/${file}/Desktop ]
    then
        cp -f /usr/share/applications/${packageName}.desktop  /home/${file}/Desktop/
        chmod +x /home/${file}/Desktop/${packageName}.desktop
        chown ${file}:${file} /home/${file}/Desktop/${packageName}.desktop
    fi

    if [ -d /home/${file}/桌面 ]
    then
        cp -f /usr/share/applications/${packageName}.desktop  /home/${file}/桌面/
        chmod +x /home/${file}/桌面/${packageName}.desktop
        chown ${file}:${file} /home/${file}/桌面/${packageName}.desktop
    fi
done

