#!/bin/bash

# clean runtime data
for I in /home/*; do
    THISUSER=`echo $I | cut -d "/" -f 3 -`
    USERID=`id -u $THISUSER 2>/dev/null || echo "_FALSE_"`
    if [ $USERID = '_FALSE_' ] ; then
        continue
    fi

    DIST_DIR=$I/.audit

    if [ -d $DIST_DIR ]; then
        rm -rf $DIST_DIR
    fi

done

if pgrep audit-srv; then
    systemctl stop xadl.service
fi

exit 0
