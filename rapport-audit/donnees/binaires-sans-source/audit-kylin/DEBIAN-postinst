#! /bin/bash


incrase_inotify() {
    line="fs.inotify.max_user_watches=524288"
    config_file=/etc/sysctl.conf

    if [[ $EUID -ne 0 ]];then
    echo 'this script need run with root priviledge'
    exit 1
    fi

    v=$(sysctl -n fs.inotify.max_user_watches)
    if [[ $v -ne 524288 ]];then
    echo fs.inotify.max_user_watches=524288 | sudo tee -a $config_file && sudo sysctl -p
    else
        echo 'already configured'
    fi
}


if [[ -f /opt/audit/audit-srv ]]; then
  incrase_inotify
  systemctl enable xadl
  systemctl start xadl
fi