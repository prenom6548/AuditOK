#!/bin/bash

set -e

systemctl --global enable kylin-software-center-plugin-preprocessing.service &> /dev/null || true
rm -f /etc/systemd/user/default.target.wants/kylin-software-center-plugin-preprocessing.service &> /dev/null || true
pkill -f -9  /usr/bin/kylin-software-center-plugin-preprocessing &> /dev/null || true
pkill -f -9 /usr/share/kylin-software-center-plugin-preprocessing/startDbus.py &> /dev/null || true
chmod 775 /usr/share/kylin-software-center-plugin-preprocessing/startDbus.py
chmod 775 /usr/share/kylin-software-center-plugin-preprocessing/kylin-software-center-plugin-preprocessing.py



exit 0
