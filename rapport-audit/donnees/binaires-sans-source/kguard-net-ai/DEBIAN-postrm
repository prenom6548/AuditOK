#!/bin/bash

set -e

case "$1" in
    purge)
        # stop service
        systemctl stop kguard_net_ai.service || true
        # disable service
	systemctl disable kguard_net_ai.service || true
        # del kguard_ai
	pip uninstall -y onnxruntime
        rm -rf /usr/lib/kguard_net_ai
	rm -rf /var/log/ai-netdetect.log
	
        ;;
    remove)
        # stop service
        systemctl stop kguard_net_ai.service || true
        # systemctl disable kguard
        systemctl disable kguard_net_ai.service || true
	pip uninstall -y onnxruntime
	rm -rf /var/log/ai-netdetect.log
	rm -rf /usr/lib/kguard_net_ai
	
        ;;
esac

exit 0


