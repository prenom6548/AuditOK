#!/bin/bash

#set -e

#pip install /usr/lib/kguard_net_ai/onnxruntime_amd/onnxruntime-1.16.3-cp38-cp38-manylinux_2_17_x86_64.manylinux2014_x86_64.whl --no-deps

#echo "onnxruntime whl successfully install"

set -e

# 获取目标架构
ARCHITECTURE=$(dpkg --print-architecture)

echo "current arch : $ARCHITECTURE"

# 根据架构选择对应的 onnxruntime whl 文件
if [ "$ARCHITECTURE" = "amd64" ]; then
    WHL_FILE="/usr/lib/kguard_net_ai/whl/onnxruntime-1.16.3-cp38-cp38-manylinux_2_17_x86_64.manylinux2014_x86_64.whl"
elif [ "$ARCHITECTURE" = "arm64" ]; then
    WHL_FILE="/usr/lib/kguard_net_ai/whl/onnxruntime-1.16.3-cp38-cp38-manylinux_2_17_aarch64.manylinux2014_aarch64.whl"
else
    echo "Unsupported architecture: $ARCHITECTURE"
    exit 1
fi

echo "$WHL_FILE"
# 安装对应的 onnxruntime whl 文件
pip install "$WHL_FILE" --no-deps

echo "onnxruntime whl for $ARCHITECTURE successfully installed"
systemctl daemon-reload
kysec_set -n exectl -v kysoft /usr/lib/kguard_net_ai/kguard_inference
