#!/bin/bash


case "${1}" in
    configure)
	glib-compile-schemas /opt/system/resource/glib-2.0/schemas/
        ln -sf /opt/system/bin/startapp /usr/bin/startapp
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`${1}'" >&2
        exit 1
        ;;
esac
