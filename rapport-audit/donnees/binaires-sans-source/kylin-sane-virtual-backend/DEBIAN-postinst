DLL_CONF="/etc/sane.d/dll.conf"

# 检查 sane-utils 是否安装（dll.conf 的提供者）
if ! dpkg -s sane-utils >/dev/null 2>&1; then
    echo "警告：依赖包 sane-utils 未安装，无法处理 ${DLL_CONF}" >&2
    exit 0  # 非错误退出，避免阻断依赖安装
fi

# 确保文件存在（sane-utils 应提供，但做双重保险）
if [ ! -f "${DLL_CONF}" ]; then
    echo "错误：${DLL_CONF} 不存在，可能是 sane-utils 安装不完整" >&2
    exit 1  # 此时说明依赖有问题，应报错
fi

# 仅在首次安装时备份（升级时不覆盖原始备份）
if [ "$1" = "configure" ] && [ -z "$2" ]; then
    if [ ! -f "${DLL_CONF}.orig" ]; then
        cp -a "${DLL_CONF}" "${DLL_CONF}.orig"
    fi
fi

# 处理后端注释
for backend in $BACKENDS; do
    # 转义特殊字符（如正则元字符）
    safe_backend=$(printf '%s' "$backend" | sed 's/[][\/.^$*+?]/\\&/g')
    # 使用 sed 原子操作避免文件锁定问题
    sed -i -e "/^##*${safe_backend}$/s/^##*/#/" \
           -e "/^${safe_backend}$/s/^/#/" "${DLL_CONF}"
done

db_stop || true

exit 0
