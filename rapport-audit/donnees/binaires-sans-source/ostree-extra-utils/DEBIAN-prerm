#!/bin/sh
# prerm script for ostree-extra-utils
#
set -e

case "$1" in
    remove|deconfigure)
        # 在移除或解配置时，删除配置文件
        # 因为包被移除时，配置文件也应该被移除
        HOOK_CONFIG="/etc/dpkg/dpkg.cfg.d/ostree-guard"
        if [ -f "$HOOK_CONFIG" ]; then
            rm -f "$HOOK_CONFIG"
        fi
        ;;
    upgrade|failed-upgrade)
        # 在升级时，不删除配置文件
        # 新包会重新安装配置文件，如果此处删除，dpkg 会认为管理员删除了它，升级后不会恢复
        ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0

