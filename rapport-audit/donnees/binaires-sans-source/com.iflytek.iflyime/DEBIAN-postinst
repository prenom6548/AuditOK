#!/bin/bash

# 遍历 /home 目录中的所有用户
for user_dir in /home/*; do
    # 如果该路径是一个目录
    if [ -d "$user_dir" ]; then
        # 删除英文桌面路径的 iflyime-setting-wizard.desktop 文件
        rm -f "$user_dir/Desktop/iflyime-setting-wizard.desktop"
        
        # 删除中文桌面路径的 iflyime-setting-wizard.desktop 文件
        rm -f "$user_dir/桌面/iflyime-setting-wizard.desktop"
    fi
done

