#!/bin/bash

rm /etc/apt/apt.conf.d/00recommends
rm /etc/apt/apt.conf.d/00secure

rm /etc/apt/sources.list

rm -rf /etc/apt/sources.list.d/kylin.list
rm -rf /etc/apt/sources.list.d/*
rm -rf /etc/apt/preferences.d/*

mkdir -p /etc/apt/preferences.d/
mkdir -p /etc/apt/sources.list.d/

cat > /etc/apt/sources.list.d/openkylin.sources <<EOF
# Modernized from /etc/apt/sources.list
Types: deb
URIs: http://archive.build.openkylin.top/openkylin/
Suites: huanghe
Components: main cross pty
Signed-By: /usr/share/keyrings/openkylin-archive-keyring.gpg

# Modernized from /etc/apt/sources.list
Types: deb
URIs: http://archive.build.openkylin.top/openkylin/
Suites: huanghe-security
Components: main cross pty
Signed-By: /usr/share/keyrings/openkylin-archive-keyring.gpg

# Modernized from /etc/apt/sources.list
Types: deb
URIs: http://archive.build.openkylin.top/openkylin/
Suites: huanghe-updates
Components: main cross pty
Signed-By: /usr/share/keyrings/openkylin-archive-keyring.gpg
EOF

cat > /etc/apt/sources.list.d/openkylin-anything.sources  <<EOF
Types: deb
URIs: http://ppa.build.openkylin.top/kylinsoft/anything3.0/openkylin/
Suites: huanghe
Components: main
Signed-By: /usr/share/keyrings/openkylin-archive-anything-keyring.gpg
EOF

cat > /etc/apt/sources.list.d/openkylin-software.sources  <<EOF
Types: deb
URIs: http://software.openkylin.top/openkylin/
Suites: huanghe
Components: main all
Signed-By: /usr/share/keyrings/openkylin-archive-keyring.gpg
EOF


for tmpkernel in $(ls /lib/modules/)
do
  echo "=== $tmpkernel"
   mkinitramfs -o /boot/initrd.img-${tmpkernel} $tmpkernel
done

#n卡处理
has_nvidia=$(lspci | grep NVIDIA)
if [ -n "${has_nvidia}" ];then
    dpkg  -i  /opt/nvidia/nvidia-*.deb
    rm /opt/third -rf
fi
