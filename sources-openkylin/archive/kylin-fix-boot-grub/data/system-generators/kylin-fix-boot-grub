#!/bin/sh
set -e
[ ! -e /run/kylin-fix-boot-grub.resume ]
normaldir=$1
earlydir=$2
latedir=$3
set -- $(cat /proc/cmdline)
for cmdline_arg in "$@"; do
        if [ "$cmdline_arg" = "recovery" ]
        then
                ln -sf /lib/systemd/system/kylin-fix-boot-grub.target $earlydir/default.target
                break
        fi
done
