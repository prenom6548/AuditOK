From: Dmitry Shachnev <mitya57@debian.org>
Date: Sat, 16 Jul 2022 10:42:46 +0800
Subject: reduce compiler memory consumption on mipsel

Forwarded: no
Last-Update: 2021-03-30
---
 src/3rdparty/chromium/content/browser/BUILD.gn                        | 4 ++++
 .../chromium/third_party/blink/renderer/bindings/modules/v8/BUILD.gn  | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/src/3rdparty/chromium/content/browser/BUILD.gn b/src/3rdparty/chromium/content/browser/BUILD.gn
index 1466f33..fb0fb97 100644
--- a/src/3rdparty/chromium/content/browser/BUILD.gn
+++ b/src/3rdparty/chromium/content/browser/BUILD.gn
@@ -2213,6 +2213,10 @@ jumbo_static_library("browser") {
       "//services/video_capture/public/uma",
       "//third_party/webrtc_overrides:webrtc_component",
     ]
+
+    if (target_cpu == "mipsel") {
+      cflags = [ "--param=ggc-min-expand=20" ]
+    }
   }
 
   # Desktop/Window/WebContents screen capture implementations, conditionally
diff --git a/src/3rdparty/chromium/third_party/blink/renderer/bindings/modules/v8/BUILD.gn b/src/3rdparty/chromium/third_party/blink/renderer/bindings/modules/v8/BUILD.gn
index f6fefc9..94bc69e 100644
--- a/src/3rdparty/chromium/third_party/blink/renderer/bindings/modules/v8/BUILD.gn
+++ b/src/3rdparty/chromium/third_party/blink/renderer/bindings/modules/v8/BUILD.gn
@@ -35,6 +35,10 @@ blink_modules_sources("v8") {
     "//third_party/blink/renderer/platform",
     "//v8",
   ]
+
+  if (target_cpu == "mipsel") {
+    cflags = [ "--param=ggc-min-expand=20" ]
+  }
 }
 
 jumbo_source_set("testing") {
