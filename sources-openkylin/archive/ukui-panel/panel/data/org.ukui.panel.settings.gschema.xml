<schemalist gettext-domain="ukui-panel">
    <schema id="org.ukui.panel.settings"  path="/org/ukui/panel/settings/">
        <key name="panelsize" type="i">
            <default>46</default>
            <summary>panelsize</summary>
            <description>the size of UKUI Panel</description>
        </key>
        <key name="panelposition" type="i">
            <default>0</default>
            <summary>PanelPosition</summary>
            <description>The Position of ukui-panel</description>
        </key>
        <key name="hidepanel" type="b">
            <default>false</default>
            <summary>If taskbar needs to hide</summary>
            <description>If taskbar needs to hide</description>
        </key>
        <key name="lockpanel" type="b">
            <default>false</default>
            <summary>If taskbar needs to lock</summary>
            <description>If taskbar needs to lock</description>
        </key>
        <key name="panellength" type="a{sv}">
            <default>[]</default>
            <summary>PanelLength</summary>
            <description>The Length of ukui-panel</description>
        </key>
        <key name="paneltype" type="i">
            <default>0</default>
            <range min="0" max="1"/>
            <summary>PanelType</summary>
            <description>The Type of ukui-panel</description>
        </key>
        <key name="dataislandposition" type="i">
            <default>0</default>
            <range min="0" max="1"/>
            <summary>The Position of DataIsland</summary>
            <description>The Position of DataIsland</description>
        </key>
        <key name="settingsislandposition" type="i">
            <default>0</default>
            <range min="0" max="1"/>
            <summary>The Position of SettingsIsland</summary>
            <description>The Position of SettingsIsland</description>
        </key>
        <key name="topbarsize" type="i">
            <default>32</default>
            <summary>The Size of TopBar</summary>
            <description>The Size of TopBar</description>
        </key>
    </schema>
</schemalist>
