#!/usr/bin/python3
# -*- coding: UTF-8 -*-

import gettext
gettext.bindtextdomain('RevisionsManager', '/usr/share/locale')
gettext.textdomain('RevisionsManager')

import signal
import os
import sys
import logging
from gettext import gettext as _
from dbus.mainloop.glib import DBusGMainLoop
DBusGMainLoop(set_as_default=True)

from RevisionsManager.Core.RMLog import RMLog
from RevisionsManager.RevisionsManager import RevisionsManager


LANGZH_LIST = ["zh_CN", "zh_CN:en", "zh_CN:zh", "zh_CN.UTF-8"]
LANGEN_LIST = ["en", "en_US", "en_US.UTF-8"]

def signal_handler_term(signal, frame):
    logging.warning("signal %d received, will stop", signal)
    app.quit()

if __name__ == "__main__":
    if os.getuid() != 0:
        print(_("You need to be root to run this application"))
        sys.exit(1)

    #1-language
    #当不存在语言变量时 默认显示中文
    if not "LANGUAGE" in os.environ:
        os.environ["LANGUAGE"] = "zh_CN"
    if not "LANG" in os.environ:
        os.environ["LANG"] = "zh_CN"

    #做一些规范处理
    if os.environ["LANGUAGE"] in LANGEN_LIST:
        os.environ["LANGUAGE"] = "en_US"
    if os.environ["LANGUAGE"] in LANGZH_LIST:
        os.environ["LANGUAGE"] = "zh_CN"

    #2-signal
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    signal.signal(signal.SIGINT,signal_handler_term)

    #3-LOG init
    RMLog()
    logging.info('RevisionsManager(lang:%s) starting ...',os.environ["LANGUAGE"])

    #4-main
    app = RevisionsManager()
    app.run()
