#!/bin/bash

set -e

echo "15setup-sourcelist start"
fifoName="15setup-sourcelist-fifo"
if [ ! -e ${fifoName} ]; then
    mkfifo -m 666 ${fifoName}
fi
exec 6<>${fifoName}
echo "0" >&6


[ -d /cdrom/pool ] || \
    return 0

sed -i "s/^/#/g" /etc/apt/sources.list

CODENAME=$(ls -l /cdrom/dists | awk '/^d/{print $NF}')
echo "deb file:/cdrom ${CODENAME} main" >>/etc/apt/sources.list

echo "10" >&6

# todo, set timeout
apt-get update --allow-insecure-repositories -y

echo "100" >&6
exec 6<&-
rm -f ${fifoName}

echo "success"
