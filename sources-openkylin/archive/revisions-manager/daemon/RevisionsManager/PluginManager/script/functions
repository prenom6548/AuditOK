# -*- shell-script -*-
# 1-日志函数

export _logLevel=0

_log_msg()
{
	time=$(date +%Y/%m/%d-%H:%M:%S)
	printf "["$time"]"" $@"
}



LOG_DBG()
{
	_log_msg "[D] %s\\n" "$*"
}

LOG_INFO()
{
	if [ $_logLevel -lt 1 ];then
		return
	fi
	_log_msg "[I] %s\\n" "$*"
}

LOG_NOTIFY()
{
	if [ $_logLevel -lt 2 ];then
		return
	fi
	_log_msg "[N] %s\\n" "$*"
}

LOG_WARNING()
{
	if [ $_logLevel -lt 3 ];then
		return
	fi
	_log_msg "[W] %s\\n" "$*"
}

LOG_ERR()
{
	if [ $_logLevel -lt 4 ];then
		return
	fi
	_log_msg "[E] %s\\n" "$*"
}

LOG_CRITICAL()
{
	if [ $_logLevel -lt 5 ];then
		return
	fi
	_log_msg "[C] %s\\n" "$*"
}

set_logLevel()
{
	_logLevel=$1
	LOG_DBG $_logLevel
}



# 2-错误码
ERR_COM_MOD=1000
ERR_COM_INVALID_PARAM=$(($ERR_COM_MOD + 1))


ERR_FILE_MOD=2000
ERR_FILE_NOT_EXIST=$(($ERR_FILE_MOD + 1))
ERR_FILE_EXISTED=$(($ERR_FILE_NOT_EXIST + 1))
ERR_FILE_NO_RW_PERMISSION=$(($ERR_FILE_EXISTED + 1))
ERR_FILE_NO_X_PERMISSION=$(($ERR_FILE_NO_RW_PERMISSION + 1))
ERR_FILE_OPEN_ERR=$(($ERR_FILE_NO_X_PERMISSION + 1))
ERR_FILE_WRITE_ERR=$(($ERR_FILE_OPEN_ERR + 1))

