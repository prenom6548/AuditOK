#!/bin/sh

set -e

if [ ! -e /usr/bin/dpkg-repack ];then
    cp /usr/share/revisions-manager/RevisionsManager/scripts/dpkg-repack /usr/bin/
fi


systemctl enable RevisionsManager.service
systemctl enable RevisionsManagerSupplement.service

systemctl --system daemon-reload >/dev/null || true
if [ -n "$2" ]; then
    _dh_action=restart
else
    _dh_action=start
fi

deb-systemd-invoke $_dh_action 'RevisionsManager.service' >/dev/null || true

