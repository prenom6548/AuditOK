 util/grub-mkconfig_lib.in | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/util/grub-mkconfig_lib.in b/util/grub-mkconfig_lib.in
index 3d68ddd..1a265cb 100644
--- a/util/grub-mkconfig_lib.in
+++ b/util/grub-mkconfig_lib.in
@@ -33,6 +33,10 @@ fi
 if test "x$grub_mkrelpath" = x; then
   grub_mkrelpath="${bindir}/@grub_mkrelpath@"
 fi
+if test "x$grub_ostree_mkrelpath" = x; then
+  grub_ostree_mkrelpath="${sbindir}/grub-ostree-mkrelpath"
+fi
+
 
 if command -v gettext >/dev/null; then
   :
@@ -49,7 +53,12 @@ grub_warn ()
 
 make_system_path_relative_to_its_root ()
 {
-  "${grub_mkrelpath}" "$1"
+  if ischroot && test -e "/ostree" ; then
+    "${grub_ostree_mkrelpath}" "$1"
+    grub_warn "update ostree configure in chroot"
+  else
+    "${grub_mkrelpath}" "$1"
+  fi
 }
 
 is_path_readable_by_grub ()
