-					      grub_size_t align,
-					      grub_err_t *err)
-{
-  grub_relocator_chunk_t ch;
-
-  *err = grub_relocator_alloc_chunk_align (relocator, &ch,
-					  0x1000, (0xffffffff - size) + 1,
-					  size, align,
-					  GRUB_RELOCATOR_PREFERENCE_LOW, 0);
