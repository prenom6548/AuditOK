-static void
-find_bits (unsigned long mask, grub_efi_uint8_t *pos, grub_efi_uint8_t *size)
-{
-  grub_efi_uint8_t first, len;
-
-  first = 0;
-  len = 0;
-
-  if (mask)
-    {
-      while (!(mask & 0x1))
-        {
-    mask = mask >> 1;
-    first++;
-        }
-
-      while (mask & 0x1)
-        {
-    mask = mask >> 1;
-    len++;
-        }
-    }
-
-  *pos = first;
-  *size = len;
-}
