#: workspace.cpp:1443
#, kde-format
msgctxt "Introductory text shown in the support information."
msgid ""
"KWin Support Information:\n"
"The following information should be used when requesting support on e.g. "
"https://forum.kde.org.\n"
"It provides information about the currently running instance, which options "
"are used,\n"
"what OpenGL driver and which effects are running.\n"
"Please post the information provided underneath this introductory text to a "
"paste bin service\n"
"like https://paste.kde.org instead of pasting into support threads.\n"
msgstr ""
"KWin قولداۋ حابارى:\n"
"تومەندەگٸ ينفورماتسايالاردا قولداۋدى تالاپ ىستەۋگە ٸستەتٸلۋٸ كەرەك، ماسەلەن "
"https :// forum. kde. org دا قولداۋدى تالاپ ەتۋ.\n"
"ول كەزەكتەگى اتقار قىلىنىپ جاتقان امالي مىساللارنىڭ ولچۇرىنى قامدادٸ، قايسى "
"تالدانبالار ئىشلىتىلگەنلىكىنىمۇ ٶز ىشىنە الادٸ،\n"
"قازىر قانداق OpenGL قوزعالتۋ اسبابى ٸستەتٸپ جاتٸر، قايسى ەرەكشە ونٸملەر "
"ٸستەتٸپ جاتٸر.\n"
"نۇ جازبانىڭ استىداعى ينفورماتسىيالاردى شاپتاۋ تاقتاسى مۇلازىمىتىگە جابىستر،\n"
"ماسەلەن https://paste.kde.org، قولداۋدى تالاپ ىستەيتىن جازباعا بىرباستا "
"چاپلىماڭ.\n"
