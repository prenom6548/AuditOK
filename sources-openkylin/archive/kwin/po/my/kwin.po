#: helpers/killer/killer.cpp:81
#, kde-format
msgctxt "@info"
msgid "<b>Application \"%1\" is not responding</b>"
msgstr "<b>Application \"%1\" မှာ တုံ့ပြန်မှုမရှိပါ</b>"

#: helpers/killer/killer.cpp:83
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>You tried to close window \"%1\" from application \"%2\" (Process ID: "
"%3) but the application is not responding.</para>"
msgstr ""
"<para>သင်သည် အပလီကေးရှင်း “%2” ၏ ဝင်းဒိုး “%1” (လုပ်ဆောင်မှုအိုင်ဒီ - %3) ကို"
" ပိတ်ရန်ကြိုးပမ်းနေပါသည်၊ သို့ရာတွင် ပရိုဂရမ်သည် တုံ့ပြန်မှုမပြပါ။</para>"

#: helpers/killer/killer.cpp:85
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>You tried to close window \"%1\" from application \"%2\" (Process ID: "
"%3), running on host \"%4\", but the application is not responding.</para>"
msgstr ""
"<para>သင်သည် host \"%4\" တွင် running နေသော application \"%2\" ၏ ဝင်းဒိုး \"%"
"1\" (process ID: %3) ကို ပိတ်ရန်ကြိုးပမ်းနေပါသည်၊ သို့ရာတွင် ထို program သည် "
"တုံ့ပြန်မှုမရှိပါ။</para>"

#: helpers/killer/killer.cpp:88
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>Do you want to terminate this application?</"
"para><para><warning>Terminating the application will close all of its child "
"windows. Any unsaved data will be lost.</warning></para>"
msgstr ""
"<para>ဤပရိုဂရမ်ကို အဓိကအားဖြင့် "
"ပိတ်လိုပါသလား။</para><para><warning>ပရိုဂရမ်ကို အဓိကအားဖြင့် ပိတ်ခြင်းသည် "
"၎င်း၏ ဝင်းဒိုးများအားလုံးကို ပိတ်မည်ဖြစ်ပြီး မသိမ်းဆည်းထားသည့် "
"ဒေတာများအားလုံး ဆုံးရှုံးသွားမည်ဖြစ်သည်။</warning></para>"

