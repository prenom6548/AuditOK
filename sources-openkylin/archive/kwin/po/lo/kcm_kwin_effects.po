msgstr "ສະແດງ/ເຊື່ອງວີດີໂອຕົວຢ່າງຂອງລັກສະນະ"

#: package/contents/ui/Effect.qml:128
#, kde-format
msgctxt "@info:tooltip"
msgid "Configure..."
msgstr "ກຳນົດຄ່າ..."

#: package/contents/ui/main.qml:20
#, kde-format
msgid "This module lets you configure desktop effects."
msgstr "ທ່ານສາມາດກຳນົດຄ່າລັກສະນະຂອງເດັສທັອບໄດ້ໃນໂມດູນນີ້."

#: package/contents/ui/main.qml:27
#, kde-format
msgid ""
"Hint: To find out or configure how to activate an effect, look at the "
"effect's settings."
msgstr ""
"ຄຳແນະນຳ: ເພື່ອຮູ້ຂໍ້ມູນເພີ່ມເຕີມ ຫຼື ກຳນົດຄ່າວິທີການເຮັດວຽກຂອງລັກສະນະ, "
"ກະລຸນາເລືອກລັກສະນະໜຶ່ງແລ້ວຄລິກປຸ່ມກຳນົດຄ່າທາງຂວາຂອງລາຍການ."

#: package/contents/ui/main.qml:47
#, kde-format
msgid "Configure Filter"
msgstr "ເງື່ອນໄຂການກັ່ນຕອງ"

#: package/contents/ui/main.qml:59
#, kde-format
msgid "Exclude unsupported effects"
msgstr "ຍົກເວັ້ນລັກສະນະທີ່ບໍ່ຮອງຮັບ"

#: package/contents/ui/main.qml:67
#, kde-format
msgid "Exclude internal effects"
msgstr "ຍົກເວັ້ນລັກສະນະທີ່ມີຢູ່ແລ້ວ"

#: package/contents/ui/main.qml:125
#, kde-format
msgid "Get New Desktop Effects..."
msgstr "ດາວໂຫຼດລັກສະນະເດັສທັອບໃໝ່..."
