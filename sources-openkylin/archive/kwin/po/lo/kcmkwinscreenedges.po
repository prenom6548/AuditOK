#: main.cpp:118 touch.cpp:116
#, kde-format
msgid "No Action"
msgstr "ບໍ່ມີການເຮັດວຽກ"

#: main.cpp:119 touch.cpp:117
#, kde-format
msgid "Show Desktop"
msgstr "ສະແດງພື້ນທີ່ເຮັດວຽກ"

#: main.cpp:120 touch.cpp:118
#, kde-format
msgid "Lock Screen"
msgstr "ລັອກຈໍ"

#: main.cpp:121 touch.cpp:119
#, kde-format
msgid "Show KRunner"
msgstr "ສະແດງ KRunner"

#: main.cpp:122 touch.cpp:120
#, kde-format
msgid "Activity Manager"
msgstr "ຕົວຈັດການກິດຈະກຳ"

#: main.cpp:123 touch.cpp:121
#, kde-format
msgid "Application Launcher"
msgstr "ຕົວເລີ່ມໂປຣແກຣມ"

#: main.cpp:127 touch.cpp:125
#, kde-format
msgid "Present Windows"
msgstr "ຈັດຫນ້າຕ່າງໃຫ້ຢູ່ໃນແບບແຜ່ນ"

#: main.cpp:128 touch.cpp:126
#, kde-format
msgid "%1 - All Desktops"
msgstr "%1 - ທຸກພື້ນທີ່ເຮັດວຽກ"

#: main.cpp:129 touch.cpp:127
#, kde-format
msgid "%1 - Current Desktop"
msgstr "%1 - ພື້ນທີ່ເຮັດວຽກປັດຈຸບັນ"

#: main.cpp:130 touch.cpp:128
#, kde-format
msgid "%1 - Current Application"
msgstr "%1 - ໂປຣແກຣມປັດຈຸບັນ"

#: main.cpp:131 touch.cpp:129
#, kde-format
msgid "Desktop Grid"
msgstr "ແຜ່ນພື້ນທີ່ເຮັດວຽກທີ່ບໍ່ແທ້ຈິງ"

#: main.cpp:133 touch.cpp:131
#, kde-format
msgid "Toggle window switching"
msgstr "ເຮັດໃຫ້ຫນ້າຕ່າງສະໄລ໌"

#: main.cpp:134 touch.cpp:132
#, kde-format
msgid "Toggle alternative window switching"
msgstr "ເຮັດໃຫ້ຫນ້າຕ່າງສະໄລ໌ເປັນທາງເລືອກ"

#: main.cpp:136 touch.cpp:134
#, kde-format
msgid "Toggle Overview"
msgstr "ສະແດງ/ເຊື່ອງມຸມມອງພື້ນທີ່ເຮັດວຽກທັງໝົດ"

#. i18n: ectx: property (text), widget (QLabel, infoLabel)
#: main.ui:23
#, kde-format
msgid ""
"You can trigger an action by pushing the mouse cursor against the "
"corresponding screen edge or corner."
msgstr ""
"ທ່ານສາມາດຍ້າຍຕົວຊີ້ຂອງເມົ້າໄປທີ່ແຄມຂອງຈໍ ຫຼື "
"ມຸມສີ່ຂອງຈໍເພື່ອເຮັດວຽກທີ່ກຳນົດໄວ້."

#. i18n: ectx: property (text), widget (QLabel, quickMaximizeLabel)
#: main.ui:67
#, kde-format
msgid "&Maximize:"
msgstr "ຂະຫຍາຍໃຫ້ເຕັມຈໍ (&M):"

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_ElectricBorderMaximize)
#: main.ui:77
#, kde-format
msgid "Windows dragged to top edge"
msgstr "ລາກຫນ້າຕ່າງໄປທີ່ແຄມເທິງຂອງຈໍ"

#. i18n: ectx: property (text), widget (QLabel, quickTileLabel)
#: main.ui:84
#, kde-format
msgid "&Tile:"
msgstr "ຈັດແບບແຜ່ນຂ້າງຄຽງກັນ (&T):"

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_ElectricBorderTiling)
#: main.ui:94
#, kde-format
msgid "Windows dragged to left or right edge"
msgstr "ລາກຫນ້າຕ່າງໄປທີ່ແຄມຊ້າຍ/ຂວາຂອງຈໍ"

#. i18n: ectx: property (text), widget (QLabel, electricBorderCornerRatioLabel)
#: main.ui:101
#, kde-format
msgid "Trigger &quarter tiling in:"
msgstr "ຈັດແບບແຜ່ນສີ່ແສນ (&Q):"

#. i18n: ectx: property (suffix), widget (QSpinBox, electricBorderCornerRatioSpin)
#: main.ui:116
#, no-c-format, kde-format
msgid "%"
msgstr ""

#. i18n: ectx: property (prefix), widget (QSpinBox, electricBorderCornerRatioSpin)
#: main.ui:119
#, kde-format
msgid "Outer "
msgstr "ຈາກຈຸດກາງ "

#. i18n: ectx: property (text), widget (QLabel, label_1)
#: main.ui:135
#, kde-format
msgid "of the screen"
msgstr "ເຮັດວຽກຫຼັງຈາກຄວາມສູງຂອງຈໍ"

#. i18n: ectx: property (toolTip), widget (QLabel, desktopSwitchLabel)
#: main.ui:144
#, kde-format
msgid ""
"Change desktop when the mouse cursor is pushed against the edge of the screen"
msgstr "ການຍ້າຍພື້ນທີ່ເຮັດວຽກໂດຍການຍ້າຍຕົວຊີ້ຂອງເມົ້າໄປທີ່ແຄມຂອງຈໍ"

#. i18n: ectx: property (text), widget (QLabel, desktopSwitchLabel)
#: main.ui:147
#, kde-format
msgid "&Switch desktop on edge:"
msgstr "ການປ່ຽນພື້ນທີ່ເຮັດວຽກເມື່ອຕົວຊີ້ຂອງເມົ້າຢູ່ໃກ້ກັບແຄມຂອງຈໍ (&S):"

#. i18n: ectx: property (text), item, widget (KComboBox, kcfg_ElectricBorders)
#: main.ui:158
#, kde-format
msgctxt "Switch desktop on edge"
msgid "Disabled"
msgstr "ຖືກປິດໃຊ້ງານ"

#. i18n: ectx: property (text), item, widget (KComboBox, kcfg_ElectricBorders)
#: main.ui:163
#, kde-format
msgid "Only When Moving Windows"
msgstr "ໃນຂະນະທີ່ຍ້າຍຫນ້າຕ່າງເທົ່ານັ້ນ"

#. i18n: ectx: property (text), item, widget (KComboBox, kcfg_ElectricBorders)
#: main.ui:168
#, kde-format
msgid "Always Enabled"
msgstr "ໃຊ້ງານຕະຫຼອດເວລາ"

#. i18n: ectx: property (toolTip), widget (QLabel, activationDelayLabel)
#: main.ui:176
#, kde-format
msgid ""
"Amount of time required for the mouse cursor to be pushed against the edge "
"of the screen before the action is triggered"
msgstr "ເວລາລໍຖ້າກ່ອນທີ່ຈະເຮັດວຽກຫຼັງຈາກທີ່ຕົວຊີ້ຂອງເມົ້າຖືກຍ້າຍໄປທີ່ແຄມຂອງຈໍ"

#. i18n: ectx: property (text), widget (QLabel, activationDelayLabel)
#: main.ui:179
#, kde-format
msgid "Activation &delay:"
msgstr "ຄວາມຊ້າໃນການເຮັດວຽກ (&D):"

#. i18n: ectx: property (suffix), widget (QSpinBox, kcfg_ElectricBorderDelay)
#. i18n: ectx: property (suffix), widget (QSpinBox, kcfg_ElectricBorderCooldown)
#: main.ui:189 main.ui:224
#, kde-format
msgid " ms"
msgstr " ມິນລິວິນາທີ"

#. i18n: ectx: property (toolTip), widget (QLabel, triggerCooldownLabel)
#: main.ui:208
#, kde-format
msgid ""
"Amount of time required after triggering an action until the next trigger "
"can occur"
msgstr "ເວລາລໍຖ້າກ່ອນທີ່ຈະເຮັດວຽກຕໍ່ໄປຫຼັງຈາກທີ່ໄດ້ເຮັດວຽກແລ້ວ"

#. i18n: ectx: property (text), widget (QLabel, triggerCooldownLabel)
#: main.ui:211
#, kde-format
msgid "&Reactivation delay:"
msgstr "ຄວາມຊ້າໃນການເຮັດວຽກຄັ້ງຕໍ່ໄປ (&R):"

#. i18n: ectx: property (text), widget (QLabel, label_1)
#: touch.ui:17
#, kde-format
msgid ""
"You can trigger an action by swiping from the screen edge towards the center "
"of the screen."
msgstr "ທ່ານສາມາດປັດນິ້ວມືຂອງທ່ານຈາກແຄມຂອງຈໍເຂົ້າໄປໃນຈໍເພື່ອເຮັດວຽກ."
