#: main.cpp:31
#, kde-format
msgid "KWinRules KCM launcher"
msgstr "ໂປຣແກຣມເລີ່ມຕົ້ນກົດລະບຽບ KWin KCM"

#: main.cpp:32
#, kde-format
msgid "KWin id of the window for special window settings."
msgstr "ໝາຍເລກຫນ້າຕ່າງ (KWin ID) ສຳລັບການຕັ້ງຄ່າສະເພາະຂອງຫນ້າຕ່າງ."

#: main.cpp:33
#, kde-format
msgid "Whether the settings should affect all windows of the application."
msgstr "ການຕັ້ງຄ່ານີ້ຈະນຳໃຊ້ກັບຫນ້າຕ່າງທັງໝົດຂອງແອັບພລິເຄຊັນນີ້ບໍ່."

#: main.cpp:40
#, kde-format
msgid "This helper utility is not supposed to be called directly."
msgstr "ບໍ່ຄວນໂຮມດ້ວຍເຄື່ອງມືຊ່ວຍນີ້ໂດຍກົງ."

