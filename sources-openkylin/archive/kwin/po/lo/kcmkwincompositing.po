#. i18n: ectx: property (text), item, widget (QComboBox, kcfg_LatencyPolicy)
#: compositing.ui:269
#, kde-format
msgid "Prefer lower latency"
msgstr "ຕ່ຳສຸດກ່ອນ"

#. i18n: ectx: property (text), item, widget (QComboBox, kcfg_LatencyPolicy)
#: compositing.ui:274
#, kde-format
msgid "Balance of latency and smoothness"
msgstr "ຄວາມສົມດຸນລະຫວ່າງຄວາມຊັກຄໍ່າ ແລະ ຄວາມເລື່ອນໄຫລຂອງການສະແດງຜົນ"

#. i18n: ectx: property (text), item, widget (QComboBox, kcfg_LatencyPolicy)
#: compositing.ui:279
#, kde-format
msgid "Prefer smoother animations"
msgstr "ຄວາມເລື່ອນໄຫລທີ່ດີກ່ອນ"

#. i18n: ectx: property (text), item, widget (QComboBox, kcfg_LatencyPolicy)
#: compositing.ui:284
#, kde-format
msgid "Force smoothest animations"
msgstr "ບັງຄັບໃຫ້ເລື່ອນໄຫລທີ່ດີທີ່ສຸດ"

#: main.cpp:76
#, kde-format
msgid "Re-enable OpenGL detection"
msgstr "ເປີດໃຊ້ການກວດສອບ OpenGL ຄືນໃໝ່"

#: main.cpp:135
#, kde-format
msgid ""
"\"Only when cheap\" only prevents tearing for full screen changes like a "
"video."
msgstr ""
"\"ພຽງແຕ່ເມື່ອໃຊ້ຊັບສິນນ້ອຍ\" "
"ສາມາດປ້ອງກັນການເກີດການຂັດຈຳໃນເວລາທີ່ເນື້ອຫາເຕັມຈໍມີການປ່ຽນແປງເທົ່ານັ້ນ, ເຊັ່"
"ນ ໃນຂະນະທີ່ເລີ່ນວິດີໂອ."

#: main.cpp:139
#, kde-format
msgid "\"Full screen repaints\" can cause performance problems."
msgstr "\"ການແຕ້ມຄືນຈໍເຕັມຈໍ\" ອາດຈະເຮັດໃຫ້ເກີດບັນຫາດ້ານປະສິດທິພາບ."

#: main.cpp:143
#, kde-format
msgid ""
"\"Re-use screen content\" causes severe performance problems on MESA drivers."
msgstr ""
"\"ການໃຊ້ຄືນເນື້ອຫາຈໍ\" ອາດຈະເຮັດໃຫ້ເກີດບັນຫາດ້ານປະສິດທິພາບຢ່າງຮ້າຍແຮງໃນໄດເວີ "
"MESA."
