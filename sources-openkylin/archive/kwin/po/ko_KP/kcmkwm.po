#. i18n: ectx: property (text), item, widget (KComboBox, kcfg_Placement)
#: advanced.ui:105
#, kde-format
msgid "In Top-Left Corner"
msgstr "왼쪽 상단 모서리"

#. i18n: ectx: property (text), item, widget (KComboBox, kcfg_Placement)
#: advanced.ui:110
#, kde-format
