<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">

<policyconfig>
  <vendor>UKUI</vendor>
  <vendor_url>https://www.ukui.org</vendor_url>

  <!-- ====== Power / Session Actions ====== -->

  <action id="org.gnome.SessionManager.logout">
    <description>Log out of the session</description>
    <description xml:lang="zh_CN">注销会话</description>
    <message>Authentication is required to log out</message>
    <message xml:lang="zh_CN">注销会话需要身份验证</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.gnome.SessionManager.reboot">
    <description>Reboot the system</description>
    <description xml:lang="zh_CN">重启系统</description>
    <message>Authentication is required to reboot the system</message>
    <message xml:lang="zh_CN">重启系统需要身份验证</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.gnome.SessionManager.poweroff">
    <description>Shut down the system</description>
    <description xml:lang="zh_CN">关闭系统</description>
    <message>Authentication is required to shut down the system</message>
    <message xml:lang="zh_CN">关闭系统需要身份验证</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.gnome.SessionManager.suspend">
    <description>Suspend the system</description>
    <description xml:lang="zh_CN">挂起系统</description>
    <message>Authentication is required to suspend the system</message>
    <message xml:lang="zh_CN">挂起系统需要身份验证</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.gnome.SessionManager.hibernate">
    <description>Hibernate the system</description>
    <description xml:lang="zh_CN">休眠系统</description>
    <message>Authentication is required to hibernate the system</message>
    <message xml:lang="zh_CN">休眠系统需要身份验证</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.gnome.SessionManager.switch-user">
    <description>Switch to another user account</description>
    <description xml:lang="zh_CN">切换用户</description>
    <message>Authentication is required to switch users</message>
    <message xml:lang="zh_CN">切换用户需要身份验证</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- ====== Sensitive Session Operations ====== -->

  <action id="org.gnome.SessionManager.set-session-env">
    <description>Set a session environment variable</description>
    <description xml:lang="zh_CN">设置会话环境变量</description>
    <message>Authentication is required to set a session environment variable</message>
    <message xml:lang="zh_CN">设置会话环境变量需要身份验证</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.gnome.SessionManager.simulate-user-activity">
    <description>Simulate user activity</description>
    <description xml:lang="zh_CN">模拟用户活动</description>
    <message>Authentication is required to simulate user activity</message>
    <message xml:lang="zh_CN">模拟用户活动需要身份验证</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.gnome.SessionManager.start-app">
    <description>Launch an application via session manager</description>
    <description xml:lang="zh_CN">通过会话管理器启动应用</description>
    <message>Authentication is required to launch applications this way</message>
    <message xml:lang="zh_CN">以此方式启动应用需要身份验证</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.gnome.SessionManager.start-module">
    <description>Start a session module</description>
    <description xml:lang="zh_CN">启动会话模块</description>
    <message>Authentication is required to start a session module</message>
    <message xml:lang="zh_CN">启动会话模块需要身份验证</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.gnome.SessionManager.stop-module">
    <description>Stop a session module</description>
    <description xml:lang="zh_CN">停止会话模块</description>
    <message>Authentication is required to stop a session module</message>
    <message xml:lang="zh_CN">停止会话模块需要身份验证</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.gnome.SessionManager.close-windows">
    <description>Close current all windows</description>
    <description xml:lang="zh_CN">关闭当前会话所有窗口</description>
    <message>Authentication is required to close current all windows</message>
    <message xml:lang="zh_CN">关闭当前所有窗口需要身份验证</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

</policyconfig>
