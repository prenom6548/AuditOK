#!/bin/bash

path_name=/etc/ukui/ukui-session/smconfig.ini
rm $path_name

touch $path_name
chmod 755 $path_name

echo "[Config]" >> $path_name
echo "IsSM = $1" >> $path_name
AppNum=$#
echo "AppNum = $[AppNum-1]" >> $path_name
if [ $# -gt 1 ]; then
	j=0
	for i in $*;
	do
		if [ $j -gt 0 ];then
			echo "SMApp$j = $i" >> $path_name
		fi
		j=$[j+1]
	done
fi

