#!/bin/sh
#export KWIN_COMPOSE=O2ES
#export GDK_BACKEND=x11
#export KSCREEN_BACKEND=kwayland
export GTK_USE_PORTAL=1
export GLIB_FORCE_USE_PORTAL=1
export GLIB_USE_KYLIN_PROCESS_MANAGER=1

#if the session bus is not available it is spawned and wrapper round our prog ram 
#otherwise we spawn our progame directly
drs=
if [ -z  "${DBUS_SESSION_BUS_ADDRESS}" ]
then
	drs=dbus-run-session
fi

exec ${drs} kwin_wayland --xwayland --drm --no-lockscreen --exit-with-session=/usr/bin/ukui-session
