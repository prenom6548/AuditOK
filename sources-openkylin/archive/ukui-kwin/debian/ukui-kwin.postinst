#! /bin/bash
for file in `ls /home` #注意此处这是两个反引号，表示运行系统命令
do
	if [ -f "/home/"$file"/.config/ukui-kwinrc" ] #注意此处之间一定要加上空格，否则会报错
	then
		sed -i '/library=/d' "/home/"$file"/.config/ukui-kwinrc"
		sed -i '/theme=/d' "/home/"$file"/.config/ukui-kwinrc"
	fi
	if [ -f "/home/"$file"/.config/kglobalshortcutsrc" ] #注意此处之间一定要加上空格，否则会报错
	then
		rm /home/"$file"/.config/kglobalshortcutsrc
	fi
done

# 用户目录下的手势配置文件尚不稳定
# 装包时覆盖掉
for user in `ls /home/`;
do
    if [ -f /home/$user/.config/touchgesture/touchgesture.xml ]; then
        cp /usr/share/touchgesture/touchgesture.xml /home/$user/.config/touchgesture/touchgesture.xml -f;
		if [ $? == 0 ]; then
			echo "$user""用户的配置文件(touchgesture.xml)替换成功!"
		else
		    echo "$user""用户的配置文件(touchgesture.xml)替换失败!"
		fi
	fi
done

function cleanconfig() {
    file="/usr/share/X11/touchscreen/01-kylin.conf"
    if [ -f "${file}" ];then
        rm ${file}
        echo "${file} has been deleted!"
    fi
    desktop="/etc/xdg/autostart/touchegg.desktop"
    if [ -f "${desktop}" ];then
        rm ${desktop}
        echo "${desktop} has been deleted!"
    fi
}
function stoptouchegg() {
    if [ -d /run/systemd/system ]; then
        systemctl stop 'touchegg.service' >/dev/null || true
        systemctl disable 'touchegg.service' >/dev/null || true
        systemctl --system daemon-reload >/dev/null || true
        echo "Stop Touchegg Success !"
    fi
}

echo "file = $#, param = $@"

if [ "$#" == 1 ] && [ "$1" == "reconfigure" ]; then
    # OTA升级时的执行分支
    echo "Total parameter is 1"
    stoptouchegg
    cleanconfig
else
    # 安装包正常安装的安装后脚本执行顺序
    stoptouchegg
    cleanconfig
    #systemctl enable testupdate
fi

echo "testUpdate's postinst has been executed!"

#DEBHELPER#
