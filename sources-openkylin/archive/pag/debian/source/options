# 忽略掉所有的 .git 版本控制记录，以免被打包进源码
extend-diff-ignore = "(^|/)\.git($|/)"
tar-ignore = .git

# 忽略其他平台的专有产物和预编译库
tar-ignore = libpag/third_party/tgfx/vendor/swiftshader/mac
tar-ignore = libpag/third_party/tgfx/vendor/swiftshader/win
tar-ignore = libpag/ios
tar-ignore = libpag/mac
tar-ignore = libpag/android
tar-ignore = libpag/ohos
tar-ignore = libpag/web
tar-ignore = ffavc/ios
tar-ignore = ffavc/mac
tar-ignore = ffavc/android
tar-ignore = ffavc/web
tar-ignore = .idea

# 忽略第三方库的大型测试数据
tar-ignore = libpag/third_party/tgfx/third_party/expat/testdata
