#!/bin/sh

#set -e

glib-compile-schemas /usr/share/glib-2.0/schemas/

version=`dpkg -l ukui-bluetooth |grep ukui-bluetooth |awk '{ print $3}'`
echo "upgrade  version: "$version

#判断命令是否存在
if [ -x /usr/share/kylin-system-updater/kylin-reboot-required ]; then
    #执行请求重启提示
    /usr/share/kylin-system-updater/kylin-reboot-required
fi

start_server(){
    echo "start_server"

    if [ -e "/etc/bluetooth/ukui-bluetooth.conf" ]
    then
        sed -i 's/activeConnection=true/activeConnection=false/g' /etc/bluetooth/ukui-bluetooth.conf
        echo "ukui-bluetooth.conf change"
    else
        echo "ukui-bluetooth.conf not exist"
    fi

    #启动ukui-bluetooth.service, 且开机自启动
    systemctl enable ukui-bluetooth.service
    systemctl start ukui-bluetooth.service
}

start_server

#DEBHELPER#
