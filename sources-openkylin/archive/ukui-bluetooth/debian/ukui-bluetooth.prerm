#!/bin/sh

#set -e

path="/usr/lib/`/usr/bin/dpkg-architecture -qDEB_TARGET_MULTIARCH`/ukui-control-center/libukcc-bluetooth.so"
case "$1" in
    remove|upgrade|deconfigure)
        if command -v dpkg-divert >/dev/null; then
            dpkg-divert --remove --rename --divert "$path"".old" "$path"
        fi
    ;;
esac