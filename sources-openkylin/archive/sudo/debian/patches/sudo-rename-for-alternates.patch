From: Ravi Kant Sharma <ravi.kant.sharma@canonical.com>
Date: Fri, 3 Apr 2026 14:48:15 +0800
Subject: symlink sudoedit to renamed sudo files

The patch links sudoedit to renamed sudo (.ws) binary and manpages.
sudo (1.9.16p2-1ubuntu2) questing; urgency=medium
---
 docs/Makefile.in | 5 +++--
 src/Makefile.in  | 3 ++-
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/docs/Makefile.in b/docs/Makefile.in
index 89c8e6c..928b8b8 100644
--- a/docs/Makefile.in
+++ b/docs/Makefile.in
@@ -52,6 +52,7 @@ libexecdir = @libexecdir@
 datarootdir = @datarootdir@
 localstatedir = @localstatedir@
 mandir = @mandir@
+ubuntu_suffix = ws
 
 # Directory in which to install the man page
 mantype = @MANTYPE@
@@ -378,11 +379,11 @@ install-doc: install-dirs
 	    done; \
 	    rm -f $(DESTDIR)$(mandirsu)/sudoedit.$(mansectsu)$(MANCOMPRESSEXT); \
 	    echo ln -s sudo.$(mansectsu)$(MANCOMPRESSEXT) $(DESTDIR)$(mandirsu)/sudoedit.$(mansectsu)$(MANCOMPRESSEXT); \
-	    ln -s sudo.$(mansectsu)$(MANCOMPRESSEXT) $(DESTDIR)$(mandirsu)/sudoedit.$(mansectsu)$(MANCOMPRESSEXT); \
+	    ln -s sudo.$(ubuntu_suffix).$(mansectsu)$(MANCOMPRESSEXT) $(DESTDIR)$(mandirsu)/sudoedit.$(mansectsu)$(MANCOMPRESSEXT); \
 	else \
 	    rm -f $(DESTDIR)$(mandirsu)/sudoedit.$(mansectsu); \
 	    echo ln -s sudo.$(mansectsu) $(DESTDIR)$(mandirsu)/sudoedit.$(mansectsu); \
-	    ln -s sudo.$(mansectsu) $(DESTDIR)$(mandirsu)/sudoedit.$(mansectsu); \
+	    ln -s sudo.$(ubuntu_suffix).$(mansectsu) $(DESTDIR)$(mandirsu)/sudoedit.$(mansectsu); \
 	fi
 
 install-plugin:
diff --git a/src/Makefile.in b/src/Makefile.in
index bc1ac46..d1755ff 100644
--- a/src/Makefile.in
+++ b/src/Makefile.in
@@ -113,6 +113,7 @@ interceptdir = @INTERCEPTDIR@
 noexecfile = @NOEXECFILE@
 noexecdir = @NOEXECDIR@
 tmpfiles_d = @TMPFILES_D@
+ubuntu_suffix = ws
 
 # User and group ids the installed files should be "owned" by
 install_uid = 0
@@ -279,7 +280,7 @@ install-rc: install-dirs
 install-binaries: install-dirs $(PROGS)
 	INSTALL_BACKUP='$(INSTALL_BACKUP)' $(LIBTOOL) $(LTFLAGS) --mode=install $(INSTALL) $(INSTALL_OWNER) -m 04755 sudo $(DESTDIR)$(bindir)/sudo
 	rm -f $(DESTDIR)$(bindir)/sudoedit
-	ln -s sudo $(DESTDIR)$(bindir)/sudoedit
+	ln -s sudo.$(ubuntu_suffix) $(DESTDIR)$(bindir)/sudoedit
 	if [ -f sesh ]; then \
 	    INSTALL_BACKUP='$(INSTALL_BACKUP)' $(LIBTOOL) $(LTFLAGS) --mode=install $(INSTALL) $(INSTALL_OWNER) -m 0755 sesh $(DESTDIR)$(libexecdir)/sudo/sesh; \
 	fi
