prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@MCP_CLIENT_INSTALL_INCLUDEDIR@

Name: kysdk-mcp-client
Description: libkysdk-mcp client library
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lkysdk-mcp-client
Libs.private: -lssl -lcrypto -lpthread
Cflags: -I${includedir} -I${includedir}/client -I${includedir}/common
