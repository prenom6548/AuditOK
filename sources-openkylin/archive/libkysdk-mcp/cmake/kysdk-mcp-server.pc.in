prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@MCP_SERVER_INSTALL_INCLUDEDIR@

Name: kysdk-mcp-server
Description: libkysdk-mcp server library
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lkysdk-mcp-server
Libs.private: -lssl -lcrypto -lpthread
Cflags: -I${includedir} -I${includedir}/server -I${includedir}/common
