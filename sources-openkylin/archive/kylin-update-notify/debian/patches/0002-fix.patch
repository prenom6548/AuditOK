+public:
+    FixButton(QWidget *parent = nullptr);
+    ~FixButton();
+    void setText(const QString &text, bool saveTextFlag = true);
+private:
+    void paintEvent(QPaintEvent *event);
+
+private:
+    QString mStr;
+};
