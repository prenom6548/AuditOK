+
+cfb_enc_rnd_loop:
+	movdqu (%rdi), RX1
+	SM4_ROUND_INST_SM4RND(XMM0, XMM1)
+	add $0x10, %rdi
+	cmpq %rax, %rdi
+	jne cfb_enc_rnd_loop
+
+	pshufd $0x1b, RX0, RX0
+	pshufb RX3, RX0
+	movdqu (%rsi), RX2
+	pxor RX2, RX0
+	movdqu RX0, (%rdx)
+
+	add $0x10, %rsi
+	add $0x10, %rdx
+	sub $0x10, %r8
+	jnz cfb_enc_loop
+	movdqu RX0, (%rcx)
+
+cfb_enc_over:
+	FRAME_END
+	RET
+SYM_FUNC_END(cis_sm4_cfb_encrypt_blk8)
+
+/**
+ * void cis_sm4_cfb_decrypt_blk8(unsigned int *sk,
+ *                                 const unsigned char *in,
+ *                                 unsigned char *out,
+ *                                 unsigned char *iv,
+ *                                 unsigned int len)
+ */
+SYM_TYPED_FUNC_START(cis_sm4_cfb_decrypt_blk8)
+	/* input:
+	 *      %rdi: round key array, sk
+	 *      %rsi: input data, in
+	 *      %rdx: output data, out
+	 *      %rcx: iv data, iv
+	 *      %r8: data length, len
