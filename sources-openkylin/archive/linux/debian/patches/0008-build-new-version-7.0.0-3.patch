+static const struct file_operations ccp_fops = {
+	.owner		= THIS_MODULE,
+	.open		= ccp_open,
+	.release	= ccp_close,
+	.read		= ccp_read,
+	.write		= ccp_write,
+	.unlocked_ioctl	= ccp_ioctl,
+	.mmap		= ccp_mmap,
+};
