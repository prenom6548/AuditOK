+	leaq (16*8)(%rdi), %rax
+	movdqa RX4, RX0
+	pshufb RX3, RX0
+
+cfb_dec_rnd_loop:
+	movdqu (%rdi), RX1
+	SM4_ROUND_INST_SM4RND(XMM0, XMM1)
+	add $0x10, %rdi
+	cmpq %rax, %rdi
+	jne cfb_dec_rnd_loop
+
+	pshufd $0x1b, RX0, RX0
+	pshufb RX3, RX0
+	movdqu (%rsi), RX4
+	pxor RX4, RX0
+	movdqu RX0, (%rdx)
