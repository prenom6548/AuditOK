 /* We want the module name in front of our messages */
 #undef pr_fmt
@@ -68,6 +70,12 @@ struct ccp_crypto_akcipher_alg {
 	struct akcipher_alg alg;
 };
 
+struct ccp_crypto_sig_alg {
+	struct list_head entry;
+
+	struct sig_alg alg;
+};
