+SYM_TYPED_FUNC_START(cis_sm4_ofb_crypt_blk8)
+	/* input:
+	 *      %rdi: round key array, sk
+	 *      %rsi: input data, in
+	 *      %rdx: output data, out
+	 *      %rcx: iv data, iv
+	 *      %r8: data length, len
+	 */
+	FRAME_BEGIN
+
+	test %r8, %r8
+	jle ofb_over
+	movq %rdi, %r9
+	movdqa .Lbswap32_mask rRIP, RX3
+	movdqu (%rcx), RX0
+
+ofb_loop:
+	movq %r9, %rdi
+	leaq (16*8)(%rdi), %rax
+	pshufb RX3, RX0
+
+ofb_rnd_loop:
+	movdqu (%rdi), RX1
+	SM4_ROUND_INST_SM4RND(XMM0, XMM1)
+	add $0x10, %rdi
+	cmpq %rax, %rdi
+	jne ofb_rnd_loop
+
+	pshufd $0x1b, RX0, RX0
+	pshufb RX3, RX0
+	movdqa RX0, RX4
+	movdqu (%rsi), RX2
+	pxor RX2, RX4
+	movdqu RX4, (%rdx)
+
+	add $0x10, %rsi
+	add $0x10, %rdx
+	sub $0x10, %r8
