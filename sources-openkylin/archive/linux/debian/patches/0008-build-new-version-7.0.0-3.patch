+static unsigned int ccp_sm2_sig_keysize(struct crypto_sig *tfm)
+{
+	return CCP_SM2_OPERAND_LEN * 8;
+}
+
+static unsigned int ccp_sm2_sig_digestsize(struct crypto_sig *tfm)
+{
+	return SM3_DIGEST_SIZE;
+}
+
+static unsigned int ccp_sm2_sig_maxsize(struct crypto_sig *tfm)
+{
+	return CCP_SM2_OPERAND_LEN * 2;
+}
