+
+    CBIOS_U32 RomImageLength;
+
+    CBIOS_DEVICE_MANAGER       DeviceMgr;
+
+    CBIOS_DISPLAY_MANAGER      DispMgr;
+
+} CBIOS_EXTENSION_COMMON, *PCBIOS_EXTENSION_COMMON;
