+            sch_mgr->engine_index, sch_mgr->last_send_fence_id, sch_mgr->returned_fence_id, sch_mgr->task_id, sch_mgr->last_submit_task_id);
+
+        vidschi_dump_task_pool(p, adapter, &sch_mgr->normal_task_pool, "Normal");
