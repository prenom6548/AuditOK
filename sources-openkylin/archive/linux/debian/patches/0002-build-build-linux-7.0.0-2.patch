+        (interrupt_info.AdvancedIntType & CBIOS_PAGE_FAULT_INT) ||
+        (interrupt_info.AdvancedIntType & CBIOS_MXU_INVALID_ADDR_FAULT_INT))*/  //need refine
+    {
+        *interrupt_mask |= INT_FENCE;
+    }
+
+    return (status == CBIOS_OK) ? DISP_OK : DISP_FAIL;
+}
