+        CBIOS_BOOL   EnhancedMode;          // 1 (yes) to support HDCP
+        CBIOS_BOOL   AsyncMode;             // 1 (yes), asynchronous mode
+        CBIOS_U32    ColorFormat;           // 0: RGB, 1:YCbCr422, 2:YCbCr444
+        CBIOS_U32    DynamicRange;          // 0: VESA range, 1:CEA range
