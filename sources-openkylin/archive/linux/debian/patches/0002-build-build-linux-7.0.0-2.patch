+        //cbDIU_HDCP_SwReset(pcbe, HDCPModuleIndex);
+
+        cbDIU_DP_HDCP_AuxOnOff(pcbe, HDCPModuleIndex, bTurnOn);
+
+        pHdcpContext->AuthStatus = CBIOS_HDCP_AUTH_DISABLE;
+        cbHDCP_InitHdcpContext(pvcbe, pHdcpContext); // reset HDCP context
+    }
+
+    cbTraceExit(GENERIC);
+}
