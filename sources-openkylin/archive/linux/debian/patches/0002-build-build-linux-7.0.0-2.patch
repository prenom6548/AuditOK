+    CBIOS_BOOL    bIsDualMode = CBIOS_FALSE;
+    CBIOS_U8      byData = 0;
+
+    //using DP dual mode char byte to see HDMI or DP
+    if (cbHWReadEDID(pcbe, byI2CBus, &byData, 0x00, 1, 0))
+    {
+        bIsDualMode = CBIOS_TRUE;
+    }
+    else
+    {
+        bIsDualMode = CBIOS_FALSE;
+    }
+    return bIsDualMode;
