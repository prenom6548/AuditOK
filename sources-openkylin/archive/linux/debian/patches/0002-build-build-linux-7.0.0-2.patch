+
+/* Bitfields in PHYTMAC_TX_MSG_TAIL */
+#define PHYTMAC_TX_MSG_INT_INDEX			16
+#define PHYTMAC_TX_MSG_INT_WIDTH			1
+
+/* Bitfields in PHYTMAC_MSG_ISR */
+#define PHYTMAC_MSG_COMPLETE_INDEX			0
+#define PHYTMAC_MSG_COMPLETE_WIDTH			1
+
