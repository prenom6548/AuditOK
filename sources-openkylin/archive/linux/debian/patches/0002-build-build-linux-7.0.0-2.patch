+    CBIOS_U32    HorDisEnd;
+    CBIOS_U32    HorBStart;
+    CBIOS_U32    HorBEnd;
+    CBIOS_U32    HorSyncStart;
+    CBIOS_U32    HorSyncEnd;
+    CBIOS_U32    VerTotal;
+    CBIOS_U32    VerDisEnd;
