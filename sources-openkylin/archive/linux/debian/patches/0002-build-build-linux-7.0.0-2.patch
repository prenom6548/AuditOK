+	LEAPRAID_DRIVER_SCSIIO_CB_IDX	= 0x6,
+	LEAPRAID_SAS_CTRL_CB_IDX	= 0x7,
+	LEAPRAID_ENC_CB_IDX		= 0x8,
+	LEAPRAID_NOTIFY_EVENT_CB_IDX	= 0x9,
+	LEAPRAID_CTL_CB_IDX		= 0xA,
