+
+static uint32_t write_one_command(struct tcm_se_private *pvt_data,
+				  uint8_t *command, uint32_t size,
+				  uint32_t offset, uint32_t msg_id)
+{
+	union tcm_protocol_send_header header;
+	uint32_t res_status;
+	unsigned long timeout = jiffies + msecs_to_jiffies(TCM_SE_LONG_TIMEOUT);
+
+	/* Wait for the channel to become free */
+	while (!CHANNEL_FREE(pvt_data->share_mm_base_addr)) {
+		if (time_after(jiffies, timeout)) {
+			pr_err("Wait for send timeout after %ums\n",
+				   TCM_SE_LONG_TIMEOUT);
+			return -ETIMEDOUT;
+		}
+	}
+
+	/* Mark the channel as busy */
+	SHARE_MEM_ADDR(pvt_data->share_mm_base_addr)->channel_free = 0;
+
+	/* Check for any previous channel errors */
+	if (unlikely(CHANNEL_ERR(pvt_data->share_mm_base_addr))) {
+		pr_err("Previous command encountered an error!\n");
+		return -EPERM;
+	}
+
+	/* Set the message size based on the message ID */
+	uint32_t msg_size =
+		(msg_id == pvt_data->tcm_recv_msg) ?
+			(4 + sizeof(union tcm_protocol_send_header)) :
+			(4 + TCM_PROTOCOL_MAX_SIZE);
+	REG_WR_32_SYNC((pvt_data->share_mm_base_addr + TCM_SE_MSG_FLAG_OFFSET),
+			   msg_size);
+
+	/* Set message header fields */
+	SHARE_MEM_ADDR(pvt_data->share_mm_base_addr)->msg_header_msg_id =
+		msg_id;
+	SHARE_MEM_ADDR(pvt_data->share_mm_base_addr)->msg_header_protocol_id =
+		pvt_data->protocol_id;
+
+	/* Prepare the protocol header */
+	header.a.cmd_offset = offset;
+	header.a.cmd_size = size;
+	memcpy_toio(TCM_HEADER_ADDR(pvt_data->share_mm_base_addr), &header.data,
+			sizeof(header.data));
+
+	/* Copy the command data if provided */
+	if (command)
+		memcpy_toio(TCM_DATA_ADDR(pvt_data->share_mm_base_addr),
+				command, size);
+
+	/* Trigger the doorbell */
+	REG_WR_32_SYNC(pvt_data->door_bell_addr, TCM_SE_COMPLETE);
+
+	/* Wait for the channel to become free again */
+	timeout = jiffies + msecs_to_jiffies(TCM_SE_LONG_TIMEOUT);
+	while (!CHANNEL_FREE(pvt_data->share_mm_base_addr)) {
+		if (time_after(jiffies, timeout)) {
+			pr_err("Channel timeout after %ums\n",
+				   TCM_SE_LONG_TIMEOUT);
+			return -ETIMEDOUT;
+		}
+	}
+
+	/* Check the response status */
+	res_status = *(uint32_t *)(pvt_data->share_mm_base_addr +
+				   sizeof(struct share_mem_struct));
+	if (res_status) {
+		pr_err("Command execution failed with status: %u\n",
+			   res_status);
+		return -EPERM;
+	}
+
+	return 0;
+}
+
+static int write_request(struct tcm_se_private *pvt_data, uint8_t *command,
+			 uint32_t size)
+{
+	uint32_t ret, size_tmp, size_left, cmd_offset;
+	uint8_t *src_iter;
+
+	if (!size) {
+		pr_err("Command size is 0!\n");
+		return -EINVAL;
+	}
+
+	if (!SHARE_MEM_ADDR(pvt_data->share_mm_base_addr)) {
+		pr_err("Shared memory is NULL!\n");
+		return -ENOMEM;
+	}
+
+	if (!pvt_data->door_bell_addr) {
+		pr_err("Doorbell address is NULL!\n");
+		return -ENOMEM;
+	}
+
+	if (CHANNEL_ERR(pvt_data->share_mm_base_addr)) {
+		pr_err("Previous command encountered an error!\n");
+		return -EPERM;
+	}
+
+	size_left = size;
+	cmd_offset = 0;
+	src_iter = command;
+	size = TCM_PROTOCOL_MAX_DATA_SIZE;
+
+	while (size_left) {
+
+		size_tmp = min(size_left, size);
+
+		ret = write_one_command(pvt_data, src_iter, size_tmp,
+					cmd_offset, pvt_data->tcm_send_msg);
+		if (ret) {
+			pr_err("Failed to write one command!\n");
+			return ret;
+		}
+		src_iter += size_tmp;
+		cmd_offset += size_tmp;
+		size_left -= size_tmp;
+	}
+
+	/* Send a final command with size 0 to indicate completion */
+	ret = write_one_command(pvt_data, NULL, 0, cmd_offset,
+				pvt_data->tcm_send_msg);
+	if (ret)
+		pr_err("Failed to write final command!\n");
+
+	return ret;
+}
+
+static uint32_t read_respond_buffer(struct tcm_se_private *pvt_data,
+				    uint32_t size)
+{
+	uint32_t ret, offset = 0, size_left = size, size_iter;
+	unsigned long timeout;
+
+	if (!size) {
+		pr_err("Response size is 0!\n");
+		return -EINVAL;
+	}
+
+	size = TCM_PROTOCOL_MAX_DATA_SIZE;
+
+	while (size_left > 0) {
+		size_iter = min(size_left, size);
+
+		ret = write_one_command(pvt_data, NULL, size_iter, offset,
+					pvt_data->tcm_recv_msg);
+		if (unlikely(ret != 0)) {
+			pr_err("write_one_command failed at offset %u\n",
+			       offset);
+			return ret;
+		}
+
+		/* Wait for the channel to become free */
+		timeout = jiffies + msecs_to_jiffies(TCM_SE_LONG_TIMEOUT);
+		while (!CHANNEL_FREE(pvt_data->share_mm_base_addr)) {
+			if (time_after(jiffies, timeout)) {
+				pr_err("Channel timeout after %ums\n",
+				       TCM_SE_LONG_TIMEOUT);
+				return -ETIMEDOUT;
+			}
+		}
+		memcpy_fromio(pvt_data->tcm_response + offset,
+			      TCM_DATA_ADDR(pvt_data->share_mm_base_addr),
+			      size_iter);
+
+		offset += size_iter;
+		size_left -= size_iter;
+	}
+
+	return 0;
+}
+
+static int tcm_se_recv(struct tpm_chip *chip, u8 *buf, size_t count)
+{
+	int ret;
+	uint32_t len;
+	struct tcm_se_private *pvt_data = dev_get_drvdata(&chip->dev);
+
+	/* Read the response length from shared memory */
+	len = *(uint32_t *)(pvt_data->share_mm_tcm_flag_addr + 4);
+
+	/* Validate the response length against the buffer size */
+	if (count < len) {
+		dev_err(&chip->dev,
+			"%s: Invalid size in recv: count=%zu, resp_len=%u\n",
+			__func__, count, len);
+		return -EINVAL;
+	}
+	/* Handle invalid or zero-length responses */
+	if (len == 0) {
+		pr_err("recv len is 0\n");
+		goto clear_flags;
+	}
+	/* Mark the driver as not readable */
+	pvt_data->status = 0;
+
+	/* Clear the shared memory flags */
+clear_flags:
+	*(uint32_t *)(pvt_data->share_mm_tcm_flag_addr) = 0;
+	*(uint32_t *)(pvt_data->share_mm_tcm_flag_addr + 4) = 0;
+
+	if (len == 0)
+		return 0;
+	ret = read_respond_buffer(pvt_data, len);
+
+	if (ret) {
+		pr_err("Failed to read response buffer!\n");
+		return ret;
+	}
+	memcpy(buf, pvt_data->tcm_response, len);
+	return len;
+}
+
+static int tcm_se_send(struct tpm_chip *chip, u8 *buf, size_t bufsiz, size_t cmdlen)
+{
+	struct tcm_se_private *pvt_data = dev_get_drvdata(&chip->dev);
+	int ret = 0;
+
+	if (!buf || cmdlen == 0) {
+		pr_err("Invalid buffer or length!\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (cmdlen > bufsiz || cmdlen > BUF_SIZE) {
+		pr_err("Buffer size exceeds maximum allowed size!\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	ret = write_request(pvt_data, buf, cmdlen);
+	if (ret < 0) {
+		pr_err("Failed to write request!\n");
+		goto out;
+	}
+
+	pvt_data->status = 1; /* Mark as readable */
+out:
+	return ret;
+}
+
+static void tcm_se_cancel(struct tpm_chip *chip)
+{
+	/* Cancel operation is not supported */
+}
+
+static u8 tcm_se_status(struct tpm_chip *chip)
+{
+	struct tcm_se_private *pvt_data = dev_get_drvdata(&chip->dev);
+
+	if (!pvt_data) {
+		pr_err("Private data is NULL!\n");
+		return 0;
+	}
+
+	if (pvt_data->status == 0)
+		return 0;
+
+	return *(uint32_t *)(pvt_data->share_mm_tcm_flag_addr) && TCM_SE_COMPLETE;
+}
+
+static bool tcm_se_req_canceled(struct tpm_chip *chip, u8 status)
+{
+	/* Request cancellation is not supported */
+	return false;
+}
+
+static int tcm_se_request_locality(struct tpm_chip *chip, int loc)
+{
+	/* Locality request is not supported */
+	return 0;
+}
+static const struct of_device_id of_tcm_se_ids[] = { { .compatible =
+							       "phytium,tcm-se" },
+						     {} };
+MODULE_DEVICE_TABLE(of, of_tcm_se_ids);
+
+#if IS_ENABLED(CONFIG_ACPI)
+static const struct acpi_device_id acpi_tcm_se_ids[] = { { "PHYT800D", 0 },
+							 { "PHYT8014", 0 },
+							 {} };
+MODULE_DEVICE_TABLE(acpi, acpi_tcm_se_ids);
+#endif
+
+// interface for tpm_class_ops
+static const struct tpm_class_ops tcm_se_ops = {
+	.flags = TPM_OPS_AUTO_STARTUP,
+	.recv = tcm_se_recv,
+	.send = tcm_se_send,
+	.cancel = tcm_se_cancel,
+	.status = tcm_se_status,
+	.req_complete_mask = 1,
+	.req_complete_val = 1,
+	.req_canceled = tcm_se_req_canceled,
+	.request_locality = tcm_se_request_locality,
+};
+
+static bool tcm_se_prepare_of(struct tcm_se_private *pvt_data, u32 *base_addr,
+			      u32 *base_size, u32 *protocol)
+{
+	struct device_node *of_node = of_find_node_by_name(NULL, "tcm_se");
+	int rc;
+
+	if (!of_node)
+		return false;
+
+
+	if (of_property_read_u32_array(of_node, "base", base_addr, 4)) {
+		pr_err("Failed to read OF base properties! rc: %x\n", rc);
+		return false;
+	}
+
+	if (of_property_read_u32_array(of_node, "base_size", base_size, 4)) {
+		pr_err("Failed to read OF base_size properties! rc: %x\n", rc);
+		return false;
+	}
+
+	if (!of_property_read_u32_array(of_node, "protocol", protocol, 3)) {
+		pvt_data->protocol_id = protocol[0];
+		pvt_data->tcm_send_msg = protocol[1];
+		pvt_data->tcm_recv_msg = protocol[2];
+	} else
+		pr_info("Using default protocol id\n");
+
+	return true;
+}
+
+#if IS_ENABLED(CONFIG_ACPI)
+static void tcm_se_parse_acpi_protocol(struct tcm_se_private *pvt_data,
+				       union acpi_object *inner_pkg)
+{
+	int i;
+	union acpi_object *entry;
+	uint64_t value;
+	const char *key;
+
+	for (i = 0; i < inner_pkg->package.count; i++) {
+		entry = &inner_pkg->package.elements[i];
+		if (entry->type == ACPI_TYPE_PACKAGE &&
+		    entry->package.count == 2 &&
+		    entry->package.elements[0].type == ACPI_TYPE_STRING) {
+			key = entry->package.elements[0].string.pointer;
+			value = entry->package.elements[1].integer.value;
+
+			if (!strcmp(key, "protocol-id"))
+				pvt_data->protocol_id = value;
+			else if (!strcmp(key, "send-id"))
+				pvt_data->tcm_send_msg = value;
+			else if (!strcmp(key, "receive-id"))
+				pvt_data->tcm_recv_msg = value;
+		}
+	}
+}
+
+static int tcm_se_prepare_acpi(struct tcm_se_private *pvt_data,
+			       struct platform_device *pdev, u32 *base_addr,
+			       u32 *base_size)
+{
+	struct resource *res;
+	struct acpi_device *adev = ACPI_COMPANION(&pdev->dev);
+	union acpi_object *dsd_obj, *inner_pkg;
+	struct acpi_buffer buffer = { ACPI_ALLOCATE_BUFFER, NULL };
+	acpi_status status;
+	int i;
+
+	for (i = 0; i < 4; i++) {
+		res = platform_get_resource(pdev, IORESOURCE_MEM, i);
+		if (res) {
+			base_addr[i] = res->start;
+			base_size[i] = resource_size(res);
+		} else
+			pr_err("Failed to get Memory32Fixed resource %d\n", i);
+	}
+
+	if (!adev)
+		return 0;
+
+	status = acpi_evaluate_object(adev->handle, "_DSD", NULL, &buffer);
+	if (ACPI_FAILURE(status))
+		return 0;
+
+	dsd_obj = buffer.pointer;
+	if (dsd_obj->type == ACPI_TYPE_PACKAGE && dsd_obj->package.count > 1) {
+		inner_pkg = &dsd_obj->package.elements[1];
+		if (inner_pkg->type == ACPI_TYPE_PACKAGE)
+			tcm_se_parse_acpi_protocol(pvt_data, inner_pkg);
+	}
+	kfree(buffer.pointer);
+
+	return 0;
+}
+#endif /* IS_ENABLED(CONFIG_ACPI) */
+
+static int tcm_se_prepare_iomap(struct tcm_se_private *pvt_data, u32 *base_addr,
+				u32 *base_size)
+{
+	pvt_data->share_mm_base_addr = ioremap(base_addr[0], base_size[0]);
+	if (!pvt_data->share_mm_base_addr)
+		return -ENOMEM;
+
+	SHARE_MEM_ADDR(pvt_data->share_mm_base_addr)->res1 = 0;
+	SHARE_MEM_ADDR(pvt_data->share_mm_base_addr)->channel_res = 0;
+	SHARE_MEM_ADDR(pvt_data->share_mm_base_addr)->flag_res = 0;
+	SHARE_MEM_ADDR(pvt_data->share_mm_base_addr)->msg_header_res = 0;
+	SHARE_MEM_ADDR(pvt_data->share_mm_base_addr)->channel_free = 1;
+	SHARE_MEM_ADDR(pvt_data->share_mm_base_addr)->channel_err = 0;
+
+	pvt_data->share_mm_tcm_flag_addr = ioremap(base_addr[1], base_size[1]);
+	if (!pvt_data->share_mm_tcm_flag_addr)
+		return -ENOMEM;
+
+	*(uint32_t *)(pvt_data->share_mm_tcm_flag_addr) = 0;
+	*(uint32_t *)(pvt_data->share_mm_tcm_flag_addr + 4) = 0;
+
+	pvt_data->door_bell_init_addr = ioremap(base_addr[3], base_size[3]);
+	if (!pvt_data->door_bell_init_addr)
+		return -ENOMEM;
+
+	REG_WR_32_SYNC(pvt_data->door_bell_init_addr, 1);
+
+	pvt_data->door_bell_addr = ioremap(base_addr[2], base_size[2]);
+	if (!pvt_data->door_bell_addr)
+		return -ENOMEM;
+
+	return 0;
+}
+
+static int tcm_se_prepare(struct tcm_se_private *pvt_data,
+			  struct platform_device *pdev)
+{
+	u32 base_addr[4] = { 0 }, base_size[4] = { 0 }, protocol[3] = { 0 };
+	int rc = 0;
+
+	pvt_data->protocol_id = TCM_PROTOCOL_ID;
+	pvt_data->tcm_send_msg = TCM_SEND_COMMAND;
+	pvt_data->tcm_recv_msg = TCM_READ_RESPONSE;
+
+	if (IS_ENABLED(CONFIG_OF) &&
+	    tcm_se_prepare_of(pvt_data, base_addr, base_size, protocol))
+		return tcm_se_prepare_iomap(pvt_data, base_addr, base_size);
+
+#if IS_ENABLED(CONFIG_ACPI)
+	rc = tcm_se_prepare_acpi(pvt_data, pdev, base_addr, base_size);
+	if (!rc)
+		return tcm_se_prepare_iomap(pvt_data, base_addr, base_size);
+#endif
+
+	return rc;
+}
+
+static int tcm_plat_se_probe(struct platform_device *pdev)
+{
+	int rc = 0;
+	struct tpm_chip *chip;
+	struct tcm_se_private *pvt_data = NULL;
+	struct device *dev = &pdev->dev;
+
+	pvt_data = devm_kzalloc(dev, sizeof(struct tcm_se_private), GFP_KERNEL);
+	if (!pvt_data)
+		return -ENOMEM;
+
+	chip = tpmm_chip_alloc(dev, &tcm_se_ops);
+	chip->flags |= TPM_CHIP_FLAG_TPM2;
+	pvt_data->status = 0;
+	pvt_data->share_mm_base_addr = NULL;
+	pvt_data->share_mm_tcm_flag_addr = NULL;
+	pvt_data->door_bell_addr = NULL;
+	pvt_data->door_bell_init_addr = NULL;
+	tcm_se_prepare(pvt_data, pdev);
+	if (IS_ERR(chip)) {
+		rc = PTR_ERR(chip);
+		goto err_unreg;
+	}
+
+	dev_set_drvdata(&chip->dev, pvt_data);
+	rc = tpm_chip_register(chip);
+
+err_unreg:
+	return rc;
+}
+
+static void tcm_plat_se_remove(struct platform_device *pdev)
+{
+	struct tpm_chip *chip = dev_get_drvdata(&pdev->dev);
+	struct tcm_se_private *pvt_data = dev_get_drvdata(&chip->dev);
+
+	tpm_chip_unregister(chip);
+	iounmap(pvt_data->door_bell_addr);
+	iounmap(pvt_data->door_bell_init_addr);
+	iounmap(pvt_data->share_mm_base_addr);
+	iounmap(pvt_data->share_mm_tcm_flag_addr);
+}
+
+static void tcm_plat_se_shutdown(struct platform_device *pdev)
+{
+	struct tpm_chip *chip = dev_get_drvdata(&pdev->dev);
+	struct tcm_se_private *pvt_data = dev_get_drvdata(&chip->dev);
+
+	iounmap(pvt_data->door_bell_addr);
+	iounmap(pvt_data->door_bell_init_addr);
+	iounmap(pvt_data->share_mm_base_addr);
+	iounmap(pvt_data->share_mm_tcm_flag_addr);
+}
+static int tcm_se_pm_suspend(struct device *dev)
+{
+	return tpm_pm_suspend(dev);
+}
+
+static int tcm_se_pm_resume(struct device *dev)
+{
+	struct tpm_buf buf;
+	int rc;
+	struct platform_device *pdev =
+		container_of(dev, struct platform_device, dev);
+	struct tcm_se_private *pvt_data;
+	struct tpm_chip *chip;
+
+	chip = dev_get_drvdata(&pdev->dev);
+	pvt_data = dev_get_drvdata(&chip->dev);
+	tcm_se_prepare(pvt_data, pdev);
+	rc = tpm_buf_init(&buf, TPM2_ST_NO_SESSIONS, TPM2_CC_STARTUP);
+	if (rc < 0)
+		return rc;
+	tpm_buf_append_u16(&buf, TPM2_SU_STATE);
+	rc = tpm_transmit_cmd(chip, &buf, 0, "Attempting to start the TCM");
+	if (rc < 0)
+		return rc;
+	tpm_buf_destroy(&buf);
+	return tpm_pm_resume(dev);
+}
+
+static SIMPLE_DEV_PM_OPS(tcm_se_pm, tcm_se_pm_suspend, tcm_se_pm_resume);
+
+static struct platform_driver tcm_se_plat_driver = {
+	.driver = {
+		.name = "tcm_se",
+		.pm = &tcm_se_pm,
+		.of_match_table = of_match_ptr(of_tcm_se_ids),
+#if IS_ENABLED(CONFIG_ACPI)
+		.acpi_match_table = ACPI_PTR(acpi_tcm_se_ids),
+#else
+		.acpi_match_table = NULL,
+#endif
+	},
+	.probe = tcm_plat_se_probe,
+	.remove = tcm_plat_se_remove,
+	.shutdown = tcm_plat_se_shutdown,
+};
+
+static int __init init_tcm(void)
+{
+	int rc = 0;
+
+	rc = platform_driver_register(&tcm_se_plat_driver);
+	return rc;
+}
+
+static void __exit cleanup_tcm(void)
+{
+	/* unregister the pdev driver */
+	platform_driver_unregister(&tcm_se_plat_driver);
+}
+
+module_init(init_tcm);
+module_exit(cleanup_tcm);
+
+MODULE_DESCRIPTION("TCM SE Driver");
+MODULE_VERSION("1.2.0");
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Yinhao Lu <luyinhao2239@phytium.com.cn>");
diff --git a/drivers/char/tpm/tcm_se.h b/drivers/char/tpm/tcm_se.h
new file mode 100644
index 0000000..b07a3d4
--- /dev/null
+++ b/drivers/char/tpm/tcm_se.h
@@ -0,0 +1,107 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+
+#ifndef _TCM_SE_H
+#define _TCM_SE_H
+
+#include <linux/types.h>
+#include <linux/bitops.h>
+#include <linux/wait.h>
+
+static inline void tcm_store_sync(u32 *addr, u32 val)
+{
+	/* that all prior memory operations are completed
+	 * before the value is stored at the specified memory location. It uses
+	 * `smp_store_release` to enforce a release memory barrier.
+	 */
+	smp_store_release(addr, val);
+}
+
+static inline u32 tcm_load_sync(u32 *addr)
+{
+	/* ensures that the load operation and all subsequent memory
+	 * operations are not reordered before this load. It uses `smp_load_acquire`
+	 * to enforce an acquire memory barrier.
+	 */
+	return smp_load_acquire(addr);
+}
+
+/* Register read/write macros */
+#define REG_WR_32_SYNC(reg_base, val) \
+	tcm_store_sync((u32 *)((uintptr_t)(reg_base)), val)
+
+/* Register read/write macros */
+#define REG_RD_32_SYNC(reg_base) tcm_load_sync((u32 *)((uintptr_t)(reg_base)))
+
+/* TCM message IDs */
+enum tcm_msg_id {
+	TCM_PROTOCOL_ID = 0x81,
+	TCM_SEND_COMMAND = 0x21,
+	TCM_READ_RESPONSE = 0x23,
+};
+
+/* Shared memory structure */
+struct share_mem_struct {
+	uint32_t res1; /* Reserved */
+	uint32_t channel_free : 1;
+	uint32_t channel_err : 1;
+	uint32_t channel_res : 30;
+	uint64_t res2; /* Reserved */
+	uint32_t flag_interrupt : 1;
+	uint32_t flag_res : 31;
+	uint32_t length;
+	uint32_t msg_header_msg_id : 8;
+	uint32_t msg_header_msg_type : 2;
+	uint32_t msg_header_protocol_id : 8;
+	uint32_t msg_header_token : 10;
+	uint32_t msg_header_res : 4;
+} __packed;
+
+/* Timeout definitions */
+#define TCM_SE_COMPLETE 1
+#define TCM_SE_SHORT_TIMEOUT 750
+#define TCM_SE_LONG_TIMEOUT 2000
+
+#define TCM_SE_MSG_FLAG_OFFSET 20
+
+/* SCMI-TCM protocol macros */
+#define SHARE_MEM_ADDR(addr) ((struct share_mem_struct *)(addr))
+#define TCM_HEADER_ADDR(addr) ((addr) + sizeof(struct share_mem_struct))
+#define TCM_DATA_ADDR(addr)                         \
+	((addr) + sizeof(struct share_mem_struct) + \
+	 sizeof(union tcm_protocol_send_header))
+
+/* SCMI channel macros */
+#define CHANNEL(addr) (REG_RD_32_SYNC((addr) + 4))
+#define CHANNEL_ERR(addr) ((REG_RD_32_SYNC((addr) + 4) >> 1) & 0x1)
+#define CHANNEL_FREE(addr) (REG_RD_32_SYNC((addr) + 4) & 0x1)
+
+/* TCM command package */
+union tcm_protocol_send_header {
+	struct {
+		uint16_t cmd_offset;
+		uint16_t cmd_size;
+	} a;
+	uint32_t data;
+};
+
+#define TCM_PROTOCOL_MAX_SIZE 772
+#define TCM_PROTOCOL_MAX_DATA_SIZE (TCM_PROTOCOL_MAX_SIZE - 4)
+
+#define BUF_SIZE 2048
+#define MAX_RESPONSE_SIZE 2048
+
+/* TCM private structure */
+struct tcm_se_private {
+	uint8_t tcm_response[MAX_RESPONSE_SIZE]; /* TCM response */
+	uint16_t resp_len; /* Response length */
+	uint8_t *share_mm_base_addr;
+	uint8_t *share_mm_tcm_flag_addr;
+	uint8_t *door_bell_addr;
+	uint8_t *door_bell_init_addr;
+	uint8_t protocol_id;
+	uint8_t tcm_recv_msg;
+	uint8_t tcm_send_msg;
+	bool status;
+};
+
+#endif /* _TCM_SE_H */
