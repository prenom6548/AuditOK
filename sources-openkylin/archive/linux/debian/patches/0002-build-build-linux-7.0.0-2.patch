+#if DRM_VERSION_CODE >= KERNEL_VERSION(5,11,0)
+static int gf_gem_dmabuf_vmap(struct dma_buf *dma_buf, struct DMABUF_PREFIX(map) *map)
+#else
+static void *gf_gem_dmabuf_vmap(struct dma_buf *dma_buf)
+#endif
