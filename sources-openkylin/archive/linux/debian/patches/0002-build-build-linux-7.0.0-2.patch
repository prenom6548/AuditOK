+}
+
+static void phytium_ddr_pmu_v2_reset_timer(struct phytium_ddr_pmu *ddr_pmu)
+{
+	writel(0xFFFFFFFF, ddr_pmu->base + DDR_PMUV2_SET_TIMER_L);
+	writel(0xFFFFFFFF, ddr_pmu->base + DDR_PMUV2_SET_TIMER_H);
+}
