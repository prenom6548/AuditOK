+    CBIOS_BOOL  bRet = CBIOS_FALSE;
+
+    pStatusFlags->Status_Flags = 0;
+    bRet = cbHDMIMonitor_SCDC_ReadData(pcbe, pDevCommon, &(pStatusFlags->ScramblerStatus), 0x21, 0x1);//Offset = 0x40:Status_0, Offset = 0x41:Status_1
