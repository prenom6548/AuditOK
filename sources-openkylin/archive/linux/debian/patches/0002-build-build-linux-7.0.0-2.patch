+    CBIOS_U8             VCP_SliceNum;
+    CBIOS_U16            VCP_CoreTempThreshold;
+    CBIOS_U8             RsvdByte_6[5];
+}VCP_INIT_DATA, *PVCP_INIT_DATA;
+#pragma pack(pop)
+
+#endif
