+             int *max_error, struct timeval *time, unsigned flags)
+#else
+bool gf_get_vblank_timestamp(struct drm_device *dev,
+                             unsigned int pipe,
+                             int *max_error,
+                         #if DRM_VERSION_CODE >= KERNEL_VERSION(4, 15, 0)
+                             ktime_t *vblank_time,
+                         #else
+                             struct timeval *vblank_time,
+                         #endif
+                             bool in_vblank_irq)
+#endif
