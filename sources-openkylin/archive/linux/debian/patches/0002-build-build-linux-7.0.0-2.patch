+void vidsch_dvfs_power_flag_reset(adapter_t *adapter)
+{
+    vidsch_mgr_t *vidsch = NULL;
+    int i;
+
+    for (i = 0; i < adapter->active_engine_count; i++)
+    {
+        vidsch = adapter->sch_mgr[i];
