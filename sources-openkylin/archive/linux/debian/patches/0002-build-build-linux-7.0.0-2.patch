+
+    HDCPDPCtrlKsvRegValue.Value = cb_ReadU32(pcbe->pAdapterContext, HDCP_REG_DP_CTRL_KSV[HDCPModuleIndex]);
+
+    return HDCPDPCtrlKsvRegValue.CP_EN ? CBIOS_TRUE : CBIOS_FALSE;
+}
