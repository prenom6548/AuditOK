+CBIOS_VOID cbSetSRTimingReg_Huangpu_1T1P(PCBIOS_EXTENSION_COMMON pcbe,
+                                PCBIOS_TIMING_ATTRIB pTiming,
+                                CBIOS_U32 IGAIndex,
+                                CBIOS_TIMING_FLAGS Flags)
+{
+    CBIOS_TIMING_REG_Arise  TimingReg;
+
+    cb_memset(&TimingReg, 0, sizeof(CBIOS_TIMING_REG_Arise));
+
+    //================================================================//
+    //************Start Setting Horizontal Timing Registers***********//
+    //================================================================//
+    TimingReg.HorSyncStart = pTiming->HorSyncStart - 1;
+    cbMapMaskWrite(pcbe, (CBIOS_U32)TimingReg.HorSyncStart, HSS2Reg_1TNP_INDEX, IGAIndex);
+
+    TimingReg.HorTotal = pTiming->HorTotal - 1;
+    cbMapMaskWrite(pcbe, (CBIOS_U32)TimingReg.HorTotal, HT2Reg_1TNP_INDEX, IGAIndex);
+
+    TimingReg.HorSyncEnd = pTiming->HorSyncEnd - 1;
+    cbMapMaskWrite(pcbe, (CBIOS_U32)TimingReg.HorSyncEnd, HSE2Reg_1TNP_INDEX, IGAIndex);
+
+    TimingReg.HorDisEnd = pTiming->HorDisEnd - 1;
+    cbMapMaskWrite(pcbe, (CBIOS_U32)TimingReg.HorDisEnd, HDE2Reg_1TNP_INDEX, IGAIndex);
+
+    TimingReg.HorBStart = pTiming->HorBStart - 1;
+    cbMapMaskWrite(pcbe, (CBIOS_U32)TimingReg.HorBStart, HBS2Reg_1TNP_INDEX, IGAIndex);
+
+    TimingReg.HorBEnd = pTiming->HorBEnd - 1;
+    cbMapMaskWrite(pcbe, (CBIOS_U32)TimingReg.HorBEnd, HBE2Reg_1TNP_INDEX, IGAIndex);
+
+    //================================================================//
+    //************Start Setting Vertical Timing Registers*************//
+    //================================================================//
+    TimingReg.VerTotal = pTiming->VerTotal - 1;
+    cbMapMaskWrite(pcbe,(CBIOS_U32) TimingReg.VerTotal, VT2Reg_1TNP_INDEX, IGAIndex);
+
+    TimingReg.VerDisEnd = pTiming->VerDisEnd - 1;
+    cbMapMaskWrite(pcbe, (CBIOS_U32)TimingReg.VerDisEnd, VDE2Reg_1TNP_INDEX, IGAIndex);
+
+    TimingReg.VerBStart = pTiming->VerBStart - 1;
+    cbMapMaskWrite(pcbe, (CBIOS_U32)TimingReg.VerBStart, VBS2Reg_1TNP_INDEX, IGAIndex);
+
+    TimingReg.VerBEnd = pTiming->VerBEnd - 1;
+    cbMapMaskWrite(pcbe, (CBIOS_U32)TimingReg.VerBEnd, VBE2Reg_1TNP_INDEX, IGAIndex);
+
+    TimingReg.VerSyncStart = pTiming->VerSyncStart - 1;
+    cbMapMaskWrite(pcbe, (CBIOS_U32)TimingReg.VerSyncStart, VSS2Reg_1TNP_INDEX, IGAIndex);
+
+    TimingReg.VerSyncEnd = pTiming->VerSyncEnd - 1;
+    cbMapMaskWrite(pcbe, (CBIOS_U32)TimingReg.VerSyncEnd, VSE2Reg_1TNP_INDEX, IGAIndex);
+
+}
