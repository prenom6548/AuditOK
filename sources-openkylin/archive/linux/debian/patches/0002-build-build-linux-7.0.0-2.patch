+	cmd_id = PHYTMAC_MSG_CMD_SET;
+	cmd_subid = PHYTMAC_MSG_CMD_SET_DEL_FDIR;
+	fdir.location = (u8)(rx_flow->location);
+	phytmac_v2_msg_send(pdata, cmd_id, cmd_subid, (void *)(&fdir), sizeof(fdir), 1);
+
+	return 0;
+}
