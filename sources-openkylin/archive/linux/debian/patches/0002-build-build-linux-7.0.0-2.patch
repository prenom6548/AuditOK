+++ b/sound/soc/phytium/pmdk_es8388.c
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ *  Copyright (c) 2021-2023, Phytium Techonology Co., Ltd.
