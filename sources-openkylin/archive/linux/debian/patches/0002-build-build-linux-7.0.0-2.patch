+#define RX_BUFFER_SIZE          8
+#define BUFFER_SIZE             20
+#define UART_FIFOSIZE           64
+#define TX_MSG_SIZE             0x80
+#define RX_MSG_SIZE             0x80
+#define RX_CHARS_MAX		28
