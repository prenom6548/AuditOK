+static unsigned int phytmac_v2_get_irq(struct phytmac *pdata, int queue_index)
+{
+	u32 status;
+	u32 value;
+
+	value = PHYTMAC_READ(pdata, PHYTMAC_INT_SR(queue_index));
+	status = phytmac_v2_get_irq_status(value);
+
+	return status;
+}
