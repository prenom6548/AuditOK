+#define ABRT_7B_ADDR_NOACK		0
+#define ABRT_10ADDR1_NOACK		1
+#define ABRT_10ADDR2_NOACK		2
+#define ABRT_TXDATA_NOACK		3
+#define ABRT_GCALL_NOACK		4
+#define ABRT_GCALL_READ			5
+#define ABRT_SBYTE_ACKDET		7
