+	struct phytmac *pdata = netdev_priv(ndev);
+	struct phytmac_hw_if *hw_if = pdata->hw_if;
+	u32 *regs_buff = p;
+
+	memset(p, 0, PHYTMAC_ETHTOOLD_REGS_LEN);
+
+	hw_if->get_regs(pdata, regs_buff);
+}
