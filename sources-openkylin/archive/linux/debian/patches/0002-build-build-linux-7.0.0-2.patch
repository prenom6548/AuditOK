+    DIPCmd.cmd_Dip.Major_Opcode    = CSP_OPCODE_Dip;
+    DIPCmd.cmd_Dip.P_Type          = P_Type;
+    DIPCmd.cmd_Dip.Mode            = Index_Mode;
