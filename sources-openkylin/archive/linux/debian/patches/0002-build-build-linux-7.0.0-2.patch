+static struct drm_crtc* gf_get_crtc_by_pipe(struct drm_device *dev, pipe_t pipe)
+{
+    struct drm_crtc *crtc = NULL;
+
+    list_for_each_entry(crtc, &(dev->mode_config.crtc_list), head)
+    {
+        if (drm_get_crtc_index(crtc) == pipe)
+        {
+            return crtc;
+        }
+    }
+
+    return NULL;
+}
