new file mode 100644
index 0000000..a8900c1
--- /dev/null
+++ b/drivers/gpu/drm/arise/core/util/handle_manager.c
@@ -0,0 +1,138 @@
+/*
+ * Copyright © 2021 Glenfly Tech Co., Ltd.
+ *
