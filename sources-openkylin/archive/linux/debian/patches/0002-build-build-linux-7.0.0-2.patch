+
+    //start
+    cbMMIOWriteReg32(pcbe, VIPnI2CCtrlReg, VIPI2C_START_REQUEST, ~(VIPI2C_START_REQUEST));
+    cbMMIOWriteReg32(pcbe, VIPnI2CCtrlReg, VIPI2C_WDAV, ~(VIPI2C_WDAV)); //set START & WDATA_AV
