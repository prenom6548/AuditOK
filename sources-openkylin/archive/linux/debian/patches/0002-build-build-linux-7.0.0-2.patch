diff --git a/drivers/gpu/drm/arise/shared/os_shared.c b/drivers/gpu/drm/arise/shared/os_shared.c
new file mode 100644
index 0000000..af610b0
--- /dev/null
+++ b/drivers/gpu/drm/arise/shared/os_shared.c
@@ -0,0 +1,352 @@
+/*
