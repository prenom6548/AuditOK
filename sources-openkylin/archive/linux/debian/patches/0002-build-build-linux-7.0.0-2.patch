+{
+    AUX_WORKING_STATUS_IDLE = 0x00,
+    AUX_WORKING_STATUS_LINKTRAINING = 0x01,
+    AUX_WORKING_STATUS_EDID_READING = 0x02,
+}AUX_WORKING_STATUS;
