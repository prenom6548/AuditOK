+    struct drm_device *dev = file->minor->dev;
+    struct drm_gf_gem_object *obj;
+
+    obj = gf_drm_gem_object_lookup(dev, file, args->handle);
+
+    if (!obj)
+        return -ENOENT;
+
+    ret = gf_gem_object_begin_cpu_access(obj, 10 * HZ, !args->readonly);
