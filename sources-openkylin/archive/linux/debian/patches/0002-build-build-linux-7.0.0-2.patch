+#define PHYUART_DBG_ENABLE_MASK	0x1
+#define PHYUART_DBG_HEARTBEAT_ENABLE_MASK	(0x1 << 1)
+#define PHYUART_DBG_HEARTBEAT_MASK	(0x1 << 2)
