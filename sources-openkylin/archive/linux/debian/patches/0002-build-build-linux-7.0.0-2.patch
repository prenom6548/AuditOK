+	uint32_t response1;
+	uint32_t response2;
+	uint32_t response3;
+};
+
+struct err_irq_data_t {
+	uint32_t raw_ints;
+	uint32_t ints_mask;
+	uint32_t dmac_status;
+	uint32_t dmac_mask;
+	uint32_t opcode;
+};
+#endif /* __PHYTIUM_MCI_HW_H */
+
