+#if IS_ENABLED(CONFIG_ARM_PHYTIUM_DMU_DEVFREQ)
+extern struct blocking_notifier_head dmu_pmu_notifier_chain;
+
+static void phytium_ddr_pmu_v2_notifier_chain_trigger(struct phytium_ddr_pmu *ddr_pmu, int event)
+{
+	if ((event == DDR_PMUV2_NOTICE_START) && !ddr_pmu->start_flag) {
+		blocking_notifier_call_chain(&dmu_pmu_notifier_chain, event, NULL);
+		ddr_pmu->start_flag = true;
+		ddr_pmu->used_flag = true;
+	} else if ((event == DDR_PMUV2_NOTICE_STOP) && ddr_pmu->start_flag) {
+		blocking_notifier_call_chain(&dmu_pmu_notifier_chain, event, NULL);
+		ddr_pmu->start_flag = false;
+		ddr_pmu->used_flag = false;
+	}
+}
+#endif
