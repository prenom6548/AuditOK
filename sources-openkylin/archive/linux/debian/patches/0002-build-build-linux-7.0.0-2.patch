+CBIOS_VOID  cbMulti_Matrix_CSC(CBIOS_S64 Multi_A[][3],CBIOS_S64 Multi_B[][3],CBIOS_S64 Multi_C[][3])
+{
+    CBIOS_U32 i,j,k;
+    CBIOS_S64 data;
+
+    for(i=0; i < 3; i++)
+    {
+        for(j=0; j < 3; j++)
+        {
+            data = 0;
+            for(k = 0; k < 3; k++)
+            {
+                data += Multi_A[i][k] * Multi_B[k][j];
+            }
+            Multi_C[i][j] = data;
+        }
+    }
+}
