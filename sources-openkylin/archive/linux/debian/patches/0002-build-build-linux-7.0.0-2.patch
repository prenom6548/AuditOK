+#if DRM_VERSION_CODE >= KERNEL_VERSION(5,11,0)
+static int gf_gem_object_vmap_wrapper(struct drm_gem_object *gem, struct DMABUF_PREFIX(map) *map)
+{
+    struct drm_gf_gem_object *obj= to_gf_bo(gem);
