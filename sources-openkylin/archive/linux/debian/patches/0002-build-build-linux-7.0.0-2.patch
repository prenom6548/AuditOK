+
+    if (HDCPModuleIndex >= HDCP_MODU_NUM)
+    {
+        cbDebugPrint((MAKE_LEVEL(GENERIC, ERROR), "%s: invalid HDCP module index!\n", FUNCTION_NAME));
+        return  CBIOS_FALSE;
