+    },
+
+    /* 3840x2160 ----> 1920x1080 */
+    {
+        WORD_CAT(3840,  2160),
+        WORD_CAT(1920,  1080),
+        WORD_CAT(9,     18),
+        WORD_CAT(9,     16),
+    },
+
+    /* 3840x2160 ----> 1920x1200 */
+    {
+        WORD_CAT(3840,  2160),
+        WORD_CAT(1920,  1200),
+        WORD_CAT(16,    32),
+        WORD_CAT(5,     9),
+    },
+
+    /* 3840x2160 ----> 1280x720 */
+    {
+        WORD_CAT(3840,  2160),
+        WORD_CAT(1280,  720),
+        WORD_CAT(10,    30),
+        WORD_CAT(3,     9),
+    },
+
+    /* 4096x2160 ----> 1920x1080 */
+    {
+        WORD_CAT(4096,  2160),
+        WORD_CAT(1920,  1080),
+        WORD_CAT(15,    32),
+        WORD_CAT(5,     10),
+    },
+
+    /* 4096x2160 ----> 1920x1200 */
+    {
+        WORD_CAT(4096,  2160),
+        WORD_CAT(1920,  1200),
+        WORD_CAT(15,    32),
+        WORD_CAT(5,     9),
+    },
+
+    /* 4096x2160 ----> 2048x1080 */
+    {
+        WORD_CAT(4096,  2160),
+        WORD_CAT(2048,  1080),
+        WORD_CAT(16,    32),
+        WORD_CAT(5,     10),
+    },
+
+    /* 4096x2160 ----> 2048x1200 */
+    {
+        WORD_CAT(4096,  2160),
+        WORD_CAT(2048,  1200),
+        WORD_CAT(16,    32),
+        WORD_CAT(5,     9),
+    },
+
+    /* 4096x2160 ----> 1280x720 */
+    {
+        WORD_CAT(4096,  2160),
+        WORD_CAT(1280,  720),
+        WORD_CAT(5,     16),
+        WORD_CAT(7,     21),
+    },
+
+    /* 1920x1080 ----> 1280x720 */
+    {
+        WORD_CAT(1920,  1080),
+        WORD_CAT(1280,  720),
+        WORD_CAT(12,    18),
+        WORD_CAT(10,    15),
