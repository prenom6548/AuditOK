+static ssize_t reg_read_store(struct device *dev,
+				      struct device_attribute *da,
+				      const char *buf, size_t size)
+{
+	struct i3c_device *i3c = dev_to_i3cdev(dev);
+	struct i3c_xfer xfers[2];
+	u8 status = 0;
+	long value;
+	__u8 reg;
+	__u8 val;
+
+	status = kstrtol(buf, 0, &value);
+	if (status)
+		return status;
+
+	reg = (__u8)value;
+
+	xfers[0].rnw = false;
+	xfers[0].len = 1;
+	xfers[0].data.out = &reg;
+
+	xfers[1].rnw = true;
+	xfers[1].len = 1;
+	xfers[1].data.in = &val;
+
+	i3c_bus_normaluse_lock(i3c->bus);
+	i3c_device_do_xfers(i3c, xfers, 2, I3C_SDR);
+	dev_info(dev, "reg read  reg =0x%x, val=%x\n", reg, val);
+	i3c_bus_normaluse_unlock(i3c->bus);
+
+	return size;
+}
+static DEVICE_ATTR_WO(reg_read);
+
+static ssize_t reg_write_store(struct device *dev,
+					struct device_attribute *da,
+					const char *buf, size_t size)
+{
+	struct i3c_device *i3c = dev_to_i3cdev(dev);
+	struct i3c_xfer xfers[2];
+	u8 status = 0;
+	char *p;
+	char *token;
+	long value;
+	__u8 reg;
+	u16 val;
+
+	p = kmalloc(size, GFP_KERNEL);
+	strscpy(p, buf, size);
+	token = strsep(&p, " ");
+
+	if (!token)
+		return -EINVAL;
+
+	status = kstrtol(token, 0, &value);
+	if (status)
+		return status;
+
+	reg = (u8)value;
+	token = strsep(&p, " ");
+	if (!token)
+		return -EINVAL;
+
+	status = kstrtol(token, 0, &value);
+	if (status)
+		return status;
+
+	val = ((u8)value << 8) | reg;
+	xfers[0].rnw = false;
+	xfers[0].len = 2;
+	xfers[0].data.out = &val;
+
+	i3c_bus_normaluse_lock(i3c->bus);
+	i3c_device_do_xfers(i3c, xfers, 1, I3C_SDR);
+	dev_info(dev, "reg write reg =0x%x, val=%x\n", reg, val);
+	i3c_bus_normaluse_unlock(i3c->bus);
+
+	kfree(p);
+	return size;
+}
+static DEVICE_ATTR_WO(reg_write);
