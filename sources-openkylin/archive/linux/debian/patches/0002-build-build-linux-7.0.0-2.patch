+static u32 i2c_phyt_get_clk_rate_khz(struct i2c_phyt_dev *dev)
+{
+	unsigned long rate = clk_get_rate(dev->clk);
+
+	if (!rate)
+		return 0;
+	return (u32)(rate / 1000);
