+
+/*------------------------------------------------------*/
+/* Register Mask					*/
+/*------------------------------------------------------*/
+/* MCI_CNTRL mask */
+#define MCI_CNTRL_CONTROLLER_RESET	(0x1 << 0) /* RW */
+#define MCI_CNTRL_FIFO_RESET		(0x1 << 1) /* RW */
