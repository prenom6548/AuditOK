+    CBIOS_U8          CLineRegWriteBitNum;
+    CBIOS_U8          CLineRegWriteEnableValue;  // equal port enable value for I2C
+    CBIOS_U8          CLineRegWriteEnableMask;   // equal port enable mask for I2C
+} CBIOS_I2C_REG_PARAMS, *PCBIOS_I2C_REG_PARAMS;
