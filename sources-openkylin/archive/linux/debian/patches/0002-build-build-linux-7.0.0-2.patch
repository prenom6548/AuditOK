+        break;
+    case OS_CALLBACK_POST_SYNCOBJ_EVENT:
+        adapter->post_sync_event_argu = argu;
+        adapter->post_sync_event      = func;
+        break;
+    case OS_CALLBACK_DRM_CB:
+        adapter->drm_cb = func;
+        adapter->drm_cb_argu = argu;
+        break;
+    default:
+        gf_error("unknown callback func type: %d.\n", type);
+        status = E_INVALIDARG;
+        break;
+    }
+
+    return status;
+}
