+        CBIOS_U32 bSupportReadRequest          :1;      //HDMI read request
+        CBIOS_U32 reserved                     :23;
+    } ChipCaps;
+    struct {
+        //for scaler
+        //upscaler
+        CBIOS_U32 ulMaxPUHorSrc;
+        CBIOS_U32 ulMaxPUHorDst;
+        CBIOS_U32 ulMaxPUVerSrc;
+        CBIOS_U32 ulMaxPUVerDst;
