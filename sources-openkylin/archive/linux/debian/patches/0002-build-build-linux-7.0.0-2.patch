+	.driver = {
+		.name		= "es8388",
+		.of_match_table = es8388_of_match,
+		.acpi_match_table = es8388_acpi_match,
+	},
+	.probe    = es8388_i2c_probe,
+	.id_table = es8388_id,
+};
+
+module_i2c_driver(es8388_i2c_driver);
