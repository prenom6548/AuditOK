+    int ret;
+
+    ret = kstrtouint_from_user(buf, size, 0, &offset);
+    if (ret)
+        return ret;
+
+    if ((offset >= 0x301FC) || (offset < 0x300A4))
+    {
+        debug_mmio->registers_offset = -1;
+        return -EINVAL;
+    }
+
+    debug_mmio->registers_offset = offset;
+    *pos += size;
+
+    return size;
+}
