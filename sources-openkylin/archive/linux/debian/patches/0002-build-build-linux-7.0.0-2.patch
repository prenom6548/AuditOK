+    VIP33760RegValue.Value = 0;
+    if((pCbiosVIPCtlData->modeSet.fmt == CBIOS_VIP_FMT_RGB444_24BIT_SDR) || (pCbiosVIPCtlData->modeSet.fmt == CBIOS_VIP_FMT_YCBCR444_24BIT_SDR))
+    {
