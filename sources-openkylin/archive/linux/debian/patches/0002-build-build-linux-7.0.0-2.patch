+void GF_API_CALL gf_byte_copy(char* dst, char* src, int len)
+{
+#ifdef __BIG_ENDIAN__
+
+    int i = 0;
+    int left;
+
+    for(i = 0; i < len/4; i++)
+    {
+        *(dst)   =  *(src+3);
+        *(dst+1) =  *(src+2);
+        *(dst+2) =  *(src+1);
+        *(dst+3) =  *(src);
+        dst     +=  4;
+        src     +=  4;
+    }
+
+    left = len & 3;
+
+    for(i = 0; i < left; i++)
+    {
+        *(dst+3-i) = *(src+i);
+    }
+
+#else
+    gf_memcpy(dst, src, len);
+#endif
+}
