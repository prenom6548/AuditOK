+    for (i = BuffLen; i > 0; i--)
+    {
+        pDataBuff[i - 1] = cb_ReadU8(pcbe->pAdapterContext, 0x83C9);
+    }
+
+    //restore SR47
+    cbMMIOWriteReg(pcbe, SR_47, SR47Value, 0x00);
