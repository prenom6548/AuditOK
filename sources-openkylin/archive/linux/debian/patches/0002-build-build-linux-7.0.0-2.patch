+void  gf_crtc_helper_disable(struct drm_crtc *crtc)
+{
+    gf_info("CRTC disable: to turn off screen of crtc: %d\n", crtc->index);
+
+    gf_crtc_dpms_onoff_helper(crtc, 0);
+
+    drm_crtc_vblank_off(crtc);
