+            unsigned char fb_idx;
+            unsigned long long fb_addr;
+        }fb;
+
+        struct
+        {
+            unsigned int mode_num;
+            gf_vip_mode_t *mode;
+        }caps;
+    };
+}gf_vip_set_t;
+
+void disp_register_vip_capture(disp_info_t *disp_info);
+void disp_unregister_vip_capture(disp_info_t *disp_info);
