+static gf_plane_t* disp_gene_plane_create(disp_info_t* disp_info, int index, GF_PLANE_TYPE plane_type)
+{
+    gf_card_t *gf_card = disp_info->gf_card;
+    struct drm_device *drm = gf_card->drm_dev;
