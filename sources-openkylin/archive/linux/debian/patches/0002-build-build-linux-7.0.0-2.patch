+CBIOS_U8 cbGetBitsNum(CBIOS_U32 N)
+{
+    CBIOS_U8 Num;
+
+    for(Num=0; N!=0; Num++)
+    {
+        N &= ~(GET_LAST_BIT(N));
+    }
+
+    return Num;
+}
