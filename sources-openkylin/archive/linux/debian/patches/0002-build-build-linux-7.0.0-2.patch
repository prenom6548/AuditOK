+
+	memset(msg, 0, sizeof(struct phytcodec_cmd));
+	msg->cmd_para.rw_data.addr = arg1;
+	msg->cmd_para.rw_data.reg = arg2;
+	msg->cmd_para.rw_data.val = arg3;
