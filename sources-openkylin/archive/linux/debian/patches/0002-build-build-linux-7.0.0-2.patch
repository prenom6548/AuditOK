+static ssize_t gf_mmio_counter_read(struct file *f, char __user *buf,
+                    size_t size, loff_t *pos)
+{
+    gf_debugfs_node_t* node = file_inode(f)->i_private;
+    gf_debugfs_mmio_t *debug_mmio = &node->dev->mmio;
+    adapter_info_t *ainfo = &node->dev->gf->adapter_info;
+    unsigned int mmio_size = ainfo->mmio_size + 1;
+    unsigned char *mmio_base = ainfo->mmio;
+    int offset = debug_mmio->registers_offset;
+    int len = debug_mmio->registers_len, i;
+    unsigned int value = 0;
+
+    if (*pos >= (len * sizeof(value)))
+        return 0;
+
+    if ((len < 0) || (offset < 0))
+        return -EINVAL;
+
+    if (size % sizeof(value))
+        return -EINVAL;
+
+    offset += *pos;
+
+    for (i = 0; i < (size / sizeof(value)); i++)
+    {
+        if ((offset + i * sizeof(value)) >= 0x301FC)
+        {
+            gf_error("debugfs counter read reach limit\n");
+            return -EPERM;
+        }
+
+        value = gf_read32(mmio_base + offset + i * sizeof(value));
+        put_user(value, (uint32_t __user *)buf);
+        buf += sizeof(value);
+        *pos += sizeof(value);
+
+        if (*pos >= (len * sizeof(value)))
+            break;
+    }
+
+    return i * sizeof(value);
+}
+
+static ssize_t gf_mmio_counter_write(struct file *f, const char __user *buf,
+                                         size_t size, loff_t *pos)
+{
+    gf_debugfs_node_t* node = file_inode(f)->i_private;
+    gf_debugfs_mmio_t *debug_mmio = &node->dev->mmio;
+    adapter_info_t *ainfo = &node->dev->gf->adapter_info;
+    unsigned int mmio_size = ainfo->mmio_size + 1;
+    unsigned char *mmio_base = ainfo->mmio;
+    int offset = debug_mmio->registers_offset;
+    int len = debug_mmio->registers_len, i;
+    unsigned int value = 0;
+
+    if ((len < 0) || (offset < 0))
+        return -EINVAL;
+
+    if (size % sizeof(value))
+        return -EINVAL;
+
+    offset += *pos;
+
+    for (i = 0; i < (size / sizeof(value)); i++)
+    {
+        if ((offset + i * sizeof(value)) >= 0x301FC)
+        {
+            gf_error("debugfs counter write reach limit\n");
+            return -EPERM;
+        }
+
+        get_user(value, (uint32_t __user *)buf);
+        gf_write32(mmio_base + offset + i * sizeof(value), value);
+        buf += sizeof(value);
+        *pos += sizeof(value);
+
+        if (*pos >= (len * sizeof(value)))
+            break;
+    }
+
+    return size;
+}
