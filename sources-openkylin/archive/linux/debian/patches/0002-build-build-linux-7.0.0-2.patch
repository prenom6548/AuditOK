+        CBIOS_U16  GPIO_OUT        :1;     //Output Data
+        CBIOS_U16  GPIO_IE         :1;     //Input Enable
+        CBIOS_U16  IP_SL_1         :1;
+        CBIOS_U16  GPIO_Data_In    :1;     //Input Data
+        CBIOS_U16  Reserved        :3;
+    };
