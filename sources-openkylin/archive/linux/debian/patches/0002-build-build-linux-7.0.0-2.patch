+static const char *get_arm64_model_name(char *model_name, size_t len)
+{
+	u32 midr = read_cpuid_id();
+
+	model_name[0] = '\0';
+	if (!dmi_walk(find_dmi_processor_version, model_name) && model_name[0])
+		return model_name;
+
+	snprintf(model_name, len, "ARMv8 Processor rev %d (%s)",
+		 MIDR_REVISION(midr), COMPAT_ELF_PLATFORM);
+
+	return model_name;
+}
