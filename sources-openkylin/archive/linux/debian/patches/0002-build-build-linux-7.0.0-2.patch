+    DPCtrl2RegMask.SW_MPLL_M_1 = 0;
+    DPCtrl2RegMask.SW_MPLL_P_1 = 0;
+    DPCtrl2RegMask.SW_MPLL_M_2 = 0;
+    DPCtrl2RegMask.SW_MPLL_P_2 = 0;
