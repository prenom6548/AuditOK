+
+static void i2c_phyt_timer_handle(struct timer_list *t)
+{
+	struct i2c_phyt_dev *dev = timer_container_of(dev, t, timer);
+
+	if (dev->alive_enabled && dev->watchdog)
+		dev->watchdog(dev);
+
+	mod_timer(&dev->timer, jiffies + msecs_to_jiffies(2000));
+}
