+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+
+
+examples:
+  - |
+    i2s_v2: i2s@27010000 {
+	compatible = "phytium,i2s-2.0";
+	reg = <0x0 0x27010000 0x0 0x800>,
+		  <0x0 0x26fe3000 0x0 0x100>,
+		  <0x0 0x18000000 0x0 0x1000>;
+	interrupts = <GIC_SPI 110 IRQ_TYPE_LEVEL_HIGH>,
+                <GIC_SPI 83 IRQ_TYPE_LEVEL_HIGH>;
+	clocks = <&sysclk_1200mhz>;
+	clock-names = "i2s_clk";
