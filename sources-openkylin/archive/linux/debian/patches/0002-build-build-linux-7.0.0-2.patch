+        disp_info->firmware_version = vbeinfo.FwVersion;
+        gf_memcpy(disp_info->firmware_name, vbeinfo.FwName, sizeof(vbeinfo.FwName));
+
+        gf_info("bios supported device: 0x%x\n", disp_info->support_output);
