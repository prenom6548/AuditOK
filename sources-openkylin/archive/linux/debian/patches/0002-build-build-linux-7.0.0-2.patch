+#define CBIOS_GPIO0_BIT_MASK   (BIT18)
+#define CBIOS_GPIO1_BIT_MASK   (BIT21)
+
+// MM8504's interrupt bits
+#define CBIOS_GPIO3_BIT_MASK  (BIT20)
+#define CBIOS_GPIO4_BIT_MASK  (BIT19)
