+static ssize_t gf_mmio_counter_offset_write(struct file *f, const char __user *buf,
+                                         size_t size, loff_t *pos)
+{
+    gf_debugfs_node_t* node = file_inode(f)->i_private;
+    gf_debugfs_mmio_t *debug_mmio = &node->dev->mmio;
