+CBIOS_STATUS cbDSI_SetDisplayOnOff(PCBIOS_VOID pvcbe, CBIOS_BOOL bTurnOn, CBIOS_DSI_INDEX DSIIndex)
+{
+    PCBIOS_EXTENSION_COMMON pcbe = (PCBIOS_EXTENSION_COMMON)pvcbe;
+    CBIOS_STATUS Status;
+    CBIOS_U8     Buf[0x01] = {DSI_DCS_SET_DISPLAY_ON};
