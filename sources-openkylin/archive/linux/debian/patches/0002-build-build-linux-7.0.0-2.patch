+#define CBIOS_GPIO0       0
+#define CBIOS_GPIO1       1
+#define CBIOS_GPIO2       2
+#define CBIOS_GPIO3       3
+#define CBIOS_GPIO4       4
+#define CBIOS_GPIO5       5
