/*!
    \module UkuiQuickItems
    \title Ukui Quick Items C++ Classes
    \brief 提供Ukui Quick Items模块的C++类实现.
*/

/*!
    \qmlmodule org.ukui.quick.items 1.0
    \title Ukui Quick Items QML Types
    \brief 提供构造UI界面的基础QML组件.

    本模块提供了一系列QML组件，用于快速构建符合UKUI设计规范的用户界面。
    所有组件都支持主题系统，能够自动跟随系统主题变化。
*/

/*!
    \page ukui-quick-items.html
    \title Ukui Quick Items

    \section1 概述

    Ukui Quick Items是一个QML组件库，提供构造UI界面的基础组件，
    包括背景、图标、菜单、按钮、特效组件等。所有组件都支持主题系统，
    能够自动跟随系统主题变化。

    \section1 主要功能

    \list
    \li \b{背景组件} - 提供Background、DtThemeBackground等背景组件，支持颜色混合、渐变、阴影等效果
    \li \b{图标组件} - 提供Icon组件，支持主题图标、高亮、禁用、角标、统一底板等多种显示模式
    \li \b{菜单组件} - 提供Menu、MenuItem等菜单组件，方便创建上下文菜单
    \li \b{按钮组件} - 提供Button、IconButton等按钮组件，支持多种交互状态
    \li \b{颜色混合} - 提供ColorMix组件，支持多种颜色混合模式
    \li \b{工具提示} - 提供ToolTip，方便为组件添加提示信息
    \li \b{特效组件} - 提供ShadowedRectangle，支持阴影、渐变边框等效果
    \li \b{文本输入} - 提供SearchLineEdit搜索框组件，支持上下文菜单
    \endlist

    \section1 使用方法

    在QML文件中导入模块：
    \qml
    import org.ukui.quick.items 1.0
    import org.ukui.quick.platform 1.0
    \endqml

    \section1 QML 类型

    本模块提供以下QML类型：

    \section2 按钮组件

    \list
    \li \b{Button} - 基础按钮组件，支持图标、文本
    \li \b{IconButton} - 图标按钮组件
    \li \b{HoverButton} - 圆形按钮组件，支持悬停和按下状态的视觉反馈
    \li \b{DtThemeButton} - DT主题按钮组件，适配DT主题样式
    \endlist

    \section2 背景主题组件

    \list
    \li \b{DtThemeBackground} - DT主题背景组件
    \li \b{StyleBackground} - 背景组件
    \li \b{DtDropShadow} - DT风格投影组件
    \endlist

    \section2 文本组件

    \list
    \li \b{StyleText} - 文本组件
    \li \b{DtThemeText} - DT主题文本组件
    \endlist

    \section2 输入组件

    \list
    \li \b{SearchLineEdit} - 搜索框组件，带上下文菜单支持
    \li \b{TouchSlider} - 触摸滑块组件
    \endlist

    \section2 其他组件

    \list
    \li \b{KBllonTip} - 气球提示组件
    \li \b{DtThemeScrollBar} - DT主题滚动条组件
    \endlist

    \sa {Ukui Quick Platform}, {Ukui Quick Framework}
*/