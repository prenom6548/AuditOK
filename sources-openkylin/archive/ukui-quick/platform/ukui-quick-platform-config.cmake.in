@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt@QT_VERSION_MAJOR@Core "@REQUIRED_QT_VERSION@")
find_dependency(Qt@QT_VERSION_MAJOR@Widgets @REQUIRED_QT_VERSION@)
find_dependency(Qt@QT_VERSION_MAJOR@Qml @REQUIRED_QT_VERSION@)
find_dependency(Qt@QT_VERSION_MAJOR@Quick @REQUIRED_QT_VERSION@)
if (QT_VERSION_MAJOR EQUAL "5")
    find_dependency(Qt@QT_VERSION_MAJOR@X11Extras @REQUIRED_QT_VERSION@)
    find_dependency(KF5Wayland)
elseif (QT_VERSION_MAJOR EQUAL "6")
    find_package(KWayland)
endif()
find_dependency(Qt@QT_VERSION_MAJOR@DBus @REQUIRED_QT_VERSION@)

if(TARGET Qt6::Core)
    find_dependency(Qt6Core5Compat @REQUIRED_QT_VERSION@)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ukui-quick-platform-targets.cmake")