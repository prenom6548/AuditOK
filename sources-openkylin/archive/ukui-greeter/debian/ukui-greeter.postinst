#!/bin/sh
  
set -e

# copy kylin-config to /etc/kylin-config/basic/
if [ -f "/usr/share/ukui-greeter/kylin-config/ukui-greeter.yaml" ]; then
    mkdir -p /etc/kylin-config/basic/
    cp /usr/share/ukui-greeter/kylin-config/ukui-greeter.yaml /etc/kylin-config/basic/ukui-greeter.yaml
fi

# copy limit files
if [ -f "/usr/share/ukui-greeter/kylin-config/org.ukui.GreeterDaemon.yaml" ]; then
    mkdir -p /etc/kylin-config/basic/
    cp /usr/share/ukui-greeter/kylin-config/org.ukui.GreeterDaemon.yaml /etc/kylin-config/basic/org.ukui.GreeterDaemon.yaml
fi

if [ -x /usr/share/kylin-system-updater/kylin-reboot-required ]; then
    #执行请求重启提示
    /usr/share/kylin-system-updater/kylin-reboot-required
fi

