<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-Bus Object Introspection 1.0//EN"
                      "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.ukui.Magnifier">
    <!--
      StartZoom: 启动缩放效果
      @param1: 缩放模式 (u) - 无符号整数
      enum zoom_type {
          ZOOM_OUTPUT = 0,
          ZOOM_WINDOW,
      };
      @param2: 缩放比例 (u) - 无符号整数
      Returns: 操作是否成功 (b) - 布尔值
    -->
    <method name="StartZoom">
      <arg name="mode" type="u" direction="in"/>
      <arg name="scale" type="u" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>

    <!--
      SetMagnifierMode: 设置放大镜模式
      @mode: 模式类型 (u) - 无符号整数
      Returns: 操作是否成功 (b) - 布尔值
    -->
    <method name="SetMagnifierMode">
      <arg name="mode" type="u" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>

    <!--
      ZoomIn: 放大
      Returns: 操作是否成功 (b) - 布尔值
    -->
    <method name="ZoomIn">
      <arg name="success" type="b" direction="out"/>
    </method>

    <!--
      ZoomOut: 缩小
      Returns: 操作是否成功 (b) - 布尔值
    -->
    <method name="ZoomOut">
      <arg name="success" type="b" direction="out"/>
    </method>

    <!--
      IsZooming: 检查是否正在缩放
      Returns: 是否正在缩放 (b) - 布尔值
    -->
    <method name="IsZooming">
      <arg name="zooming" type="b" direction="out"/>
    </method>

    <!--
      GetScale: 获取当前缩放值
      Returns: 当前缩放值 (i) - 整数
    -->
    <method name="GetScale">
      <arg name="scale" type="i" direction="out"/>
    </method>

    <!--
      StopZoom: 停止缩放效果
      无参数，无返回值
    -->
    <method name="StopZoom">
    </method>

    <signal name="scaleChanged">
      <arg name="newScale" type="u" direction="out"/>
    </signal>

    <signal name="zoomStop">
    </signal>
  </interface>
</node>
