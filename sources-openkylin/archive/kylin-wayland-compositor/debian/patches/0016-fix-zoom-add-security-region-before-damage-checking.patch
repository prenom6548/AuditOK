+static inline enum kywc_stream_cursor_mode get_cursor_mode(uint32_t mode)
+{
+    return mode == CURSOR_MODE_EMBEDDED ? KYWC_STREAM_CURSOR_MODE_EMBEDDED
+                                        : KYWC_STREAM_CURSOR_MODE_HIDDEN;
+}
