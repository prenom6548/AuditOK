+static void drag_handle_pointer_enter(struct wlr_seat_pointer_grab *grab,
+                                      struct wlr_surface *surface, double sx, double sy)
+{
+    struct drag *drag = grab->data;
+    drag_set_focus(drag, surface, sx, sy);
+}
