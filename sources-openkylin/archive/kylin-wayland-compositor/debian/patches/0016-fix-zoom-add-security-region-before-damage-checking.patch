+static void transfer_destroy(struct icon_transfer *transfer)
+{
+    if (!transfer) {
+        return;
+    }
+
+    if (transfer->event_source) {
+        wl_event_source_remove(transfer->event_source);
+    }
+
+    close(transfer->fd);
+    free(transfer->remain_buffer);
+    free(transfer);
+}
+
+static int write_icon_data(int fd, uint32_t mask, void *data)
+{
+    struct icon_transfer *transfer = data;
+
+    int remain_size = transfer->remain_size - transfer->start;
+    if (remain_size <= 0) {
+        transfer_destroy(transfer);
+        return 0;
+    }
+
+    ssize_t len = write(fd, transfer->remain_buffer + transfer->start, remain_size);
+    if (len == -1) {
+        kywc_log_errno(KYWC_ERROR, "write error to target fd %d", fd);
+        transfer_destroy(transfer);
+        return 0;
+    }
+
+    kywc_log(KYWC_DEBUG, "write %zd (remaining %d) of %ld bytes to fd %d", len, remain_size,
+             transfer->remain_size, fd);
+
+    if (len < remain_size) {
+        transfer->start += len;
+        return 1;
+    }
+
+    kywc_log(KYWC_DEBUG, "transfer complete");
+    transfer_destroy(transfer);
+    return 0;
+}
