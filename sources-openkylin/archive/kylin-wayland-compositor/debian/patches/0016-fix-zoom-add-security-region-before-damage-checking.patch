+static bool security_selection_handle_access(struct security *security,
+                                             const struct security_action_info *info, void *data)
+{
+    // the actor is the source for write/start, and the destination for read/drop
+    const struct client *client = NULL, *source = NULL;
+    const char *action_name = NULL;
+    static const char *client_type[] = { "unknown", "wayland", "x11", "dbus" };
+
+    switch (info->action) {
+    case SECURITY_WRITE_SELECTION:
+        action_name = info->selection.primary ? "primary selection write" : "selection write";
+        client = info->selection.source;
+        break;
+    case SECURITY_READ_SELECTION:
+        action_name = info->selection.primary ? "primary selection read" : "selection read";
+        client = info->selection.destination;
+        source = info->selection.source;
+        break;
+    case SECURITY_START_DRAG:
+        action_name = "drag start";
+        client = info->dnd.source;
+        break;
+    case SECURITY_DROP:
+        action_name = "drop";
+        client = info->dnd.destination;
+        source = info->dnd.source;
+        break;
+    default:
+        return true;
+    }
+
+    if (!client) {
+        return true;
+    }
+
+    if (source) {
+        char *launcher = client_get_environ(source->pid, "LAUNCHED_FROM");
+        bool secure_source = launcher != NULL;
+        free(launcher);
+
+        launcher = client_get_environ(client->pid, "LAUNCHED_FROM");
+        bool secure_destination = launcher != NULL;
+        free(launcher);
+
+        bool allow = secure_source ? secure_destination : true;
+
+        kywc_log(KYWC_INFO, "%s by %s(%s %d) from %s(%s %d) %d", action_name, client->comm,
+                 client_type[client->type], client->pid, source->comm, client_type[source->type],
+                 source->pid, allow);
+
+        return allow;
+    }
+
+    // write to selection and start_drag is allowed
+    kywc_log(KYWC_INFO, "%s by %s(%s %d)", action_name, client->comm, client_type[client->type],
+             client->pid);
+    return true;
+}
+
+static const struct security_interface security_selection_impl = {
+    .access = security_selection_handle_access,
+};
