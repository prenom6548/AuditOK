+static bool portal_stream_create_from_toplevel(struct portal_session *session, char *uuid)
+{
+    if (!session || !uuid) {
+        return false;
+    }
+
+    struct portal_context *ctx = session->ctx;
+    kywc_stream *stream = NULL;
+    if (session->type == PORTAL_SESSION_TYPE_REMOTE_DESKTOP) {
