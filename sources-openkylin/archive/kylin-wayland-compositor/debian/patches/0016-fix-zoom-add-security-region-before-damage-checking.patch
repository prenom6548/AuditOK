+++ b/portal/stream.c
@@ -0,0 +1,1171 @@
+// SPDX-FileCopyrightText: 2026 KylinSoft Co., Ltd.
+//
+// SPDX-License-Identifier: GPL-1.0-or-later
+
+#define _POSIX_C_SOURCE 200809L
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "portal.h"
+#include "stream.h"
+#include "util/dialog.h"
+#include "util/event.h"
+#include "util/nls.h"
+#include "util/spawn.h"
