         security_view_destroy(view);
     }
 
+    if (security->selection) {
+        /* make the security inert */
+        security->interface->security_set_user_data(security->selection, NULL);
+        security->interface->security_unref(security->selection);
+    }
+
     free(security->image_data);
     free(security);
     security = NULL;
@@ -406,6 +481,13 @@ static bool security_plugin_setup(void *plugin, void **teardown_data)
     security->interface->security_add_global_filter(security->global, security_filter_global,
