diff --git a/src/util/file.c b/src/util/file.c
index 16a9fe1..498db4a 100644
--- a/src/util/file.c
+++ b/src/util/file.c
@@ -337,3 +337,40 @@ out:
 
     return pictures_dir;
 }
+
+bool file_mkdir_p(const char *path)
+{
+    if (STRING_INVALID(path)) {
+        return false;
+    }
+
+    char *tmp = strdup(path);
+    if (!tmp) {
+        return false;
+    }
+
+    size_t len = strlen(tmp);
+    while (len > 1 && tmp[len - 1] == '/') {
+        tmp[--len] = '\0';
+    }
+
+    char *p = tmp + 1;
+    while (*p) {
+        if (*p == '/') {
+            while (*(p + 1) == '/') {
+                p++;
+            }
+            *p = '\0';
+            if (mkdir(tmp, 0755) != 0 && errno != EEXIST) {
+                free(tmp);
+                return false;
+            }
+            *p = '/';
+        }
+        p++;
+    }
+
+    bool ret = (mkdir(tmp, 0755) == 0 || errno == EEXIST);
+    free(tmp);
+    return ret;
+}
