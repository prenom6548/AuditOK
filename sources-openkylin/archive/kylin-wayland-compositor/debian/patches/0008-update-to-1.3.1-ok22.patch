+                               "Introspect", NULL, &reply, NULL, NULL);
+    if (r < 0) {
+        kywc_log(KYWC_ERROR, "Failed to Introspect %s", service);
+    } else {
+        const char *xml = NULL;
+        r = sd_bus_message_read(reply, "s", &xml);
