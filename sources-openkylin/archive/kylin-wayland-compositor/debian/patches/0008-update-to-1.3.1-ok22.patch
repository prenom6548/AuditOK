+)
diff --git a/examples/lib/src/buffer.c b/examples/lib/src/buffer.c
new file mode 100644
index 0000000..9425b60
--- /dev/null
+++ b/examples/lib/src/buffer.c
@@ -0,0 +1,260 @@
+// SPDX-FileCopyrightText: 2026 KylinSoft Co., Ltd.
+//
+// SPDX-License-Identifier: GPL-1.0-or-later
+
+#define _GNU_SOURCE
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <gbm.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "linux-dmabuf-v1-client-protocol.h"
+#include "wlu_private.h"
+
+static inline uint32_t get_shm_format(enum wlu_format format)
+{
+    switch (format) {
+    case WLU_FORMAT_XRGB8888:
+        return WL_SHM_FORMAT_XRGB8888;
+    case WLU_FORMAT_ARGB8888:
+        return WL_SHM_FORMAT_ARGB8888;
+    case WLU_FORMAT_BGRX8888:
+        return WL_SHM_FORMAT_BGRX8888;
+    case WLU_FORMAT_BGRA8888:
+        return WL_SHM_FORMAT_BGRA8888;
+    default:
+        assert(0);
+        break;
+    }
+}
+
+static inline uint32_t get_drm_format(enum wlu_format format)
+{
+    switch (format) {
+    case WLU_FORMAT_XRGB8888:
+        return DRM_FORMAT_XRGB8888;
+    case WLU_FORMAT_ARGB8888:
+        return DRM_FORMAT_ARGB8888;
+    case WLU_FORMAT_BGRX8888:
+        return DRM_FORMAT_BGRX8888;
+    case WLU_FORMAT_BGRA8888:
+        return DRM_FORMAT_BGRA8888;
+    default:
+        assert(0);
+        break;
+    }
+}
+
+static inline int create_anonymous_file(size_t size)
+{
+    int fd = memfd_create("wlu-shared", MFD_CLOEXEC | MFD_ALLOW_SEALING | MFD_NOEXEC_SEAL);
+    if (fd < 0 && errno == EINVAL && MFD_NOEXEC_SEAL != 0) {
+        fd = memfd_create("wlu-shared", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+    }
+    if (fd >= 0) {
+        fcntl(fd, F_ADD_SEALS, F_SEAL_SHRINK);
+    }
+
+    if (ftruncate(fd, size) < 0) {
+        close(fd);
+        return -1;
+    }
+
+    return fd;
+}
+
+static void compositor_release_buffer(void *data, struct wl_buffer *buffer)
+{
+    struct wlu_buffer *wlu_buffer = data;
+    wlu_buffer->compositor_using = false;
+
+    // 服务器超时占用跳过渲染，释放后尝试渲染
+    wlu_window_try_invoke_draw(wlu_buffer->window);
+}
+
+static const struct wl_buffer_listener buffer_listener = {
+    .release = compositor_release_buffer,
+};
+
+static bool buffer_init_shm(struct wlu_buffer *buffer, struct wlu_display *display)
+{
+    const int32_t width = buffer->width;
+    const int32_t height = buffer->height;
+    const int32_t stride = width * display->shm_formats[buffer->format].bytes_per_pixel;
+    size_t size = stride * height;
+    int fd = create_anonymous_file(size);
+    if (fd < 0) {
+        fprintf(stderr, "creating a buffer file for %ld B failed: %s\n", size, strerror(errno));
+        return false;
+    }
+
+    void *data = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (data == MAP_FAILED) {
+        fprintf(stderr, "mmap failed: %s\n", strerror(errno));
+        close(fd);
+        return false;
+    }
+
+    struct wl_shm_pool *pool = wl_shm_create_pool(display->shm, fd, size);
+    struct wl_buffer *wl_buffer =
+        wl_shm_pool_create_buffer(pool, 0, width, height, stride, get_shm_format(buffer->format));
+    wl_buffer_add_listener(wl_buffer, &buffer_listener, buffer);
+    wl_shm_pool_destroy(pool);
+    close(fd);
+
+    buffer->buffer = wl_buffer;
+    buffer->data.shm.size = size;
+    buffer->data.shm.data = data;
+    return true;
+}
+
+static void linux_buffer_create_succeeded(void *data, struct zwp_linux_buffer_params_v1 *params,
+                                          struct wl_buffer *new_buffer)
+{
+    struct wlu_buffer *buffer = data;
+    buffer->buffer = new_buffer;
+    wl_buffer_add_listener(buffer->buffer, &buffer_listener, buffer);
+    zwp_linux_buffer_params_v1_destroy(params);
+}
+
+static void linux_buffer_create_failed(void *data, struct zwp_linux_buffer_params_v1 *params)
+{
+    struct wlu_buffer *buffer = data;
+    buffer->buffer = NULL;
+    zwp_linux_buffer_params_v1_destroy(params);
+}
+
+static const struct zwp_linux_buffer_params_v1_listener linux_buffer_params_listener = {
+    .created = linux_buffer_create_succeeded,
+    .failed = linux_buffer_create_failed,
+};
+
+static bool buffer_init_dmabuf(struct wlu_buffer *buffer, struct wlu_display *display)
+{
+    int32_t format = get_drm_format(buffer->format);
+
+    struct gbm_bo *gbm_bo = gbm_bo_create(display->gbm.device, buffer->width, buffer->height,
+                                          format, GBM_BO_USE_RENDERING);
+    if (!gbm_bo) {
+        fprintf(stderr, "Failed to create gbm_bo\n");
+        return false;
+    }
+    int fd = gbm_bo_get_fd(gbm_bo);
+    uint32_t stride = gbm_bo_get_stride(gbm_bo);
+    uint32_t offset = gbm_bo_get_offset(gbm_bo, 0);
+    uint64_t modifier = gbm_bo_get_modifier(gbm_bo);
+
+    struct zwp_linux_buffer_params_v1 *params = zwp_linux_dmabuf_v1_create_params(display->dmabuf);
+    zwp_linux_buffer_params_v1_add(params, fd, 0, offset, stride, modifier >> 32,
+                                   modifier & 0xffffffff);
+    zwp_linux_buffer_params_v1_add_listener(params, &linux_buffer_params_listener, buffer);
+    zwp_linux_buffer_params_v1_create(params, buffer->width, buffer->height, format, 0);
+    // 立马执行linux_buffer_create_succeeded
+    wl_display_roundtrip(display->display);
+    if (buffer->buffer == NULL) {
+        fprintf(stderr, "Failed to create zwp_linux_buffer_params\n");
+        gbm_bo_destroy(gbm_bo);
+        return false;
+    }
+
+    // clang-format off
+    EGLAttrib image_attribs[] = {
+		EGL_WIDTH, buffer->width,
+		EGL_HEIGHT, buffer->height,
+		EGL_LINUX_DRM_FOURCC_EXT, format,
+        EGL_DMA_BUF_PLANE0_FD_EXT, fd,
+        EGL_DMA_BUF_PLANE0_OFFSET_EXT, offset,
+        EGL_DMA_BUF_PLANE0_PITCH_EXT, stride,
+		EGL_NONE
+	};
+    // clang-format on
+    EGLImage egl_image = eglCreateImage(display->egl_display, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT,
+                                        NULL, image_attribs);
+    close(fd);
+    if (egl_image == EGL_NO_IMAGE_KHR) {
+        fprintf(stderr, "EGLImageKHR creation failed\n");
+        gbm_bo_destroy(gbm_bo);
+        return false;
+    }
+
+    GLuint gl_texture;
+    glGenTextures(1, &gl_texture);
+    glBindTexture(GL_TEXTURE_2D, gl_texture);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    buffer->window->egl.image_target_texture_2d(GL_TEXTURE_2D, egl_image);
+
+    GLuint gl_fbo;
+    glGenFramebuffers(1, &gl_fbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, gl_fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, gl_texture, 0);
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+        fprintf(stderr, "FBO creation failed\n");
+        eglDestroyImage(display->egl_display, egl_image);
+        gbm_bo_destroy(gbm_bo);
+        return false;
+    }
+
+    buffer->data.egl.bo = gbm_bo;
+    buffer->data.egl.image = egl_image;
+    buffer->data.egl.texture = gl_texture;
+    buffer->data.egl.fbo = gl_fbo;
+    return true;
+}
+
+struct wlu_buffer *wlu_buffer_create(struct wlu_window *window)
+{
+    struct wlu_buffer *buffer = calloc(1, sizeof(*buffer));
+    if (buffer == NULL) {
+        return NULL;
+    }
+    buffer->width = window->width;
+    buffer->height = window->height;
+    buffer->format = window->buffer_format;
+    buffer->type = window->buffer_type;
+    buffer->window = window;
+
+    if (buffer->type == WLU_WINDOW_BUFFER_TYPE_SHM) {
+        if (!buffer_init_shm(buffer, window->display)) {
+            wlu_buffer_destroy(buffer);
+            return NULL;
+        }
+    } else if (buffer->type == WLU_WINDOW_BUFFER_TYPE_DMABUF_EGL) {
+        if (!buffer_init_dmabuf(buffer, window->display)) {
+            wlu_buffer_destroy(buffer);
+            return NULL;
+        }
+    }
+
+    return buffer;
+}
+
+void wlu_buffer_destroy(struct wlu_buffer *buffer)
+{
+    if (buffer->buffer) {
+        wl_buffer_destroy(buffer->buffer);
+    }
+
+    if (buffer->type == WLU_WINDOW_BUFFER_TYPE_SHM) {
+        if (buffer->data.shm.data) {
+            munmap(buffer->data.shm.data, buffer->data.shm.size);
+        }
+    } else if (buffer->type == WLU_WINDOW_BUFFER_TYPE_DMABUF_EGL) {
+        if (buffer->data.egl.image) {
+            eglDestroyImage(buffer->window->display->egl_display, buffer->data.egl.image);
+        }
+        if (buffer->data.egl.bo) {
+            gbm_bo_destroy(buffer->data.egl.bo);
+        }
+    }
+
+    free(buffer);
+}
diff --git a/examples/lib/src/display.c b/examples/lib/src/display.c
new file mode 100644
index 0000000..69225ca
--- /dev/null
+++ b/examples/lib/src/display.c
@@ -0,0 +1,319 @@
+// SPDX-FileCopyrightText: 2026 KylinSoft Co., Ltd.
+//
+// SPDX-License-Identifier: GPL-1.0-or-later
+
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <gbm.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "linux-dmabuf-v1-client-protocol.h"
+#include "wlu_private.h"
+
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+
+static void xdg_wm_base_ping(void *data, struct xdg_wm_base *xdg_wm_base, uint32_t serial)
+{
+    xdg_wm_base_pong(xdg_wm_base, serial);
+}
+
+static const struct xdg_wm_base_listener xdg_wm_base_listener = {
+    .ping = xdg_wm_base_ping,
+};
+
+static void seat_capabilities(void *data, struct wl_seat *seat, enum wl_seat_capability caps)
+{
+    struct wlu_display *display = data;
+
+    if ((caps & WL_SEAT_CAPABILITY_KEYBOARD) && !display->keyboard) {
+        display->keyboard = wl_seat_get_keyboard(seat);
+        wl_keyboard_add_listener(display->keyboard, wlu_input_keyboard_listener(), display);
+    } else if (!(caps & WL_SEAT_CAPABILITY_KEYBOARD) && display->keyboard) {
+        wl_keyboard_destroy(display->keyboard);
+        display->keyboard = NULL;
+    }
+
+    if ((caps & WL_SEAT_CAPABILITY_POINTER) && !display->pointer) {
+        display->pointer = wl_seat_get_pointer(seat);
+        wl_pointer_add_listener(display->pointer, wlu_input_pointer_listener(), display);
+    } else if (!(caps & WL_SEAT_CAPABILITY_POINTER) && display->pointer) {
+        wl_pointer_destroy(display->pointer);
+        display->pointer = NULL;
+    }
+}
+
+static const struct wl_seat_listener seat_listener = {
+    .capabilities = seat_capabilities,
+};
+
+static void shm_format(void *data, struct wl_shm *wl_shm, uint32_t format)
+{
+    struct wlu_display *display = data;
+
+    switch (format) {
+    case WL_SHM_FORMAT_XRGB8888:
+        wlu_shm_format_init(&display->shm_formats[WLU_FORMAT_XRGB8888], 4, format);
+        break;
+    case WL_SHM_FORMAT_ARGB8888:
+        wlu_shm_format_init(&display->shm_formats[WLU_FORMAT_ARGB8888], 4, format);
+        break;
+    case WL_SHM_FORMAT_BGRX8888:
+        wlu_shm_format_init(&display->shm_formats[WLU_FORMAT_BGRX8888], 4, format);
+        break;
+    case WL_SHM_FORMAT_BGRA8888:
+        wlu_shm_format_init(&display->shm_formats[WLU_FORMAT_BGRA8888], 4, format);
+        break;
+    default:
+        break;
+    }
+}
+
+struct wl_shm_listener shm_listener = {
+    .format = shm_format,
+};
+
+static void dmabuf_modifiers(void *data, struct zwp_linux_dmabuf_v1 *zwp_linux_dmabuf,
+                             uint32_t format, uint32_t modifier_hi, uint32_t modifier_lo)
+{
+    uint64_t modifier = ((uint64_t)modifier_hi << 32) + modifier_lo;
+    struct wlu_display *display = data;
+
+    switch (format) {
+    case DRM_FORMAT_XRGB8888:
+        wlu_dmabuf_format_init(&display->dmabuf_formats[WLU_FORMAT_XRGB8888], 4, format, modifier);
+        break;
+    case DRM_FORMAT_ARGB8888:
+        wlu_dmabuf_format_init(&display->dmabuf_formats[WLU_FORMAT_ARGB8888], 4, format, modifier);
+        break;
+    case DRM_FORMAT_BGRX8888:
+        wlu_dmabuf_format_init(&display->dmabuf_formats[WLU_FORMAT_BGRX8888], 4, format, modifier);
+        break;
+    case DRM_FORMAT_BGRA8888:
+        wlu_dmabuf_format_init(&display->dmabuf_formats[WLU_FORMAT_BGRA8888], 4, format, modifier);
+        break;
+    default:
+        break;
+    }
+}
+
+static void dmabuf_format(void *data, struct zwp_linux_dmabuf_v1 *zwp_linux_dmabuf, uint32_t format)
+{
+}
+
+static const struct zwp_linux_dmabuf_v1_listener dmabuf_listener = {
+    .format = dmabuf_format,
+    .modifier = dmabuf_modifiers,
+};
+
+static void registry_global(void *data, struct wl_registry *registry, uint32_t name,
+                            const char *interface, uint32_t version)
+{
+    struct wlu_display *display = data;
+
+    if (strcmp(interface, wl_compositor_interface.name) == 0) {
+        display->compositor =
+            wl_registry_bind(registry, name, &wl_compositor_interface, MIN(version, 4));
+    } else if (strcmp(interface, xdg_wm_base_interface.name) == 0) {
+        display->xdg_wm_base =
+            wl_registry_bind(registry, name, &xdg_wm_base_interface, MIN(version, 4));
+        xdg_wm_base_add_listener(display->xdg_wm_base, &xdg_wm_base_listener, display);
+    } else if (strcmp(interface, zxdg_decoration_manager_v1_interface.name) == 0) {
+        display->xdg_decoration_manager =
+            wl_registry_bind(registry, name, &zxdg_decoration_manager_v1_interface, 1);
+    } else if (strcmp(interface, wl_seat_interface.name) == 0) {
+        display->seat = wl_registry_bind(registry, name, &wl_seat_interface, 1);
+        wl_seat_add_listener(display->seat, &seat_listener, display);
+    } else if (strcmp(interface, wl_shm_interface.name) == 0) {
+        display->shm = wl_registry_bind(registry, name, &wl_shm_interface, 1);
+        wl_shm_add_listener(display->shm, &shm_listener, display);
+    } else if (strcmp(interface, zwp_linux_dmabuf_v1_interface.name) == 0) {
+        if (display->flags & WLU_DISPLAY_CREATE_EGL) {
+            display->dmabuf =
+                wl_registry_bind(registry, name, &zwp_linux_dmabuf_v1_interface, MIN(version, 3));
+            zwp_linux_dmabuf_v1_add_listener(display->dmabuf, &dmabuf_listener, display);
+        }
+    }
+
+    if (display->event_callbacks.registry_global) {
+        display->event_callbacks.registry_global(display, registry, name, interface, version);
+    }
+}
+
+static void registry_global_remove(void *data, struct wl_registry *registry, uint32_t name)
+{
+    struct wlu_display *display = data;
+    if (display->event_callbacks.registry_global_remove) {
+        display->event_callbacks.registry_global_remove(display, registry, name);
+    }
+}
+
+static const struct wl_registry_listener registry_listener = {
+    .global = registry_global,
+    .global_remove = registry_global_remove,
+};
+
+static inline bool display_init_gbm(struct wlu_display *display)
+{
+    /// 第1个渲染用节点
+    const char *drm_render_node = "/dev/dri/renderD128";
+    display->gbm.drm_fd = open(drm_render_node, O_RDWR);
+    if (display->gbm.drm_fd < 0) {
+        fprintf(stderr, "Failed to open drm render node %s\n", drm_render_node);
+        return false;
+    }
+    display->gbm.device = gbm_create_device(display->gbm.drm_fd);
+    if (display->gbm.device == NULL) {
+        fprintf(stderr, "Failed to create gbm device\n");
+        return false;
+    }
+    return true;
+}
+
+static inline bool display_init_egl(struct wlu_display *display)
+{
+    display->egl_display = eglGetPlatformDisplay(EGL_PLATFORM_GBM_KHR, display->gbm.device, NULL);
+    if (display->egl_display == EGL_NO_DISPLAY) {
+        fprintf(stderr, "Failed to create EGLDisplay\n");
+        return false;
+    }
+
+    EGLint major, minor;
+    if (eglInitialize(display->egl_display, &major, &minor) == EGL_FALSE) {
+        fprintf(stderr, "Failed to initialize EGLDisplay\n");
+        return false;
+    }
+
+    return true;
+}
+
+static bool wlu_display_connect(struct wlu_display *display)
+{
+    display->display = wl_display_connect(NULL);
+    if (display->display == NULL) {
+        fprintf(stderr, "Failed to connect to wayland display: %s\n", strerror(errno));
+        return false;
+    }
+
+    display->registry = wl_display_get_registry(display->display);
+    wl_registry_add_listener(display->registry, &registry_listener, display);
+
+    // 第一次roundtrip拿global
+    wl_display_roundtrip(display->display);
+    // 第二次roundtrip处理事件
+    wl_display_roundtrip(display->display);
+
+    if (!display->compositor || !display->xdg_wm_base || !display->seat) {
+        fprintf(stderr, "Failed to process wayland connection: %s\n", strerror(errno));
+        return false;
+    }
+
+    if (display->flags & WLU_DISPLAY_CREATE_EGL) {
+        if (!display_init_gbm(display) || !display_init_egl(display)) {
+            return false;
+        }
+    }
+
+    return true;
+}
+
+struct wlu_display *wlu_display_create(const wlu_display_event_callbacks_t *event_callbacks,
+                                       int32_t flags)
+{
+    struct wlu_display *display = calloc(1, sizeof(*display));
+    if (display == NULL) {
+        return NULL;
+    }
+
+    wl_list_init(&display->window_list);
+    if (event_callbacks) {
+        display->event_callbacks = *event_callbacks;
+    }
+    display->flags = flags;
+
+    if (!wlu_display_connect(display)) {
+        free(display);
+        return NULL;
+    }
+
+    return display;
+}
+
+void wlu_display_destroy(struct wlu_display *display)
+{
+    struct wlu_window *window, *tmp;
+    wl_list_for_each_safe(window, tmp, &display->window_list, link) {
+        wl_list_remove(&window->link);
+        wlu_window_destroy(window);
+    }
+
+    if (display->gbm.device) {
+        gbm_device_destroy(display->gbm.device);
+    }
+    if (display->gbm.drm_fd >= 0) {
+        close(display->gbm.drm_fd);
+    }
+
+    for (int i = 0; i < WLU_FORMAT_COUNT; i++) {
+        struct wlu_dmabuf_format *format = &display->dmabuf_formats[i];
+        if (format->modifiers) {
+            free(format->modifiers);
+        }
+    }
+
+    if (display->dmabuf) {
+        zwp_linux_dmabuf_v1_destroy(display->dmabuf);
+    }
+    if (display->shm) {
+        wl_shm_destroy(display->shm);
+    }
+    if (display->seat) {
+        wl_seat_destroy(display->seat);
+    }
+    if (display->xdg_decoration_manager) {
+        zxdg_decoration_manager_v1_destroy(display->xdg_decoration_manager);
+    }
+    if (display->xdg_wm_base) {
+        xdg_wm_base_destroy(display->xdg_wm_base);
+    }
+    if (display->compositor) {
+        wl_compositor_destroy(display->compositor);
+    }
+    if (display->display) {
+        wl_display_disconnect(display->display);
+    }
+    free(display);
+}
+
+struct wl_display *wlu_display_get_wl_display(struct wlu_display *display)
+{
+    return display->display;
+}
+
+struct wl_compositor *wlu_display_get_wl_compositor(struct wlu_display *display)
+{
+    return display->compositor;
+}
+
+struct xdg_wm_base *wlu_display_get_xdg_wm_base(struct wlu_display *display)
+{
+    return display->xdg_wm_base;
+}
+
+void wlu_display_run(struct wlu_display *display)
+{
+    display->running = true;
+    while (display->running) {
+        if (wl_display_dispatch(display->display) == -1) {
+            break;
+        }
+    }
+}
+
+void wlu_display_exit(struct wlu_display *display)
+{
+    display->running = false;
+}
