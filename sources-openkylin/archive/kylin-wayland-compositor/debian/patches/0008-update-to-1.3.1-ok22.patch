diff --git a/protocols/kywc-security-v1.xml b/protocols/kywc-security-v1.xml
new file mode 100644
index 0000000..65abfa7
--- /dev/null
+++ b/protocols/kywc-security-v1.xml
@@ -0,0 +1,91 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="kywc_security_v1">
+  <copyright><![CDATA[
+    SPDX-FileCopyrightText: 2024 KylinSoft Co., Ltd.
+    SPDX-License-Identifier: MulanPSL-2.0
+  ]]></copyright>
+
+  <interface name="kywc_security_manager_v1" version="1">
+    <description summary="client security manager">
+      This interface allows a client to create a security object for screenshot,
+      screencast and thumbnails. 
+    </description>
+
+    <request name="destroy" type="destructor">
+      <description summary="destroy the manager">
+        All objects created by the manager will still remain valid, until their
+        appropriate destroy request has been called.
+      </description>
+    </request>
+
+    <request name="get_security_for_surface">
+      <description summary="security for a surface">
+        Get a security object for an existing surface.
+        Only one security object can be associated with a given surface.
+      </description>
+      <arg name="security" type="new_id" interface="kywc_security_v1"/>
+      <arg name="surface" type="object" interface="wl_surface"/>
+    </request>
+
+    <request name="get_security_for_output">
+      <description summary="security for an output">
+        Get a security object for an existing output.
+      </description>
+      <arg name="security" type="new_id" interface="kywc_security_v1"/>
+      <arg name="output" type="object" interface="wl_output"/>
+    </request>
+  </interface>
+
+  <interface name="kywc_security_v1" version="1">
+    <description summary="a security for surface or output">
+      A kywc_security_v1 object represents the security attribute for a surface or output.
+    </description>
+
+    <request name="destroy" type="destructor">
+      <description summary="destroy the security">
+        Destroys the security. This request can be sent at any time by the client.
+      </description>
+    </request>
+
+    <event name="failed">
+      <description summary="security is failed">
+        This event indicates that the attempted security is failed.
+        After receiving this event, the client should destroy the object.
+      </description>
+    </event>
+
+    <event name="cancelled">
+      <description summary="security is cancelled">
+        Sent if the compositor cancels the security because the source has gone.
+        Upon receiving this event, the client should destroy this object.
+      </description>
+    </event>
+
+    <event name="enabled">
+      <description summary="security enabled state">
+        Sent after a security object is created or the state has been changed.
+      </description>
+      <arg name="enabled" type="uint" summary="security is enabled or not" />
+    </event>
+
+    <event name="touched">
+      <description summary="security is touched">
+        Sent if the enabled security is touched by the sensitive behavior.
+      </description>
+      <arg name="toucher" type="string" summary="the toucher name" />
+    </event>
+
+    <request name="enable">
+      <description summary="enable the security">
+        Request that this security be enabled.
+      </description>
+    </request>
+
+    <request name="disable">
+      <description summary="disable the security">
+        Request that this security be disabled.
+        There is no guarantee the output security will be actually disabled.
+      </description>
+    </request>
+  </interface>
+</protocol>
diff --git a/protocols/kywc-stream-v1.xml b/protocols/kywc-stream-v1.xml
new file mode 100644
index 0000000..2317bbf
--- /dev/null
+++ b/protocols/kywc-stream-v1.xml
@@ -0,0 +1,68 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="kywc_capture_v1">
+  <copyright><![CDATA[
+    SPDX-FileCopyrightText: 2026 KylinSoft Co., Ltd.
+    SPDX-License-Identifier: MulanPSL-2.0
+  ]]></copyright>
+
+  <interface name="kywc_stream_manager_v1" version="1">
+    <description summary="managing PipeWire stream for output and toplevel">
+      This object is a manager which offers PipeWire stream for output and toplevel.
+    </description>
+
+    <enum name="pointer">
+        <description summary="Stream consumer attachment attributes" />
+        <entry name="hidden" value="0" summary="No cursor"/>
+        <entry name="embedded" value="1" summary="Render the cursor on the stream"/>
+        <entry name="metadata" value="2" summary="Send metadata about where the cursor is through PipeWire"/>
+    </enum>
+
+    <request name="stream_output">
+        <description summary="requests a stream from a given source"/>
+        <arg name="stream" type="new_id" interface="kywc_stream_v1"/>
+        <arg name="uuid" type="string" summary="output Identifier"/>
+        <arg name="pointer" type="uint" summary="Requested pointer mode"/>
+    </request>
+
+    <request name="stream_toplevel">
+        <description summary="requests a stream from a given source"/>
+        <arg name="stream" type="new_id" interface="kywc_stream_v1"/>
+        <arg name="uuid" type="string" summary="toplevel Identifier"/>
+        <arg name="pointer" type="uint" summary="Requested pointer mode"/>
+    </request>
+
+    <request name="destroy" type="destructor">
+        <description summary="Destroy the manager">
+        All objects created by the manager will still remain valid, until their
+        appropriate destroy request has been called.
+        </description>
+    </request>
+  </interface>
+
+  <interface name="kywc_stream_v1" version="1">
+    <request name="destroy" type="destructor">
+      <description summary="delete this object, used or not">
+        Destroys the stream. This request can be sent at any time by the client.
+      </description>
+    </request>
+
+    <event name="failed">
+      <description summary="stream create failed">
+        This event indicates that the attempted stream has failed.
+        After receiving this event, the client should destroy the object.
+      </description>
+    </event>
+
+    <event name="cancelled">
+      <description summary="stream has been cancelled">
+        Sent if the compositor cancels the stream because the source has gone.
+        Upon receiving this event, the client should destroy this object.
+      </description>
+    </event>
+
+    <event name="created">
+      <description summary="a pipewire stream being created"/>
+        <arg name="node" type="uint" summary="node id of the pipewire stream"/>
+    </event>
+  </interface>
+</protocol>
