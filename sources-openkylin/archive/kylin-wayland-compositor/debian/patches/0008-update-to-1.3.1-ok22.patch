+typedef bool (*drm_output_color_check_func_t)(struct drm_connector *conn, struct drm_crtc *crtc);
+
+static bool drm_output_probe_color_capability(struct wlr_output *wlr_output,
+                                              drm_output_color_check_func_t check)
+{
+    struct drm_connector *conn = drm_connector_from_output(wlr_output);
+    if (!conn) {
+        return false;
+    }
+
+    if (conn->crtc) {
+        return check(conn, conn->crtc);
+    }
+
+    for (size_t i = 0; i < conn->drm->num_crtcs && i < 32; i++) {
+        if (!(conn->possible_crtcs & (1u << i))) {
+            continue;
+        }
+
+        if (check(conn, &conn->drm->crtcs[i])) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+uint32_t wlr_output_get_color_capabilities(struct wlr_output *wlr_output)
+{
+    if (!wlr_output_is_drm(wlr_output)) {
+        return 0;
+    }
+
+    if (wlr_renderer_is_opengl(wlr_output->renderer)) {
+        return KYWC_OUTPUT_CAPABILITY_BRIGHTNESS | KYWC_OUTPUT_CAPABILITY_COLOR_TEMP |
+               KYWC_OUTPUT_CAPABILITY_COLOR_FILTER;
+    }
+
+    uint32_t capabilities = 0;
+    if (drm_output_probe_color_capability(wlr_output, drm_output_has_brightness_capability)) {
+        capabilities |= KYWC_OUTPUT_CAPABILITY_BRIGHTNESS;
+    }
+    if (drm_output_probe_color_capability(wlr_output, drm_output_has_color_temp_capability)) {
+        capabilities |= KYWC_OUTPUT_CAPABILITY_COLOR_TEMP;
+    }
+    if (drm_output_probe_color_capability(wlr_output, drm_output_has_color_filter_capability)) {
+        capabilities |= KYWC_OUTPUT_CAPABILITY_COLOR_FILTER;
+    }
+
+    return capabilities;
+}
