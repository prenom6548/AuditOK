+static void get_keyboard_buffer_color(double **background, double **text)
+{
+    static double light_background[] = { 1.0, 1.0, 1.0 };
+    static double light_text[] = { 0.0, 0.0, 0.0 };
+    static double dark_background[] = { 0.0, 0.0, 0.0 };
+    static double dark_text[] = { 1.0, 1.0, 1.0 };
+
+    struct theme *theme = theme_manager_get_theme();
+    if (theme->type == THEME_TYPE_LIGHT || theme->type == THEME_TYPE_UNDEFINED) {
+        *background = light_background;
+        *text = light_text;
+    } else {
+        *background = dark_background;
+        *text = dark_text;
+    }
+}
