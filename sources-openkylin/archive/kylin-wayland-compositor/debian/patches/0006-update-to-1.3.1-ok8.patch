-        return false;
-    }
-
-    glBindFramebuffer(GL_FRAMEBUFFER, buffer->fbo);
-    glPixelStorei(GL_PACK_ALIGNMENT, 1);
-    glReadPixels(0, 0, buffer->buffer.width, buffer->buffer.height, GL_BGRA_EXT, GL_UNSIGNED_BYTE,
-                 data);
-    glBindFramebuffer(GL_FRAMEBUFFER, 0);
