+        options.list_toplevel = false;
+    }
+
+    if (options.list_workspace) {
+        kywc_context_for_each_workspace(manager->kywc_ctx, print_workspace, NULL);
+        options.list_workspace = false;
+    }
+
+    if (options.list_output) {
