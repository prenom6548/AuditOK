+    showkey->key_unit.last_press_time = 0;
+    showkey->key_unit.row_index = 0;
+    showkey->key_unit.key = NULL;
+    ky_scene_node_destroy(&showkey->tree->node);
+    showkey->tree = NULL;
+}
