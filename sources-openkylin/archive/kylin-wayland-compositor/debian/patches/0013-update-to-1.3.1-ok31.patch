 }
 
+bool drm_backend_support_timeline(struct wlr_backend *wlr_backend)
+{
+    struct drm_device *drm = drm_backend_from_wlr_backend(wlr_backend)->drm;
+    if (drm->mode == DRM_KMS_MODE_LEGACY) {
+        return false;
+    }
+
+    if (drm->mgpu_renderer.wlr_rend && !renderer_support_timeline(drm->mgpu_renderer.wlr_rend)) {
+        return false;
+    }
+
+    uint64_t cap;
+    int fd = drm_backend_get_non_master_fd(wlr_backend);
+    if (fd < 0) {
+        return false;
+    }
+
+    return drmGetCap(fd, DRM_CAP_SYNCOBJ_TIMELINE, &cap) == 0 && cap == 1;
+}
+
