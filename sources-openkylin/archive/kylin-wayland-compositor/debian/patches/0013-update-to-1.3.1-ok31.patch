diff --git a/src/render/drm_syncobj.c b/src/render/drm_syncobj.c
new file mode 100644
index 0000000..c1f3e9a
--- /dev/null
+++ b/src/render/drm_syncobj.c
@@ -0,0 +1,268 @@
+// SPDX-FileCopyrightText: 2025 The wlroots contributors
+// SPDX-FileCopyrightText: 2026 KylinSoft Co., Ltd.
+//
+// SPDX-License-Identifier: GPL-1.0-or-later
+
+#define _POSIX_C_SOURCE 200809L
+#include <assert.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <xf86drm.h>
+
+#if HAVE_EVENTFD
+#include <sys/eventfd.h>
+#endif
+
+#include "render/drm_syncobj.h"
+#include <kywc/log.h>
+
+static struct drm_syncobj_timeline *timeline_create(int drm_fd, uint32_t handle)
+{
+    struct drm_syncobj_timeline *timeline = calloc(1, sizeof(*timeline));
+    if (timeline == NULL) {
+        return NULL;
+    }
+
+    timeline->drm_fd = drm_fd;
+    timeline->n_refs = 1;
+    timeline->handle = handle;
+
+    return timeline;
+}
+
+struct drm_syncobj_timeline *drm_syncobj_timeline_create(int drm_fd)
+{
+    uint32_t handle = 0;
+    if (drmSyncobjCreate(drm_fd, 0, &handle) != 0) {
+        kywc_log_errno(KYWC_ERROR, "Failed with drmSyncobjCreate");
+        return NULL;
+    }
+
+    struct drm_syncobj_timeline *timeline = timeline_create(drm_fd, handle);
+    if (timeline == NULL) {
+        drmSyncobjDestroy(drm_fd, handle);
+    }
+
+    return timeline;
+}
+
+int drm_syncobj_timeline_export(struct drm_syncobj_timeline *timeline)
+{
+    int drm_syncobj_fd = -1;
+    if (drmSyncobjHandleToFD(timeline->drm_fd, timeline->handle, &drm_syncobj_fd) != 0) {
+        kywc_log_errno(KYWC_ERROR, "Failed with drmSyncobjHandleToFD");
+        return -1;
+    }
+    return drm_syncobj_fd;
+}
+
+struct drm_syncobj_timeline *drm_syncobj_timeline_import(int drm_fd, int drm_syncobj_fd)
+{
+    uint32_t handle = 0;
+    if (drmSyncobjFDToHandle(drm_fd, drm_syncobj_fd, &handle) != 0) {
+        kywc_log_errno(KYWC_ERROR, "Failed with drmSyncobjFDToHandle");
+        return NULL;
+    }
+
+    struct drm_syncobj_timeline *timeline = timeline_create(drm_fd, handle);
+    if (timeline == NULL) {
+        drmSyncobjDestroy(drm_fd, handle);
+    }
+
+    return timeline;
+}
+
+struct drm_syncobj_timeline *drm_syncobj_timeline_ref(struct drm_syncobj_timeline *timeline)
+{
+    timeline->n_refs++;
+    return timeline;
+}
+
+void drm_syncobj_timeline_unref(struct drm_syncobj_timeline *timeline)
+{
+    if (!timeline) {
+        return;
+    }
+
+    assert(timeline->n_refs);
+    timeline->n_refs--;
+    if (timeline->n_refs) {
+        return;
+    }
+
+    drmSyncobjDestroy(timeline->drm_fd, timeline->handle);
+    free(timeline);
+}
+
+bool drm_syncobj_timeline_transfer(struct drm_syncobj_timeline *dst, uint64_t dst_point,
+                                   struct drm_syncobj_timeline *src, uint64_t src_point)
+{
+    assert(dst->drm_fd == src->drm_fd);
+
+    if (drmSyncobjTransfer(dst->drm_fd, dst->handle, dst_point, src->handle, src_point, 0)) {
+        kywc_log_errno(KYWC_ERROR, "Failed with drmSyncobjTransfer");
+        return false;
+    }
+
+    return true;
+}
+
+int drm_syncobj_timeline_export_sync_file(struct drm_syncobj_timeline *timeline, uint64_t src_point)
+{
+    int sync_file_fd = -1;
+
+    uint32_t syncobj_handle;
+    if (drmSyncobjCreate(timeline->drm_fd, 0, &syncobj_handle)) {
+        kywc_log_errno(KYWC_ERROR, "Failed with drmSyncobjCreate");
+        return -1;
+    }
+
+    if (drmSyncobjTransfer(timeline->drm_fd, syncobj_handle, 0, timeline->handle, src_point, 0)) {
+        kywc_log_errno(KYWC_ERROR, "Failed with drmSyncobjTransfer");
+        goto out;
+    }
+
+    if (drmSyncobjExportSyncFile(timeline->drm_fd, syncobj_handle, &sync_file_fd) != 0) {
+        kywc_log_errno(KYWC_ERROR, "Failed with drmSyncobjExportSyncFile");
+        goto out;
+    }
+
+out:
+    drmSyncobjDestroy(timeline->drm_fd, syncobj_handle);
+    return sync_file_fd;
+}
+
+bool drm_syncobj_timeline_import_sync_file(struct drm_syncobj_timeline *timeline,
+                                           uint64_t dst_point, int sync_file_fd)
+{
+    bool ok = false;
+    int drm_fd = timeline->drm_fd;
+
+    uint32_t syncobj_handle;
+    if (drmSyncobjCreate(drm_fd, 0, &syncobj_handle)) {
+        kywc_log_errno(KYWC_ERROR, "Failed with drmSyncobjCreate");
+        return false;
+    }
+
+    if (drmSyncobjImportSyncFile(drm_fd, syncobj_handle, sync_file_fd)) {
+        kywc_log_errno(KYWC_ERROR, "Failed with drmSyncobjImportSyncFile");
+        goto out;
+    }
+
+    if (drmSyncobjTransfer(drm_fd, timeline->handle, dst_point, syncobj_handle, 0, 0)) {
+        kywc_log_errno(KYWC_ERROR, "Failed with drmSyncobjTransfer");
+        goto out;
+    }
+
+    ok = true;
+
+out:
+    drmSyncobjDestroy(drm_fd, syncobj_handle);
+    return ok;
+}
+
+bool drm_syncobj_timeline_check(struct drm_syncobj_timeline *timeline, uint64_t point,
+                                uint32_t flags, bool *result)
+{
+    int etime;
+#if defined(__FreeBSD__)
+    etime = ETIMEDOUT;
+#else
+    etime = ETIME;
+#endif
+
+    uint32_t signaled_point;
+    int ret = drmSyncobjTimelineWait(timeline->drm_fd, &timeline->handle, &point, 1, 0, flags,
+                                     &signaled_point);
+    if (ret != 0 && ret != -etime) {
+        kywc_log_errno(KYWC_ERROR, "Failed with drmSyncobjTimelineWait");
+        return false;
+    }
+
+    *result = ret == 0;
+    return true;
+}
+
+bool drm_syncobj_timeline_signal(struct drm_syncobj_timeline *timeline, uint64_t point)
+{
+    if (drmSyncobjTimelineSignal(timeline->drm_fd, &timeline->handle, &point, 1) != 0) {
+        kywc_log(KYWC_ERROR, "drmSyncobjTimelineSignal() failed");
+        return false;
+    }
+    return true;
+}
+
+static int handle_eventfd_ready(int ev_fd, uint32_t mask, void *data)
+{
+    struct drm_syncobj_timeline_waiter *waiter = data;
+
+    if (mask & (WL_EVENT_HANGUP | WL_EVENT_ERROR)) {
+        kywc_log(KYWC_ERROR, "Failed to wait for render timeline");
+    }
+
+    if (mask & WL_EVENT_READABLE) {
+        uint64_t ev_fd_value;
+        if (read(ev_fd, &ev_fd_value, sizeof(ev_fd_value)) <= 0) {
+            kywc_log(KYWC_ERROR, "Failed to wait for render timeline: read() failed");
+        }
+    }
+
+    waiter->callback(waiter);
+    return 0;
+}
+
+bool drm_syncobj_timeline_waiter_init(struct drm_syncobj_timeline_waiter *waiter,
+                                      struct drm_syncobj_timeline *timeline, uint64_t point,
+                                      uint32_t flags, struct wl_event_loop *loop,
+                                      drm_syncobj_timeline_ready_callback callback)
+{
+    assert(callback);
+
+    int ev_fd;
+#if HAVE_EVENTFD
+    ev_fd = eventfd(0, EFD_CLOEXEC);
+    if (ev_fd < 0) {
+        kywc_log_errno(KYWC_ERROR, "Failed to get event fd");
+    }
+#else
+    ev_fd = -1;
+    kywc_log(KYWC_ERROR, "eventfd() is unavailable");
+#endif
+    if (ev_fd < 0) {
+        return false;
+    }
+
+    struct drm_syncobj_eventfd syncobj_eventfd = {
+        .handle = timeline->handle,
+        .flags = flags,
+        .point = point,
+        .fd = ev_fd,
+    };
+    if (drmIoctl(timeline->drm_fd, DRM_IOCTL_SYNCOBJ_EVENTFD, &syncobj_eventfd) != 0) {
+        kywc_log_errno(KYWC_ERROR, "Failed with DRM_IOCTL_SYNCOBJ_EVENTFD");
+        close(ev_fd);
+        return false;
+    }
+
+    struct wl_event_source *source =
+        wl_event_loop_add_fd(loop, ev_fd, WL_EVENT_READABLE, handle_eventfd_ready, waiter);
+    if (source == NULL) {
+        kywc_log(KYWC_ERROR, "Failed to add FD to event loop");
+        close(ev_fd);
+        return false;
+    }
+
+    *waiter = (struct drm_syncobj_timeline_waiter){
+        .ev_fd = ev_fd,
+        .event_source = source,
+        .callback = callback,
+    };
+    return true;
+}
+
+void drm_syncobj_timeline_waiter_finish(struct drm_syncobj_timeline_waiter *waiter)
+{
+    wl_event_source_remove(waiter->event_source);
+    close(waiter->ev_fd);
+}
diff --git a/src/render/drm_syncobj_merger.c b/src/render/drm_syncobj_merger.c
new file mode 100644
index 0000000..3908309
--- /dev/null
+++ b/src/render/drm_syncobj_merger.c
@@ -0,0 +1,156 @@
+// SPDX-FileCopyrightText: 2025 The wlroots contributors
+// SPDX-FileCopyrightText: 2026 KylinSoft Co., Ltd.
+//
+// SPDX-License-Identifier: GPL-1.0-or-later
+
+#include <assert.h>
+#include <linux/dma-buf.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <wayland-util.h>
+#include <wlr/config.h>
+#include <wlr/render/dmabuf.h>
+
+#include <wlr/types/wlr_buffer.h>
+#include <xf86drm.h>
+
+#include <kywc/log.h>
+
+#include "render/drm_syncobj.h"
+#include "render/drm_syncobj_merger.h"
+
+#if HAVE_LINUX_SYNC_FILE
+
+#include <linux/sync_file.h>
+#include <sys/ioctl.h>
+
+static int sync_file_merge(int fd1, int fd2)
+{
+    // The kernel will automatically prune signalled fences
+    struct sync_merge_data merge_data = { .fd2 = fd2 };
+    if (ioctl(fd1, SYNC_IOC_MERGE, &merge_data) < 0) {
+        kywc_log_errno(KYWC_ERROR, "ioctl(SYNC_IOC_MERGE) failed");
+        return -1;
+    }
+
+    return merge_data.fence;
+}
+
+#else
+
+static int sync_file_merge(int fd1, int fd2)
+{
+    kywc_log(KYWC_ERROR, "sync_file support is unavailable");
+    return -1;
+}
+
+#endif
+
+struct drm_syncobj_merger *drm_syncobj_merger_create(struct drm_syncobj_timeline *dst_timeline,
+                                                     uint64_t dst_point)
+{
+    struct drm_syncobj_merger *merger = calloc(1, sizeof(*merger));
+    if (merger == NULL) {
+        return NULL;
+    }
+    merger->n_ref = 1;
+    merger->dst_timeline = drm_syncobj_timeline_ref(dst_timeline);
+    merger->dst_point = dst_point;
+    merger->sync_fd = -1;
+    return merger;
+}
+
+struct drm_syncobj_merger *drm_syncobj_merger_ref(struct drm_syncobj_merger *merger)
+{
+    assert(merger->n_ref > 0);
+    merger->n_ref++;
+    return merger;
+}
+
+void drm_syncobj_merger_unref(struct drm_syncobj_merger *merger)
+{
+    if (merger == NULL) {
+        return;
+    }
+    assert(merger->n_ref > 0);
+    merger->n_ref--;
+    if (merger->n_ref > 0) {
+        return;
+    }
+
+    if (merger->sync_fd != -1) {
+        drm_syncobj_timeline_import_sync_file(merger->dst_timeline, merger->dst_point,
+                                              merger->sync_fd);
+        close(merger->sync_fd);
+    } else {
+        drm_syncobj_timeline_signal(merger->dst_timeline, merger->dst_point);
+    }
+    drm_syncobj_timeline_unref(merger->dst_timeline);
+    free(merger);
+}
+
+static bool merger_add_exportable(struct drm_syncobj_merger *merger,
+                                  struct drm_syncobj_timeline *src_timeline, uint64_t src_point)
+{
+    int new_sync = drm_syncobj_timeline_export_sync_file(src_timeline, src_point);
+    return drm_syncobj_merger_add_sync_file(merger, new_sync);
+}
+
+struct export_waiter {
+    struct drm_syncobj_timeline_waiter waiter;
+    struct drm_syncobj_merger *merger;
+    struct drm_syncobj_timeline *src_timeline;
+    uint64_t src_point;
+};
+
+static void export_waiter_handle_ready(struct drm_syncobj_timeline_waiter *waiter)
+{
+    struct export_waiter *add = wl_container_of(waiter, add, waiter);
+    merger_add_exportable(add->merger, add->src_timeline, add->src_point);
+    drm_syncobj_merger_unref(add->merger);
+    drm_syncobj_timeline_unref(add->src_timeline);
+    drm_syncobj_timeline_waiter_finish(&add->waiter);
+    free(add);
+}
+
+bool drm_syncobj_merger_add(struct drm_syncobj_merger *merger,
+                            struct drm_syncobj_timeline *src_timeline, uint64_t src_point,
+                            struct wl_event_loop *loop)
+{
+    assert(loop != NULL);
+    bool exportable = false;
+    int flags = DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE;
+    if (!drm_syncobj_timeline_check(src_timeline, src_point, flags, &exportable)) {
+        return false;
+    }
+    if (exportable) {
+        return merger_add_exportable(merger, src_timeline, src_point);
+    }
+    struct export_waiter *add = calloc(1, sizeof(*add));
+    if (add == NULL) {
+        return false;
+    }
+    if (!drm_syncobj_timeline_waiter_init(&add->waiter, src_timeline, src_point, flags, loop,
+                                          export_waiter_handle_ready)) {
+        free(add);
+        return false;
+    }
+    add->merger = merger;
+    add->src_timeline = drm_syncobj_timeline_ref(src_timeline);
+    add->src_point = src_point;
+    merger->n_ref++;
+    return true;
+}
+
+bool drm_syncobj_merger_add_sync_file(struct drm_syncobj_merger *merger, int fd)
+{
+    int new_sync = fd;
+    if (merger->sync_fd != -1) {
+        new_sync = sync_file_merge(merger->sync_fd, fd);
+        close(fd);
+        close(merger->sync_fd);
+    }
+    merger->sync_fd = new_sync;
+    return merger->sync_fd != -1;
+}
diff --git a/src/render/drm_syncobj_v1.c b/src/render/drm_syncobj_v1.c
new file mode 100644
index 0000000..7cf9f3c
--- /dev/null
+++ b/src/render/drm_syncobj_v1.c
@@ -0,0 +1,537 @@
+// SPDX-FileCopyrightText: 2025 The wlroots contributors
+// SPDX-FileCopyrightText: 2026 KylinSoft Co., Ltd.
+//
+// SPDX-License-Identifier: GPL-1.0-or-later
+
+#define _POSIX_C_SOURCE 200809L
+#include <assert.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <xf86drm.h>
+
+#if HAVE_EVENTFD
+#include <sys/eventfd.h>
+#endif
+
+#include <wlr/types/wlr_buffer.h>
+#include <wlr/types/wlr_compositor.h>
+
+#include <kywc/log.h>
+
+#include "linux-drm-syncobj-v1-protocol.h"
+#include "render/drm_syncobj.h"
+#include "render/drm_syncobj_merger.h"
+#include "render/drm_syncobj_v1.h"
+
+#define LINUX_DRM_SYNCOBJ_V1_VERSION 1
+
+struct drm_syncobj_surface_v1 {
+    struct wl_resource *resource;
+    struct wlr_surface *surface;
+    struct drm_syncobj_surface_v1_state pending, current;
+
+    struct wlr_addon addon;
+    struct wlr_surface_synced synced;
+
+    struct wl_listener client_commit;
+};
+
+struct drm_syncobj_surface_v1_commit {
+    struct wlr_surface *surface;
+    struct drm_syncobj_timeline_waiter waiter;
+    uint32_t cached_seq;
+
+    struct wl_listener surface_destroy;
+};
+
+static const struct wp_linux_drm_syncobj_manager_v1_interface manager_impl;
+static const struct wp_linux_drm_syncobj_timeline_v1_interface timeline_impl;
+static const struct wp_linux_drm_syncobj_surface_v1_interface surface_impl;
+
+static struct drm_syncobj_manager_v1 *manager_from_resource(struct wl_resource *resource)
+{
+    assert(wl_resource_instance_of(resource, &wp_linux_drm_syncobj_manager_v1_interface,
+                                   &manager_impl));
+    return wl_resource_get_user_data(resource);
+}
+
+static struct drm_syncobj_timeline *timeline_from_resource(struct wl_resource *resource)
+{
+    assert(wl_resource_instance_of(resource, &wp_linux_drm_syncobj_timeline_v1_interface,
+                                   &timeline_impl));
+    return wl_resource_get_user_data(resource);
+}
+
+// Returns NULL if the syncobj surface is inert
+static struct drm_syncobj_surface_v1 *surface_from_resource(struct wl_resource *resource)
+{
+    assert(wl_resource_instance_of(resource, &wp_linux_drm_syncobj_surface_v1_interface,
+                                   &surface_impl));
+    return wl_resource_get_user_data(resource);
+}
+
+static void timeline_handle_resource_destroy(struct wl_resource *resource)
+{
+    struct drm_syncobj_timeline *timeline = timeline_from_resource(resource);
+    drm_syncobj_timeline_unref(timeline);
+}
+
+static void timeline_handle_destroy(struct wl_client *client, struct wl_resource *resource)
+{
+    wl_resource_destroy(resource);
+}
+
+static const struct wp_linux_drm_syncobj_timeline_v1_interface timeline_impl = {
+    .destroy = timeline_handle_destroy,
+};
+
+static void surface_destroy(struct drm_syncobj_surface_v1 *surface)
+{
+    if (surface == NULL) {
+        return;
+    }
+    wl_list_remove(&surface->client_commit.link);
+    wlr_addon_finish(&surface->addon);
+    wlr_surface_synced_finish(&surface->synced);
+    wl_resource_set_user_data(surface->resource, NULL);
+    free(surface);
+}
+
+static void surface_handle_destroy(struct wl_client *client, struct wl_resource *resource)
+{
+    wl_resource_destroy(resource);
+}
+
+static void surface_handle_set_acquire_point(struct wl_client *client, struct wl_resource *resource,
+                                             struct wl_resource *timeline_resource,
+                                             uint32_t point_hi, uint32_t point_lo)
+{
+    struct drm_syncobj_surface_v1 *surface = surface_from_resource(resource);
+    if (surface == NULL) {
+        wl_resource_post_error(resource, WP_LINUX_DRM_SYNCOBJ_SURFACE_V1_ERROR_NO_SURFACE,
+                               "The surface has been destroyed");
+        return;
+    }
+
+    struct drm_syncobj_timeline *timeline = timeline_from_resource(timeline_resource);
+    uint64_t point = (uint64_t)point_hi << 32 | point_lo;
+
+    drm_syncobj_timeline_unref(surface->pending.acquire_timeline);
+    surface->pending.acquire_timeline = drm_syncobj_timeline_ref(timeline);
+    surface->pending.acquire_point = point;
+}
+
+static void surface_handle_set_release_point(struct wl_client *client, struct wl_resource *resource,
+                                             struct wl_resource *timeline_resource,
+                                             uint32_t point_hi, uint32_t point_lo)
+{
+    struct drm_syncobj_surface_v1 *surface = surface_from_resource(resource);
+    if (surface == NULL) {
+        wl_resource_post_error(resource, WP_LINUX_DRM_SYNCOBJ_SURFACE_V1_ERROR_NO_SURFACE,
+                               "The surface has been destroyed");
+        return;
+    }
+
+    struct drm_syncobj_timeline *timeline = timeline_from_resource(timeline_resource);
+    uint64_t point = (uint64_t)point_hi << 32 | point_lo;
+
+    drm_syncobj_timeline_unref(surface->pending.release_timeline);
+    surface->pending.release_timeline = drm_syncobj_timeline_ref(timeline);
+    surface->pending.release_point = point;
+}
+
+static const struct wp_linux_drm_syncobj_surface_v1_interface surface_impl = {
+    .destroy = surface_handle_destroy,
+    .set_acquire_point = surface_handle_set_acquire_point,
+    .set_release_point = surface_handle_set_release_point,
+};
+
+static void surface_handle_resource_destroy(struct wl_resource *resource)
+{
+    struct drm_syncobj_surface_v1 *surface = surface_from_resource(resource);
+    surface_destroy(surface);
+}
+
+static void surface_addon_handle_surface_destroy(struct wlr_addon *addon)
+{
+    struct drm_syncobj_surface_v1 *surface = wl_container_of(addon, surface, addon);
+    surface_destroy(surface);
+}
+
+static const struct wlr_addon_interface surface_addon_impl = {
+    .name = "wp_linux_drm_syncobj_surface_v1",
+    .destroy = surface_addon_handle_surface_destroy,
+};
+
+static void surface_synced_finish_state(void *_state)
+{
+    struct drm_syncobj_surface_v1_state *state = _state;
+    drm_syncobj_timeline_unref(state->acquire_timeline);
+    drm_syncobj_timeline_unref(state->release_timeline);
+    drm_syncobj_merger_unref(state->release_merger);
+}
+
+static void surface_synced_move_state(void *_dst, void *_src)
+{
+    struct drm_syncobj_surface_v1_state *dst = _dst, *src = _src;
+    if (src->acquire_timeline == NULL) {
+        // ignore commits that did not attach a buffer
+        return;
+    }
+
+    surface_synced_finish_state(dst);
+    *dst = *src;
+    dst->committed = true;
+    *src = (struct drm_syncobj_surface_v1_state){ 0 };
+}
+
+static void surface_synced_commit(struct wlr_surface_synced *synced)
+{
+    struct drm_syncobj_surface_v1 *surface = wl_container_of(synced, surface, synced);
+
+    if (!surface->current.committed) {
+        return;
+    }
+
+    surface->current.release_merger = drm_syncobj_merger_create(surface->current.release_timeline,
+                                                                surface->current.release_point);
+    surface->current.committed = false;
+}
+
+static const struct wlr_surface_synced_impl surface_synced_impl = {
+    .state_size = sizeof(struct drm_syncobj_surface_v1_state),
+    .finish_state = surface_synced_finish_state,
+    .move_state = surface_synced_move_state,
+    .commit = surface_synced_commit,
+};
+
+static void manager_handle_destroy(struct wl_client *client, struct wl_resource *resource)
+{
+    wl_resource_destroy(resource);
+}
+
+static struct drm_syncobj_surface_v1 *surface_from_wlr_surface(struct wlr_surface *wlr_surface)
+{
+    struct wlr_addon *addon = wlr_addon_find(&wlr_surface->addons, NULL, &surface_addon_impl);
+    if (addon == NULL) {
+        return NULL;
+    }
+    struct drm_syncobj_surface_v1 *surface = wl_container_of(addon, surface, addon);
+    return surface;
+}
+
+static void surface_commit_destroy(struct drm_syncobj_surface_v1_commit *commit)
+{
+    wlr_surface_unlock_cached(commit->surface, commit->cached_seq);
+    wl_list_remove(&commit->surface_destroy.link);
+    drm_syncobj_timeline_waiter_finish(&commit->waiter);
+    free(commit);
+}
+
+static void surface_commit_handle_waiter_ready(struct drm_syncobj_timeline_waiter *waiter)
+{
+    struct drm_syncobj_surface_v1_commit *commit = wl_container_of(waiter, commit, waiter);
+    surface_commit_destroy(commit);
+}
+
+static void surface_commit_handle_surface_destroy(struct wl_listener *listener, void *data)
+{
+    struct drm_syncobj_surface_v1_commit *commit =
+        wl_container_of(listener, commit, surface_destroy);
+    surface_commit_destroy(commit);
+}
+
+static bool lock_surface_commit(struct drm_syncobj_surface_v1 *surface,
+                                struct drm_syncobj_timeline *timeline, uint64_t point)
+{
+    uint32_t flags = DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE;
+
+    bool already_materialized = false;
+    if (!drm_syncobj_timeline_check(timeline, point, flags, &already_materialized)) {
+        return false;
+    } else if (already_materialized) {
+        return true;
+    }
+
+    struct drm_syncobj_surface_v1_commit *commit = calloc(1, sizeof(*commit));
+    if (commit == NULL) {
+        return false;
+    }
+
+    struct wl_client *client = wl_resource_get_client(surface->resource);
+    struct wl_display *display = wl_client_get_display(client);
+    struct wl_event_loop *loop = wl_display_get_event_loop(display);
+    if (!drm_syncobj_timeline_waiter_init(&commit->waiter, timeline, point, flags, loop,
+                                          surface_commit_handle_waiter_ready)) {
+        free(commit);
+        return false;
+    }
+
+    commit->surface = surface->surface;
+    commit->cached_seq = wlr_surface_lock_pending(surface->surface);
+
+    commit->surface_destroy.notify = surface_commit_handle_surface_destroy;
+    wl_signal_add(&surface->surface->events.destroy, &commit->surface_destroy);
+
+    return true;
+}
+
+static void surface_handle_client_commit(struct wl_listener *listener, void *data)
+{
+    struct drm_syncobj_surface_v1 *surface = wl_container_of(listener, surface, client_commit);
+
+    if (surface->pending.acquire_timeline != NULL && surface->surface->pending.buffer == NULL) {
+        wlr_surface_reject_pending(surface->surface, surface->resource,
+                                   WP_LINUX_DRM_SYNCOBJ_SURFACE_V1_ERROR_NO_BUFFER,
+                                   "Acquire point set but no buffer attached");
+        return;
+    }
+    if (surface->pending.release_timeline != NULL && surface->surface->pending.buffer == NULL) {
+        wlr_surface_reject_pending(surface->surface, surface->resource,
+                                   WP_LINUX_DRM_SYNCOBJ_SURFACE_V1_ERROR_NO_BUFFER,
+                                   "Release point set but no buffer attached");
+        return;
+    }
+
+    if (surface->pending.acquire_timeline == NULL && surface->surface->pending.buffer != NULL) {
+        wlr_surface_reject_pending(surface->surface, surface->resource,
+                                   WP_LINUX_DRM_SYNCOBJ_SURFACE_V1_ERROR_NO_ACQUIRE_POINT,
+                                   "Buffer attached but no acquire point set");
+        return;
+    }
+    if (surface->pending.release_timeline == NULL && surface->surface->pending.buffer != NULL) {
+        wlr_surface_reject_pending(surface->surface, surface->resource,
+                                   WP_LINUX_DRM_SYNCOBJ_SURFACE_V1_ERROR_NO_RELEASE_POINT,
+                                   "Buffer attached but no release point set");
+        return;
+    }
+
+    if (surface->pending.acquire_timeline != NULL && surface->pending.release_timeline != NULL &&
+        surface->pending.acquire_timeline == surface->pending.release_timeline &&
+        surface->pending.acquire_point >= surface->pending.release_point) {
+        wlr_surface_reject_pending(surface->surface, surface->resource,
+                                   WP_LINUX_DRM_SYNCOBJ_SURFACE_V1_ERROR_CONFLICTING_POINTS,
+                                   "Acquire and release points conflict");
+        return;
+    }
+
+    if (surface->pending.acquire_timeline != NULL &&
+        !lock_surface_commit(surface, surface->pending.acquire_timeline,
+                             surface->pending.acquire_point)) {
+        wl_resource_post_no_memory(surface->resource);
+        return;
+    }
+}
+
+static void manager_handle_get_surface(struct wl_client *client, struct wl_resource *resource,
+                                       uint32_t id, struct wl_resource *surface_resource)
+{
+    struct wlr_surface *wlr_surface = wlr_surface_from_resource(surface_resource);
+
+    if (surface_from_wlr_surface(wlr_surface) != NULL) {
+        wl_resource_post_error(resource, WP_LINUX_DRM_SYNCOBJ_MANAGER_V1_ERROR_SURFACE_EXISTS,
+                               "wp_linux_drm_syncobj_surface_v1 already created for this surface");
+        return;
+    }
+
+    struct drm_syncobj_surface_v1 *surface = calloc(1, sizeof(*surface));
+    if (surface == NULL) {
+        wl_resource_post_no_memory(resource);
+        return;
+    }
+
+    if (!wlr_surface_synced_init(&surface->synced, wlr_surface, &surface_synced_impl,
+                                 &surface->pending, &surface->current)) {
+        goto error_surface;
+    }
+
+    uint32_t version = wl_resource_get_version(resource);
+    surface->resource =
+        wl_resource_create(client, &wp_linux_drm_syncobj_surface_v1_interface, version, id);
+    if (surface->resource == NULL) {
+        goto error_surface_synced;
+    }
+    wl_resource_set_implementation(surface->resource, &surface_impl, surface,
+                                   surface_handle_resource_destroy);
+
+    surface->surface = wlr_surface;
+
+    surface->client_commit.notify = surface_handle_client_commit;
+    wl_signal_add(&wlr_surface->events.client_commit, &surface->client_commit);
+
+    wlr_addon_init(&surface->addon, &wlr_surface->addons, NULL, &surface_addon_impl);
+
+    return;
+
+error_surface_synced:
+    wlr_surface_synced_finish(&surface->synced);
+error_surface:
+    free(surface);
+    wl_resource_post_no_memory(resource);
+}
+
+static void manager_handle_import_timeline(struct wl_client *client, struct wl_resource *resource,
+                                           uint32_t id, int drm_syncobj_fd)
+{
+    struct drm_syncobj_manager_v1 *manager = manager_from_resource(resource);
+
+    struct drm_syncobj_timeline *timeline =
+        drm_syncobj_timeline_import(manager->drm_fd, drm_syncobj_fd);
+    close(drm_syncobj_fd);
+    if (timeline == NULL) {
+        wl_resource_post_error(resource, WP_LINUX_DRM_SYNCOBJ_MANAGER_V1_ERROR_INVALID_TIMELINE,
+                               "Failed to import drm_syncobj timeline");
+        return;
+    }
+
+    uint32_t version = wl_resource_get_version(resource);
+    struct wl_resource *timeline_resource =
+        wl_resource_create(client, &wp_linux_drm_syncobj_timeline_v1_interface, version, id);
+    if (timeline_resource == NULL) {
+        drm_syncobj_timeline_unref(timeline);
+        wl_resource_post_no_memory(resource);
+        return;
+    }
+    wl_resource_set_implementation(timeline_resource, &timeline_impl, timeline,
+                                   timeline_handle_resource_destroy);
+}
+
+static const struct wp_linux_drm_syncobj_manager_v1_interface manager_impl = {
+    .destroy = manager_handle_destroy,
+    .get_surface = manager_handle_get_surface,
+    .import_timeline = manager_handle_import_timeline,
+};
+
+static void manager_bind(struct wl_client *client, void *data, uint32_t version, uint32_t id)
+{
+    struct drm_syncobj_manager_v1 *manager = data;
+
+    struct wl_resource *resource =
+        wl_resource_create(client, &wp_linux_drm_syncobj_manager_v1_interface, version, id);
+    if (resource == NULL) {
+        wl_client_post_no_memory(client);
+        return;
+    }
+    wl_resource_set_implementation(resource, &manager_impl, manager, NULL);
+}
+
+static void handle_display_destroy(struct wl_listener *listener, void *data)
+{
+    struct drm_syncobj_manager_v1 *manager = wl_container_of(listener, manager, display_destroy);
+    wl_list_remove(&manager->display_destroy.link);
+    wl_global_destroy(manager->global);
+    close(manager->drm_fd);
+    free(manager);
+}
+
+static bool check_syncobj_eventfd(int drm_fd)
+{
+    if (!HAVE_EVENTFD) {
+        return false;
+    }
+
+    uint64_t value = 0;
+    if (drmGetCap(drm_fd, DRM_CAP_SYNCOBJ_TIMELINE, &value) || !value) {
+        return false;
+    }
+
+    struct drm_syncobj_eventfd syncobj_eventfd = {
+        .handle = 0,
+        .fd = -1,
+    };
+    return drmIoctl(drm_fd, DRM_IOCTL_SYNCOBJ_EVENTFD, &syncobj_eventfd) != 0 && errno == ENOENT;
+}
+
+struct drm_syncobj_manager_v1 *drm_syncobj_manager_v1_create(struct wl_display *display, int drm_fd)
+{
+    if (!check_syncobj_eventfd(drm_fd)) {
+        kywc_log(KYWC_INFO, "DRM syncobj eventfd unavailable, disabling linux-drm-syncobj-v1");
+        return NULL;
+    }
+
+    struct drm_syncobj_manager_v1 *manager = calloc(1, sizeof(*manager));
+    if (manager == NULL) {
+        return NULL;
+    }
+
+    manager->drm_fd = fcntl(drm_fd, F_DUPFD_CLOEXEC, 0);
+    if (manager->drm_fd < 0) {
+        goto error_manager;
+    }
+
+    manager->global = wl_global_create(display, &wp_linux_drm_syncobj_manager_v1_interface,
+                                       LINUX_DRM_SYNCOBJ_V1_VERSION, manager, manager_bind);
+    if (manager->global == NULL) {
+        goto error_drm_fd;
+    }
+
+    manager->display_destroy.notify = handle_display_destroy;
+    wl_display_add_destroy_listener(display, &manager->display_destroy);
+
+    return manager;
+
+error_drm_fd:
+    close(manager->drm_fd);
+error_manager:
+    free(manager);
+    return NULL;
+}
+
+struct drm_syncobj_surface_v1_state *
+drm_syncobj_v1_get_surface_state(struct wlr_surface *wlr_surface)
+{
+    struct drm_syncobj_surface_v1 *surface = surface_from_wlr_surface(wlr_surface);
+    if (surface == NULL) {
+        return NULL;
+    }
+    return &surface->current;
+}
+
+struct release_signaller {
+    struct drm_syncobj_merger *merger;
+    struct wl_listener buffer_release;
+};
+
+static void release_signaller_handle_buffer_release(struct wl_listener *listener, void *data)
+{
+    struct release_signaller *signaller = wl_container_of(listener, signaller, buffer_release);
+
+    drm_syncobj_merger_unref(signaller->merger);
+    wl_list_remove(&signaller->buffer_release.link);
+    free(signaller);
+}
+
+bool drm_syncobj_v1_state_signal_release_with_buffer(struct drm_syncobj_surface_v1_state *state,
+                                                     struct wlr_buffer *buffer)
+{
+    assert(buffer->n_locks > 0);
+    if (state->release_merger == NULL) {
+        return true;
+    }
+
+    struct release_signaller *signaller = calloc(1, sizeof(*signaller));
+    if (signaller == NULL) {
+        return false;
+    }
+    signaller->merger = drm_syncobj_merger_ref(state->release_merger);
+    signaller->buffer_release.notify = release_signaller_handle_buffer_release;
+    wl_signal_add(&buffer->events.release, &signaller->buffer_release);
+
+    return true;
+}
+
+bool drm_syncobj_v1_state_add_release_point(struct drm_syncobj_surface_v1_state *state,
+                                            struct drm_syncobj_timeline *release_timeline,
+                                            uint64_t release_point,
+                                            struct wl_event_loop *event_loop)
+{
+    if (state->release_merger == NULL) {
+        // This can happen if an existing surface with a buffer has a
+        // syncobj_surface_v1_state created but no new buffer with release
+        // timeline committed.
+        return true;
+    }
+    return drm_syncobj_merger_add(state->release_merger, release_timeline, release_point,
+                                  event_loop);
+}
