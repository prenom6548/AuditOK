diff --git a/src/plugin/security/gui.cpp b/src/plugin/security/gui.cpp
new file mode 100644
index 0000000..411e638
--- /dev/null
+++ b/src/plugin/security/gui.cpp
@@ -0,0 +1,463 @@
+// SPDX-FileCopyrightText: 2026 KylinSoft Co., Ltd.
+//
+// SPDX-License-Identifier: GPL-1.0-or-later
+
+#include <QApplication>
+#include <QColorDialog>
+#include <QComboBox>
+#include <QCompleter>
+#include <QDebug>
+#include <QFileDialog>
+#include <QFileSystemModel>
+#include <QFontComboBox>
