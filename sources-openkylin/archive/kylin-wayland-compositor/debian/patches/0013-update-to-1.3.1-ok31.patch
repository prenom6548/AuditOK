diff --git a/src/view/xdg_toplevel_tag.c b/src/view/xdg_toplevel_tag.c
new file mode 100644
index 0000000..670b2c5
--- /dev/null
+++ b/src/view/xdg_toplevel_tag.c
@@ -0,0 +1,119 @@
+// SPDX-FileCopyrightText: 2026 KylinSoft Co., Ltd.
+//
+// SPDX-License-Identifier: GPL-1.0-or-later
+
+#define _POSIX_C_SOURCE 200809L
+#include <stdlib.h>
+#include <wlr/types/wlr_xdg_shell.h>
+
+#include "view_p.h"
+#include "xdg-toplevel-tag-v1-protocol.h"
+
+#define XDG_TOPLEVEL_TAG_MANAGER_VERSION 1
+
+struct xdg_toplevel_tag_manager {
+    struct wl_global *global;
+
+    struct wl_listener display_destroy;
+    struct wl_listener server_destroy;
+};
+
+static void manager_handle_destroy(struct wl_client *client, struct wl_resource *resource)
+{
+    wl_resource_destroy(resource);
+}
+
+static void manager_handle_set_tag(struct wl_client *client, struct wl_resource *manager_resource,
+                                   struct wl_resource *toplevel_resource, const char *tag)
+{
+    struct wlr_xdg_toplevel *toplevel = wlr_xdg_toplevel_from_resource(toplevel_resource);
+    if (!toplevel) {
+        return;
+    }
+
+    struct view *view = view_try_from_wlr_surface(toplevel->base->surface);
+    if (!view || (view->tag && strcmp(view->tag, tag) == 0)) {
+        return;
+    }
+
+    free(view->tag);
+    view->tag = strdup(tag);
+}
+
+static void manager_handle_set_description(struct wl_client *client,
+                                           struct wl_resource *manager_resource,
+                                           struct wl_resource *toplevel_resource,
+                                           const char *description)
+{
+    struct wlr_xdg_toplevel *toplevel = wlr_xdg_toplevel_from_resource(toplevel_resource);
+    if (!toplevel) {
+        return;
+    }
+
+    struct view *view = view_try_from_wlr_surface(toplevel->base->surface);
+    if (!view || (view->description && strcmp(view->description, description) == 0)) {
+        return;
+    }
+
+    free(view->description);
+    view->description = strdup(description);
+}
+
+static const struct xdg_toplevel_tag_manager_v1_interface xdg_toplevel_tag_manager_impl = {
+    .destroy = manager_handle_destroy,
+    .set_toplevel_tag = manager_handle_set_tag,
+    .set_toplevel_description = manager_handle_set_description,
+};
+
+static void xdg_toplevel_tag_manager_bind(struct wl_client *client, void *data, uint32_t version,
+                                          uint32_t id)
+{
+    struct xdg_toplevel_tag_manager *manager = data;
+
+    struct wl_resource *resource =
+        wl_resource_create(client, &xdg_toplevel_tag_manager_v1_interface, version, id);
+    if (!resource) {
+        wl_client_post_no_memory(client);
+        return;
+    }
+
+    wl_resource_set_implementation(resource, &xdg_toplevel_tag_manager_impl, manager, NULL);
+}
+
+static void handle_display_destroy(struct wl_listener *listener, void *data)
+{
+    struct xdg_toplevel_tag_manager *manager = wl_container_of(listener, manager, display_destroy);
+    wl_list_remove(&manager->display_destroy.link);
+    wl_global_destroy(manager->global);
+}
+
+static void handle_server_destroy(struct wl_listener *listener, void *data)
+{
+    struct xdg_toplevel_tag_manager *manager = wl_container_of(listener, manager, server_destroy);
+    wl_list_remove(&manager->server_destroy.link);
+    free(manager);
+}
+
+bool xdg_toplevel_tag_manager_create(struct server *server)
+{
+    struct xdg_toplevel_tag_manager *manager = calloc(1, sizeof(*manager));
+    if (!manager) {
+        return false;
+    }
+
+    manager->global =
+        wl_global_create(server->display, &xdg_toplevel_tag_manager_v1_interface,
+                         XDG_TOPLEVEL_TAG_MANAGER_VERSION, manager, xdg_toplevel_tag_manager_bind);
+    if (!manager->global) {
+        kywc_log(KYWC_WARN, "Xdg toplevel tag manager create failed");
+        free(manager);
+        return false;
+    }
+
+    manager->display_destroy.notify = handle_display_destroy;
+    wl_display_add_destroy_listener(server->display, &manager->display_destroy);
+    manager->server_destroy.notify = handle_server_destroy;
+    server_add_destroy_listener(server, &manager->server_destroy);
+
+    return true;
+}
diff --git a/src/xwayland/config.c b/src/xwayland/config.c
new file mode 100644
index 0000000..858daf9
--- /dev/null
+++ b/src/xwayland/config.c
@@ -0,0 +1,76 @@
+// SPDX-FileCopyrightText: 2026 KylinSoft Co., Ltd.
+//
+// SPDX-License-Identifier: GPL-1.0-or-later
+
+#include "config.h"
+#include "util/dbus.h"
+#include "util/macros.h"
+#include "xwayland_p.h"
+
+static const char *service_path = "/com/kylin/Wlcom/Xwayland";
+static const char *service_interface = "com.kylin.Wlcom.Xwayland";
+
+static int set_eavesdrops_key_mode(sd_bus_message *m, void *userdata, sd_bus_error *ret_error)
+{
+    struct xwayland_manager *xwayland = userdata;
+    uint32_t eavesdrops_key_mode;
+    CK(sd_bus_message_read(m, "u", &eavesdrops_key_mode));
+
+    if (eavesdrops_key_mode > ALL_KEYS) {
+        const sd_bus_error error =
+            SD_BUS_ERROR_MAKE_CONST(SD_BUS_ERROR_INVALID_ARGS, "Invalid eavesdrops_key_mode.");
+        return sd_bus_reply_method_error(m, &error);
+    }
+
+    xwayland->state.eavesdrops_key_mode = eavesdrops_key_mode;
+
+    return sd_bus_reply_method_return(m, NULL);
+}
+
+static int get_eavesdrops_key_mode(sd_bus_message *m, void *userdata, sd_bus_error *ret_error)
+{
+    struct xwayland_manager *xwayland = userdata;
+    return sd_bus_reply_method_return(m, "u", xwayland->state.eavesdrops_key_mode);
+}
+
+static const sd_bus_vtable service_vtable[] = {
+    SD_BUS_VTABLE_START(0),
+    SD_BUS_METHOD("SetEavesdropsKeyMode", "u", "", set_eavesdrops_key_mode,
+                  SD_BUS_VTABLE_UNPRIVILEGED),
+    SD_BUS_METHOD("GetEavesdropsKeyMode", "", "u", get_eavesdrops_key_mode,
+                  SD_BUS_VTABLE_UNPRIVILEGED),
+    SD_BUS_VTABLE_END,
+};
+
+bool xwayland_config_init(struct xwayland_manager *xwayland)
+{
+    xwayland->config = config_manager_add_config("Xwayland");
+    if (!xwayland->config) {
+        return false;
+    }
+    return dbus_register_object(NULL, service_path, service_interface, service_vtable, xwayland);
+}
+
+bool xwayland_read_config(struct xwayland_manager *xwayland)
+{
+    if (!xwayland->config || !xwayland->config->json) {
+        return false;
+    }
+
+    json_object *data;
+    if (json_object_object_get_ex(xwayland->config->json, "eavesdrops_key_mode", &data)) {
+        xwayland->state.eavesdrops_key_mode = CLAMP(json_object_get_int(data), NONE_KEYS, ALL_KEYS);
+    }
+
+    return true;
+}
+
+void xwayland_write_config(struct xwayland_manager *xwayland)
+{
+    if (!xwayland->config) {
+        return;
+    }
+
+    json_object_object_add(xwayland->config->json, "eavesdrops_key_mode",
+                           json_object_new_int(xwayland->state.eavesdrops_key_mode));
+}
diff --git a/src/xwayland/eavesdrops.c b/src/xwayland/eavesdrops.c
new file mode 100644
index 0000000..85ed3c4
--- /dev/null
+++ b/src/xwayland/eavesdrops.c
@@ -0,0 +1,287 @@
+// SPDX-FileCopyrightText: 2026 KylinSoft Co., Ltd.
+//
+// SPDX-License-Identifier: GPL-1.0-or-later
+
+#include <linux/input-event-codes.h>
+
+#include <wlr/types/wlr_keyboard.h>
+#include <wlr/types/wlr_seat.h>
+
+#include "input/keyboard.h"
+#include "input/seat.h"
+#include "util/time.h"
+#include "xwayland_p.h"
+
+static struct eavesdrops_manager {
+    struct xwm *xwm;
+
+    struct seat *seat;
+    struct wl_listener keyboard_key;
+    struct wl_listener keyboard_modifiers;
+
+    /**
+     * keycodes that have been forwarded to Xwayland and are still pressed.
+     * Their release events must always be forwarded to keep Xwayland's
+     * keyboard state consistent.
+     *
+     * Bitmap of pressed keys, indexed by keycode. Linux keycodes range
+     * from 8 to 255, so 256 bits (4 x 64-bit words) are sufficient.
+     */
+    uint64_t pressed_keys[4];
+} *manager;
+
+static bool key_is_modifier(unsigned int code)
+{
+    switch (code) {
+    case KEY_LEFTSHIFT:
+    case KEY_RIGHTSHIFT:
+
+    case KEY_LEFTCTRL:
+    case KEY_RIGHTCTRL:
+
+    case KEY_LEFTALT:
+    case KEY_RIGHTALT:
+
+    case KEY_LEFTMETA:
+    case KEY_RIGHTMETA:
+
+    case KEY_CAPSLOCK:
+    case KEY_NUMLOCK:
+    case KEY_SCROLLLOCK:
+        return true;
+
+    default:
+        return false;
+    }
+}
+
+/**
+ * Bitmap operations for pressed_keys, following the same pattern as
+ * X Server's BitIsOn/SetBit/ClearBit macros in inputstr.h.
+ */
+#define KEY_BITMAP_BYTES (sizeof(manager->pressed_keys))
+#define KEY_BITMAP_BITS (KEY_BITMAP_BYTES * 8)
+
+#define key_bitmap_is_on(bitmap, bit)                                                              \
+    (!!(((const uint64_t *)(bitmap))[(bit) >> 6] & (1ULL << ((bit) & 63))))
+#define key_bitmap_set(bitmap, bit) (((uint64_t *)(bitmap))[(bit) >> 6] |= (1ULL << ((bit) & 63)))
+#define key_bitmap_clear(bitmap, bit)                                                              \
+    (((uint64_t *)(bitmap))[(bit) >> 6] &= ~(1ULL << ((bit) & 63)))
+
+static bool eavesdrops_pressed_key_contains(uint32_t keycode)
+{
+    if (keycode >= KEY_BITMAP_BITS) {
+        return false;
+    }
+    return key_bitmap_is_on(manager->pressed_keys, keycode);
+}
+
+static void eavesdrops_pressed_key_add(uint32_t keycode)
+{
+    if (keycode >= KEY_BITMAP_BITS) {
+        return;
+    }
+    key_bitmap_set(manager->pressed_keys, keycode);
+}
+
+static void eavesdrops_pressed_key_remove(uint32_t keycode)
+{
+    if (keycode >= KEY_BITMAP_BITS) {
+        return;
+    }
+    key_bitmap_clear(manager->pressed_keys, keycode);
+}
+
+static void eavesdrops_release_pressed_keys(void)
+{
+    struct xwayland_manager *xwayland = manager->xwm->xwayland;
+    if (!xwayland->xwayland_server || !xwayland->xwayland_server->client) {
+        return;
+    }
+
+    struct wlr_seat *wlr_seat = manager->seat->wlr_seat;
+    struct wlr_seat_client *seat_client =
+        wlr_seat_client_for_wl_client(wlr_seat, xwayland->xwayland_server->client);
+    if (!seat_client) {
+        return;
+    }
+
+    uint32_t time_msec = current_time_msec();
+    uint32_t serial = wlr_seat_client_next_serial(seat_client);
+
+    for (uint32_t word = 0; word < KEY_BITMAP_BYTES / sizeof(uint64_t); word++) {
+        if (manager->pressed_keys[word] == 0) {
+            continue;
+        }
+
+        for (uint32_t bit = 0; bit < 64; bit++) {
+            uint32_t keycode = word * 64 + bit;
+            if (!eavesdrops_pressed_key_contains(keycode)) {
+                continue;
+            }
+
+            struct wl_resource *resource;
+            wl_resource_for_each(resource, &seat_client->keyboards) {
+                wl_keyboard_send_key(resource, serial, time_msec, keycode, false);
+            }
+
+            eavesdrops_pressed_key_remove(keycode);
+        }
+    }
+}
+
+static void handle_keyboard_key(struct wl_listener *listener, void *data)
+{
+    struct xwayland_manager *xwayland = manager->xwm->xwayland;
+    if (!xwayland->xwayland_server || !xwayland->xwayland_server->client) {
+        return;
+    }
+
+    if (xwayland->state.eavesdrops_key_mode == NONE_KEYS) {
+        return;
+    }
+
+    struct wlr_seat *wlr_seat = manager->seat->wlr_seat;
+    if (wlr_seat->keyboard_state.focused_client &&
+        xwayland_check_client(wlr_seat->keyboard_state.focused_client->client)) {
+        return;
+    }
+
+    struct seat *seat = manager->seat;
+    struct seat_keyboard_key_event *event = data;
+
+    /**
+     * If there's an active keystroke, keep sending events regardless what the
+     * key filter says. This ensures the release event of a key whose press was
+     * forwarded to Xwayland is always delivered, keeping Xwayland's keyboard
+     * state consistent.
+     */
+    if (!eavesdrops_pressed_key_contains(event->keycode)) {
+        if (event->consumed && !key_is_modifier(event->keycode)) {
+            return;
+        }
+
+        uint32_t modifiers = wlr_keyboard_get_modifiers(seat->keyboard->wlr_keyboard);
+        if (xwayland->state.eavesdrops_key_mode == ALL_KEYS_WITH_MODIFIER) {
+            /**
+             * Only Ctrl/Alt/Meta (and non-character keys) trigger forwarding.
+             * Shift is deliberately excluded so that e.g. Shift+A is not
+             * forwarded, matching KWin's AllKeysWithModifier behavior.
+             */
+            const uint32_t modifier_keys = WLR_MODIFIER_CTRL | WLR_MODIFIER_ALT | WLR_MODIFIER_LOGO;
+            if ((modifiers & modifier_keys) == 0 && !key_is_modifier(event->keycode)) {
+                return;
+            }
+        }
+    }
+
+    struct wlr_seat_client *seat_client =
+        wlr_seat_client_for_wl_client(wlr_seat, xwayland->xwayland_server->client);
+    if (!seat_client) {
+        return;
+    }
+
+    if (event->pressed) {
+        eavesdrops_pressed_key_add(event->keycode);
+    } else {
+        eavesdrops_pressed_key_remove(event->keycode);
+    }
+
+    uint32_t serial = wlr_seat_client_next_serial(seat_client);
+    struct wl_resource *resource;
+    wl_resource_for_each(resource, &seat_client->keyboards) {
+        wl_keyboard_send_key(resource, serial, event->time_msec, event->keycode, event->pressed);
+    }
+}
+
+static void handle_keyboard_modifiers(struct wl_listener *listener, void *data)
+{
+    struct xwayland_manager *xwayland = manager->xwm->xwayland;
+    if (!xwayland->xwayland_server || !xwayland->xwayland_server->client) {
+        return;
+    }
+
+    if (xwayland->state.eavesdrops_key_mode == NONE_KEYS) {
+        return;
+    }
+
+    struct wlr_seat *wlr_seat = manager->seat->wlr_seat;
+    if (wlr_seat->keyboard_state.focused_client &&
+        xwayland_check_client(wlr_seat->keyboard_state.focused_client->client)) {
+        return;
+    }
+
+    struct wlr_seat_client *seat_client =
+        wlr_seat_client_for_wl_client(wlr_seat, xwayland->xwayland_server->client);
+    if (!seat_client) {
+        return;
+    }
+
+    struct wlr_keyboard_modifiers *modifiers = data;
+    uint32_t serial = wlr_seat_client_next_serial(seat_client);
+    struct wl_resource *resource;
+    wl_resource_for_each(resource, &seat_client->keyboards) {
+        if (!modifiers) {
+            wl_keyboard_send_modifiers(resource, serial, 0, 0, 0, 0);
+        } else {
+            wl_keyboard_send_modifiers(resource, serial, modifiers->depressed, modifiers->latched,
+                                       modifiers->locked, modifiers->group);
+        }
+    }
+}
+
+void eavesdrops_manager_destroy(void)
+{
+    if (!manager) {
+        return;
+    }
+
+    wl_list_remove(&manager->keyboard_key.link);
+    wl_list_remove(&manager->keyboard_modifiers.link);
+    free(manager);
+    manager = NULL;
+}
+
+bool eavesdrops_manager_create(struct xwm *xwm)
+{
+    if (manager) {
+        return false;
+    }
+
+    manager = calloc(1, sizeof(*manager));
+    if (!manager) {
+        return false;
+    }
+
+    manager->xwm = xwm;
+    manager->keyboard_key.notify = handle_keyboard_key;
+    wl_list_init(&manager->keyboard_key.link);
+    manager->keyboard_modifiers.notify = handle_keyboard_modifiers;
+    wl_list_init(&manager->keyboard_modifiers.link);
+
+    return true;
+}
+
+void eavesdrops_manager_set_seat(struct seat *seat)
+{
+    if (!manager) {
+        return;
+    }
+
+    if (manager->seat != NULL) {
+        eavesdrops_release_pressed_keys();
+
+        wl_list_remove(&manager->keyboard_key.link);
+        wl_list_init(&manager->keyboard_key.link);
+        wl_list_remove(&manager->keyboard_modifiers.link);
+        wl_list_init(&manager->keyboard_modifiers.link);
+    }
+
+    manager->seat = seat;
+    if (!seat) {
+        return;
+    }
+
+    wl_signal_add(&seat->events.keyboard_key, &manager->keyboard_key);
+    wl_signal_add(&seat->events.keyboard_modifiers, &manager->keyboard_modifiers);
+}
