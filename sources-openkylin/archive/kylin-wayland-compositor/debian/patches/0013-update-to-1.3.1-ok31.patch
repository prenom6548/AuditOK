+
+EGLSyncKHR egl_create_sync(struct egl *egl, int fence_fd)
+{
+    EGLint attribs[3] = { EGL_NONE };
+    int dup_fd = -1;
+    if (fence_fd >= 0) {
+        dup_fd = fcntl(fence_fd, F_DUPFD_CLOEXEC, 0);
+        if (dup_fd < 0) {
+            kywc_log_errno(KYWC_ERROR, "Failed to dup FENCE FD");
+            return EGL_NO_SYNC_KHR;
+        }
+
+        attribs[0] = EGL_SYNC_NATIVE_FENCE_FD_ANDROID;
+        attribs[1] = dup_fd;
+        attribs[2] = EGL_NONE;
+    }
+
+    EGLSyncKHR sync = eglCreateSyncKHR(egl->display, EGL_SYNC_NATIVE_FENCE_ANDROID, attribs);
+    if (sync == EGL_NO_SYNC_KHR) {
+        kywc_log(KYWC_ERROR, "Failed with eglCreateSyncKHR");
+        if (dup_fd >= 0) {
+            close(dup_fd);
+        }
+    }
+    return sync;
+}
+
+void egl_destroy_sync(struct egl *egl, EGLSyncKHR sync)
+{
+    if (sync == EGL_NO_SYNC_KHR) {
+        return;
+    }
+
+    if (!eglDestroySyncKHR(egl->display, sync)) {
+        kywc_log(KYWC_ERROR, "Failed with eglDestroySyncKHR");
+    }
+}
+
+int egl_dup_fence_fd(struct egl *egl, EGLSyncKHR sync)
+{
+    int fd = eglDupNativeFenceFDANDROID(egl->display, sync);
+    if (fd == EGL_NO_NATIVE_FENCE_FD_ANDROID) {
+        kywc_log(KYWC_ERROR, "Failed with eglDupNativeFenceFDANDROID");
+        return -1;
+    }
+
+    return fd;
+}
+
+bool egl_wait_sync(struct egl *egl, EGLSyncKHR sync)
+{
+    if (!eglWaitSyncKHR(egl->display, sync, 0)) {
+        kywc_log(KYWC_ERROR, "Failed with eglWaitSyncKHR");
+        return false;
+    }
+    return true;
+}
