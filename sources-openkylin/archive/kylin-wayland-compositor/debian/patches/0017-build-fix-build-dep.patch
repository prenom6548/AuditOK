+static void global_shortcut_clear_binding(struct global_shortcut *shortcut)
+{
+    if (!shortcut->binding) {
+        return;
+    }
+
+    shortcut->binding = NULL;
+    shortcut->is_registered = false;
+    wl_list_remove(&shortcut->binding_destroy.link);
+    wl_list_init(&shortcut->binding_destroy.link);
+}
+
+static void handle_key_binding_destroy(struct wl_listener *listener, void *data)
+{
+    struct global_shortcut *shortcut = wl_container_of(listener, shortcut, binding_destroy);
+    global_shortcut_clear_binding(shortcut);
+}
+
+static void global_shortcut_set_binding(struct global_shortcut *shortcut,
+                                        struct key_binding *binding)
+{
+    if (shortcut->binding == binding) {
+        return;
+    }
+    if (shortcut->binding) {
+        global_shortcut_clear_binding(shortcut);
+    }
+
+    shortcut->binding = binding;
+    shortcut->binding_destroy.notify = handle_key_binding_destroy;
+    kywc_key_binding_add_destroy_listener(binding, &shortcut->binding_destroy);
+}
