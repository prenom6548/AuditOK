+
+    wl_seat_add_listener(wl_seat, &seat_listener, seat);
+
+    return seat;
+}
+
+void seat_destroy(seat *seat)
+{
+    if (!seat) {
+        return;
+    }
+
+    wl_seat_destroy(seat->wl_seat);
+    free(seat->name);
+    free(seat);
+}
