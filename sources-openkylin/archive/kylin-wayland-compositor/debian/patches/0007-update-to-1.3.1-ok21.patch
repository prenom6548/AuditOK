+static bool tiled_assist_views_check(struct view *view)
+{
+    for (int i = 0; i < SLOT_TYPE_COUNT; i++) {
+        if (manager->tiled_layer.proxy[i] && manager->tiled_layer.proxy[i]->item->view == view) {
+            return true;
