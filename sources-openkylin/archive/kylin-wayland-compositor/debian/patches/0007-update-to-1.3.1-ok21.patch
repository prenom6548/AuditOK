diff --git a/tools/magnifier/main.cpp b/tools/magnifier/main.cpp
new file mode 100644
index 0000000..cc14f46
--- /dev/null
+++ b/tools/magnifier/main.cpp
@@ -0,0 +1,42 @@
+// SPDX-FileCopyrightText: 2025 KylinSoft Co., Ltd.
+//
+// SPDX-License-Identifier: GPL-1.0-or-later
+
+#include <QApplication>
+#include <QLibraryInfo>
+#include <QLocale>
+#include <QTranslator>
+
+#include "magnifier.h"
+
+int main(int argc, char *argv[])
+{
+    QApplication app(argc, argv);
+
+    QTranslator appTranslator;
+    QTranslator qtTranslator;
+
+    QString systemLanguage = QLocale::system().name();
+    QString translationFile = "translations/" + systemLanguage;
+
+    if (appTranslator.load(translationFile, "/usr/share/kylin-magnifier")) {
+        app.installTranslator(&appTranslator);
+    }
+
+    if (qtTranslator.load(QString("qt_%1").arg(systemLanguage),
+                          QLibraryInfo::location(QLibraryInfo::TranslationsPath))) {
+        app.installTranslator(&qtTranslator);
+    }
+
+    int type = 1;
+    if (argc > 1) {
+        type = QString(argv[1]).toInt();
+    }
+
+    Magnifier magnifier(type);
+    if (!magnifier.checkZoomIsStarted()) {
+        return 0;
+    }
+    magnifier.show();
+    return app.exec();
+}
diff --git a/tools/magnifier/meson.build b/tools/magnifier/meson.build
new file mode 100644
index 0000000..6c5968a
--- /dev/null
+++ b/tools/magnifier/meson.build
@@ -0,0 +1,44 @@
+if not add_languages('cpp', native: false, required: false)
+  subdir_done()
+endif
+
+qt5 = import('qt5')
+qt5dep = dependency('qt5', modules: ['Core', 'DBus', 'Widgets', 'Gui'], private_headers: true, required: false)
+gsettings_dep = dependency('gsettings-qt')
+kysdk_ukuiwindowhelper = dependency('kysdk-ukuiwindowhelper')
+
+subdir('translations')
+
+build_dir = meson.current_build_dir()
+mag_sources = []
+
+qdbusxml2cpp = find_program('qdbusxml2cpp')
+
+xml_file = {
+  'org_ukui_Magnifier': 'org.ukui.Magnifier.xml',
+  'com_kylin_Wlcom_Effect': 'com.kylin.Wlcom.Effect.xml',
+}
+
+foreach name, path : xml_file
+  base_name = name.underscorify()
+  gen_result = run_command([qdbusxml2cpp, '-p', join_paths(build_dir, base_name), path, '-N', '-i', 'dbus_interface_date.h'], check: true)
+  mag_sources += qt5.preprocess(moc_headers: [join_paths(build_dir, base_name + '.h')], sources: [join_paths(build_dir, base_name + '.cpp')])
+endforeach
+
+res_processed = qt5.preprocess(
+  moc_headers: 'magnifier.h',
+  qresources: files('svg.qrc'),
+)
+
+mag_sources += [
+  res_processed,
+  'magnifier.cpp',
+  'main.cpp',
+]
+
+executable('kylin-magnifier',
+  sources: [mag_sources],
+  dependencies: [qt5dep, gsettings_dep, wayland_client, kysdk_ukuiwindowhelper],
+  build_by_default: true,
+  install: true,
+)
diff --git a/tools/magnifier/org.ukui.Magnifier.xml b/tools/magnifier/org.ukui.Magnifier.xml
new file mode 100644
index 0000000..f629454
--- /dev/null
+++ b/tools/magnifier/org.ukui.Magnifier.xml
@@ -0,0 +1,77 @@
+<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-Bus Object Introspection 1.0//EN"
+                      "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
+<node>
+  <interface name="org.ukui.Magnifier">
+    <!--
+      StartZoom: 启动缩放效果
+      @param1: 缩放模式 (u) - 无符号整数
+      enum zoom_type {
+          ZOOM_OUTPUT = 0,
+          ZOOM_WINDOW,
+      };
+      @param2: 缩放比例 (u) - 无符号整数
+      Returns: 操作是否成功 (b) - 布尔值
+    -->
+    <method name="StartZoom">
+      <arg name="mode" type="u" direction="in"/>
+      <arg name="scale" type="u" direction="in"/>
+      <arg name="success" type="b" direction="out"/>
+    </method>
+
+    <!--
+      SetMagnifierMode: 设置放大镜模式
+      @mode: 模式类型 (u) - 无符号整数
+      Returns: 操作是否成功 (b) - 布尔值
+    -->
+    <method name="SetMagnifierMode">
+      <arg name="mode" type="u" direction="in"/>
+      <arg name="success" type="b" direction="out"/>
+    </method>
+
+    <!--
+      ZoomIn: 放大
+      Returns: 操作是否成功 (b) - 布尔值
+    -->
+    <method name="ZoomIn">
+      <arg name="success" type="b" direction="out"/>
+    </method>
+
+    <!--
+      ZoomOut: 缩小
+      Returns: 操作是否成功 (b) - 布尔值
+    -->
+    <method name="ZoomOut">
+      <arg name="success" type="b" direction="out"/>
+    </method>
+
+    <!--
+      IsZooming: 检查是否正在缩放
+      Returns: 是否正在缩放 (b) - 布尔值
+    -->
+    <method name="IsZooming">
+      <arg name="zooming" type="b" direction="out"/>
+    </method>
+
+    <!--
+      GetScale: 获取当前缩放值
+      Returns: 当前缩放值 (i) - 整数
+    -->
+    <method name="GetScale">
+      <arg name="scale" type="i" direction="out"/>
+    </method>
+
+    <!--
+      StopZoom: 停止缩放效果
+      无参数，无返回值
+    -->
+    <method name="StopZoom">
+    </method>
+
+    <signal name="scaleChanged">
+      <arg name="newScale" type="u" direction="out"/>
+    </signal>
+
+    <signal name="zoomStop">
+    </signal>
+  </interface>
+</node>
