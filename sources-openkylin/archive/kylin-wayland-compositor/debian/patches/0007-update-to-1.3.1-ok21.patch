+<!DOCTYPE node PUBLIC
+'-//freedesktop//DTD D-BUS Object Introspection 1.0//EN'
+'http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd'>
+<node>
+    <interface name="com.kylin.Wlcom.Effect">
+        <description summary="com.kylin.Wlcom.Effect">
+        桌面效果管理相关的功能，包括启用或禁用效果、列出所有效果及其状态、
+        打印特定效果的选项以及设置这些选项的值。
+        </description>
+        <!-- Method: EnableEffect -->
+        <method name="EnableEffect">
+            <description summary="EnableEffect">
+            启用或禁用指定的效果。
+            输入参数：
+                effectName (类型为 s)：效果名称。
+                enable (类型为 b)：布尔值，表示是否启用该效果。
+            </description>
+            <arg name="effectName" type="s" direction="in"/>
+            <arg name="enable" type="b" direction="in"/>
+        </method>
+
+        <!-- Method: ListAllEffects -->
+        <method name="ListAllEffects">
+            <description summary="ListAllEffects">
+            列出所有可用的效果及其状态。
+            输出参数:包含多个元组的数组(a(sub))，每个元组包含三个元素：
+                特效名称（字符串）
+                特效优先级
+                启用状态（布尔值）
+            </description>
+            <arg name = "effects" type="a(sub)" direction="out"/>
+            <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="WlcomData::DBusEffectDataList"/>
+        </method>
+
+        <!-- Method: PrintEffectOptions -->
+        <method name="PrintEffectOptions">
+            <description summary="PrintEffectOptions">
+            打印指定效果的选项。
+            输入参数：
+                effectName (类型为 s)：效果名称。
+            输出参数:返回一个字符串(s)，通常是效果选项的描述或配置。
+            </description>
+            <arg name="effectName" type="s" direction="in"/>
+            <arg name="options" type="s" direction="out"/>
+        </method>
+
+        <!-- Method: SetEffectOption -->
+        <method name="SetEffectOption">
+            <description summary="SetEffectOption">
+            设置指定效果的某个选项的值。
+            输入参数：
+                effectName (类型为 s)：效果名称。
+                optionName (类型为 s)：选项名称。
+                value (类型为 v):变量类型,可以是任何有效的D-Bus基本类型或容器类型,表示选项的新值。
+            </description>
+            <arg name="effectName" type="s" direction="in"/>
+            <arg name="optionName" type="s" direction="in"/>
+            <arg name="value" type="v" direction="in"/>
+        </method>
+    </interface>
+</node>
diff --git a/tools/magnifier/dbus_interface_date.h b/tools/magnifier/dbus_interface_date.h
new file mode 100644
index 0000000..f86e0e0
--- /dev/null
+++ b/tools/magnifier/dbus_interface_date.h
@@ -0,0 +1,66 @@
+// SPDX-FileCopyrightText: 2025 KylinSoft Co., Ltd.
+//
+// SPDX-License-Identifier: GPL-1.0-or-later
+
+#ifndef DBUSINTERFACEDATE_H
+#define DBUSINTERFACEDATE_H
+
+#include <QtDBus>
+namespace WlcomData
+{
+
+struct DBusEffectData {
+    QString name;
+    uint priority;
+    bool enable;
+
+    DBusEffectData() : name(""), priority(0), enable(false) {}
+};
+
+typedef QList<DBusEffectData> DBusEffectDataList;
+} // namespace WlcomData
+
+Q_DECLARE_METATYPE(WlcomData::DBusEffectData)
+Q_DECLARE_METATYPE(WlcomData::DBusEffectDataList)
+
+inline QDBusArgument &operator<<(QDBusArgument &arg, const WlcomData::DBusEffectData &data)
+{
+    arg.beginStructure();
+    arg << data.name << data.priority << data.enable;
+    arg.endStructure();
+    return arg;
+}
+
+inline const QDBusArgument &operator>>(const QDBusArgument &arg, WlcomData::DBusEffectData &data)
+{
+    arg.beginStructure();
+    arg >> data.name >> data.priority >> data.enable;
+    arg.endStructure();
+    return arg;
+}
+
+inline QDBusArgument &operator<<(QDBusArgument &arg, const WlcomData::DBusEffectDataList &list)
+{
+    arg.beginArray(qMetaTypeId<WlcomData::DBusEffectData>());
+    for (const auto &item : list) {
+        arg << item;
+    }
+    arg.endArray();
+    return arg;
+}
+
+inline const QDBusArgument &operator>>(const QDBusArgument &arg,
+                                       WlcomData::DBusEffectDataList &list)
+{
+    arg.beginArray();
+    list.clear();
+    while (!arg.atEnd()) {
+        WlcomData::DBusEffectData item;
+        arg >> item;
+        list.append(item);
+    }
+    arg.endArray();
+    return arg;
+}
+
+#endif // DBUSINTERFACEDATE_H
