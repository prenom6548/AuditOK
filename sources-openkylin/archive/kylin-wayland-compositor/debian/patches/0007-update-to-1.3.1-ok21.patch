-static void preview_area_update(struct preview *preview)
-{
-    if (preview->view) {
-        return;
-    }
-
-    struct kywc_box *usable = &manager->output->usable_area;
-    enum kywc_tile tiled = preview->tiled;
-    int32_t half_width = usable->width / 2;
-    int32_t half_height = usable->height / 2;
-    int32_t back_w = usable->width / 2;
-    int32_t back_h =
-        tiled == KYWC_TILE_LEFT || tiled == KYWC_TILE_RIGHT ? usable->height : half_height;
-    struct view *top_left = manager->preview[0].view;
-    struct view *top_right = manager->preview[1].view;
-    struct view *bottom_left = manager->preview[2].view;
-    struct view *bottom_right = manager->preview[3].view;
-
-    bool w_aligned = false, h_aligned = false;
-    if (tiled == KYWC_TILE_LEFT || tiled == KYWC_TILE_RIGHT) {
-        int x = tiled == KYWC_TILE_LEFT ? GAP : half_width + GAP;
-        preview->box.width = half_width - GAP * 2;
-        preview->box.height = usable->height - GAP * 2;
-        preview->box.x = usable->x + x;
-        preview->box.y = usable->y + GAP;
-    } else if (tiled == KYWC_TILE_TOP_LEFT) {
-        w_aligned = !top_right && bottom_left;
-        h_aligned = top_right && !bottom_left;
-        preview->box.width = w_aligned ? half_width - GAP : half_width - GAP * 2;
-        preview->box.height = h_aligned ? half_height - GAP : half_height - GAP * 2;
-        preview->box.x = usable->x + GAP;
-        preview->box.y = usable->y + GAP;
-    } else if (tiled == KYWC_TILE_TOP_RIGHT) {
-        w_aligned = !top_left && !bottom_left && bottom_right;
-        h_aligned = !bottom_right && top_left;
-        preview->box.width = w_aligned ? half_width - GAP : half_width - GAP * 2;
-        preview->box.height = h_aligned ? half_height - GAP : half_height - 2 * GAP;
-        preview->box.x = w_aligned ? usable->x + half_width : usable->x + half_width + GAP;
-        preview->box.y = usable->y + GAP;
-    } else if (tiled == KYWC_TILE_BOTTOM_LEFT) {
-        w_aligned = !bottom_right && top_left;
-        h_aligned = !top_left && !top_right && bottom_right;
-        preview->box.width = w_aligned ? half_width - GAP : half_width - GAP * 2;
-        preview->box.height = h_aligned ? half_height - GAP : half_height - GAP * 2;
-        preview->box.x = usable->x + GAP;
-        preview->box.y = h_aligned ? usable->y + half_height : usable->y + half_height + GAP;
-    } else if (tiled == KYWC_TILE_BOTTOM_RIGHT) {
-        w_aligned = !bottom_left && !top_left && top_right;
-        h_aligned = !top_right && !top_left && bottom_left;
-        preview->box.width = w_aligned ? half_width - GAP : half_width - GAP * 2;
-        preview->box.height = h_aligned ? half_height - GAP : half_height - GAP * 2;
-        preview->box.x = w_aligned ? usable->x + half_width : usable->x + half_width + GAP;
-        preview->box.y = h_aligned ? usable->y + half_height : usable->y + half_height + GAP;
-    }
-
-    int x = 0, y = 0;
-    if (tiled == KYWC_TILE_LEFT || tiled == KYWC_TILE_RIGHT || tiled == KYWC_TILE_TOP_LEFT ||
-        tiled == KYWC_TILE_BOTTOM_LEFT) {
-        x = -GAP;
-    } else {
-        x = w_aligned ? 0 : -GAP;
-    }
-    if (tiled == KYWC_TILE_LEFT || tiled == KYWC_TILE_RIGHT || tiled == KYWC_TILE_TOP_LEFT ||
-        tiled == KYWC_TILE_TOP_RIGHT) {
-        y = -GAP;
-    } else {
-        y = h_aligned ? 0 : -GAP;
-    }
-
-    ky_scene_rect_set_size(preview->background, back_w, back_h);
-    ky_scene_rect_set_size(preview->preview_area, preview->box.width, preview->box.height);
-    ky_scene_node_set_position(&preview->tree->node, preview->box.x, preview->box.y);
-    ky_scene_node_set_position(&preview->background->node, x, y);
-
-    preview->row = preview->box.height / manager->fixed_height;
-    preview->col = preview->box.width / manager->fixed_width;
-    preview->total = preview->row * preview->col;
-}
