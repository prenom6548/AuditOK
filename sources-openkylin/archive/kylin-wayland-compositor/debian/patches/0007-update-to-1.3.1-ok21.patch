+static void ky_output_update_logical_size(struct ky_output *output)
+{
+    if (!output->base.enabled) {
+        output->base.width = 0;
+        output->base.height = 0;
+        return;
+    }
+
+    int width = output->base.mode->width;
+    int height = output->base.mode->height;
+    if (output->base.transform % 2 != 0) {
+        width = output->base.mode->height;
+        height = output->base.mode->width;
+    }
+    output->base.width = ceil(width / output->base.scale);
+    output->base.height = ceil(height / output->base.scale);
+}
