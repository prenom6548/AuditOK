+
+    if (zoom->enabled) {
+        return sd_bus_reply_method_return(m, "b", false);
+    }
+
+    if (!zoom->renderer_is_opengl && type == ZOOM_WINDOW) {
+        return sd_bus_reply_method_return(m, "b", false);
+    }
+
+    zoom->enabled = true;
+    zoom->type = type;
+    zoom->scale = scale;
+    zoom_init_state(zoom);
+    zoom_client_destory();
+    zoom->client = spawn_client(zoom->server->display, command);
+    ky_scene_damage_whole(zoom->scene);
