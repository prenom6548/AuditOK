+#include <assert.h>
+#include <drm_fourcc.h>
+#include <stdlib.h>
+#include <xf86drm.h>
+
+#include <wlr/render/pixman.h>
+#include <wlr/util/region.h>
+
+#include <kywc/log.h>
+
+#include "drm_p.h"
+#include "output.h"
