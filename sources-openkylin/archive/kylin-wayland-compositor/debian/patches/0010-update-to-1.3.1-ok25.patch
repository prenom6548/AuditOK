diff --git a/protocols/ukui-background-v1.xml b/protocols/ukui-background-v1.xml
new file mode 100644
index 0000000..6121f9f
--- /dev/null
+++ b/protocols/ukui-background-v1.xml
@@ -0,0 +1,92 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="ukui_background_v1">
+  <copyright><![CDATA[
+      SPDX-FileCopyrightText: 2026 KylinSoft Co., Ltd.
+      SPDX-License-Identifier: MulanPSL-2.0
+    ]]>
+  </copyright>
+
+  <interface name="ukui_background_manager_v1" version="1">
+    <description summary="interface to manage background buffers">
+      This interface allows clients to create background buffer.
+    </description>
+
+    <request name="destroy" type="destructor">
+      <description summary="destroy the ukui background manager object">
+        Destroy the manager object. The existing background objects will be
+        unaffected.
+      </description>
+    </request>
+
+    <enum name="error">
+      <entry name="background_exists" value="0"
+             summary="the output already has a background objects with the same type"/>
+    </enum>
+
+    <enum name="type">
+      <entry name="wallpaper" value="1">
+        <description summary="wallpaper background type">
+          The background type wallpaper describes the background object buffer is from
+          wallpaper picture.
+        </description>
+      </entry>
+      <entry name="screenlock" value="2">
+        <description summary="screenlock background type">
+          The background type screenlock describes the background object buffer is from
+          screenlock picture.
+        </description>
+      </entry>
+    </enum>
+
+    <request name="create_background">
+      <description summary="create a new background object">
+        Creates a new background object associated with the given output.
