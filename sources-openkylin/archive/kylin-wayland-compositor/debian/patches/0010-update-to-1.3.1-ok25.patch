+
+bool limit_set_cloexec(int fd, bool cloexec)
+{
+    int flags = fcntl(fd, F_GETFD);
+    if (flags == -1) {
+        kywc_log_errno(KYWC_ERROR, "fcntl failed");
+        return false;
+    }
+    if (cloexec) {
+        flags = flags | FD_CLOEXEC;
+    } else {
+        flags = flags & ~FD_CLOEXEC;
+    }
+    if (fcntl(fd, F_SETFD, flags) == -1) {
+        kywc_log_errno(KYWC_ERROR, "fcntl failed");
+        return false;
+    }
+    return true;
+}
