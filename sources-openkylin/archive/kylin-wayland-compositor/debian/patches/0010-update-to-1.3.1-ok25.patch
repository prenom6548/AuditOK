+static int get_click_method(sd_bus_message *m, void *userdata, sd_bus_error *ret_error)
+{
+    const char *input_name = NULL;
+    CK(sd_bus_message_read(m, "s", &input_name));
+
+    struct input *input = input_by_name(input_name);
+    if (!input) {
+        const sd_bus_error error =
+            SD_BUS_ERROR_MAKE_CONST(SD_BUS_ERROR_INVALID_ARGS, "Invalid input.");
+        return sd_bus_reply_method_error(m, &error);
+    }
+
+    return sd_bus_reply_method_return(m, "uu", input->state.click_method,
+                                      input->default_state.click_method);
+}
+
+static int set_click_method(sd_bus_message *m, void *userdata, sd_bus_error *ret_error)
+{
+    const char *input_name = NULL;
+    uint32_t click_method;
+    CK(sd_bus_message_read(m, "su", &input_name, &click_method));
+
+    struct input *input = input_by_name(input_name);
+    if (!input) {
+        const sd_bus_error error =
+            SD_BUS_ERROR_MAKE_CONST(SD_BUS_ERROR_INVALID_ARGS, "Invalid input.");
+        return sd_bus_reply_method_error(m, &error);
+    }
+
+    bool click_method_supported = false;
+    if (input->prop.click_methods) {
+        switch (click_method) {
+        case LIBINPUT_CONFIG_CLICK_METHOD_NONE:
+            click_method_supported = true;
+            break;
+        case LIBINPUT_CONFIG_CLICK_METHOD_BUTTON_AREAS:
+        case LIBINPUT_CONFIG_CLICK_METHOD_CLICKFINGER:
+            click_method_supported = input->prop.click_methods & click_method;
+            break;
+        default:
+            break;
+        }
+    }
+
+    if (!click_method_supported) {
+        const sd_bus_error error =
+            SD_BUS_ERROR_MAKE_CONST(SD_BUS_ERROR_INVALID_ARGS, "Unsupported click method.");
+        return sd_bus_reply_method_error(m, &error);
+    }
+
+    if (input->state.click_method != click_method) {
+        struct input_state state = input->state;
+        state.click_method = click_method;
+        return reply_input_set_state(m, input, &state);
+    }
+
+    return sd_bus_reply_method_return(m, NULL);
+}
