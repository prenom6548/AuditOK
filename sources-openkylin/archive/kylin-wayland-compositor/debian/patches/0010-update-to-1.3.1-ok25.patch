+static bool xwm_atoms_contains(struct xwm *xwm, xcb_atom_t *atoms, size_t num_atoms,
+                               enum atom_name needle)
+{
+    xcb_atom_t atom = xwm->atoms[needle].atom;
+
+    for (size_t i = 0; i < num_atoms; ++i) {
+        if (atom == atoms[i]) {
+            return true;
+        }
+    }
+
+    return false;
+}
