+    struct opengl_texture *blurred = NULL;
+    bool update = false;
+    struct wlr_buffer *background = output_get_background_buffer(output, blur_type, &update);
+    if (!background) {
+        return false;
+    }
+
+    struct opengl_texture **cached_texture = NULL;
+    if (blur_type == SCENE_BLUR_SCREENLOCK) {
+        cached_texture = &output_data->blurred_screenlock;
+    } else if (blur_type == SCENE_BLUR_WALLPAPER) {
+        cached_texture = &output_data->blurred_wallpaper;
+    }
+
+    if (!cached_texture) {
+        return false;
+    }
+
+    /* check if cached texture size matches output size, recreate if not */
+    if (*cached_texture && ((*cached_texture)->wlr_texture.width != (uint32_t)output->width ||
+                            (*cached_texture)->wlr_texture.height != (uint32_t)output->height)) {
+        opengl_texture_destroy(*cached_texture);
+        *cached_texture = NULL;
+    }
+
+    if (update || !*cached_texture) {
+        blurred = opengl_texture_create_with_fbo(blur_config.renderer, output->width,
+                                                 output->height, GL_BGRA_EXT, GL_LINEAR);
+        if (!blurred) {
+            return false;
+        }
+
+        *cached_texture = blurred;
+        blur_buffer(target, output_data->blur_task, background, options->blur->iterations,
+                    options->blur->offset, blurred);
+    } else {
+        blurred = *cached_texture;
+    }
+
+    if (!blurred) {
+        return false;
     }
+
