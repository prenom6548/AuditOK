+void xwayland_surface_activate(struct xwayland_surface *xsurface, bool activated)
+{
+    /* handle active NULL in xwm_handle_activate_view */
+    if (activated) {
+        xwm_surface_activate(xsurface->xwm, xsurface);
+    }
+}
