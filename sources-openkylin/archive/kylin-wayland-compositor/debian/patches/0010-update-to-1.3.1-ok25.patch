+            .dst_box = {
+                .x = options->dst_box->x,
+                .y = options->dst_box->y,
+                .height = options->dst_box->height,
+                .width = options->dst_box->width,
+            },
+            .clip = damaged_blur_region,
+            .alpha = &alpha,
+        },
