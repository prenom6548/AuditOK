+static void snapshot_get_full_box(const struct snapshot *snapshot,
+                                  const struct kywc_box *render_box, struct kywc_box *full_box)
+{
+    struct node_snapshot *node_snapshot = node_snapshot_try_from_snapshot(snapshot);
+    if (!node_snapshot) {
+        return;
+    }
+
+    *full_box = *render_box;
