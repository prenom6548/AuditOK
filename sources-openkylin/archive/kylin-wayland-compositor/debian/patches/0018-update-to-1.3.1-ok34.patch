+static void ukui_try_dbus_background(struct ukui_settings *settings)
+{
+    sd_bus *bus = dbus_context_get_bus(true);
+    if (!bus) {
+        return;
+    }
+
+    uint32_t uid = getuid();
+    sd_bus_message *reply = NULL;
+    int r = sd_bus_call_method(bus, "org.freedesktop.Accounts", "/org/freedesktop/Accounts",
+                               "org.freedesktop.Accounts", "FindUserById", NULL, &reply, "x", uid);
+    if (r < 0) {
+        return;
+    }
+
+    char *path = NULL;
+    r = sd_bus_message_read(reply, "o", &path);
+    if (r >= 0) {
+        char *background = NULL;
+        r = sd_bus_get_property_string(bus, "org.freedesktop.Accounts", path,
+                                       "org.freedesktop.Accounts.User", "BackgroundFile", NULL,
+                                       &background);
+        if (STRING_VALID(background)) {
+            settings->background.picture_file = strdup(background);
+            settings->background.use_dbus_background = true;
+        }
+    }
+    sd_bus_message_unref(reply);
+}
+
