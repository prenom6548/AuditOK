 wlcctrl [command] [options...]
 ```
 
+## 行为说明
+
+- 命令按命令行中出现的顺序依次执行，因此 `--sleep` 可以穿插在任意命令之间编排时序。
+- `-l/--list`、`--outputs`、`--workspace` 同样作为普通命令按顺序执行。
+- 任一命令执行失败时立即停止，并返回非 0 退出码；全部成功时返回 0。
+
 ## 选项
 
 ### 常用选项
@@ -117,6 +123,10 @@ wlcctrl [command] [options...]
 
 ## 窗口选项
 
+窗口类命令的参数既可以是窗口 UUID，也可以是名称片段：名称片段对窗口标题、应用
+ID 和图标做大小写不敏感的子串匹配。若片段匹配到多个窗口，命令执行失败并
+列出候选窗口的 UUID。
+
 - `-l, --list`
   - 列出所有窗口名称。
 
diff --git a/tools/wlcctrl/capture.c b/tools/wlcctrl/capture.c
new file mode 100644
index 0000000..483c554
--- /dev/null
+++ b/tools/wlcctrl/capture.c
@@ -0,0 +1,206 @@
+// SPDX-FileCopyrightText: 2026 KylinSoft Co., Ltd.
+//
+// SPDX-License-Identifier: GPL-1.0-or-later
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#include <kywc/boxes.h>
+#include <kywc/identifier.h>
+
+#include "buffer.h"
+#include "commands.h"
+
+struct capture_state {
+    const char *area;
+    const char *path;
+    bool getpixel;
+    bool done;
+    bool ok;
+};
+
+void capture_context_create(kywc_context *ctx)
+{
+    struct kywc_buffer_helper *helper = kywc_buffer_helper_create(ctx);
+    if (!helper) {
+        return;
+    }
+
+    kywc_context_set_user_data(ctx, helper);
+}
+
+void capture_context_destroy(kywc_context *ctx)
+{
+    struct kywc_buffer_helper *helper = kywc_context_get_user_data(ctx);
+    if (helper) {
+        kywc_buffer_helper_destroy(helper);
+    }
+}
+
+static bool capture_pixel(struct kywc_buffer *kywc_buffer, const char *area)
+{
+    long xy[2];
+    if (!parse_ints(area, xy, 2) || xy[0] < 0 || xy[1] < 0) {
+        fprintf(stderr, "The --getpixelcolor option expects two non-negative integers "
+                        "separated with a comma.\n");
+        return false;
+    }
+
+    uint32_t pixel = kywc_buffer_get_pixel(kywc_buffer, xy[0], xy[1]);
+    printf("pixel position %ld,%ld\tR:%d G:%d B:%d A:%0.1f\n", xy[0], xy[1], (pixel >> 16) & 0xff,
+           (pixel >> 8) & 0xff, pixel & 0xff, ((pixel >> 24) & 0xff) / 255.0);
+    return true;
+}
+
+static bool thumbnail_handle_buffer(kywc_thumbnail *thumbnail,
+                                    const struct kywc_thumbnail_buffer *buffer, void *data)
+{
+    struct capture_state *state = data;
+
+    state->done = true;
+
+    kywc_context *ctx = kywc_thumbnail_get_context(thumbnail);
+    struct kywc_buffer_helper *helper = kywc_context_get_user_data(ctx);
+    if (!helper) {
+        return false;
+    }
+
+    struct kywc_buffer *kywc_buffer =
+        kywc_buffer_helper_import_thumbnail(helper, thumbnail, buffer);
+    if (!kywc_buffer) {
+        return false;
+    }
+
+    if (state->getpixel) {
+        state->ok = capture_pixel(kywc_buffer, state->area);
+        return false;
+    }
+
+    struct kywc_box area = { 0, 0, (int)buffer->width, (int)buffer->height };
+    if (state->area) {
+        long vals[4];
+        if (!parse_ints(state->area, vals, 4) || vals[0] < 0 || vals[1] < 0 || vals[2] <= 0 ||
+            vals[3] <= 0) {
+            fprintf(stderr, "The --setarea option expects four integers separated with a comma: "
+                            "x,y,width,height.\n");
+            return false;
+        }
+        area.x = vals[0];
+        area.y = vals[1];
+        area.width = vals[2];
+        area.height = vals[3];
+    }
+
+    const char *filename = state->path;
+    char *generated = NULL;
+    if (!filename) {
+        generated = (char *)kywc_identifier_time_generate(NULL, ".png");
+        filename = generated;
+        if (!filename) {
+            fprintf(stderr, "Failed to generate the file name.\n");
+            return false;
+        }
+    }
+
+    if (kywc_buffer_write_to_file(kywc_buffer, area.x, area.y, area.width, area.height, filename)) {
+        printf("Create file %s success!\n", filename);
+        state->ok = true;
+    } else {
+        fprintf(stderr, "Create file %s failed!\n", filename);
+    }
+
+    free(generated);
+    return false;
+}
+
+static void thumbnail_handle_destroy(kywc_thumbnail *thumbnail, void *data)
+{
+    struct capture_state *state = data;
+
+    state->done = true;
+}
+
+static struct kywc_thumbnail_interface thumbnail_impl = {
+    .buffer = thumbnail_handle_buffer,
+    .destroy = thumbnail_handle_destroy,
+};
+
+static int capture_run(struct context *ctx, const char *source_uuid, const char *output_uuid,
+                       struct capture_state *state)
+{
+    kywc_thumbnail *thumbnail = NULL;
+    if (source_uuid && output_uuid) {
+        thumbnail = kywc_thumbnail_create_from_workspace(ctx->kywc, source_uuid, output_uuid,
+                                                         &thumbnail_impl, state);
+    } else if (source_uuid) {
+        thumbnail = kywc_thumbnail_create_from_toplevel(ctx->kywc, source_uuid, false,
+                                                        &thumbnail_impl, state);
+    } else if (output_uuid) {
+        thumbnail =
+            kywc_thumbnail_create_from_output(ctx->kywc, output_uuid, &thumbnail_impl, state);
+    }
+    if (!thumbnail) {
+        fprintf(stderr, "Failed to create the thumbnail for capture.\n");
+        return -1;
+    }
+
+    struct wl_display *wl_display = kywc_context_get_display(ctx->kywc);
+    int ret = 0;
+    while (!state->done && ret >= 0) {
+        ret = wl_display_dispatch(wl_display);
+    }
+    if (ret < 0) {
+        fprintf(stderr, "Failed to dispatch the wayland display.\n");
+        return -1;
+    }
+    return state->ok ? 0 : -1;
+}
+
+static const char *target_output(struct context *ctx)
+{
+    return ctx->output ? ctx->output : context_primary_output(ctx);
+}
+
+int cmd_windowcapture(struct context *ctx, const char *param)
+{
+    kywc_toplevel *toplevel = window_resolve(ctx, param);
+    if (!toplevel) {
+        return -1;
+    }
+
+    struct capture_state state = { .path = ctx->path };
+    return capture_run(ctx, toplevel->uuid, NULL, &state);
+}
+
+int cmd_workspacecapture(struct context *ctx, const char *param)
+{
+    char *w_uuid, *o_uuid;
+    if (!split_pair(param, &w_uuid, &o_uuid)) {
+        fprintf(stderr, "The --workspacecapture option expects w_uuid:o_uuid parameters.\n");
+        return -1;
+    }
+
+    struct capture_state state = { .path = ctx->path };
+    int ret = capture_run(ctx, w_uuid, o_uuid, &state);
+    free(w_uuid);
+    free(o_uuid);
+    return ret;
+}
+
+int cmd_fullscreencapture(struct context *ctx, const char *param)
+{
+    struct capture_state state = { .path = ctx->path };
+    return capture_run(ctx, NULL, target_output(ctx), &state);
+}
+
+int cmd_setarea(struct context *ctx, const char *param)
+{
+    struct capture_state state = { .area = param, .path = ctx->path };
+    return capture_run(ctx, NULL, target_output(ctx), &state);
+}
+
+int cmd_getpixelcolor(struct context *ctx, const char *param)
+{
+    struct capture_state state = { .area = param, .path = ctx->path, .getpixel = true };
+    return capture_run(ctx, NULL, target_output(ctx), &state);
+}
diff --git a/tools/wlcctrl/commands.c b/tools/wlcctrl/commands.c
new file mode 100644
index 0000000..b90b518
--- /dev/null
+++ b/tools/wlcctrl/commands.c
@@ -0,0 +1,285 @@
+// SPDX-FileCopyrightText: 2026 KylinSoft Co., Ltd.
+//
+// SPDX-License-Identifier: GPL-1.0-or-later
+
+#define _POSIX_C_SOURCE 200809L
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "util/macros.h"
+#include "util/spawn.h"
+
+#include "commands.h"
+
+#define CAP_OUTPUT KYWC_CONTEXT_CAPABILITY_OUTPUT
+#define CAP_TOPLEVEL KYWC_CONTEXT_CAPABILITY_TOPLEVEL
+#define CAP_WORKSPACE KYWC_CONTEXT_CAPABILITY_WORKSPACE
+#define CAP_THUMBNAIL KYWC_CONTEXT_CAPABILITY_THUMBNAIL
+#define CAP_CURSOR KYWC_CONTEXT_CAPABILITY_CURSOR
+
+const struct command commands[] = {
+    /* listing */
+    { "list", ARG_NONE, CAP_TOPLEVEL, 0, cmd_list_toplevels },
+    { "outputs", ARG_NONE, CAP_OUTPUT, 0, cmd_list_outputs },
+    { "workspace", ARG_NONE, CAP_WORKSPACE, 0, cmd_list_workspaces },
+
+    /* toplevel query */
+    { "getactivewindow", ARG_NONE, CAP_TOPLEVEL, 0, cmd_getactivewindow },
+    { "search", ARG_REQUIRED, CAP_TOPLEVEL, 0, cmd_search },
+    { "getwindowname", ARG_REQUIRED, CAP_TOPLEVEL, 0, cmd_getwindowname },
+    { "getwindowgeometry", ARG_REQUIRED, CAP_TOPLEVEL, 0, cmd_getwindowgeometry },
+    { "getwindowstatus", ARG_REQUIRED, CAP_TOPLEVEL, 0, cmd_getwindowstatus },
+
+    /* toplevel actions */
+    { "windowkill", ARG_REQUIRED, CAP_TOPLEVEL, 0, cmd_windowkill },
+    { "windowclose", ARG_REQUIRED, CAP_TOPLEVEL, 0, cmd_windowclose },
+    { "windowminimize", ARG_REQUIRED, CAP_TOPLEVEL, 0, cmd_windowminimize },
+    { "windowmaximize", ARG_REQUIRED, CAP_TOPLEVEL | CAP_OUTPUT, 0, cmd_windowmaximize },
+    { "windowfullscreen", ARG_REQUIRED, CAP_TOPLEVEL | CAP_OUTPUT, 0, cmd_windowfullscreen },
+    { "windowactivate", ARG_REQUIRED, CAP_TOPLEVEL, 0, cmd_windowactivate },
+    { "windowmap", ARG_REQUIRED, CAP_TOPLEVEL, 0, cmd_windowmap },
+    { "windowmove", ARG_REQUIRED, CAP_TOPLEVEL, 0, cmd_windowmove },
+    { "windowsize", ARG_REQUIRED, CAP_TOPLEVEL, 0, cmd_windowsize },
+    { "windowenter", ARG_REQUIRED, CAP_TOPLEVEL, 0, cmd_windowenter },
+    { "windowleave", ARG_REQUIRED, CAP_TOPLEVEL, 0, cmd_windowleave },
+    { "movewindowtoworkspace", ARG_REQUIRED, CAP_TOPLEVEL, 0, cmd_movewindowtoworkspace },
+    { "movewindowtooutput", ARG_REQUIRED, CAP_TOPLEVEL, 0, cmd_movewindowtooutput },
+    { "windowcapture", ARG_REQUIRED, CAP_TOPLEVEL | CAP_THUMBNAIL, 0, cmd_windowcapture },
+
+    /* workspace */
+    { "workspaceadd", ARG_OPTIONAL, CAP_WORKSPACE, 0, cmd_workspaceadd },
+    { "workspaceremove", ARG_REQUIRED, CAP_WORKSPACE, 0, cmd_workspaceremove },
+    { "workspaceactive", ARG_REQUIRED, CAP_WORKSPACE, 0, cmd_workspaceactive },
+    { "workspacecapture", ARG_REQUIRED, CAP_WORKSPACE | CAP_THUMBNAIL, 0, cmd_workspacecapture },
+
+    /* output */
+    { "getdisplaygeometry", ARG_REQUIRED, CAP_OUTPUT, 0, cmd_getdisplaygeometry },
+    { "fullscreencapture", ARG_NONE, CAP_OUTPUT | CAP_THUMBNAIL, 0, cmd_fullscreencapture },
+    { "setarea", ARG_REQUIRED, CAP_OUTPUT | CAP_THUMBNAIL, 0, cmd_setarea },
+    { "getpixelcolor", ARG_REQUIRED, CAP_OUTPUT | CAP_THUMBNAIL, 0, cmd_getpixelcolor },
+
+    /* pointer */
+    { "mousemove", ARG_REQUIRED, CAP_OUTPUT, NEED_SEAT | NEED_POINTER | NEED_OUTPUTS,
+      cmd_mousemove },
+    { "mousebutton", ARG_REQUIRED, CAP_OUTPUT, NEED_SEAT | NEED_POINTER | NEED_OUTPUTS,
+      cmd_mousebutton },
+    { "mousepress", ARG_REQUIRED, CAP_OUTPUT, NEED_SEAT | NEED_POINTER | NEED_OUTPUTS,
+      cmd_mousepress },
+    { "mouserelease", ARG_REQUIRED, CAP_OUTPUT, NEED_SEAT | NEED_POINTER | NEED_OUTPUTS,
+      cmd_mouserelease },
+    { "scroll", ARG_NONE, CAP_OUTPUT, NEED_SEAT | NEED_POINTER | NEED_OUTPUTS, cmd_scroll },
+    { "getmouselocation", ARG_NONE, CAP_CURSOR, NEED_SEAT, cmd_getmouselocation },
+
+    /* keyboard */
+    { "keystring", ARG_REQUIRED, 0, NEED_SEAT | NEED_KEYBOARD, cmd_keystring },
+    { "key", ARG_REQUIRED, 0, NEED_SEAT | NEED_KEYBOARD, cmd_key },
+    { "keydown", ARG_REQUIRED, 0, NEED_SEAT | NEED_KEYBOARD, cmd_keydown },
+    { "keyup", ARG_REQUIRED, 0, NEED_SEAT | NEED_KEYBOARD, cmd_keyup },
+
+    /* misc */
+    { "exec", ARG_REQUIRED, 0, 0, cmd_exec },
+    { "sleep", ARG_REQUIRED, 0, 0, cmd_sleep },
+};
+
+const size_t command_count = ARRAY_SIZE(commands);
+
+const struct command *command_find(const char *name)
+{
+    for (size_t i = 0; i < command_count; i++) {
+        if (strcmp(commands[i].name, name) == 0) {
+            return &commands[i];
+        }
+    }
+    return NULL;
+}
+
+static bool find_primary_output(kywc_output *output, void *data)
+{
+    struct context *ctx = data;
+
+    if (output->primary) {
+        ctx->primary_output = output->uuid;
+        return true;
+    }
+    return false;
+}
+
+const char *context_primary_output(struct context *ctx)
+{
+    if (!ctx->primary_output && ctx->kywc) {
+        kywc_context_for_each_output(ctx->kywc, find_primary_output, ctx);
+    }
+    return ctx->primary_output;
+}
+
+bool parse_u32(const char *s, uint32_t *out)
+{
+    if (*s == '-') {
+        return false;
+    }
+
+    char *end;
+    errno = 0;
+    unsigned long v = strtoul(s, &end, 10);
+    if (errno != 0 || end == s || *end != '\0' || v > UINT32_MAX) {
+        return false;
+    }
+    *out = (uint32_t)v;
+    return true;
+}
+
+bool parse_i32(const char *s, int32_t *out)
+{
+    char *end;
+    errno = 0;
+    long v = strtol(s, &end, 10);
+    if (errno != 0 || end == s || *end != '\0' || v < INT32_MIN || v > INT32_MAX) {
+        return false;
+    }
+    *out = (int32_t)v;
+    return true;
+}
+
+/* parse a comma-separated integer list like "10,40,500,100" */
+bool parse_ints(const char *s, long *vals, size_t count)
+{
+    for (size_t i = 0; i < count; i++) {
+        char *end;
+        errno = 0;
+        long v = strtol(s, &end, 10);
+        if (errno != 0 || end == s) {
+            return false;
+        }
+        vals[i] = v;
+
+        s = end;
+        if (i + 1 == count) {
+            return *s == '\0';
+        }
+        if (*s != ',') {
+            return false;
+        }
+        s++;
+    }
+    return true;
+}
+
+/* split "first:second" into two newly allocated strings */
+bool split_pair(const char *param, char **first, char **second)
+{
+    const char *sep = strchr(param, ':');
+    if (!sep || sep == param || sep[1] == '\0') {
+        return false;
+    }
+
+    *first = strndup(param, sep - param);
+    *second = strdup(sep + 1);
+    if (!*first || !*second) {
+        free(*first);
+        free(*second);
+        return false;
+    }
+    return true;
+}
+
+static bool print_toplevel(kywc_toplevel *toplevel, void *data)
+{
+    if (!toplevel) {
+        return false;
+    }
+
+    printf("toplevel \"%s\"\n", toplevel->uuid ? toplevel->uuid : "unknown");
+    printf("  title: %s\n", toplevel->title ? toplevel->title : "unknown");
+    printf("  icon: %s\n", toplevel->icon ? toplevel->icon : "unknown");
+    printf("  activated: %s\n", toplevel->activated ? "yes" : "no");
+    printf("  maximized: %s\n", toplevel->maximized ? "yes" : "no");
+    printf("  minimized: %s\n", toplevel->minimized ? "yes" : "no");
+    printf("  fullscreen: %s\n", toplevel->fullscreen ? "yes" : "no");
+    printf("\n");
+    return false;
+}
+
+static bool print_output(kywc_output *output, void *data)
+{
+    if (!output) {
+        return false;
+    }
+
+    printf("output \"%s\"\n", output->uuid ? output->uuid : "unknown");
+    printf("primary : %s\n", output->primary ? "yes" : "no");
+    printf("enabled: %s\n", output->enabled ? "true" : "false");
+    printf("  name: %s\n", output->name ? output->name : "unknown");
+    printf("\n");
+    return false;
+}
+
+int cmd_list_toplevels(struct context *ctx, const char *param)
+{
+    kywc_context_for_each_toplevel(ctx->kywc, print_toplevel, NULL);
+    return 0;
+}
+
+int cmd_list_outputs(struct context *ctx, const char *param)
+{
+    kywc_context_for_each_output(ctx->kywc, print_output, NULL);
+    return 0;
+}
+
+int cmd_getdisplaygeometry(struct context *ctx, const char *param)
+{
+    kywc_output *output = kywc_context_find_output(ctx->kywc, param);
+    if (!output) {
+        fprintf(stderr, "Please enter the correct uuid for the specified output.\n");
+        return -1;
+    }
+
+    printf("  physical size: %dx%d mm\n", output->physical_width, output->physical_height);
+    printf("  scale: %f\n", output->scale);
+    printf("  transform: %d\n", output->transform);
+    if (output->enabled) {
+        if (output->mode) {
+            printf("  mode: %d x %d @ %d\n", output->mode->width, output->mode->height,
+                   output->mode->refresh / 1000);
+        } else {
+            printf("  mode: unknown\n");
+        }
+        printf("  position: %d, %d\n", output->x, output->y);
+    }
+    return 0;
+}
+
+int cmd_exec(struct context *ctx, const char *param)
+{
+    char *command = strdup(param);
+    if (!command) {
+        perror("strdup");
+        return -1;
+    }
+
+    bool ok = spawn_shell(command);
+    free(command);
+    if (!ok) {
+        fprintf(stderr, "Failed to execute: %s\n", param);
+        return -1;
+    }
+    return 0;
+}
+
+int cmd_sleep(struct context *ctx, const char *param)
+{
+    uint32_t ms;
+    if (!parse_u32(param, &ms)) {
+        fprintf(stderr, "The --sleep option expects a non-negative integer.\n");
+        return -1;
+    }
+
+    struct timespec duration = {
+        .tv_sec = ms / 1000,
+        .tv_nsec = (long)(ms % 1000) * 1000000,
+    };
+    nanosleep(&duration, NULL);
+    return 0;
+}
diff --git a/tools/wlcctrl/commands.h b/tools/wlcctrl/commands.h
new file mode 100644
index 0000000..4f5ed0e
--- /dev/null
+++ b/tools/wlcctrl/commands.h
@@ -0,0 +1,150 @@
+// SPDX-FileCopyrightText: 2026 KylinSoft Co., Ltd.
+//
+// SPDX-License-Identifier: GPL-1.0-or-later
+
+#ifndef WLCCTRL_COMMANDS_H
+#define WLCCTRL_COMMANDS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "wlcctrl.h"
+
+/* runtime context passed to every command handler */
+struct context {
+    struct wlcom_ctrl_manager *manager; /* NULL without wayland requirements */
+    kywc_context *kywc;                 /* NULL without kywc capabilities */
+    const char *output;                 /* -o <o_uuid> */
+    const char *path;                   /* --path <file> */
+    const char *x, *y;                  /* -x/-y values */
+    const char *w, *h;                  /* -w/-h values */
+    const char *primary_output;         /* lazily resolved primary output uuid */
+};
+
+enum arg_type {
+    ARG_NONE,
+    ARG_REQUIRED,
+    ARG_OPTIONAL,
+};
+
+struct command {
+    const char *name;
+    enum arg_type arg;
+    uint32_t caps;  /* required KYWC_CONTEXT_CAPABILITY_* bits */
+    uint32_t needs; /* required NEED_* wayland resources */
+    int (*run)(struct context *ctx, const char *param);
+};
+
+extern const struct command commands[];
+extern const size_t command_count;
+
+const struct command *command_find(const char *name);
+
+/* lazily resolve the uuid of the primary output */
+const char *context_primary_output(struct context *ctx);
+
+/* strict numeric parsers shared by handlers */
+bool parse_u32(const char *s, uint32_t *out);
+
+bool parse_i32(const char *s, int32_t *out);
+
+bool parse_ints(const char *s, long *vals, size_t count);
+
+bool split_pair(const char *param, char **first, char **second);
+
+/* commands.c */
+int cmd_list_toplevels(struct context *ctx, const char *param);
+
+int cmd_list_outputs(struct context *ctx, const char *param);
+
+int cmd_getdisplaygeometry(struct context *ctx, const char *param);
+
+int cmd_exec(struct context *ctx, const char *param);
+
+int cmd_sleep(struct context *ctx, const char *param);
+
+/* window.c */
+kywc_toplevel *window_resolve(struct context *ctx, const char *query);
+
+int cmd_getactivewindow(struct context *ctx, const char *param);
+
+int cmd_search(struct context *ctx, const char *param);
+
+int cmd_getwindowname(struct context *ctx, const char *param);
+
+int cmd_getwindowgeometry(struct context *ctx, const char *param);
+
+int cmd_getwindowstatus(struct context *ctx, const char *param);
+
+int cmd_windowkill(struct context *ctx, const char *param);
+
+int cmd_windowclose(struct context *ctx, const char *param);
+
+int cmd_windowminimize(struct context *ctx, const char *param);
+
+int cmd_windowmaximize(struct context *ctx, const char *param);
+
+int cmd_windowfullscreen(struct context *ctx, const char *param);
+
+int cmd_windowactivate(struct context *ctx, const char *param);
+
+int cmd_windowmap(struct context *ctx, const char *param);
+
+int cmd_windowmove(struct context *ctx, const char *param);
+
+int cmd_windowsize(struct context *ctx, const char *param);
+
+int cmd_windowenter(struct context *ctx, const char *param);
+
+int cmd_windowleave(struct context *ctx, const char *param);
+
+int cmd_movewindowtoworkspace(struct context *ctx, const char *param);
+
+int cmd_movewindowtooutput(struct context *ctx, const char *param);
+
+/* workspace.c */
+int cmd_list_workspaces(struct context *ctx, const char *param);
+
+int cmd_workspaceadd(struct context *ctx, const char *param);
+
+int cmd_workspaceremove(struct context *ctx, const char *param);
+
+int cmd_workspaceactive(struct context *ctx, const char *param);
+
+/* capture.c */
+int cmd_windowcapture(struct context *ctx, const char *param);
+
+int cmd_workspacecapture(struct context *ctx, const char *param);
+
+int cmd_fullscreencapture(struct context *ctx, const char *param);
+
+int cmd_setarea(struct context *ctx, const char *param);
+
+int cmd_getpixelcolor(struct context *ctx, const char *param);
+
+void capture_context_create(kywc_context *ctx);
+
+void capture_context_destroy(kywc_context *ctx);
+
+/* input.c */
+int cmd_keystring(struct context *ctx, const char *param);
+
+int cmd_key(struct context *ctx, const char *param);
+
+int cmd_keydown(struct context *ctx, const char *param);
+
+int cmd_keyup(struct context *ctx, const char *param);
+
+int cmd_mousemove(struct context *ctx, const char *param);
+
+int cmd_mousebutton(struct context *ctx, const char *param);
+
+int cmd_mousepress(struct context *ctx, const char *param);
+
+int cmd_mouserelease(struct context *ctx, const char *param);
+
+int cmd_scroll(struct context *ctx, const char *param);
+
+int cmd_getmouselocation(struct context *ctx, const char *param);
+
+#endif
