-    bool find_id = false;
-    struct touch_finger *finger = NULL;
-    wl_list_for_each(finger, &effect->touch_fingers, link) {
-        if (finger->id == event->touch_id) {
-            find_id = true;
-            break;
-        }
-    }
-
-    if (find_id) {
-        struct touch_point *point = calloc(1, sizeof(struct touch_point));
-        point->point.x = lx;
-        point->point.y = ly;
