#!/usr/bin/make -f

%:
	dh $@

binary: checkkeyrings

regenerate-key-fragments:
	rm -f keyrings/*.gpg
	gpg --homedir .gnupg --import gpgkeys/*
	gpg --homedir .gnupg --export --output keyrings/openkylin-archive-anything-keyring.gpg

checkkeyrings:
	gpg --homedir .gnupg --list-keys

override_dh_installdeb:
	dh_installdeb
	# currently all keyring snippets are _not_ conffiles, keep it that way.
	cp debian/openkylin-archive-anything.conffiles debian/openkylin-archive-anything/DEBIAN/conffiles

override_dh_clean:
	rm -rf .gnupg verified current
	dh_clean
