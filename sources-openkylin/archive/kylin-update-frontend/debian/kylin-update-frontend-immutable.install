#!/usr/bin/dh-exec
#plugin
immutable/plugin/config_file/* /usr/share/ukui-control-center/upgrade/
immutable/plugin/translations/* /usr/share/upgrade/translations/
immutable/kylin-update-desktop-system.png /usr/share/upgrade/icon/
#plugin/libupgrade.so /usr/lib/upgrade/
immutable/plugin/libupgrade.so /usr/lib/upgrade2.0/
#notification
immutable/notification/kylin-updatefinish-notify1.desktop /etc/xdg/autostart
immutable/notification/kylin-updateresult-notify.desktop /etc/xdg/autostart
immutable/notification/kylin-updateresult-notify/translations/*.qm /usr/share/upgrade/translations
#immutable/kylin-updatefinish-notify-new /usr/bin
immutable/notification/kylin-updateresult-notify/kylin-updateresult-notify-new /usr/bin
#others
immutable/kylin_release_id_2209.py /usr/bin
#immutable/plugin_2107/* /tmp/plugin_2107/
#notifysend
immutable/NotifySend/Config/UpgradeRebootNotify /usr/bin
immutable/NotifySend/NotifySend /usr/bin
immutable/NotifySend/Config/NotifySendStart /usr/bin
immutable/NotifySend/Config/kylin-reboot-installnotify.desktop /etc/xdg/autostart
immutable/NotifySend/Config/kylin-stepinstall-notify.desktop /etc/xdg/autostart
immutable/NotifySend/Config/kylin-stepinstall-notify.service /usr/lib/systemd/user
immutable/NotifySend/translations/* /usr/share/upgradenotifysend/translations/
