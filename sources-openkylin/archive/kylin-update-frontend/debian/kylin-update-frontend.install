#!/usr/bin/dh-exec
#plugin
initial/plugin/config_file/* /usr/share/ukui-control-center/upgrade/
#plugin/translations/* /usr/share/Upgrade/translations/
initial/plugin/translations/* /usr/share/upgrade/translations/
#plugin/libupgrade.so /usr/lib/upgrade/
initial/plugin/libupgrade.so /usr/lib/upgrade/
#notification
initial/notification/kylin-updatefinish-notify1.desktop /etc/xdg/autostart
#notification/kylin-system-updater-notify-new.mo /usr/share/locale/zh_CN/LC_MESSAGES
#initial/notification/kylin-system-updater-notify-new.mo /tmp
initial/notification/mo/zh_CN/kylin-system-updater-notify-new.mo /usr/share/locale/zh_CN/LC_MESSAGES
initial/notification/mo/zh_HK/kylin-system-updater-notify-new.mo /usr/share/locale/zh_HK/LC_MESSAGES
initial/notification/mo/bo_CN/kylin-system-updater-notify-new.mo /usr/share/locale/bo_CN/LC_MESSAGES
initial/notification/mo/mn/kylin-system-updater-notify-new.mo /usr/share/locale/mn/LC_MESSAGES
initial/notification/mo/ug/kylin-system-updater-notify-new.mo /usr/share/locale/ug/LC_MESSAGES
initial/notification/mo/ky/kylin-system-updater-notify-new.mo /usr/share/locale/ky/LC_MESSAGES
initial/notification/mo/kk/kylin-system-updater-notify-new.mo /usr/share/locale/kk/LC_MESSAGES
initial/notification/mo/de/kylin-system-updater-notify-new.mo /usr/share/locale/de/LC_MESSAGES
initial/notification/mo/fr/kylin-system-updater-notify-new.mo /usr/share/locale/fr/LC_MESSAGES
initial/notification/mo/es/kylin-system-updater-notify-new.mo /usr/share/locale/es/LC_MESSAGES
