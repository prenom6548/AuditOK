#!/bin/bash
#set -e
#mkdir -p /usr/lib/`dpkg-architecture -qDEB_TARGET_MULTIARCH`/ukui-control-center/
rm -f /usr/lib/`dpkg-architecture -qDEB_TARGET_MULTIARCH`/ukui-control-center/libupgrade.so
ln -s /usr/lib/upgrade2.0/libupgrade.so /usr/lib/`dpkg-architecture -qDEB_TARGET_MULTIARCH`/ukui-control-center/
file_path="/usr/lib/`dpkg-architecture -qDEB_TARGET_MULTIARCH`/ukui-control-center/libupgrade.so"
if [ -f /usr/sbin/kysec_get ] && [ -f $file_path ];then
	kysec_set -n exectl -v verified $file_path
fi
