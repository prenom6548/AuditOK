#!/bin/sh
set -e

case "$1" in
    configure)
	if [ -e /boot/grub/grub.cfg ]; then
		# Will break Live CD generation, LP #1228462
		update-grub || true

	fi

	if which update-initramfs >/dev/null 2>&1
	then
	    update-initramfs -u
	fi
	;;

    abort-upgrade|abort-deconfigure|abort-remove)
	;;

    *)
	echo "$0 called with unknown argument \`$1'" 1>&2
	exit 1
	;;
esac

#DEBHELPER#
