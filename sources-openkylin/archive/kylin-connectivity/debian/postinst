#!/bin/bash

# Link to the binary
ln -sf '/opt/connectivity/tools/kylin-screencast.AppImage' '/usr/bin/kylin-screencast.AppImage' || true
ln -sf '/opt/connectivity/tools/anti-control-server' '/usr/bin/anti-control-server' || true
ln -sf '/opt/connectivity/tools/anti-control-client' '/usr/bin/anti-control-client' || true
ln -sf '/opt/connectivity/connectivity_softbus_server' '/usr/bin/connectivity_softbus_server' || true
ln -sf '/opt/connectivity/connectivity_softbus_client' '/usr/bin/connectivity_softbus_client' || true

get_arch=`uname -i`
if [ ! -L /lib/$get_arch-linux-gnu/libz.so ]
then
    ln -s /lib/$get_arch-linux-gnu/libz.so.1 /lib/$get_arch-linux-gnu/libz.so || true
fi