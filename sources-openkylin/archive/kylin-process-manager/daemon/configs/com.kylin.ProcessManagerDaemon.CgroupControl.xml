<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
         "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/kylin/ProcessManagerDaemon">
  <interface name="com.kylin.ProcessManagerDaemon.CgroupControl">
    <!-- 进程限制 -->
    <!-- 进程限制 ： cpu使用率 -->
    <method name="LimitProcessCPUPercent">
      <arg name="pid" type="i" direction="in"/>
      <arg name="cpuPercent" type="d" direction="in"/>
      <arg name="mode" type="s" direction="in"/>
      <arg type="i" direction="out"/>
    </method>
    <!-- 进程限制 ： cpu权重 -->
    <method name="LimitProcessCPUWeight">
      <arg name="pid" type="i" direction="in"/>
      <arg name="cpuWeight" type="i" direction="in"/>
      <arg name="mode" type="s" direction="in"/>
      <arg type="i" direction="out"/>
    </method>
    <!-- 进程限制 ： 内存限制 -->
    <method name="LimitProcessMemoryMax">
      <arg name="pid" type="i" direction="in"/>
      <arg name="memoryMax" type="t" direction="in"/>
      <arg name="mode" type="s" direction="in"/>
      <arg type="i" direction="out"/>
    </method>
    <!-- 进程限制 ： IO权重 -->
    <method name="LimitProcessIOWeight">
      <arg name="pid" type="i" direction="in"/>
      <arg name="ioWeight" type="i" direction="in"/>
      <arg name="mode" type="s" direction="in"/>
      <arg type="i" direction="out"/>
    </method>
    <!-- 进程冻结 -->
    <method name="FreezeProcess">
      <arg name="pid" type="i" direction="in"/>
      <arg name="mode" type="s" direction="in"/>
      <arg type="i" direction="out"/>
    </method>
    <!-- 线程限制 -->
    <!-- 线程限制 ： cpu使用率 -->
    <method name="LimitThreadCPUPercent">
      <arg name="pid" type="i" direction="in"/>
      <arg name="tid" type="i" direction="in"/>
      <arg name="cpuPercent" type="d" direction="in"/>
      <arg name="mode" type="s" direction="in"/>
      <arg type="i" direction="out"/>
    </method>
    <!-- 线程限制 ： cpu权重 -->
    <method name="LimitThreadCPUWeight">
      <arg name="pid" type="i" direction="in"/>
      <arg name="tid" type="i" direction="in"/>
      <arg name="cpuWeight" type="i" direction="in"/>
      <arg name="mode" type="s" direction="in"/>
      <arg type="i" direction="out"/>
    </method>
    <!-- 线程限制 ： 内存限制 -->
    <method name="LimitThreadMemoryMax">
      <arg name="pid" type="i" direction="in"/>
      <arg name="tid" type="i" direction="in"/>
      <arg name="memoryMax" type="i" direction="in"/>
      <arg name="mode" type="s" direction="in"/>
      <arg type="i" direction="out"/>
    </method>
    <!-- 线程限制 ： IO权重 -->
    <method name="LimitThreadIOWeight">
      <arg name="pid" type="i" direction="in"/>
      <arg name="tid" type="i" direction="in"/>
      <arg name="ioWeight" type="i" direction="in"/>
      <arg name="mode" type="s" direction="in"/>
      <arg type="i" direction="out"/>
    </method>
    <!-- 线程冻结 -->
    <method name="FreezeThread">
      <arg name="pid" type="i" direction="in"/>
      <arg name="tid" type="i" direction="in"/>
      <arg name="mode" type="s" direction="in"/>
      <arg type="i" direction="out"/>
    </method>
    <!-- 解除限制 -->
    <method name="ReleaseLimitByIndex">
      <arg name="index" type="i" direction="in"/>
      <arg type="b" direction="out"/>
    </method>
    <!-- 解除进程的所有限制 -->
    <method name="ReleaseProcessLimit">
      <arg name="pid" type="i" direction="in"/>
      <arg name="threadSync" type="b" direction="in"/>
      <arg type="b" direction="out"/>
    </method>
    <!-- 解除线程的所有限制 -->
    <method name="ReleaseThreadLimit">
      <arg name="pid" type="i" direction="in"/>
      <arg name="tid" type="i" direction="in"/>
      <arg type="b" direction="out"/>
    </method>
    <!-- 获取进程限制内容 -->
    <method name="GetProcessLimitInfo">
      <arg name="pid" type="i" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <!-- 获取线程限制内容 -->
    <method name="GetThreadLimitInfo">
      <arg name="pid" type="i" direction="in"/>
      <arg name="tid" type="i" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <!-- 根据索引获取限制内容 -->
    <method name="GetLimitInfoByIndex">
      <arg name="index" type="i" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <!-- 用户相关属性设置 -->
    <method name="SetCurrentUserProperty">
      <arg name="currentUserUID" type="s" direction="in"/>
      <arg name="currentUserSlice" type="s" direction="in"/>
      <arg name="currentUserService" type="s" direction="in"/>
      <arg name="currentUserSession" type="s" direction="in"/>
      <arg type="b" direction="out"/>
    </method>
    <!-- 设置分组相关设置 -->
    <!-- 设置分组路径 -->
    <method name="SetGroupPath">
      <arg name="currentUserUID" type="s" direction="in"/>
      <arg name="name" type="s" direction="in"/>
      <arg name="path" type="s" direction="in"/>
    </method>
    <!-- 设置分组属性 -->
    <method name="SetGroupProperty">
      <arg name="currentUserUID" type="s" direction="in"/>
      <arg name="name" type="s" direction="in"/>
      <arg name="node" type="s" direction="in"/>
      <arg name="value" type="s" direction="in"/>
    </method>
    <!-- 创建分组路径 -->
    <method name="CreateGroupPath">
      <arg name="currentUserUID" type="s" direction="in"/>
      <arg name="name" type="s" direction="in"/>
    </method>
    <!-- 删除分组路径 -->
    <method name="RemoveGroupPath">
      <arg name="currentUserUID" type="s" direction="in"/>
      <arg name="name" type="s" direction="in"/>
    </method>
    <!-- 根据分组限制进程 -->
    <method name="LimitProcessByGroup">
      <arg name="name" type="s" direction="in"/>
      <arg name="pid" type="i" direction="in"/>
    </method>
    <!-- 根据路径删除cgroup路径 -->
    <method name="RemoveCGroupPath">
      <arg name="path" type="s" direction="in"/>
    </method>
    <!-- 设置分组使能 -->
    <method name="SetGroupEnable">
      <arg name="enable" type="b" direction="in"/>
    </method>
    <!-- 设置冻结使能 -->
    <method name="SetFreezeEnable">
      <arg name="enable" type="b" direction="in"/>
    </method>
    <!-- 进程解冻 -->
    <method name="ThawedProcess">
      <arg name="pid" type="i" direction="in"/>
    </method>
    <!-- 进程限制变化-->
    <signal name="LimitChanged">
      <arg name="pid" type="i" direction="out"/>
      <arg name="tid" type="i" direction="out"/>
      <arg name="limitType" type="s" direction="out"/>
      <arg name="enable" type="b" direction="out"/>
    </signal>
  </interface> 
</node> 