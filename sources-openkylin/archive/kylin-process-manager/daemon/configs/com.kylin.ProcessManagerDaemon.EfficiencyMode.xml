<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
         "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/kylin/ProcessManagerDaemon">
  <interface name="com.kylin.ProcessManagerDaemon.EfficiencyMode">
    <!-- 效率模式 -->
    <method name="SetProcessMode">
      <arg name="pid" type="i" direction="in"/>
      <arg name="enable" type="b" direction="in"/>
    </method>
    <method name="ProcessHasFeature">
      <arg name="pid" type="i" direction="in"/>
      <arg type="b" direction="out"/>
    </method>
    <!-- 冻结状态 -->
    <method name="SetProcessFreeze">
      <arg name="pid" type="i" direction="in"/>
      <arg name="enable" type="b" direction="in"/>
    </method>
    <method name="ProcessHasFreezeFeature">
      <arg name="pid" type="i" direction="in"/>
      <arg type="b" direction="out"/>
    </method>
    <!-- 获取进程状态 -->
    <method name="GetProcessMode">
      <arg name="pid" type="i" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <method name="ListProcessModes">
      <arg type="a{is}" direction="out"/>
        <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QMap&lt;int,QString&gt;"/>
    </method>
    <method name="SetPidFilter">
      <arg name="pid" type="i" direction="in"/>
      <arg name="enable" type="b" direction="in"/>
    </method>
    <signal name="ProcessModeChanged">
      <arg name="pid" type="i" direction="out"/>
      <arg name="mode" type="s" direction="out"/>
    </signal>
  </interface> 
</node> 