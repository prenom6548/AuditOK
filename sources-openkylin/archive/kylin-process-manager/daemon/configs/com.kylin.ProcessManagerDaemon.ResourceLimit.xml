<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
         "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/kylin/ProcessManagerDaemon">
  <interface name="com.kylin.ProcessManagerDaemon.ResourceLimit">
    <!-- 进程(线程)限制 -->
    <method name="LimitResource">
      <arg name="pid" type="i" direction="in"/>
      <arg name="tid" type="i" direction="in"/>
      <arg name="resType" type="s" direction="in"/>
      <arg name="level" type="s" direction="in"/>
      <arg type="i" direction="out"/>
    </method>

    <!-- 进程（线程）冻结/解冻 -->
    <method name="FreezeProcess">
      <arg name="pid" type="i" direction="in"/>
      <arg name="tid" type="i" direction="in"/>
      <arg name="freeze" type="b" direction="in"/>
      <arg type="b" direction="out"/>
    </method>

    <!-- 解除限制 -->
    <method name="ReleaseLimit">
      <arg name="index" type="i" direction="in"/>
      <arg type="b" direction="out"/>
    </method>

    <!-- 获取进程限制内容 -->
    <method name="GetLimitInfo">
      <arg name="pid" type="i" direction="in"/>
      <arg name="tid" type="i" direction="in"/>
      <arg type="s" direction="out"/>
    </method>

    <!-- 获取进程是否被限制 -->
    <method name="IsLimited">
      <arg name="pid" type="i" direction="in"/>
      <arg name="tid" type="i" direction="in"/>
      <arg name="resType" type="s" direction="in"/>
      <arg type="b" direction="out"/>
    </method>
  </interface> 
</node> 