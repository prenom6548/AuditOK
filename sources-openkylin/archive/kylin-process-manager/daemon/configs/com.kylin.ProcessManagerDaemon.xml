<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
         "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
        <node name="/com/kylin/ProcessManagerDaemon">
          <interface name="com.kylin.ProcessManagerDaemon">
            <method name="SetSystemdUnitRun">
                <arg name="unitName" type="s" direction="in"/>
                <arg name="start" type="b" direction="in"/>
            </method>
            <signal name="ResourceThresholdWarning">
                <arg name="resource" type="s"/>
		<arg name="level" type="i"/>
            </signal>
            <method name="ReclaimProcesses">
                <arg name="pids" type="ai" direction="in"/>
                    <annotation name="org.qtproject.QtDBus.QtTypeName.In0" value="QList&lt;int>"/>
            </method>
            <method name="ReclaimProcessGroups">
                <arg name="groupNames" type="as" direction="in"/>
            </method>
            <method name="GetCpuEnergyConsumption">
                <arg name="energyConsumption" type="d" direction="out"/>
            </method>
            <method name="OpenPSR">
            </method>
            <method name="ClosePSR">
            </method>
            <method name="SetSystemCpuFreq">
                <arg name="cpufreq" type="b" direction="in"/>
            </method>
            <method name="SetSamplingRate">
                <arg name="samplingrate" type="b" direction="in"/>
            </method>
            <method name="SetKernelSched">
                <arg name="kernelsched" type="b" direction="in"/>
            </method>
            <method name="SetDirty">
                <arg name="dirty" type="b" direction="in"/>
            </method>
            <method name="SetNetParams">
                <arg name="netparams" type="b" direction="in"/>
            </method>
            <method name="SetCpuLimit">
                <arg name="cpulimit" type="b" direction="in"/>
            </method>
            <method name="SetVRRRefreshRate">
                <arg name="propertyName" type="s" direction="in"/>
            </method>
            <method name="ReverseVRRRefreshRate">
            </method>
            <method name="SetCurrentScene">
                <arg name="sceneids" type="as" direction="in"/>
            </method>
            <method name="GetCurrentScene">
                <arg type="as" direction="out"/>
            </method>
            <method name="LockGSettingsKey">
                <arg name="key" type="s" direction="in"/>
                <arg name="lock" type="b" direction="in"/>
            </method>
            <signal name="IdleStatus">
                <arg name="StatusChange" type="b" direction="out"/>
            </signal>
            <signal name="SceneChanged">
                <arg name="sceneids" type="as" direction="out"/>
            </signal>
          </interface>
          <node name="process manager daemon"/>
       </node>
