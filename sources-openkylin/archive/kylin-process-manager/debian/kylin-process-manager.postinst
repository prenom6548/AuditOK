#!/bin/sh

set -e

mkdir -p /etc/kylin-process-manager/
mkdir -p /etc/kylin-process-manager/policy_rules.d/

cp /usr/share/kylin-process-manager/kylin-process-manager.json /etc/kylin-process-manager/ || true
cp /usr/share/kylin-process-manager/task-profiles-v1.json /etc/kylin-process-manager/ || true
cp /usr/share/kylin-process-manager/task-profiles-v2.json /etc/kylin-process-manager/ || true
cp /usr/share/kylin-process-manager/scene-rules.json /etc/kylin-process-manager/ || true
cp /usr/share/kylin-process-manager/policy-rules.json /etc/kylin-process-manager/ || true
cp /usr/share/kylin-process-manager/resource-sched-configs.json /etc/kylin-process-manager/ || true
cp /usr/share/kylin-process-manager/efficiency-mode-configs.json /etc/kylin-process-manager/ || true
cp -r /usr/share/kylin-process-manager/policy_rules.d/*.json /etc/kylin-process-manager/policy_rules.d/ || true