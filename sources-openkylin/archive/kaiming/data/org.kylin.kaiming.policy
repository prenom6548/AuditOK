<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>

  <vendor>KYLINOS</vendor>
  <vendor_url>http://www.kylinos.cn</vendor_url>
  <icon_name>ues</icon_name>

  <action id="org.kylin.kaiming.install">
    <description>kaiming install</description>
    <description xml:lang="zh">开明包安装</description>
    <message>kaiming installation of software requires certification</message>
    <message xml:lang="zh">安装开明包需要认证</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/kaiming-tools/bin/kaiming</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.kylin.kaiming.unsetkysec">
    <description>setfattr -x attr</description>
    <description xml:lang="zh">剔除安全属性</description>
    <message>setfattr requires certification</message>
    <message xml:lang="zh">剔除安全属性需要认证</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/setfattr</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.kylin.kaiming.mount">
    <description>mount -o loop,offset=xxx -f squashfs src.ok dest</description>
    <description xml:lang="zh">挂载开明包</description>
    <message>mount -o loop,offset=xxx -f squashfs src.ok dest</message>
    <message xml:lang="zh">挂载开明包需要认证</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/mount</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.kylin.kaiming.umount">
    <description>umount mountpoint</description>
    <description xml:lang="zh">卸载开明包</description>
    <message>umount mountpoint</message>
    <message xml:lang="zh">卸载开明包需要认证</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/umount</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
