[Unit]
Description=session level dbus proxy
StartLimitInterval=0
ConditionUser=!lightdm
ConditionUser=!root
ConditionPathExists=/run/user/%U

[Service]
Type=simple
Restart=on-failure
ExecStart=/opt/kaiming-tools/bin/km-ses-dbusproxy
ExecCondition=/bin/sh -c '[ "$(id -u)" -ge 1000 ]'

[Install]
WantedBy=default.target
