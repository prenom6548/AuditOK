  <!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
 <node>
  <interface name="org.kaiming.proxy.system">
    <method name="startBinaryAsUser">
      <arg type="i" name="pid" direction="in"/>
      <arg type="s" name="binary" direction="in"/>
      <arg type="s" name="pwd" direction="in"/>
    </method>
    <signal name="binaryReply">
      <arg type="i" name="pid" direction="out"/>
      <arg type="s" name="out" direction="out"/>
    </signal>
    <method name="run">
      <arg type="as" name="options" direction="in"/>
      <arg type="as" name="suboptions" direction="in"/>
      <arg type="s" name="cid" direction="in"/>
      <arg type="i" name="ret" direction="out"/>
      <arg type="s" name="msg" direction="out"/>
    </method>
    <method name="enter">
      <arg type="as" name="options" direction="in"/>
      <arg type="as" name="suboptions" direction="in"/>
      <arg type="s" name="cid" direction="in"/>
      <arg type="s" name="command" direction="in"/>
      <arg type="i" name="ret" direction="out"/>
      <arg type="s" name="msg" direction="out"/>
    </method>
    <method name="ps">
      <arg type="i" name="ret" direction="out"/>
      <arg type="s" name="msg" direction="out"/>
    </method>
    <method name="kill">
      <arg type="s" name="id" direction="in"/>
      <arg type="i" name="ret" direction="out"/>
      <arg type="s" name="msg" direction="out"/>
    </method>
    <method name="getRunStatus">
      <arg type="s" name="appId" direction="in"/>
      <arg type="s" name="uid" direction="in"/>
      <arg type="b" name="ret" direction="out"/>
      <arg type="s" name="cid" direction="out"/>
    </method>    
  </interface>
</node>