<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.kylin.kaiming.interface">
    <method name="install">
      <arg direction="in" type="s" name="name" />
      <arg direction="in" type="s" name="branch" />
      <arg direction="out" type="b" />
    </method>
    <method name="installWithSpeedLimit">
      <arg direction="in" type="s" name="name" />
      <arg direction="in" type="s" name="branch" />
      <arg direction="in" type="u" name="maxSpeedLimitKilobytes" />
      <arg direction="out" type="b" />
    </method>
    <method name="installOfflinePackage">
      <arg direction="in" type="s" name="name" />
      <arg direction="in" type="s" name="branch" />
      <arg direction="out" type="b" />
    </method>
    <method name="update">
      <arg direction="in" type="s" name="name" />
      <arg direction="in" type="s" name="branch" />
      <arg direction="out" type="b" />
    </method>
    <method name="uninstall">
      <arg direction="in" type="s" name="name" />
      <arg direction="in" type="s" name="branch" />
      <arg direction="out" type="b" />
    </method>
     <method name="getLocalInfo">
      <arg direction="in" type="s" name="name" />
      <arg direction="out" type="s" />
    </method>
    <method name="getLocalDebInfo">
      <arg direction="in" type="s" name="name" />
      <arg direction="out" type="s" />
    </method>
    <method name="getDebInfoFromOK">
      <arg direction="in" type="s" name="name" />
      <arg direction="out" type="s" />
    </method>
    <method name="getAllLocalInfo">
      <arg direction="out" type="as" />
    </method>
     <method name="getRemoteInfo">
      <arg direction="in" type="s" name="name" />
      <arg direction="out" type="s" />
    </method>
    <method name="getRemotePackageStatus">
      <arg direction="in" type="s" name="name" />
      <arg direction="in" type="s" name="version" />
      <arg direction="in" type="s" name="branch" />
      <arg direction="out" type="s" />
    </method>
    <method name="getAllRemoteInfo">
      <arg direction="out" type="as" />
    </method>
    <method name="getAPPsRemoteInfo">
      <arg direction="out" type="as" />
    </method>
     <method name="isInstalled">
      <arg direction="in" type="s" name="name" />
      <arg direction="out" type="b" />
    </method>
    <method name="getAllIsInstalled">
      <arg direction="in" type="as" name="names" />
      <arg direction="out" type="a(sb)" />
    </method>
     <method name="isUpgradable">
      <arg direction="in" type="s" name="name" />
      <arg direction="out" type="b" />
    </method>
    <method name="getAllUpgradable">
      <arg direction="in" type="as" name="names" />
      <arg direction="out" type="a(sb)" />
    </method>
    <method name="getRemoteSummary">
      <arg direction="out" type="b" />
    </method>
    <!-- New privileged method: cleanup hostapp drivers; returns cleaned count -->
    <method name="checkAndCleanupUninstalledDrivers">
      <arg direction="out" type="i" name="cleanedCount" />
    </method>
    <method name="cancelInstall">
      <arg direction="in" type="s" name="taskId" />
      <arg direction="out" type="b" />
    </method>
    <method name="pauseInstall">
      <arg direction="in" type="s" name="taskIdOrName" />
      <arg direction="out" type="b" />
    </method>
    <method name="resumeInstall">
      <arg direction="in" type="s" name="taskIdOrName" />
      <arg direction="out" type="b" />
    </method>
    <method name="downloadBatch">
      <arg direction="in" type="as" name="names" />
      <arg direction="in" type="s" name="branch" />
      <arg direction="in" type="u" name="maxSpeedLimitKilobytes" />
      <arg direction="out" type="b" />
    </method>
    <method name="deployBatch">
      <arg direction="in" type="as" name="names" />
      <arg direction="in" type="s" name="branch" />
      <arg direction="out" type="b" />
    </method>
    <signal name="taskstartedsignal">
      <arg type="s" name="taskId" />
      <arg type="s" name="name" />
    </signal>
    <signal name="progresschangesignal">
      <arg type="s" name="progressInfo" />
    </signal>
    <signal name="deployprogresssignal">
      <arg type="s" name="deployprogressInfo" />
    </signal>
    <signal name="finishsignal">
      <arg type="s" name="refId"/>
      <arg type="i" name="operateType"/>
      <arg type="i" name="errorCode"/>
      <arg type="s" name="errorMessage"/>
    </signal>
    <signal name="getlocalinfosignal">
      <arg type="s" name="name"/>
      <arg type="s" name="localinfo"/>
      <arg type="i" name="errorCode"/>
      <arg type="s" name="errorMessage"/>
    </signal>
    <signal name="getlocaldebinfosignal">
      <arg type="s" name="name"/>
      <arg type="s" name="localinfo"/>
      <arg type="i" name="errorCode"/>
      <arg type="s" name="errorMessage"/>
    </signal>
    <signal name="getdebinfofromoksignal">
      <arg type="s" name="name"/>
      <arg type="s" name="okdebinfo"/>
      <arg type="i" name="errorCode"/>
      <arg type="s" name="errorMessage"/>
    </signal>
    <signal name="getalllocalinfosignal">
      <arg type="s" name="name"/>
      <arg type="as" name="localinfo"/>
      <arg type="i" name="errorCode"/>
      <arg type="s" name="errorMessage"/>
    </signal>
    <signal name="getallremoteinfosignal">
      <arg type="s" name="name"/>
      <arg type="as" name="remoteinfo"/>
      <arg type="i" name="errorCode"/>
      <arg type="s" name="errorMessage"/>
    </signal>
    <signal name="getappsremoteinfosignal">
      <arg type="s" name="name"/>
      <arg type="as" name="remoteinfo"/>
      <arg type="i" name="errorCode"/>
      <arg type="s" name="errorMessage"/>
    </signal>
    <signal name="getremoteinfosignal">
      <arg type="s" name="name"/>
      <arg type="s" name="remoteinfo"/>
      <arg type="i" name="errorCode"/>
      <arg type="s" name="errorMessage"/>
    </signal>
    <signal name="getremotepackagestatussignal">
      <arg type="s" name="name"/>
      <arg type="s" name="remoteinfo"/>
      <arg type="i" name="errorCode"/>
      <arg type="s" name="errorMessage"/>
    </signal>
    <signal name="getremotesummarysignal">
      <arg type="s" name="summaryUrl"/>
      <arg type="i" name="errorCode"/>
      <arg type="s" name="errorMessage"/>
    </signal>
    <signal name="isinstalledsignal">
      <arg type="s" name="name"/>
      <arg type="b" name="isinstalled"/>
      <arg type="i" name="errorCode"/>
      <arg type="s" name="errorMessage"/>
    </signal>
    <signal name="getallisinstalledsignal">
      <arg type="s" name="name"/>
      <arg type="a(sb)" name="allisinstallinfo"/>
      <arg type="i" name="errorCode"/>
      <arg type="s" name="errorMessage"/>
    </signal>
    <signal name="isupgradablesignal">
      <arg type="s" name="name"/>
      <arg type="b" name="isupgradable"/>
      <arg type="i" name="errorCode"/>
      <arg type="s" name="errorMessage"/>
    </signal>
    <signal name="getallupgradablesignal">
      <arg type="s" name="name"/>
      <arg type="a(sb)" name="upgradableinfo"/>
      <arg type="i" name="errorCode"/>
      <arg type="s" name="errorMessage"/>
    </signal>
   </interface>
</node>