<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.kaiming.proxy.session">
    <method name="xdgOpen">
      <arg type="s" name="path" direction="in"/>
      <arg type="s" name="pwd" direction="in"/>
      <arg type="s" name="appId" direction="in"/>
      <arg type="s" name="appVersion" direction="in"/>
    </method>
    <method name="startBinaryAsUser">
      <arg type="i" name="pid" direction="in"/>
      <arg type="s" name="binary" direction="in"/>
      <arg type="s" name="pwd" direction="in"/>
    </method>
    <signal name="binaryReply">
    <arg type="i" name="pid" direction="out"/>
    <arg type="s" name="out" direction="out"/>
    </signal>
  </interface>
</node>
