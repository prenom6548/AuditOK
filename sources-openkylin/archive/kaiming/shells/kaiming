#!/bin/bash
export LC_TIME=C
KAIMING_DIR=/opt/kaiming-tools/bin
KAIMING_CLI=km-cli
KAIMING_RUN=km-run

# $0 是脚本或命令本身的路径
CMD_FILE=$(basename "$0")

if [ "${CMD_FILE}" = "kaiming" ]; then

    if [ "$1" = "run" ]; then
        exec ${KAIMING_DIR}/${KAIMING_RUN} "$@"
    else
        exec ${KAIMING_DIR}/${KAIMING_CLI} "$@"
    fi

else

    export KAIMING_BINARY="$0"
    exec ${KAIMING_DIR}/${KAIMING_RUN} "$@"

fi


    
