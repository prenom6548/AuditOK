input_file="/etc/ostree-release"

etc_path_ln="/etc"
lib_path_ln="/lib"
usr_share_ln="/usr/share"
bin_ln_V11="/opt/system/bin"
bin_ln_not_V11="/usr/bin"

# etc_path="/opt/system/conf"
etc_path="/etc"
lib_path="/opt/system/lib"
usr_share="/opt/system/resource"
bin_path="/opt/kaiming-tools/bin"

if systemctl is-active org.kylin.kaiming.service >/dev/null 2>&1; then
    systemctl stop org.kylin.kaiming.service
fi

if systemctl is-enabled org.kylin.kaiming.service >/dev/null 2>&1; then
    systemctl disable org.kylin.kaiming.service
fi

if [ -L "/etc/systemd/user/default.target.wants/km-ses-dbusproxy.service" ]; then
    rm "/etc/systemd/user/default.target.wants/km-ses-dbusproxy.service"
fi

is_V11=0

#if [ -e "$input_file" ]; then
#    is_V11=1
#fi

if [ $is_V11 -eq 0 ]; then

    # 安装 system dbus 运行所需文件，没有则会开启 dbus 失败
    if [ -L "$lib_path_ln/systemd/system/org.kylin.kaiming.service" ]; then
        rm "$lib_path_ln/systemd/system/org.kylin.kaiming.service"
    fi

    if [ -L "$lib_path_ln/systemd/user/km-ses-dbusproxy.service" ]; then
        rm "$lib_path_ln/systemd/user/km-ses-dbusproxy.service"
    fi

    # 移除 system dbus 运行所需文件
    if [ -L "$usr_share_ln/dbus-1/system-services/org.kaiming.proxy.service" ]; then
        rm "$usr_share_ln/dbus-1/system-services/org.kaiming.proxy.service"
    fi

    # 移除 session dbus 运行所需文件
    if [ -L "$usr_share_ln/dbus-1/services/org.kaiming.proxy.service" ]; then
        rm "$usr_share_ln/dbus-1/services/org.kaiming.proxy.service"
    fi

    # 安装 kaiming-custom.xml
    if [ -L "$usr_share_ln/mime/packages/kaiming-custom.xml" ]; then
        rm "$usr_share_ln/mime/packages/kaiming-custom.xml"
    fi

    if [ -L "$usr_share_ln/icons/hicolor/scalable/mimetypes/application-x-kaiming.svg" ]; then
        rm "$usr_share_ln/icons/hicolor/scalable/mimetypes/application-x-kaiming.svg"  > /dev/null 2>&1
    fi

    # 安装 .mo 文件到指定的系统目录
    if [ -L "$usr_share_ln/locale/zh_CN/LC_MESSAGES/kaiming.mo" ]; then
        rm "$usr_share_ln/locale/zh_CN/LC_MESSAGES/kaiming.mo" 
    fi

    if [ -L "${bin_ln_not_V11}/kaiming" ]; then
        rm "${bin_ln_not_V11}/kaiming"
    fi

    if [ -L "${bin_ln_not_V11}/km-cli" ]; then
        rm "${bin_ln_not_V11}/km-cli"
    fi

    if [ -L "${bin_ln_not_V11}/km-run" ]; then
        rm "${bin_ln_not_V11}/km-run"
    fi
    
    if [ -L "${bin_ln_not_V11}/kaiming-system-dbus" ]; then
	    rm "${bin_ln_not_V11}/kaiming-system-dbus"
    fi

    if [ -L "${bin_ln_not_V11}/kaiming-sessionproxy-dbus" ]; then
        rm "${bin_ln_not_V11}/kaiming-sessionproxy-dbus"
    fi

    if [ -L "${bin_ln_not_V11}/kaiming-systemproxy-dbus" ]; then
        rm "${bin_ln_not_V11}/kaiming-systemproxy-dbus"
    fi
    
    if [ -L "$usr_share_ln/polkit-1/actions/org.kylin.kaiming.policy" ]; then
        rm "$usr_share_ln/polkit-1/actions/org.kylin.kaiming.policy"
    fi

else

    if [ -L "${bin_ln_V11}/kaiming" ]; then
        rm "${bin_ln_V11}/kaiming"
    fi

    if [ -L "${bin_ln_V11}/km-cli" ]; then
        rm "${bin_ln_V11}/km-cli"
    fi

    if [ -L "${bin_ln_V11}/km-run" ]; then
        rm "${bin_ln_V11}/km-run"
    fi

    if [ -L "${bin_ln_V11}/kaiming-system-dbus" ]; then
	    rm "${bin_ln_V11}/kaiming-system-dbus"
    fi

    if [ -L "${bin_ln_V11}/kaiming-sessionproxy-dbus" ]; then
        rm "${bin_ln_V11}/kaiming-sessionproxy-dbus"
    fi

    if [ -L "${bin_ln_V11}/kaiming-systemproxy-dbus" ]; then
        rm "${bin_ln_V11}/kaiming-systemproxy-dbus"
    fi
fi

exit 0
