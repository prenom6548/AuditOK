From: Jie Liu <liujie01@kylinos.cn>
Date: Fri, 30 Aug 2024 14:32:47 +0800
Subject: add some useful property

---
 src/ukuishellintegration.cpp | 15 ++++++++++++++-
 src/ukuishellintegration.h   |  3 +++
 src/ukuishellsurface.cpp     | 16 ++++++++++++++++
 3 files changed, 33 insertions(+), 1 deletion(-)

diff --git a/src/ukuishellintegration.cpp b/src/ukuishellintegration.cpp
index 84ebf01..c4c1bac 100644
--- a/src/ukuishellintegration.cpp
+++ b/src/ukuishellintegration.cpp
@@ -32,7 +32,20 @@ bool UkuiShellIntegration::initialize(QtWaylandClient::QWaylandDisplay *display)
 
 QtWaylandClient::QWaylandShellSurface *UkuiShellIntegration::createShellSurface(QtWaylandClient::QWaylandWindow *window)
 {
-    return m_ukuiShell->getUkuiShellSurface(window);
+    auto *shellSurface = m_ukuiShell->getUkuiShellSurface(window);
+    if (!shellSurface) {
+        m_shellSurfaces[window->window()] = shellSurface;
+    }
+    return shellSurface;
 }
 
+void *UkuiShellIntegration::nativeResourceForWindow(const QByteArray &resourceString, QWindow *window)
+{
+    QByteArray lowerCaseResource = resourceString.toLower();
+    if (lowerCaseResource == QByteArrayLiteral("ukui_surface")) {
+        return m_shellSurfaces[window]->ukui_surface::object();
+    }
+
+    return nullptr;
+}
 }
diff --git a/src/ukuishellintegration.h b/src/ukuishellintegration.h
index 1d2c0d8..55eb601 100644
--- a/src/ukuishellintegration.h
+++ b/src/ukuishellintegration.h
@@ -18,8 +18,11 @@ public:
     bool initialize(QtWaylandClient::QWaylandDisplay *display) override;
     QtWaylandClient::QWaylandShellSurface *createShellSurface(QtWaylandClient::QWaylandWindow *window) override;
 
+    void *nativeResourceForWindow(const QByteArray &resourceString, QWindow *window) override;
+
 private:
     std::unique_ptr<UkuiShell> m_ukuiShell;
+    std::unordered_map<QWindow *, UkuiShellSurface *> m_shellSurfaces;
 };
 
 } // namespace UKUI
diff --git a/src/ukuishellsurface.cpp b/src/ukuishellsurface.cpp
index a5a0b9d..8d2c5ef 100644
--- a/src/ukuishellsurface.cpp
+++ b/src/ukuishellsurface.cpp
@@ -609,6 +609,22 @@ void Toplevel::parseWindowProperties()
             }
         } else if (key == "icon") {
             m_ukuiShellSurface->setWindowIcon(window->property(property).toString());
+        } else if (key == "panelautohide") {
+            m_ukuiShellSurface->set_panel_auto_hide(window->property(property).toBool());
+        } else if (key == "grabkeyboard") {
+            m_ukuiShellSurface->grab_keyboard(m_ukuiShellSurface->window()->display()->lastInputDevice()->object());
+        } else if (key == "openundercursor") {
+            const auto point = window->property(property).toPoint();
+            m_ukuiShellSurface->open_under_cursor(point.x(), point.y());
+        } else if (key == "position") {
+            const auto point = window->property(property).toPoint();
+            m_ukuiShellSurface->set_position(point.x(), point.y());
+        } else if (key == "skiptaskbar") {
+            m_ukuiShellSurface->setSkipTaskbar(window->property(property).toBool());
+        } else if (key == "skipswitcher") {
+            m_ukuiShellSurface->setSkipSwitcher(window->property(property).toBool());
+        } else if (key == "paneltakefocus") {
+            m_ukuiShellSurface->set_panel_takes_focus(window->property(property).toBool());
         }
     }
 }
