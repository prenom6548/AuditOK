From: Jie Liu <liujie01@kylinos.cn>
Date: Fri, 30 Aug 2024 19:42:04 +0800
Subject: export ukui_shell and ukui_surface interface by
 nativeResourceForWindow

---
 src/ukuishellintegration.cpp | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/ukuishellintegration.cpp b/src/ukuishellintegration.cpp
index c4c1bac..74cb676 100644
--- a/src/ukuishellintegration.cpp
+++ b/src/ukuishellintegration.cpp
@@ -42,8 +42,16 @@ QtWaylandClient::QWaylandShellSurface *UkuiShellIntegration::createShellSurface(
 void *UkuiShellIntegration::nativeResourceForWindow(const QByteArray &resourceString, QWindow *window)
 {
     QByteArray lowerCaseResource = resourceString.toLower();
-    if (lowerCaseResource == QByteArrayLiteral("ukui_surface")) {
-        return m_shellSurfaces[window]->ukui_surface::object();
+    if (lowerCaseResource == QByteArrayLiteral("ukui_shell")) {
+        if (m_shellSurfaces.find(window) != m_shellSurfaces.end()) {
+            return m_shellSurfaces[window]->shell()->ukui_shell::object();
+        }
+        return nullptr;
+    } else if (lowerCaseResource == QByteArrayLiteral("ukui_surface")) {
+        if (m_shellSurfaces.find(window) != m_shellSurfaces.end()) {
+            return m_shellSurfaces[window]->ukui_surface::object();
+        }
+        return nullptr;
     }
 
     return nullptr;
