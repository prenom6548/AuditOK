####### Compile

kypackage-test.o: kypackage-test.cpp ../../packages/libkypackages.h \
		../cpp-stub/src/stub.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o kypackage-test.o kypackage-test.cpp

libkypackages.o: ../../packages/libkypackages.c ../../packages/libkypackages.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o libkypackages.o ../../packages/libkypackages.c

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu || mkdir -p $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/ 


install_headers: first FORCE
	@test -d $(INSTALL_ROOT)/usr/include/kysdk/base/ || mkdir -p $(INSTALL_ROOT)/usr/include/kysdk/base/
	$(QINSTALL_PROGRAM) /home/kylin/sdk/libkysdk-system/libkysdk-system/src/packages/libkypackages.h $(INSTALL_ROOT)/usr/include/kysdk/base/libkypackages.h
	-strip $(INSTALL_ROOT)/usr/include/kysdk/base/libkypackages.h

uninstall_headers: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/include/kysdk/base/libkypackages.h
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/include/kysdk/base/ 


install: install_target install_headers  FORCE

uninstall: uninstall_target uninstall_headers  FORCE

FORCE:

