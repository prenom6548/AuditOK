mv /usr/share/locale/bo_CN/LC_MESSAGES/kysdk-sysinfo_bo_CN.mo /usr/share/locale/bo_CN/LC_MESSAGES/kysdk-sysinfo.mo || true
mv /usr/share/locale/zh_HK/LC_MESSAGES/kysdk-sysinfo_zh_HK.mo /usr/share/locale/zh_HK/LC_MESSAGES/kysdk-sysinfo.mo || true
mv /usr/share/locale/kk/LC_MESSAGES/kysdk-sysinfo_kk.mo /usr/share/locale/kk/LC_MESSAGES/kysdk-sysinfo.mo || true
mv /usr/share/locale/ky/LC_MESSAGES/kysdk-sysinfo_ky.mo /usr/share/locale/ky/LC_MESSAGES/kysdk-sysinfo.mo || true
mv /usr/share/locale/de/LC_MESSAGES/kysdk-sysinfo_de.mo /usr/share/locale/de/LC_MESSAGES/kysdk-sysinfo.mo || true
mv /usr/share/locale/es/LC_MESSAGES/kysdk-sysinfo_es.mo /usr/share/locale/es/LC_MESSAGES/kysdk-sysinfo.mo || true
