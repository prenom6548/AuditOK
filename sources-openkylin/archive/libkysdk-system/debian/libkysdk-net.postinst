if systemctl is-active --quiet kysdk-dbus.service; then
    echo "kysdk-dbus.service is active, restarting..."
    systemctl restart kysdk-dbus.service || { echo "systemctl restart kysdk-dbus.service failed"; true; }
else
    echo "kysdk-dbus.service is not active"
fi

if systemctl is-active --quiet kysdk-net.service; then
    echo "kysdk-net.service is active, restarting..."
    systemctl restart kysdk-net.service || { echo "systemctl restart kysdk-net.service failed"; true; }
else
    echo "kysdk-net.service is not active"
fi
