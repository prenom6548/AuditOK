#!/bin/bash
# systemctl daemon-reload
# systemctl enable kysdk-dbus.service
# systemctl restart kysdk-dbus.service

echo "Reloading systemd daemon..."
systemctl daemon-reload || { echo "systemctl daemon-reload failed"; true; }

echo "Unmask kysdk-dbus.service..."
systemctl unmask kysdk-dbus.service || { echo "systemctl unmask kysdk-dbus.service failed"; true; }

echo "Enabling kysdk-dbus.service..."
systemctl enable kysdk-dbus.service || { echo "systemctl enable kysdk-dbus.service failed"; true; }

echo "Restarting kysdk-dbus.service..."
systemctl restart kysdk-dbus.service || { echo "systemctl restart kysdk-dbus.service failed"; true; }
