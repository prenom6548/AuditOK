+void extract_value(const char *line, const char *key, char *output, size_t output_size) {
+    if (strstr(line, key)) {
+        const char *colon = strchr(line, ':');
+        if (colon) {
+            strncpy(output, colon + 1, output_size - 1);
+            output[output_size - 1] = '\0'; // 确保字符串结尾
+            strstripspace(output); // 去除空格
+        }
+    }
+}
+
+static kdk_custom_info kdk_system_tag_custom_version_verify()
+{
+    kdk_custom_info info;
+    char line[128];
+    FILE *fp = fopen("/etc/.kylin-osinfo", "rt");
+    if (!fp)
+    {
+        strcpy(info.version_type, "Unknown");
+        strcpy(info.custom_info, "Unknown");
+        strcpy(info.custom_type, "Unknown");
+        return info;
+    }
+
+    char type[128] = {0};
+    char project[128] = {0};
+
+    while (fgets(line, sizeof(line), fp))
+    {
+        extract_value(line, "CustomType", type, sizeof(type));
+        extract_value(line, "ProjectInfo", project, sizeof(project));
+
+        if (*type && *project)  // 两个都找到就停止
+            break;
+    }
+    fclose(fp);
+
+    if (*type)
+    {
+        if (*project)
+        {
+            strcpy(info.version_type, "是");
+            strcpy(info.custom_info, project);
+            strcpy(info.custom_type, type);
+        }
+        else
+        {
+            strcpy(info.version_type, "否");
+            strcpy(info.custom_info, "Unknown");
+            strcpy(info.custom_type, "Unknown");
+        }
+    }
+    else
+    {
+        strcpy(info.version_type, "Unknown");
+        strcpy(info.custom_info, "Unknown");
+        strcpy(info.custom_type, "Unknown");
+    }
+    return info;
+}
