+// 解析实际使用的命令：
+// 若 /usr/bin/<cmd> 是软连接，说明原生命令已被替换，真实命令位于 <cmd>.orig，返回 <cmd>.orig；
+// 若不是软连接，则返回原生命令 <cmd> 本身。
+static const char *kdk_get_real_cmd(const char *cmd)
+{
+    static char resolved[8][64];
+    static int idx = 0;
+    char path[256] = {0};
+
+    if (!cmd)
+    {
+        return cmd;
+    }
+
+    snprintf(path, sizeof(path), "/usr/bin/%s", cmd);
+    if (access(path, F_OK) == 0)
+    {
+        struct stat st;
+        if (lstat(path, &st) == 0 && S_ISLNK(st.st_mode))
+        {
+            char *buf = resolved[(idx++) & 7];
+            snprintf(buf, sizeof(resolved[0]), "%s.orig", cmd);
+            return buf;
+        }
+    }
+
+    return cmd;
+}
