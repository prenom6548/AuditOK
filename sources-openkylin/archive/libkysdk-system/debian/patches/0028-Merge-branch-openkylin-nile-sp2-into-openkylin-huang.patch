+    }
+    else
+    {
+        // çˆ¶è¿›ç¨‹ï¼šå…³é—­å†™ç«¯
+        close(pipefd[1]);
+
+        // ä»ç®¡é“è¯»å–æ•°æ®å¹¶å¤„ç†
+        int read_result = _read_pipe_and_process(pipefd[0], callback, user_data);
