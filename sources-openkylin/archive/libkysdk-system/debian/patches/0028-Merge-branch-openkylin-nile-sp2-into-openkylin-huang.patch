+            else
+            {
+                // æ·»åŠ åˆ°è¡Œç¼“å†²åŒº
+                if (line_pos < buffer_size - 1)
+                {
+                    line_buffer[line_pos++] = read_buffer[i];
+                }
+                else
+                {
+                    // è¡Œç¼“å†²åŒºæº¢å‡ºï¼Œå¼ºåˆ¶å¤„ç†
+                    line_buffer[line_pos] = '\0';
