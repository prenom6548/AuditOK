+static int extract_deb_uri(const char* input, char* output, size_t out_len) {
+    if (!input || !output || out_len == 0)
+        return -1;
+
+    const char *start = strchr(input, '\'');
+    if (!start)
+        return -1; // æ²¡æœ‰æ‰¾åˆ°ç¬¬ä¸€ä¸ªå•å¼•å·
+
+    const char *end = strchr(start + 1, '\'');
+    if (!end)
+        return -1; // æ²¡æœ‰æ‰¾åˆ°ç¬¬äºŒä¸ªå•å¼•å·
+
+    size_t len = end - start - 1;
+    if (len >= out_len)
+        return -1; // ç¼“å†²åŒºå¤ªå°
+
+    strncpy(output, start + 1, len);
+    output[len] = '\0';
+    return 0;
+}
+
+static char *trim(char *s)
+{
+    while (*s == ' ' || *s == '\t') s++;
+    char *end = s + strnlen(s, STRNLEN_MAX) - 1;
+    while (end > s && (*end == ' ' || *end == '\t' || *end == '\n'))
+        *end-- = '\0';
+    return s;
+}
