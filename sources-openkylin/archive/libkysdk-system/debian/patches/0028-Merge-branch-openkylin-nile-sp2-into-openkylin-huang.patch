+static unsigned long kdk_package_get_kare_package_size(const char *pkg_name)
+{
+    unsigned long size = 0;
+
+    int pipe_fd[2];
+    pid_t pid;
+    bool installable = false;
+
+    if (pipe(pipe_fd) == -1) {
+        return false;
+    }
+
+    pid = fork();
+    if (pid == -1) {
+        close(pipe_fd[0]);
+        close(pipe_fd[1]);
+        return false;
+    }
+
+    if (pid == 0) { // å­è¿›ç¨‹
+        close(pipe_fd[0]);
+        dup2(pipe_fd[1], STDOUT_FILENO);
+        dup2(pipe_fd[1], STDERR_FILENO);
+        close(pipe_fd[1]);
+
+        char *args[] = {"kare", "-s", (char *)pkg_name, NULL};
+
+        execvp("kare", args);
+        
+        exit(EXIT_FAILURE);
+    } else { // çˆ¶è¿›ç¨‹
+        close(pipe_fd[1]);
+        
+        FILE *fp = fdopen(pipe_fd[0], "r");
+        if (!fp) {
+            close(pipe_fd[0]);
+            waitpid(pid, NULL, 0);
+            return false;
+        }
+
+        char line[1024] = "\0";
+        char *val = NULL;
+        while (fgets(line, sizeof(line), fp)) {
+            strstripspace(line);
+            
+            if (strncmp(line, "Installed-Size:", 15) == 0) {
+                if ((val = lookup(line, "Installed-Size")))
+                {
+                    size = atol(val);
+                }
+            }
+        }
+        
+        fclose(fp);
+        
+        // ç­‰å¾…å­è¿›ç¨‹ç»“æŸ
+        int status;
+        waitpid(pid, &status, 0);
+        
+        // æ£€æŸ¥å‘½ä»¤æ‰§è¡ŒçŠ¶æ€
+        if (WIFEXITED(status) && WEXITSTATUS(status) != 0) {
+            installable = false;
+        }
+    }
+    return size;
+}
