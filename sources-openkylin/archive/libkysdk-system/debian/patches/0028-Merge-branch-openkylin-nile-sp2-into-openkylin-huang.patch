+    m_u64FreeCapacity = 0;
+    m_u32TrackNumber = 0;
+    m_u64UsedCapacity = 0;
+    m_oCDROM = (DataCDROMImpl *)parent;
+    m_oCapacity = std::to_string(0.00) + "B";
+    m_oUsedCapacity = std::to_string(0.00) + "B";
+    m_oFreeCapacity = std::to_string(0.00) + "B";
+}
