+    // å°è¯•è·å–éé˜»å¡å…±äº«é”ï¼ˆæ£€æŸ¥è¯»é”ï¼‰
+    if (flock(fd, LOCK_SH | LOCK_NB) == 0) {
+        flock(fd, LOCK_UN);  // ç«‹å³é‡Šæ”¾
+        // å†å°è¯•æ’ä»–é”ï¼ˆæ£€æŸ¥å†™é”ï¼‰
+        if (flock(fd, LOCK_EX | LOCK_NB) == 0) {
