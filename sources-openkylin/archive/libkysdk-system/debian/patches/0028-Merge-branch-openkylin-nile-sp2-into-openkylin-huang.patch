+        return -1;
+    }
+
+    pid_t child_pid = fork();
+    if (child_pid == -1)
+    {
+        klog_err("fork è°ƒç”¨å¤±è´¥, errno:%d (%s)\n", errno, strerror(errno));
+        close(pipefd[0]);
+        close(pipefd[1]);
