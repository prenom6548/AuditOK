+        if (strncmp(buf, key, strnlen(key, STRNLEN_MAX)) == 0)
+        {
+            val = strdup((char*)buf + strnlen(key, STRNLEN_MAX) +1);
+            break;
+        }
+    }
+
+    return val;
+}
