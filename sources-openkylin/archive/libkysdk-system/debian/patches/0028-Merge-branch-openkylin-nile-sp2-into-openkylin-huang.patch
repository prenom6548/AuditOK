+            close(fd);
+            return UNLOCKED;  // ä¸¤ç§é”éƒ½èƒ½è·å–ï¼Œè¯´æ˜æ²¡é”
+        } else if (errno == EWOULDBLOCK) {
+            close(fd);
+            return LOCKED;  // æœ‰å†™é”
+        }
+    } else if (errno == EWOULDBLOCK) {
+        close(fd);
+        return LOCKED;  // æœ‰è¯»é”æˆ–å†™é”
+    }
+    
+    close(fd);
+    return ERROR;
+}
