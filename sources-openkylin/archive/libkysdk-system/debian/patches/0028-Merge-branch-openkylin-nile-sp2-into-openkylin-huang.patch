+
+    ns_mode_session_id_t session_id_t = enter_handle();
+    
+    if(session_id_t == 0)
+    {
+        syslog(LOG_ERR, "é”™è¯¯: ns_mode_enter() å¤±è´¥, %s\n", strerror(errno));
+        dlclose(libHandle);
