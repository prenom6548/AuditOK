+// è®¡ç®— deb æ–‡ä»¶å‰åŠéƒ¨åˆ†çš„ SHA512ï¼ˆåˆ†æ®µè¯»å–ï¼‰
+static int calculate_deb_sha512(const char* deb_file, off_t total_size, unsigned char* hash) {
+    int fd = open(deb_file, O_RDONLY);
+    if (fd < 0) {
+        syslog(LOG_ERR, "æ‰“å¼€æ–‡ä»¶å¤±è´¥");
+        return -1;
+    }
+
+    SHA512_CTX ctx;
+    SHA512_Init(&ctx);
+    
+    unsigned char buffer[BUFFER_SIZE];
+    off_t bytes_read = 0;
+    ssize_t n;
+    
+    // åˆ†æ®µè¯»å–å¹¶è®¡ç®—å“ˆå¸Œ
+    while (bytes_read < total_size) {
+        size_t to_read = BUFFER_SIZE;
+        if (bytes_read + to_read > total_size) {
+            to_read = total_size - bytes_read;
+        }
+        
+        n = read(fd, buffer, to_read);
+        if (n < 0) {
+            syslog(LOG_ERR, "è¯»å–æ–‡ä»¶å¤±è´¥");
+            close(fd);
+            return -1;
+        }
+        if (n == 0) {
+            break;  // EOF
+        }
+        
+        SHA512_Update(&ctx, buffer, n);
+        bytes_read += n;
+    }
+    
+    SHA512_Final(hash, &ctx);
+    close(fd);
+    
+    return 0;
+}
