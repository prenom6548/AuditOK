+// è§£æ ar å‘½ä»¤è¾“å‡º
+static DebInfo parse_ar_output(const char* ar_output) {
+    DebInfo info = {0, 0, 0};
+    
+    // ç¤ºä¾‹è¾“å‡ºå¯èƒ½åŒ…å«åå…­è¿›åˆ¶:
+    // "rw-r--r-- 1000/1000  12345678  Dec 31 23:59 data.tar 0x3d0"
+    
+    char buffer[1024];
+    strncpy(buffer, ar_output, sizeof(buffer));
+    buffer[sizeof(buffer)-1] = '\0';
+    
+    // åˆ†å‰²å­—ç¬¦ä¸²
+    char* tokens[32];
+    int token_count = 0;
+    
+    char* token = strtok(buffer, " \t");
+    while (token && token_count < 32) {
+        tokens[token_count++] = token;
+        token = strtok(NULL, " \t");
+    }
+    
+    if (token_count < 7) {
+        syslog(LOG_ERR, "è­¦å‘Š: ar è¾“å‡ºæ ¼å¼å¼‚å¸¸\n");
+        return info;
+    }
+    
+    // ç¬¬3åˆ—æ˜¯å¤§å°ï¼ˆå¯èƒ½æ˜¯åè¿›åˆ¶æˆ–åå…­è¿›åˆ¶ï¼‰
+    char* endptr;
+    info.size = strtol(tokens[2], &endptr, 0);  // 0è¡¨ç¤ºè‡ªåŠ¨è¯†åˆ«è¿›åˆ¶
+    if (endptr == tokens[2]) {
+        syslog(LOG_ERR, "é”™è¯¯: æ— æ³•è§£æå¤§å° '%s'\n", tokens[2]);
+        return info;
+    }
+    
+    // æœ€åä¸€åˆ—æ˜¯åç§»é‡ï¼ˆå¯èƒ½æ˜¯åè¿›åˆ¶æˆ–åå…­è¿›åˆ¶ï¼‰
+    info.offset = strtol(tokens[token_count - 1], &endptr, 0);
+    if (endptr == tokens[token_count - 1]) {
+        syslog(LOG_ERR, "é”™è¯¯: æ— æ³•è§£æåç§»é‡ '%s'\n", tokens[token_count - 1]);
+        return info;
+    }
+    
+    info.total_size = info.size + info.offset;
+    
+    return info;
+}
