+        result[0] = 'u';  // unknown
+    }
+
+    // ç¡®å®šå®é™…çŠ¶æ€çš„ç¬¬äºŒä¸ªå­—ç¬¦
+    if (part2) {
+        if (strcmp(part2, "ok") == 0) {
+            if (part3 && strcmp(part3, "installed") == 0) {
+                result[1] = 'i';  // installed
+            } else if (part3 && strcmp(part3, "unpacked") == 0) {
