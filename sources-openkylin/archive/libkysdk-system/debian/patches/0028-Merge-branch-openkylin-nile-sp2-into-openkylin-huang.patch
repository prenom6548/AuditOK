+typedef struct {
+    FILE *fp;
+    pid_t pid;
+} cmd_pipe_t;
+
+static cmd_pipe_t cmd_popen(const char *file, char *const argv[])
+{
+    cmd_pipe_t result = {NULL, -1};
+    int pipefd[2];
+    if (pipe(pipefd) < 0)
+        return result;
+
+    pid_t pid = fork();
+    if (pid < 0)
+    {
+        close(pipefd[0]);
+        close(pipefd[1]);
+        return result;
+    }
+
+    if (pid == 0)
+    {
+        close(pipefd[0]);
+        dup2(pipefd[1], STDOUT_FILENO);
+        dup2(pipefd[1], STDERR_FILENO);
+        close(pipefd[1]);
+        execvp(file, argv);
+        _exit(127);
+    }
+
+    close(pipefd[1]);
+    result.fp = fdopen(pipefd[0], "r");
+    if (!result.fp)
+    {
+        close(pipefd[0]);
+        waitpid(pid, NULL, 0);
+    }
+    result.pid = pid;
+    return result;
+}
+
+static int cmd_pclose(cmd_pipe_t *cp)
+{
+    if (!cp || !cp->fp)
+        return -1;
+    fclose(cp->fp);
+    cp->fp = NULL;
+    int status = 0;
+    if (cp->pid > 0)
+    {
+        waitpid(cp->pid, &status, 0);
+        cp->pid = -1;
+    }
+    return status;
+}
