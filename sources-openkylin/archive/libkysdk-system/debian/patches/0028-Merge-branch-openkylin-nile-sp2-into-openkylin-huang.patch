+            ver->os_version = strdup(value);
+        } else if (strcmp(key, "update_version") == 0) {
+            ver->update_version = strdup(value);
+        }
+        line = strtok(NULL, "\n");
+    }
+
+    free(contents);
+
+    if (!ver->os_version || !ver->update_version) {
+        klog_info("The required version information was not found\n");
+    }
+
+    return TRUE;
