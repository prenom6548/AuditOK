+static kdk_pre_inst_method kdk_check_km_or_deb(char *uri)
+{
+    kdk_pre_inst_method method = KDK_PRE_INST_NONE_METHOD;
+    char filename[512] = {0};
+    strncpy(filename, uri, 511);
+    const char *dot = strrchr(filename, '.');
+    // å¦‚æœæ²¡æœ‰æ‰¾åˆ°ç‚¹ï¼Œæˆ–è€…ç‚¹æ˜¯æ–‡ä»¶åçš„ç¬¬ä¸€ä¸ªå­—ç¬¦ï¼Œåˆ™è¿”å› false
+    if (dot == NULL || dot == filename)
+    {
+        return 0;
+    }
+    if (strcmp(dot, ".ok") == 0)
+    {
+        return KDK_PRE_INST_KM_METHOD;
+    }
+    else
+    {
+        memset(filename, 0, 512);
+        strncpy(filename, uri, 511);
+
+        char file_name[512] = "\0";
+
+        int pipe_fd[2];
+        pid_t pid;
+
+        if (pipe(pipe_fd) == -1) {
+            return KDK_PRE_INST_NONE_METHOD;
+        }
+
+        pid = fork();
+        if (pid == -1) {
+            close(pipe_fd[0]);
+            close(pipe_fd[1]);
+            return KDK_PRE_INST_NONE_METHOD;
+        }
+
+        if (pid == 0) { // å­è¿›ç¨‹
+            close(pipe_fd[0]);
+            dup2(pipe_fd[1], STDOUT_FILENO);
+            dup2(pipe_fd[1], STDERR_FILENO);
+            close(pipe_fd[1]);
+
+            char *args[] = {"dpkg-deb", "-f", (char*)filename, "Package", NULL};
+
+            execvp("dpkg", args);
+            
+            exit(EXIT_FAILURE);
+        } else { // çˆ¶è¿›ç¨‹
+            close(pipe_fd[1]);
+            
+            FILE *fp = fdopen(pipe_fd[0], "r");
+            if (!fp) {
+                close(pipe_fd[0]);
+                waitpid(pid, NULL, 0);
+                return KDK_PRE_INST_NONE_METHOD;
+            }
+
+            char line[1024] = "\0";
+            char *val = NULL;
+            fgets(file_name, sizeof(file_name), fp);
+            strstripspace(file_name);
+            syslog(LOG_INFO, "file_name = %s\n", file_name);
+            
+            fclose(fp);
+            if (file_name[0] != '\0')
+            {
+                method = kdk_check_kare_or_dpkg(uri, file_name);
+            }
+            
+            // ç­‰å¾…å­è¿›ç¨‹ç»“æŸ
+            int status;
+            waitpid(pid, &status, 0);
+        }
+    }
+    return method;
+}
