+static bool kdk_package_is_deb_online_installable(const char *name, const char *version)
+{
+    int pipe_fd[2];
+    pid_t pid;
+    bool installable = false;
+
+#ifdef __loongarch64
+
+    char cmd[512] = "";
+    snprintf(cmd, sizeof(cmd), "dpkg --add-architecture loongarch64 && apt.orig update");
+    syslog(LOG_DEBUG, "cmd = %s\n", cmd);
+    system(cmd);
+#endif
+
+    if (pipe(pipe_fd) == -1) {
+        return false;
+    }
+
+    pid = fork();
+    if (pid == -1) {
+        close(pipe_fd[0]);
+        close(pipe_fd[1]);
+        return false;
+    }
+
+    if (pid == 0) { // å­è¿›ç¨‹
+        close(pipe_fd[0]);
+        dup2(pipe_fd[1], STDOUT_FILENO);
+        dup2(pipe_fd[1], STDERR_FILENO);
+        close(pipe_fd[1]);
+
+        char *args[] = {
+            "apt-cache", "policy", (char *)name, NULL
+        };
+        execvp("apt-cache", args);
+        
+        exit(EXIT_FAILURE);
+    } else { // çˆ¶è¿›ç¨‹
+        close(pipe_fd[1]);
+        
+        FILE *fp = fdopen(pipe_fd[0], "r");
+        if (!fp) {
+            close(pipe_fd[0]);
+            waitpid(pid, NULL, 0);
+            return false;
+        }
+
+        char line[1024] = {0};
+        bool in_version_list = false;  // æ ‡è®°æ˜¯å¦åœ¨ç‰ˆæœ¬åˆ—è¡¨åŒºåŸŸ
+        char *colon = NULL;
+        char candidate_version[256] = {0};
+        while (fgets(line, sizeof(line), fp)) {
+            strstripspace(line);
+            
+            char *p = line;
+
+            // å»é™¤å‰å¯¼ç©ºæ ¼
+            p = trim(p);
+           
+            if (strstr(p, "å€™é€‰")) {
+                colon = strchr(p, 'ï¼š');
+                if (colon) {
+                    char *ver_start = colon + 1;
+                    strstripspace(ver_start);
+                    strcpy(candidate_version, ver_start);
+                    syslog(LOG_INFO, "[%s] Found candidate version: %s\n", __func__, candidate_version);
+                }
+                continue;
+            }
+
+            // *** å¼€å¤´ï¼Œè·³è¿‡æ˜Ÿå·
+            if (strncmp(p, "***", 3) == 0)
+                p = trim(p + 3);
+
+            // æå–ç‰ˆæœ¬å·ï¼ˆå–ç¬¬ä¸€ä¸ªç©ºæ ¼å‰çš„éƒ¨åˆ†ï¼‰
+            char ver[256] = {0};
+            sscanf(p, "%255s", ver);
+
+            // é˜²æ­¢é”™è¯¯è¡Œï¼šç‰ˆæœ¬å·å¿…é¡»åŒ…å«æ•°å­—
+            if (!strpbrk(ver, "0123456789"))
+                continue;
+
+            syslog(LOG_INFO, "[%s] version = %s, ver = %s, candidate_version = %s\n", __func__, version, ver, candidate_version);
+            if(version) {
+                if(strcmp(version, ver) == 0) {
+                    // éœ€è¦è·å–è¿™ä¸ªç‰ˆæœ¬å¯¹åº”çš„URL
+                    // ç»§ç»­è¯»å–ä¸‹ä¸€è¡Œè·å–URLä¿¡æ¯
+                    if (fgets(line, sizeof(line), fp)) {
+                        strstripspace(line);
+                        // URLè¡Œé€šå¸¸ä»¥æ•°å­—å¼€å¤´ï¼Œåé¢è·Ÿç€URL
+                        char url_temp[1024] = {0};
+                        int priority;
+
+                        if (sscanf(line, "%d %1023s", &priority, url_temp) == 2) {
+                            if ((strncmp(url_temp, "http://", 7) == 0 || strncmp(url_temp, "https://", 8) == 0)) {
+                                syslog(LOG_INFO, "[%s] found URL: %s\n", __func__, url_temp);
+                                bool ret_access = test_connectivity(url_temp);
+                                if(!ret_access)
+                                {
+                                    syslog(LOG_DEBUG, "[%s] Weak network environment detected, please check your network connectivity.", __func__);
+                                    installable = false;
+                                    break;
+                                } else {
+                                    installable = true;
+                                    break;
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+            else{
+                if(candidate_version[0] != '\0') {
+                    if(strcmp(candidate_version, ver) == 0) {
+                        // éœ€è¦è·å–è¿™ä¸ªç‰ˆæœ¬å¯¹åº”çš„URL
+                        // ç»§ç»­è¯»å–ä¸‹ä¸€è¡Œè·å–URLä¿¡æ¯
+                        if (fgets(line, sizeof(line), fp)) {
+                            strstripspace(line);
+                            // URLè¡Œé€šå¸¸ä»¥æ•°å­—å¼€å¤´ï¼Œåé¢è·Ÿç€URL
+                            char url_temp[1024] = {0};
+                            int priority;
+
+                            if (sscanf(line, "%d %1023s", &priority, url_temp) == 2) {
+                                if ((strncmp(url_temp, "http://", 7) == 0 || strncmp(url_temp, "https://", 8) == 0)) {
+                                    syslog(LOG_INFO, "[%s] found URL: %s\n", __func__, url_temp);
+                                    bool ret_access = test_connectivity(url_temp);
+                                    if(!ret_access)
+                                    {
+                                        installable = false;
+                                        syslog(LOG_DEBUG, "[%s] Weak network environment detected, please check your network connectivity.", __func__);
+                                        break;
+                                    } else {
+                                        installable = true;
+                                        break;
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        
+        fclose(fp);
+        
+        // ç­‰å¾…å­è¿›ç¨‹ç»“æŸ
+        int status;
+        waitpid(pid, &status, 0);
+
+        // æ£€æŸ¥å‘½ä»¤æ‰§è¡ŒçŠ¶æ€
+        if (WIFEXITED(status) && WEXITSTATUS(status) != 0) {
+            installable = false;
+        }
+    }
+
+#ifdef __loongarch64
+    snprintf(cmd, sizeof(cmd), "dpkg --remove-architecture loongarch64 && apt.orig update");
+    syslog(LOG_DEBUG, "cmd = %s\n", cmd);
+    system(cmd);
+#endif
+    return installable;
+}
