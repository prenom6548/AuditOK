+        
+
+    // åˆ†é…å†…å­˜å­˜å‚¨ä¸¤ä¸ªå­—ç¬¦çš„çŠ¶æ€ç 
+    char *result = malloc(3 * sizeof(char));
+    if (!result)
+    {
+        syslog(LOG_ERR, "malloc failed");
+        return NULL;
+    }
+        
+
+    memset(result, 0, 3);
+    // åˆå§‹åŒ–ä¸º0
+
+    // è§£æçŠ¶æ€å­—ç¬¦ä¸²ï¼Œä¾‹å¦‚ "install ok installed"
+    // ç¬¬ä¸€éƒ¨åˆ†ï¼šæœŸæœ›çŠ¶æ€ (Desired-State)
+    // ç¬¬äºŒéƒ¨åˆ†ï¼šå®é™…çŠ¶æ€ (Package-Status)
+    char *status_copy = strdup(pkg_status);
+    if (!status_copy) {
+        free(result);
+        return NULL;
+    }
+
+    char *part1 = NULL;  // æœŸæœ›çŠ¶æ€
+    char *part2 = NULL;  // å®é™…çŠ¶æ€
+    char *part3 = NULL;  // å­çŠ¶æ€
+
+    char *token = strtok(status_copy, " ");
+    if (token) {
+        part1 = token;
+        token = strtok(NULL, " ");
+        if (token) {
+            part2 = token;
+            token = strtok(NULL, " ");
+            if (token) {
+                part3 = token;
+            }
+        }
+    }
+
+    // ç¡®å®šæœŸæœ›çŠ¶æ€çš„ç¬¬ä¸€ä¸ªå­—ç¬¦
+    if (part1) {
+        if (strcmp(part1, "install") == 0) {
+            result[0] = 'i';  // install
+        } else if (strcmp(part1, "hold") == 0) {
+            result[0] = 'h';  // hold
+        } else if (strcmp(part1, "deinstall") == 0) {
+            result[0] = 'r';  // remove
+        } else if (strcmp(part1, "purge") == 0) {
+            result[0] = 'p';  // purge
+        } else {
