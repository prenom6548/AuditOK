+bool contains_wildcard(const char *pattern) {
+    if (!pattern) return false;
+    const char *wildcards = "*";
+    
+    for (const char *p = pattern; *p; p++) {
+        if (strchr(wildcards, *p)) {
+            return true;
+        }
+    }
+    return false;
