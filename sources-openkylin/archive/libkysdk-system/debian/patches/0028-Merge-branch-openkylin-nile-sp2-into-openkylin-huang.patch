+        }
+    }
+
+
+    // æ¨¡å¼2: åŒ¹é…æ™®é€šåˆ†åŒºè®¾å¤‡ (^([a-z]+[0-9]+)$) - æ–°å¢
+    else if (strcmp(pattern, "^([a-z]+[0-9]+)$") == 0) {
+        // æ£€æŸ¥æ˜¯å¦ä»¥å°å†™å­—æ¯å¼€å¤´ï¼Œåè·Ÿæ•°å­—ç»“å°¾
+        if (strnlen(line, STRNLEN_MAX) < 2) {
+            return NULL;
+        }
+        
+        // æ£€æŸ¥ç¬¬ä¸€ä¸ªå­—ç¬¦æ˜¯å¦æ˜¯å°å†™å­—æ¯
+        if (!islower(line[0])) {
+            return NULL;
+        }
+        
