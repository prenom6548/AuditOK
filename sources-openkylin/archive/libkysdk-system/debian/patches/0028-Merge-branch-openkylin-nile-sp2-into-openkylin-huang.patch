+                .arg(diskinfo->model)
+                .arg(diskinfo->serial)
+                .arg(diskinfo->partition_nums)
+                .arg(diskinfo->disk_type)
+                .arg(QString::fromLocal8Bit(diskinfo->fwrev).remove("\n"))
+                .arg(diskinfo->sectors_num)
+                .arg(diskinfo->format);
+        kdk_free_diskinfo(diskinfo);
+        return result;
+    }else{
+        return NULL;
+    }
+}
