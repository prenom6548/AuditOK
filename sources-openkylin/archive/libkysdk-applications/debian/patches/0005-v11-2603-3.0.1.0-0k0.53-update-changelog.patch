+   {
+        qWarning()<<"failed to get ukui_surface_v1 from nativeResourceForWindow";
+        return nullptr;
+   }
+   UkuiShellSurface *ukuiSurface = new UkuiShellSurface(nullptr);
+   connect(this, &UkuiShell::interfaceAboutToBeReleased, ukuiSurface, &UkuiShellSurface::release);
+   connect(this, &UkuiShell::interfaceAboutToBeDestroyed, ukuiSurface, &UkuiShellSurface::destroy);
+   if (d->queue) {
+       d->queue->addProxy(ukui_surface);
+   }
+   ukuiSurface->setup(ukui_surface);
