+void KMiniCalendarWidget::showPreviousYear()
+{
+    Q_D(KMiniCalendarWidget);
+    int year = d->date.year();
+    int month = d->date.month();
+    int day = d->date.day();
+
+    year--;
+
+    if (year <= 1901 && month == 1) {
+        return;
+    }
+
+
+    dateChanged(year, month, day);
+}
+
+void KMiniCalendarWidget::showNextYear()
+{
+    Q_D(KMiniCalendarWidget);
+    int year = d->date.year();
+    int month = d->date.month();
+    int day = d->date.day();
+    year++;
+
+    if (year >= 2099 && month == 12) {
+        return;
+    }
+
+    dateChanged(year, month, day);
+
+}
