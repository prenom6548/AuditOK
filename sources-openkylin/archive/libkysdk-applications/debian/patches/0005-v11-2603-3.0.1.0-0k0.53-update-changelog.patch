+    if (!nativeResourceForWindowFun) {
+        qWarning() << "Failed to resolve nativeResourceForIntegration function";
+        return nullptr;
+    }
+
+   ukui_surface_v1* ukui_surface =  static_cast<ukui_surface_v1 *>(nativeResourceForWindowFun(native, QByteArrayLiteral("ukui_surface_v1"), window));
