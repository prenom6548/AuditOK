+char **KConf2Private::strvFromQVariant(const QVariant &variant)
+{
+    QStringList strList = variant.toStringList();
+    if(strList.isEmpty())
+        return nullptr;
+    char** result = new char*[strList.count()+1];
+    for (int i = 0; i < strList.count(); ++i) {
+        QByteArray byteArray = strList.at(i).toUtf8();
+        const int size = byteArray.size() + 1;
+        result[i] = new char[size];
+        strncpy(result[i], byteArray.constData(), size); 
+        result[i][size - 1] = '\0'; 
     }
+    result[strList.count()] = nullptr;
+    return result;
 }
 
