---
 kysdk-waylandhelper/protocols/ukui-startup-v2.xml | 66 +++++++++++++++++++++++
 1 file changed, 66 insertions(+)
 create mode 100644 kysdk-waylandhelper/protocols/ukui-startup-v2.xml

diff --git a/kysdk-waylandhelper/protocols/ukui-startup-v2.xml b/kysdk-waylandhelper/protocols/ukui-startup-v2.xml
new file mode 100644
index 0000000..a039736
--- /dev/null
+++ b/kysdk-waylandhelper/protocols/ukui-startup-v2.xml
@@ -0,0 +1,66 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="ukui_startup_v2">
+  <copyright><![CDATA[
+    SPDX-FileCopyrightText: 2025 KylinSoft Co., Ltd.
+
+    SPDX-License-Identifier: MulanPSL-2.0
+    ]]></copyright>
+
+  <interface name="ukui_startup_management_v2" version="1">
+    <description summary="ukui startup info management">
+      This interface manages startup infos.
+    </description>
+
+    <request name="destroy" type="destructor">
+      <description summary="Destroy the ukui_startup_management_v2 object."/>
+    </request>
+
+    <request name="create_startup_info">
+      <description summary="create startup_info object"/>
+      <arg name="id" type="new_id" interface="ukui_startup_info_v2"
+           summary="the new ukui_startup_info_v2 object"/>
+    </request>
+  </interface>
+
+  <interface name="ukui_startup_info_v2" version="1">
+    <description summary="startup info for window">
+      The startup_info object provides a way sets the startup geometry of the
+      taskbar/desktop entry for app.
+      The object will auto destroy when arrive the retire time.
+    </description>
+
+    <request name="set_startup_geometry">
+      <description summary="set the startup geometry">
+        Sets the startup geometry of the taskbar/desktop entry.
+        Coordinates are global.
+      </description>
+      <arg name="x" type="int"/>
+      <arg name="y" type="int"/>
+      <arg name="width" type="uint"/>
+      <arg name="height" type="uint"/>
+    </request>
+
+    <request name="set_pid">
+      <description summary="set the startup pid">
+        The pid determines which process will use the startup_geometry.
+        The child process of this process will also use the startup_geometry.
+      </description>
+      <arg name="pid" type="uint"/>
+    </request>
+
+    <request name="set_appid">
+      <description summary="set the startup appid">
+        The appid determines which app should use the startup_geometry.
+        It only uses when not set pid or not find the app from pid.
+      </description>
+      <arg name="app_id" type="string"/>
+    </request>
+
+    <request name="destroy" type="destructor">
+      <description summary="Destroy the ukui_startup_info_v2 object.">
+        Must call destroy after set info completely.
+      </description>
+    </request>
+
+  </interface>
+</protocol>
