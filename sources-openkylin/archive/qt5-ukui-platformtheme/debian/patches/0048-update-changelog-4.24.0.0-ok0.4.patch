+
+void UKUIConfigStyle::ensureLineEditClearToolButton(QLineEdit *lineEdit)
+{
+    if (!lineEdit || !isStandaloneLineEdit(lineEdit))
+        return;
+
+    if (lineEdit->isClearButtonEnabled()) {
+        lineEdit->setProperty("_ukui_clear_button_wanted", true);
+        lineEdit->setClearButtonEnabled(false);
+    }
+
+    if (!lineEdit->property("_ukui_clear_button_wanted").toBool())
+        return;
+
+    QToolButton *btn = lineEdit->findChild<QToolButton *>(QLatin1String("_ukui_lineedit_clearbtn"));
+    if (!btn) {
+        btn = new QToolButton(lineEdit);
+        btn->setObjectName(QStringLiteral("_ukui_lineedit_clearbtn"));
+        btn->setAutoRaise(false);
+        btn->setProperty("setDefaultBrush", QBrush(Qt::transparent));
+        btn->setCursor(Qt::ArrowCursor);
+        btn->setFocusPolicy(Qt::NoFocus);
+        btn->setIcon(standardIcon(QStyle::SP_LineEditClearButton, nullptr, lineEdit));
+        connect(btn, &QToolButton::clicked, lineEdit, [lineEdit]() {
+            lineEdit->clear();
+            lineEdit->setFocus(Qt::OtherFocusReason);
+        });
+
+        if (!lineEdit->property("_ukui_orig_margin_left").isValid()) {
+            const QMargins margins = lineEdit->textMargins();
+            lineEdit->setProperty("_ukui_orig_margin_left", margins.left());
+            lineEdit->setProperty("_ukui_orig_margin_top", margins.top());
+            lineEdit->setProperty("_ukui_orig_margin_right", margins.right());
+            lineEdit->setProperty("_ukui_orig_margin_bottom", margins.bottom());
+        }
+
+        connect(lineEdit, &QLineEdit::textChanged, lineEdit, [this, lineEdit]() {
+            updateLineEditClearToolButton(lineEdit);
+        });
+    }
+
+    updateLineEditClearToolButton(lineEdit);
+}
+
+void UKUIConfigStyle::updateLineEditClearToolButton(QLineEdit *lineEdit)
+{
+    if (!lineEdit || !lineEdit->property("_ukui_clear_button_wanted").toBool())
+        return;
+
+    QToolButton *btn = lineEdit->findChild<QToolButton *>(QLatin1String("_ukui_lineedit_clearbtn"));
+    if (!btn)
+        return;
+
+    const QMargins origMargins = lineEdit->property("_ukui_orig_margin_left").isValid()
+            ? QMargins(lineEdit->property("_ukui_orig_margin_left").toInt(),
+                       lineEdit->property("_ukui_orig_margin_top").toInt(),
+                       lineEdit->property("_ukui_orig_margin_right").toInt(),
+                       lineEdit->property("_ukui_orig_margin_bottom").toInt())
+            : lineEdit->textMargins();
+
+    const bool visible = lineEdit->isEnabled() && !lineEdit->isReadOnly() && !lineEdit->text().isEmpty();
+    btn->setVisible(visible);
+    if (!visible) {
+        lineEdit->setTextMargins(origMargins);
+        return;
+    }
+
+    const int btnSize = lineEdit->height() >= 36 ? 30 : qMax(16, lineEdit->height() - 6);
+    const int edgeMargin = 2;
+    const int y = (lineEdit->height() - btnSize) / 2;
+    const int x = lineEdit->layoutDirection() == Qt::RightToLeft
+            ? edgeMargin
+            : lineEdit->width() - btnSize - edgeMargin;
+
+    btn->setFixedSize(btnSize, btnSize);
+    btn->move(x, y);
+    btn->raise();
+
+    if (lineEdit->layoutDirection() == Qt::RightToLeft) {
+        lineEdit->setTextMargins(origMargins.left() + btnSize + edgeMargin,
+                                 origMargins.top(),
+                                 origMargins.right(),
+                                 origMargins.bottom());
+    } else {
+        lineEdit->setTextMargins(origMargins.left(),
+                                 origMargins.top(),
+                                 origMargins.right() + btnSize + edgeMargin,
+                                 origMargins.bottom());
+    }
+}
