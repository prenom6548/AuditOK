+void UKUIConfigStyle::releaseWindowHelper(QWidget *widget)
+{
+    if (!widget || !m_windowHelperHash || !m_windowHelperHash->contains(widget))
+        return;
+
+    delete m_windowHelperHash->take(widget);
+}
