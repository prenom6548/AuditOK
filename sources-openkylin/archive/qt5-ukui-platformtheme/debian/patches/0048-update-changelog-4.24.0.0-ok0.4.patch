+void KyQuickStyleItem::setContentWidth(int arg)
+{
+    if (m_contentWidth != arg) {
+        m_contentWidth = arg;
+        emit contentWidthChanged(arg);
+    }
+}
+
+void KyQuickStyleItem::setContentHeight(int arg)
+{
