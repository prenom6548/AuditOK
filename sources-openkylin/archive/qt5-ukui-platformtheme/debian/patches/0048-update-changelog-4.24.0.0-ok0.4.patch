+UkuiWindowHelper *UKUIConfigStyle::windowHelperForWidget(QWidget *widget)
+{
+    if (!widget)
+        return nullptr;
+
+    if (!m_windowHelperHash)
+        m_windowHelperHash = new QHash<QWidget *, UkuiWindowHelper *>();
+
+    if (m_windowHelperHash->contains(widget))
+        return m_windowHelperHash->value(widget);
+
+    auto *windowHelper = new UkuiWindowHelper(widget);
+    m_windowHelperHash->insert(widget, windowHelper);
+    connect(widget, &QWidget::destroyed, this, [this, widget]() {
+        if (m_windowHelperHash && m_windowHelperHash->contains(widget)) {
+            delete m_windowHelperHash->take(widget);
+        }
+    });
+    return windowHelper;
