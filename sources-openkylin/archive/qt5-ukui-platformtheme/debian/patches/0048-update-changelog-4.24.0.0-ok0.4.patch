+static bool isTranslucentHeader(const QWidget *widget)
+{
+    while (widget && !widget->inherits("QTreeView") && !widget->inherits("QTableView"))
+        widget = widget->parentWidget();
+    return widget && (!widget->property("needTranslucent").isValid()
+                      || widget->property("needTranslucent").toBool());
+}
+
+static bool isComboBoxPopupView(const QWidget *widget)
+{
+    while (widget) {
+        if (widget->inherits("QComboBoxPrivateContainer"))
+            return true;
+        widget = widget->parentWidget();
+    }
+    return false;
+}
+
+static bool usesOpaqueItemViewBackground(const QWidget *widget)
+{
+    return widget->property("needTranslucent").isValid()
+            && !widget->property("needTranslucent").toBool();
+}
+
+static const QAbstractItemView *itemViewForWidget(const QWidget *widget)
+{
+    if (isComboBoxPopupView(widget))
+        return nullptr;
+
+    while (widget) {
+        if (const auto *view = qobject_cast<const QListView *>(widget))
+            return usesOpaqueItemViewBackground(view) ? view : nullptr;
+        if (const auto *view = qobject_cast<const QTableView *>(widget))
+            return usesOpaqueItemViewBackground(view) ? view : nullptr;
+        if (const auto *view = qobject_cast<const QTreeView *>(widget))
+            return usesOpaqueItemViewBackground(view) ? view : nullptr;
+        widget = widget->parentWidget();
+    }
+    return nullptr;
+}
