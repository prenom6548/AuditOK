+void KyQuickStyleItem::styleChanged()
+{
+    if (!qApp->style() || QApplication::closingDown()) {
+        return;
+    }
+
+    Q_ASSERT(qApp->style() != sender());
+
+    connect(qApp->style(), &QObject::destroyed, this, &KyQuickStyleItem::styleChanged);
+
+    updateSizeHint();
+    updateItem();
+}
