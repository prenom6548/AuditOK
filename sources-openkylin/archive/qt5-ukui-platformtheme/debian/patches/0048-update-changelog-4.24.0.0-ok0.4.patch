+qreal KyQuickStyleItem::textHeight(const QString &text)
+{
+    QFontMetricsF fm = QFontMetricsF(m_styleoption->fontMetrics);
+    return text.isEmpty() ? fm.height() :
+                            fm.boundingRect(text).height();
+}
