-bool KyQuickStyleItem::event(QEvent *ev)
-{
-    if (ev->type() == QEvent::StyleAnimationUpdate) {
-        if (isVisible()) {
-            ev->accept();
-            polish();
-        }
-        return true;
-    }
-    return QQuickItem::event(ev);
