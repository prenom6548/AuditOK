+    GlobalDTConfigPrivate empty;
+    empty.m_dt_configData.clear();
+    empty.m_ukui_dt_loadConfig = false;
+    QBrush brush;
+    QVERIFY(!empty.getColorValue(brush, QStringLiteral("kblack")));
+    int px = 0;
+    QVERIFY(!empty.getValue(px, QStringLiteral("focusline")));
