+namespace  {
+class QHighDpiPixmapsEnabler1 {
+public:
+    QHighDpiPixmapsEnabler1()
+    :wasEnabled(false)
+    {
+        if (!qApp->testAttribute(Qt::AA_UseHighDpiPixmaps)) {
+            qApp->setAttribute(Qt::AA_UseHighDpiPixmaps);
+            wasEnabled = true;
+        }
+    }
+
+    ~QHighDpiPixmapsEnabler1()
+    {
+        if (wasEnabled)
+            qApp->setAttribute(Qt::AA_UseHighDpiPixmaps, false);
+    }
+private:
+    bool wasEnabled;
+};
+}
