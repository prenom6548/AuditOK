+
+void clearAppThemePropertiesOnApp()
+{
+    if (!qApp)
+        return;
+    for (const QString &key : g_appThemePropertyKeys) {
+        qApp->setProperty(key.toLatin1().constData(), QVariant());
+    }
+}
+
+void ensureAppThemePropertyCleanupOnQuit()
+{
+    if (g_appThemeCleanupOnQuitInstalled || !qApp)
+        return;
+    g_appThemeCleanupOnQuitInstalled = true;
+    QObject::connect(qApp, &QCoreApplication::aboutToQuit, qApp, []() {
+        clearAppThemePropertiesOnApp();
+        g_appThemePropertyKeys.clear();
+    });
+}
+
+void trackAppThemePropertyKey(const QString &key)
+{
+    if (!g_appThemePropertyKeys.contains(key))
+        g_appThemePropertyKeys.append(key);
+}
