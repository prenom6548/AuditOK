+bool UKUIConfigStyle::isStandaloneLineEdit(const QLineEdit *lineEdit)
+{
+    if (!lineEdit)
+        return false;
+    if (const QWidget *parent = lineEdit->parentWidget()) {
+        if (parent->inherits("QDoubleSpinBox") || parent->inherits("QSpinBox")
+                || parent->inherits("QComboBox") || parent->inherits("QDateTimeEdit")) {
+            return false;
+        }
+    }
+    return true;
