+void MessageBoxHelper::emitPlatformDialogResult(MessageBox *box)
+{
+    if (!box)
+        return;
+
+    QAbstractButton *const clickedBtn = box->clickedButton();
+    if (!clickedBtn)
+        return;
+
+    switch (box->buttonRole(clickedBtn)) {
+    case QMessageBox::AcceptRole:
+    case QMessageBox::YesRole:
+        Q_EMIT accept();
+        break;
+    case QMessageBox::RejectRole:
+    case QMessageBox::NoRole:
+        Q_EMIT reject();
+        break;
+    default:
+        break;
+    }
+}
