+UKUIPopupWindowHandle::~UKUIPopupWindowHandle()
+{
+    if(m_windowHelper){
+        m_windowHelper->deleteLater();
+        m_windowHelper = nullptr;
+    }
+    if (m_wlcomDBus) {
+        delete m_wlcomDBus;
+        m_wlcomDBus = nullptr;
+    }
