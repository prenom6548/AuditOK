 using namespace UKUIFileDialog;
 
+namespace {
+
+// bug#588069: 文件名/目录名中的字面量 %12 不能被当成 URI 转义序列解码为控制字符。
+QByteArray safePercentDecodeUtf8Path(const QByteArray &rawPath)
+{
+    QByteArray safePath;
+    safePath.reserve(rawPath.size());
+    for (int i = 0; i < rawPath.size(); ++i) {
+        if (rawPath[i] == '%' && i + 2 < rawPath.size()
+                && isxdigit(static_cast<unsigned char>(rawPath[i + 1]))
+                && isxdigit(static_cast<unsigned char>(rawPath[i + 2]))) {
+            const QByteArray hex = rawPath.mid(i + 1, 2);
+            bool ok = false;
+            const unsigned char decoded = static_cast<unsigned char>(hex.toInt(&ok, 16));
+            if (ok && decoded > 0x1f && decoded != 0x7f)
+                safePath.append(static_cast<char>(decoded));
+            else
+                safePath.append(rawPath.mid(i, 3));
+            i += 2;
+        } else {
+            safePath.append(rawPath[i]);
+        }
+    }
+    return safePath;
+}
+
+QString localPathFromFileUriOrPath(const QString &uriOrPath)
+{
+    if (!uriOrPath.startsWith(QStringLiteral("file://")))
+        return uriOrPath;
+
+    // 仅有 file:// 而无路径分量（区别于合法的 file:/// 根目录）
+    if (uriOrPath == QStringLiteral("file://"))
+        return QString();
+
+    return QString::fromUtf8(safePercentDecodeUtf8Path(uriOrPath.mid(7).toUtf8()));
+}
+
+QString uriToLocalPath(const QString &uri)
+{
+    if (uri.startsWith(QStringLiteral("file://")))
+        return localPathFromFileUriOrPath(uri);
+    if (uri.startsWith(QLatin1Char('/')))
+        return localPathFromFileUriOrPath(QStringLiteral("file://") + uri);
+    return uri;
+}
+
+QUrl fileUrlFromLocalPath(const QString &localPath)
+{
+    if (localPath.isEmpty())
+        return QUrl();
+
+    // 字面量 % 必须编码为 %25，否则 QUrl::toLocalFile() 会把 %12 误解码为控制字符。
+    const QByteArray encoded = QUrl::toPercentEncoding(localPath.toUtf8(), "/");
+    return QUrl(QStringLiteral("file://") + QString::fromUtf8(encoded));
+}
+
+QString stripTrailingSlash(const QString &dirPath)
+{
+    // 根目录 / 与 file:/// 末尾的 / 不能去掉
+    if (dirPath == QLatin1String("/") || dirPath == QStringLiteral("file:///"))
+        return dirPath;
+
+    QString path = dirPath;
+    while (path.length() > 1 && path.endsWith(QLatin1Char('/')))
+        path.chop(1);
+    return path;
+}
+
+QString appendFileNameToDir(const QString &dirPath, const QString &fileName)
+{
+    if (fileName.isEmpty())
+        return dirPath;
+    if (dirPath.endsWith(QLatin1Char('/')))
+        return dirPath + fileName;
+    return dirPath + QLatin1Char('/') + fileName;
+}
+
+QString joinLocalPath(const QString &dirUriOrPath, const QString &fileName)
+{
+    const QString dirPath = stripTrailingSlash(uriToLocalPath(dirUriOrPath));
+    if (dirPath.isEmpty())
+        return QString();
+    return appendFileNameToDir(dirPath, fileName);
+}
+
+QString joinUriPath(const QString &dirUri, const QString &fileName)
+{
+    if (dirUri.isEmpty() || dirUri == QStringLiteral("file://"))
+        return QString();
+    const QString dir = stripTrailingSlash(dirUri);
+    if (dir.isEmpty() || dir == QStringLiteral("file://"))
+        return QString();
+    return appendFileNameToDir(dir, fileName);
+}
+
