+static int plainTextMaxLineWidth(const QString &text, const QFont &font, Qt::TextFormat format)
+{
+    if (text.isEmpty()) {
+        return 0;
+    }
+    if (format == Qt::RichText || (format == Qt::AutoText && Qt::mightBeRichText(text))) {
+        return 0;
+    }
+    const QFontMetrics fm(font);
+    int maxWidth = 0;
+    for (const QString &line : text.split(QLatin1Char('\n'), Qt::SkipEmptyParts)) {
+        maxWidth = qMax(maxWidth, fm.horizontalAdvance(line));
+    }
+    return maxWidth;
+}
+
+static void applyTextLabelLayout(QLabel *label, const QString &rawText, int contentWrapWidth, int labelMaxWidth, bool forceWrap = false)
+{
+    if (!label) {
+        return;
+    }
+    if (label->textFormat() == Qt::RichText
+            || (label->textFormat() == Qt::AutoText && Qt::mightBeRichText(rawText))) {
+        label->setText(rawText);
+        label->setWordWrap(true);
+        label->setMaximumWidth(labelMaxWidth);
+        return;
+    }
+    const int maxLineWidth = plainTextMaxLineWidth(rawText, label->font(), label->textFormat());
+    if (!forceWrap && maxLineWidth <= contentWrapWidth) {
+        label->setText(rawText);
+        label->setWordWrap(false);
+        label->setMaximumWidth(contentWrapWidth);
+    } else {
+        label->setText(wrapPlainTextForWidth(rawText, label->font(), contentWrapWidth, label->textFormat()));
+        label->setWordWrap(false);
+        label->setMaximumWidth(contentWrapWidth);
+    }
+}
+
+static void updateIconLabelSize(QLabel *iconLabel, const QFont &textFont)
+{
+    if (!iconLabel || !iconLabel->pixmap() || iconLabel->pixmap()->isNull()) {
+        return;
+    }
+    iconLabel->setMinimumSize(0, 0);
+    iconLabel->setMaximumSize(QWIDGETSIZE_MAX, QWIDGETSIZE_MAX);
+
+    const QSize iconSize = iconLabel->sizeHint();
+    const int textLineHeight = QFontMetrics(textFont).height();
+    if (iconSize.height() <= textLineHeight) {
+        // Small icon: grow cell to one text line for alignment, never clip the pixmap.
+        iconLabel->setFixedSize(iconSize.width(), textLineHeight);
+    } else {
+        // Large icon: use natural pixmap size, do not cap to font height.
+        iconLabel->setFixedSize(iconSize);
+    }
+}
