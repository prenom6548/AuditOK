+void KyQuickStyleItem::setHints(const QVariantMap &str)
+{
+    if (m_hints != str) {
+        m_hints = str;
+        initStyleOption();
+        updateSizeHint();
+        if (m_styleoption->state & QStyle::State_Mini) {
+            m_font.setPointSize(9.);
+            emit fontChanged();
+        } else if (m_styleoption->state & QStyle::State_Small) {
+            m_font.setPointSize(11.);
+            emit fontChanged();
+        } else {
+            emit hintChanged();
+        }
+    }
+}
