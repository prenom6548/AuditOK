+    Q_ASSERT(QLatin1String(uri) == QLatin1String("org.ukui.qqc2style.private"));
+
+    // @uri org.ukui.qqc2style.private
+    qmlRegisterType<KyStyleHelper>(uri, 1, 0, "StyleHelper");
+    qmlRegisterType<KyIcon>(uri, 1, 0, "KyIcon");
