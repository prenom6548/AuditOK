+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Layouts 1.15
+import QtQuick.Window 2.12
+import org.ukui.platformtheme.controls 1.0 as UkuiPrivate
+import org.ukui.qqc2style.private 1.0
+
+UkuiPrivate.KDialog {
+    id: root
+
+    readonly property int appIconLogicalSize: 96
+    readonly property real _iconDpr: (screen && screen.devicePixelRatio > 0) ? screen.devicePixelRatio : 1.0
+    readonly property int _iconSourcePixels: Math.min(512, Math.max(appIconLogicalSize, Math.round(appIconLogicalSize * _iconDpr)))
+
+    /// Theme icon name (QIcon::name); refreshed when icon theme changes
+    property string appIconId: ""
+    property string appName: ""
+    property string appVersion: ""
+    /// Optional file / qrc icon; when set, used before theme
+    property url appIconUrl: ""
+    /// kdk::KAboutDialog::bodyText — long description (widgets often keep hidden)
+    property string bodyText: ""
+    property bool bodyTextVisible: false
+    /// kdk::setAppSupport — plain or rich text; empty uses default Service & Support mailto line
+    property string appSupport: ""
+    /// When false, hide support row (e.g. openKylin in widget code)
+    property bool supportSectionVisible: true
+    property string supportEmail: "support@kylinos.cn"
+    /// kdk::setAppPrivacyLabelVisible
+    property bool privacyVisible: false
+    /// Match kdk::ConvertFirstLetterCase on appName
+    property bool capitalizeAppName: true
+
+    readonly property string _titleText: capitalizeAppName ? _convertFirstLetterCase(appName) : appName
+
+    readonly property string _appIconSource: {
+        if (appIconUrl.toString().length > 0)
+            return appIconUrl.toString()
+        var id = appIconId.length ? appIconId : appName
+        if (id.length > 0)
+            return "image://imageProvider/" + id + "/" + (root.active ? "normal" : "disenable")
+        return ""
+    }
+
+    /// 与 QLabel::linkActivated(url) 一致：点击富文本链接时传入 &lt;a href="..."&gt; 里的字符串（如 mailto:xxx）。
+    signal supportLinkActivated(string link)
+    signal privacyClicked()
+
+    /// 旧 widget 曾用 mailto://addr，规范成 mailto:addr 便于 QDesktopServices::openUrl
+    function _normalizeSupportHref(href) {
+        if (!href || href.length === 0)
+            return href
+        if (href.indexOf("mailto://") === 0)
+            return "mailto:" + href.substring("mailto://".length)
+        return href
+    }
+
+    /// KyQuickDialog.openSupportLink：检查默认邮件应用，与 kaboutdialog.cpp 一致。
+    function handleSupportLinkActivated(href) {
+        var u = _normalizeSupportHref(href)
+        root.kyQuickDialog.openSupportLink(u)
+        supportLinkActivated(u)
+    }
+
+    function _convertFirstLetterCase(input) {
+        if (!input || !input.length)
+            return ""
+        var sep = input.indexOf("-") >= 0 ? "-" : " "
+        var parts = input.split(sep)
+        var out = []
+        for (var i = 0; i < parts.length; i++) {
+            var w = parts[i]
+            if (!w.length)
+                continue
+            out.push(w.charAt(0).toUpperCase() + w.slice(1))
+        }
+        return out.join(sep)
+    }
+
+    minimumWidth: 450
+    maximumWidth: 450
+    width: 450
+    /// ApplicationWindow.height 是整窗高度；contentItem 在 header 下方，高度约为 height - header.height。
+    /// 只设 content 高度而不加标题栏时，客户区会被少算一截，正文会被裁切。
+    readonly property int _titleBarH: header ? header.height : 40
+    readonly property real _bodyH: contentColumn.implicitHeight
+    height: _titleBarH + _bodyH
+    minimumHeight: _titleBarH + _bodyH
+    // 勿与 height 同值锁死 maximum：privacyVisible 等变为 true 时 implicit 变高，
+    // 部分环境下 maximum 更新滞后会导致客户区高度不够，底部（含隐私行）被裁掉。
+    maximumHeight: _titleBarH + _bodyH + 800
+    modality: Qt.ApplicationModal
+    title: qsTr("About")
+    property string titleIcon: appIconId.length ? appIconId : appName
+
+    Component.onCompleted: {
+        minButton.visible = false
+        maxButton.visible = false
+        menuButton.visible = false
+    }
+
+    APPParameter {
+        id: styleParam
+        onParametryChanged: {
+            appIconImage.source = ""
+            appIconImage.source = root._appIconSource
+        }
+        onIconThemeChanged: {
+            appIconImage.source = ""
+            appIconImage.source = root._appIconSource
+        }
+    }
+
+    Item {
+        id: aboutBody
+        z: 100
+        anchors.top: parent.top
+        anchors.left: parent.left
+        anchors.right: parent.right
+        width: parent.width
+        implicitHeight: contentColumn.implicitHeight
+        height: contentColumn.implicitHeight
+
+        ColumnLayout {
+            id: contentColumn
+            width: parent.width - 50
+            anchors.horizontalCenter: parent.horizontalCenter
+            spacing: 0
+
+            Item {
+                Layout.fillWidth: true
+                Layout.preferredHeight: 20
+            }
+
+            Image {
+                id: appIconImage
+                Layout.alignment: Qt.AlignHCenter
+                Layout.preferredWidth: root.appIconLogicalSize
+                Layout.preferredHeight: root.appIconLogicalSize
+                fillMode: Image.PreserveAspectFit
+                smooth: true
+                mipmap: true
+                sourceSize.width: root._iconSourcePixels
+                sourceSize.height: root._iconSourcePixels
+                source: root._appIconSource
+            }
+
+            Item {
+                Layout.fillWidth: true
+                Layout.preferredHeight: 24
+            }
+
+            Label {
+                id: appNameLabel
+                Layout.alignment: Qt.AlignHCenter
+                Layout.maximumWidth: 400
+                Layout.fillWidth: true
+                horizontalAlignment: Text.AlignHCenter
+                wrapMode: Text.WordWrap
+                text: root._titleText
+                font.pixelSize: Math.max(8, styleParam.font.pointSize * 1.7)
+                font.weight: Font.Medium
+                property string labelDTColor: "kfont-primary"
+            }
+
+            Item {
+                Layout.fillWidth: true
+                Layout.preferredHeight: 16
+            }
+
+            Label {
+                id: appVersionLabel
+                visible: root.appVersion.length > 0
+                Layout.alignment: Qt.AlignHCenter
+                Layout.maximumWidth: 400
+                Layout.fillWidth: true
+                horizontalAlignment: Text.AlignHCenter
+                wrapMode: Text.WordWrap
+                text: root.appVersion
+                property string labelDTColor: "kfont-secondary"
+
+            }
+
+            Item {
+                Layout.fillWidth: true
+                Layout.preferredHeight: 16
+                visible: appVersionLabel.visible
+            }
+
+            // 行宽须随内容收缩（短邮箱不要用满 400px），否则 horizontalCenter 只是把一条「满宽左对齐」的条居中，看起来仍不居中
+            Item {
+                id: supportOuter
+                visible: root.supportSectionVisible && root.appSupport.length === 0
+                Layout.fillWidth: true
+                implicitHeight: supportRow.implicitHeight
+
+                readonly property real _lineCap: width > 0 ? Math.min(400, width) : 400
+
+                RowLayout {
+                    id: supportRow
+                    anchors.horizontalCenter: parent.horizontalCenter
+                    spacing: 0
+
+                    Label {
+                        id: supportBlock
+                        Layout.alignment: Qt.AlignVCenter
+                        wrapMode: Text.NoWrap
+                        text: qsTr("Service & Support: ")
+                        property string labelDTColor: "kfont-secondary"
+                    }
+
+                    Item {
+                        id: emailWrap
+                        Layout.alignment: Qt.AlignVCenter
+                        readonly property real _emailColW: Math.min(
+                            supportBlockEmail.implicitWidth,
+                            Math.max(0, supportOuter._lineCap - supportBlock.implicitWidth - supportRow.spacing))
+                        Layout.preferredWidth: _emailColW
+                        Layout.preferredHeight: supportBlockEmail.contentHeight
+
+                        Text {
+                            id: supportBlockEmail
+                            width: parent.width
+                            wrapMode: Text.WordWrap
+                            textFormat: Text.RichText
+                            linkColor: palette.highlight
+                            font: supportBlock.font
+                            text: "<a href=\"mailto:" + root.supportEmail + "\">" + root.supportEmail + "</a>"
+                            onLinkActivated: function (link) {
+                                root.handleSupportLinkActivated(link)
+                            }
+                        }
+
+                        MouseArea {
+                            anchors.fill: supportBlockEmail
+                            hoverEnabled: true
+                            acceptedButtons: Qt.LeftButton
+                            cursorShape: containsMouse ? Qt.PointingHandCursor : Qt.ArrowCursor
+                            onPressed: function (mouse) {
+                                mouse.accepted = false
+                            }
+                        }
+                    }
+                }
+            }
+
+            Label {
+                id: supportCustom
+                visible: root.supportSectionVisible && root.appSupport.length > 0
+                Layout.alignment: Qt.AlignHCenter
+                Layout.maximumWidth: 400
+                Layout.fillWidth: true
+                Layout.preferredHeight: contentHeight
+                horizontalAlignment: Text.AlignHCenter
+                wrapMode: Text.WordWrap
+                textFormat: Text.RichText
+                linkColor: palette.highlight
+//                color: palette.windowText
+                text: root.appSupport
+                onLinkActivated: function (link) { root.handleSupportLinkActivated(link) }
+                property string labelDTColor: "kfont-secondary"
+
+            }
+
+            Loader {
+                id: privacyLoader
+                Layout.fillWidth: true
+                Layout.preferredHeight: item ? item.implicitHeight : 0
+                active: root.privacyVisible
+                sourceComponent: Column {
+                    width: contentColumn.width
+                    spacing: 0
+                    Item { width: parent.width; height: 16 }
+                    Label {
+                        id: privacyText
+                        width: parent.width
+                        height: contentHeight
+                        horizontalAlignment: Text.AlignHCenter
+                        text: qsTr("Privacy statement")
+                        font.family: styleParam.font.family
+                        font.pixelSize: Math.max(9, styleParam.font.pixelSize > 0
+                            ? styleParam.font.pixelSize
+                            : Math.round(styleParam.font.pointSize > 0 ? styleParam.font.pointSize * (4.0 / 3.0) : 12))
+                        font.bold: styleParam.font.bold
+                        font.italic: styleParam.font.italic
+//                        font.underline: true
+                        color: palette.highlight
+                        wrapMode: Text.NoWrap
+                        property string labelDTColor: "kfont-secondary"
+
+//                        property string labelDTColor: "highlight-active"
+
+                        MouseArea {
+                            anchors.fill: parent
+                            z: 1
+                            cursorShape: Qt.PointingHandCursor
+                            acceptedButtons: Qt.LeftButton
+                            hoverEnabled: true
+                            onClicked: root.kyQuickDialog.privacyClicked()
+                        }
+                    }
+                }
+            }
+
+            Item {
+                Layout.fillWidth: true
+                Layout.preferredHeight: 16
+                visible: root.bodyTextVisible && root.bodyText.length > 0
+            }
+
+            ScrollView {
+                id: bodyScroll
+                visible: root.bodyTextVisible && root.bodyText.length > 0
+                Layout.fillWidth: true
+                Layout.preferredHeight: 120
+                clip: true
+                Label {
+                    width: contentColumn.width
+                    wrapMode: Text.WordWrap
+                    text: root.bodyText
+                    color: palette.windowText
+                }
+            }
+
+            Item {
+                Layout.fillWidth: true
+                Layout.preferredHeight: 35
+            }
+        }
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KBadge.qml b/ukui-qml-style-helper/controls/qml/KBadge.qml
new file mode 100644
index 0000000..16f8774
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KBadge.qml
@@ -0,0 +1,119 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KBadge.
+ * 消息提醒气泡。value<1 或不可见 → 10x10 圆点；1~999 → 数字胶囊；>=1000 → "999"宽胶囊 + 三点。
+ * 背景：默认 highlight-active；useErrorColor=true → kerror-normal；useCustomColor → 自定义色。
+ * 颜色随主题变化（getDtColor 不跟主题，靠 _refreshColors 在主题切换时重算）。
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+Item {
+    id: control
+
+    property int value: -1
+    property bool valueVisiable: true
+    property color color: "transparent" // 自定义色，仅 useCustomColor 时生效
+    property bool useCustomColor: false
+    property bool useErrorColor: false // 背景 kerror-normal（错误态）
+    property int fontSize: 14
+
+    implicitWidth: 40
+    implicitHeight: 30
+
+    StylePrivate.APPParameter { id: app }
+    StylePrivate.ParseColorInterface { id: parseColor }
+
+    readonly property bool _showDots: value >= 1000 && valueVisiable
+    readonly property bool _showNumber: value >= 1 && value < 1000 && valueVisiable
+    readonly property bool _showDot: value < 1 || !valueVisiable
+
+    // 字体度量对齐 QFontMetrics：height = ascent + descent + 1（QML 的 fm.height 少了 +1）
+    FontMetrics {
+        id: fm
+        font.pixelSize: control.fontSize
+    }
+    readonly property int _fmHeight: fm.ascent + fm.descent + 1
+
+    function _badgeWidth() {
+        if (_showDot)
+            return 10
+        var text = _showDots ? "999" : (value >= 0 ? String(value) : "")
+        return Math.max(fm.advanceWidth(text) + 10, _fmHeight) // 对齐 cpp: max(width, height)
+    }
+    function _badgeHeight() {
+        if (_showDot)
+            return 10
+        return _fmHeight
+    }
+
+    // 配色（随主题刷新）：优先自定义色，其次 kerror-normal，默认 highlight-active；文字 light-active
+    property color _bgColor: "transparent"
+    property color _textColor: "transparent"
+    function _refreshColors() {
+        _textColor = parseColor.getDtColor("light-active")
+        if (useCustomColor)
+            _bgColor = color
+        else if (useErrorColor)
+            _bgColor = parseColor.getDtColor("kerror-normal")
+        else
+            _bgColor = parseColor.getDtColor("highlight-active")
+    }
+    Component.onCompleted: _refreshColors()
+    onUseCustomColorChanged: _refreshColors()
+    onUseErrorColorChanged: _refreshColors()
+    onColorChanged: _refreshColors()
+    Connections {
+        target: app
+        function onParametryChanged() { control._refreshColors() } // 主题切换刷新配色
+    }
+
+    // 胶囊背景：所有情况都画（cpp:147 drawRoundedRect 无条件执行；>=1000 也有底色胶囊）
+    Rectangle {
+        id: pill
+        anchors.centerIn: parent
+        width: control._badgeWidth()
+        height: control._badgeHeight()
+        radius: height / 2
+        color: control._bgColor
+        antialiasing: true
+
+        // 对齐 cpp drawText(tmpRect, Qt::AlignCenter)：铺满 pill 再对齐，避免 anchors.centerIn 把 descent 空白算进包围盒导致个位数偏上
+        Text {
+            anchors.fill: parent
+            horizontalAlignment: Text.AlignHCenter
+            verticalAlignment: Text.AlignVCenter
+            visible: control._showNumber
+            text: control.value >= 0 ? String(control.value) : ""
+            font.pixelSize: control.fontSize
+            color: control._textColor
+        }
+    }
+
+    // >=1000：三点叠在胶囊上（cpp:159-164 drawEllipse 半径1.5，圆心 center.x ±10 / 0）
+    // Row 三点 3px、spacing 7 → 总宽 23，居中后圆心正好在 -10/0/+10
+    Row {
+        anchors.centerIn: parent
+        visible: control._showDots
+        spacing: 7
+        Repeater {
+            model: 3
+            Rectangle {
+                width: 3
+                height: 3
+                radius: 1.5
+                color: control._textColor
+                antialiasing: true
+            }
+        }
+    }
+
+    function setValue(v) { value = v }
+    function setValueVisiable(flag) { valueVisiable = flag }
+    function setColor(c) { useCustomColor = true; color = c }
+    function setUseErrorColor(flag) { useErrorColor = flag }
+    function setFontSize(s) { if (s >= 1 && s <= 100) fontSize = s }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KBallonTip.qml b/ukui-qml-style-helper/controls/qml/KBallonTip.qml
new file mode 100644
index 0000000..113ec5f
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KBallonTip.qml
@@ -0,0 +1,268 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KBallonTip。
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Layouts 1.15
+import QtQuick.Window 2.12
+import QtQuick.Templates 2.12 as T
+import org.ukui.platformtheme.controls 1.0 as Private
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+// 外层 Popup 负责保持与宿主窗口的关系；实际提示内容在内层 Window 中绘制。
+// 结构与主题 Menu.qml 保持一致，窗口移动时可重新同步全局坐标。
+T.Popup {
+    id: root
+
+    enum TipType { Nothing = 0, Normal = 1, Info = 2, Warning = 3, Error = 4, Variable = 5, Loading = 6 }
+
+    property int tipType: KBallonTip.TipType.Nothing
+    property string text: ""
+    property string variableIconName: ""
+    property int tipTime: 1000
+    property int contentLeftMargin: 24
+    property int contentTopMargin: 18
+    property int contentRightMargin: 24
+    property int contentBottomMargin: 18
+    property bool transparent: false
+    property Item anchorItem: null
+
+    padding: 0
+    margins: 0
+    modal: false
+    focus: false
+    closePolicy: T.Popup.NoAutoClose
+
+    implicitWidth: Math.max(1, contentLeftMargin + (_hasIcon ? 22 + contentRow.spacing : 0)
+                            + textLabel.implicitWidth + contentRightMargin)
+    implicitHeight: Math.max(22, textLabel.implicitHeight)
+                    + contentTopMargin + contentBottomMargin
+    width: implicitWidth
+    height: implicitHeight
+
+    StylePrivate.APPParameter { id: app }
+    StylePrivate.ParseColorInterface { id: parseColor }
+
+    property color _backgroundColor: "transparent"
+    readonly property color _surfaceColor: transparent
+        ? Qt.rgba(_backgroundColor.r, _backgroundColor.g, _backgroundColor.b,
+                  Math.max(0, Math.min(1, app.menuTransparency)))
+        : _backgroundColor
+    readonly property int _radius: {
+        var r = typeof ukui_platformtheme_token !== "undefined" && ukui_platformtheme_token
+                ? ukui_platformtheme_token.kradiusNormal : 6
+        return r < 0 ? 6 : r
+    }
+
+    property int _loadingIndex: 0
+    readonly property string _iconName: {
+        if (tipType === KBallonTip.TipType.Normal)
+            return "ukui-dialog-success"
+        if (tipType === KBallonTip.TipType.Info)
+            return "dialog-info"
+        if (tipType === KBallonTip.TipType.Warning)
+            return "dialog-warning"
+        if (tipType === KBallonTip.TipType.Error)
+            return "dialog-error"
+        if (tipType === KBallonTip.TipType.Variable)
+            return variableIconName
+        if (tipType === KBallonTip.TipType.Loading)
+            return "ukui-loading-" + _loadingIndex + ".symbolic"
+        return ""
+    }
+    readonly property bool _hasIcon: tipType !== KBallonTip.TipType.Nothing
+
+    function _refreshTheme() {
+        _backgroundColor = parseColor.getDtColor("window-active")
+    }
+
+    function _refreshLoading() {
+        if (tipType === KBallonTip.TipType.Loading)
+            loadingTimer.start()
+        else {
+            loadingTimer.stop()
+            _loadingIndex = 0
+        }
+    }
+
+    function _syncWindowGeometry() {
+        if (!popupWindow || !anchorItem)
+            return
+
+        var w = Math.max(1, popupWindow.width)
+        var p = anchorItem.mapToGlobal((anchorItem.width - w) / 2,
+                                       anchorItem.height + 8)
+        var x = Math.round(p.x)
+        var y = Math.round(p.y)
+        if (popupWindow.x !== x)
+            popupWindow.x = x
+        if (popupWindow.y !== y)
+            popupWindow.y = y
+        popupWindow.requestUpdate()
+    }
+
+    function _scheduleWindowSync() {
+        if (visible)
+            Qt.callLater(_syncWindowGeometry)
+    }
+
+    function showInfo(item) {
+        if (item)
+            anchorItem = item
+        _refreshLoading()
+        // 先定位独立窗口，避免首次显示时落在默认的左上角坐标。
+        _syncWindowGeometry()
+        visible = true
+        hideTimer.restart()
+        _scheduleWindowSync()
+    }
+
+    function hide() {
+        visible = false
+        hideTimer.stop()
+        loadingTimer.stop()
+    }
+
+    function setTipType(type) { tipType = type }
+    function setText(value) { text = value }
+    function setTipTime(value) { tipTime = value }
+    function setContentsMargins(left, top, right, bottom) {
+        contentLeftMargin = left
+        contentTopMargin = top
+        contentRightMargin = right
+        contentBottomMargin = bottom
+    }
+    function setVariableIcon(name) { variableIconName = name }
+    function setTransparent(value) { transparent = value }
+    function setAnchorItem(item) { anchorItem = item }
+
+    Component.onCompleted: {
+        _refreshTheme()
+        _refreshLoading()
+    }
+    onTipTypeChanged: _refreshLoading()
+    onVisibleChanged: _scheduleWindowSync()
+    onWidthChanged: _scheduleWindowSync()
+    onHeightChanged: _scheduleWindowSync()
+    onAnchorItemChanged: _scheduleWindowSync()
+
+    Timer {
+        id: hideTimer
+        interval: Math.max(0, root.tipTime)
+        repeat: false
+        onTriggered: root.hide()
+    }
+
+    Timer {
+        id: loadingTimer
+        interval: 100
+        repeat: true
+        onTriggered: root._loadingIndex = (root._loadingIndex + 1) % 8
+    }
+
+    // 外层 Popup 不绘制内容，避免在宿主窗口内出现第二份提示。
+    contentItem: Item {
+        visible: false
+        implicitWidth: 0
+        implicitHeight: 0
+    }
+
+    background: Item {
+        implicitWidth: 0
+        implicitHeight: 0
+
+        Window {
+            id: popupWindow
+            width: Math.max(1, Math.ceil(root.width))
+            height: Math.max(1, Math.ceil(root.height))
+            visible: root.visible
+            color: "transparent"
+            flags: Qt.ToolTip | Qt.FramelessWindowHint
+
+            onWidthChanged: root._scheduleWindowSync()
+            onHeightChanged: root._scheduleWindowSync()
+            onVisibleChanged: {
+                if (visible)
+                    root._scheduleWindowSync()
+            }
+
+            // 平台窗口管理器提供阴影、边框和圆角。
+            Private.UKUIPopupHandle {
+                anchors.fill: parent
+                visible: parent.visible
+                titlebarVisible: false
+                acceptFocus: false
+                windowStaysOnTopHint: true
+                radius: root._radius
+            }
+
+            Rectangle {
+                id: surface
+                anchors.fill: parent
+                // 圆角由 UKUIPopupHandle 的窗口装饰统一处理，避免透明状态下重复抗锯齿。
+                radius: 0
+                color: root._surfaceColor
+            }
+
+            RowLayout {
+                id: contentRow
+                anchors.fill: parent
+                anchors.leftMargin: root.contentLeftMargin
+                anchors.topMargin: root.contentTopMargin
+                anchors.rightMargin: root.contentRightMargin
+                anchors.bottomMargin: root.contentBottomMargin
+                spacing: 12
+
+                Item {
+                    visible: root._hasIcon
+                    Layout.preferredWidth: 22
+                    Layout.minimumWidth: 22
+                    Layout.maximumWidth: 22
+                    Layout.preferredHeight: 22
+                    Layout.alignment: Qt.AlignVCenter
+
+                    Private.KyIcon {
+                        anchors.fill: parent
+                        iconName: root._iconName
+                    }
+                }
+
+                Text {
+                    id: textLabel
+                    Layout.fillWidth: true
+                    Layout.minimumWidth: implicitWidth
+                    Layout.preferredWidth: implicitWidth
+                    Layout.alignment: Qt.AlignVCenter
+                    text: root.text
+                    font: app.font
+                    color: parseColor.getDtColor("kfont-primary")
+                    wrapMode: Text.NoWrap
+                }
+            }
+        }
+    }
+
+    // 锚点自身的布局、滚动或尺寸变化时更新独立窗口位置。
+    Connections {
+        target: root.anchorItem
+        function onXChanged() { root._scheduleWindowSync() }
+        function onYChanged() { root._scheduleWindowSync() }
+        function onWidthChanged() { root._scheduleWindowSync() }
+        function onHeightChanged() { root._scheduleWindowSync() }
+    }
+
+    // 与 Menu.qml 一样，主窗口移动后同步内层 Window 的全局坐标。
+    Connections {
+        target: Window.window
+        function onXChanged() { root._scheduleWindowSync() }
+        function onYChanged() { root._scheduleWindowSync() }
+    }
+
+    Connections {
+        target: app
+        function onParametryChanged() { root._refreshTheme() }
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KBorderButton.qml b/ukui-qml-style-helper/controls/qml/KBorderButton.qml
new file mode 100644
index 0000000..2de2b22
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KBorderButton.qml
@@ -0,0 +1,43 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KBorderButton.
+ * 基于 KBorderlessButton，圆角描边对齐 kborderbutton.cpp。
+ */
+
+import QtQuick 2.12
+import org.ukui.platformtheme.controls 1.0 as Private
+
+Private.KBorderlessButton {
+    id: control
+
+    paletteStyle: Private.KyButton.StyleBorder
+
+    property int borderWidth: 1
+    property int radius: (typeof ukui_platformtheme_token !== "undefined"
+                          && ukui_platformtheme_token
+                          && ukui_platformtheme_token.kradiusNormal > 0)
+                         ? ukui_platformtheme_token.kradiusNormal : 6
+
+    readonly property real _inset: borderWidth
+
+    leftPadding: buttonStyle.leftRightMargin + _inset + 1
+    rightPadding: buttonStyle.leftRightMargin + _inset + 1
+    topPadding: buttonStyle.upDownMargin + _inset + 1
+    bottomPadding: buttonStyle.upDownMargin + _inset + 1
+
+    implicitWidth: Math.max(implicitContentWidth + leftPadding + rightPadding,
+                            buttonStyle.normalWidth)
+    implicitHeight: Math.max(implicitContentHeight + topPadding + bottomPadding,
+                            buttonStyle.normalHeight)
+
+    background: Rectangle {
+        anchors.fill: parent
+        anchors.margins: control._inset
+        radius: Math.max(0, control.radius - control._inset)
+        color: "transparent"
+        border.width: control.borderWidth
+        border.color: buttonPalette.borderColor
+        antialiasing: true
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KBorderlessButton.qml b/ukui-qml-style-helper/controls/qml/KBorderlessButton.qml
new file mode 100644
index 0000000..5d3bff0
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KBorderlessButton.qml
@@ -0,0 +1,189 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KBorderlessButton.
+ * 图标：image://imageProvider/（KyImageProvider）
+ * 颜色：KyButton（C++，GlobalDTConfig）
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Templates 2.12 as T
+import QtQuick.Layouts 1.15
+import QtGraphicalEffects 1.0
+import org.ukui.platformtheme.controls 1.0 as Private
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+T.AbstractButton {
+    id: control
+
+    property int paletteStyle: Private.KyButton.StyleBorderless
+
+    readonly property bool _hasIcon: icon.name !== "" || icon.source.toString() !== ""
+    readonly property int _iconSize: icon.width > 0 ? icon.width
+                                : (icon.height > 0 ? icon.height : 16)
+    readonly property int _gap: (_hasIcon && text !== "") ? btn.space : 0
+
+    hoverEnabled: true
+    focusPolicy: Qt.NoFocus
+
+    font: StylePrivate.APPParameter.font
+
+    property string _toolTipText: ""
+
+    ToolTip{
+        delay: Qt.styleHints.mousePressAndHoldInterval
+        text: _toolTipText
+        visible: hovered && _toolTipText !== ""
+    }
+
+    leftPadding: btn.leftRightMargin
+    rightPadding: btn.leftRightMargin
+    topPadding: btn.upDownMargin
+    bottomPadding: btn.upDownMargin
+
+    StylePrivate.UKUIButton {
+        id: btn
+    }
+
+    property alias buttonStyle: btn
+
+    Private.KyButton {
+        id: btnPalette
+        styleType: control.paletteStyle
+        enabled: control.enabled
+        hovered: control.hovered
+        pressed: control.pressed
+        hasIcon: control._hasIcon
+    }
+
+    property alias buttonPalette: btnPalette
+
+    StylePrivate.APPParameter {
+        id: appParam
+        onParametryChanged: {
+            // 先刷新文字/边框色，再重载图标资源（同 URL 需先清空）
+            btnPalette.refreshPalette()
+            contentItem.updateIconSource()
+        }
+        onIconThemeChanged: contentItem.updateIconSource()
+    }
+
+    background: Item { width: 0; height: 0 }
+
+    implicitWidth: Math.max(implicitContentWidth + leftPadding + rightPadding, 1)
+    implicitHeight: Math.max(implicitContentHeight + topPadding + bottomPadding, 1)
+
+    onTextChanged: contentItem.updateToolTip()
+    onWidthChanged: contentItem.updateToolTip()
+    onIconChanged: contentItem.updateIconSource()
+    // hover/press/enable 只改 contentColor，ColorOverlay 自动跟随，无需重载图标
+
+    contentItem: RowLayout {
+        id: contentRow
+        anchors.fill: parent
+
+        Item { Layout.fillWidth: true }
+
+        RowLayout {
+            id: innerRow
+            spacing: control._gap
+            Layout.alignment: Qt.AlignVCenter
+
+            // 对齐 C++ drawColoredPixmap(pixmap, fontColor)：底图只取图标资源，
+            // 颜色用 ColorOverlay 跟 contentColor（主题/hover/press 随 KyButton 刷新）
+            function updateIconSource() {
+                var s = control.icon.source.toString()
+                if (s === "")
+                    s = control.icon.name
+                if (s === "") {
+                    iconImage.source = ""
+                    return
+                }
+                var prefix = "image://imageProvider/"
+                if (s.indexOf(prefix) === 0) {
+                    var path = s.substring(prefix.length)
+                    var slash = path.lastIndexOf("/")
+                    if (slash >= 0) {
+                        var model = path.substring(slash + 1)
+                        if (model === "normal" || model === "disenable" || model === "clicked"
+                                || model === "hover" || model === "highlight" || model === "highDisbale"
+                                || model === "hoveredWidthThemeColor" || model === "clickedWidthThemeColor"
+                                || model === "normalWidthThemeColor" || model === "disableWidthThemeColor")
+                            path = path.substring(0, slash)
+                    }
+                    s = path
+                }
+                // 同 URL 不重载：先清空再设，保证切主题/图标主题时重新取图
+                var url = prefix + s + "/normal"
+                iconImage.source = ""
+                iconImage.source = url
+            }
+
+            Item {
+                id: iconBox
+                visible: control._hasIcon && iconImage.status === Image.Ready
+                Layout.preferredWidth: visible ? control._iconSize : 0
+                Layout.preferredHeight: visible ? control._iconSize : 0
+                Layout.alignment: Qt.AlignVCenter
+                width: control._iconSize
+                height: control._iconSize
+
+                Image {
+                    id: iconImage
+                    anchors.fill: parent
+                    fillMode: Image.PreserveAspectFit
+                    smooth: true
+                    cache: false
+                    visible: false
+                }
+                ColorOverlay {
+                    anchors.fill: parent
+                    source: iconImage
+                    // 与文字同色，对齐 C++ fontColor 着色
+                    color: btnPalette.contentColor
+                }
+            }
+
+            Text {
+                id: label
+                visible: control.text !== ""
+                text: control.text
+                font: control.font
+                color: btnPalette.contentColor
+                verticalAlignment: Text.AlignVCenter
+                horizontalAlignment: control._hasIcon ? Text.AlignLeft : Text.AlignHCenter
+                elide: Text.ElideRight
+                maximumLineCount: 1
+                wrapMode: Text.NoWrap
+                Layout.alignment: Qt.AlignVCenter
+                Layout.maximumWidth: {
+                    if (control.width <= 0)
+                        return implicitWidth
+                    var available = control.width - control.leftPadding - control.rightPadding
+                    if (iconBox.visible)
+                        available -= control._iconSize + control._gap
+                    return available > 0 ? available : implicitWidth
+                }
+                onImplicitWidthChanged: contentRow.updateToolTip()
+                onWidthChanged: contentRow.updateToolTip()
+                onTruncatedChanged: contentRow.updateToolTip()
+            }
+
+            Component.onCompleted: {
+                updateIconSource()
+                contentRow.updateToolTip()
+            }
+        }
+
+        Item { Layout.fillWidth: true }
+
+        function updateToolTip() {
+            control._toolTipText = (control.text && label.truncated) ? control.text : ""
+        }
+
+        function updateIconSource() {
+            innerRow.updateIconSource()
+        }
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KBreadCrumb.qml b/ukui-qml-style-helper/controls/qml/KBreadCrumb.qml
new file mode 100644
index 0000000..37b06c9
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KBreadCrumb.qml
@@ -0,0 +1,92 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KBreadCrumb。
+ * 使用 KBreadCrumbItem；默认无背景交互（文字高亮），可开 backgroundVisible。
+ */
+
+import QtQuick 2.12
+import QtQuick.Layouts 1.15
+import org.ukui.platformtheme.controls 1.0 as Private
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+RowLayout {
+    id: root
+
+    enum KBreadCrumbType { FlatBreadCrumb = 0, CubeBreadCrumb = 1 }
+
+    property int breadCrumbType: KBreadCrumb.FlatBreadCrumb
+    // 支持 string，或 { text: "...", icon: "dialog-info" }
+    property var tabs: []
+    property int currentIndex: 0
+    property string iconName: ""
+    property bool flat: true
+    property bool backgroundVisible: false
+    property bool translucent: true
+
+    spacing: 8
+    implicitHeight: 36
+
+    StylePrivate.APPParameter {
+        id: app
+        onParametryChanged: root._reloadIcons()
+        onIconThemeChanged: root._reloadIcons()
+    }
+
+    signal currentChanged(int index)
+
+    property int iconRev: 0
+    function _reloadIcons() { iconRev++ }
+
+    function _tabText(item) {
+        if (typeof item === "object" && item !== null) {
+            if (item.text !== undefined)
+                return item.text
+            if (item.title !== undefined)
+                return item.title
+            return ""
+        }
+        return item !== undefined && item !== null ? String(item) : ""
+    }
+
+    function _tabIconName(index, item) {
+        if (typeof item === "object" && item !== null) {
+            var ic = item.icon !== undefined ? item.icon
+                   : (item.iconName !== undefined ? item.iconName : item.iconSource)
+            if (ic !== undefined && ic !== null && String(ic) !== "")
+                return String(ic)
+        }
+        if (index === 0 && root.iconName !== "")
+            return root.iconName
+        return ""
+    }
+
+    Repeater {
+        model: root.tabs
+
+        Private.KBreadCrumbItem {
+            text: root._tabText(modelData)
+            iconName: root._tabIconName(index, modelData)
+            showSeparator: index < root.tabs.length - 1
+            current: index === root.currentIndex
+            flat: root.flat
+            backgroundVisible: root.backgroundVisible
+            translucent: root.translucent
+            separatorInteractive: false
+            expanded: false
+            iconRev: root.iconRev
+            onClicked: {
+                root.currentIndex = index
+                root.currentChanged(index)
+            }
+        }
+    }
+
+    function setIcon(name) { iconName = name }
+    function setFlat(f) {
+        flat = f
+        breadCrumbType = f ? KBreadCrumb.FlatBreadCrumb : KBreadCrumb.CubeBreadCrumb
+    }
+    function setBackgroundVisible(v) { backgroundVisible = v }
+    function setTranslucent(v) { translucent = v }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KBreadCrumbItem.qml b/ukui-qml-style-helper/controls/qml/KBreadCrumbItem.qml
new file mode 100644
index 0000000..1eba93b
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KBreadCrumbItem.qml
@@ -0,0 +1,354 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * 面包屑/目录栏单项外壳，供 KBreadCrumb、KDirTabBar 共用。
+ * 布局：高 36；左 8 + 16x16 图标 + 间距 8 + 文字 + 间距 8 + 30x30 箭头 + 右 8
+ *  - backgroundVisible=false：悬浮/点击 → 文字高亮，无背景
+ *  - backgroundVisible=true：悬浮/点击 → Button 背景，文字不变色
+ *  - separatorInteractive=true：箭头单独发 separatorClicked；图标随 expanded 在 end/down 间切换
+ *  - separatorInteractive=false：箭头点击与正文同属 clicked
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Layouts 1.15
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+Item {
+    id: root
+
+    property string text: ""
+    property string iconName: ""
+    property bool showSeparator: true
+    property bool current: false
+    property bool flat: true
+    property bool backgroundVisible: false
+    property bool translucent: true
+    // true：箭头独立交互（KDirTabBar）；false：整项点击（KBreadCrumb）
+    property bool separatorInteractive: false
+    // 菜单展开时箭头为 ukui-down-symbolic
+    property bool expanded: false
+    property int iconRev: 0
+    // KDirTabBar 对齐 C++（去掉 TabFocus）；KBreadCrumb 保持可 Tab
+    property bool tabFocusEnabled: true
+
+    signal clicked()
+    signal separatorClicked()
+
+    Layout.alignment: Qt.AlignVCenter
+    Layout.preferredHeight: 36
+    Layout.minimumHeight: 36
+    readonly property int _contentWidth: {
+        var w = itemLabel.implicitWidth
+        if (_hasIcon)
+            w += 16 + 8
+        if (showSeparator)
+            w += 30 + 8
+        return w + 16
+    }
+    Layout.preferredWidth: _contentWidth
+    implicitHeight: 36
+    implicitWidth: _contentWidth
+    activeFocusOnTab: tabFocusEnabled
+    focus: false
+
+    StylePrivate.APPParameter { id: app }
+    StylePrivate.UKUIButton { id: btn }
+    StylePrivate.ParseColorInterface { id: parseColor }
+
+    readonly property bool isDark: app.isDark()
+    readonly property bool _hasIcon: iconName !== ""
+    readonly property bool _hovered: hoverArea.containsMouse
+    // 鼠标按下或键盘空格/回车按住时，背景用点击态
+    readonly property bool _pressed: clickArea.pressed || sepBtn.down || _keyPressed
+    property bool _keyPressed: false
+    property bool _mouseFocusing: false
+    property bool _focusEnable: false
+    readonly property bool _showFocusBorder: app.focusEnable && _focusEnable
+
+    readonly property bool _hasToken: typeof ukui_platformtheme_token !== "undefined"
+                                      && ukui_platformtheme_token
+    readonly property int _radius: {
+        if (_hasToken && ukui_platformtheme_token.kradiusNormal > 0)
+            return ukui_platformtheme_token.kradiusNormal
+        return btn.radius > 0 ? btn.radius : 6
+    }
+    readonly property color _highLightColor: _hasToken
+                                             ? ukui_platformtheme_token.highLightActive
+                                             : "#3790FA"
+    readonly property color _focusTextColor: _hasToken
+                                             ? ukui_platformtheme_token.kFontPrimary
+                                             : (isDark ? "#D9D9D9" : "#262626")
+    readonly property color _baseColor: {
+        if (flat)
+            return _focusTextColor
+        if (_hasToken)
+            return isDark ? ukui_platformtheme_token.kGray6
+                          : ukui_platformtheme_token.kGray10
+        return isDark ? "#47474A" : "#B3B3B3"
+    }
+
+    function _resolveIconUrl(name) {
+        if (!name || name === "")
+            return ""
+        var s = String(name)
+        var prefix = "image://imageProvider/"
+        if (s.indexOf(prefix) === 0) {
+            var path = s.substring(prefix.length)
+            var slash = path.lastIndexOf("/")
+            if (slash >= 0) {
+                var model = path.substring(slash + 1)
+                if (model === "normal" || model === "disenable" || model === "clicked"
+                        || model === "hover" || model === "highlight" || model === "highDisbale"
+                        || model === "hoveredWidthThemeColor" || model === "clickedWidthThemeColor"
+                        || model === "normalWidthThemeColor" || model === "disableWidthThemeColor")
+                    path = path.substring(0, slash)
+            }
+            s = path
+        }
+        return prefix + s + "/normalWidthThemeColor"
+    }
+
+    function _bgBrush(hovered, pressed) {
+        if (translucent) {
+            if (pressed)
+                return btn.clickedTransparentBC
+            if (hovered)
+                return btn.hoveredTransparentBC
+            return btn.normalTransparentBC
+        }
+        if (pressed)
+            return btn.clickedBC
+        if (hovered)
+            return btn.hoveredBC
+        return btn.normalBC
+    }
+
+    function _borderBrush(hovered, pressed) {
+        if (translucent) {
+            if (pressed)
+                return btn.clickedBorderTransparentBC
+            if (hovered)
+                return btn.hoveredBorderTransparentBC
+            return btn.normalBorderTransparentBC
+        }
+        if (pressed)
+            return btn.clickBorderColor
+        if (hovered)
+            return btn.hoverBorderColor
+        return btn.normalBorderColor
+    }
+
+    function _bgStart(hovered, pressed) {
+        if (!backgroundVisible || (!hovered && !pressed))
+            return "transparent"
+        return parseColor.startColor(_bgBrush(hovered, pressed))
+    }
+
+    function _bgEnd(hovered, pressed) {
+        if (!backgroundVisible || (!hovered && !pressed))
+            return "transparent"
+        return parseColor.endColor(_bgBrush(hovered, pressed))
+    }
+
+    function _showChrome(hovered, pressed) {
+        return backgroundVisible && (hovered || pressed)
+    }
+
+    function refreshIcons() {
+        itemIcon.source = ""
+        itemIcon.source = _hasIcon ? _resolveIconUrl(iconName) : ""
+        var sepName = expanded ? "ukui-down-symbolic" : "ukui-end-symbolic"
+        sepBtn.icon.name = ""
+        sepBtn.icon.name = sepName
+    }
+
+    onIconNameChanged: refreshIcons()
+    onExpandedChanged: refreshIcons()
+    onIconRevChanged: refreshIcons()
+    Component.onCompleted: refreshIcons()
+
+    onActiveFocusChanged: {
+        if (!activeFocus) {
+            _focusEnable = false
+            _keyPressed = false
+            return
+        }
+        // Tab 走焦：_mouseFocusing 为 false → 显示焦点框
+        // 鼠标点击：_mouseFocusing 为 true → 不显示焦点框
+        _focusEnable = !_mouseFocusing
+        _mouseFocusing = false
+    }
+
+    function _activateByMouse() {
+        _mouseFocusing = true
+        forceActiveFocus()
+        _focusEnable = false
+    }
+
+    // 菜单收起：清掉焦点框并释放焦点，避免 Popup 归还焦点被误判为键盘获焦；
+    // 之后可用 Tab 重新走焦并正常显示焦点样式
+    function dismissFocusChrome() {
+        _focusEnable = false
+        _mouseFocusing = false
+        focus = false
+    }
+
+    Rectangle {
+        id: bg
+        anchors.fill: parent
+        radius: root._radius
+        antialiasing: true
+        color: root._bgStart(root._hovered, root._pressed)
+        border.width: root._showFocusBorder ? btn.focusBorderWidth
+                      : (root._showChrome(root._hovered, root._pressed) ? btn.borderWidth : 0)
+        border.color: root._showFocusBorder
+                      ? parseColor.startColor(btn.focusBorderColor)
+                      : parseColor.startColor(root._borderBrush(root._hovered, root._pressed))
+
+        Rectangle {
+            anchors.fill: parent
+            radius: parent.radius
+            border.width: parent.border.width
+            border.color: parent.border.color
+            visible: root._showChrome(root._hovered, root._pressed)
+                     && !parseColor.isSolidPattern(root._bgBrush(root._hovered, root._pressed))
+            gradient: Gradient {
+                GradientStop {
+                    position: 0.0
+                    color: root._bgStart(root._hovered, root._pressed)
+                }
+                GradientStop {
+                    position: 1.0
+                    color: root._bgEnd(root._hovered, root._pressed)
+                }
+            }
+        }
+    }
+
+    RowLayout {
+        anchors.left: parent.left
+        anchors.right: parent.right
+        anchors.leftMargin: 8
+        anchors.rightMargin: 8
+        anchors.verticalCenter: parent.verticalCenter
+        spacing: 8
+
+        Image {
+            id: itemIcon
+            visible: root._hasIcon && status === Image.Ready
+            sourceSize.width: 16
+            sourceSize.height: 16
+            Layout.preferredWidth: root._hasIcon ? 16 : 0
+            Layout.preferredHeight: 16
+            Layout.alignment: Qt.AlignVCenter
+            fillMode: Image.PreserveAspectFit
+            smooth: true
+            cache: false
+        }
+
+        Text {
+            id: itemLabel
+            text: root.text
+            font: app.font
+            color: (!root.backgroundVisible && root._hovered)
+                   ? root._highLightColor
+                   : (root.current ? root._focusTextColor : root._baseColor)
+            Layout.alignment: Qt.AlignVCenter
+            elide: Text.ElideRight
+        }
+
+        Button {
+            id: sepBtn
+            visible: root.showSeparator
+            flat: true
+            hoverEnabled: false
+            focusPolicy: Qt.NoFocus
+            activeFocusOnTab: false
+            implicitWidth: 30
+            implicitHeight: 30
+            Layout.preferredWidth: root.showSeparator ? 30 : 0
+            Layout.preferredHeight: 30
+            Layout.alignment: Qt.AlignVCenter
+            icon.name: "ukui-end-symbolic"
+            icon.width: 16
+            icon.height: 16
+            background: Rectangle {
+                implicitWidth: 30
+                implicitHeight: 30
+                radius: root._radius
+                color: "transparent"
+            }
+            onPressed: {
+                root._mouseFocusing = true
+                root._focusEnable = false
+            }
+            onClicked: {
+                root._activateByMouse()
+                if (root.separatorInteractive)
+                    root.separatorClicked()
+                else
+                    root.clicked()
+            }
+        }
+    }
+
+    MouseArea {
+        id: clickArea
+        anchors.fill: parent
+        z: -1
+        hoverEnabled: false
+        cursorShape: Qt.PointingHandCursor
+        onPressed: {
+            root._mouseFocusing = true
+            root._focusEnable = false
+        }
+        onClicked: {
+            root._activateByMouse()
+            root.clicked()
+        }
+        onCanceled: root._mouseFocusing = false
+    }
+
+    MouseArea {
+        id: hoverArea
+        anchors.fill: parent
+        z: 100
+        hoverEnabled: true
+        acceptedButtons: Qt.NoButton
+        cursorShape: Qt.PointingHandCursor
+    }
+
+    Keys.onShortcutOverride: {
+        // 防止外层 ScrollView 等抢走空格/回车
+        if (event.key === Qt.Key_Space || event.key === Qt.Key_Return
+                || event.key === Qt.Key_Enter) {
+            event.accepted = true
+        }
+    }
+
+    Keys.onPressed: {
+        if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter
+                || event.key === Qt.Key_Space) {
+            // 按住期间显示与鼠标点击相同的按下背景
+            _keyPressed = true
+            event.accepted = true
+        } else if (event.key === Qt.Key_Down
+                   && root.separatorInteractive && root.showSeparator) {
+            // DirTabBar：↓ 打开子目录菜单
+            root.separatorClicked()
+            event.accepted = true
+        }
+    }
+
+    Keys.onReleased: {
+        if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter
+                || event.key === Qt.Key_Space) {
+            if (_keyPressed) {
+                _keyPressed = false
+                root.clicked()
+            }
+            event.accepted = true
+        }
+    }
+}
\ No newline at end of file
diff --git a/ukui-qml-style-helper/controls/qml/KBubbleWidget.qml b/ukui-qml-style-helper/controls/qml/KBubbleWidget.qml
new file mode 100644
index 0000000..3746c2c
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KBubbleWidget.qml
@@ -0,0 +1,126 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KBubbleWidget.
+ * 带三角形尾部的气泡容器。尾部方向/位置、圆角、透明度、高亮背景色可配。
+ * 背景默认 window-active，highlightBackground 时用 kbrand-normal。
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import org.ukui.qqc2style.private 1.1 as StylePrivate
+
+T.Control {
+    id: control
+
+    enum TailDirection { TopDirection = 0, LeftDirection = 1, BottomDirection = 2, RightDirection = 3, None = 4 }
+    enum TailLocation { LeftLocation = 0, MiddleLocation = 1, RightLocation = 2 }
+
+    property int tailDirection: KBubbleWidget.TailDirection.None
+    property int tailLocation: KBubbleWidget.TailLocation.MiddleLocation
+    property size tailSize: Qt.size(16, 16)
+    property int borderRadius: (typeof ukui_platformtheme_token !== "undefined"
+                                && ukui_platformtheme_token
+                                && ukui_platformtheme_token.kradiusNormal > 0)
+                               ? ukui_platformtheme_token.kradiusNormal : 6
+    property bool enableBlur: false
+    property real bubbleOpacity: 1.0
+    property bool highlightBackground: false
+    property alias contentItem: contentHost.sourceComponent
+    property Component content
+
+    font: app.font
+    palette: app.palette
+
+    implicitWidth: 200
+    implicitHeight: 80
+
+    StylePrivate.APPParameter { id: app }
+    StylePrivate.ParseColorInterface { id: parseColor }
+
+    readonly property color _bgColor: highlightBackground
+            ? parseColor.getDtColor("kbrand-normal")
+            : parseColor.getDtColor("window-active")
+
+    background: Item {
+        anchors.fill: parent
+        opacity: control.bubbleOpacity
+
+        // 尾部三角形
+        Canvas {
+            id: tail
+            anchors.fill: parent
+            onPaint: {
+                var ctx = getContext("2d")
+                ctx.reset()
+                ctx.fillStyle = control._bgColor
+                var w = control.tailSize.width
+                var h = control.tailSize.height
+                var W = width, H = height
+                ctx.beginPath()
+                if (control.tailDirection === KBubbleWidget.TailDirection.TopDirection) {
+                    var x = control.tailLocation === KBubbleWidget.TailLocation.LeftLocation ? w
+                            : control.tailLocation === KBubbleWidget.TailLocation.RightLocation ? W - 2 * w
+                            : W / 2 - w / 2
+                    ctx.moveTo(x, h)
+                    ctx.lineTo(x + w / 2, 0)
+                    ctx.lineTo(x + w, h)
+                } else if (control.tailDirection === KBubbleWidget.TailDirection.BottomDirection) {
+                    var xb = control.tailLocation === KBubbleWidget.TailLocation.LeftLocation ? w
+                            : control.tailLocation === KBubbleWidget.TailLocation.RightLocation ? W - 2 * w
+                            : W / 2 - w / 2
+                    ctx.moveTo(xb, H - h)
+                    ctx.lineTo(xb + w / 2, H)
+                    ctx.lineTo(xb + w, H - h)
+                } else if (control.tailDirection === KBubbleWidget.TailDirection.LeftDirection) {
+                    var y = control.tailLocation === KBubbleWidget.TailLocation.LeftLocation ? h
+                            : control.tailLocation === KBubbleWidget.TailLocation.RightLocation ? H - 2 * h
+                            : H / 2 - h / 2
+                    ctx.moveTo(h, y)
+                    ctx.lineTo(0, y + h / 2)
+                    ctx.lineTo(h, y + h)
+                } else if (control.tailDirection === KBubbleWidget.TailDirection.RightDirection) {
+                    var yr = control.tailLocation === KBubbleWidget.TailLocation.LeftLocation ? h
+                            : control.tailLocation === KBubbleWidget.TailLocation.RightLocation ? H - 2 * h
+                            : H / 2 - h / 2
+                    ctx.moveTo(W - h, yr)
+                    ctx.lineTo(W, yr + h / 2)
+                    ctx.lineTo(W - h, yr + h)
+                }
+                ctx.closePath()
+                ctx.fill()
+            }
+            visible: control.tailDirection !== KBubbleWidget.TailDirection.None
+        }
+
+        Rectangle {
+            anchors.fill: parent
+            anchors.margins: control.tailDirection !== KBubbleWidget.TailDirection.None ? control.tailSize.height / 2 : 0
+            radius: control.borderRadius
+            color: control._bgColor
+            border.width: 1
+            border.color: parseColor.getDtColor("kline-window-inactive")
+            antialiasing: true
+            opacity: control.bubbleOpacity
+        }
+    }
+
+    onTailDirectionChanged: tail.requestPaint()
+    onTailLocationChanged: tail.requestPaint()
+    onHighlightBackgroundChanged: tail.requestPaint()
+
+    contentItem: Item {
+        id: contentHost
+        anchors.fill: parent
+        anchors.margins: control.tailDirection !== KBubbleWidget.TailDirection.None ? control.tailSize.height / 2 + 4 : 4
+        property Component sourceComponent: control.content
+        Loader { sourceComponent: contentHost.sourceComponent }
+    }
+
+    function setTailSize(s) { tailSize = s }
+    function setTailPosition(dir, loc) { tailDirection = dir; tailLocation = loc }
+    function setBorderRadius(r) { borderRadius = r }
+    function setEnableBlur(flag) { enableBlur = flag }
+    function setOpacity(o) { bubbleOpacity = o }
+    function setHighlightBackground(flag) { highlightBackground = flag }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KButtonBox.qml b/ukui-qml-style-helper/controls/qml/KButtonBox.qml
new file mode 100644
index 0000000..8ee1bc1
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KButtonBox.qml
@@ -0,0 +1,293 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KButtonBox.
+ * 按钮容器：水平/垂直、无缝拼接成圆角胶囊、互斥、阴影、id 体系。
+ * 子项可为 Component（Loader 新建）或已存在的按钮 Item 实例。
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Layouts 1.15
+import QtQuick.Templates 2.12 as T
+import QtGraphicalEffects 1.0
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+T.Control {
+    id: control
+
+    property int orientation: Qt.Horizontal
+    property int borderRadius: (typeof ukui_platformtheme_token !== "undefined"
+                                && ukui_platformtheme_token
+                                && ukui_platformtheme_token.kradiusNormal > 0)
+                               ? ukui_platformtheme_token.kradiusNormal : 6
+    property bool exclusive: false
+    property bool checkable: false
+    property bool shadowEnabled: false
+    property bool showDividers: true // 按钮间分割线画在按钮自身边缘（无间隙）：N 个按钮 → N-1 条
+    property var buttons: []
+    property var _ids: [] // index -> id，默认 id = index（对齐 QButtonGroup addButton(btn,i)）
+
+    font: app.font
+    palette: app.palette
+
+    // 对齐 C++：SetFixedSize，尺寸随内容；首尾两角各圆 borderRadius
+    implicitWidth: orientation === Qt.Horizontal ? row.implicitWidth
+                                                    : Math.max(row.implicitWidth, 36)
+    implicitHeight: orientation === Qt.Horizontal ? Math.max(row.implicitHeight, 36)
+                                                    : col.implicitHeight
+
+    signal buttonClicked(var button)
+    signal buttonPressed(var button)
+    signal buttonReleased(var button)
+    signal buttonToggled(var button, bool toggled)
+
+    StylePrivate.APPParameter { id: app }
+    StylePrivate.ParseColorInterface { id: parseColor }
+
+    // 子按钮共享 delegate：挂信号；圆角由 updateBorderRadius 按位置逐角设到按钮自身
+    // （对齐 C++ updateBorderRadius：圆角在按钮自身，焦点框跟着按钮走，不被容器裁剪）
+    Component {
+        id: buttonDelegate
+        Loader {
+            id: btnLoader
+            sourceComponent: modelData
+            Layout.alignment: control.orientation === Qt.Horizontal ? Qt.AlignVCenter : Qt.AlignHCenter
+            Layout.fillWidth: control.orientation === Qt.Vertical
+            Layout.fillHeight: control.orientation === Qt.Horizontal
+            onLoaded: control._onItemLoaded(btnLoader.item)
+            // 用 Connections 的 onPressed/onReleased 等（QML 信号处理器）避免
+            // item.pressed 是 bool 属性、与 pressed() 信号同名导致 .connect 失败
+            Connections {
+                target: btnLoader.item
+                ignoreUnknownSignals: true
+                function onClicked() { control._onClicked(btnLoader.item) }
+                function onPressed() { control.buttonPressed(btnLoader.item) }
+                function onReleased() { control.buttonReleased(btnLoader.item) }
+                function onToggled(checked) { control._onToggled(btnLoader.item, checked) }
+            }
+        }
+    }
+
+    background: Item {}
+
+    contentItem: Item {
+        id: shadowRoot
+        anchors.fill: parent
+
+        // 阴影（对齐 C++ QGraphicsDropShadowEffect offset(0,2) blurRadius4 alpha0.1），不裁剪子按钮
+        layer.enabled: control.shadowEnabled
+        layer.effect: DropShadow {
+            verticalOffset: 2
+            horizontalOffset: 0
+            radius: 4
+            samples: 9
+            color: app.isDark ? Qt.rgba(1, 1, 1, 0.1) : Qt.rgba(0, 0, 0, 0.1)
+            transparentBorder: true
+        }
+
+        RowLayout {
+            id: row
+            visible: control.orientation === Qt.Horizontal
+            anchors.fill: parent
+            spacing: 0 // 对齐 C++ setSpacing(0)，按钮紧贴
+            Repeater {
+                id: rowRepeater
+                model: control.orientation === Qt.Horizontal ? control.buttons : []
+                delegate: buttonDelegate
+            }
+        }
+
+        ColumnLayout {
+            id: col
+            visible: control.orientation === Qt.Vertical
+            anchors.fill: parent
+            spacing: 0
+            Repeater {
+                id: colRepeater
+                model: control.orientation === Qt.Vertical ? control.buttons : []
+                delegate: buttonDelegate
+            }
+        }
+    }
+
+    function _activeRepeater() {
+        return orientation === Qt.Horizontal ? rowRepeater : colRepeater
+    }
+
+    function _allItems() {
+        var rep = _activeRepeater()
+        var arr = []
+        for (var i = 0; i < rep.count; i++) {
+            var ld = rep.itemAt(i)
+            if (ld && ld.item)
+                arr.push(ld.item)
+        }
+        return arr
+    }
+
+    function _itemAt(i) {
+        var ld = _activeRepeater().itemAt(i)
+        return ld && ld.item ? ld.item : null
+    }
+
+    function _indexOfItem(btn) {
+        return _allItems().indexOf(btn)
+    }
+
+    function _idAt(i) {
+        return (_ids.length > i && _ids[i] !== undefined) ? _ids[i] : i
+    }
+
+    // 给单个子按钮设四角半径：优先 setBorderRadius(bl,tl,tr,br)（KPushButton），
+    // 回退 radius 单值（RoundButton 等，无法逐角只能近似）
+    function _setChildRadius(btn, bl, tl, tr, br) {
+        if (!btn)
+            return
+        if (typeof btn.setBorderRadius === "function")
+            btn.setBorderRadius(bl, tl, tr, br)
+        else if ('radius' in btn)
+            btn.radius = Math.max(bl, tl, tr, br)
+    }
+
+    // 给子按钮设分割线（画在按钮自身边缘，无间隙）：
+    // 水平 box → 非末按钮画右边竖线 dividerRight；垂直 box → 非末按钮画底边横线 dividerBottom
+    function _setChildDivider(btn, on) {
+        if (!btn)
+            return
+        if ('dividerRight' in btn)
+            btn.dividerRight = (control.orientation === Qt.Horizontal) && on
+        if ('dividerBottom' in btn)
+            btn.dividerBottom = (control.orientation === Qt.Vertical) && on
+    }
+
+    // 对齐 C++ updateBorderRadius（kbuttonbox.cpp:91-132）：按按钮位置/方向给每个按钮设四角
+    // 并按 showDividers 给非末按钮设分割线（N 个按钮 → N-1 条，画在按钮上无缝）
+    function updateBorderRadius() {
+        var rep = _activeRepeater()
+        var n = rep.count
+        var r = borderRadius
+        for (var i = 0; i < n; i++) {
+            var it = _itemAt(i)
+            if (!it)
+                continue
+            var bl, tl, tr, br
+            if (it.flat) { // flat 按钮：四角都圆（独立圆角按钮，不拼胶囊）
+                bl = tl = tr = br = r
+            } else if (i === 0) { // 首按钮
+                if (orientation === Qt.Horizontal) { bl = r; tl = r; tr = 0; br = 0 }
+                else { bl = 0; tl = r; tr = r; br = 0 }
+            } else if (i === n - 1) { // 尾按钮
+                if (orientation === Qt.Horizontal) { bl = 0; tl = 0; tr = r; br = r }
+                else { bl = r; tl = 0; tr = 0; br = r }
+            } else { // 中间
+                bl = 0; tl = 0; tr = 0; br = 0
+            }
+            _setChildRadius(it, bl, tl, tr, br)
+            _setChildDivider(it, control.showDividers && i < n - 1)
+        }
+    }
+
+    function _onItemLoaded(item) {
+        if (!item)
+            return
+        // 仅按钮有 checkable；分割线等非按钮子项跳过
+        if ('checkable' in item)
+            item.checkable = Qt.binding(function () { return control.checkable })
+        control.updateBorderRadius() // 子项就绪后重算四角（位置可能变）
+    }
+
+    onBorderRadiusChanged: updateBorderRadius()
+    onOrientationChanged: updateBorderRadius()
+    onShowDividersChanged: updateBorderRadius()
+
+    function _onClicked(btn) {
+        if (exclusive && checkable) {
+            var arr = _allItems()
+            for (var i = 0; i < arr.length; i++)
+                if (arr[i] !== btn && arr[i].checked)
+                    arr[i].checked = false
+        }
+        buttonClicked(btn)
+    }
+
+    // 互斥：编程式 setChecked 也会触发 toggled，从而联动取消其它（对齐 QButtonGroup exclusive）
+    function _onToggled(btn, checked) {
+        if (exclusive && checkable && checked) {
+            var arr = _allItems()
+            for (var i = 0; i < arr.length; i++)
+                if (arr[i] !== btn && arr[i].checked)
+                    arr[i].checked = false
+        }
+        buttonToggled(btn, checked)
+    }
+
+    onExclusiveChanged: update() // 状态记录，无额外动作
+
+    function setOrientation(o) { orientation = o }
+    function addButton(btnComponent, index) {
+        var arr = buttons
+        if (index === undefined || index < 0 || index >= arr.length)
+            arr.push(btnComponent)
+        else
+            arr.splice(index, 0, btnComponent)
+        buttons = arr
+    }
+    function setButtonList(list) { buttons = list }
+    function removeButton(indexOrButton) {
+        var arr = buttons
+        var idx = -1
+        if (typeof indexOrButton === "number")
+            idx = indexOrButton
+        else {
+            // 先按 Component 匹配（addButton 传入的），否则按已加载 Item 实例定位其 index
+            idx = _indexOfButtonComponent(indexOrButton)
+            if (idx < 0)
+                idx = _indexOfItem(indexOrButton)
+        }
+        if (idx >= 0 && idx < arr.length)
+            arr.splice(idx, 1)
+        buttons = arr
+    }
+    function _indexOfButtonComponent(comp) {
+        for (var i = 0; i < buttons.length; i++)
+            if (buttons[i] === comp)
+                return i
+        return -1
+    }
+    function buttonList() { return _allItems() }
+    function setBorderRadius(r) { borderRadius = r }
+    function setExclusive(flag) { exclusive = flag }
+    function setCheckable(flag) { checkable = flag }
+    function setShadow(flag) { shadowEnabled = flag }
+
+    // id 体系（对齐 C++ setId/id/button(int)/checkedButton/checkedId）
+    function setId(button, id) {
+        var i = _indexOfItem(button)
+        if (i < 0)
+            return
+        _ids[i] = id
+    }
+    function id(button) {
+        var i = _indexOfItem(button)
+        return i < 0 ? -1 : _idAt(i)
+    }
+    function button(btnId) {
+        var rep = _activeRepeater()
+        for (var i = 0; i < rep.count; i++)
+            if (_idAt(i) === btnId)
+                return _itemAt(i)
+        return null
+    }
+    function checkedButton() {
+        var arr = _allItems()
+        for (var i = 0; i < arr.length; i++)
+            if (arr[i].checked)
+                return arr[i]
+        return null
+    }
+    function checkedId() {
+        var btn = checkedButton()
+        return btn ? id(btn) : -1
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KColorButton.qml b/ukui-qml-style-helper/controls/qml/KColorButton.qml
new file mode 100644
index 0000000..8371ba3
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KColorButton.qml
@@ -0,0 +1,171 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KColorButton.
+ * 三种样式 Circle/RoundedRect/CheckedRect，hover/checked 时绘制白色外圈或对勾。
+ * 颜色对齐 kcolorbutton.cpp：默认 highlight-active，禁用 buttontext-disable。
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Templates 2.12 as T
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+T.AbstractButton {
+    id: control
+
+    enum ButtonType { Circle = 0, RoundedRect = 1, CheckedRect = 2 }
+
+    property int buttonType: KColorButton.ButtonType.RoundedRect
+    property var backgroundColor: "transparent" // var：兼容 Qt::GlobalColor(int)/字符串/QColor
+    property bool useCustomColor: false
+    property int borderRadius: 6
+    property color _fillColor: getDtColor("highlight-active")
+
+    checkable: true
+    hoverEnabled: true
+    focusPolicy: Qt.NoFocus
+
+    implicitWidth: buttonType === KColorButton.ButtonType.Circle ? 20 : 24
+    implicitHeight: buttonType === KColorButton.ButtonType.Circle ? 20 : 24
+
+    StylePrivate.APPParameter { id: app }
+    StylePrivate.ParseColorInterface { id: parseColor }
+
+    Connections {
+        target: app
+        function onParametryChanged() {
+            updateFillColor()
+            updateBorderRadius()
+        }
+        function onIsDarkChanged() {
+            updateFillColor()
+        }
+    }
+
+    onEnabledChanged: updateFillColor()
+    onUseCustomColorChanged: updateFillColor()
+    onBackgroundColorChanged: updateFillColor()
+
+    Component.onCompleted: {
+        updateFillColor()
+        updateBorderRadius()
+    }
+
+    function getDtColor(colorName) {
+        return parseColor.getDtColor(colorName)
+    }
+
+    // 对齐 C++：setBackgroundColor(QColor) 可接收 Qt::GlobalColor(QColor 隐式构造)。
+    // QML 中 Qt.darkYellow 等为 int，property color 无法直接赋值，故先转成 Qt 真实 RGB hex。
+    // 注意：不用 SVG 颜色名，因为 SVG "green"=#008000 ≠ Qt::green=#00ff00，且 "darkyellow" 非标准名。
+    function coerceColor(c) {
+        if (typeof c === "number") {
+            var rgb = [
+                "#000000", "#ffffff", "#808080", "#a0a0a0", "#c0c0c0",
+                "#ff0000", "#00ff00", "#0000ff", "#00ffff", "#ff00ff", "#ffff00",
+                "#800000", "#008000", "#000080", "#008080", "#800080", "#808000"
+            ]
+            if (c === 19) return "transparent" // Qt::transparent
+            if (c === 17) return "#000000"     // Qt::color0
+            if (c === 18) return "#ffffff"     // Qt::color1
+            return (c >= 0 && c < rgb.length) ? rgb[c] : "transparent"
+        }
+        return c
+    }
+
+    function updateFillColor() {
+        if (!enabled)
+            _fillColor = getDtColor("buttontext-disable")
+        else if (useCustomColor)
+            _fillColor = coerceColor(backgroundColor)
+        else
+            _fillColor = getDtColor("highlight-active")
+    }
+
+    function updateBorderRadius() {
+        if (typeof ukui_platformtheme_token !== "undefined"
+                && ukui_platformtheme_token
+                && ukui_platformtheme_token.kradiusNormal > 0)
+            borderRadius = ukui_platformtheme_token.kradiusNormal
+    }
+
+    readonly property bool _highlighted: checked || hovered
+
+    background: Item {
+        anchors.fill: parent
+
+        // 外圈白边（仅 RoundedRect 在 hover/checked 时）
+        Rectangle {
+            id: outerRing
+            anchors.fill: parent
+            visible: control.buttonType === KColorButton.ButtonType.RoundedRect
+                     && control._highlighted && control.enabled
+            radius: control.borderRadius
+            color: typeof ukui_platformtheme_token !== "undefined" ? ukui_platformtheme_token.kFontWhite : "white"
+            antialiasing: true
+        }
+
+        Rectangle {
+            id: fillRect
+            anchors.centerIn: parent
+            width: outerRing.visible ? parent.width - 4 : parent.width
+            height: outerRing.visible ? parent.height - 4 : parent.height
+            visible: control.buttonType !== KColorButton.ButtonType.Circle
+            radius: outerRing.visible ? Math.max(0, control.borderRadius / 2) : control.borderRadius
+            color: control._fillColor
+            antialiasing: true
+
+            // CheckedRect 选中时绘制白色对勾
+            // 对齐 kcolorbutton.cpp：C++ 整数除法 (rect.width()*2/11) + QPen 默认 SquareCap/BevelJoin
+            Canvas {
+                id: checkMark
+                anchors.fill: parent
+                visible: control.buttonType === KColorButton.ButtonType.CheckedRect && control.checked && control.enabled
+                onPaint: {
+                    var ctx = getContext("2d")
+                    ctx.reset()
+                    ctx.strokeStyle = typeof ukui_platformtheme_token !== "undefined" ? ukui_platformtheme_token.kFontWhite : "white"
+                    ctx.lineWidth = 2
+                    ctx.lineCap = "square"   // 对应 QPainter 默认 Qt::SquareCap，端点外延半个线宽
+                    ctx.lineJoin = "bevel"   // 对应 QPainter 默认 Qt::BevelJoin
+                    ctx.beginPath()
+                    ctx.moveTo(Math.floor(width * 2 / 11), Math.floor(height * 6 / 11))
+                    ctx.lineTo(Math.floor(width * 5 / 11), Math.floor(height * 8 / 11))
+                    ctx.lineTo(Math.floor(width * 9 / 11), Math.floor(height * 4 / 11))
+                    ctx.stroke()
+                }
+            }
+        }
+
+        // Circle 类型（对齐 kcolorbutton.cpp: rect.adjusted(1,1,0,0) + 内圆 adjusted(w/4,h/4,-w/4,-h/4)）
+        Rectangle {
+            id: circleFill
+            x: 1
+            y: 1
+            width: parent.width - 1
+            height: parent.height - 1
+            visible: control.buttonType === KColorButton.ButtonType.Circle
+            radius: Math.min(width, height) / 2
+            color: control._fillColor
+            antialiasing: true
+
+            // 内白圆：复刻 C++ 整数除法 adjusted(w/4,...) ，外19 -> 内11 -> 环厚4
+            Rectangle {
+                x: Math.floor(parent.width / 4)
+                y: Math.floor(parent.height / 4)
+                width: parent.width - 2 * Math.floor(parent.width / 4)
+                height: parent.height - 2 * Math.floor(parent.height / 4)
+                radius: width / 2
+                color: typeof ukui_platformtheme_token !== "undefined" ? ukui_platformtheme_token.kFontWhite : "white"
+                visible: control._highlighted && control.enabled
+            }
+        }
+    }
+
+    contentItem: Item {}
+
+    function setBackgroundColor(color) { useCustomColor = true; backgroundColor = color }
+    function setButtonType(type) { buttonType = type }
+    function setBorderRadius(r) { borderRadius = r }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KDateEdit.qml b/ukui-qml-style-helper/controls/qml/KDateEdit.qml
new file mode 100644
index 0000000..d87dfaa
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KDateEdit.qml
@@ -0,0 +1,537 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KLunarDateEdit / KCustomDateEdit.
+ * 尺寸、圆角、悬停/焦点边框及小日历配色与 Widgets 实现保持一致。
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Templates 2.12 as T
+import QtQuick.Window 2.12
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+import org.ukui.platformtheme.controls 1.0 as Private
+import "LunarCalendar.js" as Lunar
+
+T.Control {
+    id: control
+
+    property date date: new Date()
+    property bool showLunar: false
+    property bool calendarPopupEnabled: true
+    property int borderRadius: 6
+    property int activeSection: -1 // 当前激活字段：0 年、1 月、2 日
+    property date displayedMonth: new Date(date.getFullYear(), date.getMonth(), 1)
+    property var calendarDays: []
+
+    implicitWidth: 140
+    implicitHeight: 36
+    hoverEnabled: true
+    focusPolicy: Qt.StrongFocus
+    padding: 0
+
+    StylePrivate.APPParameter { id: app }
+    StylePrivate.ParseColorInterface { id: parseColor }
+
+    readonly property bool dark: app.isDark
+    readonly property color componentColor: parseColor.getDtColor("kcomponent-normal")
+    readonly property color highlightColor: parseColor.getDtColor("highlight-active")
+    readonly property color brandColor: parseColor.getDtColor("kbrand-normal")
+    readonly property color buttonTextColor: parseColor.getDtColor("buttontext-active")
+    readonly property color controlTextColor: enabled ? buttonTextColor
+                                                       : parseColor.getDtColor("buttontext-disable")
+    readonly property color currentTextColor: dark ? "#ffffff" : "#000000"
+    readonly property bool inputFocused: activeSection >= 0 || calendar.opened
+
+    onDateChanged: {
+        displayedMonth = new Date(date.getFullYear(), date.getMonth(), 1)
+        rebuildCalendar()
+    }
+    onEnabledChanged: {
+        if (!enabled && calendar.opened) {
+            calendar.close()
+            activeSection = -1
+        }
+    }
+    onDisplayedMonthChanged: rebuildCalendar()
+    Component.onCompleted: rebuildCalendar()
+
+    function copyDate(value) {
+        return new Date(value.getFullYear(), value.getMonth(), value.getDate())
+    }
+
+    function sameDate(first, second) {
+        return first.getFullYear() === second.getFullYear()
+                && first.getMonth() === second.getMonth()
+                && first.getDate() === second.getDate()
+    }
+
+    function rebuildCalendar() {
+        var first = new Date(displayedMonth.getFullYear(), displayedMonth.getMonth(), 1)
+        var firstWeekday = (first.getDay() + 6) % 7 // Monday is the first column.
+        var start = new Date(first.getFullYear(), first.getMonth(), 1 - firstWeekday)
+        var result = []
+        for (var i = 0; i < 42; ++i) {
+            var value = new Date(start.getFullYear(), start.getMonth(), start.getDate() + i)
+            result.push({ value: value, currentMonth: value.getMonth() === displayedMonth.getMonth()
+                        && value.getFullYear() === displayedMonth.getFullYear() })
+        }
+        calendarDays = result
+    }
+
+    function setDate(value) {
+        if (value instanceof Date && !isNaN(value.getTime()) && !sameDate(value, date))
+            date = copyDate(value)
+    }
+
+    function setShowLunar(value) { showLunar = value }
+    function getDate() { return copyDate(date) }
+    function showCalendar() {
+        positionCalendar()
+        calendar.open()
+    }
+
+    function calendarOverlayParent() {
+        var item = control
+        while (item) {
+            if (item.overlay)
+                return item.overlay
+            item = item.parent
+        }
+        return Window.window ? (Window.window.overlay || Window.window.contentItem) : null
+    }
+
+    function positionCalendar() {
+        var overlay = calendarOverlayParent()
+        if (!overlay)
+            return
+        // 锚点与编辑框重合，使点击编辑框内部不会被视为弹窗外部点击。
+        if (calendarAnchor.parent !== overlay)
+            calendarAnchor.parent = overlay
+        if (calendar.parent !== calendarAnchor)
+            calendar.parent = calendarAnchor
+
+        var position = control.mapToItem(overlay, 0, 0)
+        calendarAnchor.x = position.x
+        calendarAnchor.y = position.y
+        calendar.x = Math.max(-calendarAnchor.x,
+                              Math.min(0, overlay.width - calendar.width - calendarAnchor.x))
+        calendar.y = position.y + control.height + 4 + calendar.height <= overlay.height
+                || position.y - calendar.height - 4 < 0 ? control.height + 4 : -calendar.height - 4
+    }
+
+    function navigateMonth(delta) {
+        var year = displayedMonth.getFullYear()
+        var month = displayedMonth.getMonth() + delta
+        var target = new Date(year, month, 1)
+        var lastDay = new Date(target.getFullYear(), target.getMonth() + 1, 0).getDate()
+        var day = Math.min(date.getDate(), lastDay)
+        setDate(new Date(target.getFullYear(), target.getMonth(), day))
+    }
+
+    function datePartAt(position) {
+        return position <= 4 ? 0 : position <= 7 ? 1 : 2
+    }
+
+    function selectedDatePart() {
+        var position = dateInput.selectionStart < dateInput.selectionEnd
+                ? dateInput.selectionStart : dateInput.cursorPosition
+        return datePartAt(position)
+    }
+
+    function selectDatePart(part) {
+        var start = part === 0 ? 0 : part === 1 ? 5 : 8
+        var end = part === 0 ? 4 : part === 1 ? 7 : 10
+        dateInput.select(start, end)
+    }
+
+    function activateDatePart(part) {
+        activeSection = part
+        if (!showLunar)
+            selectDatePart(part)
+        // 日历面板可由使用方关闭，字段激活和编辑仍可正常进行。
+        if (calendarPopupEnabled)
+            showCalendar()
+    }
+
+    function adjustDate(delta) {
+        var part = selectedDatePart()
+        activeSection = part
+        var target
+        if (part === 0) {
+            var year = date.getFullYear() + delta
+            var lastDay = new Date(year, date.getMonth() + 1, 0).getDate()
+            target = new Date(year, date.getMonth(), Math.min(date.getDate(), lastDay))
+        } else if (part === 1) {
+            var month = new Date(date.getFullYear(), date.getMonth() + delta, 1)
+            var monthLastDay = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate()
+            target = new Date(month.getFullYear(), month.getMonth(), Math.min(date.getDate(), monthLastDay))
+        } else {
+            target = new Date(date.getFullYear(), date.getMonth(), date.getDate() + delta)
+        }
+        setDate(target)
+        if (calendarPopupEnabled)
+            showCalendar()
+        Qt.callLater(function() { selectDatePart(part) })
+    }
+
+    function spinButtonIcon(name) {
+        var icon = name
+        if (!app.themeHasIcon(icon))
+            icon = "file:///usr/share/icons/ukui-icon-theme-default/scalable/actions/" + name + ".svg"
+        return "image://imageProvider/" + icon + "/" + (dark ? "highlight" : "normal")
+    }
+
+    function acceptText() {
+        var match = /^(\d{4})\/(\d{1,2})\/(\d{1,2})$/.exec(dateInput.text)
+        if (!match) {
+            dateInput.text = Qt.formatDate(date, "yyyy/MM/dd")
+            return
+        }
+        var value = new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]))
+        if (value.getFullYear() === Number(match[1]) && value.getMonth() === Number(match[2]) - 1
+                && value.getDate() === Number(match[3]))
+            setDate(value)
+        else
+            dateInput.text = Qt.formatDate(date, "yyyy/MM/dd")
+    }
+
+    function syncDateFromText() {
+        // 仅在完整日期输入后同步，避免删除数字时被自动补零。
+        var match = /^(\d{4})\/(\d{2})\/(\d{2})$/.exec(dateInput.text)
+        if (!match)
+            return
+        var value = new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]))
+        if (value.getFullYear() === Number(match[1]) && value.getMonth() === Number(match[2]) - 1
+                && value.getDate() === Number(match[3]))
+            setDate(value)
+    }
+
+    background: Rectangle {
+        color: control.componentColor
+        radius: control.borderRadius
+        border.color: control.highlightColor
+        border.width: control.inputFocused ? 2 : (control.hovered ? 1 : 0)
+        antialiasing: true
+    }
+
+    contentItem: Item {
+        TextInput {
+            id: dateInput
+            anchors.left: parent.left
+            anchors.right: popupButton.left
+            anchors.leftMargin: 8
+            anchors.rightMargin: 2
+            anchors.verticalCenter: parent.verticalCenter
+            visible: !control.showLunar
+            enabled: control.enabled
+            color: control.controlTextColor
+            selectionColor: control.palette.highlight
+            selectedTextColor: control.palette.highlightedText
+            font.family: app.font.family
+            font.pixelSize: 14
+            selectByMouse: true
+            verticalAlignment: TextInput.AlignVCenter
+            inputMethodHints: Qt.ImhDigitsOnly
+            validator: RegExpValidator {
+                regExp: /^\d{0,4}(\/\d{0,2})?(\/\d{0,2})?$/
+            }
+            text: Qt.formatDate(control.date, "yyyy/MM/dd")
+            onTextChanged: control.syncDateFromText()
+            onEditingFinished: control.acceptText()
+            onActiveFocusChanged: {
+                if (activeFocus) {
+                    if (control.activeSection < 0)
+                        control.activateDatePart(0)
+                }
+            }
+
+            TapHandler {
+                acceptedButtons: Qt.LeftButton
+                onTapped: {
+                    var position = dateInput.cursorPosition
+                    control.activateDatePart(control.datePartAt(position))
+                }
+            }
+        }
+
+        Text {
+            anchors.left: parent.left
+            anchors.right: popupButton.left
+            anchors.leftMargin: 10
+            anchors.rightMargin: 2
+            anchors.verticalCenter: parent.verticalCenter
+            visible: control.showLunar
+            text: Lunar.lunarMonthDay(control.date)
+            color: control.controlTextColor
+            font.family: app.font.family
+            font.pixelSize: 14
+            verticalAlignment: Text.AlignVCenter
+            elide: Text.ElideRight
+        }
+
+        Item {
+            id: popupButton
+            width: 24
+            anchors.top: parent.top
+            anchors.bottom: parent.bottom
+            anchors.right: parent.right
+
+            readonly property int borderInset: control.inputFocused ? 2 : (control.hovered ? 1 : 0)
+
+            Item {
+                anchors.left: parent.left
+                anchors.right: parent.right
+                anchors.rightMargin: popupButton.borderInset
+                anchors.top: parent.top
+                anchors.topMargin: popupButton.borderInset
+                anchors.bottom: parent.verticalCenter
+                clip: true
+
+                Rectangle {
+                    anchors.left: parent.left
+                    anchors.right: parent.right
+                    height: popupButton.height
+                    radius: control.borderRadius
+                    color: upMouseArea.pressed ? parseColor.getDtColor("kcomponent-click")
+                                               : upMouseArea.containsMouse ? parseColor.getDtColor("kcomponent-hover")
+                                                                           : "transparent"
+                }
+            }
+
+            Item {
+                anchors.left: parent.left
+                anchors.right: parent.right
+                anchors.rightMargin: popupButton.borderInset
+                anchors.top: parent.verticalCenter
+                anchors.bottom: parent.bottom
+                anchors.bottomMargin: popupButton.borderInset
+                clip: true
+
+                Rectangle {
+                    anchors.left: parent.left
+                    anchors.right: parent.right
+                    anchors.bottom: parent.bottom
+                    height: popupButton.height
+                    radius: control.borderRadius
+                    color: downMouseArea.pressed ? parseColor.getDtColor("kcomponent-click")
+                                                 : downMouseArea.containsMouse ? parseColor.getDtColor("kcomponent-hover")
+                                                                             : "transparent"
+                }
+            }
+
+            Image {
+                anchors.horizontalCenter: parent.horizontalCenter
+                anchors.verticalCenter: parent.top
+                anchors.verticalCenterOffset: popupButton.height / 4
+                width: 16
+                height: 16
+                sourceSize.width: 16
+                sourceSize.height: 16
+                source: control.spinButtonIcon("ukui-up-symbolic")
+                cache: false
+            }
+
+            Image {
+                anchors.horizontalCenter: parent.horizontalCenter
+                anchors.verticalCenter: parent.bottom
+                anchors.verticalCenterOffset: -popupButton.height / 4
+                width: 16
+                height: 16
+                sourceSize.width: 16
+                sourceSize.height: 16
+                source: control.spinButtonIcon("ukui-down-symbolic")
+                cache: false
+            }
+
+            MouseArea {
+                id: upMouseArea
+                anchors.left: parent.left
+                anchors.right: parent.right
+                anchors.top: parent.top
+                anchors.bottom: parent.verticalCenter
+                enabled: control.enabled
+                hoverEnabled: true
+                onClicked: control.adjustDate(1)
+            }
+
+            MouseArea {
+                id: downMouseArea
+                anchors.left: parent.left
+                anchors.right: parent.right
+                anchors.top: parent.verticalCenter
+                anchors.bottom: parent.bottom
+                enabled: control.enabled
+                hoverEnabled: true
+                onClicked: control.adjustDate(-1)
+            }
+        }
+
+        MouseArea {
+            anchors.left: parent.left
+            anchors.right: popupButton.left
+            anchors.top: parent.top
+            anchors.bottom: parent.bottom
+            enabled: control.enabled && control.showLunar
+            onClicked: {
+                control.activateDatePart(0)
+            }
+        }
+    }
+
+    Item {
+        id: calendarAnchor
+        width: control.width
+        height: control.height
+    }
+
+    Private.KPopup {
+        id: calendar
+        parent: calendarAnchor
+        x: 0
+        y: control.height + 4
+        width: 300
+        height: 336
+        padding: 24
+        modal: false
+        focus: false
+        acceptFocus: false
+        focusTarget: control.showLunar ? control : dateInput
+        animated: false
+        transparent: false
+        closePolicy: T.Popup.CloseOnEscape | T.Popup.CloseOnPressOutsideParent
+
+        onAboutToShow: control.positionCalendar()
+        onClosed: control.activeSection = -1
+
+        Column {
+            width: 252
+            height: 288
+            spacing: 0
+
+            Item {
+                width: parent.width
+                height: 36
+
+                Repeater {
+                    model: ["go-first.symbolic", "ukui-start-symbolic",
+                            "ukui-end-symbolic", "go-first-rtl.symbolic"]
+                    delegate: Item {
+                        width: 36
+                        height: 36
+                        x: index < 2 ? index * 36 : parent.width - (4 - index) * 36
+                        Image {
+                            anchors.centerIn: parent
+                            width: 16
+                            height: 16
+                            sourceSize.width: 16
+                            sourceSize.height: 16
+                            source: "image://imageProvider/" + modelData + "/normal"
+                            cache: false
+                        }
+                        MouseArea {
+                            anchors.fill: parent
+                            onClicked: {
+                                var delta = index === 0 ? -12 : index === 1 ? -1 : index === 2 ? 1 : 12
+                                control.navigateMonth(delta)
+                            }
+                        }
+                    }
+                }
+
+                Text {
+                    anchors.centerIn: parent
+                    text: Qt.formatDate(control.displayedMonth, "yyyy年M月")
+                    color: control.currentTextColor
+                    font.family: app.font.family
+                    font.pixelSize: 14
+                }
+            }
+
+            Row {
+                width: parent.width
+                height: 36
+                Repeater {
+                    model: ["一", "二", "三", "四", "五", "六", "日"]
+                    delegate: Text {
+                        width: 36
+                        height: 36
+                        text: modelData
+                        color: control.currentTextColor
+                        font.family: app.font.family
+                        font.pixelSize: 14
+                        horizontalAlignment: Text.AlignHCenter
+                        verticalAlignment: Text.AlignVCenter
+                    }
+                }
+            }
+
+            Grid {
+                width: parent.width
+                columns: 7
+                rows: 6
+                rowSpacing: 0
+                columnSpacing: 0
+
+                Repeater {
+                    model: control.calendarDays
+                    delegate: Item {
+                        id: dayItem
+                        width: 36
+                        height: 36
+                        property var day: modelData
+                        property bool selected: control.sameDate(day.value, control.date)
+                        property bool hovered: mouseArea.containsMouse
+                        property color textColor: selected ? "#ffffff" : hovered ? "#fafafa"
+                                                  : day.currentMonth ? control.currentTextColor : "#c8c8c8"
+
+                        Rectangle {
+                            anchors.fill: parent
+                            visible: dayItem.selected || dayItem.hovered
+                            radius: 6
+                            color: dayItem.selected ? control.brandColor : "#b4b4b4"
+                            antialiasing: true
+                        }
+
+                        Text {
+                            width: parent.width
+                            y: control.showLunar ? 3 : 0
+                            height: control.showLunar ? 21 : parent.height
+                            text: dayItem.day.value.getDate()
+                            color: dayItem.textColor
+                            font.family: app.font.family
+                            font.pixelSize: control.showLunar ? 13 : 16
+                            horizontalAlignment: Text.AlignHCenter
+                            verticalAlignment: Text.AlignVCenter
+                        }
+
+                        Text {
+                            visible: control.showLunar
+                            width: parent.width
+                            y: 19
+                            height: 14
+                            text: Lunar.lunarDay(dayItem.day.value)
+                            color: dayItem.selected || dayItem.hovered ? dayItem.textColor : "#b3b3b3"
+                            font.family: app.font.family
+                            font.pixelSize: 9
+                            font.bold: true
+                            horizontalAlignment: Text.AlignHCenter
+                            verticalAlignment: Text.AlignVCenter
+                            elide: Text.ElideRight
+                        }
+
+                        MouseArea {
+                            id: mouseArea
+                            anchors.fill: parent
+                            hoverEnabled: true
+                            onClicked: {
+                                control.setDate(dayItem.day.value)
+                                calendar.close()
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KDialog.qml b/ukui-qml-style-helper/controls/qml/KDialog.qml
