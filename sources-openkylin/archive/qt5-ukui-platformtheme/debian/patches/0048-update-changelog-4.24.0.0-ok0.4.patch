+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Layouts 1.15
+import org.ukui.platformtheme.controls 1.0 as Private
+import org.ukui.qqc2style.private 1.0
+
+ApplicationWindow {
+    id: control
+
+    /// token 常为 QBrush，先收成 color 再取 rgb
+    readonly property bool _hasToken: typeof ukui_platformtheme_token !== "undefined"
+                                      && ukui_platformtheme_token
+    readonly property color _containColor: _hasToken
+                                           ? ukui_platformtheme_token.kContainGeneralNormal
+                                           : palette.base
+    readonly property real _bgAlpha: {
+        var a = (control.active && blurEnabled) ? app.menuTransparency : 1.0
+        if (a === undefined || a === null)
+            return 1.0
+        return a
+    }
+    readonly property color _bgFillColor: Qt.rgba(_containColor.r, _containColor.g, _containColor.b, _bgAlpha)
+
+    // ApplicationWindow 对带 alpha 的 color 表现异常：窗口本身透明，由 background 铺色
+    color: "transparent"
+    background: Rectangle {
+        anchors.fill: parent
+        color: control._bgFillColor
+    }
+
+    property var _titleIcon: {
+        if(control.hasOwnProperty("titleIcon"))
+            return control.titleIcon
+        return ""
+    }
+    property bool isNormal : true
+    property alias minButton: minBtn
+    property alias maxButton: maxBtn
+    property alias closeButton: closeBtn
+    property alias menuButton: menuBtn
+    property bool blurEnabled: false
+
+
+    signal closeBtnClicked
+    signal maxOrRestoryBtnClicked(bool isNormal)
+    signal minBtnClicked
+
+    width:  600
+    height: 480
+    minimumWidth: 200
+    header: Item{
+        height: 40
+        width: parent.width
+
+        RowLayout{
+            anchors.left: parent.left
+            anchors.leftMargin: 8
+            anchors.right: parent.right
+            anchors.rightMargin: 8
+            anchors.top: parent.top
+            anchors.bottom: parent.bottom
+            Image{
+                id: titleImage
+                visible: _titleIcon != "" && control.title != ""
+                source: "image://imageProvider/" + _titleIcon + "/" + (control.active ? "normal" : "disenable");
+                Layout.alignment: Qt.AlignVCenter
+                Layout.fillWidth: false
+                sourceSize.width:  24
+                sourceSize.height: 24
+            }
+            Label{
+                visible: control.title != ""
+                text: control.title
+                property var windowLabel: true
+                Layout.alignment: Qt.AlignVCenter
+                Layout.fillWidth: true
+                Layout.minimumWidth: 0
+                elide: Text.ElideRight
+                maximumLineCount: 1
+            }
+
+            Private.KHeadBarMenuBtn{
+                id: menuBtn
+                Layout.alignment: Qt.AlignVCenter
+                Layout.fillWidth: false
+            }
+            Private.KWindowButton{
+                id: minBtn
+                Layout.alignment: Qt.AlignVCenter
+                Layout.fillWidth: false
+                property string type: "minimize"
+                onClicked: {
+                    control.showMinimized()
+                    minBtnClicked()
+                }
+            }
+            Private.KWindowButton{
+                id: maxBtn
+                Layout.alignment: Qt.AlignVCenter
+                Layout.fillWidth: false
+                property string type: "maximize"
+                onClicked:{
+                    if(isNormal){
+                        control.showMaximized()
+                    }
+                    else{
+                        control.showNormal()
+                    }
+                    isNormal = !isNormal
+                    maxOrRestoryBtnClicked(isNormal)
+                }
+                onHoveredChanged: {
+                    maxBtnFlyoutTimer.stop()
+                    if (hovered)
+                        maxBtnFlyoutTimer.start()
+                }
+
+            }
+            Private.KWindowButton{
+                id: closeBtn
+                Layout.alignment: Qt.AlignVCenter |Qt.AlignRight
+                Layout.fillWidth: false
+                property string type: "close"
+                onClicked: {
+                    closeBtnClicked()
+                    control.close()
+                }
+            }
+        }
+    }
+
+    Timer {
+        id: maxBtnFlyoutTimer
+        interval: Qt.styleHints.mousePressAndHoldInterval
+        repeat: false
+        onTriggered: {
+            if (!maxBtn.hovered)
+                return
+            kdialog.showTileFlyout(maxBtn.x, maxBtn.y, Math.round(maxBtn.width), Math.round(maxBtn.height))
+        }
+    }
+
+    Private.KyQuickDialog {
+        id: kdialog
+    }
+    /// KAboutDialog 等子组件通过 root.kyQuickDialog 调用 openSupportLink / privacyClicked
+    property alias kyQuickDialog: kdialog
+
+    function iconSource(){
+        if(_titleIcon != "")
+            return "image://imageProvider/" + _titleIcon + "/" + (control.active ? "normal" : "disenable");
+    }
+    APPParameter{
+        id: app
+        onParametryChanged:{
+            titleImage.source = ""
+            titleImage.source = iconSource()
+        }
+        onIconThemeChanged: {
+            titleImage.source = ""
+            titleImage.source = iconSource()
+        }
+    }
+    Private.UKUIWindow{
+        id:ukuiWindow
+        blurEnabled: control.blurEnabled
+        shadowEnabled: true
+        borderEnabled: true
+        roundCornerEnabled: true
+    }
+    Component.onCompleted: ukuiWindow.setUseStyleWindowManager(true)
+}
diff --git a/ukui-qml-style-helper/controls/qml/KDirTabBar.qml b/ukui-qml-style-helper/controls/qml/KDirTabBar.qml
new file mode 100644
index 0000000..aad10b2
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KDirTabBar.qml
@@ -0,0 +1,319 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KDirTabBar。
+ * 对齐 C++ 交互：
+ *  - setCurrentPath(path) 按路径拆段重建按钮
+ *  - 点正文 → setCurrentPath(该段 uri) + tabBarClicked(uri)
+ *  - 点子目录菜单 → setCurrentPath(子路径) + tabBarClicked(uri)
+ *  - 箭头仅在有子目录时显示；菜单打开时为 ukui-down-symbolic
+ *  - 默认通过 KyDirHelper 读取真实文件系统子目录（QDirIterator）
+ *  - 可选 childrenProvider 覆盖默认列举（测试用）
+ */
+
+import QtQuick 2.12
+import QtQml 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Layouts 1.15
+import org.ukui.platformtheme.controls 1.0 as Private
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+RowLayout {
+    id: root
+
+    property string currentPath: ""
+    property int visibleDepth: 5
+    // 对齐 C++ textLength：显示名超过该字符数则省略
+    property int textLength: 5
+    property bool flat: true
+    property bool backgroundVisible: true
+    property bool translucent: true
+    // 可选：function(path) → [{ text, icon?, uri? }, ...]；未设置则读真实文件系统
+    property var childrenProvider: null
+
+    readonly property string homePath: dirHelper.homePath
+
+    // 当前路径拆出的段 [{ text, displayText, uri, icon, menuItems }]
+    property var _segments: []
+    readonly property int segmentCount: _segments.length
+    property int expandedIndex: -1
+    // setIcon(1-based) 覆盖；key 为 1-based 下标字符串
+    property var _iconOverrides: ({})
+
+    spacing: 8
+    implicitHeight: 36
+
+    Private.KyDirHelper { id: dirHelper }
+
+    StylePrivate.APPParameter {
+        id: app
+        onParametryChanged: root._reloadIcons()
+        onIconThemeChanged: root._reloadIcons()
+    }
+
+    signal tabBarClicked(string uri)
+
+    property int iconRev: 0
+    function _reloadIcons() { iconRev++ }
+
+    function _normalizePath(path) {
+        return dirHelper.normalizePath(String(path === undefined || path === null ? "" : path))
+    }
+
+    function _parentPath(path) {
+        var p = _normalizePath(path)
+        if (p === "" || p === "/")
+            return "/"
+        var slash = p.lastIndexOf("/")
+        if (slash <= 0)
+            return "/"
+        return p.substring(0, slash)
+    }
+
+    function _baseName(path) {
+        var p = _normalizePath(path)
+        if (p === "" || p === "/")
+            return p
+        var slash = p.lastIndexOf("/")
+        return p.substring(slash + 1)
+    }
+
+    function _joinPath(parent, name) {
+        var p = _normalizePath(parent)
+        var n = String(name)
+        if (p === "/" || p === "")
+            return "/" + n
+        return p + "/" + n
+    }
+
+    function _elideName(name) {
+        var s = String(name)
+        if (root.textLength <= 0 || s.length <= root.textLength)
+            return s
+        return s.substring(0, root.textLength) + "…"
+    }
+
+    function _defaultFolderIcon(name) {
+        switch (String(name)) {
+        case "图片": return "folder-pictures"
+        case "下载": return "folder-download"
+        case "公共的": return "folder-publicshare"
+        case "文档": return "folder-documents"
+        case "桌面": return "user-desktop"
+        case "模板": return "folder-templates"
+        case "视频": return "folder-videos"
+        case "音乐": return "folder-music"
+        default: return "folder"
+        }
+    }
+
+    function _normalizeChild(parentUri, item) {
+        if (typeof item === "string") {
+            return {
+                text: item,
+                uri: root._joinPath(parentUri, item),
+                icon: root._defaultFolderIcon(item)
+            }
+        }
+        if (typeof item !== "object" || item === null)
+            return null
+        var text = item.text !== undefined ? item.text
+                  : (item.title !== undefined ? item.title : item.name)
+        text = text !== undefined && text !== null ? String(text) : ""
+        var uri = item.uri !== undefined && item.uri !== null && String(item.uri) !== ""
+                ? root._normalizePath(item.uri)
+                : root._joinPath(parentUri, text)
+        var icon = item.icon !== undefined ? item.icon
+                 : (item.iconName !== undefined ? item.iconName : root._defaultFolderIcon(text))
+        return { text: text, uri: uri, icon: String(icon || "folder") }
+    }
+
+    function _childrenOf(path) {
+        var list = []
+        var raw
+        if (typeof root.childrenProvider === "function")
+            raw = root.childrenProvider(path)
+        else
+            raw = dirHelper.listSubDirectories(path)
+        if (!raw)
+            return list
+        for (var i = 0; i < raw.length; i++) {
+            var c = root._normalizeChild(path, raw[i])
+            if (c)
+                list.push(c)
+        }
+        return list
+    }
+
+    // 对齐 C++ setCurrentPath：自路径向上拆段，不含 "/" 本身
+    function _segmentsFromPath(path) {
+        var p = root._normalizePath(path)
+        var segs = []
+        if (p === "" || p === "/")
+            return segs
+        var tmp = p
+        while (tmp !== "/" && tmp !== "") {
+            var name = root._baseName(tmp)
+            segs.unshift({
+                text: name,
+                displayText: root._elideName(name),
+                uri: tmp,
+                icon: root._defaultFolderIcon(name),
+                menuItems: []
+            })
+            tmp = root._parentPath(tmp)
+        }
+        return segs
+    }
+
+    function _rebuild() {
+        root.expandedIndex = -1
+        var segs = root._segmentsFromPath(root.currentPath)
+        for (var i = 0; i < segs.length; i++) {
+            var key = String(i + 1)
+            if (root._iconOverrides[key] !== undefined && root._iconOverrides[key] !== "")
+                segs[i].icon = root._iconOverrides[key]
+            segs[i].menuItems = root._childrenOf(segs[i].uri)
+        }
+        root._segments = segs
+        root._reloadIcons()
+    }
+
+    function setCurrentPath(path) {
+        var p = root._normalizePath(path)
+        if (root.currentPath !== p)
+            root.currentPath = p
+        else
+            root._rebuild()
+    }
+
+    onCurrentPathChanged: root._rebuild()
+    onVisibleDepthChanged: root._reloadIcons()
+    onTextLengthChanged: root._rebuild()
+    onChildrenProviderChanged: root._rebuild()
+
+    function _firstVisibleIndex() {
+        var n = root._segments.length
+        if (n <= root.visibleDepth)
+            return 0
+        return n - root.visibleDepth
+    }
+
+    function _navigateTo(uri) {
+        root.setCurrentPath(uri)
+        root.tabBarClicked(uri)
+    }
+
+    function collapse() { expandedIndex = -1 }
+
+    // 对齐 C++：index 为 1-based
+    function setIcon(index, iconName) {
+        if (index < 1)
+            return
+        var next = {}
+        for (var k in root._iconOverrides)
+            next[k] = root._iconOverrides[k]
+        next[String(index)] = iconName !== undefined && iconName !== null ? String(iconName) : ""
+        root._iconOverrides = next
+        root._rebuild()
+    }
+
+    function icon(index) {
+        if (index < 1 || index > root._segments.length)
+            return ""
+        return root._segments[index - 1].icon
+    }
+
+    function setVisibleDepth(d) { visibleDepth = d }
+    function setTextLength(n) { textLength = n }
+    function setBackgroundVisible(v) { backgroundVisible = v }
+    function setTranslucent(v) { translucent = v }
+
+    Component.onCompleted: {
+        if (root.currentPath !== "")
+            root._rebuild()
+    }
+
+    Repeater {
+        model: root._segments
+
+        Private.KBreadCrumbItem {
+            id: crumb
+            visible: index >= root._firstVisibleIndex()
+            text: modelData.displayText !== undefined ? modelData.displayText : modelData.text
+            iconName: modelData.icon !== undefined ? modelData.icon : "folder"
+            // 对齐 C++：仅当该段有子目录菜单时画箭头
+            showSeparator: modelData.menuItems && modelData.menuItems.length > 0
+            current: index === root._segments.length - 1
+            flat: root.flat
+            backgroundVisible: root.backgroundVisible
+            translucent: root.translucent
+            separatorInteractive: true
+            expanded: index === root.expandedIndex
+            iconRev: root.iconRev
+            // 允许 Tab 走焦并显示焦点框；菜单收起用 dismissFocusChrome 避免误显
+            tabFocusEnabled: true
+
+            // 点正文：跳到该段路径（截断更深层级）
+            onClicked: root._navigateTo(modelData.uri)
+
+            // 点箭头：重新扫描真实目录后弹出菜单
+            onSeparatorClicked: {
+                var items = root._childrenOf(modelData.uri)
+                if (!items.length) {
+                    root.expandedIndex = -1
+                    crumb.dismissFocusChrome()
+                    return
+                }
+                if (root.expandedIndex === index) {
+                    root.expandedIndex = -1
+                    itemMenu.close()
+                    crumb.dismissFocusChrome()
+                    return
+                }
+                // 弹出前标记为鼠标路径，菜单抢走/归还焦点时不显示焦点框
+                crumb.dismissFocusChrome()
+                root.expandedIndex = index
+                itemMenu.segmentUri = modelData.uri
+                itemMenu.menuModel = items
+                itemMenu.popup(crumb, 0, crumb.height)
+            }
+
+            Menu {
+                id: itemMenu
+                property string segmentUri: ""
+                property var menuModel: []
+                width: Math.max(crumb.width + 5, implicitWidth)
+                onAboutToShow: {
+                    width = Math.max(crumb.width + 5, implicitWidth)
+                    // 弹出前再扫一次，保证下拉内容是最新文件系统状态
+                    if (segmentUri !== "")
+                        menuModel = root._childrenOf(segmentUri)
+                }
+                onAboutToHide: crumb.dismissFocusChrome()
+                onClosed: {
+                    if (root.expandedIndex === index)
+                        root.expandedIndex = -1
+                    // Popup 归还焦点可能在 closed 之后，再清一次
+                    Qt.callLater(function () { crumb.dismissFocusChrome() })
+                }
+
+                Instantiator {
+                    model: itemMenu.menuModel
+                    delegate: MenuItem {
+                        text: modelData.text !== undefined ? modelData.text : String(modelData)
+                        icon.name: modelData.icon !== undefined ? modelData.icon : "folder"
+                        onTriggered: {
+                            var uri = modelData.uri !== undefined
+                                      ? modelData.uri
+                                      : root._joinPath(itemMenu.segmentUri, text)
+                            root._navigateTo(uri)
+                        }
+                    }
+                    onObjectAdded: itemMenu.insertItem(index, object)
+                    onObjectRemoved: itemMenu.removeItem(object)
+                }
+            }
+        }
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KDragWidget.qml b/ukui-qml-style-helper/controls/qml/KDragWidget.qml
new file mode 100644
index 0000000..dd68187
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KDragWidget.qml
@@ -0,0 +1,273 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KDragWidget.
+ * 外观、边框状态和文件过滤行为对齐 kdragwidget.cpp。
+ */
+
+import QtQuick 2.12
+import org.ukui.platformtheme.controls 1.0 as Private
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+Item {
+    id: root
+
+    property string iconName: "list-add.symbolic"
+    property string text: qsTr("将文件拖拽到此处或点击“+”添加文件")
+    property string nameFilter: ""
+    property var nameFilters: []
+    property bool dropActive: false
+    property bool dropInvalid: false
+
+    signal getPath(string path)
+    signal getPathList(var paths)
+
+    // 与 KDragWidget::iconButton/textLabel 对应的可访问对象。
+    property alias iconButton: addButton
+    property alias textLabel: textLabelItem
+
+    StylePrivate.APPParameter { id: app }
+    StylePrivate.ParseColorInterface { id: parseColor }
+
+    readonly property color _hoverLine: parseColor.getDtColor("tooltiptext-active")
+    readonly property color _dragLine: parseColor.getDtColor("highlight-active")
+    readonly property color _leaveLine: parseColor.getDtColor("placeholdertext-active")
+    readonly property color _plusBackground: parseColor.getDtColor("kcomponent-alpha-normal")
+    readonly property color _plusHoverBackground: parseColor.getDtColor("kcomponent-alpha-hover")
+    readonly property color _plusClickBackground: parseColor.getDtColor("kcomponent-alpha-click")
+    readonly property color _plusDisableBackground: parseColor.getDtColor("kcomponent-alpha-disable")
+    readonly property int _radius: {
+        var r = typeof ukui_platformtheme_token !== "undefined" && ukui_platformtheme_token
+                ? ukui_platformtheme_token.kradiusNormal : 6
+        return r < 0 ? 6 : r
+    }
+
+    // 初始状态与鼠标离开后保持一致，避免首次显示的边框颜色突变。
+    property color _lineColor: _leaveLine
+
+    implicitWidth: 332
+    implicitHeight: 114
+    activeFocusOnTab: true
+    enabled: true
+
+    function _filterMatches(url) {
+        var filters = nameFilters
+        if (nameFilter !== "")
+            filters = nameFilter.split(/;;|\n/)
+        if (!filters || filters.length === 0)
+            return true
+
+        var path = String(url).split("/").pop()
+        for (var i = 0; i < filters.length; ++i) {
+            var filter = String(filters[i])
+            if (filter.indexOf("(*)") !== -1)
+                return true
+            var matches = filter.match(/\*\.([A-Za-z0-9_+-]+)/g)
+            if (!matches || matches.length === 0)
+                continue
+            for (var j = 0; j < matches.length; ++j) {
+                var suffix = matches[j].slice(1).toLowerCase()
+                if (path.toLowerCase().slice(-suffix.length) === suffix)
+                    return true
+            }
+        }
+        return false
+    }
+
+    function _handleUrls(urls) {
+        var accepted = []
+        for (var i = 0; i < urls.length; ++i) {
+            var url = String(urls[i])
+            if (_filterMatches(url))
+                accepted.push(url.indexOf("file://") === 0 ? url.slice(7) : url)
+        }
+        dropInvalid = accepted.length !== urls.length
+        if (accepted.length === 1)
+            getPath(accepted[0])
+        else if (accepted.length > 1)
+            getPathList(accepted)
+    }
+
+    function _urlsAreValid(urls) {
+        if (!urls || urls.length === 0)
+            return false
+        for (var i = 0; i < urls.length; ++i) {
+            if (!_filterMatches(urls[i]))
+                return false
+        }
+        return true
+    }
+
+    function _handlePaths(paths) {
+        var accepted = []
+        for (var i = 0; i < paths.length; ++i) {
+            if (_filterMatches(paths[i]))
+                accepted.push(paths[i])
+        }
+        if (accepted.length === 1)
+            getPath(accepted[0])
+        else if (accepted.length > 1)
+            getPathList(accepted)
+    }
+
+    function setNameFilter(filter) {
+        nameFilter = filter
+        nameFilters = filter === "" ? [] : filter.split(/;;|\n/)
+    }
+
+    function setNameFilters(filters) {
+        nameFilters = filters
+        nameFilter = filters.join(";;")
+    }
+
+    function openFile() {
+        fileDialog.nameFilters = nameFilters
+        fileDialog.open()
+    }
+
+    // 用 Canvas 绘制可随控件尺寸变化的圆角虚线边框。
+    Canvas {
+        id: borderCanvas
+        anchors.fill: parent
+        antialiasing: true
+
+        onPaint: {
+            var ctx = getContext("2d")
+            ctx.reset()
+            var inset = 1
+            var w = width - inset * 2
+            var h = height - inset * 2
+            if (w <= 0 || h <= 0)
+                return
+
+            var r = Math.min(root._radius, Math.min(w, h) / 2)
+            ctx.beginPath()
+            ctx.moveTo(inset + r, inset)
+            ctx.lineTo(inset + w - r, inset)
+            ctx.quadraticCurveTo(inset + w, inset, inset + w, inset + r)
+            ctx.lineTo(inset + w, inset + h - r)
+            ctx.quadraticCurveTo(inset + w, inset + h, inset + w - r, inset + h)
+            ctx.lineTo(inset + r, inset + h)
+            ctx.quadraticCurveTo(inset, inset + h, inset, inset + h - r)
+            ctx.lineTo(inset, inset + r)
+            ctx.quadraticCurveTo(inset, inset, inset + r, inset)
+            ctx.closePath()
+            ctx.setLineDash([4, 4])
+            ctx.lineWidth = 1
+            ctx.strokeStyle = root.enabled
+                    ? (root.dropInvalid ? root._leaveLine : root._lineColor) : root._leaveLine
+            ctx.stroke()
+        }
+    }
+
+    MouseArea {
+        id: interactionArea
+        anchors.fill: parent
+        hoverEnabled: true
+        onEntered: {
+            root._lineColor = root._hoverLine
+            borderCanvas.requestPaint()
+        }
+        onExited: {
+            root._lineColor = root._leaveLine
+            borderCanvas.requestPaint()
+        }
+        onPressed: {
+            root._lineColor = root._hoverLine
+            borderCanvas.requestPaint()
+        }
+        onClicked: root.openFile()
+    }
+
+    // 11px 是控件间距；加上 Text 的字体留白后，视觉间距约为 16px。
+    Item {
+        id: contentLayout
+        anchors.centerIn: parent
+        width: parent.width
+        height: addButton.height + 11 + textLabelItem.implicitHeight
+    }
+
+    Rectangle {
+        id: addButton
+        parent: contentLayout
+        anchors.horizontalCenter: parent.horizontalCenter
+        anchors.top: parent.top
+        width: 36
+        height: 36
+        color: "transparent"
+
+        Rectangle {
+            anchors.fill: parent
+            radius: 18
+            color: !root.enabled ? root._plusDisableBackground
+                                  : interactionArea.pressed ? root._plusClickBackground
+                                  : interactionArea.containsMouse ? root._plusHoverBackground
+                                  : root._plusBackground
+
+            Private.KyIcon {
+                anchors.centerIn: parent
+                width: 16
+                height: 16
+                iconName: root.iconName
+            }
+        }
+    }
+
+    Text {
+        id: textLabelItem
+        parent: contentLayout
+        anchors.top: addButton.bottom
+        anchors.topMargin: 11
+        anchors.left: parent.left
+        anchors.right: parent.right
+        horizontalAlignment: Text.AlignHCenter
+        elide: Text.ElideRight
+        color: root.enabled ? parseColor.getDtColor("kfont-primary") : root._leaveLine
+        text: root.text
+    }
+
+    DropArea {
+        anchors.fill: parent
+        keys: ["text/uri-list"]
+
+        onEntered: {
+            root.dropActive = true
+            root.dropInvalid = !root._urlsAreValid(drag.urls)
+            // 拒绝无效文件，让 Qt 显示禁止拖放光标。
+            drag.accepted = !root.dropInvalid
+            root._lineColor = root._dragLine
+            borderCanvas.requestPaint()
+        }
+        onPositionChanged: {
+            root.dropInvalid = !root._urlsAreValid(drag.urls)
+            drag.accepted = !root.dropInvalid
+            borderCanvas.requestPaint()
+        }
+        onExited: {
+            root.dropActive = false
+            root.dropInvalid = false
+            root._lineColor = root._leaveLine
+            borderCanvas.requestPaint()
+        }
+        onDropped: {
+            root.dropActive = false
+            root._lineColor = root._leaveLine
+            root._handleUrls(drop.urls)
+            borderCanvas.requestPaint()
+        }
+    }
+
+    Private.KDragFileDialog {
+        id: fileDialog
+        onAccepted: root._handlePaths(paths)
+    }
+
+    Connections {
+        target: app
+        function onParametryChanged() { borderCanvas.requestPaint() }
+    }
+
+    Component.onCompleted: borderCanvas.requestPaint()
+    onEnabledChanged: borderCanvas.requestPaint()
+    onDropInvalidChanged: borderCanvas.requestPaint()
+}
diff --git a/ukui-qml-style-helper/controls/qml/KHLineFrame.qml b/ukui-qml-style-helper/controls/qml/KHLineFrame.qml
new file mode 100644
index 0000000..84d9c85
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KHLineFrame.qml
@@ -0,0 +1,41 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KHLineFrame。
+ * 对齐 klineframe.cpp：水平 1px 分隔线，色 kline-normal，固定高 1；
+ * setFollowPalette(false) 冻结当前色（不再随主题变化），true 恢复随主题。
+ */
+
+import QtQuick 2.12
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+Rectangle {
+    id: root
+
+    property bool followPalette: true
+
+    implicitHeight: 1
+    height: 1
+
+    StylePrivate.ParseColorInterface { id: parseColor }
+    StylePrivate.APPParameter { id: app }
+
+    Component.onCompleted: root.color = parseColor.getDtColor("kline-normal")
+
+    // 主题变化：仅 followPalette 时刷新；false 时保持当前色（冻结，对齐 C++ changeTheme 守卫）
+    Connections {
+        target: app
+        function onParametryChanged() {
+            if (root.followPalette)
+                root.color = parseColor.getDtColor("kline-normal")
+        }
+    }
+
+    onFollowPaletteChanged: {
+        if (followPalette)
+            root.color = parseColor.getDtColor("kline-normal")
+        // 置 false：不动 color，冻结当前值
+    }
+
+    function setFollowPalette(f) { followPalette = f }
+}
