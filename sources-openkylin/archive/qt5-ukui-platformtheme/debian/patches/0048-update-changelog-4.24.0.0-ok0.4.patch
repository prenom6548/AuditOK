+static bool messageBoxMatchesOptions(const QMessageBox *mb, const QMessageDialogOptions *options)
+{
+    return mb && options
+        && static_cast<int>(mb->icon()) == static_cast<int>(options->icon())
+        && mb->windowTitle() == options->windowTitle()
+        && mb->text() == options->text()
+        && mb->informativeText() == options->informativeText()
+        && mb->detailedText() == options->detailedText();
+}
+
+// Locate the application's QMessageBox for the current helper options.
+// Prefer children of the transient parent (reliable for modal dialogs); fall back
+// to a unique global match only when parent lookup is inconclusive.
+static QMessageBox *findSourceMessageBox(const QMessageDialogOptions *options, QWindow *parentWindow)
+{
+    if (!options)
+        return nullptr;
+
+    QMessageBox *found = nullptr;
+    int matchCount = 0;
+
+    const auto consider = [&](QMessageBox *mb) {
+        if (!messageBoxMatchesOptions(mb, options))
+            return;
+        found = mb;
+        ++matchCount;
+    };
+
+    if (parentWindow) {
+        if (QWidget *parentWidget = QWidget::find(parentWindow->winId())) {
+            const QList<QMessageBox *> boxes = parentWidget->findChildren<QMessageBox *>();
+            for (QMessageBox *mb : boxes)
+                consider(mb);
+            if (matchCount == 1)
+                return found;
+        }
+    }
+
+    found = nullptr;
+    matchCount = 0;
+    const QList<QWidget *> widgets = QApplication::allWidgets();
+    for (QWidget *w : widgets) {
+        if (QMessageBox *mb = qobject_cast<QMessageBox *>(w))
+            consider(mb);
+    }
+    if (matchCount == 1)
+        return found;
+
+    // Fallback: title + body text only (icon/informativeText can diverge on some paths).
+    found = nullptr;
+    matchCount = 0;
+    for (QWidget *w : widgets) {
+        if (QMessageBox *mb = qobject_cast<QMessageBox *>(w)) {
+            if (mb->windowTitle() == options->windowTitle() && mb->text() == options->text()) {
+                found = mb;
+                ++matchCount;
+            }
+        }
+    }
+
+    return matchCount == 1 ? found : nullptr;
+}
+
+static QString sourceStandardButtonLabel(const QMessageBox *source, QMessageBox::StandardButton standardButton)
+{
+    if (!source)
+        return QString();
 
+    if (QAbstractButton *srcBtn = source->button(standardButton))
+        return srcBtn->text();
+
+    return source->buttonText(int(standardButton));
+}
 
