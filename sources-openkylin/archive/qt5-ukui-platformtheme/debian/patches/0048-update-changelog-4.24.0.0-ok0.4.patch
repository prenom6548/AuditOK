+const char* KyQuickStyleItem::classNameForItem() const
+{
+    switch(m_itemType) {
+    case Button:
+        return "QPushButton";
+    case RadioButton:
+        return "QRadioButton";
+    case CheckBox:
+        return "QCheckBox";
+    case ComboBox:
+        return "QComboBox";
+    case ComboBoxItem:
+        return "QComboMenuItem";
+    case ToolBar:
+        return "";
+    case ToolButton:
+        return "QToolButton";
+    case Tab:
+        return "QTabButton";
+    case TabFrame:
+        return "QTabBar";
+    case Edit:
+        return "QTextEdit";
+    case GroupBox:
+        return "QGroupBox";
+    case Header:
+        return "QHeaderView";
+    case Item:
+    case ItemRow:
+        return "QAbstractItemView";
+    case Menu:
+    case MenuItem:
+        return "QMenu";
+    case MenuBar:
+    case MenuBarItem:
+        return "QMenuBar";
+    default:
+        return "";
+    }
+    Q_UNREACHABLE();
+}
