diff --git a/ukui-qml-style-helper/controls/qml/KInputDialog.qml b/ukui-qml-style-helper/controls/qml/KInputDialog.qml
new file mode 100644
index 0000000..0ebb0bf
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KInputDialog.qml
@@ -0,0 +1,316 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KInputDialog.
+ * Layout, sizes and control states follow kysdk-qtwidgets/src/kinputdialog.cpp.
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import org.ukui.platformtheme.controls 1.0 as Private
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+Private.KDialog {
+    id: root
+
+    enum InputMode {
+        TextInput = 0,
+        IntInput = 1,
+        DoubleInput = 2
+    }
+
+    enum InputDialogOption {
+        NoButtons = 1,
+        UseListViewForComboBoxItems = 2,
+        UsePlainTextEditForTextInput = 4
+    }
+
+    property int inputMode: KInputDialog.InputMode.TextInput
+    property int options: 0
+    property string labelText: qsTr("Enter a value:")
+    property string tipText: ""
+    property string placeholderText: ""
+    property string textValue: ""
+    property int textEchoMode: TextInput.Normal
+    property int intValue: 0
+    property int intMinimum: 0
+    property int intMaximum: 99
+    property int intStep: 1
+    property real doubleValue: 0.0
+    property real doubleMinimum: 0.0
+    property real doubleMaximum: 99.99
+    property int doubleDecimals: 2
+    property real doubleStep: 1.0
+    property string okButtonText: qsTr("ok")
+    property string cancelButtonText: qsTr("cancel")
+
+    readonly property bool usePlainTextEdit: inputMode === KInputDialog.InputMode.TextInput
+                                                  && (options & KInputDialog.InputDialogOption.UsePlainTextEditForTextInput) !== 0
+    readonly property bool noButtons: (options & KInputDialog.InputDialogOption.NoButtons) !== 0
+    readonly property bool _singleLine: inputMode === KInputDialog.InputMode.TextInput && !usePlainTextEdit
+    readonly property bool _intInput: inputMode === KInputDialog.InputMode.IntInput
+    readonly property bool _doubleInput: inputMode === KInputDialog.InputMode.DoubleInput
+    readonly property int _inputHeight: usePlainTextEdit ? 192 : 36
+    // 标签下方统一保留 8px 间距。
+    readonly property int _inputY: 28
+    readonly property int _tipY: _inputY + _inputHeight + (_singleLine ? 0 : 8)
+    readonly property int _buttonY: _tipY + 19 + 32
+    readonly property int _bodyHeight: _buttonY + (noButtons ? 0 : 36) + 24
+    readonly property int _dialogWidth: usePlainTextEdit ? 304 : 336
+    readonly property int _doubleFactor: Math.pow(10, Math.max(0, doubleDecimals))
+    readonly property bool _numericInputAcceptable: {
+        var spin = _intInput ? intSpinBox : doubleSpinBox
+        return !_intInput && !_doubleInput
+                || !spin.contentItem
+                || spin.contentItem.acceptableInput
+    }
+
+    signal textValueSelected(string value)
+    signal intValueSelected(int value)
+    signal doubleValueSelected(real value)
+    signal confirmed(var value)
+    signal cancelled()
+
+    title: ""
+    width: _dialogWidth
+    height: 40 + _bodyHeight
+    minimumWidth: _dialogWidth
+    maximumWidth: _dialogWidth
+    minimumHeight: 40 + _bodyHeight
+    maximumHeight: 40 + _bodyHeight
+    modality: Qt.ApplicationModal
+    flags: Qt.Dialog | Qt.WindowTitleHint | Qt.WindowCloseButtonHint
+    blurEnabled: false
+
+    StylePrivate.APPParameter { id: app }
+    palette: app.palette
+
+    readonly property bool _hasToken: typeof ukui_platformtheme_token !== "undefined"
+                                      && ukui_platformtheme_token
+    readonly property color _primaryText: _hasToken
+                                          ? ukui_platformtheme_token.kFontPrimary
+                                          : palette.windowText
+    property bool _suppressClosingCancel: false
+
+    Component.onCompleted: _applyChrome()
+    onCloseBtnClicked: cancelDialog()
+    onClosing: {
+        if (!_suppressClosingCancel)
+            cancelled()
+    }
+    onVisibleChanged: {
+        if (visible)
+            Qt.callLater(_focusInput)
+    }
+
+    function _applyChrome() {
+        if (minButton)
+            minButton.visible = false
+        if (maxButton)
+            maxButton.visible = false
+        if (menuButton)
+            menuButton.visible = false
+        if (closeButton)
+            closeButton.visible = true
+    }
+
+    function _focusInput() {
+        var input = _singleLine ? lineEdit
+                                : usePlainTextEdit ? plainTextEdit
+                                                   : _intInput ? intSpinBox : doubleSpinBox
+        input.forceActiveFocus()
+        if (input.selectAll)
+            input.selectAll()
+        else if (input.contentItem && input.contentItem.selectAll)
+            input.contentItem.selectAll()
+    }
+
+    function setOption(option, on) {
+        if (on === undefined)
+            on = true
+        options = on ? (options | option) : (options & ~option)
+    }
+
+    function testOption(option) {
+        return (options & option) !== 0
+    }
+
+    function setIntRange(minimum, maximum) {
+        intMinimum = minimum
+        intMaximum = maximum
+    }
+
+    function setDoubleRange(minimum, maximum) {
+        doubleMinimum = minimum
+        doubleMaximum = maximum
+    }
+
+    function showDialog() {
+        show()
+        raise()
+        requestActivate()
+        Qt.callLater(_focusInput)
+    }
+
+    function acceptDialog() {
+        if (!_numericInputAcceptable)
+            return
+
+        _suppressClosingCancel = true
+        var value
+        if (_intInput) {
+            value = intValue
+            intValueSelected(value)
+        } else if (_doubleInput) {
+            value = doubleValue
+            doubleValueSelected(value)
+        } else {
+            value = textValue
+            textValueSelected(value)
+        }
+        confirmed(value)
+        close()
+        Qt.callLater(function() { _suppressClosingCancel = false })
+    }
+
+    function cancelDialog() {
+        if (!visible)
+            return
+        _suppressClosingCancel = true
+        cancelled()
+        close()
+        Qt.callLater(function() { _suppressClosingCancel = false })
+    }
+
+    Item {
+        anchors.fill: parent
+
+        Label {
+            x: 24
+            y: 0
+            width: parent.width - 48
+            height: 20
+            text: root.labelText
+            color: root._primaryText
+            verticalAlignment: Text.AlignVCenter
+            wrapMode: Text.WordWrap
+        }
+
+        TextField {
+            id: lineEdit
+            x: 24
+            y: root._inputY
+            width: 288
+            height: 36
+            visible: root._singleLine
+            property bool transparent: false
+            text: root.textValue
+            placeholderText: root.placeholderText
+            echoMode: root.textEchoMode
+            selectByMouse: true
+            onTextChanged: root.textValue = text
+            onAccepted: root.acceptDialog()
+        }
+
+        TextArea {
+            id: plainTextEdit
+            x: 24
+            y: root._inputY
+            width: 256
+            height: 192
+            visible: root.usePlainTextEdit
+            property bool transparent: false
+            text: root.textValue
+            placeholderText: root.placeholderText
+            selectByMouse: true
+            wrapMode: TextEdit.NoWrap
+            clip: true
+            onTextChanged: root.textValue = text
+        }
+
+        SpinBox {
+            id: intSpinBox
+            x: 24
+            y: root._inputY
+            width: 288
+            height: 36
+            visible: root._intInput
+            property bool transparent: false
+            editable: true
+            from: root.intMinimum
+            to: root.intMaximum
+            stepSize: root.intStep
+            value: root.intValue
+            onValueChanged: root.intValue = value
+            Keys.onReturnPressed: root.acceptDialog()
+            Keys.onEnterPressed: root.acceptDialog()
+        }
+
+        SpinBox {
+            id: doubleSpinBox
+            x: 24
+            y: root._inputY
+            width: 288
+            height: 36
+            visible: root._doubleInput
+            property bool transparent: false
+            editable: true
+            from: Math.round(root.doubleMinimum * root._doubleFactor)
+            to: Math.round(root.doubleMaximum * root._doubleFactor)
+            stepSize: Math.max(1, Math.round(root.doubleStep * root._doubleFactor))
+            value: Math.round(root.doubleValue * root._doubleFactor)
+            validator: DoubleValidator {
+                bottom: Math.min(root.doubleMinimum, root.doubleMaximum)
+                top: Math.max(root.doubleMinimum, root.doubleMaximum)
+                decimals: root.doubleDecimals
+                notation: DoubleValidator.StandardNotation
+            }
+            textFromValue: function(value, locale) {
+                return Number(value / root._doubleFactor).toLocaleString(locale, "f", root.doubleDecimals)
+            }
+            valueFromText: function(text, locale) {
+                return Math.round(Number.fromLocaleString(locale, text) * root._doubleFactor)
+            }
+            onValueChanged: root.doubleValue = value / root._doubleFactor
+            Keys.onReturnPressed: root.acceptDialog()
+            Keys.onEnterPressed: root.acceptDialog()
+        }
+
+        Label {
+            x: 24
+            y: root._tipY
+            width: parent.width - 48
+            height: 19
+            text: root.tipText
+            color: "red"
+            verticalAlignment: Text.AlignVCenter
+            elide: Text.ElideRight
+            maximumLineCount: 1
+        }
+
+        Row {
+            x: parent.width - 24 - width
+            y: root._buttonY
+            visible: !root.noButtons
+            spacing: 10
+
+            Button {
+                width: 96
+                height: 36
+                property bool transparent: false
+                text: root.cancelButtonText
+                onClicked: root.cancelDialog()
+            }
+
+            Button {
+                width: 96
+                height: 36
+                property bool transparent: false
+                text: root.okButtonText
+                highlighted: true
+                enabled: root._numericInputAcceptable
+                onClicked: root.acceptDialog()
+            }
+        }
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KLabel.qml b/ukui-qml-style-helper/controls/qml/KLabel.qml
new file mode 100644
index 0000000..13d5974
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KLabel.qml
@@ -0,0 +1,382 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KLabel.
+ * 样式和颜色对齐 kysdk-qtwidgets/src/klabel.cpp。
+ */
+
+import QtQuick 2.12
+import QtGraphicalEffects 1.0
+import org.ukui.platformtheme.controls 1.0 as Private
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+Item {
+    id: root
+
+    enum LabelType { NormalType = 0, DataType = 1, CircleType = 2 }
+    // 与 QPalette::ColorRole 的数值保持一致，供 setFontColorRole() 使用。
+    enum FontColorRole {
+        WindowText = 0, Button = 1, Light = 2, Midlight = 3, Dark = 4,
+        Mid = 5, Text = 6, BrightText = 7, ButtonText = 8, Base = 9,
+        Window = 10, Shadow = 11, Highlight = 12, HighlightedText = 13,
+        Link = 14, LinkVisited = 15, AlternateBase = 16, NoRole = 17,
+        ToolTipBase = 18, ToolTipText = 19, PlaceholderText = 20
+    }
+
+    property int labelType: KLabel.LabelType.NormalType
+    property string text: ""
+    property string iconName: ""
+    property url iconSource: ""
+    property int iconWidth: 16
+    property int iconHeight: 16
+    property int iconSpacing: 4
+    property bool wordWrap: false
+    property int horizontalAlignment: Text.AlignLeft
+    property int verticalAlignment: Text.AlignVCenter
+    property int leftPadding: 0
+    property int topPadding: 0
+    property int rightPadding: 0
+    property int bottomPadding: 0
+    property font font: app.font
+
+    property bool dataHighlightColor: false
+    property bool backgroundColorEnabled: false
+    property color backgroundColor: "white"
+    property bool highlightBackground: false
+    property color fontColor: "transparent"
+    property bool customFontColor: false
+    property int fontColorRole: KLabel.FontColorRole.Text
+    property bool fontColorRoleEnabled: false
+    property bool tristate: false
+    property bool checked: false
+    property int topLeftRadius: 6
+    property int topRightRadius: 6
+    property int bottomLeftRadius: 6
+    property int bottomRightRadius: 6
+
+    signal enterWidget()
+    signal leaveWidget()
+    signal clicked(bool checked)
+    signal doubleClicked()
+
+    StylePrivate.APPParameter { id: app }
+    StylePrivate.ParseColorInterface { id: parseColor }
+
+    property color _textActive: "transparent"
+    property color _highlight: "transparent"
+    property color _button: "transparent"
+    property color _windowText: "transparent"
+    property color _placeholderText: "transparent"
+    property color _highlightedText: "transparent"
+    property color _brightText: "transparent"
+    property color _buttonText: "transparent"
+    property color _toolTipText: "transparent"
+    property color _light: "transparent"
+    property color _midlight: "transparent"
+    property color _dark: "transparent"
+    property color _mid: "transparent"
+    property color _base: "transparent"
+    property color _window: "transparent"
+    property color _shadow: "transparent"
+    property color _link: "transparent"
+    property color _linkVisited: "transparent"
+    property color _alternateBase: "transparent"
+    property color _toolTipBase: "transparent"
+
+    readonly property bool _hasIcon: iconName !== "" || iconSource !== ""
+    readonly property int _naturalContentWidth: (_hasIcon ? iconWidth + (text !== "" ? iconSpacing : 0) : 0)
+                                               + textItem.implicitWidth
+    readonly property int _naturalContentHeight: Math.max(_hasIcon ? iconHeight : 0, textItem.implicitHeight)
+    // DataType 使用主题高亮色的 15% 透明度作为底色。
+    readonly property color _dataBackground: Qt.rgba(_highlight.r, _highlight.g, _highlight.b, 0.15)
+    readonly property color _background: {
+        if (labelType === KLabel.LabelType.DataType)
+            return backgroundColorEnabled ? backgroundColor : _dataBackground
+        if (backgroundColorEnabled)
+            return backgroundColor
+        if (highlightBackground)
+            return _highlight
+        if (labelType === KLabel.LabelType.CircleType)
+            return _button
+        return "transparent"
+    }
+    readonly property color _roleColor: {
+        switch (fontColorRole) {
+        case KLabel.FontColorRole.WindowText: return _windowText
+        case KLabel.FontColorRole.Button: return _button
+        case KLabel.FontColorRole.Light: return _light
+        case KLabel.FontColorRole.Midlight: return _midlight
+        case KLabel.FontColorRole.Dark: return _dark
+        case KLabel.FontColorRole.Mid: return _mid
+        case KLabel.FontColorRole.BrightText: return _brightText
+        case KLabel.FontColorRole.ButtonText: return _buttonText
+        case KLabel.FontColorRole.Base: return _base
+        case KLabel.FontColorRole.Window: return _window
+        case KLabel.FontColorRole.Shadow: return _shadow
+        case KLabel.FontColorRole.Highlight: return _highlight
+        case KLabel.FontColorRole.HighlightedText: return _highlightedText
+        case KLabel.FontColorRole.Link: return _link
+        case KLabel.FontColorRole.LinkVisited: return _linkVisited
+        case KLabel.FontColorRole.AlternateBase: return _alternateBase
+        case KLabel.FontColorRole.ToolTipBase: return _toolTipBase
+        case KLabel.FontColorRole.ToolTipText: return _toolTipText
+        case KLabel.FontColorRole.PlaceholderText: return _placeholderText
+        default: return _textActive
+        }
+    }
+    // 三态标签悬浮/按下时，按原生逻辑混合高亮与亮文字色。
+    readonly property color _tristateHoverColor: _mixColor(_highlight, _brightText,
+                                                             interaction.pressed ? 0.2 : 0.05)
+    readonly property color _textColor: {
+        if (tristate)
+            return interaction.containsMouse ? _tristateHoverColor : _placeholderText
+        if (customFontColor)
+            return fontColor
+        if (fontColorRoleEnabled)
+            return _roleColor
+        if (dataHighlightColor)
+            return _highlight
+        return _textActive
+    }
+
+    implicitWidth: leftPadding + _naturalContentWidth + rightPadding
+    implicitHeight: topPadding + _naturalContentHeight + bottomPadding
+    clip: true
+
+    function _mixColor(first, second, bias) {
+        return Qt.rgba(first.r * (1 - bias) + second.r * bias,
+                       first.g * (1 - bias) + second.g * bias,
+                       first.b * (1 - bias) + second.b * bias,
+                       first.a * (1 - bias) + second.a * bias)
+    }
+
+    function _refreshColors() {
+        // ParseColorInterface 读取当前主题 token；主题切换后重新取色。
+        _textActive = parseColor.getDtColor("text-active")
+        _highlight = parseColor.getDtColor("highlight-active")
+        _button = parseColor.getDtColor("button-active")
+        _windowText = parseColor.getDtColor("windowtext-active")
+        _placeholderText = parseColor.getDtColor("placeholdertext-active")
+        _highlightedText = parseColor.getDtColor("highlightedtext-active")
+        _brightText = parseColor.getDtColor("brighttext-active")
+        _buttonText = parseColor.getDtColor("buttontext-active")
+        _toolTipText = parseColor.getDtColor("tooltiptext-active")
+        _light = parseColor.getDtColor("light-active")
+        _midlight = parseColor.getDtColor("midlight-active")
+        _dark = parseColor.getDtColor("dark-active")
+        _mid = parseColor.getDtColor("mid-active")
+        _base = parseColor.getDtColor("base-active")
+        _window = parseColor.getDtColor("window-active")
+        _shadow = parseColor.getDtColor("shadow-active")
+        _link = parseColor.getDtColor("link-active")
+        _linkVisited = parseColor.getDtColor("linkvisited-active")
+        _alternateBase = parseColor.getDtColor("alternatebase-active")
+        _toolTipBase = parseColor.getDtColor("tooltipbase-active")
+        backgroundCanvas.requestPaint()
+    }
+
+    function setLabelType(type) { labelType = type }
+    function setDataHightColor(flag) { dataHighlightColor = flag }
+    function setBackgroundColor(flag, color) {
+        highlightBackground = false
+        backgroundColorEnabled = flag
+        if (color !== undefined)
+            backgroundColor = color
+    }
+    function setHighlightBackground(flag) {
+        backgroundColorEnabled = false
+        highlightBackground = flag
+    }
+    function setBorderRadius(bottomLeft, topLeft, topRight, bottomRight) {
+        // 兼容原生的一参（统一圆角）和四参（分别设置圆角）重载。
+        if (arguments.length === 1) {
+            topLeftRadius = bottomLeft
+            topRightRadius = bottomLeft
+            bottomLeftRadius = bottomLeft
+            bottomRightRadius = bottomLeft
+            return
+        }
+        bottomLeftRadius = bottomLeft
+        topLeftRadius = topLeft
+        topRightRadius = topRight
+        bottomRightRadius = bottomRight
+    }
+    function setWordWrap(flag) { wordWrap = flag }
+    function setFontColor(color) {
+        fontColor = color
+        customFontColor = true
+        fontColorRoleEnabled = false
+    }
+    function setFontColorRole(role) {
+        fontColorRole = role
+        fontColorRoleEnabled = true
+        customFontColor = false
+    }
+    function setTristate(flag) {
+        tristate = flag
+        if (flag)
+            setFontColorRole(KLabel.FontColorRole.PlaceholderText)
+    }
+    function isTristate() { return tristate }
+    function setPixmap(icon, width, height) {
+        if (typeof icon === "string")
+            iconName = icon
+        if (width !== undefined)
+            iconWidth = width
+        if (height !== undefined)
+            iconHeight = height
+    }
+
+    Canvas {
+        id: backgroundCanvas
+        anchors.fill: parent
+        antialiasing: true
+
+        onPaint: {
+            var ctx = getContext("2d")
+            ctx.reset()
+            if (root._background === "transparent" || width <= 0 || height <= 0)
+                return
+
+            ctx.fillStyle = root._background
+            ctx.beginPath()
+            if (root.labelType === KLabel.LabelType.CircleType) {
+                // CircleType 按控件完整矩形绘制椭圆。
+                ctx.save()
+                ctx.translate(width / 2, height / 2)
+                ctx.scale(width / 2, height / 2)
+                ctx.arc(0, 0, 1, 0, Math.PI * 2, false)
+                ctx.restore()
+            } else {
+                var tl = Math.max(0, Math.min(root.topLeftRadius, width / 2, height / 2))
+                var tr = Math.max(0, Math.min(root.topRightRadius, width / 2, height / 2))
+                var br = Math.max(0, Math.min(root.bottomRightRadius, width / 2, height / 2))
+                var bl = Math.max(0, Math.min(root.bottomLeftRadius, width / 2, height / 2))
+                ctx.moveTo(tl, 0)
+                ctx.lineTo(width - tr, 0)
+                ctx.quadraticCurveTo(width, 0, width, tr)
+                ctx.lineTo(width, height - br)
+                ctx.quadraticCurveTo(width, height, width - br, height)
+                ctx.lineTo(bl, height)
+                ctx.quadraticCurveTo(0, height, 0, height - bl)
+                ctx.lineTo(0, tl)
+                ctx.quadraticCurveTo(0, 0, tl, 0)
+            }
+            ctx.closePath()
+            ctx.fill()
+        }
+    }
+
+    Item {
+        id: content
+        anchors.top: parent.top
+        anchors.bottom: parent.bottom
+        anchors.left: parent.left
+        anchors.leftMargin: root.leftPadding
+        anchors.right: parent.right
+        anchors.rightMargin: root.rightPadding
+
+        Item {
+            id: contentRow
+            width: root.wordWrap ? parent.width : Math.min(parent.width, root._naturalContentWidth)
+            height: parent.height
+            x: root.horizontalAlignment === Text.AlignRight ? parent.width - width
+              : root.horizontalAlignment === Text.AlignHCenter ? (parent.width - width) / 2 : 0
+
+            Private.KyIcon {
+                id: themedIcon
+                width: root.iconWidth
+                height: root.iconHeight
+                anchors.left: parent.left
+                anchors.verticalCenter: parent.verticalCenter
+                visible: root.iconName !== "" && !root.dataHighlightColor
+                iconName: root.iconName
+                icontype: "ordinary"
+            }
+
+            Image {
+                id: highlightIcon
+                width: root.iconWidth
+                height: root.iconHeight
+                anchors.left: parent.left
+                anchors.verticalCenter: parent.verticalCenter
+                visible: false
+                source: root.iconName !== "" ? "image://imageProvider/" + root.iconName + "/normal"
+                                             : root.iconSource
+                fillMode: Image.PreserveAspectFit
+                smooth: true
+                cache: false
+            }
+
+            // 数据高亮图标固定使用 highlight-active，与原生 KLabel 一致。
+            ColorOverlay {
+                anchors.fill: highlightIcon
+                visible: root.dataHighlightColor && root._hasIcon
+                source: highlightIcon
+                color: root._highlight
+            }
+
+            Image {
+                id: sourceIcon
+                width: root.iconWidth
+                height: root.iconHeight
+                anchors.left: parent.left
+                anchors.verticalCenter: parent.verticalCenter
+                visible: root.iconName === "" && root.iconSource !== "" && !root.dataHighlightColor
+                source: root.iconSource
+                fillMode: Image.PreserveAspectFit
+                smooth: true
+            }
+
+            Text {
+                id: textItem
+                anchors.left: parent.left
+                anchors.leftMargin: root._hasIcon ? root.iconWidth + (root.text !== "" ? root.iconSpacing : 0) : 0
+                anchors.right: parent.right
+                anchors.top: parent.top
+                anchors.bottom: parent.bottom
+                text: root.text
+                font: root.font
+                color: root._textColor
+                wrapMode: root.wordWrap ? Text.WordWrap : Text.NoWrap
+                elide: root.wordWrap ? Text.ElideNone : Text.ElideRight
+                horizontalAlignment: root._hasIcon ? Text.AlignLeft : root.horizontalAlignment
+                verticalAlignment: root.verticalAlignment
+            }
+        }
+    }
+
+    MouseArea {
+        id: interaction
+        anchors.fill: parent
+        hoverEnabled: true
+        acceptedButtons: Qt.LeftButton
+        onEntered: root.enterWidget()
+        onExited: root.leaveWidget()
+        onReleased: {
+            // 原生 KLabel 每次左键释放切换一次 clicked 状态。
+            if (mouse.button === Qt.LeftButton) {
+                root.checked = !root.checked
+                root.clicked(root.checked)
+            }
+        }
+        onDoubleClicked: root.doubleClicked()
+    }
+
+    Component.onCompleted: _refreshColors()
+    onLabelTypeChanged: backgroundCanvas.requestPaint()
+    onBackgroundColorEnabledChanged: backgroundCanvas.requestPaint()
+    onBackgroundColorChanged: backgroundCanvas.requestPaint()
+    onHighlightBackgroundChanged: backgroundCanvas.requestPaint()
+    onTopLeftRadiusChanged: backgroundCanvas.requestPaint()
+    onTopRightRadiusChanged: backgroundCanvas.requestPaint()
+    onBottomLeftRadiusChanged: backgroundCanvas.requestPaint()
+    onBottomRightRadiusChanged: backgroundCanvas.requestPaint()
+    onWidthChanged: backgroundCanvas.requestPaint()
+    onHeightChanged: backgroundCanvas.requestPaint()
+
+    Connections {
+        target: app
+        function onParametryChanged() { root._refreshColors() }
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KNavigationBar.qml b/ukui-qml-style-helper/controls/qml/KNavigationBar.qml
new file mode 100644
index 0000000..2dcb58e
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KNavigationBar.qml
@@ -0,0 +1,581 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KNavigationBar。
+ * 普通项 / 次级项：复用 qqc2style ItemDelegate（hover/高亮/禁用/焦点）；
+ * 当前项：highlightOnly + highlighted（不用 checked）；Tag 无底。
+ * 走焦：FocusScope + ListView + ItemDelegate focusHandling；↑↓ 跳过 Tag/禁用/折叠。
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Layouts 1.15
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+FocusScope {
+    id: control
+
+    enum ItemType { StandardItem = 0, SubItem = 1, TagItem = 2 }
+    enum DataType { ValueRole = 256, StringRole = 257, BoolRole = 258 }
+
+    // [{ text, icon, type: 0/1/2, enabled, tag, tabValue, addVisible, extendVisible, expanded, addIcon }]
+    property var items: []
+    property bool tabValueVisible: false
+    property int currentIndex: -1
+
+    property font font: app.font
+    property var palette: app.palette
+
+    // Tab 进入本控件，落到内部 ListView
+    activeFocusOnTab: true
+    implicitWidth: 240
+    implicitHeight: 400
+
+    signal addTagClicked(string tag)
+    signal extendClicked(string tag, int row)
+    signal currentChanged(int index)
+
+    StylePrivate.APPParameter {
+        id: app
+        onParametryChanged: control._reloadIcons()
+        onIconThemeChanged: control._reloadIcons()
+    }
+
+    readonly property bool _hasToken: typeof ukui_platformtheme_token !== "undefined"
+                                      && ukui_platformtheme_token
+    readonly property color _fontPrimary: _hasToken
+                                          ? ukui_platformtheme_token.kFontPrimary
+                                          : (palette ? palette.windowText : "#000000")
+    readonly property color _fontPrimaryDisable: _hasToken
+                                                 ? ukui_platformtheme_token.kFontPrimaryDisable
+                                                 : "#999999"
+    readonly property color _fontSecondary: _hasToken
+                                            ? ukui_platformtheme_token.kFontSecondary
+                                            : "#8C8C8C"
+    readonly property color _fontHighlight: _hasToken
+                                            ? ukui_platformtheme_token.kFontWhite
+                                            : "#FFFFFF"
+    readonly property color _kWhite: _hasToken
+                                     ? ukui_platformtheme_token.kWhite
+                                     : "#FFFFFF"
+
+    property int iconRev: 0
+    function _reloadIcons() { iconRev++ }
+
+    function _copyItems() {
+        var a = []
+        for (var i = 0; i < items.length; i++)
+            a.push(Object.assign({}, items[i]))
+        return a
+    }
+
+    function _setItems(a) { items = a }
+
+    function _rowVisible(it) {
+        if (!it)
+            return false
+        if (it.type === KNavigationBar.TagItem)
+            return true
+        return it.expanded !== false
+    }
+
+    function _resolveIconUrl(name, selected, enabled) {
+        if (!name || name === "")
+            return ""
+        var s = String(name)
+        var prefix = "image://imageProvider/"
+        if (s.indexOf(prefix) === 0) {
+            var path = s.substring(prefix.length)
+            var slash = path.lastIndexOf("/")
+            if (slash >= 0) {
+                var model = path.substring(slash + 1)
+                if (model === "normal" || model === "disenable" || model === "clicked"
+                        || model === "hover" || model === "highlight" || model === "highDisbale"
+                        || model === "hoveredWidthThemeColor" || model === "clickedWidthThemeColor"
+                        || model === "normalWidthThemeColor" || model === "disableWidthThemeColor")
+                    path = path.substring(0, slash)
+            }
+            s = path
+        }
+        var mode
+        if (enabled === false)
+            mode = selected ? "highDisbale" : "disableWidthThemeColor"
+        else if (selected)
+            mode = "highlight"
+        else
+            mode = "normalWidthThemeColor"
+        return prefix + s + "/" + mode
+    }
+
+    function _tagIconUrl(name) {
+        return _resolveIconUrl(name || "list-add-symbolic", false, true)
+    }
+
+    function _isSelectable(it) {
+        if (!it || it.type === KNavigationBar.TagItem)
+            return false
+        if (it.enabled === false)
+            return false
+        return control._rowVisible(it)
+    }
+
+    function _nextSelectable(from, step) {
+        var i = from + step
+        while (i >= 0 && i < control.items.length) {
+            if (control._isSelectable(control.items[i]))
+                return i
+            i += step
+        }
+        return -1
+    }
+
+    function _findTagIndex(a, tag) {
+        for (var i = 0; i < a.length; i++) {
+            if (a[i].type === KNavigationBar.TagItem && a[i].text === tag)
+                return i
+        }
+        return -1
+    }
+
+    function _toggleGroup(tag, tagRow) {
+        var a = _copyItems()
+        var ti = _findTagIndex(a, tag)
+        if (ti < 0)
+            return
+        var currentlyExpanded = a[ti].expanded !== false
+        var nextExpanded = !currentlyExpanded
+        a[ti].expanded = nextExpanded
+        var clearCurrent = false
+        for (var i = 0; i < a.length; i++) {
+            if (a[i].type !== KNavigationBar.TagItem && a[i].tag === tag) {
+                a[i].expanded = nextExpanded
+                if (!nextExpanded && i === control.currentIndex)
+                    clearCurrent = true
+            }
+        }
+        _setItems(a)
+        if (clearCurrent)
+            control.currentIndex = -1
+        control.extendClicked(tag, tagRow)
+    }
+
+    // FocusScope 获焦后把焦点交给 ListView
+    onActiveFocusChanged: {
+        if (activeFocus && !lv.activeFocus)
+            lv.forceActiveFocus()
+    }
+
+    ListView {
+        id: lv
+        anchors.fill: parent
+        model: control.items
+        clip: true
+        spacing: 4
+        currentIndex: control.currentIndex
+        boundsBehavior: Flickable.StopAtBounds
+        // 由外层 FocusScope 进焦；ListView 持焦以驱动 ItemDelegate 焦点框
+        activeFocusOnTab: false
+        keyNavigationEnabled: false
+        focus: true
+
+        onActiveFocusChanged: {
+            if (!activeFocus)
+                return
+            if (currentIndex < 0 || !control._isSelectable(control.items[currentIndex])) {
+                var i = control._nextSelectable(-1, 1)
+                if (i >= 0)
+                    currentIndex = i
+            }
+        }
+
+        // ListView 持焦时（Tab 进入、未点选 take）的 ↑↓，需跳过 Tag
+        Keys.onPressed: {
+            if (event.key === Qt.Key_Down) {
+                var n = control._nextSelectable(currentIndex, 1)
+                if (n >= 0)
+                    currentIndex = n
+                event.accepted = true
+            } else if (event.key === Qt.Key_Up) {
+                var p = control._nextSelectable(currentIndex, -1)
+                if (p >= 0)
+                    currentIndex = p
+                event.accepted = true
+            } else if (event.key === Qt.Key_Space
+                       || event.key === Qt.Key_Return
+                       || event.key === Qt.Key_Enter) {
+                if (currentItem && currentItem.keyboardPressing !== undefined)
+                    currentItem.keyboardPressing = true
+                event.accepted = true
+            }
+        }
+        Keys.onReleased: {
+            if (event.key === Qt.Key_Space
+                    || event.key === Qt.Key_Return
+                    || event.key === Qt.Key_Enter) {
+                if (currentItem && currentItem.keyboardPressing !== undefined)
+                    currentItem.keyboardPressing = false
+                event.accepted = true
+            }
+        }
+
+        onCurrentIndexChanged: {
+            if (control.currentIndex !== currentIndex)
+                control.currentIndex = currentIndex
+            control.currentChanged(currentIndex)
+        }
+
+        Connections {
+            target: control
+            function onCurrentIndexChanged() {
+                if (lv.currentIndex !== control.currentIndex)
+                    lv.currentIndex = control.currentIndex
+            }
+        }
+
+        delegate: ItemDelegate {
+            id: del
+            width: lv.width
+
+            property var rowData: modelData
+            property int rowIndex: index
+            readonly property bool isCurrent: ListView.isCurrentItem
+            readonly property bool isTag: rowData && rowData.type === KNavigationBar.TagItem
+            readonly property bool isSub: rowData && rowData.type === KNavigationBar.SubItem
+            // 供 ItemDelegate focusHandling ↑↓ 跳过 Tag
+            property bool focusNavigable: !isTag
+
+            height: control._rowVisible(rowData)
+                    ? (isTag ? (rowIndex === 0 ? 36 : 48) : 40)
+                    : 0
+            visible: height > 0
+
+            padding: 0
+            leftPadding: 0
+            rightPadding: 0
+            topPadding: 0
+            bottomPadding: 0
+            property bool focusHandling: true
+            property bool highlightOnly: true
+
+            highlighted: !isTag && isCurrent
+            checked: false
+            hoverEnabled: !isTag
+            enabled: isTag ? true : (rowData && rowData.enabled !== false)
+
+            onClicked: {
+                if (!isTag && rowData && rowData.enabled !== false)
+                    lv.currentIndex = rowIndex
+            }
+
+            Binding {
+                target: del.background
+                property: "visible"
+                value: !del.isTag
+                when: del.background !== null
+            }
+
+            contentItem: Item {
+                anchors.fill: parent
+
+                // 普通 / 次级
+                RowLayout {
+                    anchors.fill: parent
+                    anchors.leftMargin: del.isSub ? 32 : 16
+                    anchors.rightMargin: 16
+                    spacing: 8
+                    visible: !del.isTag
+
+                    Image {
+                        id: rowIcon
+                        visible: !del.isSub && !!del.rowData && !!del.rowData.icon
+                                 && status === Image.Ready
+                        sourceSize.width: 16
+                        sourceSize.height: 16
+                        Layout.preferredWidth: (!del.isSub && del.rowData && del.rowData.icon) ? 16 : 0
+                        Layout.preferredHeight: 16
+                        Layout.alignment: Qt.AlignVCenter
+                        fillMode: Image.PreserveAspectFit
+                        smooth: true
+                        cache: false
+
+                        // 主题 / 选中 / 禁用变化时重刷（避免 Connections 与 ItemDelegate 信号重名）
+                        readonly property string _iconKey: [
+                            control.iconRev,
+                            del.rowData ? (del.rowData.icon || "") : "",
+                            del.highlighted ? 1 : 0,
+                            del.enabled ? 1 : 0
+                        ].join(":")
+
+                        on_IconKeyChanged: reload()
+                        Component.onCompleted: reload()
+
+                        function reload() {
+                            if (del.isSub || !del.rowData || !del.rowData.icon) {
+                                source = ""
+                                return
+                            }
+                            var url = control._resolveIconUrl(del.rowData.icon, del.highlighted, del.enabled)
+                            source = ""
+                            source = url
+                        }
+                    }
+
+                    Label {
+                        text: (del.rowData && del.rowData.text) ? del.rowData.text : ""
+                        font: control.font
+                        elide: Text.ElideRight
+                        Layout.fillWidth: true
+                        Layout.alignment: Qt.AlignVCenter
+                        color: !del.enabled
+                               ? control._fontPrimaryDisable
+                               : (del.highlighted
+                                  ? control._fontHighlight
+                                  : control._fontPrimary)
+                    }
+
+                    Label {
+                        visible: !!(control.tabValueVisible
+                                 && del.rowData
+                                 && del.rowData.tabValue !== undefined
+                                 && String(del.rowData.tabValue) !== "")
+                        text: (del.rowData && del.rowData.tabValue) ? del.rowData.tabValue : ""
+                        font: control.font
+                        Layout.alignment: Qt.AlignVCenter
+                        color: del.highlighted
+                               ? control._kWhite
+                               : Qt.rgba(control._fontPrimary.r,
+                                         control._fontPrimary.g,
+                                         control._fontPrimary.b, 0.4)
+                    }
+                }
+
+                // Tag
+                RowLayout {
+                    anchors.fill: parent
+                    anchors.leftMargin: 16
+                    anchors.rightMargin: 16
+                    anchors.topMargin: del.rowIndex === 0 ? 0 : 12
+                    spacing: 8
+                    visible: del.isTag
+
+                    Label {
+                        text: (del.rowData && del.rowData.text) ? del.rowData.text : ""
+                        font: control.font
+                        color: control._fontSecondary
+                        elide: Text.ElideRight
+                        Layout.fillWidth: true
+                        Layout.alignment: Qt.AlignVCenter
+                    }
+
+                    Item {
+                        visible: !!(del.rowData && del.rowData.addVisible)
+                        Layout.preferredWidth: visible ? 24 : 0
+                        Layout.preferredHeight: 24
+                        Layout.alignment: Qt.AlignVCenter
+                        z: 1
+
+                        Rectangle {
+                            anchors.fill: parent
+                            radius: 6
+                            color: addMa.pressed
+                                   ? Qt.rgba(control.palette.buttonText.r,
+                                             control.palette.buttonText.g,
+                                             control.palette.buttonText.b, 0.2)
+                                   : (addMa.containsMouse
+                                      ? Qt.rgba(control.palette.buttonText.r,
+                                                control.palette.buttonText.g,
+                                                control.palette.buttonText.b, 0.05)
+                                      : "transparent")
+                        }
+                        Image {
+                            id: addIconImg
+                            anchors.centerIn: parent
+                            sourceSize.width: 16
+                            sourceSize.height: 16
+                            smooth: true
+                            cache: false
+                            readonly property string _iconKey: control.iconRev + ":"
+                                    + ((del.rowData && del.rowData.addIcon) ? del.rowData.addIcon : "list-add-symbolic")
+                            on_IconKeyChanged: reload()
+                            Component.onCompleted: reload()
+                            function reload() {
+                                var n = (del.rowData && del.rowData.addIcon)
+                                        ? del.rowData.addIcon : "list-add-symbolic"
+                                var url = control._tagIconUrl(n)
+                                source = ""
+                                source = url
+                            }
+                        }
+                        MouseArea {
+                            id: addMa
+                            anchors.fill: parent
+                            hoverEnabled: true
+                            cursorShape: Qt.PointingHandCursor
+                            onClicked: control.addTagClicked(del.rowData.text)
+                        }
+                        ToolTip.visible: addMa.containsMouse
+                        ToolTip.text: qsTr("Add tag")
+                        ToolTip.delay: 500
+                    }
+
+                    Item {
+                        visible: !!(del.rowData && del.rowData.extendVisible)
+                        Layout.preferredWidth: visible ? 24 : 0
+                        Layout.preferredHeight: 24
+                        Layout.alignment: Qt.AlignVCenter
+                        z: 1
+
+                        Rectangle {
+                            anchors.fill: parent
+                            radius: 6
+                            color: extMa.pressed
+                                   ? Qt.rgba(control.palette.buttonText.r,
+                                             control.palette.buttonText.g,
+                                             control.palette.buttonText.b, 0.2)
+                                   : (extMa.containsMouse
+                                      ? Qt.rgba(control.palette.buttonText.r,
+                                                control.palette.buttonText.g,
+                                                control.palette.buttonText.b, 0.05)
+                                      : "transparent")
+                        }
+                        Image {
+                            id: extIconImg
+                            anchors.centerIn: parent
+                            sourceSize.width: 16
+                            sourceSize.height: 16
+                            smooth: true
+                            cache: false
+                            readonly property string _iconKey: control.iconRev + ":"
+                                    + ((del.rowData && del.rowData.expanded !== false) ? "up" : "down")
+                            on_IconKeyChanged: reload()
+                            Component.onCompleted: reload()
+                            function reload() {
+                                var n = (del.rowData && del.rowData.expanded !== false)
+                                        ? "ukui-up.symbolic" : "ukui-down.symbolic"
+                                var url = control._tagIconUrl(n)
+                                source = ""
+                                source = url
+                            }
+                        }
+                        MouseArea {
+                            id: extMa
+                            anchors.fill: parent
+                            hoverEnabled: true
+                            cursorShape: Qt.PointingHandCursor
+                            onClicked: control._toggleGroup(del.rowData.text, del.rowIndex)
+                        }
+                        ToolTip.visible: extMa.containsMouse
+                        ToolTip.text: (del.rowData && del.rowData.expanded !== false)
+                                      ? qsTr("Fold") : qsTr("Expand")
+                        ToolTip.delay: 500
+                    }
+                }
+            }
+        }
+
+        // 内容未超出高度时隐藏（UKUI ScrollBar：非 AlwaysOff 即显示）
+        ScrollBar.horizontal: ScrollBar { policy: ScrollBar.AlwaysOff }
+        ScrollBar.vertical: ScrollBar {
+            policy: lv.contentHeight > lv.height ? ScrollBar.AsNeeded : ScrollBar.AlwaysOff
+        }
+    }
+
+    // —— API（对齐 C++）——
+    function addItem(it) {
+        var a = _copyItems()
+        var row = Object.assign({ type: KNavigationBar.StandardItem, expanded: true }, it)
+        row.type = KNavigationBar.StandardItem
+        a.push(row)
+        _setItems(a)
+    }
+    function addSubItem(it) {
+        var a = _copyItems()
+        var row = Object.assign({ type: KNavigationBar.SubItem, expanded: true }, it)
+        row.type = KNavigationBar.SubItem
+        a.push(row)
+        _setItems(a)
+    }
+    function addGroupItems(list, tag) {
+        var a = _copyItems()
+        a.push({ text: tag, type: KNavigationBar.TagItem, expanded: true,
+                 addVisible: false, extendVisible: false })
+        for (var i = 0; i < list.length; i++) {
+            var row = Object.assign({ type: KNavigationBar.StandardItem, expanded: true }, list[i])
+            row.type = KNavigationBar.StandardItem
+            row.tag = tag
+            row.expanded = true
+            a.push(row)
+        }
+        _setItems(a)
+    }
+    function insertGroupItems(tag, row, it) {
+        var a = _copyItems()
+        var ti = _findTagIndex(a, tag)
+        if (ti < 0)
+            return
+        var insertAt = ti + 1 + row
+        var groupExpanded = a[ti].expanded !== false
+        var n = Object.assign({ type: KNavigationBar.StandardItem }, it)
+        n.type = KNavigationBar.StandardItem
+        n.tag = tag
+        n.expanded = groupExpanded
+        if (insertAt > a.length)
+            insertAt = a.length
+        a.splice(insertAt, 0, n)
+        _setItems(a)
+    }
+    function removeGroupItem(tag, predicate) {
+        // predicate: object 引用匹配 text，或 string 匹配 text
+        var a = _copyItems()
+        var key = typeof predicate === "string" ? predicate
+                : (predicate && predicate.text !== undefined ? predicate.text : "")
+        for (var i = a.length - 1; i >= 0; i--) {
+            if (a[i].tag === tag && a[i].type !== KNavigationBar.TagItem
+                    && a[i].text === key) {
+                a.splice(i, 1)
+                break
+            }
+        }
+        _setItems(a)
+    }
+    function addTag(tag) {
+        var a = _copyItems()
+        a.push({ text: tag, type: KNavigationBar.TagItem, expanded: true,
+                 addVisible: false, extendVisible: false })
+        _setItems(a)
+    }
+    function setTabValue(itemOrText, value) {
+        var key = typeof itemOrText === "string" ? itemOrText
+                : (itemOrText && itemOrText.text !== undefined ? itemOrText.text : "")
+        var a = _copyItems()
+        for (var i = 0; i < a.length; i++) {
+            if (a[i].text === key && a[i].type !== KNavigationBar.TagItem) {
+                a[i].tabValue = value
+                break
+            }
+        }
+        _setItems(a)
+    }
+    function setTabValueVisible(v) { tabValueVisible = v }
+    function setAddIcon(tag, iconName) {
+        var a = _copyItems()
+        var ti = _findTagIndex(a, tag)
+        if (ti >= 0)
+            a[ti].addIcon = iconName
+        _setItems(a)
+    }
+    function setAddTagVisible(tag, v) {
+        var a = _copyItems()
+        var ti = _findTagIndex(a, tag)
+        if (ti >= 0)
+            a[ti].addVisible = v
+        _setItems(a)
+    }
+    function setExtendTagVisible(tag, v) {
+        var a = _copyItems()
+        var ti = _findTagIndex(a, tag)
+        if (ti >= 0)
+            a[ti].extendVisible = v
+        _setItems(a)
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KPopup.qml b/ukui-qml-style-helper/controls/qml/KPopup.qml
new file mode 100644
index 0000000..00ae95d
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KPopup.qml
@@ -0,0 +1,285 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * Copyright (C) 2023, KylinSoft Co., Ltd.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 3 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this library.  If not, see <https://www.gnu.org/licenses/>.
+ *
+ * Authors: Jing Tan <tanjing@kylinos.cn>
+ *
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Window 2.12
+import QtQuick.Templates 2.12 as T
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+import org.ukui.platformtheme.controls 1.0 as PlatformthemeControls
+
+/// 带窗管毛玻璃效果的通用 Popup。
+/// 内容通过 default property 放入独立 Window，由 PopupHandle 调用 compositor 模糊。
+T.Popup {
+    id: control
+
+    palette: app.palette
+    font: app.font
+
+    default property alias content: windowContent.data
+
+    /// true 时使用 transparentBC 半透明色（配合毛玻璃）；false 时使用实色 backColor
+    property bool transparent: true
+
+    /// 背景不透明度，未设置时跟随 app.menuTransparency
+    property real backOpacity: -1
+
+    /// false 时毛玻璃 Window 使用 ToolTip 标志，不抢键盘焦点（适合补全/搜索下拉）
+    property bool acceptFocus: false//focus
+
+    /// acceptFocus 为 false 时，popup 显示后将焦点还回此控件
+    property Item focusTarget: null
+
+    /// false 时关闭/打开无渐变动画（适合搜索补全等需即时消失的场景）
+    property bool animated: true
+
+    readonly property bool isTransaprent: transparent
+
+    readonly property real _opacity: backOpacity >= 0 ? backOpacity : app.menuTransparency
+
+    padding: ukuiPopup.padding
+    topMargin: 6
+    bottomMargin: 6
+    clip: false
+    closePolicy: T.Popup.CloseOnEscape | T.Popup.CloseOnPressOutsideParent | T.Popup.CloseOnReleaseOutsideParent
+
+    readonly property int _contentWidth: Math.max(windowContent.implicitWidth, windowContent.width)
+    readonly property int _contentHeight: Math.max(windowContent.implicitHeight, windowContent.height)
+
+    implicitWidth: _contentWidth > 0 ? _contentWidth + leftPadding + rightPadding : 0
+    implicitHeight: _contentHeight > 0 ? _contentHeight + topPadding + bottomPadding : 0
+
+    // 外层 Popup 仅负责定位与生命周期，实际内容由 windowContent 承载
+    contentItem: Item {
+        visible: false
+        width: 0
+        height: 0
+    }
+
+    function getStartColor(dtcolor) {
+        return parseInterface.startColor(dtcolor)
+    }
+
+    function syncWindowPosition() {
+        if (!visible || !parent)
+            return
+        var p = parent.mapToGlobal(x, y)
+        var wx = p.x - (control.mirrored ? popupWindow.width : 0)
+        if (popupWindow.x !== wx)
+            popupWindow.x = wx
+        if (popupWindow.y !== p.y)
+            popupWindow.y = p.y
+    }
+
+    function syncWindowSize() {
+        var w = control.width > 0 ? control.width
+              : Math.max(implicitWidth, _contentWidth + leftPadding + rightPadding, 1)
+        var h = control.height > 0 ? control.height
+              : Math.max(implicitHeight, _contentHeight + topPadding + bottomPadding, 1)
+        if (popupWindow.width !== w)
+            popupWindow.width = w
+        if (popupWindow.height !== h)
+            popupWindow.height = h
+    }
+
+    function constrainToScreen() {
+        var size = popHandle.getScreenSize()
+        var p = popHandle.getScreenPoint()
+
+        if (popupWindow.x + popupWindow.width > size.width + p.x) {
+            var nx = size.width + p.x - popupWindow.width
+            if (nx >= p.x)
+                popupWindow.x = nx
+        }
+        if (popupWindow.y + popupWindow.height >= size.height + p.y) {
+            var maxH = size.height + p.y - popupWindow.y
+            if (maxH > 0 && control.height <= 0 && popupWindow.height > maxH)
+                popupWindow.height = maxH
+        }
+    }
+
+    onVisibleChanged: {
+        if (visible) {
+            syncWindowSize()
+            syncWindowPosition()
+            popupWindow.show()
+            if (!acceptFocus)
+                Qt.callLater(restoreFocusTarget)
+        } else {
+            popupWindow.hide()
+        }
+        if (popupWindow.visible !== visible)
+            popupWindow.visible = visible
+    }
+
+    function restoreFocusTarget() {
+        if (focusTarget) {
+            focusTarget.forceActiveFocus()
+            return
+        }
+        var item = control.parent
+        while (item) {
+            if (item.hasOwnProperty("forceActiveFocus")) {
+                item.forceActiveFocus()
+                return
+            }
+            item = item.parent
+        }
+    }
+
+    onXChanged: syncWindowPosition()
+    onYChanged: syncWindowPosition()
+
+    onWidthChanged: {
+        if (visible && control.width > 0 && popupWindow.width !== control.width)
+            popupWindow.width = control.width
+    }
+
+    onHeightChanged: {
+        if (visible && control.height > 0 && popupWindow.height !== control.height)
+            popupWindow.height = control.height
+    }
+
+    Connections {
+        target: windowContent
+        function onImplicitWidthChanged() {
+            if (control.visible && control.width <= 0)
+                control.syncWindowSize()
+        }
+        function onImplicitHeightChanged() {
+            if (control.visible && control.height <= 0)
+                control.syncWindowSize()
+        }
+    }
+
+    Connections {
+        target: popupWindow
+        function onWidthChanged() {
+            if (control.parent && control.visible)
+                control.syncWindowPosition()
+        }
+    }
+
+    enter: Transition {
+        NumberAnimation {
+            property: "opacity"
+            from: control.animated ? 0 : 1
+            to: 1
+            easing.type: Easing.InOutQuad
+            duration: control.animated ? 250 : 0
+        }
+    }
+
+    exit: Transition {
+        NumberAnimation {
+            property: "opacity"
+            from: 1
+            to: control.animated ? 0 : 1
+            easing.type: Easing.InOutQuad
+            duration: control.animated ? 250 : 0
+        }
+    }
+
+    onAboutToHide: popupWindow.hide()
+
+    StylePrivate.UKUIPopup {
+        id: ukuiPopup
+    }
+
+    StylePrivate.APPParameter {
+        id: app
+    }
+
+    StylePrivate.ParseColorInterface {
+        id: parseInterface
+    }
+
+    background: Item {
+        implicitWidth: popupWindow.width
+        implicitHeight: popupWindow.height
+
+        Window {
+            id: popupWindow
+            visible: control.visible
+            color: "transparent"
+
+            onWidthChanged: control.constrainToScreen()
+            onHeightChanged: control.constrainToScreen()
+
+            onVisibleChanged: {
+                if (visible) {
+                    control.syncWindowSize()
+                    if (width <= 0)
+                        width = 1
+                    if (height <= 0)
+                        height = 1
+                }
+                if (control.visible !== visible)
+                    control.visible = visible
+            }
+
+            PlatformthemeControls.UKUIPopupHandle {
+                id: popHandle
+//                blur: true
+                titlebarVisible: false
+                acceptFocus: control.acceptFocus
+                anchors.fill: parent
+                visible: parent.visible
+                radius: ukuiPopup.radius
+            }
+
+            Rectangle {
+                id: popRec
+                anchors.fill: parent
+                radius: _opacity >= 1 ? ukuiPopup.radius : 0
+                color: {
+                    var baccolor = getStartColor(isTransaprent ? ukuiPopup.transparentBC : ukuiPopup.backColor)
+                    return Qt.rgba(baccolor.r, baccolor.g, baccolor.b, _opacity)
+                }
+            }
+
+            Item {
+                id: windowContent
+                anchors.fill: parent
+                anchors.leftMargin: control.leftPadding
+                anchors.rightMargin: control.rightPadding
+                anchors.topMargin: control.topPadding
+                anchors.bottomMargin: control.bottomPadding
+                visible: popupWindow.visible
+                focus: false
+            }
+
+            Shortcut {
+                sequence: "Escape"
+                onActivated: control.close()
+            }
+
+            Connections {
+                target: Qt.application
+                function onStateChanged() {
+                    if (!Qt.application.active)
+                        control.close()
+                }
+            }
+        }
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KProgressBar.qml b/ukui-qml-style-helper/controls/qml/KProgressBar.qml
new file mode 100644
index 0000000..ecc2b32
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KProgressBar.qml
@@ -0,0 +1,275 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KProgressBar。
+ * 内部复用 org.ukui.style ProgressBar（背景/填充/居中文字/扫光/indeterminate）；
+ * 本控件补充：三态、label 位置、外侧图标，以及 bodyWidth / format / 自定义色等接口。
+ *
+ * 规则：
+ *  - Center：仅居中百分比文字，不会有图标
+ *  - End：文本/图标都在条外（水平右侧，竖直下方）；成功/失败显示图标
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Layouts 1.15
+import QtQuick.Templates 2.12 as T
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+T.Control {
+    id: control
+
+    enum State { NormalProgress = 0, FailedProgress = 1, SuccessProgress = 2 }
+    /// Center：百分比居中叠在条上（无图标）；End：文本/图标在条外
+    enum LabelPosition { Center = 0, End = 1 }
+
+    property int state: KProgressBar.State.NormalProgress
+    property int orientation: Qt.Horizontal
+    property int labelPosition: KProgressBar.LabelPosition.Center
+    property bool textVisible: true
+    property bool animationEnabled: false
+    property bool indeterminate: false
+    /// 与 QProgressBar::format 一致，支持 %p / %v / %m
+    property string format: "%p%"
+    /// 槽厚度；0 表示用样式默认
+    property int bodyWidth: 0
+    /// 反向填充（从右/上往左/下）
+    property bool invertedAppearance: false
+    /// 自定义双色渐变（Normal 态）
+    property bool gradation: false
+    property var gradationColor1: null
+    property var gradationColor2: null
+    /// 自定义背景 / 填充（null 表示跟主题）
+    property var backgroundColor: null
+    property var fillColor: null
+
+    property real from: 0
+    property real to: 100
+    property real value: 0
+
+    font: app.font
+    palette: app.palette
+
+    readonly property bool _horizontal: orientation === Qt.Horizontal
+    readonly property int _barThickness: bodyWidth > 0 ? bodyWidth : (_horizontal ? 30 : 0)
+    implicitWidth: _horizontal ? 240 : Math.max(48, _barThickness > 0 ? _barThickness + 16 : 48)
+    implicitHeight: _horizontal ? Math.max(30, _barThickness) : 220
+
+    StylePrivate.APPParameter { id: app }
+    StylePrivate.ParseColorInterface { id: parseColor }
+
+    readonly property bool _hasToken: typeof ukui_platformtheme_token !== "undefined"
+                                      && ukui_platformtheme_token
+
+    readonly property bool _isNormal: state === KProgressBar.State.NormalProgress
+    readonly property bool _isFailed: state === KProgressBar.State.FailedProgress
+    readonly property bool _isSuccess: state === KProgressBar.State.SuccessProgress
+    readonly property bool _labelAtEnd: labelPosition === KProgressBar.LabelPosition.End
+
+    readonly property bool _barTextVisible: textVisible && _isNormal && !indeterminate
+                                            && !_labelAtEnd
+    readonly property bool _sideTextVisible: textVisible && _isNormal && !indeterminate
+                                            && _labelAtEnd
+    readonly property bool _sideIconVisible: textVisible && (_isFailed || _isSuccess)
+                                             && !indeterminate && _labelAtEnd
+
+    readonly property color _sideTextColor: {
+        if (!enabled) {
+            if (_hasToken)
+                return ukui_platformtheme_token.kFontPrimaryDisable
+            return parseColor.getDtColor("kfont-primary-disable")
+        }
+        return palette.windowText
+    }
+
+    readonly property string _statusIcon: {
+        if (_isFailed)
+            return "image://imageProvider/dialog-error/normal"
+        if (_isSuccess)
+            return "image://imageProvider/ukui-dialog-success/normal"
+        return ""
+    }
+
+    /// 对应 C++ text()：按 format 替换 %p/%v/%m
+    readonly property string displayText: {
+        if (!_isNormal || indeterminate)
+            return ""
+        var total = to - from
+        var p = total <= 0 ? 100 : Math.round((value - from) * 100.0 / total)
+        var v = Math.round(value)
+        var m = Math.round(total)
+        var result = format
+        // 与 QProgressBar 替换顺序一致：%m → %v → %p
+        result = result.split("%m").join("" + m)
+        result = result.split("%v").join("" + v)
+        result = result.split("%p").join("" + p)
+        return result
+    }
+
+    readonly property bool _useCustomFill: {
+        if (_isFailed || _isSuccess)
+            return false
+        if (gradation && gradationColor1)
+            return true
+        if (fillColor)
+            return true
+        return false
+    }
+
+    /// 传给内部 ProgressBar 的填充（含三态主题色）
+    property var progressChildrenColor: {
+        if (_isFailed) {
+            if (_hasToken)
+                return ukui_platformtheme_token.kErrorNormal
+            return parseColor.getDtColor("kerror-normal")
+        }
+        if (_isSuccess) {
+            if (_hasToken)
+                return ukui_platformtheme_token.kSuccessNormal
+            return parseColor.getDtColor("ksuccess-normal")
+        }
+        if (gradation && gradationColor1)
+            return gradationColor1
+        if (fillColor)
+            return fillColor
+        return null
+    }
+
+    property var progressChildrenColorEnd: {
+        if (_isFailed || _isSuccess)
+            return null
+        if (gradation && gradationColor2)
+            return gradationColor2
+        return null
+    }
+
+    onValueChanged: {
+        if (!indeterminate && value >= to && to > from)
+            state = KProgressBar.State.SuccessProgress
+    }
+
+    contentItem: Loader {
+        sourceComponent: control._horizontal ? hLayout : vLayout
+    }
+
+    Component {
+        id: hLayout
+        RowLayout {
+            spacing: 8
+
+            ProgressBar {
+                Layout.fillWidth: true
+                Layout.preferredHeight: control._barThickness > 0 ? control._barThickness : 30
+                Layout.minimumWidth: 40
+                from: control.from
+                to: control.to
+                value: control.value
+                indeterminate: control.indeterminate
+                property bool textVisible: control._barTextVisible
+                property string progressText: control.displayText
+                property bool showNormalProgressBarAnim: control.animationEnabled
+                                                        && control.enabled
+                                                        && control._isNormal
+                                                        && !control.indeterminate
+                property var progressChildrenColor: control.progressChildrenColor
+                property var progressChildrenColorEnd: control.progressChildrenColorEnd
+                property bool progressFillPlain: control._useCustomFill
+                property var progressBackgroundColor: control.backgroundColor
+                property bool invertedAppearance: control.invertedAppearance
+            }
+
+            Label {
+                Layout.alignment: Qt.AlignVCenter
+                visible: control._sideTextVisible
+                text: control.displayText
+                color: control._sideTextColor
+            }
+
+            Image {
+                Layout.alignment: Qt.AlignVCenter
+                visible: control._sideIconVisible
+                opacity: control.enabled ? 1.0 : 0.45
+                source: visible ? control._statusIcon : ""
+                width: 16; height: 16
+                sourceSize.width: 16; sourceSize.height: 16
+                fillMode: Image.PreserveAspectFit
+                smooth: true; cache: false
+            }
+        }
+    }
+
+    Component {
+        id: vLayout
+        ColumnLayout {
+            spacing: 8
+
+            Item {
+                Layout.preferredWidth: control.bodyWidth > 0 ? control.bodyWidth : vBar.implicitHeight
+                Layout.fillHeight: true
+                Layout.minimumHeight: 40
+                Layout.alignment: Qt.AlignHCenter
+
+                ProgressBar {
+                    id: vBar
+                    width: parent.height
+                    height: control.bodyWidth > 0 ? control.bodyWidth : implicitHeight
+                    anchors.centerIn: parent
+                    rotation: -90
+                    from: control.from
+                    to: control.to
+                    value: control.value
+                    indeterminate: control.indeterminate
+                    property bool textVisible: control._barTextVisible
+                    property string progressText: control.displayText
+                    property bool showNormalProgressBarAnim: control.animationEnabled
+                                                            && control.enabled
+                                                            && control._isNormal
+                                                            && !control.indeterminate
+                    property var progressChildrenColor: control.progressChildrenColor
+                    property var progressChildrenColorEnd: control.progressChildrenColorEnd
+                    property bool progressFillPlain: control._useCustomFill
+                    property var progressBackgroundColor: control.backgroundColor
+                    property bool invertedAppearance: control.invertedAppearance
+                }
+            }
+
+            Label {
+                Layout.alignment: Qt.AlignHCenter
+                visible: control._sideTextVisible
+                text: control.displayText
+                color: control._sideTextColor
+            }
+
+            Image {
+                Layout.alignment: Qt.AlignHCenter
+                visible: control._sideIconVisible
+                opacity: control.enabled ? 1.0 : 0.45
+                source: visible ? control._statusIcon : ""
+                width: 16; height: 16
+                sourceSize.width: 16; sourceSize.height: 16
+                fillMode: Image.PreserveAspectFit
+                smooth: true; cache: false
+            }
+        }
+    }
+
+    function text() { return displayText }
+    function setState(s) { state = s }
+    function setOrientation(o) { orientation = o }
+    function setLabelPosition(p) { labelPosition = p }
+    function setTextVisible(v) { textVisible = v }
+    function setAnimation(flag) { animationEnabled = flag }
+    function animation() { return animationEnabled }
+    function setRange(min, max) { from = min; to = max }
+    function setValue(v) { value = v }
+    function setFormat(f) { format = f }
+    function setBodyWidth(w) { bodyWidth = w }
+    function setBackgroundColor(c) { backgroundColor = c }
+    function setFillColor(c) { fillColor = c }
+    function setGradation(flag) { gradation = flag }
+    function setGradationColor(c1, c2) {
+        gradationColor1 = c1
+        gradationColor2 = c2
+        gradation = true
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KProgressCircle.qml b/ukui-qml-style-helper/controls/qml/KProgressCircle.qml
new file mode 100644
index 0000000..33650a6
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KProgressCircle.qml
@@ -0,0 +1,312 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KProgressCircle.
+ * 圆形进度条控件，支持百分比显示、三种状态（正常/成功/失败）。
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Templates 2.12 as T
+import QtGraphicalEffects 1.0
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+T.Control {
+    id: control
+
+    palette: app.palette
+    font: app.font
+
+    // 进度值属性
+    property int minimum: 0
+    property int maximum: 100
+    property int value: 0
+
+    // 文本显示
+    property bool textVisible: true
+    property string displayText: {
+        if (maximum === 0 && minimum === 0)
+            return ""
+        var totalSteps = maximum - minimum
+        if (totalSteps === 0)
+            return "100%"
+        var progress = Math.round((value - minimum) * 100.0 / totalSteps)
+        return progress + "%"
+    }
+
+    // 状态枚举：0=Normal, 1=Success, 2=Failed
+    property int state: 0
+
+    // 圆环宽度
+    readonly property int circleWidth: 6
+
+    // 起始角度（12点钟方向为90度）
+    readonly property int startAngle: 90
+
+    readonly property bool isClassicTheme: app.widgetThemeName === "classical"
+
+    // 基础圆环颜色（对齐 changeTheme()）
+    property color baseColor: app.isDark ? getDtColor("kgray-16") : getDtColor("kgray-6")
+    property color baseCircleColor: app.isDark ? getDtColor("kgray-17") : getDtColor("kgray-10")
+
+    // 进度颜色（对齐 setState + dawColoredCircle）
+    readonly property color progressColor: {
+        switch (state) {
+        case 2: return "#FF4D4F"
+        case 1: return "#52C429"
+        default: return getDtColor("kbrand-normal")
+        }
+    }
+
+    // 固定尺寸
+    implicitWidth: 60
+    implicitHeight: 60
+
+    // 计算进度角度
+    readonly property real angleSpan: {
+        if (maximum === 0)
+            return 0
+        var span = value * 360 / maximum
+        return Math.min(360, Math.max(0, span))
+    }
+
+    // 中心图标尺寸
+    readonly property int centerPixSize: 20
+
+    onStateChanged: canvas.requestPaint()
+    onValueChanged: syncStateWithValue()
+    onMaximumChanged: syncStateWithValue()
+    onTextVisibleChanged: canvas.requestPaint()
+
+    Connections {
+        target: app
+        function onParametryChanged() {
+            updateThemeColors()
+            canvas.requestPaint()
+        }
+        function onIconThemeChanged() {
+            canvas.requestPaint()
+        }
+        function onIsDarkChanged() {
+            updateThemeColors()
+            canvas.requestPaint()
+        }
+    }
+
+    StylePrivate.APPParameter {
+        id: app
+    }
+
+    StylePrivate.ParseColorInterface {
+        id: parseColor
+    }
+
+    function getDtColor(colorName) {
+        return parseColor.getDtColor(colorName)
+    }
+
+    function lanhuHSL(l) {
+        return Qt.hsla(0, 0, l / 100, 1)
+    }
+
+    function syncStateWithValue() {
+        // 对齐 C++ valueChanged：满值切成功；未满值时回到正常（失败态保持，需 setState/reset 清除）
+        if (state === 2)
+            return
+        if (value === maximum)
+            state = 1
+        else if (state === 1)
+            state = 0
+        canvas.requestPaint()
+    }
+
+    function updateThemeColors() {
+        baseColor = app.isDark ? getDtColor("kgray-16") : getDtColor("kgray-6")
+        baseCircleColor = app.isDark ? getDtColor("kgray-17") : getDtColor("kgray-10")
+    }
+
+    function progressLineCap() {
+        return isClassicTheme ? "butt" : "round"
+    }
+
+    function classicOuterRingColor() {
+        return app.isDark ? lanhuHSL(35) : lanhuHSL(73)
+    }
+
+    function classicFillColor() {
+        return app.isDark ? lanhuHSL(27) : lanhuHSL(98)
+    }
+
+    // 绘制画布
+    Canvas {
+        id: canvas
+        anchors.fill: parent
+        antialiasing: true
+
+        onPaint: {
+            var ctx = getContext("2d")
+            ctx.clearRect(0, 0, width, height)
+
+            var centerX = width / 2
+            var centerY = height / 2
+            var arcRadius = (Math.min(width, height) - circleWidth) / 2 - 1
+            if (isClassicTheme)
+                arcRadius -= 1
+
+            if (textVisible) {
+                if (isClassicTheme) {
+                    ctx.beginPath()
+                    ctx.arc(centerX, centerY, arcRadius, 0, Math.PI * 2)
+                    ctx.strokeStyle = classicOuterRingColor()
+                    ctx.lineWidth = 8
+                    ctx.lineCap = "butt"
+                    ctx.stroke()
+                }
+
+                ctx.beginPath()
+                ctx.arc(centerX, centerY, arcRadius, 0, Math.PI * 2)
+                ctx.strokeStyle = baseColor
+                ctx.lineWidth = circleWidth
+                ctx.lineCap = progressLineCap()
+                ctx.stroke()
+
+                if (angleSpan > 0) {
+                    var startRad = (startAngle - 90) * Math.PI / 180
+                    var endRad = startRad - angleSpan * Math.PI / 180
+                    ctx.beginPath()
+                    ctx.arc(centerX, centerY, arcRadius, startRad, endRad, true)
+                    ctx.strokeStyle = progressColor
+                    ctx.lineWidth = circleWidth
+                    ctx.lineCap = progressLineCap()
+                    ctx.stroke()
+                }
+            } else {
+                var outerRadius = arcRadius + circleWidth / 2
+                var innerRadius = arcRadius - circleWidth / 2
+
+                if (isClassicTheme) {
+                    ctx.beginPath()
+                    ctx.arc(centerX, centerY, outerRadius, 0, Math.PI * 2)
+                    ctx.fillStyle = classicFillColor()
+                    ctx.fill()
+                    ctx.strokeStyle = classicOuterRingColor()
+                    ctx.lineWidth = 1
+                    ctx.stroke()
+                } else {
+                    ctx.beginPath()
+                    ctx.arc(centerX, centerY, outerRadius, 0, Math.PI * 2)
+                    ctx.fillStyle = baseColor
+                    ctx.fill()
+                }
+
+                ctx.beginPath()
+                ctx.arc(centerX, centerY, innerRadius, 0, Math.PI * 2)
+                if (isClassicTheme) {
+                    ctx.fillStyle = classicFillColor()
+                    ctx.fill()
+                }
+                ctx.strokeStyle = baseCircleColor
+                ctx.lineWidth = circleWidth
+                ctx.lineCap = progressLineCap()
+                ctx.stroke()
+
+                if (angleSpan > 0) {
+                    var innerStartRad = (startAngle - 90) * Math.PI / 180
+                    var innerEndRad = innerStartRad - angleSpan * Math.PI / 180
+                    ctx.beginPath()
+                    ctx.arc(centerX, centerY, innerRadius, innerStartRad, innerEndRad, true)
+                    ctx.strokeStyle = progressColor
+                    ctx.lineWidth = circleWidth
+                    ctx.lineCap = progressLineCap()
+                    ctx.stroke()
+                }
+            }
+        }
+    }
+
+    // 文本/图标显示区域（互斥展示，避免重叠）
+    Item {
+        id: contentArea
+        anchors.centerIn: parent
+        visible: textVisible
+
+        Text {
+            id: percentText
+            anchors.centerIn: parent
+            visible: control.state === 0
+            text: displayText
+            font: control.font
+            color: control.palette.windowText
+            horizontalAlignment: Text.AlignHCenter
+            verticalAlignment: Text.AlignVCenter
+        }
+
+        Item {
+            anchors.centerIn: parent
+            width: centerPixSize
+            height: centerPixSize
+            visible: control.state === 1
+
+            Image {
+                id: successIcon
+                anchors.fill: parent
+                source: "image://imageProvider/object-select-symbolic/normal"
+                fillMode: Image.PreserveAspectFit
+                cache: false
+                visible: false
+            }
+
+            ColorOverlay {
+                anchors.fill: parent
+                source: successIcon
+                color: getDtColor("ksuccess-normal")
+            }
+        }
+
+        Item {
+            anchors.centerIn: parent
+            width: centerPixSize
+            height: centerPixSize
+            visible: control.state === 2
+
+            Image {
+                id: failedIcon
+                anchors.fill: parent
+                source: "image://imageProvider/window-close-symbolic/normal"
+                fillMode: Image.PreserveAspectFit
+                cache: false
+                visible: false
+            }
+
+            ColorOverlay {
+                anchors.fill: parent
+                source: failedIcon
+                color: getDtColor("kerror-normal")
+            }
+        }
+    }
+
+    function setValue(val) {
+        if (val === value)
+            return
+        if ((val > maximum || val < minimum) && (maximum !== 0 || minimum !== 0))
+            return
+        value = val
+    }
+
+    function setRange(min, max) {
+        minimum = min
+        maximum = Math.max(min, max)
+        if (value < minimum || value > maximum)
+            reset()
+    }
+
+    function reset() {
+        value = minimum - 1
+        state = 0
+    }
+
+    function setState(newState) {
+        state = newState
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KProgressDialog.qml b/ukui-qml-style-helper/controls/qml/KProgressDialog.qml
new file mode 100644
index 0000000..4e8503a
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KProgressDialog.qml
@@ -0,0 +1,378 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KProgressDialog。
+ * 基于 KDialog；对齐 C++ 四种 BarType 布局与常用接口。
+ *
+ * BarType:
+ *  - NormalBar：标题栏 + 主文案 + 进度条 + 详情行（副文案/百分比/value+suffix）+ 取消
+ *  - NothingBar：无标题栏按钮；主文案 + 进度条与百分比同行；无取消
+ *  - ScrollBar：不确定进度；仅主文案 + 条；无取消/详情
+ *  - SpeedBar：主文案 + 条与百分比；副文案 + 速度文案；自定义按钮（最多 3 个），无取消
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Layouts 1.15
+import org.ukui.platformtheme.controls 1.0 as Private
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+Private.KDialog {
+    id: root
+
+    enum BarType { ScrollBar = 0, NothingBar = 1, NormalBar = 2, SpeedBar = 3 }
+
+    property int barType: KProgressDialog.BarType.NormalBar
+    property int minimum: 0
+    property int maximum: 100
+    property int value: 0
+    property string labelText: ""
+    property string subContent: ""
+    property string cancelButtonText: qsTr("cancel")
+    /// NormalBar 详情后缀：显示为 "value+suffix/maximum+suffix"
+    property string suffix: ""
+    /// SpeedBar：速度与单位（对应 C++ setSuffix(numerator, denominator)）
+    property string numerator: ""
+    property string denominator: ""
+    property real speed: 0
+    property bool showDetail: true
+    property bool autoReset: true
+    property bool autoClose: true
+    /// SpeedBar 额外按钮文案，最多 3 个
+    property var extraButtons: []
+
+    readonly property bool _isScroll: barType === KProgressDialog.BarType.ScrollBar
+    readonly property bool _isNothing: barType === KProgressDialog.BarType.NothingBar
+    readonly property bool _isNormal: barType === KProgressDialog.BarType.NormalBar
+    readonly property bool _isSpeed: barType === KProgressDialog.BarType.SpeedBar
+    /// 无底部操作按钮时：不显示标题文字与关闭按钮（NothingBar / ScrollBar）
+    readonly property bool _hasActionButtons: _isNormal
+                                              || (_isSpeed && extraButtons && extraButtons.length > 0)
+    readonly property bool _showTitleBar: _hasActionButtons
+
+    readonly property int _percent: {
+        if (maximum <= minimum)
+            return 0
+        return Math.round((value - minimum) * 100.0 / (maximum - minimum))
+    }
+    readonly property string _percentText: _percent + "%"
+    readonly property string _progressDetailText: {
+        if (_isSpeed)
+            return speed + " " + numerator + "/" + denominator
+        return value + suffix + "/" + maximum + suffix
+    }
+
+    signal canceled()
+    signal extraButtonClicked(int index)
+
+    // 有按钮时可显示标题/图标，窗口按钮仅关闭；无按钮时隐藏整栏标题栏
+    title: ""
+    blurEnabled: true
+    modality: Qt.ApplicationModal
+    readonly property int _titleBarH: _showTitleBar && header ? header.height : 0
+    readonly property int _bodyH: contentCol.implicitHeight
+    width: 376
+    height: _titleBarH + _bodyH
+    minimumWidth: width
+    maximumWidth: width
+    minimumHeight: height
+    maximumHeight: height
+
+    StylePrivate.APPParameter { id: app }
+    palette: app.palette
+
+    readonly property bool _hasToken: typeof ukui_platformtheme_token !== "undefined"
+                                      && ukui_platformtheme_token
+    readonly property color _primaryText: _hasToken
+                                          ? ukui_platformtheme_token.kFontPrimary
+                                          : palette.windowText
+    readonly property color _secondaryText: _hasToken
+                                            ? ukui_platformtheme_token.kFontSecondary
+                                            : palette.placeholderText
+
+    Component.onCompleted: _applyChrome()
+    onBarTypeChanged: _applyChrome()
+    on_ShowTitleBarChanged: _applyChrome()
+    onExtraButtonsChanged: _applyChrome()
+
+    function _applyChrome() {
+        if (header)
+            header.visible = root._showTitleBar
+        if (minButton)
+            minButton.visible = false
+        if (maxButton)
+            maxButton.visible = false
+        if (menuButton)
+            menuButton.visible = false
+        if (closeButton)
+            closeButton.visible = root._showTitleBar
+    }
+
+    onValueChanged: {
+        if (_isScroll)
+            return
+        if (value < maximum)
+            return
+        // 与 QProgressDialog 语义接近：满值可自动重置/关闭
+        if (autoClose)
+            close()
+        else if (autoReset)
+            _resetValueOnly()
+    }
+
+    function _resetValueOnly() {
+        value = minimum
+    }
+
+    function reset() {
+        _resetValueOnly()
+        if (autoClose)
+            close()
+    }
+
+    function cancel() {
+        canceled()
+        value = minimum
+        close()
+    }
+
+    Item {
+        anchors.fill: parent
+
+        ColumnLayout {
+            id: contentCol
+            anchors.left: parent.left
+            anchors.right: parent.right
+            anchors.top: parent.top
+            spacing: 0
+
+            Item { Layout.preferredHeight: root._isNormal ? 30 : (root._isSpeed ? 4 : 24); Layout.fillWidth: true }
+
+        Label {
+            text: root.labelText
+            color: root._primaryText
+            wrapMode: Text.WordWrap
+            Layout.fillWidth: true
+            Layout.leftMargin: 24
+            Layout.rightMargin: 24
+            horizontalAlignment: Text.AlignLeft
+        }
+
+        Item { Layout.preferredHeight: root._isNormal ? 10 : 8; Layout.fillWidth: true }
+
+        // —— ScrollBar：不确定进度 ——
+        ProgressBar {
+            visible: root._isScroll
+            Layout.fillWidth: true
+            Layout.preferredHeight: 30
+            Layout.leftMargin: 24
+            Layout.rightMargin: 24
+            indeterminate: true
+        }
+
+        // —— NothingBar / SpeedBar：条 + 百分比同行 ——
+        RowLayout {
+            visible: root._isNothing || root._isSpeed
+            Layout.fillWidth: true
+            Layout.leftMargin: 24
+            Layout.rightMargin: 24
+            spacing: 8
+
+            Private.KProgressBar {
+                Layout.fillWidth: true
+                Layout.preferredHeight: 8
+                from: root.minimum
+                to: root.maximum
+                value: root.value
+                textVisible: false
+                bodyWidth: 8
+            }
+
+            Label {
+                text: root._percentText
+                color: root._primaryText
+                Layout.alignment: Qt.AlignVCenter
+            }
+        }
+
+        // —— NormalBar：单独进度条 ——
+        Private.KProgressBar {
+            visible: root._isNormal
+            Layout.fillWidth: true
+            Layout.preferredHeight: 8
+            Layout.leftMargin: 24
+            Layout.rightMargin: 24
+            from: root.minimum
+            to: root.maximum
+            value: root.value
+            textVisible: false
+            bodyWidth: 8
+        }
+
+        // —— NormalBar 详情行：副文案 | 百分比 | value/max ——
+        RowLayout {
+            visible: root._isNormal && root.showDetail
+            Layout.fillWidth: true
+            Layout.leftMargin: 24
+            Layout.rightMargin: 24
+            spacing: 0
+
+            Label {
+                text: root.subContent
+                color: root._secondaryText
+                elide: Text.ElideRight
+                Layout.fillWidth: true
+            }
+
+            Label {
+                text: root._percentText
+                color: root._secondaryText
+            }
+
+            Item { Layout.preferredWidth: 15 }
+
+            Label {
+                text: root._progressDetailText
+                color: root._secondaryText
+            }
+        }
+
+        // —— SpeedBar 详情行：副文案 | 速度 ——
+        RowLayout {
+            visible: root._isSpeed && root.showDetail
+            Layout.fillWidth: true
+            Layout.leftMargin: 24
+            Layout.rightMargin: 24
+            spacing: 0
+            Layout.topMargin: 4
+
+            Label {
+                text: root.subContent
+                color: root._secondaryText
+                elide: Text.ElideRight
+                Layout.fillWidth: true
+            }
+
+            Label {
+                text: root._progressDetailText
+                color: root._secondaryText
+            }
+
+            Item { Layout.preferredWidth: 36 }
+        }
+
+        Item {
+            visible: root._isNormal || root._isSpeed
+            Layout.preferredHeight: root._isNormal ? 30 : 32
+            Layout.fillWidth: true
+        }
+
+        // —— NormalBar 取消按钮 ——
+        RowLayout {
+            visible: root._isNormal
+            Layout.fillWidth: true
+            Layout.leftMargin: 24
+            Layout.rightMargin: 24
+            Item { Layout.fillWidth: true }
+            Button {
+                text: root.cancelButtonText
+                onClicked: root.cancel()
+            }
+        }
+
+        // —— SpeedBar 自定义按钮 ——
+        RowLayout {
+            visible: root._isSpeed && root.extraButtons && root.extraButtons.length > 0
+            Layout.fillWidth: true
+            Layout.leftMargin: 24
+            Layout.rightMargin: 24
+            spacing: 8
+
+            Item {
+                visible: root.extraButtons.length < 3
+                Layout.fillWidth: true
+            }
+
+            Repeater {
+                model: {
+                    var src = root.extraButtons || []
+                    var n = Math.min(3, src.length)
+                    if (n <= 0)
+                        return []
+                    if (n === 1)
+                        return [src[0]]
+                    if (n === 2)
+                        return [src[1], src[0]]
+                    return [src[2], src[1], src[0]]
+                }
+
+                Button {
+                    text: typeof modelData === "string" ? modelData : (modelData.text || "")
+                    Layout.fillWidth: root.extraButtons.length >= 3 && index === 0
+                    onClicked: {
+                        var src = root.extraButtons || []
+                        var n = Math.min(3, src.length)
+                        var realIndex = index
+                        if (n === 2)
+                            realIndex = 1 - index
+                        else if (n === 3)
+                            realIndex = 2 - index
+                        root.extraButtonClicked(realIndex)
+                    }
+                }
+            }
+        }
+
+        // 内容距底 24（有按钮时即按钮距底）
+        Item { Layout.preferredHeight: 24; Layout.fillWidth: true }
+        }
+    }
+
+    function setRange(min, max) { minimum = min; maximum = max }
+    function setMaximum(v) { maximum = v }
+    function setMinimum(v) { minimum = v }
+    function setValue(v) { value = v }
+    function setLabelText(t) { labelText = t }
+    function setCancelButtonText(t) { cancelButtonText = t }
+    function setSubContent(t) {
+        subContent = t
+        showDetail = true
+    }
+    function setSuffix(a, b) {
+        if (b === undefined || b === null) {
+            suffix = a
+        } else {
+            numerator = a
+            denominator = b
+        }
+    }
+    function setShowDetail(flag) { showDetail = flag }
+    function setAutoReset(flag) { autoReset = flag }
+    function setAutoClose(flag) { autoClose = flag }
+    function setBarType(t) { barType = t }
+    function setSpeed(s) { speed = s }
+    function myType() { return barType }
+
+    function addButton(text) {
+        var list = (extraButtons || []).slice()
+        if (list.length >= 3)
+            return
+        list.push(text)
+        extraButtons = list
+    }
+
+    function removeButton(textOrIndex) {
+        var list = (extraButtons || []).slice()
+        if (typeof textOrIndex === "number") {
+            if (textOrIndex < 0 || textOrIndex >= list.length)
+                return
+            list.splice(textOrIndex, 1)
+        } else {
+            var i = list.indexOf(textOrIndex)
+            if (i < 0)
+                return
+            list.splice(i, 1)
+        }
+        extraButtons = list
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KProgressLabel.qml b/ukui-qml-style-helper/controls/qml/KProgressLabel.qml
new file mode 100644
index 0000000..054c781
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KProgressLabel.qml
@@ -0,0 +1,134 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KProgressLabel。
+ * 配色严格对齐 kprogresslabel.cpp：
+ *  - 圆点：未完成 -> midlight-active + 白字；当前(isSucceed) 与 已完成(colorFlag) -> highlight-active
+ *    已完成画 dialog-apply 勾，当前画步骤号
+ *  - 连线：index < currentIndex -> highlight-active；否则 midlight-active；2px
+ *  - 文本：当前 -> highlight-active；其余 brighttext-active @0.35
+ *  - circleSize 默认 24x24
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Layouts 1.15
+import org.ukui.qqc2style.private 1.1 as StylePrivate
+
+Item {
+    id: root
+
+    property var list1: []    // 上行文本（步骤号）
+    property var list2: []    // 下行文本（可选，与 list1 等长）
+    property int currentIndex: -1
+    property size circleSize: Qt.size(24, 24)
+
+    implicitWidth: 360
+    implicitHeight: list1.length > 0 ? 80 : 24
+
+    StylePrivate.APPParameter { id: app }
+    StylePrivate.ParseColorInterface { id: parseColor }
+
+    signal currentChanged(int index)
+
+    readonly property color _midlight: parseColor.getDtColor("midlight-active")
+    readonly property color _highlight: parseColor.getDtColor("highlight-active")
+    readonly property color _kwhite: parseColor.getDtColor("kwhite")
+
+    function _textColor(i) {
+        return i === root.currentIndex ? root._highlight : Qt.rgba(1, 1, 1, 0.35)
+    }
+    // brighttext-active @0.35 近似为白色@0.35（深浅色下 midlight 圆点配白字）
+
+    ColumnLayout {
+        anchors.fill: parent
+        spacing: 8
+
+        // 第一行：圆点 + 连线
+        RowLayout {
+            Layout.fillWidth: true
+            spacing: 0
+
+            Repeater {
+                model: root.list1.length
+                RowLayout {
+                    spacing: 0
+                    Layout.alignment: Qt.AlignVCenter
+
+                    Rectangle {
+                        id: circle
+                        width: root.circleSize.width
+                        height: root.circleSize.height
+                        radius: width / 2
+                        Layout.alignment: Qt.AlignVCenter
+                        // i < currentIndex -> 已完成(colorFlag)；i == currentIndex -> 当前(isSucceed)；i > -> 未完成
+                        property bool _completed: index < root.currentIndex
+                        property bool _current: index === root.currentIndex
+                        color: (_completed || _current) ? root._highlight : root._midlight
+                        antialiasing: true
+
+                        Text {
+                            // 当前画步骤号，已完成画勾图标
+                            anchors.centerIn: parent
+                            visible: !circle._completed
+                            text: root.list1[index] || ""
+                            font: app.font
+                            color: root._kwhite
+                        }
+
+                        Image {
+                            anchors.centerIn: parent
+                            visible: circle._completed
+                            source: visible ? "image://imageProvider/dialog-apply/normalWidthThemeColor" : ""
+                            width: 16; height: 16
+                            fillMode: Image.PreserveAspectFit; smooth: true; cache: false
+                        }
+                    }
+
+                    // 连线（非末项）
+                    Rectangle {
+                        visible: index < root.list1.length - 1
+                        Layout.fillWidth: true
+                        Layout.preferredHeight: 2
+                        Layout.alignment: Qt.AlignVCenter
+                        color: index < root.currentIndex ? root._highlight : root._midlight
+                        antialiasing: true
+                    }
+                }
+            }
+        }
+
+        // 第二行：文本
+        RowLayout {
+            Layout.fillWidth: true
+            Layout.leftMargin: root.circleSize.width / 2 - 6
+            Layout.rightMargin: root.circleSize.width / 2 - 6
+            spacing: 0
+
+            Repeater {
+                model: (root.list2.length > 0 ? root.list2 : root.list1).length
+                Item {
+                    Layout.fillWidth: true
+                    Layout.preferredHeight: txt.implicitHeight
+                    Text {
+                        id: txt
+                        anchors.centerIn: parent
+                        text: (root.list2.length > 0 ? root.list2 : root.list1)[index] || ""
+                        font: app.font
+                        color: root._textColor(index)
+                        wrapMode: Text.WordWrap
+                        horizontalAlignment: Text.AlignHCenter
+                        width: parent.width
+                    }
+                }
+            }
+        }
+    }
+
+    function setStringList(l1, l2) {
+        list1 = l1
+        list2 = (l2 !== undefined && l2 !== null) ? l2 : []
+    }
+    function setCurrentIndex(i) { currentIndex = i; currentChanged(i) }
+    function setCircleSize(s) { circleSize = s }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KPushButton.qml b/ukui-qml-style-helper/controls/qml/KPushButton.qml
new file mode 100644
index 0000000..870e750
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KPushButton.qml
@@ -0,0 +1,227 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KPushButton.
+ * 根植于 QtQuick.Controls Button（org.ukui.style 样式自动提供 content/图标/文本色/loading），
+ * 仅覆盖 background：用 Canvas 按 C++ QPainterPath（kpushbutton.cpp:842-851）画四角独立圆角。
+ * 配色与焦点逻辑完全照搬 BackGroundRectangle.changeColor（normal/highlighted/close/window/import/transparent
+ * 全分支，用 UKUIButton 的 *BC/*Border* token + ParseColorInterface.startColor/endColor 取渐变首末色）。
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+Button {
+    id: control
+
+    // 对齐 Button.qml 的 buttonType 字符串约定（closeButton/windowButton/importButton）
+    property string buttonType: ""
+    property bool transparent: false
+
+    // 四角独立圆角（对齐 C++ m_topLeft/m_bottomLeft/m_topRight/m_bottomRight）
+    property int topLeftRadius: 0
+    property int topRightRadius: 0
+    property int bottomLeftRadius: 0
+    property int bottomRightRadius: 0
+
+    property color backgroundColor: "transparent"
+    property bool useCustomColor: false
+
+    // 分割线画在按钮自身边缘上（无间隙）：dividerRight 右边竖线、dividerBottom 底边横线
+    // 由 KButtonBox 按位置设；色 kline-normal，距两端各 5px
+    property bool dividerRight: false
+    property bool dividerBottom: false
+
+    // 加载态：沿用样式 Button 的 isLoadBtn/isLoading 约定（ButtonIconLabelContent 自带 BusyIndicator）
+    property bool isLoadBtn: true
+    property bool isLoading: false
+
+    // 菜单按钮：hasMenu=true 时样式 Button 显下拉箭头（ukui-down-symbolic）；菜单弹出由调用方 onClicked 触发
+    property bool hasMenu: false
+
+    // 焦点状态机（对齐 BackGroundRectangle：visualFocus 进入置 true，按下抑制）
+    property bool focusEnable: false
+    readonly property bool showFocusBorder: app.focusEnable && control.focusEnable
+
+    StylePrivate.APPParameter { id: app }
+    StylePrivate.UKUIButton { id: btn }
+    StylePrivate.ParseColorInterface { id: parseColor }
+
+    readonly property string _stateKey: (control.enabled ? 1 : 0) + "," + (control.hovered ? 1 : 0) + ","
+            + (control.pressed ? 1 : 0) + "," + (control.checked ? 1 : 0) + "," + (control.checkable ? 1 : 0) + ","
+            + (control.visualFocus ? 1 : 0) + "," + (control.focusEnable ? 1 : 0) + "," + (control.showFocusBorder ? 1 : 0) + ","
+            + (control.highlighted ? 1 : 0) + "," + (control.flat ? 1 : 0) + "," + control.buttonType + ","
+            + (control.transparent ? 1 : 0) + "," + (control.useCustomColor ? 1 : 0) + "," + control.backgroundColor + ","
+            + (control.isLoading ? 1 : 0) + "," + (control.dividerRight ? 1 : 0) + "," + (control.dividerBottom ? 1 : 0)
+
+    function setButtonType(type) { buttonType = type }
+    function setTranslucent(flag) { transparent = flag }
+    function setBackgroundColor(c) { useCustomColor = true; backgroundColor = c }
+    function setLoaingStatus(flag) { isLoading = flag }
+
+    // 对齐 C++ 重载：setBorderRadius(r) 四角同值；setBorderRadius(bl,tl,tr,br) 四角独立
+    function setBorderRadius(bl, tl, tr, br) {
+        if (tl === undefined) {
+            var r = Math.max(0, bl)
+            topLeftRadius = r
+            topRightRadius = r
+            bottomLeftRadius = r
+            bottomRightRadius = r
+        } else {
+            bottomLeftRadius = Math.max(0, bl)
+            topLeftRadius = Math.max(0, tl)
+            topRightRadius = Math.max(0, tr)
+            bottomRightRadius = Math.max(0, br)
+        }
+    }
+
+    background: Canvas {
+        id: bgCanvas
+        anchors.fill: parent
+        antialiasing: true
+
+        onWidthChanged: requestPaint()
+        onHeightChanged: requestPaint()
+
+        // 样式 Button 的 onEnabledChanged 会调 back.changeColor(...)；back 现在是本 Canvas，提供空实现兜住
+        function changeColor() {}
+
+        onPaint: {
+            var ctx = getContext("2d")
+            ctx.reset()
+            var w = width
+            var h = height
+            if (w <= 0 || h <= 0)
+                return
+
+            var enable = control.enabled
+            var click = control.pressed
+            var hover = control.hovered
+            var checked = control.checkable && control.checked
+            var flat = control.flat
+
+            // ---- 照搬 BackGroundRectangle.changeColor：按 buttonType 选 token 集，再按状态选首末色/边框色 ----
+            var closeBtn = (control.buttonType === "closeButton" || control.buttonType === "windowTitleBarCloseButton")
+            var windowBtn = (control.buttonType === "windowButton" || control.buttonType === "windowTitleBarWindowButton")
+            var importBtn = (control.buttonType === "importButton")
+            var hl = control.highlighted || importBtn
+
+            // 给定一组 normal/clicked/hovered/disable 的填充与边框 token，按状态返回 [start,end,border]
+            function pick(nBC, cBC, hBC, dBC, nB, cB, hB, dB) {
+                if (!enable)
+                    return [parseColor.startColor(dBC), parseColor.endColor(dBC), parseColor.startColor(dB)]
+                if (click || checked)
+                    return [parseColor.startColor(cBC), parseColor.endColor(cBC), parseColor.startColor(cB)]
+                if (hover)
+                    return [parseColor.startColor(hBC), parseColor.endColor(hBC), parseColor.startColor(hB)]
+                return [parseColor.startColor(nBC), parseColor.endColor(nBC), parseColor.startColor(nB)]
+            }
+
+            var s
+            if (hl)
+                s = pick(btn.normalHBC, btn.clickedHBC, btn.hoveredHBC, btn.disableHBC,
+                         btn.normalBorderHColor, btn.clickBorderHColor, btn.hoverBorderHColor, btn.disableBorderHColor)
+            else if (closeBtn)
+                s = pick(btn.normalCloseBC, btn.clickedCloseBC, btn.hoveredCloseBC, btn.disableCloseBC,
+                         btn.normalBorderCloseColor, btn.clickBorderCloseColor, btn.hoverBorderCloseColor, btn.disableBorderCloseColor)
+            else if (windowBtn && !control.transparent)
+                s = pick(btn.normalWindowBC, btn.clickedWindowBC, btn.hoveredWindowBC, btn.disableWindowBC,
+                         btn.normalBorderWindowColor, btn.clickBorderWindowColor, btn.hoverBorderWindowColor, btn.disableBorderWindowColor)
+            else if (windowBtn && control.transparent)
+                s = pick(btn.normalWindowTransparentBC, btn.clickedWindowTransparentBC, btn.hoveredWindowTransparentBC, btn.disableWindowTransparentBC,
+                         btn.normalBorderWindowTransparentColor, btn.clickedBorderWindowTransparentColor, btn.hoveredBorderWindowTransparentColor, btn.disableBorderWindowTransparentColor)
+            else if (control.transparent)
+                s = pick(btn.normalTransparentBC, btn.clickedTransparentBC, btn.hoveredTransparentBC, btn.disableTransparentBC,
+                         btn.normalBorderTransparentBC, btn.clickedBorderTransparentBC, btn.hoveredBorderTransparentBC, btn.disableBorderTransparentBC)
+            else
+                s = pick(btn.normalBC, btn.clickedBC, btn.hoveredBC, btn.disableBC,
+                         btn.normalBorderColor, btn.clickBorderColor, btn.hoverBorderColor, btn.disableBorderColor)
+
+            var startC = s[0]
+            var endC = s[1]
+            var borderC = s[2]
+            var focusC = parseColor.startColor(btn.focusBorderColor)
+
+            // flat 且未交互：透明填充（对齐 BackGroundRectangle）
+            if (flat && !click && !hover && !checked) {
+                startC = "transparent"
+                endC = "transparent"
+            }
+            // 自定义背景色覆盖填充
+            if (control.useCustomColor) {
+                startC = control.backgroundColor
+                endC = control.backgroundColor
+            }
+
+            // ---- 四角路径（对齐 C++ QPainterPath）----
+            var max = Math.min(w, h) / 2
+            var rtl = Math.min(control.topLeftRadius, max)
+            var rtr = Math.min(control.topRightRadius, max)
+            var rbl = Math.min(control.bottomLeftRadius, max)
+            var rbr = Math.min(control.bottomRightRadius, max)
+
+            function buildPath(inset) {
+                var x0 = inset, y0 = inset, x1 = w - inset, y1 = h - inset
+                ctx.beginPath()
+                ctx.moveTo(x0, y0 + rtl)
+                ctx.lineTo(x0, y1 - rbl)
+                ctx.quadraticCurveTo(x0, y1, x0 + rbl, y1)
+                ctx.lineTo(x1 - rbr, y1)
+                ctx.quadraticCurveTo(x1, y1, x1, y1 - rbr)
+                ctx.lineTo(x1, y0 + rtr)
+                ctx.quadraticCurveTo(x1, y0, x1 - rtr, y0)
+                ctx.lineTo(x0 + rtl, y0)
+                ctx.quadraticCurveTo(x0, y0, x0, y0 + rtl)
+                ctx.closePath()
+            }
+
+            // 填充：铺满矩形 + 垂直渐变（对齐 BackGroundRectangle 的 QML Gradient）
+            buildPath(0)
+            var grad = ctx.createLinearGradient(0, 0, 0, h)
+            grad.addColorStop(0.0, startC)
+            grad.addColorStop(1.0, endC)
+            ctx.fillStyle = grad
+            ctx.fill()
+
+            // 描边：内缩 lw/2，居中描边落在内侧 [0,lw]，粗细 = lw（对齐 Rectangle.border）
+            var lw = control.showFocusBorder ? btn.focusBorderWidth : btn.borderWidth
+            if (lw > 0) {
+                buildPath(lw / 2)
+                ctx.lineWidth = lw
+                ctx.strokeStyle = control.showFocusBorder ? focusC : borderC
+                ctx.stroke()
+            }
+
+            // 分割线画在按钮自身边缘（无间隙）：右边竖线 / 底边横线，色 kline-normal，距两端 5px
+            var divC = parseColor.getDtColor("kline-normal")
+            ctx.fillStyle = divC
+            if (control.dividerRight && h > 10)
+                ctx.fillRect(w - 1, 5, 1, h - 10)
+            if (control.dividerBottom && w > 10)
+                ctx.fillRect(5, h - 1, w - 10, 1)
+        }
+    }
+
+    onVisualFocusChanged: focusEnable = control.visualFocus
+    on_StateKeyChanged: bgCanvas.requestPaint()
+    onTopLeftRadiusChanged: bgCanvas.requestPaint()
+    onTopRightRadiusChanged: bgCanvas.requestPaint()
+    onBottomLeftRadiusChanged: bgCanvas.requestPaint()
+    onBottomRightRadiusChanged: bgCanvas.requestPaint()
+
+    Connections {
+        target: control
+        function onPressedChanged() {
+            if (control.pressed)
+                focusEnable = false
+            bgCanvas.requestPaint()
+        }
+    }
+
+    Connections {
+        target: app
+        function onParametryChanged() { bgCanvas.requestPaint() }
+        function onFocusEnableChanged() { bgCanvas.requestPaint() }
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KSearchLineEdit.qml b/ukui-qml-style-helper/controls/qml/KSearchLineEdit.qml
new file mode 100644
index 0000000..612fa7f
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KSearchLineEdit.qml
@@ -0,0 +1,693 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KSearchLineEdit.
+ * 搜索图标、自定义 placeholder 动画、清除键、智能语义按钮、补全历史、圆角描边。
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Window 2.12
+import QtQuick.Templates 2.12 as T
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+import org.ukui.platformtheme.controls 1.0 as Private
+
+T.TextField {
+    id: control
+
+    readonly property bool _rtl: {
+        var loc = Qt.locale().name
+        return loc === "ug_CN" || loc === "kk_KZ" || loc === "ky_KG"
+    }
+    readonly property int _iconSize: 16
+    readonly property int _iconMargin: 6
+    readonly property int _iconTextSpacing: 8
+    readonly property int _toolSpacing: 4
+    // 智能语义按钮内置图标（UKUI 主题）；C++ init 为 QIcon() 空图标，由应用通过 customButton()->setIcon 设置
+    readonly property string _builtinCustomButtonIcon: "ukui-ai-search-symbolic"
+
+    // 对齐 ksearchlineedit.h
+    property bool clearButtonEnabled: false
+    property int placeHolderAlignment: Qt.AlignCenter
+    property bool translucent: false
+    property bool gradationEnabled: false
+    property bool customButtonVisible: false
+    property alias customButton: customBtn
+
+    property string placeHolderText: qsTr("Search")
+    property string _toolTipPlaceHolder: ""
+
+    font: app.font
+    palette: app.palette
+    hoverEnabled: true
+    selectByMouse: true
+    focusReason: Qt.MouseFocusReason
+    placeholderText: ""
+    color: getStartColor(!enabled ? textfield.disableTextColor : textfield.normalTextColor)
+    selectionColor: getStartColor(textfield.focusBorderColor)
+    selectedTextColor: palette.highlightedText
+    verticalAlignment: TextInput.AlignVCenter
+    horizontalAlignment: _rtl ? Text.AlignRight : Text.AlignLeft
+
+    // 宽度由布局/显式 width 决定，不随输入文本变长（对齐 C++ QLineEdit::sizeHint）
+    implicitWidth: textfield.normalWidth
+    implicitHeight: Math.max(textfield.normalHeight,
+                             contentHeight + topPadding + bottomPadding, 36)
+
+    // 搜索图标与文本/输入区间距 8px（_iconTextSpacing）
+    leftPadding: _rtl ? _rightChromeWidth : (_iconMargin + _iconSize + _iconTextSpacing)
+    rightPadding: _rtl ? (_iconMargin + _iconSize + _iconTextSpacing) : _rightChromeWidth
+    topPadding: textfield.upDownMargin
+    bottomPadding: textfield.upDownMargin
+
+    readonly property bool _atSide: length > 0 || activeFocus
+
+    // placeholder 可用宽度：扣除左侧 icon 区与右侧 chrome（custom/clear）
+    readonly property int _placeHolderLeadingInset: _rtl ? _rightChromeWidth : _iconMargin
+    readonly property int _placeHolderTrailingInset: _rtl ? _iconMargin : _rightChromeWidth
+    readonly property int _placeHolderAreaWidth: Math.max(_iconSize,
+        width - _placeHolderLeadingInset - _placeHolderTrailingInset)
+    readonly property int _placeHolderLabelMaxWidth: Math.max(0,
+        _placeHolderAreaWidth - _iconTextSpacing - _iconSize)
+
+    readonly property bool _placeHolderNeedsElide: Math.ceil(placeHolderMetrics.width)
+        > _placeHolderLabelMaxWidth
+
+    readonly property int _placeHolderTextWidth: _placeHolderNeedsElide
+        ? Math.ceil(placeHolderLabel.paintedWidth)
+        : Math.ceil(placeHolderMetrics.width)
+
+    readonly property int _placeHolderRowNaturalWidth: length > 0
+        ? _iconSize
+        : (_iconSize + _iconTextSpacing + Math.max(1, _placeHolderTextWidth))
+
+    readonly property int _placeHolderContentWidth: Math.min(
+        _placeHolderRowNaturalWidth, _placeHolderAreaWidth)
+
+    // C++：widget 高度 = max(icon, textLabel->height())
+    readonly property int _placeHolderRowHeight: length > 0
+        ? _iconSize
+        : Math.max(_iconSize, Math.ceil(placeHolderMetrics.height))
+
+    function _clampHolderX(x, rowW) {
+        var minX = _placeHolderLeadingInset
+        var maxX = Math.max(minX, width - rowW - _placeHolderTrailingInset)
+        return Math.max(minX, Math.min(x, maxX))
+    }
+
+    // C++ m_sideRect：LTR moveLeft(iconMargin)；RTL moveLeft(width - w - iconMargin)
+    function _holderSideX() {
+        var rowW = _placeHolderContentWidth
+        var x = _rtl ? (width - rowW - _iconMargin) : _iconMargin
+        return _clampHolderX(x, rowW)
+    }
+
+    // C++ m_holderRect：居中/左右对齐均在扣除右侧 chrome 后的区域内计算
+    function _holderIdleX() {
+        var rowW = _placeHolderContentWidth
+        var minX = _placeHolderLeadingInset
+        var x
+        if (placeHolderAlignment & Qt.AlignRight)
+            x = _rtl ? minX : (width - rowW - _placeHolderTrailingInset)
+        else if (placeHolderAlignment & Qt.AlignLeft)
+            x = _rtl ? (width - rowW - _iconMargin) : minX
+        else
+            x = minX + (_placeHolderAreaWidth - rowW) / 2
+        return _clampHolderX(x, rowW)
+    }
+
+    function snapPlaceHolder() {
+        placeHolderRow.x = (length > 0 || activeFocus) ? _holderSideX() : _holderIdleX()
+    }
+
+    function animatePlaceHolder() {
+        if (length > 0) {
+            placeHolderRow.x = _holderSideX()
+            return
+        }
+        // C++ FocusIn: holderRect -> sideRect；FocusOut: sideRect -> holderRect
+        var target = activeFocus ? _holderSideX() : _holderIdleX()
+        if (Math.abs(placeHolderRow.x - target) < 0.5)
+            return
+        placeHolderAnim.stop()
+        placeHolderAnim.from = placeHolderRow.x
+        placeHolderAnim.to = target
+        placeHolderAnim.start()
+    }
+
+    onActiveFocusChanged: {
+        animatePlaceHolder()
+        updateChrome()
+        if (!activeFocus)
+            historyLayer.close()
+        else
+            refreshHistoryPopup()
+    }
+    onTextChanged: {
+        updateChrome()
+        updateIconSources()
+        refreshHistoryPopup()
+        if (length > 0)
+            snapPlaceHolder()
+        else
+            animatePlaceHolder()
+    }
+    onEnabledChanged: {
+        updateIconSources()
+        updateChrome()
+    }
+    onCustomButtonVisibleChanged: {
+        updateChrome()
+        if (!placeHolderAnim.running)
+            snapPlaceHolder()
+        else
+            animatePlaceHolder()
+    }
+    onHeightChanged: {
+        repaintAiGradientBorder()
+        if (!placeHolderAnim.running)
+            snapPlaceHolder()
+    }
+
+    Connections {
+        target: rightChromeRow
+        function onWidthChanged() {
+            if (!placeHolderAnim.running)
+                control.snapPlaceHolder()
+        }
+    }
+    onAccepted: {
+        appendSearchHistory(text)
+        focus = false
+    }
+    onEditingFinished: appendSearchHistory(text)
+
+    function setTranslucent(flag) {
+        translucent = flag
+    }
+    function isTranslucent() {
+        return translucent
+    }
+    function setGradation(flag) {
+        gradationEnabled = flag
+    }
+    function setCustomButtonVisible(flag) {
+        customButtonVisible = flag
+        updateChrome()
+    }
+    function isCustomButtonVisible() {
+        return customButtonVisible
+    }
+
+    function clearField() {
+        if (!length)
+            return
+        control.text = ""
+        animatePlaceHolder()
+        updateChrome()
+    }
+
+    function appendSearchHistory(entry) {
+        var t = entry.trim()
+        if (t === "")
+            return
+        for (var i = 0; i < historyModel.count; ++i) {
+            if (historyModel.get(i).text.toLowerCase() === t.toLowerCase())
+                return
+        }
+        historyModel.append({ text: t })
+    }
+
+    function updateChrome() {
+        // 对齐 C++：显示 customButton 时右侧区域变宽，清除键与 custom 不同时出现
+        clearBtn.visible = clearButtonEnabled && enabled && activeFocus && length > 0
+                && !customButtonVisible
+        chromeLine.visible = customButtonVisible
+        customBtn.visible = customButtonVisible
+        repaintAiGradientBorder()
+        if (!placeHolderAnim.running)
+            snapPlaceHolder()
+    }
+
+    function repaintAiGradientBorder() {
+        if (aiGradientBorder)
+            aiGradientBorder.requestPaint()
+    }
+
+    function updateIconSources() {
+        var model = "normalWidthThemeColor"
+        if (!enabled)
+            model = "disableWidthThemeColor"
+        searchIcon.source = "image://imageProvider/search-symbolic/" + model
+        _chromeLineColor = parseColor.getDtColor("kline-normal")
+    }
+
+    // 对齐 C++ KVLineFrame / m_pLineFrame：kline-normal DT
+    property color _chromeLineColor: parseColor.getDtColor("kline-normal")
+
+    // 取右侧 Row 实测宽度，避免隐藏 clearBtn 仍占位导致 placeholder/文本错位
+    readonly property int _rightChromeWidth: _iconMargin + rightChromeRow.width
+
+    StylePrivate.ParseColorInterface {
+        id: parseColor
+    }
+
+    function getStartColor(dtcolor) {
+        return parseColor.startColor(dtcolor)
+    }
+
+    function getEndColor(dtcolor) {
+        return parseColor.endColor(dtcolor)
+    }
+
+    property bool click: false
+
+    // 与 TextField.qml 一致：translucent=true 用 *TransparentBC，false 用实色 BC
+    property var backColor: !control.enabled ? (translucent ? textfield.disableTransparentBC : textfield.disableBC) :
+                             (control.activeFocus) ? (translucent ? textfield.inputNormalTransparentBC : textfield.inputNormalBC) :
+                             click ? (translucent ? textfield.clickedTransparentBC : textfield.clickedBC) :
+                             control.hovered ? (translucent ? textfield.hoveredTransparentBC : textfield.hoveredBC) :
+                                               (translucent ? textfield.normalTransparentBC : textfield.normalBC)
+
+    property var backBorderColor: !control.enabled ? textfield.disableBorderColor : (control.activeFocus) ? textfield.focusBorderColor :
+                                                          control.hovered ? textfield.hoverBorderColor : textfield.normalBorderColor
+
+    onPressed: click = true
+    onReleased: click = false
+
+    StylePrivate.UKUITextFiled {
+        id: textfield
+    }
+
+    StylePrivate.UKUIComboBox {
+        id: combobox
+    }
+
+    StylePrivate.APPParameter {
+        id: app
+        onParametryChanged: updateIconSources()
+        onIconThemeChanged: updateIconSources()
+    }
+
+    ListModel {
+        id: historyModel
+    }
+
+    ListModel {
+        id: filteredHistory
+    }
+
+    readonly property int _historyRowHeight: 36
+
+    function historyOverlayParent() {
+        var item = control
+        while (item) {
+            if (item.overlay)
+                return item.overlay
+            item = item.parent
+        }
+        if (Window.window) {
+            if (Window.window.overlay)
+                return Window.window.overlay
+            return Window.window.contentItem
+        }
+        return typeof Overlay !== "undefined" ? Overlay.overlay : null
+    }
+
+    function attachHistoryLayer() {
+        var p = historyOverlayParent()
+        if (p && historyLayer.parent !== p)
+            historyLayer.parent = p
+    }
+
+    function refreshHistoryPopup() {
+        if (!activeFocus || text.length === 0 || historyModel.count === 0) {
+            if (historyLayer.opened)
+                historyLayer.close()
+            return
+        }
+        var needle = text.toLowerCase()
+        var newItems = []
+        for (var i = 0; i < historyModel.count; ++i) {
+            var entry = historyModel.get(i).text
+            if (entry.toLowerCase().indexOf(needle) === 0)
+                newItems.push({ text: entry })
+        }
+        if (newItems.length === 0) {
+            if (historyLayer.opened)
+                historyLayer.close()
+            return
+        }
+        filteredHistory.clear()
+        for (var j = 0; j < newItems.length; ++j)
+            filteredHistory.append(newItems[j])
+        historyLayer.reposition()
+        historyLayer.open()
+        control.forceActiveFocus()
+    }
+
+    function applyHistoryEntry(entry) {
+        control.text = entry
+        historyLayer.close()
+        control.forceActiveFocus()
+    }
+
+    // KPopup：边距对齐 ComboBox 下拉（top/bottomMargin 6，内边距 upDownMargin）
+    Private.KPopup {
+        id: historyLayer
+        modal: false
+        focus: false
+        acceptFocus: false
+        focusTarget: control
+        animated: false
+        topMargin: 6
+        bottomMargin: 6
+        padding: combobox.upDownMargin
+        transparent: control.translucent
+        closePolicy: T.Popup.CloseOnPressOutside | T.Popup.CloseOnEscape
+        width: control.width
+        height: filteredHistory.count > 0
+               ? Math.min(filteredHistory.count * _historyRowHeight, 208) + 2 * combobox.upDownMargin
+               : 0
+
+        onClosed: filteredHistory.clear()
+
+        Component.onCompleted: control.attachHistoryLayer()
+
+        Timer {
+            interval: 50
+            running: historyLayer.parent === control
+            repeat: false
+            onTriggered: control.attachHistoryLayer()
+        }
+
+        onAboutToShow: reposition()
+        onOpened: Qt.callLater(function() { control.forceActiveFocus() })
+
+        function reposition() {
+            var overlay = historyOverlayParent()
+            if (!overlay)
+                return
+            if (historyLayer.parent !== overlay)
+                historyLayer.parent = overlay
+            var pos = control.mapToItem(overlay, 0, control.height)
+            historyLayer.x = pos.x
+            historyLayer.y = pos.y + historyLayer.topMargin
+            historyLayer.width = control.width
+            if (historyLayer.visible) {
+                historyLayer.syncWindowSize()
+                historyLayer.syncWindowPosition()
+            }
+        }
+
+        Connections {
+            target: control
+            function onWidthChanged() { historyLayer.reposition() }
+            function onXChanged() { if (historyLayer.opened) historyLayer.reposition() }
+            function onYChanged() { if (historyLayer.opened) historyLayer.reposition() }
+        }
+
+        ListView {
+            id: historyList
+            width: parent.width
+            clip: true
+            focus: false
+            activeFocusOnTab: false
+            implicitHeight: contentHeight
+            model: filteredHistory
+            boundsBehavior: Flickable.StopAtBounds
+            delegate: ItemDelegate {
+                width: historyList.width
+                height: _historyRowHeight
+                focus: false
+                text: model.text
+                onClicked: control.applyHistoryEntry(model.text)
+            }
+        }
+    }
+
+    TextMetrics {
+        id: placeHolderMetrics
+        font: control.font
+        text: placeHolderText
+    }
+
+    onWidthChanged: {
+        repaintAiGradientBorder()
+        if (!placeHolderAnim.running)
+            snapPlaceHolder()
+    }
+    onPlaceHolderTextChanged: {
+        placeHolderHost.refreshToolTip()
+        if (!placeHolderAnim.running)
+            snapPlaceHolder()
+    }
+
+    Component.onCompleted: {
+        snapPlaceHolder()
+        updateIconSources()
+        updateChrome()
+        attachHistoryLayer()
+        if (contentItem)
+            contentItem.z = 0
+    }
+
+    // 对齐 C++ paintEvent：有焦点或语义模式(m_isGradient)时画边框
+    readonly property bool _aiGradientActive: gradationEnabled && customBtn.checked && enabled
+    readonly property bool _showBorder: enabled && (activeFocus || _aiGradientActive)
+
+    // 非渐变：highlight-active；禁用：button-disable（与 C++ QPen 一致）
+    readonly property color _borderStrokeColor: !enabled
+            ? parseColor.getDtColor("button-disable")
+            : parseColor.getDtColor("highlight-active")
+
+    background: Item {
+        implicitWidth: textfield.normalWidth
+        implicitHeight: textfield.normalHeight
+
+        Rectangle {
+            id: backrec
+            anchors.fill: parent
+            radius: textfield.radius
+            color: gradientRec.visible ? "transparent" : getStartColor(backColor)
+
+            Rectangle {
+                id: gradientRec
+                anchors.fill: parent
+                radius: parent.radius
+                gradient: Gradient {
+                    GradientStop { position: 0.0; color: getStartColor(backColor) }
+                    GradientStop { position: 1.0; color: getEndColor(backColor) }
+                }
+                visible: !parseColor.isSolidPattern(backColor)
+            }
+
+            // C++ m_isGradient：四色横向渐变描边
+            Canvas {
+                id: aiGradientBorder
+                anchors.fill: parent
+                visible: control._showBorder && control._aiGradientActive
+                antialiasing: true
+
+                onPaint: {
+                    var ctx = getContext("2d")
+                    ctx.reset()
+                    if (width <= 0 || height <= 0)
+                        return
+
+                    // 与上方 Rectangle border 一致：贴控件外缘描边，不用 C++ adjusted(1,3) 内缩
+                    var lineW = textfield.focusBorderWidth > 0 ? textfield.focusBorderWidth : 2
+                    var half = lineW / 2
+                    var x = half
+                    var y = half
+                    var rw = width - lineW
+                    var rh = height - lineW
+                    if (rw <= 0 || rh <= 0)
+                        return
+
+                    var radius = (textfield.radius > 0 ? textfield.radius : 6) - half
+                    radius = Math.max(0, Math.min(radius, rw / 2, rh / 2))
+
+                    var grd = ctx.createLinearGradient(0, height / 2, width, height / 2)
+                    grd.addColorStop(0, "#E888F8")
+                    grd.addColorStop(0.4, "#8A41FF")
+                    grd.addColorStop(0.7, "#4E75FF")
+                    grd.addColorStop(1, "#0036F5")
+
+                    ctx.strokeStyle = grd
+                    ctx.lineWidth = lineW
+                    ctx.beginPath()
+                    ctx.moveTo(x + radius, y)
+                    ctx.lineTo(x + rw - radius, y)
+                    ctx.arcTo(x + rw, y, x + rw, y + radius, radius)
+                    ctx.lineTo(x + rw, y + rh - radius)
+                    ctx.arcTo(x + rw, y + rh, x + rw - radius, y + rh, radius)
+                    ctx.lineTo(x + radius, y + rh)
+                    ctx.arcTo(x, y + rh, x, y + rh - radius, radius)
+                    ctx.lineTo(x, y + radius)
+                    ctx.arcTo(x, y, x + radius, y, radius)
+                    ctx.closePath()
+                    ctx.stroke()
+                }
+            }
+
+            Rectangle {
+                anchors.fill: parent
+                radius: parent.radius
+                color: "transparent"
+                border.width: control._showBorder && !control._aiGradientActive
+                        ? textfield.focusBorderWidth : 0
+                border.color: control._borderStrokeColor
+                antialiasing: true
+            }
+        }
+    }
+
+    // 右侧清除/语义按钮必须在 contentItem 之上
+    Item {
+        id: rightChromeHost
+        z: 10
+        anchors.fill: parent
+
+        Row {
+            id: rightChromeRow
+            spacing: _toolSpacing
+            anchors.verticalCenter: parent.verticalCenter
+            anchors.right: _rtl ? undefined : parent.right
+            anchors.left: _rtl ? parent.left : undefined
+            anchors.rightMargin: 3//_iconMargin
+            anchors.leftMargin: _iconMargin
+
+            RoundButton {
+                id: clearBtn
+                width: visible ? height : 0
+                height: visible ? (control.height >= 36 ? 30 : (control.height - 6)) : 0
+                visible: false
+                flat: true
+                focusPolicy: Qt.NoFocus
+                hoverEnabled: true
+                display: AbstractButton.IconOnly
+                padding: 0
+                leftPadding: 0
+                rightPadding: 0
+                topPadding: 0
+                bottomPadding: 0
+                icon.name: "application-exit-symbolic"
+                icon.width: _iconSize
+                icon.height: _iconSize                
+
+                onClicked: control.clearField()
+            }
+
+            Rectangle {
+                id: chromeLine
+                width: visible ? 1 : 0
+                height: Math.max(16, parent.height - 12)
+                visible: customBtn.visible
+                color: control._chromeLineColor
+                anchors.verticalCenter: parent.verticalCenter
+            }
+
+            // 对齐 C++ KToolButton；icon.name 由 org.ukui.style ToolButton 经 ParseInterface 加载主题图
+            Button {
+                id: customBtn
+                width: visible ? height : 0
+                height: visible ? (control.height >= 36 ? 30 : (control.height - 6)) : 0
+                visible: false
+                //flat: true
+                checkable: true
+                focusPolicy: Qt.NoFocus
+                hoverEnabled: true
+                display: AbstractButton.IconOnly
+                padding: 0
+                leftPadding: 0
+                rightPadding: 0
+                topPadding: 0
+                bottomPadding: 0
+                //highlighted: gradationEnabled && checked
+                icon.name: _builtinCustomButtonIcon
+                icon.width: _iconSize
+                icon.height: _iconSize
+
+                flat: true
+                onCheckedChanged: control.updateChrome()
+            }
+        }
+    }
+
+    // 对齐 C++ m_pWidget：在整框内定位，超出部分由 clip 裁切（与 QWidget 子控件一致）
+    Item {
+        id: placeHolderHost
+        z: 10
+        anchors.fill: parent
+        clip: true
+        enabled: false
+
+        Item {
+            id: placeHolderRow
+            width: _placeHolderContentWidth
+            height: _placeHolderRowHeight
+            clip: true
+            anchors.verticalCenter: parent.verticalCenter
+
+            Image {
+                id: searchIcon
+                width: _iconSize
+                height: _iconSize
+                anchors.verticalCenter: parent.verticalCenter
+                fillMode: Image.PreserveAspectFit
+                smooth: true
+                cache: false
+            }
+
+            Text {
+                id: placeHolderLabel
+                visible: !control.length
+                x: _iconSize + _iconTextSpacing
+                anchors.verticalCenter: parent.verticalCenter
+                width: _placeHolderNeedsElide
+                    ? _placeHolderLabelMaxWidth
+                    : Math.max(1, Math.ceil(placeHolderMetrics.width))
+                text: placeHolderText
+                font: control.font
+                color: getStartColor(!control.enabled
+                    ? textfield.placeHolderDisableTextColor
+                    : textfield.placeHolderNormalTextColor)
+                elide: _placeHolderNeedsElide ? Text.ElideRight : Text.ElideNone
+
+                onPaintedWidthChanged: {
+                    if (!placeHolderAnim.running)
+                        control.snapPlaceHolder()
+                }
+            }
+        }
+
+        Component.onCompleted: {
+            control.snapPlaceHolder()
+            refreshToolTip()
+        }
+
+        PropertyAnimation {
+            id: placeHolderAnim
+            target: placeHolderRow
+            property: "x"
+            duration: 100
+            easing.type: Easing.InOutQuad
+        }
+
+        ToolTip {
+            delay: Qt.styleHints.mousePressAndHoldInterval
+            visible: control.hovered && _toolTipPlaceHolder !== ""
+            text: _toolTipPlaceHolder
+        }
+
+        function refreshToolTip() {
+            if (_placeHolderNeedsElide)
+                _toolTipPlaceHolder = placeHolderText
+            else
+                _toolTipPlaceHolder = ""
+        }
+
+        onWidthChanged: refreshToolTip()
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KSecurityLevelBar.qml b/ukui-qml-style-helper/controls/qml/KSecurityLevelBar.qml
new file mode 100644
index 0000000..d12ae6a
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KSecurityLevelBar.qml
@@ -0,0 +1,102 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KSecurityLevelBar.
+ * 三段彩条 + 等级文字。颜色对齐 ksecuritylevelbar.cpp：
+ *  Low -> kerror-normal, Medium -> kwarning-normal, High -> ksuccess-normal,
+ *  未点亮段 -> kcomponent-normal。
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+Item {
+    id: control
+
+    enum SecurityLevel { Low = 0, Medium = 1, High = 2 }
+
+    property int securityLevel: KSecurityLevelBar.SecurityLevel.Low
+    property color _labelColor: getDtColor("kfont-primary")
+    property var _segColors: [getDtColor("kerror-normal"), getDtColor("kcomponent-normal"), getDtColor("kcomponent-normal")]
+
+    implicitWidth: 300
+    implicitHeight: 30
+
+    signal levelChanged(int level)
+
+    StylePrivate.APPParameter { id: app }
+    StylePrivate.ParseColorInterface { id: parseColor }
+
+    Connections {
+        target: app
+        function onParametryChanged() { updateColors() }
+        function onIsDarkChanged() { updateColors() }
+    }
+
+    onSecurityLevelChanged: updateSegColors()
+
+    Component.onCompleted: updateColors()
+
+    function getDtColor(colorName) {
+        return parseColor.getDtColor(colorName)
+    }
+
+    function segColor(index) {
+        if (securityLevel === KSecurityLevelBar.SecurityLevel.Low)
+            return index === 0 ? getDtColor("kerror-normal") : getDtColor("kcomponent-normal")
+        if (securityLevel === KSecurityLevelBar.SecurityLevel.Medium)
+            return index <= 1 ? getDtColor("kwarning-normal") : getDtColor("kcomponent-normal")
+        return getDtColor("ksuccess-normal")
+    }
+
+    function updateSegColors() {
+        _segColors = [segColor(0), segColor(1), segColor(2)]
+    }
+
+    function updateColors() {
+        _labelColor = getDtColor("kfont-primary")
+        updateSegColors()
+    }
+
+    readonly property string _levelText: {
+        switch (securityLevel) {
+        case KSecurityLevelBar.SecurityLevel.Low: return qsTr("Low")
+        case KSecurityLevelBar.SecurityLevel.Medium: return qsTr("Medium")
+        case KSecurityLevelBar.SecurityLevel.High: return qsTr("High")
+        }
+        return ""
+    }
+
+    Text {
+        id: label
+        anchors.left: parent.left
+        anchors.verticalCenter: parent.verticalCenter
+        text: control._levelText
+        font: app.font
+        color: control._labelColor
+    }
+
+    Row {
+        anchors.left: label.right
+        anchors.leftMargin: 5
+        anchors.verticalCenter: parent.verticalCenter
+        spacing: 5
+
+        Repeater {
+            model: 3
+            Rectangle {
+                width: 32
+                height: 8
+                radius: height / 2
+                color: control._segColors[index]
+                antialiasing: true
+            }
+        }
+    }
+
+    function setSecurityLevel(level) {
+        securityLevel = level
+        levelChanged(level)
+    }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KSlider.qml b/ukui-qml-style-helper/controls/qml/KSlider.qml
new file mode 100644
index 0000000..3b2cc47
--- /dev/null
+++ b/ukui-qml-style-helper/controls/qml/KSlider.qml
@@ -0,0 +1,323 @@
+/*
+ * Qt5-UKUI's Library
+ *
+ * QML counterpart of kdk::KSlider。
+ * 配色对齐 org.ukui.style/Slider.qml（非 touchSlider）/ UKUISlider token：
+ *  - unGroove：kcomponent-normal（translucent -> kcomponent-alpha-normal）
+ *  - groove(cover)：kbrand-normal
+ *  - handle：kfont-white + kbrand-normal 描边，尺寸/边框对齐 Slider.qml 非 touchSlider（handleHeight=16，handleBorderWidth=3）
+ *  - NodeSlider 默认 tickInterval=10；StepSlider 默认 singleStep=10；
+ *    SingleSelectSlider range 0..2，tickInterval=1，且不画 coverLine/coverNode
+ */
+
+import QtQuick 2.12
+import QtQuick.Controls 2.12
+import QtQuick.Templates 2.12 as T
+import org.ukui.qqc2style.private 1.0 as StylePrivate
+
+T.Slider {
+    id: control
+
+    enum KSliderType { SmoothSlider = 0, StepSlider = 1, NodeSlider = 2, SingleSelectSlider = 3 }
+
+    property int sliderType: KSlider.KSliderType.SmoothSlider
+    property int tickInterval: 0
+    property bool nodeVisible: true
+    property bool translucent: false
+
+    from: 0
+    to: 100
+    value: 0
+    stepSize: sliderType === KSlider.KSliderType.StepSlider ? (tickInterval > 0 ? tickInterval : 10) : 1
+    font: app.font
+    hoverEnabled: true
+
+    implicitWidth: orientation === Qt.Horizontal ? sliderStyle.normalWidth : sliderStyle.grooveHeight
+    implicitHeight: orientation === Qt.Horizontal ? sliderStyle.normalHeight : sliderStyle.normalWidth
+
+    StylePrivate.APPParameter { id: app }
+    StylePrivate.UKUISlider { id: sliderStyle }
+    StylePrivate.ParseColorInterface { id: parseColor }
+
+    readonly property var _unGrooveBrush: translucent
+        ? (control.enabled ? sliderStyle.normalTransparentUnGrooveColor : sliderStyle.disableTransparentUnGrooveColor)
+        : (control.enabled ? sliderStyle.normalUnGrooveColor : sliderStyle.disableUnGrooveColor)
+    readonly property var _grooveBrush: control.enabled ? sliderStyle.normalGrooveColor : sliderStyle.disableGrooveColor
+
+    function _handleFillBrush(hovered) {
+        if (!control.enabled)
+            return sliderStyle.disableHandleColor
+        if (control.pressed)
+            return sliderStyle.clickHandleColor
+        if (hovered)
+            return sliderStyle.hoverHandleColor
+        return sliderStyle.normalHandleColor
+    }
+
+    function _handleBorderBrush(hovered) {
+        if (!control.enabled)
+            return sliderStyle.disableHandleBorderColor
+        if (control.pressed)
+            return sliderStyle.clickHandleBorderColor
+        if (hovered)
+            return sliderStyle.hoverHandleBorderColor
+        return sliderStyle.normalHandleBorderColor
+    }
+
+    // 几何常量（对齐 kslider.cpp）
+    readonly property int _lineWidth: sliderStyle.grooveHeight
+    readonly property int _lineRadius: _lineWidth / 2
+    readonly property int _margin: 3
+    readonly property int _handleSize: sliderStyle.handleHeight
+    readonly property int _nodeBarW: 3
+    readonly property int _nodeBarH: 10
+
+    // groove 矩形（对齐 baseLineRect）
+    readonly property rect _groove: {
+        if (orientation === Qt.Horizontal) {
+            var x = _margin + _handleSize / 2
+            return Qt.rect(x, height / 2 - _lineWidth / 2, width - 2 * x, _lineWidth)
+        } else {
+            var y = _margin + _handleSize / 2
+            return Qt.rect(width / 2 - _lineWidth / 2, y, _lineWidth, height - 2 * y)
+        }
+    }
+
+    // 节点列表（对齐 kslider.cpp locateNode）
+    readonly property var _nodeList: {
+        var list = []
+        if (!nodeVisible || sliderType === KSlider.KSliderType.SingleSelectSlider)
+            return list
+
+        var g = _groove
+        if (orientation === Qt.Horizontal) {
+            var cy = height / 2
+            list.push({ px: g.x, py: cy })
+            if (tickInterval > 0 && to !== from) {
+                for (var i = from + tickInterval; i < to; i += tickInterval) {
+                    var ratio = (i - from) / (to - from)
+                    list.push({ px: g.x + g.width * ratio, py: cy })
+                }
+            }
+            list.push({ px: g.x + g.width, py: cy })
+        } else {
+            var cx = width / 2
+            list.push({ px: cx, py: g.y + g.height })
+            if (tickInterval > 0 && to !== from) {
+                for (var j = from + tickInterval; j < to; j += tickInterval) {
+                    var ratioV = (j - from) / (to - from)
+                    list.push({ px: cx, py: g.y + g.height * ratioV })
+                }
+            }
+            list.push({ px: cx, py: g.y })
+        }
+        return list
+    }
+
+    readonly property color _nodeBase: parseColor.getDtColor("kcomponent-alpha-normal")
+    readonly property int _nodeRadius: (typeof ukui_platformtheme_token !== "undefined"
+                                        && ukui_platformtheme_token
+                                        && ukui_platformtheme_token.kradiusMin > 0)
+                                       ? ukui_platformtheme_token.kradiusMin : 4
+
+    // 当前值位置（像素）
+    readonly property real _valuePos: {
+        if (to === from) return 0
+        var r = (value - from) / (to - from)
+        if (orientation === Qt.Horizontal)
+            return _groove.x + _groove.width * r
+        else
+            return _groove.y + _groove.height * (1 - r)
+    }
+
+    background: Item {
+        implicitWidth: control.orientation === Qt.Horizontal ? 200 : control._lineWidth
+        implicitHeight: control.orientation === Qt.Horizontal ? control._lineWidth : 200
+        opacity: control.enabled ? 1 : 0.45
+
+        // unGroove
+        Item {
+            x: control._groove.x
+            y: control._groove.y
+            width: control._groove.width
+            height: control._groove.height
+
+            Rectangle {
+                anchors.fill: parent
+                radius: control._lineRadius
+                color: parseColor.isSolidPattern(control._unGrooveBrush)
+                       ? parseColor.startColor(control._unGrooveBrush)
+                       : "transparent"
+                antialiasing: true
+            }
+
+            Rectangle {
+                anchors.fill: parent
+                radius: control._lineRadius
+                visible: !parseColor.isSolidPattern(control._unGrooveBrush)
+                gradient: Gradient {
+                    GradientStop { position: 0.0; color: parseColor.startColor(control._unGrooveBrush) }
+                    GradientStop { position: 1.0; color: parseColor.endColor(control._unGrooveBrush) }
+                }
+                antialiasing: true
+            }
+        }
+
+        // cover groove（SingleSelectSlider 不画）
+        Item {
+            visible: control.sliderType !== KSlider.KSliderType.SingleSelectSlider
+            x: control._groove.x
+            y: control.orientation === Qt.Horizontal ? control._groove.y : control._valuePos
+            width: control.orientation === Qt.Horizontal
+                   ? Math.max(0, control._valuePos - control._groove.x) : control._lineWidth
+            height: control.orientation === Qt.Horizontal
+                    ? control._lineWidth
+                    : Math.max(0, control._groove.y + control._groove.height - control._valuePos)
+
+            Rectangle {
+                anchors.fill: parent
+                radius: control._lineRadius
+                color: parseColor.isSolidPattern(control._grooveBrush)
+                       ? parseColor.startColor(control._grooveBrush)
+                       : "transparent"
+                antialiasing: true
+            }
+
+            Rectangle {
+                anchors.fill: parent
+                radius: control._lineRadius
+                visible: !parseColor.isSolidPattern(control._grooveBrush)
+                gradient: Gradient {
+                    GradientStop { position: 0.0; color: parseColor.startColor(control._grooveBrush) }
+                    GradientStop { position: 1.0; color: parseColor.endColor(control._grooveBrush) }
+                }
+                antialiasing: true
+            }
+        }
+
+        // 节点（对齐 kslider.cpp drawBasePath / drawCoverNode）
+        Repeater {
+            model: control._nodeList
+
+            delegate: Item {
+                x: modelData.px - (control.orientation === Qt.Horizontal ? 1 : 5)
+                y: modelData.py - (control.orientation === Qt.Horizontal ? 5 : 3)
+                width: control.orientation === Qt.Horizontal ? control._nodeBarW : control._nodeBarH
+                height: control.orientation === Qt.Horizontal ? control._nodeBarH : control._nodeBarW
+
+                property bool _covered: control.orientation === Qt.Horizontal
+                                        ? (modelData.px <= control._valuePos)
+                                        : (modelData.py >= control._valuePos)
+
+                Rectangle {
+                    anchors.fill: parent
+                    radius: control._nodeRadius
+                    color: parent._covered
+                           ? parseColor.startColor(control._grooveBrush)
+                           : control._nodeBase
+                    antialiasing: true
+                }
+            }
+        }
+    }
+
+    handle: Item {
+        id: handleRoot
+        x: control.leftPadding + (control.orientation === Qt.Horizontal
+            ? control.visualPosition * (control.availableWidth - width) : (control.availableWidth - width) / 2)
+        y: control.topPadding + (control.orientation === Qt.Horizontal
+            ? (control.availableHeight - height) / 2 : control.visualPosition * (control.availableHeight - height))
+        width: control._handleSize
+        height: control._handleSize
+
+        property bool handleHovered: handleMouse.containsMouse || control.hovered
+        readonly property var fillBrush: control._handleFillBrush(handleHovered)
+        readonly property var borderBrush: control._handleBorderBrush(handleHovered)
+
+        MouseArea {
+            id: handleMouse
+            anchors.fill: parent
+            hoverEnabled: true
+            propagateComposedEvents: true
+            onPressed: mouse.accepted = false
+        }
+
+        Rectangle {
+            anchors.fill: handleRec
+            visible: !control.enabled
+            radius: handleRec.radius
+            color: parseColor.startColor(sliderStyle.touchHandleBaseColor)
+            antialiasing: true
+        }
+
+        Rectangle {
+            id: handleRec
+            anchors.fill: parent
+            opacity: control.enabled ? 1 : 0.45
+            radius: width / 2
+            color: parseColor.isSolidPattern(handleRoot.fillBrush)
+                   ? parseColor.startColor(handleRoot.fillBrush)
+                   : "transparent"
+            border.width: control.pressed ? sliderStyle.handleBorderWidth * 1.25 : sliderStyle.handleBorderWidth
+            border.color: parseColor.startColor(handleRoot.borderBrush)
+            scale: 1.0
+            antialiasing: true
+
+            states: [
+                State {
+                    name: "HOVERED"
+                    when: control.enabled && !control.pressed && handleRoot.handleHovered
+                    PropertyChanges { target: handleRec; scale: 1.125 }
+                },
+                State {
+                    name: "PRESSED"
+                    when: control.enabled && control.pressed
+                    PropertyChanges {
+                        target: handleRec
+                        scale: 1.0
+                        border.width: sliderStyle.handleBorderWidth * 1.25
+                    }
+                }
+            ]
+
+            transitions: [
+                Transition {
+                    from: "*"; to: "HOVERED"
+                    reversible: true
+                    NumberAnimation { property: "scale"; duration: 100; easing.type: Easing.InOutSine }
+                },
+                Transition {
+                    from: "*"; to: "PRESSED"
+                    reversible: true
+                    ParallelAnimation {
+                        NumberAnimation { property: "scale"; duration: 100; easing.type: Easing.InOutSine }
+                        NumberAnimation { property: "border.width"; duration: 100; easing.type: Easing.Linear }
+                    }
+                }
+            ]
+
+            Rectangle {
+                anchors.fill: parent
+                radius: parent.radius
+                border.width: parent.border.width
+                border.color: parent.border.color
+                visible: control.enabled && !parseColor.isSolidPattern(handleRoot.fillBrush)
+                gradient: Gradient {
+                    GradientStop { position: 0.0; color: parseColor.startColor(handleRoot.fillBrush) }
+                    GradientStop { position: 1.0; color: parseColor.endColor(handleRoot.fillBrush) }
+                }
+                antialiasing: true
+            }
+        }
+    }
+
+    function setSliderType(t) {
+        sliderType = t
+        if (tickInterval === 0 && t === KSlider.KSliderType.NodeSlider) tickInterval = 10
+        if (singleStep === 0 && t === KSlider.KSliderType.StepSlider) stepSize = 10
+        if (t === KSlider.KSliderType.SingleSelectSlider) { tickInterval = 1; stepSize = 1; from = 0; to = 2 }
+    }
+    function setTickInterval(i) { tickInterval = i }
+    function setNodeVisible(f) { nodeVisible = f }
+    function setTranslucent(f) { translucent = f }
+}
diff --git a/ukui-qml-style-helper/controls/qml/KUninstallDialog.qml b/ukui-qml-style-helper/controls/qml/KUninstallDialog.qml
