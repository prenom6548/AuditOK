#!/bin/bash

if [ "$1" == "/usr/bin/download.py" ]; then
    echo $@

    modelenv_path=$HOME/.cache/pythonvenv/modelenv

    echo ${modelenv_path}

    python3 -m venv ${modelenv_path}

    source ${modelenv_path}/bin/activate

    if ! pip show modelscope > /dev/null 2>&1; then
        echo "installing modelscope"
        python3 -m pip install modelscope -i https://pypi.tuna.tsinghua.edu.cn/simple
    fi

    echo "依赖下载完成"

    python3 $@

    deactivate
else
    echo "模型保存路径" $@
    [ -d "$2" ] || mkdir -p $2
    chmod -R a+r $1
    ln -s $@
fi
