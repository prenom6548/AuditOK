<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/polkit-policy-configuration-1.0.dtd">
<policyconfig>
  <vendor>Kylin OS</vendor>
  <vendor_url>https://www.kylinos.cn/</vendor_url>

  <action id="com.kylin.ai.model.management.download-model">
    <description>需要管理员权限以下载端侧模型</description>
    <message>需要管理员权限以下载端侧模型</message>
    <defaults>
      <allow_any>yes</allow_any> <!-- 允许所有用户执行 -->
      <allow_inactive>auth_admin_keep</allow_inactive> <!-- 认证后保持一段时间 -->
      <allow_active>auth_admin_keep</allow_active> <!-- 认证后保持一段时间 -->
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/download-in-venv</annotate>
  </action>
</policyconfig>
