diff --git a/download-in-venv b/download-in-venv
new file mode 100755
index 0000000..225e677
--- /dev/null
+++ b/download-in-venv
@@ -0,0 +1,24 @@
+#!/bin/bash
+
+set -e
+
+echo $@
+
+modelenv_path=$HOME/.cache/pythonvenv/modelenv
+
+echo ${modelenv_path}
+
+python3 -m venv ${modelenv_path}
+
+source ${modelenv_path}/bin/activate
+
+if ! pip show modelscope > /dev/null 2>&1; then
+    echo "installing modelscope"
+    python3 -m pip install modelscope
+fi
+
+echo "依赖下载完成"
+
+python3 $@
+
+deactivate
