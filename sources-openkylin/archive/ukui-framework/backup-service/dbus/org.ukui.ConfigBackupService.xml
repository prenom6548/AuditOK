<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
    <interface name="org.ukui.ConfigBackupService">
        <method name="GetBackupConfig">
            <arg name="modules" type="as" direction="in"/>
            <arg name="name" type="s" direction="in"/>
            <arg name="config" type="s" direction="out"/>
        </method>
        <method name="SyncConfig">
            <arg name="config" type="s" direction="in"/>
            <arg name="successList" type="as" direction="out"/>
        </method>
    </interface>
</node>
