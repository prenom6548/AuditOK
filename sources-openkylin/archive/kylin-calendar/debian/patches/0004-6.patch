+           m_ifLunarcheckBox->setStyleSheet("QCheckBox {"
+                                            "   background-color:#222222;"
+                                            "   border: none; /* 移除边框，默认边框可能会盖住背景色 */"
+                                            "   border-radius: 6px; "
+                                            "}");
+           allDaycheckBox->setStyleSheet("QCheckBox {"
+                                         "   background-color:#222222;"
+                                         "   border: none; /* 移除边框，默认边框可能会盖住背景色 */"
