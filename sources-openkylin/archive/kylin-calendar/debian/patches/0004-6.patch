+    screen = qobject_cast<QScreen *>(sender());
+    // 当主屏幕变化时，更新主屏幕和高度
+     qDebug() << "Screen geometry changed:" << screen->name() << newGeometry;
+//    screen = newScreen;
+    primaryScreenHeight = screen->size().height();
+
+    updatePrimaryScreenHeight();
+
+}
+void LunarCalendarWidget::onGSettingsChanged(const QString &key) {
+    if(key == PANEL_POSITION_KEY){
+        qDebug()<<"变化了";
+        int num = m_markInfoList.count();
+        int calendar_height;
+        if(num == 0 ){
+            calendar_height = ORIGIN_CALENDAR_HEIGHT;
+        }else if(num <= 2){
+            calendar_height = LESSTWOSHCEDULE_CALENDAR_HEIGHT;
+        }else if(num > 2){
+            calendar_height= TWO_MORE_SCHEDULE_HEIGHT;
+        }/*else if(isMore){
+            calendar_height=THREE_SCHEDULE_HEIGHT;
+        }*/
+        int width = screen->size().width();
+        int height = screen->size().height();
+        int m_panelPoistion = m_panelGsettings->get(PANEL_POSITION_KEY).toInt();
+        qDebug()<<"变化了"<<m_panelPoistion;
+        int  m_panelSize = m_panelGsettings->get(PANEL_SIZE_KEY).toInt();
+        //width-m_panelSize-ORIGIN_CALENDAR_WIDTH+WIDGET_GAP , qApp->screenAt(QCursor::pos())->geometry().x()+m_panelSize+WIDGET_GAP
+        if(m_panelPoistion == 2){
+            this->move(qApp->screenAt(QCursor::pos())->geometry().x()+m_panelSize+WIDGET_GAP,height-calendar_height-WIDGET_GAP-8);
+        }
+        else if(m_panelPoistion == 0){
+            this->move(width - ORIGIN_CALENDAR_WIDTH - WIDGET_GAP,panelHeight-calendar_height-WIDGET_GAP);
+        } else if(m_panelPoistion ==3){
+            this->move(width-m_panelSize-ORIGIN_CALENDAR_WIDTH-WIDGET_GAP,height-calendar_height-WIDGET_GAP-8);
+        } else if(m_panelPoistion == 1){
+            this->move(width-ORIGIN_CALENDAR_WIDTH-WIDGET_GAP,m_panelSize+WIDGET_GAP);
+        }
+    }
+    if(key == PANEL_SIZE_KEY){
+        panelSize = m_panelGsettings->get(PANEL_SIZE_KEY).toInt();
+        screenHeight = screen->size().height();
+        panelHeight = primaryScreenHeight-panelSize;//这个值就是屏幕到任务栏的高度
+
+    }
+}
