--- miracast-dialog-1.0.orig/miracastDialog.pro
+++ miracast-dialog-1.0/miracastDialog.pro
@@ -2,6 +2,8 @@ QT       += core gui dbus KWindowSystem
 
 greaterThan(QT_MAJOR_VERSION, 4): QT += widgets
 
+TARGET = miracastDialog
+
 # 适配窗口管理器圆角阴影
 LIBS +=-lpthread
 LIBS +=-lX11
@@ -29,7 +31,11 @@ HEADERS += \
 FORMS += \
     src/widget.ui
 
-# Default rules for deployment.
-qnx: target.path = /tmp/$${TARGET}/bin
-else: unix:!android: target.path = /opt/$${TARGET}/bin
-!isEmpty(target.path): INSTALLS += target
+
+unix {
+
+    target.path = /usr/bin
+    desktop_file.files = miracle-dialog.desktop
+    desktop_file.path = /etc/xdg/autostart
+    INSTALLS += target desktop_file
+}
