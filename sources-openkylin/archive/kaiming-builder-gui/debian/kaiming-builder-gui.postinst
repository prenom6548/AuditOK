#!/bin/sh

set -e

input_file="/ostree/pkgs/system-ovl.conf"

etc_path_ln="/etc"
lib_path_ln="/lib"
usr_share_ln="/usr/share"
bin_ln_V11="/opt/system/bin"
bin_ln_not_V11="/usr/bin"

etc_path="/opt/system/conf"
lib_path="/opt/system/lib"
usr_share="/opt/system/resource"
bin_path="/opt/kaiming-tools/bin"

is_V11=0

if [ -e "$input_file" ]; then
    is_V11=1
fi

if [ $is_V11 -eq 0 ]; then

	if [ ! -e $bin_ln_not_V11/kaiming-builder-gui ]; then
		if [ ! -d "${bin_ln_not_V11}" ]; then
            mkdir -p "${bin_ln_not_V11}"
        fi
		ln -s /opt/kaiming-tools/bin/kaiming-builder-gui $bin_ln_not_V11/kaiming-builder-gui
	fi

	if [ ! -e $usr_share_ln/applications/kaiming-builder-gui.desktop ]; then
		if [ ! -d "$usr_share_ln/applications" ]; then
            mkdir -p "$usr_share_ln/applications"
        fi
		ln -s /opt/kaiming-tools/share/kaiming-builder-gui/kaiming-builder-gui.desktop $usr_share_ln/applications/kaiming-builder-gui.desktop
	fi
else

	if [ ! -e $bin_ln_V11/kaiming-builder-gui ]; then
		ln -s /opt/kaiming-tools/bin/kaiming-builder-gui $bin_ln_V11/kaiming-builder-gui
	fi

	if [ ! -e $usr_share/applications/kaiming-builder-gui.desktop ]; then
		if [ ! -d "$usr_share/applications" ]; then
            mkdir -p "$usr_share/applications"
        fi
		ln -s /opt/kaiming-tools/share/kaiming-builder-gui/kaiming-builder-gui.desktop $usr_share/applications/kaiming-builder-gui.desktop
	fi
	
fi

exit 0

# vim:set sw=4 sts=4 et:
