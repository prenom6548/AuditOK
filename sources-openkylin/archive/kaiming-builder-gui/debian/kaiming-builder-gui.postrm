#!/bin/bash
# 删除符号链接 (如果存在)
input_file="/ostree/pkgs/system-ovl.conf"

etc_path_ln="/etc"
lib_path_ln="/lib"
usr_share_ln="/usr/share"
bin_ln_V11="/opt/system/bin"
bin_ln_not_V11="/usr/bin"

etc_path="/opt/system/conf"
lib_path="/opt/system/lib"
usr_share="/opt/system/resource"
bin_path="/opt/kaiming-tools/bin"

is_V11=0

if [ -e "$input_file" ]; then
    is_V11=1
fi

if [ $is_V11 -eq 0 ]; then
	if [ -L $bin_ln_not_V11/kaiming-builder-gui ]; then
		rm -f $bin_ln_not_V11/kaiming-builder-gui
	fi

	if [ -L $usr_share_ln/applications/kaiming-builder-gui.desktop ]; then
		rm -f $usr_share_ln/applications/kaiming-builder-gui.desktop
	fi
else
	if [ -L $bin_ln_V11/kaiming-builder-gui ]; then
		rm -f $bin_ln_V11/kaiming-builder-gui
	fi

	if [ -L $usr_share/applications/kaiming-builder-gui.desktop ]; then
		rm -f $usr_share/applications/kaiming-builder-gui.desktop
	fi
fi


exit 0
