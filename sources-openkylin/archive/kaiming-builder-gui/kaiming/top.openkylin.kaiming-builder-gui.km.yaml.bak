version: 1
package:
  id: top.openkylin.kaiming-builder-gui
  name: kaiming-builder-gui
  version: 1.0.0-ok1k0.13
  kind: app
command:
  - kaiming-builder-gui
channel: stable
permission:
  filesystem:
    xdg-user-dirs: true
    filesystem-dirs:
      - "~"
      - /data
  net:
    network: true
    scanning: true
  device:
    usb: true
base: stable:top.openkylin.base/1.1.0
runtime: stable:top.openkylin.ukui/1.1.0
depends:
  - depend.openkylin.libyaml-cpp-dev
  - depend.openkylin.libkf5windowsystem-dev
cleanup:
  []
annotations:
  kylin.privilege: true
  kylin.depend-apps:
    - kaiming
    - kaiming-builder
    - pkexec
components:
  - name: kaiming-builder-gui
    buildsystem: qmake
    config-opts:
      - CONFIG+=KAIMING
    sources:
      - type: dir
        path: ..