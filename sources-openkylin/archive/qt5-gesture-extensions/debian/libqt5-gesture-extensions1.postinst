#! /bin/bash
function cleanconfig() {
    file="/usr/share/X11/touchscreen/01-kylin.conf"
    if [ -f "${file}" ];then
        rm ${file}
        echo "${file} has been deleted!"
    fi
    desktop="/etc/xdg/autostart/touchegg.desktop"
    if [ -f "${desktop}" ];then
        rm ${desktop}
        echo "${desktop} has been deleted!"
    fi
}
function stoptouchegg() {
    if [ -d /run/systemd/system ]; then
        deb-systemd-helper stop 'touchegg.service' >/dev/null || true
        deb-systemd-helper disable 'touchegg.service' >/dev/null || true
        deb-systemd-helper --system daemon-reload >/dev/null || true
        echo "Stop Touchegg Success !"
    fi
}

echo "file = $#, param = $@"

if [ "$#" == 1 ] && [ "$1" == "reconfigure" ]; then
    # OTA升级时的执行分支
    echo "Total parameter is 1"
    stoptouchegg
    cleanconfig
else
    # 安装包正常安装的安装后脚本执行顺序
    stoptouchegg
    cleanconfig
fi

echo "stop ukui-touchegg finish"
