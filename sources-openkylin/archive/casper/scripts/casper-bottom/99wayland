#!/bin/sh

PREREQ=""

prereqs()
{
       echo "$PREREQ"
}

case $1 in
# get pre-requisites
prereqs)
       prereqs
       exit 0
       ;;
esac

if grep -q boot=casper /proc/cmdline; then
	if ! grep -q live /proc/cmdline; then
		if [ -e /root/usr/bin/ukui-session-wayland ]; then
			sed -i 's/ukui-session/kylin-os-installer-live/' /root/usr/bin/ukui-session-wayland
		fi
		if [ -e /root/usr/share/wayland-sessions/kylin-wlcom.desktop ]; then
			sed -i 's/ukui-session/kylin-os-installer-live/g' /root/usr/share/wayland-sessions/kylin-wlcom.desktop
		fi
	fi
fi
