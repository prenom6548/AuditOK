#ifndef AUTOTESTS_BLUETOOTH_CONNECTOR_STUB_QTIME
#define AUTOTESTS_BLUETOOTH_CONNECTOR_STUB_QTIME

#include <QtGlobal>

class QTime
{
public:
    QTime() = default;

    static QTime currentTime()
    {
        return QTime(s_currentValue++);
    }

    QTime addMSecs(int msecs) const
    {
        Q_UNUSED(msecs)
        return QTime(m_value + 3);
    }

    bool operator<(const QTime &other) const
    {
        return m_value < other.m_value;
    }

private:
    explicit QTime(int value)
        : m_value(value)
    {
    }

    int m_value = 0;
    inline static int s_currentValue = 0;
};

#endif
