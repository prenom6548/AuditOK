<!-- details about the keys used by the distribution -->
<!ENTITY keyring-distro "OpenKylin">
<!ENTITY keyring-package "<package>openkylin-keyring</package>">
<!ENTITY keyring-filename "<filename>/usr/share/keyrings/openkylin-archive-keyring.gpg</filename>">
<!ENTITY keyring-removed-filename "<filename>/usr/share/keyrings/openkylin-archive-removed-keys.gpg</filename>">
<!ENTITY keyring-master-filename "/usr/share/keyrings/openkylin-master-keyring.gpg">
<!ENTITY keyring-uri "http://archive.build.openkylin.top/openkylin/project/openkylin-archive-keyring.gpg">
<!ENTITY openkylin-codename "nile">

<!ENTITY sourceslist-list-format "http://archive.build.openkylin.top/openkylin &openkylin-codename; main cross pty
deb http://archive.build.openkylin.top/openkylin &openkylin-codename;-security main cross pty
deb http://archive.build.openkylin.top/openkylin &openkylin-codename;-updates main cross pty">

<!ENTITY sourceslist-sources-format "Types: deb
URIs: http://archive.build.openkylin.top/openkylin
Suites: &openkylin-codename; &openkylin-codename;-security &openkylin-codename;-updates
Components: main cross pty">
