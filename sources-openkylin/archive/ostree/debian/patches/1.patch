---
 src/boot/grub2/grub2-15_ostree          | 1 +
 src/libostree/ostree-bootloader-grub2.c | 8 ++++++--
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/boot/grub2/grub2-15_ostree b/src/boot/grub2/grub2-15_ostree
index f423561..1a67b19 100644
--- a/src/boot/grub2/grub2-15_ostree
+++ b/src/boot/grub2/grub2-15_ostree
@@ -17,6 +17,7 @@
 
 # Gracefully exit if ostree is not installed, or there's
 # no system repository initialized.
+mount --bind /boot/ /sysroot/boot/
 if ! which ostree >/dev/null 2>/dev/null; then
     exit 0
 fi
diff --git a/src/libostree/ostree-bootloader-grub2.c b/src/libostree/ostree-bootloader-grub2.c
index e1ee786..8f3a737 100644
--- a/src/libostree/ostree-bootloader-grub2.c
+++ b/src/libostree/ostree-bootloader-grub2.c
@@ -154,8 +154,12 @@ _ostree_bootloader_grub2_generate_config (OstreeSysroot *sysroot, int bootversio
                                           GCancellable *cancellable, GError **error)
 {
   /* So... yeah.  Just going to hardcode these. */
-  static const char hardcoded_video[] = "load_video\n"
-                                        "set gfxpayload=keep\n";
+  #if defined(__aarch64__) || defined(__arm__)
+    static const char hardcoded_video[] = "";
+  #else
+    static const char hardcoded_video[] = "load_video\n"
+      "set gfxpayload=keep\n";
+  #endif
   static const char hardcoded_insmods[] = "insmod gzio\n";
   const char *grub2_boot_device_id = g_getenv ("GRUB2_BOOT_DEVICE_ID");
   const char *grub2_prepare_root_cache = g_getenv ("GRUB2_PREPARE_ROOT_CACHE");
