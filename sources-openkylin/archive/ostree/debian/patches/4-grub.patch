---
 src/boot/grub2/grub2-15_ostree | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/boot/grub2/grub2-15_ostree b/src/boot/grub2/grub2-15_ostree
index d0475f4..8eb8789 100644
--- a/src/boot/grub2/grub2-15_ostree
+++ b/src/boot/grub2/grub2-15_ostree
@@ -21,6 +21,8 @@
 #need bind before update-grub 
 mount --bind /boot/ /sysroot/boot/
 mount --bind /boot/efi/ /sysroot/boot/efi/
+#openkylin系统上的ostree使用systemd-boot启动引导，增加软连接
+ln -sf /boot/loader/grub.cfg /boot/grub/grub.cfg
 
 if ! which ostree >/dev/null 2>/dev/null; then
     exit 0
@@ -67,6 +69,4 @@ export GRUB2_BOOT_DEVICE_ID
 GRUB2_PREPARE_ROOT_CACHE="$(prepare_grub_to_access_device ${DEVICE})"
 export GRUB2_PREPARE_ROOT_CACHE
 
-exec ostree admin instutil grub2-generate
-
-update-grub
+exec ostree admin instutil grub2-generate
