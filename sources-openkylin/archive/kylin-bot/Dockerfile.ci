# Dockerfile.ci — CI/release image using pre-built binaries.
# Used by release workflows to skip the ~60 min Rust compilation.
# The main Dockerfile is still used for local dev builds.

# ── Runtime (Distroless) ─────────────────────────────────────
FROM gcr.io/distroless/cc-debian13:nonroot@sha256:84fcd3c223b144b0cb6edc5ecc75641819842a9679a3a58fd6294bec47532bf7

ARG TARGETARCH

# Copy the pre-built binary for this platform (amd64 or arm64)
COPY bin/${TARGETARCH}/kylinbot /usr/local/bin/kylinbot

# Copy the web dashboard bundled alongside the binary in the release tarball.
# The dashboard was decoupled from the binary in #5665 and is now served from
# disk at `gateway.web_dist_dir`; without this COPY the distroless image has
# no `/kylinbot-data/web/dist` and `GET /` returns HTTP 503.
COPY bin/${TARGETARCH}/web/dist /kylinbot-data/web/dist

# Runtime directory structure and default config
COPY --chown=65534:65534 kylinbot-data/ /kylinbot-data/

ENV LANG=C.UTF-8
ENV KYLINBOT_WORKSPACE=/kylinbot-data/workspace
ENV HOME=/kylinbot-data
ENV KYLINBOT_GATEWAY_PORT=42617

WORKDIR /kylinbot-data
USER 65534:65534
EXPOSE 42617
ENTRYPOINT ["kylinbot"]
CMD ["daemon"]
