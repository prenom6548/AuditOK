# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS web-builder

WORKDIR /src/web

COPY web/package.json web/package-lock.json* ./
RUN npm ci --ignore-scripts

COPY web/ ./
RUN npm run build

FROM rust:1.94-bookworm AS builder

WORKDIR /src

ARG RUST_TARGET=x86_64-unknown-linux-gnu
ARG KYLINBOT_CARGO_FEATURES=

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add "${RUST_TARGET}"

COPY Cargo.toml Cargo.lock ./
COPY build.rs ./
COPY src/ src/
COPY crates/ crates/
COPY benches/ benches/
COPY apps/tauri/Cargo.toml apps/tauri/Cargo.toml
COPY --from=web-builder /src/web/dist web/dist

RUN mkdir -p apps/tauri/src \
    && printf '%s\n' 'fn main() {}' > apps/tauri/src/main.rs \
    && printf '%s\n' 'fn main() {}' > apps/tauri/build.rs

RUN --mount=type=cache,id=kylinbot-build-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=kylinbot-build-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=kylinbot-build-target,target=/src/target,sharing=locked \
    if [ -n "${KYLINBOT_CARGO_FEATURES}" ]; then \
      cargo build --release --locked --bin kylinbot --target "${RUST_TARGET}" --features "${KYLINBOT_CARGO_FEATURES}"; \
    else \
      cargo build --release --locked --bin kylinbot --target "${RUST_TARGET}"; \
    fi && \
    install -Dm755 "target/${RUST_TARGET}/release/kylinbot" /out/kylinbot

FROM scratch AS artifact

COPY --from=builder /out/ /
