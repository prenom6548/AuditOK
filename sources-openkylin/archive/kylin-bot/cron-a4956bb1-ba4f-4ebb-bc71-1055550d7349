od org.ukui.Framework.UI.OsdServer.ShowCameraStatusOn\n\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/OsdServer \\\n  --method org.ukui.Framework.UI.OsdServer.ShowCameraStatusOff\n```\n\n### 8. 音频状态\n&gt; 显示音频状态\n\n```\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/OsdServer \\\n  --method org.ukui.Framework.UI.OsdServer.ShowAudioStatusOSD true\n\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/OsdServer \\\n  --method org.ukui.Framework.UI.OsdServer.ShowAudioStatusOn\n\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/OsdServer \\\n  --method org.ukui.Framework.UI.OsdServer.ShowAudioStatusOff\n```\n\n### 9. 电源模式OSD\n&gt; 电源模式切换\n\n```\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/OsdServer \\\n  --method org.ukui.Framework.UI.OsdServer.ShowPowerModeOSD 0\n\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/OsdServer \\\n  --method org.ukui.Framework.UI.OsdServer.ShowPowerModePerformance\n\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/OsdServer \\\n  --method org.ukui.Framework.UI.OsdServer.ShowPowerModeEco\n\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/OsdServer \\\n  --method org.ukui.Framework.UI.OsdServer.ShowPowerModeAuto\n```\n\n### 10. WiFi状态\n&gt; 显示WiFi状态\n\n```\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/OsdServer \\\n  --method org.ukui.Framework.UI.OsdServer.ShowWifiModeOSD true\n\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/OsdServer \\\n  --method org.ukui.Framework.UI.OsdServer.ShowWifiModeOn\n\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/OsdServer \\\n  --method org.ukui.Framework.UI.OsdServer.ShowWifiModeOff\n```\n\n### 11. 自定义OSD\n&gt; 显示自定义图标\n\n```\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/OsdServer \\\n  --method org.ukui.Framework.UI.OsdServer.ShowCustomOSD &quot;my-icon&quot;\n```\n\n### 12. 自定义进度条\n&gt; 显示自定义进度条\n\n```\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/OsdServer \\\n  --method org.ukui.Framework.UI.OsdServer.ShowBarWindow &quot;my-bar&quot; 50 100\n```\n\n---\n\n## 完整对话样例\n\n**你**: 显示音量OSD，当前60\n**誩**: [OSD显示：音量条60]\n\n**你**: 显示亮度OSD 70%\n**誩**: [OSD显示：亮度条70]\n\n**你**: 显示飞行模式已开\n**誩**: [OSD显示：飞行模式开]\n\n**你**: 显示性能模式\n**誩**: [OSD显示：性能模式图标]\n</instruction>\n    </instructions>\n  </skill>\n  <skill>\n    <name>panel</name>\n    <description>任务栏相关操作</description>\n    <location>/home/ky/.kylinbot/workspace/skills/panel/SKILL.md</location>\n    <instructions>\n      <instruction>\n# 任务栏 (Panel) 对话测试\n\n## 测试流程\n\n### 1. 查合并图标\n&gt; 任务栏图标是合并的吗\n\n```\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/Panel \\\n  --method org.ukui.Framework.UI.Panel.GetMergeIcons\n```\n返回值: 0=从不合并, 1=始终合并, 2=窗口满时合并\n\n### 2. 设置合并图标\n&gt; 任务栏图标始终合并\n\n```\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/Panel \\\n  --method org.ukui.Framework.UI.Panel.SetMergeIcon 1\n```\n\n### 3. 面板位置\n&gt; 任务栏位置\n\n```\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/Panel \\\n  --method org.ukui.Framework.UI.Panel.GetPanelLocation\n```\n返回值: 0=底部, 2=顶部, 1=左侧, 3=右侧\n\n### 4. 设置面板位置\n&gt; 任务栏移到顶部\n\n```\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/Panel \\\n  --method org.ukui.Framework.UI.Panel.SetPanelLocation 2\n```\n\n### 5. 面板尺寸\n&gt; 任务栏调大\n\n```\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/Panel \\\n  --method org.ukui.Framework.UI.Panel.GetPanelSizePolicy\n\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/Panel \\\n  --method org.ukui.Framework.UI.Panel.SetPanelSizePolicy 2\n```\n可选值: 0=小, 1=中, 2=大\n\n### 6. 自动隐藏\n&gt; 任务栏自动隐藏\n\n```\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/Panel \\\n  --method org.ukui.Framework.UI.Panel.GetPanelAutoHide\n\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/Panel \\\n  --method org.ukui.Framework.UI.Panel.SetPanelAutoHide true\n```\n\n### 7. 锁定面板\n&gt; 锁定任务栏\n\n```\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/Panel \\\n  --method org.ukui.Framework.UI.Panel.GetPanelLockState\n\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/Panel \\\n  --method org.ukui.Framework.UI.Panel.SetPanelLockState true\n```\n\n### 8. 所有屏幕显示面板\n&gt; 所有屏幕都显示任务栏\n\n```\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/Panel \\\n  --method org.ukui.Framework.UI.Panel.GetShowPanelOnAllScreens\n\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/Panel \\\n  --method org.ukui.Framework.UI.Panel.SetShowPanelOnAllScreens true\n```\n\n### 9. 所有面板显示托盘\n&gt; 所有面板都显示系统托盘\n\n```\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/Panel \\\n  --method org.ukui.Framework.UI.Panel.SetShowSystemTrayOnAllPanels true\n```\n\n### 10. 任务栏图标显示策略\n&gt; 任务栏图标显示在所有工作区\n\n```\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/Panel \\\n  --method org.ukui.Framework.UI.Panel.SetTaskBarIconsShowedOn 1\n```\n可选值: 0=仅当前工作区, 1=所有工作区\n\n### 11. 任务视图按钮\n&gt; 显示任务视图按钮\n\n```\ngdbus call --session --dest org.ukui.Framework \\\n  --object-path /org/ukui/Framework/UI/Panel \\\n  --method org.ukui.Framework.UI.Panel.SetShowTaskView true\n```\n\n### 12. 搜索按钮\