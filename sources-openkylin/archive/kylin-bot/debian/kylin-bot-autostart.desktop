[Desktop Entry]
Encoding=UTF-8
Name=Kylin Bot
Comment=Start Kylin Bot agent daemon after login (gateway, channels and scheduler).
Keywords=kylinbot;assistant;ai;
Exec=/usr/bin/kylin-bot daemon
StartupNotify=false
Terminal=false
Type=Application
Categories=Utility;
X-GNOME-Autostart-enabled=true
X-UKUI-AutoRestart=true
