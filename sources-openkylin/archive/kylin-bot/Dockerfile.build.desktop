# syntax=docker/dockerfile:1.7

FROM rust:1.94-bookworm AS builder

WORKDIR /src

ARG RUST_TARGET=x86_64-unknown-linux-gnu

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        file \
        libayatana-appindicator3-dev \
        libgtk-3-dev \
        librsvg2-dev \
        libwebkit2gtk-4.1-dev \
        libxdo-dev \
        patchelf \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add "${RUST_TARGET}"
RUN cargo install tauri-cli --locked --version '^2.0'

COPY Cargo.toml Cargo.lock ./
COPY apps/tauri/ apps/tauri/
COPY src/ src/
COPY crates/ crates/

RUN --mount=type=cache,id=kylinbot-desktop-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=kylinbot-desktop-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=kylinbot-desktop-target,target=/src/target,sharing=locked \
    cargo tauri build --manifest-path apps/tauri/Cargo.toml --target "${RUST_TARGET}" --bundles appimage && \
    mkdir -p /out && \
    find "target/${RUST_TARGET}/release/bundle/appimage" -maxdepth 1 -type f -name '*.AppImage' -exec cp {} /out/ \;

FROM scratch AS artifact

COPY --from=builder /out/ /
