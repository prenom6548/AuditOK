+def Judgment_PANGUX():
+    args = ["dmidecode", "--oem-string", "4"]
+    pipe = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    output = pipe.stdout.readlines()
+    for l in output:
+        line = bytes.decode(l.strip(),"utf-8","ignore")
+        if "PGUX" == line:
