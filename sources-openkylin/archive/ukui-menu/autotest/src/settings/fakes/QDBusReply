#ifndef AUTOTEST_SETTINGS_FAKE_QDBUS_REPLY_H
#define AUTOTEST_SETTINGS_FAKE_QDBUS_REPLY_H

#include <QVariant>

template<typename T>
class QDBusReply
{
public:
    QDBusReply(const QVariant &value)
        : m_value(value.value<T>()), m_valid(value.isValid())
    {
    }

    bool isValid() const { return m_valid; }
    T value() const { return m_value; }

private:
    T m_value {};
    bool m_valid {false};
};

#endif
