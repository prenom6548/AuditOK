{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iso_3166_2",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "code",
      "name",
      "country_alpha2",
      "parent_code",
      "timezone_ids"
    ],
    "properties": {
      "code": {
        "type": "string",
        "pattern": "^[A-Z]{2}-.+$"
      },
      "name": {
        "type": "string"
      },
      "country_alpha2": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "parent_code": {
        "type": ["string", "null"]
      },
      "timezone_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  }
}
