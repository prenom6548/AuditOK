{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manifest",
  "type": "object",
  "required": [
    "generated_at",
    "generator_version",
    "source_versions",
    "source_tag",
    "files"
  ],
  "properties": {
    "generated_at": {
      "type": "string"
    },
    "generator_version": {
      "type": "string"
    },
    "source_versions": {
      "type": "object"
    },
    "source_tag": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "sha256",
          "records"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "records": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
