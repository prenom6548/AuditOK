{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "timezone_coords",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "lat",
      "lon",
      "timezone"
    ],
    "properties": {
      "lat": {
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "lon": {
        "type": "number",
        "minimum": -180,
        "maximum": 180
      },
      "timezone": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  }
}
