{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iso_3166_1",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "alpha2",
      "alpha3",
      "name",
      "numeric",
      "currency",
      "emoji",
      "timezones"
    ],
    "properties": {
      "alpha2": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "alpha3": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      },
      "name": {
        "type": "string"
      },
      "numeric": {
        "type": ["integer", "null"],
        "minimum": 0,
        "maximum": 65535
      },
      "currency": {
        "type": ["string", "null"]
      },
      "emoji": {
        "type": ["string", "null"]
      },
      "timezones": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  }
}
