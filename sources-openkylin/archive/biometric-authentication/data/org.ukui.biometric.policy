<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>

	<icon_name>stock_person</icon_name>

	<action id="org.ukui.biometric.enroll-own-data">
		<description>Enroll your biometric feature</description>
		<description xml:lang="zh">录入您的用户生物特征信息</description>
		<description xml:lang="bo">ནང་འཇུག་ཁྱེད་སྤྱོད་མཁན་སྐྱེ་དངོས་ཀྱི་ཁྱད་རྟགས་ཆ་འཕྲིན། </description>
		<description xml:lang="mn">ᠲᠠᠨ ᠤ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠦᠨ ᠠᠮᠢᠳᠤ ᠪᠣᠳᠠᠰ ᠤᠨ ᠣᠨᠴᠠᠯᠢᠭ ᠤᠨ ᠰᠤᠷᠠᠭ ᠵᠠᠩᠭᠢ ᠳᠤ ᠣᠷᠣᠭᠤᠯ </description>
		<description xml:lang="zh_HK">錄入您的使用者生物特徵資訊 </description>
		<message>Enrolling your biometric features requires authorization</message>
		<message xml:lang="zh">录入您的用户生物特征信息需要授权</message>
		<message xml:lang="bo">ནང་འཇུག་ཁྱེད་སྤྱོད་མཁན་སྐྱེ་དངོས་ཀྱི་ཁྱད་རྟགས་ཆ་འཕྲིན་དགོས་མཁོ་དབང་བསྐུར། </message>
		<message xml:lang="mn">ᠲᠠᠨ ᠤ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠦᠨ ᠠᠮᠢᠳᠤ ᠪᠣᠳᠠᠰ ᠤᠨ ᠣᠨᠴᠠᠯᠢᠭ ᠤᠨ ᠮᠡᠳᠡᠭᠡ ᠵᠠᠩᠭᠢ ᠶᠢ ᠰᠢᠩᠭᠡᠭᠡᠨ ᠣᠷᠣᠭᠤᠯᠬᠤ ᠳᠤ ᠡᠷᠬᠡ ᠣᠯᠭᠣᠬᠤ ᠴᠢᠬᠤᠯᠠ ᠲᠠᠢ </message>
		<message xml:lang="zh_HK">錄入您的使用者生物特徵資訊需要授權</message>
		<defaults>
			<allow_any>auth_self</allow_any>
			<allow_inactive>auth_self</allow_inactive>
			<allow_active>auth_self_keep</allow_active>
		</defaults>
	</action>

	<action id="org.ukui.biometric.enroll-admin-data">
		<description>Enroll other user's biometric features</description>
		<description xml:lang="zh">录入其他用户的生物信息</description>
		<message xml:lang="bo">ནང་འཇུག་གཞན་དག་སྤྱོད་མཁན་སྐྱེ་དངོས་ཆ་འཕྲིན། </message>
		<message xml:lang="mn">ᠪᠤᠰᠤᠳ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠲᠦ ᠰᠢᠩᠭᠡᠭᠡᠨ ᠣᠷᠣᠭᠤᠯᠤᠭᠰᠠᠨ ᠠᠮᠢᠳᠤ ᠪᠣᠳᠠᠰ ᠤᠨ ᠮᠡᠳᠡᠭᠡ ᠵᠠᠩᠭᠢ </message>
		<message xml:lang="zh_HK">錄入其他使用者的生物資訊 </message>
		<message>Enrolling other user's biometric features requires authorization</message>
		<message xml:lang="zh">录入其他用户的生物信息需要授权</message>
		<message xml:lang="bo">ནང་འཇུག་གཞན་དག་སྤྱོད་མཁན་སྐྱེ་དངོས་ཆ་འཕྲིན་དགོས་མཁོ་དབང་བསྐུར། </message>
		<message xml:lang="mn">ᠪᠤᠰᠤᠳ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠲᠦ ᠰᠢᠩᠭᠡᠭᠡᠨ ᠣᠷᠣᠭᠤᠯᠤᠭᠰᠠᠨ ᠠᠮᠢᠳᠤ ᠪᠣᠳᠠᠰ ᠤᠨ ᠮᠡᠳᠡᠭᠡ ᠵᠠᠩᠭᠢ ᠶᠢ ᠡᠷᠬᠡ ᠣᠯᠭᠣᠬᠤ ᠴᠢᠬᠤᠯᠠ ᠲᠠᠶ ᠪᠠᠶᠢᠨ᠎ᠠ </message>
		<message xml:lang="zh_HK">錄入其他使用者的生物資訊需要授權</message>
		<defaults>
			<allow_any>auth_admin</allow_any>
			<allow_inactive>auth_admin</allow_inactive>
			<allow_active>auth_admin_keep</allow_active>
		</defaults>
	</action>

	<action id="org.ukui.biometric.enroll-wechat-data">
		<description>Enroll user's wechat features</description>
		<description xml:lang="zh">绑定该用户扫码账户</description>
		<message xml:lang="bo">ནང་འཇུག་དེའི་སྤྱོད་མཁན་ཐོག་རྣམ། </message>
		<message xml:lang="mn">ᠲᠤᠰ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢ ᠶᠢᠨ ᠸᠢᠴᠠᠲ ᠲᠤ ᠰᠢᠩᠭᠡᠭᠡᠨ ᠣᠷᠣᠭᠤᠯᠤᠨ᠎ᠠ </message>
		<message xml:lang="zh_HK">綁定該使用者扫码账户 </message>
		<message>Enrolling user's wechat features requires authorization</message>
		<message xml:lang="zh">绑定该用户扫码账户需要授权</message>
		<message xml:lang="bo">ནང་འཇུག་དེའི་སྤྱོད་མཁན་ཐོག་རྣམ་པའི་དགོས་མཁོ་ལ་དབང་བསྐུར། </message>
		<message xml:lang="mn">ᠲᠤᠰ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠦᠨ ᠸᠢᠴᠠᠲ ᠲᠤ ᠰᠢᠩᠭᠡᠭᠡᠨ ᠣᠷᠣᠭᠤᠯᠬᠤ ᠳᠤ ᠡᠷᠬᠡ ᠣᠯᠭᠣᠬᠤ ᠴᠢᠬᠤᠯᠠ ᠲᠠᠢ  </message>
		<message xml:lang="zh_HK">綁定該使用者扫码账户需要授權</message>
		<defaults>
			<allow_any>auth_self</allow_any>
			<allow_inactive>auth_self</allow_inactive>
			<allow_active>auth_self_keep</allow_active>
		</defaults>
	</action>

	<action id="org.ukui.biometric.enroll-ukey-data">
		<description>Enroll user's ueky features</description>
		<description xml:lang="zh">需要授权以绑定安全秘钥</description>
		<message xml:lang="bo">ནང་འཇུག་དེའི་སྤྱོད་མཁན་ཐོག་རྣམ། </message>
		<message xml:lang="mn">ᠡᠷᠬᠡ ᠣᠯᠭᠣᠵᠤ ᠠᠮᠤᠷ ᠲᠦᠪᠰᠢᠨ ᠨᠢᠭᠤᠴᠠ ᠪᠠᠷ ᠪᠢᠲᠡᠭᠦᠮᠵᠢᠯᠡᠭᠳᠡᠬᠦ ᠴᠢᠬᠤᠯᠠ ᠲᠠᠢ </message>
		<message xml:lang="zh_HK">需要授權以綁定安全秘鑰</message>
		<message>Enrolling user's ukey features requires authorization</message>
		<message xml:lang="zh">需要授权以绑定安全秘钥</message>
		<message xml:lang="bo">ནང་འཇུག་དེའི་སྤྱོད་མཁན་ཐོག་རྣམ་པའི་དགོས་མཁོ་ལ་དབང་བསྐུར། </message>
		<message xml:lang="mn">ᠡᠷᠬᠡ ᠣᠯᠭᠣᠵᠤ ᠠᠮᠤᠷ ᠲᠦᠪᠰᠢᠨ ᠨᠢᠭᠤᠴᠠ ᠪᠠᠷ ᠪᠢᠲᠡᠭᠦᠮᠵᠢᠯᠡᠭᠳᠡᠬᠦ ᠴᠢᠬᠤᠯᠠ ᠲᠠᠢ </message>
		<message xml:lang="zh_HK">需要授權以綁定安全秘鑰</message>
		<defaults>
			<allow_any>auth_self</allow_any>
			<allow_inactive>auth_self</allow_inactive>
			<allow_active>auth_self_keep</allow_active>
		</defaults>
	</action>

	<action id="org.ukui.biometric.clean-own-data">
		<description>Delete your biometric features</description>
		<description xml:lang="zh">删除您的用户生物信息</description>
		<message xml:lang="bo">སུབ་པ་ཁྱེད་སྤྱོད་མཁན་སྐྱེ་དངོས་ཆ་འཕྲིན། </message>
		<message xml:lang="mn">ᠲᠠᠨ ᠤ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠦᠨ ᠠᠮᠢᠳᠤ ᠪᠣᠳᠠᠰ ᠤᠨ ᠰᠤᠷᠠᠭ ᠵᠠᠩᠭᠢ ᠶᠢ ᠬᠠᠰᠤᠨ᠎ᠠ </message>
		<message xml:lang="zh_HK">刪除您的使用者生物資訊</message>
		<message>Deleting your biometric features requires authorization</message>
		<message xml:lang="zh">删除您的用户生物信息需要授权</message>
		<message xml:lang="bo">སུབ་པ་ཁྱེད་སྤྱོད་མཁན་སྐྱེ་དངོས་ཆ་འཕྲིན་དགོས་མཁོ་དབང་བསྐུར། </message>
		<message xml:lang="mn">ᠲᠠᠨ ᠤ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠦᠨ ᠠᠮᠢᠳᠤ ᠪᠣᠳᠠᠰ ᠤᠨ ᠮᠡᠳᠡᠭᠡ ᠵᠠᠩᠭᠢ ᠶᠢ ᠬᠠᠰᠤᠬᠤ ᠳᠤ ᠡᠷᠬᠡ ᠣᠯᠭᠣᠬᠤ ᠴᠢᠬᠤᠯᠠ ᠲᠠᠢ </message>
		<message xml:lang="zh_HK">刪除您的使用者生物資訊需要授權</message>
		<defaults>
			<allow_any>auth_self</allow_any>
			<allow_inactive>auth_self</allow_inactive>
			<allow_active>auth_self_keep</allow_active>
		</defaults>
	</action>

	<action id="org.ukui.biometric.clean-admin-data">
		<description>Delete other user's biometric features</description>
		<description xml:lang="zh">删除其他用户生物信息</description>
		<description xml:lang="bo">སུབ་པ་གཞན་དག་སྤྱོད་མཁན་སྐྱེ་དངོས་ཆ་འཕྲིན། </description>
		<description xml:lang="mn">ᠪᠤᠰᠤᠳ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠦᠨ ᠠᠮᠢᠳᠤ ᠪᠣᠳᠠᠰ ᠤᠨ ᠮᠡᠳᠡᠭᠡ ᠵᠠᠩᠭᠢ ᠶᠢ ᠬᠠᠰᠤᠨ᠎ᠠ </description>
		<description xml:lang="zh_HK">刪除其他使用者生物資訊 </description>
                <message>Deleting other user's biometric features requires authorization</message>
                <message xml:lang="zh">删除其他用户的生物信息需要授权</message>
				<message xml:lang="bo">སུབ་པ་གཞན་དག་སྤྱོད་མཁན་སྐྱེ་དངོས་ཆ་འཕྲིན་དགོས་མཁོ་དབང་བསྐུར། </message>
				<message xml:lang="mn">ᠪᠤᠰᠤᠳ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠦᠨ ᠠᠮᠢᠳᠤ ᠪᠣᠳᠠᠰ ᠤᠨ ᠮᠡᠳᠡᠭᠡ ᠵᠠᠩᠭᠢ ᠶᠢ ᠬᠠᠰᠤᠬᠤ ᠳᠤ ᠡᠷᠬᠡ ᠣᠯᠭᠣᠬᠤ ᠴᠢᠬᠤᠯᠠ ᠲᠠᠶ ᠪᠠᠶᠢᠨ᠎ᠠ </message>
				<message xml:lang="zh_HK">刪除其他使用者的生物資訊需要授權</message>
		<defaults>
			<allow_any>auth_admin</allow_any>
			<allow_inactive>auth_admin</allow_inactive>
			<allow_active>auth_admin_keep</allow_active>
		</defaults>
        </action>

	<action id="org.ukui.biometric.clean-wechat-data">
		<description>Delete user's wechat features</description>
		<description xml:lang="zh">解绑该用户扫码登录账户</description>
		<description xml:lang="bo">བཅིངས་པ་དགྲོལ་བ་དེའི་སྤྱོད་མཁན་ཐོག་རྣམ། </description>
		<description xml:lang="mn">ᠲᠤᠰ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠦᠨ ᠸᠢᠴᠠᠲ ᠢ ᠲᠠᠶᠢᠯᠪᠤᠷᠢᠯᠠᠨ᠎ᠠ </description>
		<description xml:lang="zh_HK">解綁該使用者扫码登录账户</description>
                <message>Delete user's wechat features requires authorization</message>
                <message xml:lang="zh">解绑该用户扫码账户需要授权</message>
				<message xml:lang="bo">བཅིངས་པ་དགྲོལ་བ་དེའི་སྤྱོད་མཁན་ཐོག་རྣམ་པའི་དགོས་མཁོ་ལ་དབང་བསྐུར། </message>
				<message xml:lang="mn">ᠲᠤᠰ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠦᠨ ᠸᠢᠴᠠᠲ ᠢ ᠤᠶᠠᠬᠤ ᠳᠤ ᠡᠷᠬᠡ ᠣᠯᠭᠣᠬᠤ ᠴᠢᠬᠤᠯᠠ ᠲᠠᠢ </message>
				<message xml:lang="zh_HK">解綁該使用者扫码账户需要授權</message>
		<defaults>
			<allow_any>auth_self</allow_any>
			<allow_inactive>auth_self</allow_inactive>
			<allow_active>auth_self_keep</allow_active>
		</defaults>
        </action>

			<action id="org.ukui.biometric.clean-ukey-data">
		<description>Delete user's ukey features</description>
		<description xml:lang="zh">解绑该用户安全密钥</description>
		<description xml:lang="bo">བཅིངས་པ་དགྲོལ་བ་དེའི་སྤྱོད་མཁན་ཐོག་རྣམ། </description>
		<description xml:lang="mn">ᠲᠤᠰ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠦᠨ ᠠᠮᠤᠷ ᠲᠦᠪᠰᠢᠨ ᠪᠢᠲᠡᠭᠦᠮᠵᠢᠯᠡᠯ ᠢ ᠲᠠᠶᠢᠯᠪᠤᠷᠢᠯᠠᠨ᠎ᠠ </description>
		<description xml:lang="zh_HK">解綁該使用者安全金鑰 </description>
                <message>Delete user's ukey features requires authorization</message>
                <message xml:lang="zh">解绑该用户安全密钥需要授权</message>
				<message xml:lang="bo">བཅིངས་པ་དགྲོལ་བ་དེའི་སྤྱོད་མཁན་ཐོག་རྣམ་པའི་དགོས་མཁོ་ལ་དབང་བསྐུར། </message>
				<message xml:lang="mn">ᠲᠤᠰ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠦᠨ ᠠᠮᠤᠷ ᠲᠦᠪᠰᠢᠨ ᠦ ᠪᠢᠲᠡᠭᠦᠮᠵᠢ ᠶᠢ ᠲᠠᠶᠢᠯᠬᠤ ᠳᠤ ᠡᠷᠬᠡ ᠣᠯᠭᠣᠬᠤ ᠴᠢᠬᠤᠯᠠᠲᠠᠶ </message>
				<message xml:lang="zh_HK">解綁該使用者安全金鑰需要授權 </message>
		<defaults>
			<allow_any>auth_self</allow_any>
			<allow_inactive>auth_self</allow_inactive>
			<allow_active>auth_self_keep</allow_active>
		</defaults>
        </action>

        <action id="org.ukui.biometric.modify-own-data">
                <description>Modify your biometric features</description>
                <description xml:lang="zh">修改您的用户生物信息</description>
				<description xml:lang="bo">བཟོ་བཅོས་ཁྱེད་སྤྱོད་མཁན་སྐྱེ་དངོས་ཆ་འཕྲིན། </description>
				<description xml:lang="mn">ᠲᠠᠨ ᠤ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠦᠨ ᠠᠮᠢᠳᠤ ᠪᠣᠳᠠᠰ ᠤᠨ ᠰᠤᠷᠠᠭ ᠵᠠᠩᠭᠢ ᠳᠤ ᠵᠠᠰᠠᠪᠤᠷᠢ ᠣᠷᠣᠭᠤᠯᠤᠨ᠎ᠠ </description>
				<description xml:lang="zh_HK">修改您的使用者生物資訊</description>
                <message>Modifing your biometric features requires authorization</message>
                <message xml:lang="zh">修改您的用户的生物信息需要授权</message>
				<message xml:lang="bo">བཟོ་བཅོས་ཁྱེད་སྤྱོད་མཁན་སྐྱེ་དངོས་ཆ་འཕྲིན་དགོས་མཁོ་དབང་བསྐུར། </message>
				<message xml:lang="mn">ᠲᠠᠨ ᠤ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠦᠨ ᠠᠮᠢᠳᠤ ᠪᠣᠳᠠᠰ ᠤᠨ ᠮᠡᠳᠡᠭᠡ ᠵᠠᠩᠭᠢ ᠳᠤ ᠡᠷᠬᠡ ᠣᠯᠭᠣᠬᠤ ᠴᠢᠬᠤᠯᠠ ᠲᠠᠢ </message>
				<message xml:lang="zh_HK">修改您的使用者的生物資訊需要授權 </message>
                <defaults>
                        <allow_any>auth_self</allow_any>
                        <allow_inactive>auth_self</allow_inactive>
                        <allow_active>auth_self_keep</allow_active>
                </defaults>
        </action>

        <action id="org.ukui.biometric.modify-admin-data">
                <description>Modify other user's biometric features</description>
                <description xml:lang="zh">修改其他用户生物信息</description>
				<description xml:lang="bo">བཟོ་བཅོས་ཁྱེད་སྤྱོད་མཁན་སྐྱེ་དངོས་ཆ་འཕྲིན་དགོས་མཁོ་དབང་བསྐུར། </description>
				<description xml:lang="mn">ᠪᠤᠰᠤᠳ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠦᠨ ᠠᠮᠢᠳᠤ ᠪᠣᠳᠠᠰ ᠤᠨ ᠮᠡᠳᠡᠭᠡ ᠵᠠᠩᠭᠢ ᠳᠤ ᠵᠠᠰᠠᠪᠤᠷᠢ ᠣᠷᠣᠭᠤᠯᠤᠨ᠎ᠠ </description>
				<description xml:lang="zh_HK">修改其他使用者生物資訊 </description>
                <message>Modifing other user's biometric features requires authorization</message>
                <message xml:lang="zh">修改其他用户的生物信息需要授权</message>
				<message xml:lang="bo">བཟོ་བཅོས་གཞན་དག་སྤྱོད་མཁན་སྐྱེ་དངོས་ཆ་འཕྲིན་དགོས་མཁོ་དབང་བསྐུར། </message>
				<message xml:lang="mn">ᠪᠤᠰᠤᠳ ᠬᠡᠷᠡᠭᠯᠡᠭᠴᠢᠳ ᠦᠨ ᠠᠮᠢᠳᠤ ᠪᠣᠳᠠᠰ ᠤᠨ ᠮᠡᠳᠡᠭᠡ ᠵᠠᠩᠭᠢ ᠳᠤ ᠵᠠᠰᠠᠪᠤᠷᠢ ᠣᠷᠣᠭᠤᠯᠬᠤ ᠳᠤ ᠡᠷᠬᠡ ᠣᠯᠭᠣᠬᠤ ᠴᠢᠬᠤᠯᠠ ᠲᠠᠶ ᠪᠠᠶᠢᠨ᠎ᠠ</message>
				<message xml:lang="zh_HK">修改其他使用者的生物資訊需要授權</message>
                <defaults>
                        <allow_any>auth_admin</allow_any>
                        <allow_inactive>auth_admin</allow_inactive>
                        <allow_active>auth_admin_keep</allow_active>
                </defaults>
        </action>

</policyconfig>
