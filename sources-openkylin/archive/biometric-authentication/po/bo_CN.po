#: ../src/utils/biometric-auth-client/biometric-auth-client.in:76
msgid ""
"Usage:\n"
"  biometric-auth-client BuiltinCommands ...\n"
"\n"
"BuiltinCommands:\n"
"  get-driver-list       Get Driver List\n"
"  get-device-list       Get Device List\n"
"  get-feature-list      Get Feature List\n"
"  enroll                Enroll Feature\n"
"  verify                Verify Feature\n"
"  capture               Capture Feature\n"
"  search                Search Feature\n"
"  clean                 Clean Feature\n"
"  rename                Rename Feature\n"
"\n"
"Options:\n"
"  -h, --help            show this help message and exit\n"
msgstr ""
"སྤྱོད་སྟངས།\n"
"  biometric-auth-client ནང་འཛུགས་བཀའ་བརྡ།\n"
"\n"
"ནང་འཛུགས་བཀའ་བརྡ།\n"
"  get-driver-list       སྐུལ་བྱེད་རེའུ་མིག་ལེན་པ།\n"
"  get-device-list       སྒྲིག་ཆས་རེའུ་མིག་ལེན་པ།\n"
"  get-feature-list      ཁྱད་རྟགས་རེའུ་མིག་ལེན་པ།\n"
"  enroll                ཁྱད་རྟགས་ཕབ་འཇུག\n"
"  verify                ཁྱད་རྟགས་ར་སྤྲོད།\n"
"  capture               ཁྱད་རྟགས་འཛིན་པ།\n"
"  search                ཁྱད་རྟགས་བཙལ་བ།\n"
"  clean                 ཁྱད་རྟགས་གཙང་སེལ།\n"
"  rename                ཁྱད་རྟགས་མིང་བསྐྱར་འདོགས།\n"
"\n"
"གདམ་ཚན།\n"
"  -h, --help            རོགས་རམ་གྱི་གདམ་ཚན་ཤར་ནས་ཕྱིར་འབུད་པ།\n"

