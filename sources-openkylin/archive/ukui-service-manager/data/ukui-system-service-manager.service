[Unit]
Description=UKUI System Service Manager
Wants=dbus.socket
After=dbus.socket
After=graphical.target

[Service]
Type=dbus
BusName=org.ukui.serviceManager
ExecStart=/usr/bin/ukui-system-service-manager
Restart=on-failure
RestartSec=5s

[Install]
#WantedBy=multi-user.target
WantedBy=graphical.target
