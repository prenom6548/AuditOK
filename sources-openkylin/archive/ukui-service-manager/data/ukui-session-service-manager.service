[Unit]
Description=UKUI Session Service Manager
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Environment=QT_QPA_PLATFORMTHEME=ukui XDG_CURRENT_DESKTOP=UKUI
Type=dbus
BusName=org.ukui.serviceManager
ExecStart=/usr/bin/ukui-session-service-manager
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
