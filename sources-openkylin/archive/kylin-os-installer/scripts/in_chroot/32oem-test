#!/bin/bash

set -e

if [[ "${is_minimal}" = "true" ]]; then
    return 0
elif [[ "${is_ghost}" = "true" ]]; then
    return 0
fi

if grep -q "QC=" /proc/cmdline; then
    if grep -q "url=" /proc/cmdline; then
            cmd_cfg=$(cat /proc/cmdline)
            url_ip=$(echo ${cmd_cfg##*url=}| awk '{print $1}')
            url_ip=${url_ip%/*}
            QC=$(echo ${cmd_cfg##*QC=}| awk '{print $1}')
            wget -P/tmp ${url_ip}/${QC}
            tar -xf /tmp/${QC} -C /tmp/
            /usr/bin/rsync -a /tmp/QC/ /usr/share/oem-test/
	    return 0
    fi
fi

if [[ -d /cdrom/QC ]]; then
    /usr/bin/rsync -a /cdrom/QC/ /usr/share/oem-test/
fi
