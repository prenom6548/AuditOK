#!/bin/bash

set -e

if [[ "${is_minimal}" = "true" ]]; then
    return 0
elif [[ "${is_ghost}" = "true" ]]; then
    return 0
fi

LANGUAGE=$(get_value language)
echo "zh_CN.UTF-8 UTF-8
en_US.UTF-8 UTF-8
zh_HK.UTF-8 UTF-8
mn_MN.UTF-8 UTF-8
bo_CN.UTF-8 UTF-8
kk_KZ.UTF-8 UTF-8
ug_CN.UTF-8 UTF-8
ky_KG.UTF-8 UTF-8
de_DE.UTF-8 UTF-8
es_ES.UTF-8 UTF-8
fr_FR.UTF-8 UTF-8
ko_KP.UTF-8 UTF-8
khb_CN.UTF-8 UTF-8
vi_VN.UTF-8 UTF-8
ms_MY.UTF-8 UTF-8
th_TH.UTF-8 UTF-8
ar_AE.UTF-8 UTF-8
ru_RU.UTF-8 UTF-8
tr_TR.UTF-8 UTF-8
it_IT.UTF-8 UTF-8
ja_JP.UTF-8 UTF-8
my_MM.UTF-8 UTF-8
pt_PT.UTF-8 UTF-8
id_ID.UTF-8 UTF-8
lo_LA.UTF-8 UTF-8
ur_PK.UTF-8 UTF-8" >> /etc/locale.gen

msg "设置语言为 ${LANGUAGE}"
echo "LANG=${LANGUAGE}.UTF-8" >/etc/default/locale
if [[ "${LANGUAGE}" = "zh_CN" ]]; then
    echo "LANGUAGE=\"zh_CN:zh\"" >> /etc/default/locale
elif [[ "${LANGUAGE}" = "en_US" ]]; then
    echo "LANGUAGE=\"en\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "bo_CN" ]]; then
    echo "LANGUAGE=\"bo_CN:zh_CN:zh\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "zh_HK" ]]; then
    echo "LANGUAGE=\"zh_HK:zh_CN:zh\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "mn_MN" ]]; then
    echo "LANGUAGE=\"mn_MN\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "kk_KZ" ]]; then
    echo "LANGUAGE=\"kk_KZ\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "ug_CN" ]]; then
    echo "LANGUAGE=\"ug_CN\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "ky_KG" ]]; then
    echo "LANGUAGE=\"ky_KG\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "de_DE" ]]; then
    echo "LANGUAGE=\"de_DE\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "es_ES" ]]; then
    echo "LANGUAGE=\"es_ES\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "fr_FR" ]]; then
    echo "LANGUAGE=\"fr_FR\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "ko_KP" ]]; then
    echo "LANGUAGE=\"ko_KP\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "khb_CN" ]]; then
    echo "LANGUAGE=\"khb_CN\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "vi_VN" ]]; then
    echo "LANGUAGE=\"vi_VN\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "ms_MY" ]]; then
    echo "LANGUAGE=\"ms_MY\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "th_TH" ]]; then
    echo "LANGUAGE=\"th_TH\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "ar_AE" ]]; then
    echo "LANGUAGE=\"ar_AE\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "ru_RU" ]]; then
    echo "LANGUAGE=\"ru_RU\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "tr_TR" ]]; then
    echo "LANGUAGE=\"tr_TR\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "it_IT" ]]; then
    echo "LANGUAGE=\"it_IT\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "ja_JP" ]]; then
    echo "LANGUAGE=\"ja_JP\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "my_MM" ]]; then
    echo "LANGUAGE=\"my_MM\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "pt_PT" ]]; then
    echo "LANGUAGE=\"pt_PT\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "id_ID" ]]; then
    echo "LANGUAGE=\"id_ID\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "lo_LA" ]]; then
    echo "LANGUAGE=\"lo_LA\"" >>/etc/default/locale
elif [[ "${LANGUAGE}" = "ur_PK" ]]; then
    echo "LANGUAGE=\"ur_PK\"" >>/etc/default/locale
fi

locale-gen
update-locale
