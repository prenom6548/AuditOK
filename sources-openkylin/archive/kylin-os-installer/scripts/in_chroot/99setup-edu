#!/bin/bash

set -e

if [[ "${is_minimal}" == "true" ]]; then
  return 0
elif [[ "${is_ghost}" == "true" ]]; then
  return 0
fi

set_iso=$(get_value edition)
if [[ -z "${set_iso}" ]]; then
	return 0
fi

if [[ "${set_iso}" = "default" ]]; then
	set_iso=professional
fi

if grep -q "edition=" /proc/cmdline; then
	cmd_edition=$(cat /proc/cmdline)
        set_iso=$(echo ${cmd_edition##*edition=}| awk '{print $1}')
fi


if [[ -f "/cdrom/Editions/${set_iso}/edition.conf" ]]; then
	do_set=$(grep "^script=" "/cdrom/Editions/${set_iso}/edition.conf")
	do_set="${do_set#*=}"
	. ${do_set} || echo "${do_set} is failed"
fi


