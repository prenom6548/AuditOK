#!/bin/bash

set -e

# 从配置文件 /tmp/ky-installer.cfg 中读取 factory-backup 的值
factory_backup=$(get_value factory-backup)

# 出从备份创建标志位文件，以触发GRUB生成恢复菜单项
if grep -q 'factory-backup' /proc/cmdline; then
	mkdir -p /ostree/pkgs/
	touch /ostree/pkgs/FACTORY_RECOVERY_GRUB_ENTRY_ENABLED
else
	if [[ "$factory_backup" -ne 1 ]]; then
  		mkdir -p /ostree/pkgs/
  		touch /ostree/pkgs/FACTORY_RECOVERY_GRUB_ENTRY_ENABLED
	fi
fi
