#!/bin/bash

set -e

new_sysroot_path=$(get_value new-root)

if [[ "${is_minimal}" == "true" ]]; then
  return 0
elif [[ "${is_ghost}" == "true" ]]; then
  return 0
fi

[ -d /cdrom/pool ] || \
  return 0

#sed -i "s/^/#/g" /etc/apt/sources.list

#TODO, 优化获取方式
CODENAME=$(ls -l /cdrom/dists | awk '/^d/{print $NF}')

mv $new_sysroot_path/etc/apt/sources.list{,.bak}
echo "deb file:/cdrom ${CODENAME} main" >>$new_sysroot_path/etc/apt/sources.list

# todo, set timeout
chroot $new_sysroot_path apt-get update --allow-insecure-repositories -y
