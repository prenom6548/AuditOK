#!/bin/bash

set -e

if [[ "${is_oem_mode}" = "false" ]]; then
    return 0
fi

files=$(dpkg -L kylin-os-installer) || true

new_sysroot_dir=$(get_value new-root)


for file in ${files}
do
	if [[ -f $file ]]; then
		echo $file
		file_dir=
		file_dir=${file%/*}
		cp -a $file ${new_sysroot_dir}/${file_dir}/ || true
		continue
	fi
	if [[ -d $file ]]; then
		echo $file
		mkdir -p ${new_sysroot_dir}/$file || true
		continue
	fi
done




