#!/bin/bash

set -e

case ${LANGUAGES} in
        'zh_CN')
                echo "磁盘分区完成" >>${LOG_PROGRESS_FILE}
                ;;
        'en_US')
                echo "Disk partition completed" >>${LOG_PROGRESS_FILE}
                ;;
        'bo_CN')
                echo "འཁོར་གཞོང་འཛུགས་སྐྲུན་ཁག་ལེགས་གྲུབ།" >>${LOG_PROGRESS_FILE}
                ;;
        'zh_HK')
                echo "磁碟分割完成" >>${LOG_PROGRESS_FILE}
                ;;
        'mn_MN')
                echo "ᠰᠣᠷᠢᠨᠵᠢᠨ ᠳ᠋ᠢᠰᠺ ᠢ ᠬᠡᠰᠡᠭ ᠬᠤᠪᠢᠶᠠᠵᠤ ᠳᠠᠭᠤᠰᠪᠠ" >>${LOG_PROGRESS_FILE}
                ;;
              *)
                echo "磁盘分区完成" >>${LOG_PROGRESS_FILE}
                ;;
esac

case ${LANGUAGES} in
        'zh_CN')
                echo "磁盘格式化中..." >>${LOG_PROGRESS_FILE}
                ;;
        'en_US')
                echo "Disk formatting in progress..." >>${LOG_PROGRESS_FILE}
                ;;
        'bo_CN')
                echo "འཁོར་གཞོང་格式化ཁྲོད།..." >>${LOG_PROGRESS_FILE}
                ;;
        'zh_HK')
                echo "磁片格式化中..." >>${LOG_PROGRESS_FILE}
                ;;
        'mn_MN')
                echo "ᠳ᠋ᠢᠰᠺ ᠢ ᠬᠡᠯᠪᠡᠷᠢᠵᠢᠭᠦᠯᠵᠦ ᠪᠠᠶᠢᠨᠠ..." >>${LOG_PROGRESS_FILE}
                ;;
              *)
                echo "磁盘格式化中..." >>${LOG_PROGRESS_FILE}
                ;;
esac


