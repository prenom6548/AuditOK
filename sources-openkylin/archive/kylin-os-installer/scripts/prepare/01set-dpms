#!/bin/bash

set -e

# Inhibit display screensaver.

if [[ ! -z "$DISPLAY" ]]; then
  # 防止屏幕熄灭
  xset s off -dpms
fi

sync
sleep 1
umount  /var/lib/os-prober/mount || true

case ${LANGUAGES} in
        'zh_CN')
                echo "磁盘分区中..." >>${LOG_PROGRESS_FILE}
                ;;
        'en_US')
                echo "Perform disk partitioning..." >>${LOG_PROGRESS_FILE}
                ;;
        'bo_CN')
                echo "འཁོར་གཞོང་ཁུལ་ནང།..." >>${LOG_PROGRESS_FILE}
                ;;
        'zh_HK')
                echo "磁碟分割中..." >>${LOG_PROGRESS_FILE}
                ;;
        'mn_MN')
                echo "ᠰᠣᠷᠢᠨᠵᠢᠨ ᠳ᠋ᠢᠰᠺ ᠢ ᠬᠡᠰᠡᠭ ᠬᠤᠪᠢᠶᠠᠬᠤ..." >>${LOG_PROGRESS_FILE}
                ;;
              *)
                echo "磁盘分区中..." >>${LOG_PROGRESS_FILE}
                ;;
esac


