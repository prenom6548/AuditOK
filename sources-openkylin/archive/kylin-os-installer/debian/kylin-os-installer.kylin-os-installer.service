[Unit]
Description=Kylin live CD installer
Before=plymouth-quit.service plymouth-quit-wait.service lightdm.service
ConditionKernelCommandLine=boot=casper

[Service]
Type=oneshot
Restart=on-failure
RestartSec=0
ExecStart=/usr/share/kylin-os-installer/data/start-kylin-os-installer

[Install]
WantedBy=graphical.target
