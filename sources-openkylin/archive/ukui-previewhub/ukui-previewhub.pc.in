prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: ukui-previewhub
Description: Embeddable Qt5 file preview widget library
Version: @PROJECT_VERSION@
Requires: Qt5Widgets
Libs: -L${libdir} -lukui-previewhub
Cflags: -I${includedir}/ukui-previewhub
