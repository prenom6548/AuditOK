diff --git a/core/third_party/qpdflib/pdfview/qpdf.css b/core/third_party/qpdflib/pdfview/qpdf.css
index f76427a..6ff9e45 100644
--- a/core/third_party/qpdflib/pdfview/qpdf.css
+++ b/core/third_party/qpdflib/pdfview/qpdf.css
@@ -10,3 +10,166 @@
 #viewerContainer {
     overflow: auto !important;
 }
+
+/* ==========================================================================
+   Preview layout: document on the left, thumbnail strip on the right.
+
+   The `dir` attribute is written at runtime by the l10n layer, so every rule
+   that upstream splits into html[dir='ltr'] / html[dir='rtl'] has to be
+   neutralised here for BOTH directions -- otherwise the strip jumps sides
+   depending on the UI language.
+   ========================================================================== */
+
+:root {
+    /* 98px thumbnail (upstream THUMBNAIL_WIDTH) + margins. */
+    --sidebar-width: 132px;
+}
+
+/* No pdf.js toolbar in the preview pane. */
+#topLevelToolbar {
+    display: none !important;
+}
+
+#viewerContainer {
+    top: 0 !important;
+}
+
+/* --- Anchor the sidebar to the right edge, in both text directions --------- */
+
+#sidebarContainer,
+.loadingInProgress #sidebarContainer,
+html[dir='ltr'] #sidebarContainer,
+html[dir='rtl'] #sidebarContainer {
+    top: 0;
+    left: auto;
+    right: calc(-1 * var(--sidebar-width));
+    width: var(--sidebar-width);
+    min-width: var(--sidebar-width);
+    max-width: var(--sidebar-width);
+    border-top: none;
+    transition-property: right;
+}
+
+html[dir='ltr'] #outerContainer.sidebarOpen #sidebarContainer,
+html[dir='rtl'] #outerContainer.sidebarOpen #sidebarContainer {
+    left: auto;
+    right: 0;
+}
+
+/* Document keeps the left edge and yields width on the right instead. */
+html[dir='ltr'] #outerContainer.sidebarOpen #viewerContainer,
+html[dir='rtl'] #outerContainer.sidebarOpen #viewerContainer {
+    left: 0;
+    right: var(--sidebar-width);
+    transition-property: right;
+}
+
+#outerContainer.sidebarOpen #mainContainer {
+    min-width: 0;
+}
+
+/* The Thumbnails/Outline/Attachments switcher stays in the DOM (PDFSidebar
+   binds listeners to those buttons) but is never shown. */
+#toolbarSidebar {
+    display: none !important;
+}
+
+#sidebarContent,
+html[dir='ltr'] #sidebarContent,
+html[dir='rtl'] #sidebarContent {
+    top: 0;
+    left: 0;
+    right: 0;
+    width: 100%;
+    background-color: #f5f5f5;
+    box-shadow: none;
+    border-left: 1px solid rgba(0, 0, 0, 0.12);
+}
+
+/* --- Single centred column of thumbnails ---------------------------------- */
+
+#thumbnailView {
+    width: 100%;
+    padding: 8px 0;
+    box-sizing: border-box;
+    overflow-x: hidden;
+}
+
+#thumbnailView .thumbnail,
+html[dir='ltr'] #thumbnailView .thumbnail,
+html[dir='rtl'] #thumbnailView .thumbnail {
+    float: none;
+    margin: 0 auto 8px auto;
+}
+
+#thumbnailView > a:last-of-type > .thumbnail {
+    margin-bottom: 8px;
+}
+
+.thumbnailSelectionRing {
+    padding: 4px;
+}
+
+/* Upstream selection/hover styling is white-on-dark and would be invisible on
+   the light strip. Restate it for a light background. */
+.thumbnailImage {
+    opacity: 1;
+    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.18);
+}
+
+a:focus > .thumbnail > .thumbnailSelectionRing,
+.thumbnail:hover > .thumbnailSelectionRing {
+    background-color: rgba(0, 0, 0, 0.06);
+    background-image: none;
+    box-shadow: none;
+}
+
+.thumbnail.selected > .thumbnailSelectionRing {
+    background-color: rgba(55, 144, 250, 0.16);
+    background-image: none;
+    box-shadow: none;
+}
+
+.thumbnail.selected > .thumbnailSelectionRing > .thumbnailImage {
+    opacity: 1;
+    box-shadow: 0 0 0 2px #3790fa;
+}
+
+.thumbnail:not([data-loaded]) {
+    border: 1px dashed rgba(0, 0, 0, 0.25);
+}
+
+/* --- Floating thumbnail toggle -------------------------------------------- */
+
+#sidebarToggle {
+    position: absolute;
+    top: 12px;
+    right: 12px;
+    z-index: 101;
+    width: 32px;
+    height: 32px;
+    padding: 0;
+    border: none;
+    border-radius: 6px;
+    cursor: pointer;
+    background-color: rgba(0, 0, 0, 0.45);
+    background-image: url(images/toolbarButton-sidebarToggle.png);
+    background-repeat: no-repeat;
+    background-position: center;
+    opacity: 1;
+    transition: right 200ms ease, background-color 150ms ease;
+}
+
+/* Keep the icon's white glyph legible on the translucent chip. */
+#sidebarToggle > span {
+    display: none;
+}
+
+#sidebarToggle:hover {
+    background-color: rgba(0, 0, 0, 0.65);
+}
+
+/* Ride along with the strip so it is never covered by it. */
+#outerContainer.sidebarOpen #sidebarToggle {
+    right: calc(var(--sidebar-width) + 12px);
+}
