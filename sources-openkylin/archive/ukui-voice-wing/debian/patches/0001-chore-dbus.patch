     QDBusConnectionInterface *busIface = bus.interface();
     if (!busIface) {
-        VW_LOG(Logger::Level::Error) << "kylin_aiassistant" << methodName
+        VW_LOG(Logger::Level::Error) << service << methodName
                                      << "failed: session bus interface unavailable";
