<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="ukui-voice-wing">
  <schema id="org.ukui.voice-wing" path="/org/ukui/voice-wing/">
    <key name="enabled" type="b">
      <default>true</default>
      <summary>Whether voice input is enabled</summary>
      <description>Enable or disable the voice input service.</description>
