#!/bin/sh
set -e

#DEBHELPER#

if [ ! -f "/etc/biometric-auth/" ]
then
	mkdir -p /etc/biometric-auth/
	touch /etc/biometric-auth/biometric-drivers.conf
fi

case "${1}" in
	configure)
		biometric-config-tool add-driver -f bio_drv_fidoukey /usr/lib/biometric-authentication/drivers/bio_drv_fidoukey.so
		;;

	abort-upgrade|abort-remove|abort-deconfigure)
		;;

	*)
		echo "postinst called with unknown argument \`${1}'" >&2
		exit 1
		;;
esac

exit 0
