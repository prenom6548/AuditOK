[Unit]
Description=Language package status check and notification
Documentation=man:ukui-i18n-management(8)
# 开机场景：等待 network-online.target 后执行一次
# 手动连网场景：由 NetworkManager dispatcher 再次触发（非常驻监听）
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/ukui-i18n-management/packages.conf

[Service]
Type=oneshot
ExecStart=/usr/lib/ukui-i18n-management/check-packages.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
