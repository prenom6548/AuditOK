#!/bin/sh
set -e

case "$1" in
    configure)
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper unmask ukui-i18n-management.service >/dev/null || true
            deb-systemd-helper update-state ukui-i18n-management.service >/dev/null || true
            deb-systemd-helper enable ukui-i18n-management.service >/dev/null || true
            if [ -d /run/systemd/system ]; then
                deb-systemd-invoke start ukui-i18n-management.service >/dev/null || true
            fi
        elif command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
            systemctl enable ukui-i18n-management.service >/dev/null || true
            if [ -d /run/systemd/system ]; then
                systemctl start ukui-i18n-management.service >/dev/null || true
            fi
        fi
        ;;
esac

#DEBHELPER#

exit 0
