#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_install:
	dh_auto_install
	install -d debian/ukui-i18n-management/etc/ukui-i18n-management
	install -m 644 etc/ukui-i18n-management/packages.conf debian/ukui-i18n-management/etc/ukui-i18n-management/
	install -d debian/ukui-i18n-management/usr/lib/ukui-i18n-management
	install -m 755 usr/lib/ukui-i18n-management/check-packages.sh debian/ukui-i18n-management/usr/lib/ukui-i18n-management/
	install -m 755 usr/lib/ukui-i18n-management/send-notification.py debian/ukui-i18n-management/usr/lib/ukui-i18n-management/
	install -d debian/ukui-i18n-management/lib/systemd/system
	install -m 644 lib/systemd/system/ukui-i18n-management.service debian/ukui-i18n-management/lib/systemd/system/
	install -d debian/ukui-i18n-management/etc/NetworkManager/dispatcher.d
	install -m 755 etc/NetworkManager/dispatcher.d/99-ukui-i18n-management debian/ukui-i18n-management/etc/NetworkManager/dispatcher.d/
