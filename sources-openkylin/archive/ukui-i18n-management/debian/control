Maintainer: Maintainer <maintainer@example.com>
Build-Depends: debhelper-compat (= 13)
Standards-Version: 4.6.2
Rules-Requires-Root: no

Package: ukui-i18n-management
Architecture: all
Depends: ${misc:Depends},
         systemd,
         python3-dbus,
         python3-gi,
         iputils-ping | inetutils-ping
Recommends: network-manager
Description: UKUI language configuration package checker
 This package maintains a list of language-related deb packages and
 automatically checks their installation status after network becomes
 available. If any package is missing, a desktop notification is shown.
 Clicking the notification opens ukui-control-center for installation.
