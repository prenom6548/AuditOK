#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper disable ukui-i18n-management.service >/dev/null || true
            deb-systemd-helper mask ukui-i18n-management.service >/dev/null || true
        elif command -v systemctl >/dev/null 2>&1; then
            systemctl stop ukui-i18n-management.service >/dev/null || true
            systemctl disable ukui-i18n-management.service >/dev/null || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
