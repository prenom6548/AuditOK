From: openKylin Developers <packaging@lists.openkylin.top>
Date: Mon, 1 Jun 2026 16:36:01 +0800
Subject: ignore-autoinstall-errors

---
 dkms_autoinstaller.in   | 5 +++++
 dkms_common.postinst.in | 7 ++++++-
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/dkms_autoinstaller.in b/dkms_autoinstaller.in
index 2fbc4f5..3228dc1 100644
--- a/dkms_autoinstaller.in
+++ b/dkms_autoinstaller.in
@@ -34,6 +34,11 @@ case "$1" in
 		else
 			dkms autoinstall --kernelver "$kernel"
 			res=$?
+			if [ "$res" != "0" ] && { [ -f /etc/dkms/no-autoinstall-errors ] || \
+			   [ "$RELEASE_UPGRADE_IN_PROGRESS" = "1" ]; }; then
+				echo "Ignore autoinstall errors for dkms modules."
+				res=0
+			fi
 			test $res = 0
 		fi
 		;;
diff --git a/dkms_common.postinst.in b/dkms_common.postinst.in
index 10dd392..f1da9e8 100644
--- a/dkms_common.postinst.in
+++ b/dkms_common.postinst.in
@@ -252,7 +252,12 @@ for KERNEL in $KERNELS; do
             0)
                 ;;
             *)
-                exit $res
+                if [ -f /etc/dkms/no-autoinstall-errors ] || \
+                   [ "$RELEASE_UPGRADE_IN_PROGRESS" = "1" ]; then
+                    continue
+                else
+                    exit $res
+                fi
                 ;;
             esac
             dkms_status=$(dkms status -m "$NAME" -v "$VERSION" -k "$KERNEL" ${ARCH:+-a "$ARCH"})
