#library
usr/lib/*/libkyconf2.so*

# system bus
src/conf2/service/conf2Utils.py /usr/share/kysdk/kysdk-base
src/conf2/service/conf2-system.py /usr/share/kysdk/kysdk-base
src/conf2/service/kysdk-conf2.conf etc/dbus-1/system.d
src/conf2/service/kysdk-conf2.service usr/lib/systemd/system
src/conf2/configs/conf2.yaml etc/kylin-config/

# session bus
src/conf2/service/conf2-session.py /usr/share/kysdk/kysdk-base
src/conf2/service/kysdk-conf2.desktop /etc/xdg/autostart

# conf2 compile
bin/conf2-compile usr/bin
src/conf2/configs/conf2-compile.service usr/lib/systemd/system

# dbus control
src/conf2/configs/com.kylin.kysdk.conf2.yaml etc/kylin-config/basic

# sync system bus
bin/conf2-sync-system usr/bin
src/conf2/sync-config/com.kylin.kysdk.SyncConfig.conf etc/dbus-1/system.d
src/conf2/sync-config/com.kylin.kysdk.SyncConfig.service usr/lib/systemd/system

# sync session bus
bin/conf2-sync-session usr/bin
src/conf2/sync-config/com.kylin.kysdk.SyncConfig.desktop /etc/xdg/autostart
