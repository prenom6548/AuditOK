#!/bin/bash

set -e
input_file="/ostree/pkgs/system-ovl.conf"

etc_path_ln="/etc"
usr_share_ln="/usr/share"
bin_ln_V11="/opt/system/bin"
bin_ln_not_V11="/usr/bin"

etc_path="/opt/system/conf"
usr_share="/opt/system/resource"
bin_path="/opt/kaiming-tools/bin"

is_V11=0

if [ -e "$input_file" ]; then
    is_V11=1
fi

if [ $is_V11 -eq 0 ]; then

    if [ -L "${etc_path_ln}/bash_completion.d/kaiming-builder_completion.sh" ]; then
        rm "${etc_path_ln}/bash_completion.d/kaiming-builder_completion.sh" 
    fi

    if [ -L "${usr_share_ln}/locale/zh_CN/LC_MESSAGES/kaiming-builder.mo" ]; then
        rm "${usr_share_ln}/locale/zh_CN/LC_MESSAGES/kaiming-builder.mo"
    fi

    if [ -L "${usr_share_ln}/polkit-1/actions/cn.kylin.kaiming-builder.policy" ]; then
        rm "${usr_share_ln}/polkit-1/actions/cn.kylin.kaiming-builder.policy"
    fi

    if [ -L "${bin_ln_not_V11}/kaiming-builder" ]; then
        rm "${bin_ln_not_V11}/kaiming-builder"
    fi

    if [ -L "${bin_ln_not_V11}/kaiming-buildpackage" ]; then
        rm "${bin_ln_not_V11}/kaiming-buildpackage"
    fi

    if [ -L "${bin_ln_not_V11}/kch" ]; then
        rm "${bin_ln_not_V11}/kch"
    fi
else
    if [ -L "${bin_ln_V11}/kaiming-builder" ]; then
        rm "${bin_ln_V11}/kaiming-builder"
    fi

    if [ -L "${bin_ln_V11}/kaiming-buildpackage" ]; then
        rm "${bin_ln_V11}/kaiming-buildpackage"
    fi

    if [ -L "${bin_ln_V11}/kch" ]; then
        rm "${bin_ln_V11}/kch"
    fi
fi

exit 0