#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.

export DH_VERBOSE = 1
export DEB_BUILD_OPTIONS = nocheck # Avoid dh_auto_test check

%:
	dh $@

override_dh_auto_build:
	dh_auto_build -- -j8

# 重写 dh_auto_install
override_dh_auto_install:
	dh_auto_install
	# 调用脚本收集二进制依赖库
	mkdir -p debian/kaiming-builder/opt/kaiming-tools/lib/
	# 进行依赖复制和rpath设置
	./shells/bundle_dependencies.sh

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info -- -l/opt/kaiming-tools/lib

#TODO暂时删除，后续可能更改路径
override_dh_installdocs:
#	mkdir -p $(CURDIR)/debian/kaiming-builder/opt/kaiming-tools/share/doc/kaiming-builder

override_dh_installchangelogs:
#	cp -a debian/changelog $(CURDIR)/debian/kaiming-builder/opt/kaiming-tools/share/doc/kaiming-builder/changelog.Debian
#	cp -a debian/copyright $(CURDIR)/debian/kaiming-builder/opt/kaiming-tools/share/doc/kaiming-builder/copyright
#	chmod -x  $(CURDIR)/debian/kaiming-builder/opt/kaiming-tools/share/doc/kaiming-builder/changelog.Debian
#	gzip -9 -f $(CURDIR)/debian/kaiming-builder/opt/kaiming-tools/share/doc/kaiming-builder/changelog.Debian

