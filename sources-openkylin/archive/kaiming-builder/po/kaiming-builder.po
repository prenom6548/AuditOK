#: ../src/KMBuilderContext.cpp:74
msgid ""
"\n"
"Usage\n"
" \tkaiming-builder build [OPTION…] MANIFEST\n"
msgstr ""
"\n"
"用法：\n"
" \tkaiming-builder build [选项…] MANIFEST\n"

#: ../src/KMBuilderContext.cpp:79 ../src/KMBuilderRun.cpp:87
msgid "Print debug information during command processing"
msgstr "显示命令执行过程中的调试信息"

#: ../src/KMBuilderContext.cpp:80
msgid "Architecture to build for (must be host compatible)"
msgstr "要构建的架构（必须和主机兼容）"

#: ../src/KMBuilderContext.cpp:81 ../src/KMBuilderRun.cpp:88
msgid "Use ccache"
msgstr "使用ccache"

#: ../src/KMBuilderContext.cpp:92
msgid "Stop after build、clean, don't run finish, export phases"
msgstr "只执行build构建、clean清理阶段，不执行finish、export打包阶段"

#: ../src/KMBuilderContext.cpp:93
msgid "Only run finish, export phases"
msgstr "只执行finish、export打包阶段"

#: ../src/KMBuilderContext.cpp:94
msgid "Only run export phase."
msgstr "只执行export打包阶段"

#: ../src/KMBuilderContext.cpp:95
msgid "Generate kaiming package , Only export this project."
msgstr "打包生成kaiming包，只导出项目"

#: ../src/KMBuilderContext.cpp:96
msgid "Generate kaiming package, include base、runtime、app, etc."
msgstr "打包生成kaiming包，其中包含base、runtime、app,etc"

#: ../src/KMBuilderContext.cpp:97
msgid "Generate kaiming package, which like appimage."
msgstr "生成类似AppImage的开明包。"

#: ../src/KMBuilderContext.cpp:87
msgid ""
"The filesystem of the kaiming package's bundle section. Such as squashfs、"
"erofs. Default squashfs."
msgstr ""
"指定导出开明包使用的压缩文件系统类型，例如：squashfs、erofs。默认是squashfs"

#: ../src/KMBuilderContext.cpp:88
msgid "Erase previous contents of DIRECTORY"
msgstr "清除先前构建的内容"

#: ../src/KMBuilderContext.cpp:89
msgid "Don't delete source directories after build"
msgstr "构建完成后保留构建的源码"

#: ../src/KMBuilderContext.cpp:90
msgid "COMPONENTNAME. Stop building at this component (implies --build-only)"
msgstr "组件名称。在此组件处停止构建（使用--build-only时）"

#: ../src/KMBuilderContext.cpp:94
msgid "Number of parallel jobs to build (default=NCPU)"
msgstr "构建时并行作业数量（默认当前可用CPU核数）"

#: ../src/KMBuilderContext.cpp:95
msgid "The path for output of build, default $(pwd)"
msgstr "构建结果存放路径，默认当前工作目录"

#: ../src/KMBuilderContext.cpp:97
msgid "--comp=<comp [extra options]>. Select <comp> compression, squashfs filesystem's <comp> see command mksquashfs, for example : --comp=xz or --comp='zstd -Xcompression-level 18'; erofs filesystem's <comp> see command mkfs.erofs, for example : --comp=lz4hc"
msgstr "--comp=<comp [extra options]>。 选择开明包压缩算法<comp>，squashfs文件系统支持的压缩算法见命令mksquashfs，样例 : --comp=xz 或 --comp='zstd -Xcompression-level 18'；erofs文件系统支持的压缩算法见命令mkfs.erofs，样例：--comp=lz4hc。不指定则使用默认压缩算法。"

#: ../src/KMBuilderContext.cpp:94 ../src/KMBuilderRun.cpp:92
msgid "The MANIFEST file for building, support .km.yml/.km.yaml"
msgstr "用于构建的清单文件，支持.km.yml/.km.yaml"

#: ../src/KMBuilderQuery.cpp:56
msgid ""
"\n"
"Usage\n"
" \tkaiming-builder query [OPTION…]\n"
msgstr ""
"\n"
"用法：\n"
" \tkaiming-builder query [选项…]\n"

#: ../src/KMBuilderQuery.cpp:60
msgid "The kind of kaiming package, such as app/base/runtime/depend and so on"
msgstr "开明包类型，例如app/runtime/depend等"

#: ../src/KMBuilderQuery.cpp:61
msgid ""
"The id of kaiming package. It supports entering only a part of the exact ID "
"and supports wildcards"
msgstr "开明包id,支持只输入id的部分内容及通配符"

#: ../src/KMBuilderQuery.cpp:62
msgid "The matching version"
msgstr "匹配版本号"

#: ../src/KMBuilderQuery.cpp:63
msgid ""
"Module, including binary and devel. Binary for running, devel for development"
msgstr "模块。包括binary和devel。binary用于运行，devel用于开发"

#: ../src/KMBuilderQuery.cpp:64 ../src/KMBuilderCreateFromDeb.cpp:88
msgid ""
"The basic environmental information used by the application. Format: "
"{channel}:{id}/{version}, example: stable:top.openkylin.base/1.0.0"
msgstr ""
"应用需要的基础环境。格式：{channel}:{id}/{version}。例：stable:top.openkylin."
"base/1.0.0"

#: ../src/KMBuilderQuery.cpp:65 ../src/KMBuilderCreateFromDeb.cpp:89
msgid ""
"The runtime environmental information used by the application. Format: "
"{channel}:{id}/{version}, example: stable:top.openkylin.ukui/1.0.0"
msgstr ""
"应用需要的运行时环境。格式：{channel}:{id}/{version}。例：stable:top."
"openkylin.ukui/1.0.0"

#: ../src/KMBuilderNewProject.cpp:62
msgid ""
"\n"
"Usage\n"
" \tkaiming-builder create [OPTION…] [APPID] \n"
msgstr ""
"\n"
"用法：\n"
" \tkaiming-builder create [选项…] [APPID] \n"

#: ../src/KMBuilderNewProject.cpp:66
msgid ""
"The unique identifier of the app. If the appid is left blank, it is top."
"openkylin.demo by default"
msgstr "app的唯一标识符，如果appid为空，默认是top.openkylin.demo"

#: ../src/KMBuilderRun.cpp:83
