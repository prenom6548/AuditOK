    // 恢复历史对话的文件引用
    function restoreDocumentReferenceFromJson(documentJson) {
        console.log("restoreDocumentReferenceFromJson:", documentJson)
        try {
            var docObj = JSON.parse(documentJson)
            if (!docObj || !docObj.list) {
                console.log("No document reference to restore")
                return
            }

            // 清空当前文件引用
            uploadedItemModel.reset()

            // 设置聊天类型
            if (docObj.type === "file") {
                uploadedItemModel.chatType = "file"
            } else if (docObj.type === "knowledgeBaseFile") {
                uploadedItemModel.chatType = "knowledgeBaseFile"
            } else if (docObj.type === "knowledgeBase"){
                uploadedItemModel.chatType = "knowledgeBase"
            }

            // 恢复文件列表
            var docList = docObj.list
            for (var i = 0; i < docList.length; i++) {
                var docItem = docList[i]
                uploadedItemModel.addItem({
                    name: docItem.documentName || "",
                    size: docItem.documentSize || "",
                    icon: docItem.documentIcon || "",
                    path: docItem.documentPath || "",
                    uuid: docItem.documentUuid || "",
                    isDir: docItem.isDir || false,
                    childCount: docItem.childCount || 0
                })
            }

            // 更新 targetDocument 显示
            if (uploadedItemModel.count > 0) {
                targetDocument.iconPath = uploadedItemModel.get(0).icon
                var firstDocumentName = uploadedItemModel.get(0).name
                if (uploadedItemModel.count === 1) {
                    targetDocument.text = firstDocumentName
                } else {
                    targetDocument.text = firstDocumentName + qsTr(" and other ") + String(uploadedItemModel.count - 1) + qsTr(" items")
                }
            }else{
                if (docObj.type === "knowledgeBase"){
                    targetDocument.text = qsTr("Personal Knowledge Base")
                    targetDocument.iconPath = "qrc:/icon/icon/write/knowledge.svg"
                }
            }

            // 设置文件状态为已发送
            uploadedItemModel.status = enums.uploadedFileStatus.SENT
            if (uploadedItemModel.chatType === "file") {
                addFileButton.isActive = true
            } else if (uploadedItemModel.chatType === "knowledgeBaseFile" || uploadedItemModel.chatType === "knowledgeBase") {
                knowledgebaseButton.isActive = true
            }
        } catch (e) {
            console.error("Failed to restore document reference:", e)
        }
    }

