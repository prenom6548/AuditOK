                                break;
                            case 1:
                                lastElement.message = qsTr("Scanning has been stopped")
                                break;
                            case 2:
                                lastElement.message = qsTr("Cutout has been stopped")
                                break;
                            case 3:
                                lastElement.message = qsTr("Answered stopped")
                                break;
                           default:
