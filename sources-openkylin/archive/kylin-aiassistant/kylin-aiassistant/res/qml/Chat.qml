                                function refreshTodoSchedulePrompt() {
                                    if (!model.isGenerateToDo && !chat.pendingGenerateTodoReply && !chat.isTodoCommand) {
                                        return
                                    }
                                    // 待办内容为 Markdown（## 日期、- 事项）；优先 markdownText，兼容旧记录。
                                    var todoSource = (model.markdownText && model.markdownText !== "")
