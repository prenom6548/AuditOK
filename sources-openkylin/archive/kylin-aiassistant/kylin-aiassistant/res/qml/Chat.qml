                                        return
                                    }
                                    var currentMsg = listModel.get(index)
                                    currentMsg.isAddScheduleShow = addSchedulePromptBubbleRet.hasValidTodoList
                                    currentMsg.isGenerateToDo = true
                                    if (addSchedulePromptBubbleRet.hasValidTodoList) {
