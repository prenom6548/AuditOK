                    onAddQuestion: function(questions) {
                        var element = listModel.get(listModel.count - 1);
                        if(listModel.count === 0 || element.author === "User"){
                            return;
                        }

                        console.log("[FollowUp] onAddQuestion called, questions:", questions, "type:", typeof questions);

                        var isEmpty = false;
                        if (questions !== null && questions !== undefined && typeof questions === "object") {
                            if (questions.length !== undefined && questions.length === 0) {
                                isEmpty = true;
                                console.log("[FollowUp] Detected empty array by length:", questions.length);
                            }
                        }else if (questions === "" || questions === null || questions === undefined) {
                            isEmpty = true;
                            console.log("[FollowUp] Detected empty by value check");
                        }else {
                            var questionsStr = String(questions);
                            if (questionsStr === "" || questionsStr === "[]" || questionsStr.trim() === "") {
                                isEmpty = true;
                                console.log("[FollowUp] Detected empty by string conversion:", questionsStr);
                            }
                        }

                        if(isEmpty){
                            console.log("[FollowUp] No questions available, setting __NO_FOLLOW_UP__ marker");
                            element.allFollowUpQuestion = "__NO_FOLLOW_UP__"  // 使用特殊标记表示"已尝试但无追问问题"
                        } else {
                            var questionsStr = String(questions);
                            console.log("[FollowUp] Questions received, setting allFollowUpQuestion to:", questionsStr);
                            element.allFollowUpQuestion = questionsStr
                            if(questionModeEnabled !== ""){
                                element.questionModeEnabledWhenAnswer = String(questionModeEnabled);
                            }
                        }
                        console.log("[FollowUp] Final allFollowUpQuestion:", element.allFollowUpQuestion);
                        listModel.set(listModel.count - 1,element);
                        if(listView.isChatEndFlag){
                            moveCommonTimer.running = true
                        }
                         msgPane.updateLastMessage(listModel.count - 1, JSON.stringify(element));
                    }

                    onInsertImage: function(base64EncodedImage, operatorId, imagePath) {
                        var lastElement = listModel.get(listModel.count - 1)
                        lastElement.drawMsg = false
                        //moveCommonTimer.running = true
