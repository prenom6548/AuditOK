                                                // 初始化
                                                Component.onCompleted: {
                                                    // 问答：设置深度思考
                                                    console.log("深度思考:", ButtonState.isDeepThinking)
                                                    chat.deepThinkingEnabled = ButtonState.isDeepThinking
                                                    msgPane.setDeepThinking(ButtonState.isDeepThinking)
                                                }
                                            }

                                            //联网搜索按钮
                                            WebSearchButton {
                                                id: webSearchButton
                                                Layout.alignment: Qt.AlignVCenter
                                                Layout.fillHeight: false
                                                Layout.preferredHeight: 32

                                                Connections {
                                                    target: ButtonState

                                                    onIsWebSearchChanged: function() {
                                                        // 问答：设置联网搜索
                                                        console.log("联网搜索:", ButtonState.isWebSearch)
                                                        msgPane.setWebSearch(ButtonState.isWebSearch)
                                                    }
