    function initGatewayHost() {
        var configuredHost = msgPane.getConfigValue("gateway-host")
        if (configuredHost && String(configuredHost).trim() !== "") {
            gatewayHost = String(configuredHost).trim()
        } else {
            gatewayHost = "127.0.0.1:42617"
        }
    }

    function routeByTaskTab(tabKey) {
        switch (tabKey) {
        case "channels":
            return "/channel"
        case "capabilities":
            return "/skills"
        case "tasks":
            return "/cron"
        case "models":
            return "/model"
        default:
            return "/"
        }
    }

    function modelSubscriptText(modelMsg, isSpeechMessage, modeType) {
        var value = (modelMsg === undefined || modelMsg === null) ? "" : String(modelMsg)
        if (value === "") {
            return (isSpeechMessage === true && Number(modeType) === 1) ? qsTr("Content generated by AI") : ""
        }

        if (ButtonState.isTaskMode || value === "Content generated by AI" || value === qsTr("Content generated by AI")) {
            return qsTr("Content generated by AI")
        }

        if (value === "ai" || value === "::ai_assistant") {
            return qsTr("Generated by Xiao K")
        }

        return qsTr("Generated by %1").arg(value)
    }

