                        if(operatorId === 1){
                            lastElement.message = qsTr("Here is the black-and-white scan based on your request.")
                            lastElement.isShowPictureOperateRefresh = false
                        }else if(operatorId === 2){
                            lastElement.message = qsTr("Here is the cutout result based on your request.")
                            lastElement.isShowPictureOperateRefresh = false
                        }else if(operatorId === 0){
                            lastElement.message = qsTr("Here is the image generated based on your description.")
                        }

                        if(operatorId === 4){
                            lastElement.imageSrc = "qrc:/icon/icon/loading-fail.png"
                        }else{
                            lastElement.imageSrc = base64EncodedImage

                        }
                        lastElement.operatorId = operatorId
                        lastElement.imagePath = imagePath
                        lastElement.isFirst = false
                        moveCommonTimer.running = true
                        moveGIFTimer.running = true
