    property bool webPageLoaded: false

    function buildTaskWebUrl(route) {
        var url = "qrc:///webkbot/index.html"
            + "?kybotEmbed=qtwebengine"
        var loc = Qt.locale().name
        if (loc && loc.length > 0) {
            url += "&locale=" + encodeURIComponent(loc)
        }
        if (webApiBridge.providerDropdownSafeMode()) {
            url += "&providerDropdownSafeMode=1"
        }
        var gwToken = msgPane.getConfigValue("gateway-token")
        if (gwToken && String(gwToken).trim() !== "") {
            url += "&token=" + encodeURIComponent(String(gwToken).trim())
        }
        return url + "#" + route
    }

    function updateTaskWebUrl(tabKey) {
        if (!gatewayHost || gatewayHost === "") {
            initGatewayHost()
        }
        msgPane.validateAndRefreshGatewayToken()
        var route = routeByTaskTab(tabKey)
        if (webPageLoaded && webLoadedRoute === route) {
            return
        }

        pendingTaskWebRoute = route
        webPageLoaded = false
        webUiCurrentUrl = buildTaskWebUrl(route)
    }

    function setTaskTab(index, tabKey) {
        currentTaskTabIndex = index
        currentTaskTabKey = tabKey
        if (index !== 0) {
            updateTaskWebUrl(tabKey)
        }
        // index === 0 时不清空 URL，保持 WebEngineView 预加载状态
    }

