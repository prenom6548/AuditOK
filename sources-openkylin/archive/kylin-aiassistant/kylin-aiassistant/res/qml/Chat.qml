    function normalizeTaskToolCalls(value) {
        if (value === undefined || value === null || value === "")
            return []
        if (Array.isArray(value))
            return value
        if (typeof value === "string") {
            try {
                return normalizeTaskToolCalls(JSON.parse(value))
            } catch (e) {
                return []
            }
        }
        if (value.toolCalls !== undefined)
            return normalizeTaskToolCalls(value.toolCalls)
        if (value.tool_calls !== undefined)
            return normalizeTaskToolCalls(value.tool_calls)
        return []
    }

    function getTaskToolCallId(frame) {
        if (!frame)
            return ""
        var id = frame.call_id || frame.tool_call_id || frame.id || frame.name || frame.tool_name || frame.tool || ""
        return String(id)
    }

    function updateTaskToolCallsFromFrame(jsonData) {
        if (!jsonData || listModel.count === 0)
            return

        var element = listModel.get(listModel.count - 1)
        if (!element || element.author === "User")
            return

        var frame
        try {
            frame = typeof jsonData === "string" ? JSON.parse(jsonData) : jsonData
        } catch (e) {
            console.log("Failed to parse task tool frame:", e)
            return
        }

        var calls = normalizeTaskToolCalls(element.taskToolCalls)
        var frameType = frame.type || ""
        var callId = getTaskToolCallId(frame)
        var targetIndex = -1

        for (var i = 0; i < calls.length; ++i) {
            if (getTaskToolCallId(calls[i]) === callId && callId !== "") {
                targetIndex = i
                break
            }
        }

        if (frameType === "tool_call") {
            if (targetIndex < 0) {
                var newCall = {
                    "id": callId,
                    "name": frame.name || frame.tool_name || frame.tool || "",
                    "args": frame.args !== undefined ? frame.args : (frame.arguments !== undefined ? frame.arguments : (frame.input !== undefined ? frame.input : (frame.params !== undefined ? frame.params : frame.parameters))),
                    "output": ""
                }
                calls.push(newCall)
                targetIndex = calls.length - 1
            }
        } else if (frameType === "tool_result") {
            if (targetIndex < 0) {
                console.log("Orphan tool_result dropped, callId:", callId)
                return
            }
            calls[targetIndex].output = frame.output !== undefined ? frame.output : (frame.result !== undefined ? frame.result : (frame.content !== undefined ? frame.content : frame.message))
        } else {
            return
        }

        element.taskToolCalls = JSON.stringify({"toolCalls": calls})
        listModel.set(listModel.count - 1, element)

        if (element.isEnd) {
            msgPane.updateLastMessage(listModel.count - 1, JSON.stringify(element))
        }
        if (listView.isChatEndFlag) {
            moveCommonTimer.running = true
        }
    }

    // 打包待发送区的所有信息，发送给后端。
    // 目的：优化发送流程中重复的部分
    // 注意：使用 isSending 重入防护 + messageText 提前快照，防止智能体模式(WebSocket)下
    // C++ 端嵌套事件循环(QEventLoop::exec)期间，连续点击发送按钮导致同一条消息被重入发送多次
    function packageAndSendMessage() {
        // 判断是否使用新的指令系统（使用uuid）
        let useNewCommandSystem = inputRectange.activeCommandUuid !== ""
        let promptIdValue = -1
        let promptIconPathValue = ""

        if (useNewCommandSystem) {
            // 新的指令系统使用uuid，promptId设置为-1表示使用自定义指令
            promptIdValue = -1
            promptIconPathValue = inputRectange.activeCommandIcon
        } else {
            // 旧的指令系统使用activeCommandID
            promptIdValue = inputRectange.activeCommandID
            promptIconPathValue = commandTemplateListModel.getPromptIconHighlightpath(inputRectange.activeCommandID)
        }

        if (isSending) {
            return
        }
        isSending = true

        let messageText = messageField.text

        let msgHeadList = {
            msgHead: inputRectange.activeCommand,
            promptId: promptIdValue,
            promptIconPath: promptIconPathValue,
            imagePath: inputRectange.imagePreviewPath,
            imageSrc: inputRectange.imagePreviewSrc,
            modeType: ButtonState.isTaskMode ? 1 : 0
        }

        // 如果使用新的指令系统，添加uuid字段
        if (useNewCommandSystem) {
            msgHeadList.commandUuid = inputRectange.activeCommandUuid
        }

        // 如果挂载区有数据 而且 是个人知识库
        if (uploadedItemModel.chatType === "knowledgeBase"){
            let jsonOject = {
                type: "knowledgeBase"
            }
            msgHeadList.document = jsonOject
            uploadedItemModel.status = enums.uploadedFileStatus.SENT
        } else {
            // 如果model中有文件
            if (uploadedItemModel.count > 0) {
                let documentCount =  uploadedItemModel.count
                // 从ListModel中提取文档数据并转换为数组
                let documentList = [];
                for (var i = 0; i < uploadedItemModel.count; i++) {
                    var item = uploadedItemModel.get(i);
                    documentList.push({
                        documentName: item.name,
                        documentSize: item.size,
                        documentIcon: item.icon,
                        documentPath: item.path,
                        documentUuid: item.uuid,
                        isDir: item.isDir,
                        childCount: item.childCount

                    });
                }

                // 准备挂载区数据
                targetDocument.iconPath = uploadedItemModel.get(0).icon

                let firstDocumentName = uploadedItemModel.get(0).name
                if (documentCount === 1) {
                    targetDocument.text = firstDocumentName
                } else {
                    targetDocument.text = firstDocumentName + qsTr(" and other ") + String(documentCount - 1) + qsTr(" items")
                }

                // 文档首次发送显示文档，非首次发送显示挂载内容
                if (uploadedItemModel.status === enums.uploadedFileStatus.SENT){
                    msgHeadList.targetDocument = targetDocument.text
                }

                // 判断 普通文档问答 或 知识库文档问答
                if (uploadedItemModel.chatType === "file") {
                    let jsonOject = {
                        type: "file",
                        list: documentList
                    }
                    msgHeadList.document = jsonOject
                } else if (uploadedItemModel.chatType === "knowledgeBaseFile") {
                    let jsonOject = {
                        type: "knowledgeBaseFile",
                        list: documentList
                    }
                    msgHeadList.document = jsonOject
                }

                // 文件发送后，清空文档上传区，转为挂载区
                if (addFileButton.isActive){
                    uploadedItemModel.status = enums.uploadedFileStatus.SENT
                    addFileButton.isActive = true;
                }
                if (knowledgebaseButton.isActive){
                    uploadedItemModel.status = enums.uploadedFileStatus.SENT
                    knowledgebaseButton.isActive = true
                }
            }
        }

        let jsonMsgHead = JSON.stringify(msgHeadList)
        moveCommonTimer.running = true
        let retJsonString = msgPane.onSendMsg(jsonMsgHead, messageText)
        let retJsonObject = JSON.parse(retJsonString);
        isReplying = retJsonObject['isReplying'] !== undefined ? retJsonObject['isReplying'] : false
        msgPane.onSendDataCollect("send_chat_message_click_event", "chatPage")

        if (msgHeadList.commandUuid === generateTodoCommandUuid) {
            pendingGenerateTodoReply = true
        }

        isSending = false

        // 图片发送后，附件按钮恢复默认
        if (inputRectange.imagePreviewSrc !== "") {
            addFileButton.isActive = false;
        }

        // 如果选中了"生成待办"指令，发送后清除文档挂载区
        if (isTodoCommand && uploadedItemModel.count > 0) {
            uploadedItemModel.reset()
            targetDocument.clear()
            addFileButton.isActive = false
            knowledgebaseButton.isActive = false
        }

        messageField.text = "";

        imagePreviewShowRow.clear()

    }

