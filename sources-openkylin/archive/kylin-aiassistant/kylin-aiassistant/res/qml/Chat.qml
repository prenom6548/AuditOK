                                    } catch(e) {
                                        console.log("Failed to parse todo list JSON:", e)
                                        parsedTodos = []
                                    }
                                    todoListArray = parsedTodos
                                    addSchedulePromptBubbleRet.hasValidTodoList = Array.isArray(parsedTodos) && parsedTodos.length > 0

