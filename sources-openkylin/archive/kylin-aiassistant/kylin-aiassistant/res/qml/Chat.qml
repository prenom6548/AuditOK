                                                                    // 若此处也处理空格会导致刚启动的录音被立即停止
                                                                    if (isCapturingVideo && event.key !== Qt.Key_Space) {
                                                                        unifiedSendButton.stopVoiceInput(true);
                                                                    }

                                                                    // 空格键长按检测：!event.isAutoRepeat 确保只响应首次按下，忽略按住时的重复事件
                                                                    if (event.key === Qt.Key_Space) {
                                                                        // 输入法 composing 或有预编辑文本时（如中文输入选词），不拦截空格，交由 IME 处理
                                                                        var hasPreedit = (typeof Qt !== 'undefined' && Qt.inputMethod && Qt.inputMethod.preeditText && Qt.inputMethod.preeditText.length > 0)
                                                                        if (messageField.inputMethodComposing || hasPreedit) {
                                                                            messageField.spaceKeyPressedDuringImeComposing = true
                                                                            return
