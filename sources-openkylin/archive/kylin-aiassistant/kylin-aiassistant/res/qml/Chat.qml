                                                                            var cursorPos = messageField.cursorPosition;
                                                                            messageField.text = messageField.text.substring(0, cursorPos) + "\n" + messageField.text.substring(cursorPos);
                                                                            messageField.cursorPosition = cursorPos + 1;
                                                                            event.accepted = true;
                                                                            return;
                                                                        }

                                                                        console.log("只按下enter")

