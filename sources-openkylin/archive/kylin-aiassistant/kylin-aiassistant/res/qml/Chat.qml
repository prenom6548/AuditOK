    // 显示删除确认弹窗
    function showDeleteConfirmDialog(msgIndex) {
        // 删除前停止朗读
        readerControl.stopReading()
        let dialogComponent = Qt.createComponent("qrc:/qml/qml/DeleteCommonWindow.qml");
        if (dialogComponent.status === Component.Ready) {
            let dialog = dialogComponent.createObject(chat);
            dialog.questionText = qsTr("Are you sure you want to delete it?")
            dialog.infoText = qsTr("After deleting the conversation, it cannot be restored.")
            dialog.confirmButtonText = qsTr("Delete")
            dialog.cancelButtonText = qsTr("Cancel")
            dialog.highlightConfirmButton = true
            dialog.highlightCancelButton = false
            dialog.showNoRemindCheckBox = false

            if (dialog) {
                dialog.confirmed.connect(function(selectedOptions, noRemindChecked) {
                    // 执行删除操作
                    performDeleteMessage(msgIndex)
                    dialog.destroy();
                });

                dialog.canceled.connect(function() {
                    dialog.destroy();
                });

                dialog.showDialog()
            }
        } else {
            console.log("Failed to load DeleteCommonWindow component:", dialogComponent.errorString())
        }
    }

    // 执行删除消息操作
    function performDeleteMessage(msgIndex) {
        if (msgIndex < 0 || msgIndex >= listModel.count) {
            return
        }

        var currentMsg = listModel.get(msgIndex)
        var isGenerateToDo = currentMsg.isGenerateToDo !== undefined && currentMsg.isGenerateToDo

        // 找到对应的用户消息（一问一答）
        var userMsgIndex = -1
        for (var i = msgIndex - 1; i >= 0; i--) {
            var msg = listModel.get(i)
            if (msg.author === "User") {
                userMsgIndex = i
                break
            }
        }

        // 计算需要删除的消息数量
        var deleteCount = 0
        var startIndex = -1

        if (userMsgIndex >= 0) {
            // 找到用户消息，删除一问一答
            startIndex = userMsgIndex
            deleteCount = msgIndex - userMsgIndex + 1
        } else {
            // 如果没有找到用户消息，只删除当前AI回答
            startIndex = msgIndex
            deleteCount = 1
        }

        // 从后往前删除，避免索引变化
        // 注意：生成待办的确认提示（AddSchedulePromptBubble）和查看日程提示（ScheduleAddedBubble）
        // 是基于 model.isGenerateToDo 和 model.isAddSchedule 显示的，它们不是独立的listModel项
        // 删除一问一答后，这些提示会自动消失
        for (var j = startIndex + deleteCount - 1; j >= startIndex; j--) {
            if (j >= 0 && j < listModel.count) {
                // 从数据库中删除消息
                msgPane.deleteMessageByIndex(j)
            }
        }

    }

