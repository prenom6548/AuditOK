    //用于用户发送消息转换
    function convertString(msgMessage){
        // 判断如果是带标签的指令，特殊转换一下
        if(msgMessage !== "" && msgMessage !== null && msgMessage !== undefined){
            // 将换行符转换为 <br> 标签
            var htmlText = msgMessage.replace(/\n/g, "<br>");
            // 可以根据需要添加其他格式化处理，例如
            // 将 **加粗** 的内容用 <b> 包裹
            htmlText = htmlText.replace(/\*\*(.*?)\*\*/g, "<b>$1</b>");
            // 将 _斜体_ 的内容用 <i> 包裹
            htmlText = htmlText.replace(/_(.*?)_/g, "<i>$1</i>");
            msgMessage = htmlText
        }else{
            return "";
        }

        return msgMessage;

    }

    function looksLikeHtml(text) {
        if (!text)
            return false
        return text.indexOf("<p>") !== -1 || text.indexOf("<br") !== -1
                || text.indexOf("<ul") !== -1 || text.indexOf("<ol") !== -1
                || text.indexOf("<pre") !== -1 || text.indexOf("<h1") !== -1
                || text.indexOf("<h2") !== -1 || text.indexOf("<span") !== -1
                || text.indexOf("<div") !== -1
    }

    // 新消息走 Markdown；历史里已存成 HTML 的仍用原文 Markdown（若有）或 RichText
    function bubbleDisplayText(message, markdownText) {
        if (markdownText && markdownText !== "" && looksLikeHtml(message) && !looksLikeHtml(markdownText))
            return markdownText
        return message || ""
    }

    function bubbleTextFormat(sentByUser, text) {
        if (sentByUser)
            return Text.PlainText
        if (looksLikeHtml(text))
            return Text.RichText
        return Text.MarkdownText
    }

    // 用于还原后端二次转义后的 html 实体（如 &amp;lt; -> &lt;）
    function convertStringToHtml(msgMessage) {
        if (msgMessage !== "" && msgMessage !== null && msgMessage !== undefined) {
            var htmlText = msgMessage.replace(/&amp;lt;/g, "&lt;")
            htmlText = htmlText.replace(/&amp;gt;/g, "&gt;")
            // cmark 围栏代码为 <pre><code>，Qt 富文本默认 pre 不换行会导致右侧裁切；补样式兜底（含已走 HTML 分支的内容）
            htmlText = htmlText.replace(/<pre>/gi, "<pre style=\"white-space:pre-wrap;word-wrap:break-word;\">")
            return htmlText
        }
        return ""
    }

