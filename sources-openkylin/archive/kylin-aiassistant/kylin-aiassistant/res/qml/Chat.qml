                                                                        // 按下时处于 IME 组合状态（如中文选词），不插入空格，交由 IME 处理
                                                                        if (messageField.spaceKeyPressedDuringImeComposing) {
                                                                            globals.sendLog("----按下时处于 IME 组合状态（如中文选词），不插入空格，交由 IME 处理----" + event.key)
                                                                            messageField.spaceKeyPressedDuringImeComposing = false
                                                                            return
                                                                        }


                                                                        // 检查长按空格语音输入功能是否启用
                                                                        var isSpaceVoiceInputEnabled = globals ? globals.getSpaceVoiceInputEnabled() : false
                                                                        spaceKeyHoldTimer.stop()
                                                                        // 长按启动的录音：松开空格即停止；若长按空格与点击录音按钮同时触发，录音可能由按钮先启动，
