                                        // 处理Markdown文本，解决列表序号显示错误的问题
                                        function processMarkdownText(text) {
                                            if (!text) return "";
                                            var parts = text.split("```");
                                            for (var i = 0; i < parts.length; i += 2) {
                                                var content = parts[i];
                                                // 1. 转义列表序号
                                                content = content.replace(/(^|\n)(\s*)(\d+)\.(\s+)/g, "$1$2$3\\.$4");
                                                // 2. 在非空行末尾添加两个空格以强制换行
                                                content = content.replace(/([^\n])\n/g, "$1  \n");
                                                // 3. 处理网址字符，前后加上`。防止被渲染成超链接形式。
                                                content = content.replace(/(^|[^`])(https?:\/\/[^\s`]+)($|[^`])/g, "$1`$2`$3");
                                                parts[i] = content;
                                            }
                                            return parts.join("```");
