                    onAddDocumentPreview: function(filePath, icon, fileName, fileSize){
                        // 临时文件问答-如果model中有文件
                        if (uploadedItemModel.count === 1) {
                            var item = uploadedItemModel.get(0);
                            // 如果拖入的文件与列表中的文件相同，不做任何操作
                            if (item.path === filePath) {
                                return
                            }
                        }

                        // 添加文件时，清空图片预览区，文档预览区和挂载区
                        uploadedItemModel.reset()
                        imagePreviewShowRow.clear()
                        targetDocument.clear()

                        // 清除之前的文档引用
                        msgPane.clearCurrentSessionDocumentReference()

                        addFileButton.isActive = true
                        uploadedItemModel.addItem({
                                                      name: fileName,
                                                      size: fileSize,
                                                      icon: icon,
                                                      path: filePath,
                                                      uuid: "",
                                                      isDir: false,
                                                      childCount: 0
                                                  })
                        uploadedItemModel.chatType = "file"
                        uploadedItemModel.status = enums.uploadedFileStatus.PREVIEW
                        // 上传文档时，如果当前选中了"生成待办"指令，则保留输入框中已选择的指令
                        if (inputRectange.activeCommand !== "" && !isTodoCommand){
                            inputRectange.activeCommand = ""
                            inputRectange.activeCommandID = -1
                            inputRectange.activeCommandUuid = ""
