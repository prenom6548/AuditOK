                    onReplyEnd: function(isEnd) {
                        console.log("onReplyEnd", isEnd);
                        var element = listModel.get(listModel.count - 1);
                        if(listModel.count === 0 || element.author === "User")
                            return;
                        // 错误场景(colorMsg为red/black)下不显示"已停止回答"，避免与错误提示重复
                        if(element.message === "" && element.colorMsg !== "red" && element.colorMsg !== "black"){
                           element.message = qsTr("Answered stopped")
                        }
                        element.isEnd = isEnd;
                        if(element.drawMsg === true){
                            element.drawMsg = false
                            element.message = qsTr("Generation failed")
                            element.imageSrc = "qrc:/icon/icon/loading-fail.png"
                        }
                        // 记录回答结束时的追问模式状态，用于判断是否显示"追问生成中"
                        element.questionModeEnabledWhenAnswer = String(questionModeEnabled);

                        var isGenerateTodoReply = element.isGenerateToDo
                                                  || pendingGenerateTodoReply
                                                  || isTodoCommand
                        if (isGenerateTodoReply) {
                            element.isGenerateToDo = true
                        }

                        //element.colorMsg === "red" || element.noModelError === "true"
                        if(element.colorMsg === "red"){
                            //如果是异常消息，去除html标签和末尾的换行，解决历史记录第一条异常的问题
                            // 解析 JSON 字符串为 JavaScript 对象
                            var jsonObject = JSON.parse(JSON.stringify(element));
                            //去除html标签
                            //jsonObject.message = jsonObject.message.replace(/<\/?.+?\/?>/g,'');
                            //去除最末尾的换行
                            jsonObject.message = jsonObject.message.replace(/\n$/, '')
                            msgPane.saveToDatabase(listModel.count - 1, JSON.stringify(jsonObject));
                        }else{
                            msgPane.saveToDatabase(listModel.count - 1, JSON.stringify(element));
                        }

                        listModel.set(listModel.count - 1, element)
                        pendingGenerateTodoReply = false
                        // refreshTodoSchedulePrompt 可能在 delegate 中已更新 isAddScheduleShow，同步最新状态再落库
                        var syncedElement = listModel.get(listModel.count - 1)
                        msgPane.updateLastMessage(listModel.count - 1, JSON.stringify(syncedElement))

                        isReplying = false;

                    }

                    onReplyingChanged: function(replying) {
