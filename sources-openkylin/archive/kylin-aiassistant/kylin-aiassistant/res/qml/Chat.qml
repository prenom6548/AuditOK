                                                                            if (messageField.text.trim().length > 0) {
                                                                                globals.sendLog("----输入框已有文字时，不手动插入空格，避免干扰中文输入（空格用于选词）----" + event.key)
                                                                                messageField.spaceKeyTriggeredRecording = false
                                                                                return
                                                                            }

