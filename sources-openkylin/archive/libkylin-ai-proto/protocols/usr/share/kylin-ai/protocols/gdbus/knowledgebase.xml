<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
    <interface name="com.kylin.AiBusiness.Knowledgebase">

        <!--
          @brief create knowledge base
          @param [in] knowledgebaseName
          such as:
          {
            "knowledgebaseName": "default"
          }
          @param [out] result.
          such as:
          {
            "data": {
                      "knowledgebaseName": "test"
                    }
            "err_no": 0,
            "err_msg": "error"
          }
        -->
        <method name="createKnowledgeBase">
            <arg name="knowledgebaseName" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!--
          @brief delete knowledge base
          @param [in] knowledgeBaseName, the name of the knowledge base
          such as :
          {
            "knowledgebaseName": "test"
          }
          @param [out] error message returned;
          such as:
          {
            "err_no": 0,
            "err_msg": "error"
          }
        -->
        <method name="deleteKnowledgeBase">
            <arg name="knowledgeBaseName" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!--
          @brief similarity search
          @param [in] content of the search and the name of the knowledge base, a json string, has at least a 'text' key.
          such as:
           {
            "knowledgebaseName": "test",
            "searchCondition": "linux内核安全选项"
           }
          @param [out] search result, a json with 'data' key and error.
          such as:  {
                      "data": {"result":"[
                                          {
                                            "document": "adgjcvn",
                                            "filepath": "/path/to/file1.txt",
                                            "similarity": 0.92
                                          },
                                          {
                                            "document": "trsghncd",
                                            "filepath": "/path/to/file2.txt",
                                            "similarity": 0.85
                                          }
                                          ......
                                        ]"
                              },s
                      "err_no": 0,
                      "err_msg": "error"
                    }
        -->
        <method name="similaritySearch">
            <arg name="searchConditions" type="s" direction="in" />
            <arg name="searchResult" type="s" direction="out" />
        </method>

        <!--
          @brief add text file to user data
          @param [in] text files info, a json with 'filepath' key and 'fileformat' key.
          such as: {
                      [
                        {
                          "knowledgeBaseName": "test",
                          "filepath": "/path/to/file1.txt",
                          "fileformat": "txt"
                          "chunk_size": 100
                        },
                        {
                          "knowledgeBaseName": "test",
                          "filepath": "/path/to/file2.txt",
                          "fileformat": "txt"
                          "chunk_size": 200
                        }
                      ]
                    }
          @param [out] error message returned;
          such as :
          {
            "err_no": 0,
            "err_msg": "error"
          }
        -->
        <method name="addTextFiles">
            <arg name="fileinfos" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!--
          @brief get text file contents to user data
          @param [in] text files info, a json.
          such as:  {
                      [
                        {
                          "knowledgeBaseName": "test",
                          "filepath": "/path/to/file1.txt",
                          "fileformat": "txt"
                          "chunk_size": 100
                        },
                        {
                          "knowledgeBaseName": "test",
                          "filepath": "/path/to/file2.txt",
                          "fileformat": "txt"
                          "chunk_size": 200
                        }
                      ]
                    }
          @param [out] file info contents, a json with 'data' and 'error' .;
          such as:  {
                      "data": { "result":
                                        "[
                                          {
                                            "filepath": "/path/to/file1.txt",
                                            "document": "file1 content"
                                          },
                                          {
                                            "filepath": "/path/to/file2.txt",
                                            "document": "file2 content"
                                          }
                                        ]"
                              },
                      "err_no": 0,
                      "err_msg": "error"
                    }
        -->
        <method name="getTextFileContents">
            <arg name="fileinfos" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

    </interface>
</node>
