<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
    <interface name="com.kylin.AiBusiness.KnowledgeBaseService">
        <!-- 初始化知识库会话 -->
        <!--
          @brief init knowledge base session
          @param [in] appId
          such as:
          {
            "appId": "cn.kylin.aiassistant"
          }
          @param [out] session id
          such as:
          {
            "data": {
              "sessionId": 15
            }
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <method name="initKnowledgeBaseSession">
            <arg name="input" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!-- 销毁知识库会话 -->
        <!--
          @brief destroy knowledge base session
          @param [in] session id
          such as:
          {
            "sessionId": 15
          }
          @param [out] error message returned;
          such as:
          {
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <method name="destroyKnowledgeBaseSession">
            <arg name="input" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!-- 知识库管理接口 -->
        <!--
          @brief create knowledge base
          @param [in] knowledgeBaseInfo
          such as:
          {
            "appId": "cn.kylin.aiassistant"
            "name": "assistant_kb"
            "description": "This is a knowledge base for kylin-ai-assistant"
            "type": "RAG" or "FAQ", default RAG
            "indexType": "FLAT"
          }
          @param [out] result.
          such as:
          {
            "data": {
              "knowledgeBaseId": "XXX"
            }
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <method name="createKnowledgeBase">
            <arg name="input" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!--
          @brief delete knowledge base
          @param [in] knowledgeBaseId
          such as :
          {
            "appId": "cn.kylin.aiassistant"
            "knowledgeBaseId": "XXX"
          }
          @param [out] error message returned;
          such as:
          {
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <method name="deleteKnowledgeBase">
            <arg name="input" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!--
          @brief get knowledge base info
          @param [in] input
          such as:
          {
            "appId": "cn.kylin.aiassistant"
            "knowledgeBaseId": "XXX"
          }
          @param [out] knowledge base info
          such as:
          {
            "data": {
              "name":"assistant_kb",
              "description":"This is a knowledge base for kylin-ai-assistant",
              "knowledgeBaseId":"XXX",
              "changetime":"xxxx-xx-xx xx:xx:xx",
              "indexType":"FLAT",
              "type":"RAG" or "FAQ", default RAG
            },
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <method name="getKnowledgeBase">
            <arg name="input" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!--
          @brief get all knowledge base info
          @param [in] appId
          such as:
          {
            "appId": "cn.kylin.aiassistant"
          }
          @param [out] all knowledge base info
          such as:
          {
            "data": [
              {
                "name":"assistant_kb",
                "description":"This is a knowledge base for kylin-ai-assistant",
                "knowledgeBaseId":"XXX",
                "changetime":"",
                "indexType":"FLAT",
                "type":"RAG" or "FAQ", default RAG
              }
            ],
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <method name="getAllKnowledgeBase">
            <arg name="input" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!--
          @brief change the name of knowledge base
          @param [in]
          such as:
          {
            "appId": "cn.kylin.aiassistant",
            "knowledgeBaseId": "XXX",
            "name": "newName",
          }
          @param [out]
          such as:
          {
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <method name="setKnowledgeBaseName">
            <arg name="input" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!--
          @brief change the description of knowledge base
          @param [in]
          such as:
          {
            "appId": "cn.kylin.aiassistant",
            "knowledgeBaseId": "XXX",
            "description": "newDescription",
          }
          @param [out]
          such as:
          {
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <method name="setKnowledgeBaseDescription">
            <arg name="input" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!--
          @brief 上传文档到知识库
          @param [in] input
          such as:
          {
            "appId": "cn.kylin.aiassistant",
            "knowledgeBaseId": "XXX",
            "files": [
              {"filePath": "/path/to/doc1.pdf", "fileId": "file_001"},
              {"filePath": "/path/to/doc2.docx", "fileId": "file_002"}
            ],
            "config": {
              "chunkSize": 1024,
              "embeddingModel": "xxx",
              "enhanceParse": false
            }
          }
          @param [out] result
          such as:
          {
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <method name="uploadDocuments">
            <arg name="input" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!--
          @brief 获取知识库中的文件列表
          @param [in] input
          such as:
          {
            "appId": "cn.kylin.aiassistant",
            "knowledgeBaseId": "XXX"
          }
          @param [out] result
          such as:
          {
            "data": {
              "fileIds": ["file_001", "file_002"],
            }
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <method name="getFileListInKnowledgeBase">
            <arg name="input" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!--
          @brief 删除知识库中的文件
          @param [in] input
          such as:
          {
            "appId": "cn.kylin.aiassistant",
            "knowledgeBaseId": "XXX",
            "fileIds": ["file_001", "file_002"]
          }
          @param [out] result
          such as:
          {
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <method name="deleteFiles">
            <arg name="input" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!--
          @brief 获取文件处理进度
          @param [in] input
          such as:
          {
            "appId": "cn.kylin.aiassistant",
            "knowledgeBaseId": "XXX",
            "fileId": "file_001"
          }
          @param [out] result
          such as:
          {
            "data": {
              "progress": 0.75,
              "status": "PENDING", // 状态值: PENDING/PARSING/EMBEDDING/INDEXING/COMPLETED/ALLCOMPLETED/FAILED
            }
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <method name="getFileProcessingProgress">
            <arg name="input" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!-- 检索与问答接口 -->
        <!--
          @brief 知识库检索
          @param [in] input
          such as:
          {
            "appId": "cn.kylin.aiassistant",
            "knowledgeBaseId": "XXX",
            "requestId": "req_123456",
            "query": "如何安装软件？",
            "fileIds": ["file_001", "file_002"],
            "config": {
              "retrievalMethod": "SEMANTIC" // 检索方法：SEMANTIC/KEYWORD/HYBRID
              "scoreThreshold": 0.7, // 召回阈值
              "topK": 5,
              "maxTokens": 4096.
              "expandContext": true,
              "rerankMethod": "RRF"
            }
          }
          @param [out] result
          such as:
          {
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <method name="retrievalKnowledgeBase">
            <arg name="input" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!--
          @brief 知识库问答对话（同步返回完整结果）
          @param [in] input
          such as: {
            "appId": "cn.kylin.aiassistant",
            "knowledgeBaseId": "XXX",
            "requestId": "chat_123456",
            "query": "如何备份系统？",
            "fileIds": ["file_1", "file_2"],
            "config": {
              "modelName": "Qwen-2.5-3b_1.0",
              "newChat": true,
              "retrievalMethod": "SEMANTIC" // 检索方法：SEMANTIC/KEYWORD/HYBRID
              "scoreThreshold": 0.9, // 召回阈值
              "topK": 5,
              "scoreThreshold": 0.8,
              "maxTokens": 4096.
              "expandContext": true,
              "rerankMethod": "RRF"
            },
            "message": [
              {"role": "user", "content": "你好"},
              {"role": "assistant", "content": "您好，请继续提问"}
            ]
          }
          @param [out] result
          such as:
          {
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <method name="chatWithKnowledgeBase">
            <arg name="input" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!--
          @brief 终止指定对话
          @param [in] input
          such as: {
            "requestId": "chat_123456",
          }
          @param [out] result
          such as:
          {
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <method name="stopChat">
            <arg name="input" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!--
          @brief 终止文档上传
          @param [in] input
          such as: {
            "sessionId": 123456,
            "knowledgeBaseId": "XXX",
            "fileIds": ["file_001", "file_002"]
          }
          @param [out] result
          such as:
          {
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <method name="stopUpload">
            <arg name="input" type="s" direction="in" />
            <arg name="result" type="s" direction="out" />
        </method>

        <!-- =============== 信号定义 =============== -->
        <!-- 文档上传进度信号
          such as :
          {
            "data": {
              "fileId": "file_001",
              "progress": "70", 进度百分比 0-100,
              "status": "EMBEDDING" PENDING/PARSING/EMBEDDING/INDEXING/COMPLETED/ALLCOMPLETED/FAILED
            }
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <signal name="DocumentUploadProgress">
            <arg name="param" type="s" />
        </signal>

        <!-- 流式聊天响应信号
          such as :
          {
            "data": {
              "chunks": [ RAG
                {
                  "fileId": "file_001",
                  "chunkIndex": 0,
                  "sectionTitles": "段落1",
                  "content": "段落1的内容",
                  "metadata": "元数据",
                  "similarity": 0.8
                }
              ],
              "items": [ FAQ
                {
                  "knowledgeId": "item_001",
                  "question": "问题",
                  "answer": "答案",
                  "description": "问题描述",
                  "similarity": 0.8
                }
              ],
              "isFinal": false,
              "queryText": "查询文本",
              "requestId":"request_001",
              "result": "token文本"
            }
            "err_no": 0,
            "err_msg": "error message"
          }
        -->
        <signal name="StreamingChatResponse">
            <arg name="param" type="s" />
        </signal>

    </interface>
</node>
