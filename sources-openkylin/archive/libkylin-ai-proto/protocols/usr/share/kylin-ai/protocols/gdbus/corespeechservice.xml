        <annotation name="SdkVersion" value="1.3.0"/>
        <property name="RuntimeVersion" type="s" access="read"/>
        <method name="initRecognizer">
            <arg name="sessionId" type="i" direction="out" />
            <arg name="errorCode" type="i" direction="out" />
            <arg name="config" type="s" direction="in" />
        </method>
        <method name="initSynthesizer">
            <arg name="sessionId" type="i" direction="out" />
            <arg name="errorCode" type="i" direction="out" />
            <arg name="config" type="s" direction="in" />
        </method>
        <method name="destroyRecognizer">
            <arg name="sessionId" type="i" direction="in" />
        </method>
        <method name="destroySynthesizer">
            <arg name="sessionId" type="i" direction="in" />
