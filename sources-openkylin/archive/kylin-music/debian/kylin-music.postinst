#!/bin/bash
glib-compile-schemas /usr/share/glib-2.0/schemas

#使用软连接来保证属性一致
dest_filename="/usr/lib/libsimple.so"
source_filename="/usr/lib/kylin-music/libsimple.so"
if [ -e "$dest_filename" ]; then
    # 如果存在这个文件，就删除
    rm "$dest_filename"
fi

if [ -L "$dest_filename" ]; then
    # 如果存在这个文件，就删除
    rm "$dest_filename"
fi

if [ ! -L "$dest_filename" ]; then
    # 如果文件不存在，创建一个软链接
    ln -s "$source_filename" "$dest_filename"
fi
