+void DbusAdapter::setVolume(double d)
+{
+    if (d < 0) {
+        d = 0;
+    } else if (d > 1) {
+        qWarning() << "setVolume error, bigger than 1, volume is :" << d;
+        return;
+    }
+
+    Widget::mutual->setVolume(d*100);
+
