+/**
+ * @brief DbusAdapter::Seek
+ * @param offset 偏移微妙数，正数表示向后，负数表示向前
+ * 如果结果小于0，表示从开始位置播放；如果结果大于媒体时长，表示播放下一曲
+ */
 void DbusAdapter::Seek(const qint64 Offset)
 {
+    qDebug() << "seek :" << Offset;
+    // 如果小于0.1ms就不进行操作
+    if (qAbs(Offset) > 1000*99) {
+        Widget::mutual->Seek(Offset / 1000);
+    }
 
 }
 
