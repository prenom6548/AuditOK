+void DbusAdapter::notify(const QString &changedPropertie, const QStringList &invalidatedProperties)
+{
+    QVariantMap changedProperties;
+
+    QDBusConnection connection = QDBusConnection::sessionBus();
+    QString objectPath = "/org/mpris/MediaPlayer2";
+    QDBusMessage signalMessage= QDBusMessage::createSignal(objectPath,"org.freedesktop.DBus.Properties","PropertiesChanged");
+
+    changedProperties["property"] = changedPropertie;
+    signalMessage << "org.mpris.MediaPlayer2.Player" << changedProperties << invalidatedProperties;
+    connection.send(signalMessage);
+}
+
