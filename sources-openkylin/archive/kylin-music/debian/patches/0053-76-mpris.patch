+}
+
+
+void DbusAdapter::setRate(double d)
+{
+    qDebug() << "setRate:" << d;
+    if (d >= m_minimumRate && d <= m_maximumRate) {
+        Widget::mutual->setPlayRate(d);
+    } else {
+        qWarning() << "dbus set rate error, rate is :" << d;
+    }
+    QStringList changeList { QString::number(d) };
+    notify("Rate", changeList);
+}
