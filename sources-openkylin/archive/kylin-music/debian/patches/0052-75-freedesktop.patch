+
+    bool m_canControl { false };
+    bool getCanControl() { return m_canControl; }
+    void setCanControl(const bool b) { m_canControl = b; }
+
+    void initMetadata();
 public Q_SLOTS:
     // mpris 使用
     void Stop() const;
@@ -21,11 +111,30 @@ public Q_SLOTS:
     void Pause() const;
