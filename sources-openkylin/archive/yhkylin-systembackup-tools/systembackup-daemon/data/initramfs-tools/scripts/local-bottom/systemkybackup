                return 2
        else
                 #echo "系统支持英文"
                return 1
        fi
}

isEnglish
v_isEnglish=$?

myoutput()
{
        #echo "v_isEnglish is "$v_isEnglish

        #echo "first para: $1"
        #echo "second para: $2"

        if [ $v_isEnglish -eq 6 ]; then
                echo $6
                #plymouth message --text=$6
                #echo "蒙语"
		show_message "$6"
        elif [ $v_isEnglish -eq 5 ]; then
                echo $5
                #plymouth message --text=$5
                #echo "藏文"
		show_message "$5"
        elif [ $v_isEnglish -eq 4 ]; then
                echo $4
                #plymouth message --text=$4
                #echo "港文"
		show_message "$4"
        elif [ $v_isEnglish -eq 3 ]; then
                echo $3
                #plymouth message --text=$3
                #echo "越文"
		show_message "$3"
        elif [ $v_isEnglish -eq 2 ]; then
