	OVL_FILE="${rootpath}/sysroot/ostree/deploy/kylin/deploy/${m_system_hash}/sysroot/ostree/pkgs/system-ovl.conf"

	echo "find ${rootpath} -name "system-ovl.conf"" >>$PLOGFILE
	find "${rootpath}" -name "system-ovl.conf" >>$PLOGFILE 2>&1

	if [ -f "$OVL_FILE" ]; then
