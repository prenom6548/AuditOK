		#安装器阶段
		fstabpath=${rootpath}/etc/fstab
        echo $fstabpath
        #获取对应分区得UUID
        Uuid=$(cat ${fstabpath} |grep ${name} |grep UUID |grep -v /boot/efi |awk  -F ' ' '{print $1}' | awk  -F '=' '{print $2}')
        echo $Uuid
        #根据UUID获取对应分区名称
        devName=`ls -l /dev/disk/by-uuid/|grep ${Uuid} | awk  -F '../..' '{print $2}'`
        echo $devName
        devPath=/dev${devName}
        echo $devPath
        #挂载对应分区
        mount ${devPath} ${rootpath}${name}
}


