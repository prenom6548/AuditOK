sub-systembackup-daemon-distdir: FORCE
	@test -d systembackup-daemon/ || mkdir -p systembackup-daemon/
	cd systembackup-daemon/ && ( test -e Makefile || $(QMAKE) -o Makefile /home/soda/桌面/新建文件夹/yhkylin-systembackup-tools/systembackup-daemon/systembackup-daemon.pro 'QMAKE_CFLAGS_RELEASE=-g -O2 -flto=auto -ffat-lto-objects -flto=auto -ffat-lto-objects -fstack-protector-strong -Wformat -Werror=format-security -Wdate-time -D_FORTIFY_SOURCE=2' 'QMAKE_CFLAGS_DEBUG=-g -O2 -flto=auto -ffat-lto-objects -flto=auto -ffat-lto-objects -fstack-protector-strong -Wformat -Werror=format-security -Wdate-time -D_FORTIFY_SOURCE=2' 'QMAKE_CXXFLAGS_RELEASE=-g -O2 -flto=auto -ffat-lto-objects -flto=auto -ffat-lto-objects -fstack-protector-strong -Wformat -Werror=format-security -Wdate-time -D_FORTIFY_SOURCE=2' 'QMAKE_CXXFLAGS_DEBUG=-g -O2 -flto=auto -ffat-lto-objects -flto=auto -ffat-lto-objects -fstack-protector-strong -Wformat -Werror=format-security -Wdate-time -D_FORTIFY_SOURCE=2' 'QMAKE_LFLAGS_RELEASE=-flto=auto -ffat-lto-objects -flto=auto -Wl,-z,relro -Wl,--as-needed' 'QMAKE_LFLAGS_DEBUG=-flto=auto -ffat-lto-objects -flto=auto -Wl,-z,relro -Wl,--as-needed' QMAKE_STRIP=: PREFIX=/usr ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/systembackup-daemon

