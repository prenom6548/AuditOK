<?xml version="1.0" ?>
<node xmlns:tp="http://telepathy.freedesktop.org/wiki/DbusSpec#extensions-v0">
  <interface name="org.mpris.MediaPlayer2.TrackList">
    <method name="GetTracksMetadata" tp:name-for-bindings="Get_Tracks_Metadata">
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QList&lt;QVariantMap&gt;"/>
      <arg direction="in" type="ao" tp:type="Track_Id_List" name="TrackIds">
      </arg>
      <arg direction="out" type="aa{sv}" tp:type="Metadata_Map_List" name="Metadata">
      </arg>
    </method>

    <method name="AddTrack" tp:name-for-bindings="Add_Track">
      <arg direction="in" type="s" tp:type="Uri" name="Uri">
      </arg>
      <arg direction="in" type="o" tp:type="Track_Id" name="AfterTrack">
      </arg>
      <arg direction="in" type="b" name="SetAsCurrent">
      </arg>
    </method>

    <method name="RemoveTrack" tp:name-for-bindings="Remove_Track">
      <arg direction="in" type="o" tp:type="Track_Id" name="TrackId">
      </arg>
    </method>

    <method name="GoTo" tp:name-for-bindings="Go_To">
      <arg direction="in" type="o" tp:type="Track_Id" name="TrackId">
      </arg>
    </method>

    <property name="Tracks" tp:name-for-bindings="Tracks" type="ao" tp:type="Track_Id_List" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <property name="CanEditTracks" tp:name-for-bindings="Can_Edit_Tracks" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <signal name="TrackListReplaced" tp:name-for-bindings="Track_List_Replaced">
      <arg name="Tracks" type="ao" tp:type="Track_Id_List">
      </arg>
      <arg name="CurrentTrack" type="o" tp:type="Track_Id">
      </arg>
    </signal>

    <signal name="TrackAdded" tp:name-for-bindings="Track_Added">
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
      <arg name="Metadata" type="a{sv}" tp:type="Metadata_Map">
      </arg>
      <arg name="AfterTrack" type="o" tp:type="Track_Id">
      </arg>
    </signal>

    <signal name="TrackRemoved" tp:name-for-bindings="Track_Removed">
      <arg name="TrackId" type="o" tp:type="Track_Id">
      </arg>
    </signal>

    <signal name="TrackRemoved" tp:name-for-bindings="Track_Removed">
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg name="TrackId" type="o" tp:type="Track_Id">
      </arg>
      <arg name="Metadata" type="a{sv}" tp:type="Metadata_Map">
      </arg>
    </signal>
  </interface>
</node>
<!-- vim:set sw=2 sts=2 et ft=xml: -->