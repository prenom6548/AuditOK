<?xml version="1.0" ?>
<node xmlns:tp="http://telepathy.freedesktop.org/wiki/DbusSpec#extensions-v0">
  <interface name="org.mpris.MediaPlayer2.Playlists">
    <method name="ActivatePlaylist" tp:name-for-bindings="Activate_Playlist">
      <arg direction="in" type="o" name="PlaylistId">
      </arg>
    </method>

    <method name="GetPlaylists" tp:name-for-bindings="Get_Playlists">
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QList&gt;PlaylistInfo&lt;"/>
      <arg direction="in" type="u" name="Index">
      </arg>
      <arg direction="in" type="u" name="MaxCount">
      </arg>
      <arg direction="in" type="s" tp:type="Playlist_Ordering" name="Order">
      </arg>
      <arg direction="in" type="b" name="ReverseOrder">
      </arg>
      <arg direction="out" type="a(oss)" tp:type="Playlist_List" name="Playlists">
      </arg>
    </method>

    <property name="PlaylistCount" tp:name-for-bindings="Playlist_Count" type="u" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <property name="Orderings" tp:name-for-bindings="Orderings" type="as" tp:type="Playlist_Ordering_List" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <property name="ActivePlaylist" tp:name-for-bindings="Active_Playlist" type="(b(oss))" tp:type="Maybe_Playlist" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="ActivePlaylistInfo"/>
    </property>

    <signal name="PlaylistChanged" tp:name-for-bindings="Playlist_Changed">
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="PlaylistInfo"/>
      <arg name="Playlist" type="(oss)" tp:type="Playlist">
      </arg>
    </signal>
  </interface>
</node>
<!-- vim:set sw=2 sts=2 et ft=xml: -->