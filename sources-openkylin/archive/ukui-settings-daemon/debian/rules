#!/usr/bin/make -f
export QT_SELECT=5
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_clean:
	dh_auto_clean
	rm -rf build
	rm -f *.pro.user
	find . -name "Makefile" -delete
	find . -name "*.o" -delete
	find . -name "*.so" -delete
	find . -name "moc_*" -delete
	find . -name "*.moc" -delete
	find . -name "qrc_*" -delete



