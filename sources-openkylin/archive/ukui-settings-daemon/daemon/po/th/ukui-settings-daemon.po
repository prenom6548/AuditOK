msgstr "ปิดตัวลง"

#: ../data/org.ukui.SettingsDaemon.plugins.media-keys.gschema.xml.in.h:18
msgid "Binding to shut down."
msgstr "การผูกมัดเพื่อปิดระบบ"

#: ../data/org.ukui.SettingsDaemon.plugins.media-keys.gschema.xml.in.h:19
