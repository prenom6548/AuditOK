#: ../data/org.ukui.SettingsDaemon.plugins.media-keys.gschema.xml.in.h:49
msgid "Previous track"
msgstr "แทร็กก่อนหน้า"

#: ../data/org.ukui.SettingsDaemon.plugins.media-keys.gschema.xml.in.h:50
