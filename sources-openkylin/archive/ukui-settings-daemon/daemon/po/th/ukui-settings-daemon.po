#: ../data/org.ukui.SettingsDaemon.plugins.media-keys.gschema.xml.in.h:59
msgid "Terminal"
msgstr "เทอร์มินัล"

#: ../data/org.ukui.SettingsDaemon.plugins.media-keys.gschema.xml.in.h:60
