#!/bin/bash

# Usage: bioctl status|enable|disable

if [ "$1" = "enable" ]; then
	pkexec /usr/bin/bioctl-helper enable $2
elif [ "$1" = "disable" ]; then
	pkexec /usr/bin/bioctl-helper disable $2
elif [ "$1" = "status" ]; then
	/usr/bin/bioctl-helper status $2 
else
	echo "Usage: bioctl status|enable|disable"
fi

exit 0
