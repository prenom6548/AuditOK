#!/bin/sh
set -e

PKG="kylin-wget"
TARGET="/usr/bin/wget"

case "$1" in
  install|upgrade|reinstall)
    if [ -e "$TARGET" ] || [ -L "$TARGET" ]; then
      dpkg-divert --add --rename --package "$PKG" "$TARGET" || true
    else
      dpkg-divert --add --package "$PKG" "$TARGET" || true
    fi
    ;;
esac

exit 0

