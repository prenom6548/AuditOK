@@ -0,0 +1,77 @@
+import QtQuick 2.0
+import QtQuick.Controls 2.15
+import org.username 1.0
+
+// Accessibility text
+Rectangle {
+    id: interactionText
+    width: 900;
+    height: 235
+
+    ProcessManager {
+        id: processmanager
+                Component.onCompleted: {
+            console.log("ProcessManager åˆå§‹åŒ–å®Œæˆ")
+            updateTextColor()
+        }
+    }
+
+    // æ ¹æ®ä¸»é¢˜æ›´æ–°æ–‡æœ¬é¢œè‰²çš„å‡½æ•°
+    function updateTextColor() {
+        var themeStyle = processmanager.getThemeStyle()
+        console.log("å½“å‰ä¸»é¢˜æ ·å¼:", themeStyle)
+        var isDarkTheme = (themeStyle === "ukui-black" || themeStyle === "ukui-dark")
+            var textColor = isDarkTheme ? "white" : "black"
+        centerText.color = textColor
+        bottomText.color = textColor
+
+        console.log("å­—ä½“é¢œè‰²è®¾ç½®ä¸º:", textColor, "æ˜¯å¦ä¸ºæ·±è‰²ä¸»é¢˜:", isDarkTheme)
+    }
+
+    Text {
+        id: centerText
+        width: parent.width
+        x:80
+
+        text: qsTr("Lightweight vision Â· Breathing experience")
+        font.bold: true
+        wrapMode: Text.WordWrap
+        font.pixelSize: 20
+        //ä¸‹æ–¹çš„label
+        Text {
+            id: bottomText
+            x:0
+            y:6+centerText.height
+            width: 900
+            text: qsTr("46 silky sliding effects and millimeter-level interactive aesthetics.")
+            elide: Text.ElideRight  // è¶…å‡ºå®½åº¦æ˜¾ç¤º...
+            clip: true  // è£å‰ªè¶…å‡ºéƒ¨åˆ†
+            maximumLineCount: 1  // é™åˆ¶ä¸ºå•è¡Œ
+            font.pixelSize: 16
+            // æ·»åŠ æ‚¬æµ®æç¤º
+            ToolTip.visible: maBottom.containsMouse && truncated
+            ToolTip.text: text
+            MouseArea {
+                id: maBottom
+                anchors.fill: parent
+                hoverEnabled: true
+            }
+        }
+        anchors.centerIn: parent
+    }
+
+    Connections {
+        target: processmanager
+                onStyleNameChanged: function(message) {
+            updateTextColor()
+        }
+    }
+
+    Component.onCompleted: {
+        Qt.callLater(function() {
+            if (processmanager) {
+                updateTextColor()
+            }
+        })
+    }
+}
