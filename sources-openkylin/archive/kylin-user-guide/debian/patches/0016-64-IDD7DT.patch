+
+	//------------------------------------------------------------------------------
+	template <class T>
+	void
+	generic_add_entry( Elf64_Addr offset, Elf_Xword info, Elf_Sxword addend )
+	{
+		const endianess_convertor& convertor = elf_file.get_convertor();
+
