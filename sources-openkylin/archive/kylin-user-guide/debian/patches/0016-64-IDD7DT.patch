+
+class QtLocalPeer;
+
+#  define QT_QTSINGLEAPPLICATION_EXPORT
+
+
+class QT_QTSINGLEAPPLICATION_EXPORT QtSingleApplication : public QApplication
+{
+    Q_OBJECT
