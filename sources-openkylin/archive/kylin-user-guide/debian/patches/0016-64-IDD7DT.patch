+		entry.r_offset = offset;
+		entry.r_info   = info;
+		entry.r_offset = convertor( entry.r_offset );
+		entry.r_info   = convertor( entry.r_info );
+
+		relocation_section->append_data( reinterpret_cast<char*>( &entry ),
+										 sizeof( entry ) );
