#!/usr/bin/env bash
# This test checks that the sudoers of sudo-common file is
# correctly configured.
set -euo pipefail

export LC_ALL=C

sudo_rs_visudo="/usr/lib/cargo/bin/visudo"
echo "Checking sudoers configuration using ${sudo_rs_visudo}"
"$sudo_rs_visudo" -c

ogsudo_visudo="/usr/sbin/visudo.ws"
echo "Checking sudoers configuration using ${ogsudo_visudo}"
"$ogsudo_visudo" -c
