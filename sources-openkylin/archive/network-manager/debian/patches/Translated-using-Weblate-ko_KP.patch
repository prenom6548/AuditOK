 #: src/nmcli/nmcli.c:243
 msgid ""
@@ -11777,76 +13226,102 @@ msgid ""
 "  m[onitor]       monitor NetworkManager changes\n"
 "\n"
 msgstr ""
+"사용법: nmcli [옵션] 대상 { 명령 | 도움말 }\n"
+"\n"
+"옵션\n"
+"  -a, --ask                                누락된 매개변수 묻기\n"
+"  -c, --colors auto|yes|no                 출력에서 색상 사용 여부\n"
+"  -e, --escape yes|no                      값의 열 구분자 이스케이프\n"
+"  -f, --fields <필드,...>|all|common      출력할 필드 지정\n"
+"  -g, --get-values <필드,...>|all|common  -m 표 형식 -t -f의 단축\n"
+"  -h, --help                               이 도움말 인쇄\n"
+"  -m, --mode tabular|multiline             출력 모드\n"
+"  -o, --overview                           개요 모드\n"
+"  -p, --pretty                             보기 좋게 출력\n"
+"  -s, --show-secrets                       비밀번호 표시 허용\n"
+"  -t, --terse                              간략한 출력\n"
+"  -v, --version                            프로그람 버전 보기\n"
+"  -w, --wait <초>                     작업 완료 대기 시간 설정\n"
+"\n"
