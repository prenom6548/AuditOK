+#: src/core/devices/wifi/nm-wifi-utils.c:68
+msgid "LEAP authentication requires a LEAP username"
+msgstr "مصادقة LEAP تتطلب اسم مستخدم LEAP"
+
+#: src/core/devices/wifi/nm-wifi-utils.c:80
