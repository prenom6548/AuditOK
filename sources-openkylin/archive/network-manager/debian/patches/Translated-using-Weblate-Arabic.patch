+#: src/libnmc-setting/nm-meta-setting-desc.c:4718
+msgid ""
+"nmcli can accepts both direct JSON configuration data and a file name "
+"containing the configuration. In the latter case the file is read and the "
+"contents is put into this property.\n"
+"\n"
+"Examples: set team.config { \"device\": \"team0\", \"runner\": {\"name\": "
+"\"roundrobin\"}, \"ports\": {\"eth1\": {}, \"eth2\": {}} }\n"
+"          set team.config /etc/my-team.conf\n"
+msgstr ""
+"يقبل nmcli بيانات تكوين JSON مباشرةً واسم الملف الذي يحتوي على هذا التكوين. "
+"في الحالة الأخيرة، تتم قراءة الملف ووضع محتواه في هذه الخاصية.\n"
+"\n"
+"على سبيل المثال: set team.config { \"device\": \"team0\", \"runner\": {\"name"
+"\": \"roundrobin\"}, \"ports\": {\"eth1\": {}, \"eth2\": {}} }\n"
+"          set team.config /etc/my-team.conf\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:4726
+msgid ""
+"Enter a list of link watchers formatted as dictionaries where the keys are "
+"teamd properties. Dictionary pairs are in the form: key=value and pairs are "
+"separated by ' '. Dictionaries are separated with ','.\n"
+"The keys allowed/required in the dictionary change on the basis of the link "
+"watcher type, while the only property common to all the link watchers is  "
+"'name'*, which defines the link watcher to be specified.\n"
+"\n"
+"Properties available for the 'ethtool' link watcher:\n"
+"  'delay-up', 'delay-down'\n"
+"\n"
+"Properties available for the 'nsna_ping' link watcher:\n"
+"  'init-wait', 'interval', 'missed-max', 'target-host'*\n"
+"\n"
+"Properties available for the 'arp_ping' include all the ones for 'nsna_ping' "
+"and:\n"
+"  'source-host'*, 'validate-active', 'validate-inactive', 'send-always'.\n"
+"\n"
+"Properties flagged with a '*' are mandatory.\n"
+"\n"
+"Example:\n"
+"   name=arp_ping source-host=172.16.1.1 target-host=172.16.1.254, "
+"name=ethtool delay-up=3\n"
+msgstr ""
+"أدخل قائمة مراقبي الروابط، بتنسيق قاموس تكون فيه أزواج المفاتيح والقيم هي "
+"سمات teamd. يكون شكل أزواج القاموس: مفتاح=قيمة، وتفصل المسافة \" \" بين "
+"أزواج القاموس. وتفصل الفاصلة \",\" بين القواميس.\n"
+"تتغير المفاتيح المسموح بها أو المطلوبة في القاموس وفقًا لنوع مراقب الرابط، "
+"والسمة المشتركة الوحيدة لجميع مراقبي الروابط هي \"name\"*، والتي تحدد مراقب "
+"الرابط المعين.\n"
+"\n"
+"السمات المنطبقة على مراقب الرابط \"ethtool\" هي:\n"
+"  \"delay-up\"، \"delay-down\"\n"
+"\n"
+"السمات المنطبقة على مراقب الرابط \"nsna_ping\" هي:\n"
+"  \"init-wait\"، \"interval\"، \"missed-max\"، \"target-host\"*\n"
+"\n"
+"السمات المنطبقة على مراقب الرابط \"arp_ping\" بالإضافة إلى جميع السمات تحت "
+"\"nsna_ping\" هي:\n"
+"  \"source-host\"*، \"validate-active\"، \"validate-inactive\"، \"send-"
+"always\".\n"
+"\n"
+"السمات المميزة بعلامة \"*\" إلزامية.\n"
+"\n"
+"مثال:\n"
+"   name=arp_ping source-host=172.16.1.1 target-host=172.16.1.254, "
+"name=ethtool delay-up=3\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:4775
+msgid "IEEE 802.15.4 (WPAN) parent device or connection UUID"
+msgstr "UUID للجهاز الأصلي أو الاتصال لـ IEEE 802.15.4 (WPAN)"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:4811
+msgid ""
+"Enter file path to CA certificate (optionally prefixed with file://).\n"
+"  [file://]<file path>\n"
+"Note that nmcli does not support specifying certificates as raw blob data.\n"
+"Example: /home/cimrman/cacert.crt\n"
+msgstr ""
+"أدخل مسار الملف لشهادة CA (مع بادئة اختيارية file://).\n"
+"  [file://]<مسار الملف>\n"
+"يرجى ملاحظة أن nmcli لا يدعم تحديد الشهادة كبيانات كتلة بت خام (blob).\n"
+"مثال: /home/cimrman/cacert.crt\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:4853
+msgid ""
+"Enter file path to client certificate (optionally prefixed with file://).\n"
+"  [file://]<file path>\n"
+"Note that nmcli does not support specifying certificates as raw blob data.\n"
+"Example: /home/cimrman/jara.crt\n"
+msgstr ""
+"أدخل مسار الملف لشهادة العميل (مع بادئة اختيارية file://).\n"
+"  [file://]<مسار الملف>\n"
+"يرجى ملاحظة أن nmcli لا يدعم تحديد الشهادة كبيانات كتلة بت خام (blob).\n"
+"مثال: /home/cimrman/jara.crt\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:4910
+msgid ""
+"Enter file path to CA certificate for inner authentication (optionally "
+"prefixed\n"
+"with file://).\n"
+"  [file://]<file path>\n"
+"Note that nmcli does not support specifying certificates as raw blob data.\n"
+"Example: /home/cimrman/ca-zweite-phase.crt\n"
+msgstr ""
+"أدخل مسار الملف لشهادة CA للمصادقة الداخلية (مع بادئة اختيارية file://).\n"
+"  [file://]<مسار الملف>\n"
+"يرجى ملاحظة أن nmcli لا يدعم تحديد الشهادة كبيانات كتلة بت خام (blob).\n"
+"مثال: /home/cimrman/ca-zweite-phase.crt\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:4953
+msgid ""
+"Enter file path to client certificate for inner authentication (optionally "
+"prefixed\n"
+"with file://).\n"
+"  [file://]<file path>\n"
+"Note that nmcli does not support specifying certificates as raw blob data.\n"
+"Example: /home/cimrman/jara-zweite-phase.crt\n"
+msgstr ""
+"أدخل مسار الملف لشهادة العميل للمصادقة الداخلية (مع بادئة اختيارية file://)."
+"\n"
+"  [file://]<مسار الملف>\n"
+"يرجى ملاحظة أن nmcli لا يدعم تحديد الشهادة كبيانات كتلة بت خام (blob).\n"
+"مثال: /home/cimrman/jara-zweite-phase.crt\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:4980
+msgid ""
+"Enter bytes as a list of hexadecimal values.\n"
+"Two formats are accepted:\n"
+"(a) a string of hexadecimal digits, where each two digits represent one "
+"byte\n"
+"(b) space-separated list of bytes written as hexadecimal digits (with "
+"optional 0x/0X prefix, and optional leading 0).\n"
+"\n"
+"Examples: ab0455a6ea3a74C2\n"
+"          ab 4 55 0xa6 ea 3a 74 C2\n"
+msgstr ""
+"أدخل قائمة القيم السداسية العشرية.\n"
+"يمكن استخدام تنسيقين:\n"
+"(أ) سلسلة من الأرقام السداسية العشرية، حيث يمثل كل رقمين بايت واحد.\n"
+"(ب) بايتات مكتوبة بأرقام سداسية عشرية مفصولة بمسافات (مع خيار البادئة 0x/0X "
+"وبداية اختيارية بـ 0).\n"
+"\n"
+"على سبيل المثال: ab0455a6ea3a74C2\n"
+"      ab 4 55 0xa6 ea 3a 74 C2\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:4997
+#: src/libnmc-setting/nm-meta-setting-desc.c:5015
+msgid ""
+"Enter path to a private key and the key password (if not set yet):\n"
+"  [file://]<file path> [<password>]\n"
+"Note that nmcli does not support specifying private key as raw blob data.\n"
+"Example: /home/cimrman/jara-priv-key Dardanely\n"
+msgstr ""
+"أدخل مسار المفتاح الخاص وكلمة مرور المفتاح (إذا لم يتم تعيينها بعد):\n"
+"  [file://]<مسار الملف> [<كلمة المرور>]\n"
+"يرجى ملاحظة أن nmcli لا يدعم تحديد المفتاح الخاص كبيانات كتلة بت خام (blob)."
+"\n"
+"مثال: /home/cimrman/jara-priv-key Dardanely\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5060
+#: src/libnmc-setting/nm-meta-setting-desc.c:5356
+#: src/libnmc-setting/nm-meta-setting-desc.c:5843
+#: src/libnmc-setting/nm-meta-setting-desc.c:6899
+msgid "Password [none]"
+msgstr "كلمة المرور [بلا]"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5106
+msgid "Bluetooth device address"
+msgstr "عنوان جهاز البلوتوث"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5154
+#: src/nmtui/nmt-page-bond-port.c:51
+msgid "Queue ID"
+msgstr "معرف قائمة الانتظار"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5166
+#: src/libnmc-setting/nm-meta-setting-desc.c:5917
+#: src/libnmc-setting/nm-meta-setting-desc.c:7619
+#: src/libnmc-setting/nm-meta-setting-desc.c:7657
+#: src/libnmc-setting/nm-meta-setting-desc.c:7842
+#: src/libnmc-setting/nm-meta-setting-desc.c:8075
+msgid "MAC [none]"
+msgstr "MAC [بلا]"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5172
+msgid "Enable STP"
+msgstr "تمكين STP"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5178
+msgid "STP priority"
+msgstr "أولوية STP"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5184
+#: src/nmtui/nmt-page-bridge.c:120
+msgid "Forward delay"
+msgstr "تأخير إعادة التوجيه"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5190
+#: src/nmtui/nmt-page-bridge.c:134
+msgid "Hello time"
+msgstr "وقت الترحيب"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5196
+#: src/nmtui/nmt-page-bridge.c:148
+msgid "Max age"
+msgstr "الحد الأقصى للعمر"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5202
+msgid "MAC address ageing time"
+msgstr "وقت تقادم عنوان MAC"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5212
+#: src/nmtui/nmt-page-bridge.c:156
+msgid "Group forward mask"
+msgstr "قناع إعادة توجيه المجموعة"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5254
+#: src/nmtui/nmt-page-bridge.c:79
+msgid "Enable IGMP snooping"
+msgstr "تمكين التنصت على IGMP"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5312
+msgid "Bridge port priority"
+msgstr "أولوية منفذ الجسر"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5318
+msgid "Bridge port STP path cost"
+msgstr "تكلفة مسار STP لمنفذ الجسر"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5324
+msgid "Hairpin"
+msgstr "مشبك الشعر"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5350
+#: src/libnmc-setting/nm-meta-setting-desc.c:5837
+#: src/libnmc-setting/nm-meta-setting-desc.c:7466
+msgid "Username [none]"
+msgstr "اسم المستخدم [بلا]"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5452
+msgid ""
+"Enter a list of user permissions. This is a list of user names formatted "
+"as:\n"
+"  [user:]<user name 1>, [user:]<user name 2>,...\n"
+"The items can be separated by commas or spaces.\n"
+"\n"
+"Example: alice bob charlie\n"
+msgstr ""
+"أدخل قائمة أذونات المستخدمين. تنسيق أسماء المستخدمين في هذه القائمة هو:\n"
+"  [user:]<اسم المستخدم 1>، [user:]<اسم المستخدم 2>،... \n"
+"استخدم الفاصلة أو المسافة للفصل بين الأسماء.\n"
+"\n"
+"مثال: alice bob charlie\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5505
+msgid ""
+"Enter secondary connections that should be activated when this connection "
+"is\n"
+"activated. Connections can be specified either by UUID or ID (name). nmcli\n"
+"transparently translates names to UUIDs. Note that NetworkManager only "
+"supports\n"
+"VPNs as secondary connections at the moment.\n"
+"The items can be separated by commas or spaces.\n"
+"\n"
+"Example: private-openvpn, fe6ba5d8-c2fc-4aae-b2e3-97efddd8d9a7\n"
+msgstr ""
+"أدخل الاتصالات الثانوية التي يجب تفعيلها عند تفعيل هذا الاتصال. يمكن تحديد "
+"الاتصالات باستخدام UUID أو المعرف (الاسم). يقوم nmcli\n"
+"تلقائيًا بتحويل الأسماء إلى UUID. يرجى ملاحظة أن مدير الشبكة (NetworkManager)"
+" يدعم حاليًا فقط VPN كاتصالات ثانوية.\n"
+"يمكن فصل هذه المدخلات بفاصلة أو مسافة.\n"
+"\n"
+"مثال: private-openvpn, fe6ba5d8-c2fc-4aae-b2e3-97efddd8d9a7\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5528
+msgid ""
+"Enter a value which indicates whether the connection is subject to a data\n"
+"quota, usage costs or other limitations. Accepted options are:\n"
+"'true','yes','on' to set the connection as metered\n"
+"'false','no','off' to set the connection as not metered\n"
+"'unknown' to let NetworkManager choose a value using some heuristics\n"
+msgstr ""
+"تشير القيمة المدخلة إلى ما إذا كان الاتصال يحتوي على حصة بيانات أو تكلفة "
+"استخدام أو قيود أخرى.\n"
+"الخيارات المقبولة هي:\n"
+"\"true\"، \"yes\"، \"on\"، لتعيين الاتصال على أنه يُحسب ضمن حجم البيانات\n"
+"\"false\"، \"no\"، \"off\"، لتعيين الاتصال على أنه لا يُحسب ضمن حجم "
+"البيانات\n"
+"\"unknown\"، للسماح لمدير الشبكة (NetworkManager) باستخدام بعض الخوارزميات "
+"الإرشادية لاختيار القيمة\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5853
+msgid "APN"
+msgstr ""
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5926
+#: src/libnmc-setting/nm-meta-setting-desc.c:7688
+#: src/libnmc-setting/nm-meta-setting-desc.c:7882
+#: src/nmtui/nmt-page-ethernet.c:72 src/nmtui/nmt-page-infiniband.c:81
+#: src/nmtui/nmt-page-ip-tunnel.c:178 src/nmtui/nmt-page-vlan.c:100
+#: src/nmtui/nmt-page-wifi.c:380 src/nmtui/nmt-page-wireguard.c:85
+msgid "MTU"
+msgstr ""
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5945
+msgid "P_KEY [none]"
+msgstr "P_KEY [بلا]"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5954
+msgid "Parent interface [none]"
+msgstr "الواجهة العليا [بلا]"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:5981
+msgid ""
+"Enter a list of IPv4 addresses of DNS servers.\n"
+"\n"
+"Example: 8.8.8.8, 8.8.4.4\n"
+msgstr ""
+"أدخل قائمة عناوين IPv4 لخوادم DNS.\n"
+"\n"
+"مثال: 8.8.8.8, 8.8.4.4\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6029
+msgid "IPv4 address (IP[/plen]) [none]"
+msgstr "عنوان IPv4 (IP[/plen]) [بلا]"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6031
+msgid ""
+"Enter a list of IPv4 addresses formatted as:\n"
+"  ip[/prefix], ip[/prefix],...\n"
+"Missing prefix is regarded as prefix of 32.\n"
+"\n"
+"Example: 192.168.1.5/24, 10.0.0.11/24\n"
+msgstr ""
+"أدخل قائمة عناوين IPv4 بالتنسيق:\n"
+"  ip[/prefix]، ip[/prefix]،...\n"
+"إذا كانت البادئة مفقودة، فسيكون الافتراضي 32.\n"
+"\n"
+"مثال: 192.168.1.5/24, 10.0.0.11/24\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6050
+msgid "IPv4 gateway [none]"
+msgstr "بوابة IPv4 [بلا]"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6058
+msgid ""
+"Enter a list of IPv4 routes formatted as:\n"
+"  ip[/prefix] [next-hop] [metric],...\n"
+"\n"
+"Missing prefix is regarded as a prefix of 32.\n"
+"Missing next-hop is regarded as 0.0.0.0.\n"
+"Missing metric means default (NM/kernel will set a default value).\n"
+"\n"
+"Examples: 192.168.2.0/24 192.168.2.1 3, 10.1.0.0/16 10.0.0.254\n"
+"          10.1.2.0/24\n"
+msgstr ""
+"أدخل قائمة مسارات IPv4 بالتنسيق التالي:\n"
+"  ip[/prefix] [next-hop] [metric],...\n"
+"إذا لم يتم تحديد البادئة، فسيكون الافتراضي 32.\n"
+"إذا لم يتم تحديد next-hop، فسيكون الافتراضي 0.0.0.0.\n"
+"إذا لم يتم تحديد عدد القفزات، فسيتم استخدام القيمة الافتراضية (سيقوم NM/"
+"kernel بتعيين القيمة الافتراضية).\n"
+"\n"
+"مثال: 192.168.2.0/24 192.168.2.1 3, 10.1.0.0/16 10.0.0.254\n"
+"      10.1.2.0/24\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6098
+msgid ""
+"Enter a list of IPv4 routing rules formatted as:\n"
+"  priority [prio] [from [src]] [to [dst]], ,...\n"
+"\n"
+msgstr ""
+"أدخل مجموعة من قواعد توجيه IPv4 بالتنسيق التالي:\n"
+"  priority [prio] [from [src]] [to [dst]], ,...\n"
+"\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6228
+msgid ""
+"Enter a list of IPv6 addresses of DNS servers.  If the IPv6 configuration "
+"method is 'auto' these DNS servers are appended to those (if any) returned "
+"by automatic configuration.  DNS servers cannot be used with the 'shared' or "
+"'link-local' IPv6 configuration methods, as there is no upstream network. In "
+"all other IPv6 configuration methods, these DNS servers are used as the only "
+"DNS servers for this connection.\n"
+"\n"
+"Example: 2607:f0d0:1002:51::4, 2607:f0d0:1002:51::1\n"
+msgstr ""
+"أدخل قائمة عناوين IPv6 لخوادم DNS. إذا كانت طريقة تكوين IPv6 هي \"auto\"، "
+"فسيتم إلحاق خوادم DNS هذه بالعناوين التي يتم إرجاعها من التكوين التلقائي (إن "
+"وجدت). لا يمكن استخدام خوادم DNS مع طرق تكوين IPv6 \"shared\" أو \"link-"
+"local\"، لأنها ليست شبكات منحدرية. في جميع طرق تكوين IPv6 الأخرى، يمكن أن "
+"تعمل خوادم DNS هذه كخوادم DNS الوحيدة لهذا الاتصال.\n"
+"\n"
+"مثال: 2607:f0d0:1002:51::4, 2607:f0d0:1002:51::1\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6282
+msgid "IPv6 address (IP[/plen]) [none]"
+msgstr "عنوان IPv6 (IP[/plen]) [بلا]"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6284
+msgid ""
+"Enter a list of IPv6 addresses formatted as:\n"
+"  ip[/prefix], ip[/prefix],...\n"
+"Missing prefix is regarded as prefix of 128.\n"
+"\n"
+"Example: 2607:f0d0:1002:51::4/64, 1050:0:0:0:5:600:300c:326b\n"
+msgstr ""
+"أدخل قائمة عناوين IPv6 بالتنسيق التالي:\n"
+"  ip[/prefix], ip[/prefix],...\n"
+"إذا لم يتم تحديد البادئة، فسيكون الافتراضي 128.\n"
+"\n"
+"مثال: 2607:f0d0:1002:51::4/64, 1050:0:0:0:5:600:300c:326b\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6303
+msgid "IPv6 gateway [none]"
+msgstr "بوابة IPv6 [بلا]"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6311
+msgid ""
+"Enter a list of IPv6 routes formatted as:\n"
+"  ip[/prefix] [next-hop] [metric],...\n"
+"\n"
+"Missing prefix is regarded as a prefix of 128.\n"
+"Missing next-hop is regarded as \"::\".\n"
+"Missing metric means default (NM/kernel will set a default value).\n"
+"\n"
+"Examples: 2001:db8:beef:2::/64 2001:db8:beef::2, 2001:db8:beef:3::/64 2001:"
+"db8:beef::3 2\n"
+"          abbe::/64 55\n"
+msgstr ""
+"أدخل قائمة مسارات IPv6 بالتنسيق التالي:\n"
+"  ip[/prefix] [next-hop] [metric],...\n"
+"إذا لم يتم تحديد البادئة، فسيكون الافتراضي 128.\n"
+"إذا لم يتم تحديد next-hop، فسيكون الافتراضي \"::\".\n"
+"إذا لم يتم تحديد عدد القفزات، فسيتم استخدام القيمة الافتراضية (سيقوم NM/"
+"kernel بتعيين القيمة الافتراضية).\n"
+"\n"
+"مثال: 2001:db8:beef:2::/64 2001:db8:beef::2, 2001:db8:beef:3::/64 "
+"2001:db8:beef::3 2\n"
+"      abbe::/64 55\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6351
+msgid ""
+"Enter a list of IPv6 routing rules formatted as:\n"
+"  priority [prio] [from [src]] [to [dst]], ,...\n"
+"\n"
+msgstr ""
+"أدخل مجموعة من قواعد توجيه IPv6 بالتنسيق التالي:\n"
+"  priority [prio] [from [src]] [to [dst]], ,...\n"
+"\n"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6479
+#: src/libnmc-setting/nm-meta-setting-desc.c:7519
+msgid "Parent device [none]"
+msgstr "الجهاز الأصلي [بلا]"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6485
+msgid "Local endpoint [none]"
+msgstr "نقطة النهاية المحلية [بلا]"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6492
+#: src/libnmc-setting/nm-meta-setting-desc.c:7538
+msgid "Remote"
+msgstr "بعيد"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6537
+msgid "MACsec parent device or connection UUID"
+msgstr "الجهاز الأصلي لـ MACsec أو UUID الاتصال"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6558
+msgid "Enable encryption"
+msgstr "تمكين التشفير"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6574
+msgid "MKA_CKN"
+msgstr ""
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6580
+msgid "SCI port"
+msgstr "منفذ SCI"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6606
+msgid "MACVLAN parent device or connection UUID"
+msgstr "الجهاز الأصلي لـ MACVLAN أو UUID الاتصال"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6627
+msgid "Tap"
+msgstr "واجهة Tap"
+
+#: src/libnmc-setting/nm-meta-setting-desc.c:6694
+#: src/libnmc-setting/nm-meta-setting-desc.c:7796 src/nmtui/nmt-page-wifi.c:200
+msgid "SSID"
+msgstr ""
