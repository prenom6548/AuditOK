+#: src/nmcli/general.c:302
+msgid ""
+"Usage: nmcli general { COMMAND | help }\n"
+"\n"
+"COMMAND := { status | hostname | permissions | logging | reload }\n"
+"\n"
+"  status\n"
+"\n"
+"  hostname [<hostname>]\n"
+"\n"
+"  permissions\n"
+"\n"
+"  logging [level <log level>] [domains <log domains>]\n"
+"\n"
+"  reload [<flags>]\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli general { COMMAND | help }\n"
+"\n"
+"COMMAND := { status | hostname | permissions | logging | reload }\n"
+"\n"
+"  status\n"
+"\n"
+"  hostname [<hostname>]\n"
+"\n"
+"  permissions\n"
+"\n"
+"  logging [level <log level>] [domains <log domains>]\n"
+"\n"
+"  reload [<flags>]\n"
+"\n"
+
+#: src/nmcli/general.c:315
+msgid ""
+"Usage: nmcli general status { help }\n"
+"\n"
+"Show overall status of NetworkManager.\n"
+"'status' is the default action, which means 'nmcli gen' calls 'nmcli gen "
+"status'\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli general status { help }\n"
+"\n"
+"يعرض الحالة العامة لمدير الشبكة (NetworkManager).\n"
+"\"status\" هو الإجراء الافتراضي، أي أن \"nmcli gen\" يستدعي \"nmcli gen "
+"status\"\n"
+"\n"
+
+#: src/nmcli/general.c:325
+msgid ""
+"Usage: nmcli general hostname { ARGUMENTS | help }\n"
+"\n"
+"ARGUMENTS := [<hostname>]\n"
+"\n"
+"Get or change persistent system hostname.\n"
+"With no arguments, this prints currently configured hostname. When you pass\n"
+"a hostname, NetworkManager will set it as the new persistent system "
+"hostname.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli general hostname { المعاملات | help }\n"
+"\n"
+"المعاملات := [<hostname>]\n"
+"\n"
+"الحصول على اسم المضيف الدائم للنظام أو تغييره.\n"
+"إذا لم يتم تقديم أي معاملات، فسيتم عرض اسم المضيف المُكوّن حاليًا. عند تقديم "
+"اسم مضيف، سيقوم مدير الشبكة (NetworkManager) بتعيينه\n"
+"كاسم مضيف دائم جديد للنظام.\n"
+"\n"
+
+#: src/nmcli/general.c:337
+msgid ""
+"Usage: nmcli general permissions { help }\n"
+"\n"
+"Show caller permissions for authenticated operations.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli general permissions { help }\n"
+"\n"
+"يعرض أذونات البرنامج المستدعي لعمليات المصادقة.\n"
+"\n"
+
+#: src/nmcli/general.c:345
+msgid ""
+"Usage: nmcli general reload { ARGUMENTS | help }\n"
+"\n"
+"ARGUMENTS := [<flag>[,<flag>...]]\n"
+"\n"
+"Reload NetworkManager's configuration and perform certain updates, like\n"
+"flushing caches or rewriting external state to disk. This is similar to\n"
+"sending SIGHUP to NetworkManager but it allows for more fine-grained\n"
+"control over what to reload through the flags argument. It also allows\n"
+"non-root access via PolicyKit and contrary to signals it is synchronous.\n"
+"\n"
+"Available flags are:\n"
+"\n"
+"  'conf'        Reload the NetworkManager.conf configuration from\n"
+"                disk. Note that this does not include connections, which\n"
+"                can be reloaded through 'nmcli connection reload' instead.\n"
+"\n"
+"  'dns-rc'      Update DNS configuration, which usually involves writing\n"
+"                /etc/resolv.conf anew. This is equivalent to sending the\n"
+"                SIGUSR1 signal to the NetworkManager process.\n"
+"\n"
+"  'dns-full'    Restart the DNS plugin. This is for example useful when\n"
+"                using dnsmasq plugin, which uses additional configuration\n"
+"                in /etc/NetworkManager/dnsmasq.d. If you edit those files,\n"
+"                you can restart the DNS plugin. This action shortly\n"
+"                interrupts name resolution.\n"
+"\n"
+"With no flags, everything that is supported is reloaded, which is\n"
+"identical to sending a SIGHUP.\n"
+msgstr ""
+"الاستخدام: nmcli general reload { ARGUMENTS | help }\n"
+"\n"
+"ARGUMENTS := [<flag>[,<flag>...]]\n"
+"\n"
+"إعادة تحميل تكوين NetworkManager وإجراء تحديثات معينة، مثل\n"
+"تفريغ ذاكرات التخزين المؤقت أو إعادة كتابة الحالة الخارجية إلى القرص. هذا "
+"مشابه لـ\n"
+"إرسال SIGHUP إلى NetworkManager ولكنه يسمح بتحكم أكثر دقة\n"
+"فيما يجب إعادة تحميله من خلال وسيطة العلامات. كما يسمح أيضًا\n"
+"بالوصول من غير الجذر عبر PolicyKit وعلى عكس الإشارات فهو متزامن.\n"
+"\n"
+"العلامات المتاحة هي:\n"
+"\n"
+"  'conf'        إعادة تحميل تكوين NetworkManager.conf من\n"
+"                القرص. لاحظ أن هذا لا يتضمن الاتصالات، والتي\n"
+"                يمكن إعادة تحميلها عبر 'nmcli connection reload' بدلاً من "
+"ذلك.\n"
+"\n"
+"  'dns-rc'      تحديث تكوين DNS، والذي يتضمن عادةً كتابة\n"
+"                /etc/resolv.conf من جديد. هذا يعادل إرسال\n"
+"                إشارة SIGUSR1 إلى عملية NetworkManager.\n"
+"\n"
+"  'dns-full'    إعادة تشغيل ملحق DNS. هذا مفيد على سبيل المثال عند\n"
+"                استخدام ملحق dnsmasq، والذي يستخدم تكوينًا إضافيًا\n"
+"                في /etc/NetworkManager/dnsmasq.d. إذا قمت بتحرير هذه الملفات،"
+"\n"
+"                يمكنك إعادة تشغيل ملحق DNS. هذا الإجراء يعطل\n"
+"                تحليل الأسماء لفترة وجيزة.\n"
+"\n"
+"بدون علامات، يتم إعادة تحميل كل ما هو مدعوم، وهو\n"
+"مطابق لإرسال SIGHUP.\n"
+
+#: src/nmcli/general.c:378
+msgid ""
+"Usage: nmcli general logging { ARGUMENTS | help }\n"
+"\n"
+"ARGUMENTS := [level <log level>] [domains <log domains>]\n"
+"\n"
+"Get or change NetworkManager logging level and domains.\n"
+"Without any argument current logging level and domains are shown. In order "
+"to\n"
+"change logging state, provide level and/or domain. Please refer to the man "
+"page\n"
+"for the list of possible logging domains.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli general logging { المعاملات | help }\n"
+"\n"
+"المعاملات := [level <مستوى السجل>] [domains <نطاقات السجل>]\n"
+"\n"
+"الحصول على مستوى السجل ونطاقات مدير الشبكة (NetworkManager) أو تغييرهما.\n"
+"إذا لم يتم تقديم أي معاملات، فسيتم عرض مستوى السجل والنطاقات الحالية. لتغيير "
+"حالة السجل، يرجى تقديم المستوى و/أو النطاقات.\n"
+"يرجى الرجوع إلى صفحة الدليل للحصول على قائمة بنطاقات السجل المحتملة.\n"
+"\n"
+
