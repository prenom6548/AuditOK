+msgstr "مصادقة LEAP غير متوافقة مع وضع Ad-Hoc"
+
+#: src/core/devices/wifi/nm-wifi-utils.c:129
+msgid "LEAP authentication is incompatible with 802.1x setting"
+msgstr "مصادقة LEAP غير متوافقة مع إعدادات 802.1x"
+
+#: src/core/devices/wifi/nm-wifi-utils.c:149
+#, c-format
+msgid "a connection using '%s' authentication cannot use WPA key management"
+msgstr "لا يمكن للاتصالات التي تستخدم مصادقة \"%s\" استخدام إدارة مفاتيح WPA"
+
+#: src/core/devices/wifi/nm-wifi-utils.c:162
+#, c-format
+msgid "a connection using '%s' authentication cannot specify WPA protocols"
+msgstr "لا يمكن للاتصالات التي تستخدم مصادقة \"%s\" تحديد بروتوكول WPA"
+
+#: src/core/devices/wifi/nm-wifi-utils.c:180
+#: src/core/devices/wifi/nm-wifi-utils.c:199
