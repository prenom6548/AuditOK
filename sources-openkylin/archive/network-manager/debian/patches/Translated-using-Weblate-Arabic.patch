+#: src/nmcli/devices.c:840
+msgid ""
+"Usage: nmcli device { COMMAND | help }\n"
+"\n"
+"COMMAND := { status | show | set | connect | reapply | modify | disconnect | "
+"delete | monitor | wifi | lldp }\n"
+"\n"
+"  status\n"
+"\n"
+"  show [<ifname>]\n"
+"\n"
+"  set [ifname] <ifname> [autoconnect yes|no] [managed yes|no]\n"
+"\n"
+"  connect <ifname>\n"
+"\n"
+"  reapply <ifname>\n"
+"\n"
+"  modify <ifname> ([+|-]<setting>.<property> <value>)+\n"
+"\n"
+"  disconnect <ifname> ...\n"
+"\n"
+"  delete <ifname> ...\n"
+"\n"
+"  monitor <ifname> ...\n"
+"\n"
+"  wifi [list [ifname <ifname>] [bssid <BSSID>] [--rescan yes|no|auto]]\n"
+"\n"
+"  wifi connect <(B)SSID> [password <password>] [wep-key-type key|phrase] "
+"[ifname <ifname>]\n"
+"                         [bssid <BSSID>] [name <name>] [private yes|no] "
+"[hidden yes|no]\n"
+"\n"
+"  wifi hotspot [ifname <ifname>] [con-name <name>] [ssid <SSID>] [band a|bg] "
+"[channel <channel>] [password <password>]\n"
+"\n"
+"  wifi rescan [ifname <ifname>] [[ssid <SSID to scan>] ...]\n"
+"\n"
+"  wifi show-password [ifname <ifname>]\n"
+"\n"
+"  lldp [list [ifname <ifname>]]\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli device { أمر | help }\n"
+"\n"
+"الأوامر := { status | show | set | connect | reapply | modify | disconnect | "
+"delete | monitor | wifi | lldp }\n"
+"\n"
+"  status\n"
+"\n"
+"  show [<اسم_الواجهة>]\n"
+"\n"
+"  set [ifname] <اسم_الواجهة> [autoconnect yes|no] [managed yes|no]\n"
+"\n"
+"  connect <اسم_الواجهة>\n"
+"\n"
+"  reapply <اسم_الواجهة>\n"
+"\n"
+"  modify <اسم_الواجهة> ([+|-]<الإعداد>.<الخاصية> <القيمة>)+\n"
+"\n"
+"  disconnect <اسم_الواجهة> ...\n"
+"\n"
+"  delete <اسم_الواجهة> ...\n"
+"\n"
+"  monitor <اسم_الواجهة> ...\n"
+"\n"
+"  wifi [list [ifname <اسم_الواجهة>] [bssid <BSSID>] [--rescan yes|no|auto]]\n"
+"\n"
+"  wifi connect <(B)SSID> [password <كلمة_المرور>] [wep-key-type key|phrase] ["
+"ifname <اسم_الواجهة>]\n"
+"                         [bssid <BSSID>] [name <الاسم>] [private yes|no] ["
+"hidden yes|no]\n"
+"\n"
+"  wifi hotspot [ifname <اسم_الواجهة>] [con-name <الاسم>] [ssid <SSID>] [band "
+"a|bg] [channel <القناة>] [password <كلمة_المرور>]\n"
+"\n"
+"  wifi rescan [ifname <اسم_الواجهة>] [[ssid <SSID_للفحص>] ...]\n"
+"\n"
+"  wifi show-password [ifname <اسم_الواجهة>]\n"
+"\n"
+"  lldp [list [ifname <اسم_الواجهة>]]\n"
+"\n"
+
+# 大写的 DEVICE、TYPE、STATE、CONNECTION 找不到具体对应的翻译位置，这是在 CLI 是显示的列表项，所以没有翻译。
+#: src/nmcli/devices.c:868
+msgid ""
+"Usage: nmcli device status { help }\n"
+"\n"
+"Show status for all devices.\n"
+"By default, the following columns are shown:\n"
+" DEVICE     - interface name\n"
+" TYPE       - device type\n"
+" STATE      - device state\n"
+" CONNECTION - connection activated on device (if any)\n"
+"Displayed columns can be changed using '--fields' global option. 'status' "
+"is\n"
+"the default command, which means 'nmcli device' calls 'nmcli device "
+"status'.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli device status { help }\n"
+"\n"
+"يعرض حالة جميع الأجهزة.\n"
+"افتراضيًا، يعرض الأعمدة التالية:\n"
+" DEVICE     - اسم الواجهة\n"
+" TYPE       - نوع الجهاز\n"
+" STATE      - حالة الجهاز\n"
+" CONNECTION - الاتصال النشط على الجهاز (إن وجد)\n"
+"يمكن تغيير الأعمدة المعروضة عبر الخيار العام \"--fields\". \"status\" هو "
+"الأمر الافتراضي، مما يعني أن \n"
+"\"nmcli device\" يستدعي \"nmcli device status\".\n"
+"\n"
+
+#: src/nmcli/devices.c:883
+msgid ""
+"Usage: nmcli device show { ARGUMENTS | help }\n"
+"\n"
+"ARGUMENTS := [<ifname>]\n"
+"\n"
+"Show details of device(s).\n"
+"The command lists details for all devices, or for a given device.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli device show { وسيطات | help }\n"
+"\n"
+"الوسائط := [<اسم_الواجهة>]\n"
+"\n"
+"يعرض تفاصيل الجهاز.\n"
+"يسرد هذا الأمر تفاصيل جميع الأجهزة أو جهاز معين.\n"
+"\n"
+
+#: src/nmcli/devices.c:894
+msgid ""
+"Usage: nmcli device connect { ARGUMENTS | help }\n"
+"\n"
+"ARGUMENTS := <ifname>\n"
+"\n"
+"Connect the device.\n"
+"NetworkManager will try to find a suitable connection that will be "
+"activated.\n"
+"It will also consider connections that are not set to auto-connect.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli device connect { وسيطات | help }\n"
+"\n"
+"الوسائط := <اسم_الواجهة>\n"
+"\n"
+"يتصل بالجهاز.\n"
+"سيحاول مدير الشبكة (NetworkManager) العثور على اتصال مناسب لتفعيله، بما في "
+"ذلك تلك التي لم يتم تعيينها للاتصال التلقائي.\n"
+"\n"
+
+#: src/nmcli/devices.c:906
+msgid ""
+"Usage: nmcli device reapply { ARGUMENTS | help }\n"
+"\n"
+"ARGUMENTS := <ifname>\n"
+"\n"
+"Attempts to update device with changes to the currently active connection\n"
+"made since it was last applied.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli device reapply { وسيطات | help }\n"
+"\n"
+"الوسائط := <اسم_الواجهة>\n"
+"\n"
+"يحاول تطبيق التغييرات التي أُجريت على الاتصال النشط حاليًا منذ آخر تطبيق له "
+"على الجهاز.\n"
+"\n"
+
+#: src/nmcli/devices.c:918
+msgid ""
+"Usage: nmcli device modify { ARGUMENTS | help }\n"
+"\n"
+"ARGUMENTS := <ifname> ([+|-]<setting>.<property> <value>)+\n"
+"\n"
+"Modify one or more properties that are currently active on the device "
+"without modifying\n"
+"the connection profile. The changes have immediate effect. For multi-valued\n"
+"properties you can use optional '+' or '-' prefix to the property name.\n"
+"The '+' sign allows appending items instead of overwriting the whole value.\n"
+"The '-' sign allows removing selected items instead of the whole value.\n"
+"\n"
+"Examples:\n"
+"nmcli dev mod em1 ipv4.method manual ipv4.addr \"192.168.1.2/24, "
+"10.10.1.5/8\"\n"
+"nmcli dev mod em1 +ipv4.dns 8.8.4.4\n"
+"nmcli dev mod em1 -ipv4.dns 1\n"
+"nmcli dev mod em1 -ipv6.addr \"abbe::cafe/56\"\n"
+msgstr ""
+"الاستخدام: nmcli device modify { وسيطات | --help }\n"
+"\n"
+"الوسائط := <اسم_الواجهة> ([+|-]<الإعداد>.<الخاصية> <القيمة>)+\n"
+"\n"
+"يعدل خاصية واحدة أو أكثر للاتصال النشط حاليًا على الجهاز، دون تغيير ملف "
+"تعريف الاتصال. تسري التغييرات فورًا.\n"
+"بالنسبة للخصائص متعددة القيم، يمكنك إدراج علامة \"+\" أو \"-\" اختيارية قبل "
+"اسم الخاصية. تسمح علامة \"+\" بإضافة عناصر\n"
+"بدلاً من استبدال القيمة بأكملها. وتسمح علامة \"-\" بإزالة عناصر محددة بدلاً "
+"من القيمة بأكملها.\n"
+"أمثلة:\n"
+"nmcli dev mod em1 ipv4.method manual ipv4.addr \"192.168.1.2/24, 10.10.1.5/"
+"8\"\n"
+"nmcli dev mod em1 +ipv4.dns 8.8.4.4\n"
+"nmcli dev mod em1 -ipv4.dns 1\n"
+"nmcli dev mod em1 -ipv6.addr \"abbe::cafe/56\"\n"
+
+#: src/nmcli/devices.c:938
+msgid ""
+"Usage: nmcli device disconnect { ARGUMENTS | help }\n"
+"\n"
+"ARGUMENTS := <ifname> ...\n"
+"\n"
+"Disconnect devices.\n"
+"The command disconnects the device and prevents it from auto-activating\n"
+"further connections without user/manual intervention.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli device disconnect { وسيطات | help }\n"
+"\n"
+"الوسائط := <اسم_الواجهة>\n"
+"\n"
+"يفصل اتصال الجهاز.\n"
+"يفصل هذا الأمر اتصال الجهاز ويمنعه من تفعيل الاتصالات تلقائيًا دون تدخل "
+"المستخدم/يدويًا.\n"
+"\n"
+
+#: src/nmcli/devices.c:950
+msgid ""
+"Usage: nmcli device delete { ARGUMENTS | help }\n"
+"\n"
+"ARGUMENTS := <ifname> ...\n"
+"\n"
+"Delete the software devices.\n"
+"The command removes the interfaces. It only works for software devices\n"
+"(like bonds, bridges, etc.). Hardware devices cannot be deleted by the\n"
+"command.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli device delete { وسيطات | help }\n"
+"\n"
+"الوسائط := <اسم_الواجهة> ...\n"
+"\n"
+"يحذف الأجهزة البرمجية.\n"
+"يُستخدم هذا الأمر لإزالة الواجهات. وهو ينطبق فقط على الأجهزة البرمجية (مثل "
+"الترابط، الجسور، إلخ). لا يمكن حذف الأجهزة المادية باستخدام هذا الأمر.\n"
+"\n"
+
+#: src/nmcli/devices.c:963
+msgid ""
+"Usage: nmcli device set { ARGUMENTS | help }\n"
+"\n"
+"ARGUMENTS := DEVICE { PROPERTY [ PROPERTY ... ] }\n"
+"DEVICE    := [ifname] <ifname> \n"
+"PROPERTY  := { autoconnect { yes | no } |\n"
+"             { managed { yes | no }\n"
+"\n"
+"Modify device properties.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli device set { وسيطات | help }\n"
+"\n"
+"الوسائط := جهاز { خاصية [ خاصية ... ] }\n"
+"الجهاز := [ifname] <اسم_الواجهة> \n"
+"الخاصية := { autoconnect { yes | no } |\n"
+"        { managed { yes | no }\n"
+"\n"
+"يعدل خصائص الجهاز.\n"
+"\n"
+
+#: src/nmcli/devices.c:976
+msgid ""
+"Usage: nmcli device monitor { ARGUMENTS | help }\n"
+"\n"
+"ARGUMENTS := [<ifname>] ...\n"
+"\n"
+"Monitor device activity.\n"
+"This command prints a line whenever the specified devices change state.\n"
+"Monitors all devices in case no interface is specified.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli device monitor { وسيطات | help }\n"
+"\n"
+"الوسائط := [<اسم_الواجهة>] ...\n"
+"\n"
+"يراقب نشاط الجهاز.\n"
+"يطبع هذا الأمر التعديلات كلما تم تعديل الاتصال المحدد. إذا لم يتم تحديد أي "
+"اتصال، فإنه يراقب جميع الاتصالات.\n"
+"\n"
+
+#: src/nmcli/devices.c:989
+msgid ""
+"Usage: nmcli device wifi { ARGUMENTS | help }\n"
+"\n"
+"Perform operation on Wi-Fi devices.\n"
+"\n"
+"ARGUMENTS := [list [ifname <ifname>] [bssid <BSSID>] [--rescan yes|no|"
+"auto]]\n"
+"\n"
+"List available Wi-Fi access points. The 'ifname' and 'bssid' options can be\n"
+"used to list APs for a particular interface, or with a specific BSSID. The\n"
+"--rescan flag tells whether a new Wi-Fi scan should be triggered.\n"
+"\n"
+"ARGUMENTS := connect <(B)SSID> [password <password>] [wep-key-type key|"
+"phrase] [ifname <ifname>]\n"
+"                     [bssid <BSSID>] [name <name>] [private yes|no] [hidden "
+"yes|no]\n"
+"\n"
+"Connect to a Wi-Fi network specified by SSID or BSSID. The command finds a\n"
+"matching connection or creates one and then activates it on a device. This\n"
+"is a command-line counterpart of clicking an SSID in a GUI client. If a\n"
+"connection for the network already exists, it is possible to bring up the\n"
+"existing profile as follows: nmcli con up id <name>. Note that only open,\n"
+"WEP and WPA-PSK networks are supported if no previous connection exists.\n"
+"It is also assumed that IP configuration is obtained via DHCP.\n"
+"\n"
+"ARGUMENTS := hotspot [ifname <ifname>] [con-name <name>] [ssid <SSID>]\n"
+"                     [band a|bg] [channel <channel>] [password <password>]\n"
+"\n"
+"Create a Wi-Fi hotspot. Use 'connection down' or 'device disconnect'\n"
+"to stop the hotspot.\n"
+"Parameters of the hotspot can be influenced by the optional parameters:\n"
+"ifname - Wi-Fi device to use\n"
+"con-name - name of the created hotspot connection profile\n"
+"ssid - SSID of the hotspot\n"
+"band - Wi-Fi band to use\n"
+"channel - Wi-Fi channel to use\n"
+"password - password to use for the hotspot\n"
+"\n"
+"ARGUMENTS := rescan [ifname <ifname>] [[ssid <SSID to scan>] ...]\n"
+"\n"
+"Request that NetworkManager immediately re-scan for available access "
+"points.\n"
+"NetworkManager scans Wi-Fi networks periodically, but in some cases it "
+"might\n"
+"be useful to start scanning manually. 'ssid' allows scanning for a specific\n"
+"SSID, which is useful for APs with hidden SSIDs. More 'ssid' parameters can "
+"be\n"
+"given. Note that this command does not show the APs,\n"
+"use 'nmcli device wifi list' for that.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli device wifi { وسيطات | help }\n"
+"\n"
+"ينفذ عمليات على أجهزة Wi-Fi.\n"
+"\n"
+"الوسائط := [list [ifname <اسم_الواجهة>] [bssid <BSSID>] [--rescan "
+"yes|no|auto]]\n"
+"\n"
+"يسرد نقاط وصول Wi-Fi المتاحة. يمكن استخدام خياري \"ifname\" و \"bssid\" لسرد "
+"نقاط الوصول لواجهة أو BSSID محدد.\n"
+"تحدد علامة --rescan ما إذا كان يجب تشغيل فحص Wi-Fi جديد أم لا.\n"
+"\n"
+"الوسائط := connect <(B)SSID> [password <كلمة_المرور>] [wep-key-type "
+"key|phrase] [ifname <اسم_الواجهة>]\n"
+"                     [bssid <BSSID>] [name <الاسم>] [private yes|no] [hidden "
+"yes|no]\n"
+"\n"
+"يتصل بشبكة Wi-Fi المحددة بواسطة SSID أو BSSID. يبحث هذا الأمر عن اتصال مطابق "
+"أو ينشئ واحدًا على الجهاز\n"
+"ثم يقوم بتفعيله. يتوافق عنصر سطر الأوامر هذا مع النقر على SSID في عميل GUI. "
+"إذا كان الاتصال بالشبكة\n"
+"موجودًا بالفعل، يمكن استدعاء ملف التعريف الموجود بالأمر: nmcli con up id "
+"<الاسم>. لاحظ أنه إذا لم يكن هناك اتصال مسبقًا،\n"
+"فإن الشبكات المفتوحة و WAP و WPA-PSK فقط هي المدعومة. ويُفترض أيضًا أن تكوين "
+"IP يتم الحصول عليه عبر DHCP.\n"
+"\n"
+"الوسائط := hotspot [ifname <اسم_الواجهة>] [con-name <الاسم>] [ssid <SSID>]\n"
+"                     [band a|bg] [channel <القناة>] [password <كلمة_المرور>]"
+"\n"
+"\n"
+"ينشئ نقطة اتصال Wi-Fi. استخدم \"connection down\" أو \"device disconnect\" "
+"لإيقاف نقطة الاتصال.\n"
+"تتأثر معلمات نقطة الاتصال بالمعلمات الاختيارية:\n"
+"ifname — جهاز Wi-Fi المراد استخدامه\n"
+"con-name — اسم ملف تعريف اتصال نقطة الاتصال المُنشأ\n"
+"ssid — SSID لنقطة الاتصال\n"
+"band — نطاق Wi-Fi المراد استخدامه\n"
+"channel — قناة Wi-Fi المراد استخدامها\n"
+"password — كلمة المرور لنقطة الاتصال\n"
+"\n"
+"الوسائط := rescan [ifname <اسم_الواجهة>] [[ssid <SSID_للفحص>] ...]\n"
+"\n"
+"يطلب من مدير الشبكة (NetworkManager) إعادة فحص نقاط الوصول المتاحة فورًا. "
+"يقوم مدير الشبكة بفحص\n"
+"شبكات Wi-Fi بشكل دوري، ولكن قد يكون من المفيد البدء يدويًا في بعض الحالات. "
+"يسمح \"ssid\" بفحص SSID محدد،\n"
+"مما يمكن استخدامه لفحص نقاط الوصول التي تحتوي على SSID مخفي. يمكن تقديم "
+"معلمات \"ssid\" متعددة. لاحظ أن هذا الأمر لا\n"
+"يعرض نقاط الوصول، لعرض نقاط الوصول استخدم \"nmcli device wifi list\".\n"
+"\n"
+
+#: src/nmcli/devices.c:1037
+msgid ""
+"Usage: nmcli device lldp { ARGUMENTS | help }\n"
+"\n"
+"ARGUMENTS := [list [ifname <ifname>]]\n"
+"\n"
+"List neighboring devices discovered through LLDP. The 'ifname' option can "
+"be\n"
+"used to list neighbors for a particular interface.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli device lldp { وسيطات | help }\n"
+"\n"
+"الوسائط := [list [ifname <اسم_الواجهة>]]\n"
+"\n"
+"يسرد الأجهزة المجاورة المكتشفة عبر LLDP. يمكن استخدام خيار \"ifname\" لسرد "
+"الأجهزة المجاورة لواجهة محددة.\n"
+"\n"
+
+#: src/nmcli/devices.c:1048
+msgid ""
+"Usage: nmcli device checkpoint { ARGUMENTS | help }\n"
+"\n"
+"ARGUMENTS := [--timeout <seconds>] -- COMMAND...\n"
+"\n"
+"Runs the command with a configuration checkpoint taken and asks for a\n"
+"confirmation when finished. When the confirmation is not given, the\n"
+"checkpoint is automatically restored after timeout.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli device checkpoint { وسيطات | help }\n"
+"\n"
+"الوسائط := [--timeout <ثواني>] -- أمر...\n"
+"\n"
+"يشغل الأمر مع أخذ نقطة تحقق للتكوين ويطلب تأكيدًا عند الانتهاء. عندما لا يتم "
+"تقديم التأكيد،\n"
+"يتم استعادة نقطة التحقق تلقائيًا بعد انتهاء المهلة.\n"
+"\n"
+
