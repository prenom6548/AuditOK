+#: data/org.freedesktop.NetworkManager.policy.in.in:13
+msgid "Enable or disable system networking"
+msgstr "تمكين أو تعطيل اتصال النظام بالشبكة"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:14
+msgid "System policy prevents enabling or disabling system networking"
+msgstr "تمنع سياسة النظام تمكين أو تعطيل اتصال النظام بالشبكة"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:22
+msgid "Reload NetworkManager configuration"
+msgstr "إعادة تحميل إعدادات مدير الشبكة"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:23
+msgid "System policy prevents reloading NetworkManager"
+msgstr "تمنع سياسة النظام إعادة تحميل مدير الشبكة"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:32
+msgid ""
+"Put NetworkManager to sleep or wake it up (should only be used by system "
+"power management)"
+msgstr "تعليق أو استئناف مدير الشبكة (يجب استخدامه فقط لإدارة طاقة النظام)"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:33
+msgid "System policy prevents putting NetworkManager to sleep or waking it up"
+msgstr "تمنع سياسة النظام تعليق أو استئناف مدير الشبكة"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:41
+msgid "Enable or disable Wi-Fi devices"
+msgstr "تمكين أو تعطيل أجهزة Wi-Fi"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:42
+msgid "System policy prevents enabling or disabling Wi-Fi devices"
+msgstr "تمنع سياسة النظام تمكين أو تعطيل أجهزة Wi-Fi"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:50
+msgid "Enable or disable mobile broadband devices"
+msgstr "تمكين أو تعطيل أجهزة النطاق العريض المتنقل"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:51
+msgid "System policy prevents enabling or disabling mobile broadband devices"
+msgstr "تمنع سياسة النظام تمكين أو تعطيل أجهزة النطاق العريض المتنقل"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:59
+msgid "Enable or disable WiMAX mobile broadband devices"
+msgstr "تمكين أو تعطيل أجهزة WiMAX للنطاق العريض المتنقل"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:60
+msgid ""
+"System policy prevents enabling or disabling WiMAX mobile broadband devices"
+msgstr "تمنع سياسة النظام تمكين أو تعطيل أجهزة WiMAX للنطاق العريض المتنقل"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:68
+msgid "Allow control of network connections"
+msgstr "السماح بالتحكم في اتصالات الشبكة"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:69
+msgid "System policy prevents control of network connections"
+msgstr "تمنع سياسة النظام التحكم في اتصالات الشبكة"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:78
+msgid "Allow control of Wi-Fi scans"
+msgstr "السماح بالتحكم في فحص Wi-Fi"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:79
+msgid "System policy prevents Wi-Fi scans"
+msgstr "تمنع سياسة النظام فحص Wi-Fi"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:88
+msgid "Connection sharing via a protected Wi-Fi network"
+msgstr "مشاركة الاتصال عبر شبكة Wi-Fi محمية"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:89
+msgid ""
+"System policy prevents sharing connections via a protected Wi-Fi network"
+msgstr "تمنع سياسة النظام مشاركة الاتصال باستخدام شبكة Wi-Fi محمية"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:97
+msgid "Connection sharing via an open Wi-Fi network"
+msgstr "مشاركة الاتصال عبر شبكة Wi-Fi مفتوحة"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:98
+msgid "System policy prevents sharing connections via an open Wi-Fi network"
+msgstr "تمنع سياسة النظام مشاركة الاتصال باستخدام شبكة Wi-Fi مفتوحة"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:106
+msgid "Modify personal network connections"
+msgstr "تغيير اتصالات الشبكة الشخصية"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:107
+msgid "System policy prevents modification of personal network settings"
+msgstr "تمنع سياسة النظام تغيير إعدادات الشبكة الشخصية"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:116
+msgid "Modify network connections for all users"
+msgstr "تعديل اتصالات الشبكة لجميع المستخدمين"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:117
+msgid "System policy prevents modification of network settings for all users"
+msgstr "تمنع سياسة النظام جميع المستخدمين من تعديل إعدادات الشبكة"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:126
+msgid "Modify persistent system hostname"
+msgstr "تعديل اسم المضيف الثابت للنظام"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:127
+msgid "System policy prevents modification of the persistent system hostname"
+msgstr "تمنع سياسة النظام تعديل اسم المضيف الثابت للنظام"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:136
+msgid "Modify persistent global DNS configuration"
+msgstr "تعديل إعدادات DNS العامة الدائمة"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:137
+msgid ""
+"System policy prevents modification of the persistent global DNS "
+"configuration"
+msgstr "تمنع سياسة النظام تعديل إعدادات DNS العامة الدائمة"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:146
+msgid "Perform a checkpoint or rollback of interfaces configuration"
+msgstr "تنفيذ نقطة تفتيش أو استرجاع لإعدادات الواجهة"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:147
+msgid "System policy prevents the creation of a checkpoint or its rollback"
+msgstr "تمنع سياسة النظام إنشاء نقاط التفتيش أو استرجاعها"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:156
+msgid "Enable or disable device statistics"
+msgstr "تمكين أو تعطيل إحصائيات الجهاز"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:157
+msgid "System policy prevents enabling or disabling device statistics"
+msgstr "تمنع سياسة النظام تمكين أو تعطيل إحصائيات الجهاز"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:165
+msgid "Enable or disable connectivity checking"
+msgstr "تمكين أو تعطيل فحص الاتصال"
+
+#: data/org.freedesktop.NetworkManager.policy.in.in:166
+msgid "System policy prevents enabling or disabling connectivity checking"
+msgstr "تمنع سياسة النظام تمكين أو تعطيل فحص الاتصال"
+
