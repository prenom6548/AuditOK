+#, c-format
+msgid "Could not re-read file: %s"
+msgstr "تعذّرت إعادة قراءة الملف: %s"
+
+#: src/nm-online/nm-online.c:76
+msgid "Connecting"
+msgstr "جارٍ الاتصال"
+
+#: src/nm-online/nm-online.c:189
+msgid "Error: timeout creating NMClient object\n"
+msgstr "خطأ: انتهت مهلة إنشاء كائن NMClient\n"
+
+#: src/nm-online/nm-online.c:210
+#, c-format
+msgid "Error: Could not create NMClient object: %s\n"
+msgstr "خطأ: تعذّر إنشاء كائن NMClient: %s\n"
+
+#: src/nm-online/nm-online.c:236
+msgid "Don't print anything"
+msgstr "لا يُخرج أي نتائج"
+
+#: src/nm-online/nm-online.c:242
+msgid "Wait for NetworkManager startup instead of a connection"
+msgstr "ينتظر بدء مدير الشبكة بدلاً من الاتصال"
+
+#: src/nm-online/nm-online.c:249
+msgid ""
+"Time to wait for a connection, in seconds (without the option, default value "
+"is 30). Maximum value is 2073600 seconds."
+msgstr ""
+"الوقت المنتظر للاتصال، بالثواني (بدون الخيار، القيمة الافتراضية هي 30). الحد "
+"الأقصى للقيمة هو 2073600 ثانية."
+
+#: src/nm-online/nm-online.c:257
+msgid "Exit immediately if NetworkManager is not running or connecting"
+msgstr "يخرج فوراً إذا لم يكن مدير الشبكة قيد التشغيل أو متصلاً"
+
+#: src/nm-online/nm-online.c:281
+msgid ""
+"Waits for NetworkManager to finish activating startup network connections."
+msgstr "ينتظر انتهاء مدير الشبكة من تنشيط بدء اتصال الشبكة."
+
+#: src/nm-online/nm-online.c:289 src/nm-online/nm-online.c:296
+msgid "Invalid option.  Please use --help to see a list of valid options."
+msgstr "خيار غير صالح. يُرجى استخدام --help لعرض قائمة الخيارات الصالحة."
+
+#: src/nmcli/agent.c:25
+msgid ""
+"Usage: nmcli agent { COMMAND | help }\n"
+"\n"
+"COMMAND := { secret | polkit | all }\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli agent { COMMAND | help }\n"
+"\n"
+"الأوامر := { secret | polkit | all }\n"
+"\n"
+
+#: src/nmcli/agent.c:32
+msgid ""
+"Usage: nmcli agent secret { help }\n"
+"\n"
+"Runs nmcli as NetworkManager secret agent. When NetworkManager requires\n"
+"a password it asks registered agents for it. This command keeps nmcli "
+"running\n"
+"and if a password is required asks the user for it.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli agent secret { help }\n"
+"\n"
+"تشغيل nmcli كوكيل أسرار لمدير الشبكة (NetworkManager). عندما يطلب "
+"NetworkManager كلمة مرور، سيطلبها من\n"
+"الوكلاء المسجلين. سيبقي هذا الأمر nmcli قيد التشغيل، وسيطلب من المستخدم كلمة "
+"المرور إذا طُلبت.\n"
+"\n"
+
+#: src/nmcli/agent.c:42
+msgid ""
+"Usage: nmcli agent polkit { help }\n"
+"\n"
+"Registers nmcli as a polkit action for the user session.\n"
+"When a polkit daemon requires an authorization, nmcli asks the user and "
+"gives\n"
+"the response back to polkit.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli agent polkit { help }\n"
+"\n"
+"تسجيل nmcli كإجراء polkit لجلسة المستخدم.\n"
+"عندما يطلب برنامج polkit الخفي التفويض، يستفسر nmcli من المستخدم ويعيد "
+"استجابته إلى polkit.\n"
+"\n"
+
+#: src/nmcli/agent.c:52
+msgid ""
+"Usage: nmcli agent all { help }\n"
+"\n"
+"Runs nmcli as both NetworkManager secret and a polkit agent.\n"
+"\n"
+msgstr ""
+"الاستخدام: nmcli agent all { help }\n"
+"\n"
+"تشغيل nmcli كوكيل أسرار لمدير الشبكة (NetworkManager) ووكيل polkit في آن "
+"واحد.\n"
+"\n"
+
+#: src/nmcli/agent.c:141
+msgid "nmcli successfully registered as a NetworkManager's secret agent.\n"
+msgstr "تم تسجيل nmcli بنجاح كوكيل أسرار لمدير الشبكة (NetworkManager).\n"
