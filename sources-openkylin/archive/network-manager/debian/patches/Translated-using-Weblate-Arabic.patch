+msgstr "نقطة الوصول لا تدعم PSK ولكن الإعدادات تتطلب ذلك"
+
+#: src/core/devices/wifi/nm-wifi-utils.c:363
+msgid "WPA Ad-Hoc authentication requires 'rsn' protocol"
+msgstr "تتطلب مصادقة WPA Ad-Hoc بروتوكول \"rsn\""
+
+#: src/core/devices/wifi/nm-wifi-utils.c:376
+msgid "WPA Ad-Hoc authentication requires 'ccmp' pairwise cipher"
+msgstr "تتطلب مصادقة WPA Ad-Hoc تشفير \"ccmp\" الثنائي"
+
+#: src/core/devices/wifi/nm-wifi-utils.c:389
+msgid "WPA Ad-Hoc requires 'ccmp' group cipher"
+msgstr "تتطلب WPA Ad-Hoc تشفير \"ccmp\" الجماعي"
+
+#: src/core/devices/wifi/nm-wifi-utils.c:420
+msgid "WPA-EAP authentication requires an 802.1x setting"
+msgstr "تتطلب مصادقة WPA-EAP إعدادات 802.1x"
+
+#: src/core/devices/wifi/nm-wifi-utils.c:430
+msgid "WPA-EAP requires 'open' authentication"
+msgstr "تتطلب WPA-EAP مصادقة \"open\""
+
+#: src/core/devices/wifi/nm-wifi-utils.c:443
+msgid "802.1x setting requires 'wpa-eap' key management"
+msgstr "تتطلب إعدادات 802.1x إدارة مفاتيح \"wpa-eap\""
+
+#: src/core/devices/wifi/nm-wifi-utils.c:457
+msgid "Access point does not support 802.1x but setting requires it"
+msgstr "نقطة الوصول لا تدعم 802.1x ولكن الإعدادات تتطلب ذلك"
+
+#: src/core/devices/wifi/nm-wifi-utils.c:487
+msgid "Ad-Hoc mode requires 'none' or 'wpa-psk' key management"
+msgstr "يتطلب وضع Ad-Hoc إدارة مفاتيح \"none\" أو \"wpa-psk\""
+
+#: src/core/devices/wifi/nm-wifi-utils.c:499
+msgid "Ad-Hoc mode is incompatible with 802.1x security"
+msgstr "وضع Ad-Hoc غير متوافق مع أمان 802.1x"
+
+#: src/core/devices/wifi/nm-wifi-utils.c:508
+msgid "Ad-Hoc mode is incompatible with LEAP security"
+msgstr "وضع Ad-Hoc غير متوافق مع أمان LEAP"
+
+#: src/core/devices/wifi/nm-wifi-utils.c:520
+msgid "Ad-Hoc mode requires 'open' authentication"
+msgstr "يتطلب وضع Ad-Hoc مصادقة \"open\""
+
+#: src/core/devices/wifi/nm-wifi-utils.c:564
+#: src/core/devices/wifi/nm-wifi-utils.c:599
+msgid "connection does not match access point"
+msgstr "الاتصال ونقطة الوصول غير متطابقين"
+
+#: src/core/devices/wifi/nm-wifi-utils.c:653
+msgid "connection does not match mesh point"
+msgstr "الاتصال ونقطة الشبكة المتداخلة غير متطابقين"
+
+#: src/core/devices/wifi/nm-wifi-utils.c:672
+msgid "Access point is unencrypted but setting specifies security"
+msgstr "نقطة الوصول غير مشفرة ولكن الإعدادات تحدد الأمان"
+
