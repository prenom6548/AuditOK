+#. TRANSLATORS: do not translate command names and keywords before ::
+#. *              However, you should translate terms enclosed in <>.
+#.
+#: src/nmcli/connections.c:7059
+msgid ""
+"---[ Main menu ]---\n"
+"goto     [<setting> | <prop>]        :: go to a setting or property\n"
+"remove   <setting>[.<prop>] | <prop> :: remove setting or reset property "
+"value\n"
+"set      [<setting>.<prop> <value>]  :: set property value\n"
+"describe [<setting>.<prop>]          :: describe property\n"
+"print    [all | <setting>[.<prop>]]  :: print the connection\n"
+"verify   [all | fix]                 :: verify the connection\n"
+"save     [persistent|temporary]      :: save the connection\n"
+"activate [<ifname>] [/<ap>|<nsp>]    :: activate the connection\n"
+"back                                 :: go one level up (back)\n"
+"help/?   [<command>]                 :: print this help\n"
+"nmcli    <conf-option> <value>       :: nmcli configuration\n"
+"quit                                 :: exit nmcli\n"
+msgstr ""
+"---[ القائمة الرئيسية ]---\n"
+"goto     [<الإعداد> | <الخاصية>]        :: الانتقال إلى إعداد أو خاصية\n"
+"remove   <الإعداد>[.<الخاصية>] | <الخاصية> :: إزالة إعداد أو إعادة تعيين "
+"قيمة الخاصية\n"
+"set      [<الإعداد>.<الخاصية> <القيمة>]     :: تعيين قيمة الخاصية\n"
+"describe [<الإعداد>.<الخاصية>]          :: وصف الخاصية\n"
+"print    [all | <الإعداد>[.<الخاصية>]]  :: طباعة الاتصال\n"
+"verify   [all | fix]              :: التحقق من الاتصال\n"
+"save     [persistent|temporary]   :: حفظ الاتصال\n"
+"activate [<اسم_الواجهة>] [/<ap>|<nsp>] :: تنشيط الاتصال\n"
+"back                              :: الانتقال إلى المستوى الأعلى (رجوع)\n"
+"help/?   [<الأمر>]                 :: طباعة هذه المساعدة\n"
+"nmcli    <خيار_التكوين> <القيمة>          :: تكوين nmcli\n"
+"quit                              :: الخروج من nmcli\n"
+
+#: src/nmcli/connections.c:7086
+msgid ""
+"goto <setting>[.<prop>] | <prop>  :: enter setting/property for editing\n"
+"\n"
+"This command enters into a setting or property for editing it.\n"
+"\n"
+"Examples: nmcli> goto connection\n"
+"          nmcli connection> goto secondaries\n"
+"          nmcli> goto ipv4.addresses\n"
+msgstr ""
+"goto <الإعداد>[.<الخاصية>] | <الخاصية>  :: الدخول إلى إعداد/خاصية للتحرير\n"
+"\n"
+"يدخل هذا الأمر إلى إعداد أو خاصية لتحريرها.\n"
+"\n"
+"أمثلة: nmcli> goto connection\n"
+"      nmcli connection> goto secondaries\n"
+"      nmcli> goto ipv4.addresses\n"
+
+#: src/nmcli/connections.c:7094
+msgid ""
+"remove <setting>[.<prop>]  :: remove setting or reset property value\n"
+"\n"
+"This command removes an entire setting from the connection, or if a "
+"property\n"
+"is given, resets that property to the default value.\n"
+"\n"
+"Examples: nmcli> remove wifi-sec\n"
+"          nmcli> remove eth.mtu\n"
+msgstr ""
+"remove <الإعداد>[.<الخاصية>]  :: إزالة إعداد أو إعادة تعيين قيمة الخاصية\n"
+"\n"
+"يزيل هذا الأمر إعداد الإدخال من الاتصال، أو إذا تم توفير خاصية، يعيد تعيين "
+"تلك الخاصية إلى قيمتها الافتراضية.\n"
+"\n"
+"أمثلة: nmcli> remove wifi-sec\n"
+"      nmcli> remove eth.mtu\n"
+
+#: src/nmcli/connections.c:7101
+msgid ""
+"set [<setting>.<prop> <value>]  :: set property value\n"
+"\n"
+"This command sets property value.\n"
+"\n"
+"Example: nmcli> set con.id My connection\n"
+msgstr ""
+"set [<الإعداد>.<الخاصية> <القيمة>]  :: تعيين قيمة الخاصية\n"
+"\n"
+"يُستخدم هذا الأمر لتعيين قيمة الخاصية.\n"
+"\n"
+"مثال: nmcli> set con.id اتصالي\n"
+
+#: src/nmcli/connections.c:7106
+msgid ""
+"add [<setting>.<prop> <value>]  :: add property value\n"
+"\n"
+"This command appends property value.\n"
+"\n"
+"Example: nmcli> add ipv4.addresses 192.168.1.1/24\n"
+msgstr ""
+"add [<الإعداد>.<الخاصية> <القيمة>]  :: إضافة قيمة الخاصية\n"
+"\n"
+"يُلحق هذا الأمر قيمة الخاصية.\n"
+"\n"
+"مثال: nmcli> add ipv4.addresses 192.168.1.1/24\n"
+
+#: src/nmcli/connections.c:7111
+msgid ""
+"describe [<setting>.<prop>]  :: describe property\n"
+"\n"
+"Shows property description. You can consult nm-settings(5) manual page to "
+"see all NM settings and properties.\n"
+msgstr ""
+"describe [<الإعداد>.<الخاصية>]  :: وصف الخاصية\n"
+"\n"
+"يعرض وصف الخاصية. يمكنك الرجوع إلى صفحة الدليل nm-settings(5) لعرض جميع "
+"إعدادات وخصائص مدير الشبكة (NetworkManager).\n"
+
+#: src/nmcli/connections.c:7116
+msgid ""
+"print [all]  :: print setting or connection values\n"
+"\n"
+"Shows current property or the whole connection.\n"
+"\n"
+"Example: nmcli ipv4> print all\n"
+msgstr ""
+"print [all]  :: طباعة الإعدادات أو قيم الاتصال\n"
+"\n"
+"يعرض الخاصية الحالية أو الاتصال بأكمله.\n"
+"\n"
+"مثال: nmcli ipv4> print all\n"
+
+#: src/nmcli/connections.c:7122
+msgid ""
+"verify [all | fix]  :: verify setting or connection validity\n"
+"\n"
+"Verifies whether the setting or connection is valid and can be saved later.\n"
+"It indicates invalid values on error. Some errors may be fixed "
+"automatically\n"
+"by 'fix' option.\n"
+"\n"
+"Examples: nmcli> verify\n"
+"          nmcli> verify fix\n"
+"          nmcli bond> verify\n"
+msgstr ""
+"verify [all | fix]  :: التحقق من صحة الإعدادات أو الاتصال\n"
+"\n"
+"يتحقق مما إذا كانت الإعدادات أو الاتصال صالحة ويمكن حفظها لاحقًا. عند حدوث "
+"خطأ، سيُشير إلى القيم غير الصالحة. يمكن إصلاح بعض الأخطاء\n"
+"تلقائيًا باستخدام الخيار \"fix\".\n"
+"\n"
+"أمثلة: nmcli> verify\n"
+"      nmcli> verify fix\n"
+"      nmcli bond> verify\n"
+
+#: src/nmcli/connections.c:7132
+msgid ""
+"save [persistent|temporary]  :: save the connection\n"
+"\n"
+"Sends the connection profile to NetworkManager that either will save it\n"
+"persistently, or will only keep it in memory. 'save' without an argument\n"
+"means 'save persistent'.\n"
+"Note that once you save the profile persistently those settings are saved\n"
+"across reboot or restart. Subsequent changes can also be temporary or\n"
+"persistent, but any temporary changes will not persist across reboot or\n"
+"restart. If you want to fully remove the persistent connection, the "
+"connection\n"
+"profile must be deleted.\n"
+msgstr ""
+"save [persistent|temporary]  :: حفظ الاتصال\n"
+"\n"
+"يرسل ملف تعريف الاتصال إلى مدير الشبكة (NetworkManager)، مع خيار الحفظ بشكل "
+"دائم أو في الذاكرة فقط. \"save\" بدون وسائط\n"
+"تعني \"save persistent\".\n"
+"يرجى ملاحظة أنه بمجرد حفظ ملف التعريف بشكل دائم، ستستمر هذه الإعدادات بعد "
+"إعادة تشغيل الجهاز/NM. يمكن أن تكون التعديلات اللاحقة\n"
+"مؤقتة أو دائمة، ولكن أي تعديلات مؤقتة ستُستعاد بعد إعادة التشغيل. إذا كنت "
+"تريد حذف\n"
+"اتصال دائم تمامًا، فيجب حذف ملف تعريف الاتصال.\n"
+
+#: src/nmcli/connections.c:7143
+msgid ""
+"activate [<ifname>] [/<ap>|<nsp>]  :: activate the connection\n"
+"\n"
+"Activates the connection.\n"
+"\n"
+"Available options:\n"
+"<ifname>    - device the connection will be activated on\n"
+"/<ap>|<nsp> - AP (Wi-Fi) or NSP (WiMAX) (prepend with / when <ifname> is not "
+"specified)\n"
+msgstr ""
+"activate [<اسم_الواجهة>] [/<ap>|<nsp>]  :: تنشيط الاتصال\n"
+"\n"
+"ينشط الاتصال.\n"
+"\n"
+"الخيارات المتاحة:\n"
+"<اسم_الواجهة>    - الجهاز الذي سيُنشط الاتصال.\n"
+"/<ap>|<nsp> - AP (Wi-Fi) أو NSP (WiMAX) (يسبقه الرمز / عند عدم تحديد "
+"<اسم_الواجهة>.)\n"
+
+#: src/nmcli/connections.c:7151 src/nmcli/connections.c:7310
+msgid ""
+"back  :: go to upper menu level\n"
+"\n"
+msgstr ""
+"back  :: العودة إلى القائمة العليا\n"
+"\n"
+
+#: src/nmcli/connections.c:7154
+msgid ""
+"help/? [<command>]  :: help for the nmcli commands\n"
+"\n"
+msgstr ""
+"help/? [<أمر>]  :: مساعدة أمر nmcli\n"
+"\n"
+
+#: src/nmcli/connections.c:7157
+#, c-format
+msgid ""
+"nmcli [<conf-option> <value>]  :: nmcli configuration\n"
+"\n"
+"Configures nmcli. The following options are available:\n"
+"status-line yes | no          [default: no]\n"
+"save-confirmation yes | no    [default: yes]\n"
+"show-secrets yes | no         [default: no]\n"
+"prompt-color <color> | <0-8>  [default: 0]\n"
+"%s\n"
+"Examples: nmcli> nmcli status-line yes\n"
+"          nmcli> nmcli save-confirmation no\n"
+"          nmcli> nmcli prompt-color 3\n"
+msgstr ""
+"nmcli [<خيار_التكوين> <قيمة>]  :: تكوين nmcli\n"
+"\n"
+"يُكوّن nmcli. الخيارات التالية متاحة:\n"
+"status-line yes | no          [الافتراضي: no]\n"
+"save-confirmation yes | no    [الافتراضي: yes]\n"
+"show-secrets yes | no         [الافتراضي: no]\n"
+"prompt-color <لون> | <0-8>  [الافتراضي: 0]\n"
+"%s\n"
+"أمثلة: nmcli> nmcli status-line yes\n"
+"      nmcli> nmcli save-confirmation no\n"
+"      nmcli> nmcli prompt-color 3\n"
+
+#: src/nmcli/connections.c:7179 src/nmcli/connections.c:7316
+msgid ""
+"quit  :: exit nmcli\n"
+"\n"
+"This command exits nmcli. When the connection being edited is not saved, the "
+"user is asked to confirm the action.\n"
+msgstr ""
+"quit  :: الخروج من nmcli\n"
+"\n"
+"يُستخدم هذا الأمر للخروج من nmcli. عند عدم حفظ الاتصال الذي يتم تحريره، "
+"سيسأل المستخدم لتأكيد العملية.\n"
+
+#: src/nmcli/connections.c:7184 src/nmcli/connections.c:7321
+#: src/nmcli/connections.c:7709 src/nmcli/connections.c:8741
+#, c-format
+msgid "Unknown command: '%s'\n"
+msgstr "أمر غير معروف: \"%s\"\n"
+
+#. TRANSLATORS: do not translate command names and keywords before ::
+#. *              However, you should translate terms enclosed in <>.
+#.
+#: src/nmcli/connections.c:7249
+msgid ""
+"---[ Property menu ]---\n"
+"set      [<value>]               :: set new value\n"
+"add      [<value>]               :: add new option to the property\n"
+"change                           :: change current value\n"
+"remove   [<index> | <option>]    :: delete the value\n"
+"describe                         :: describe property\n"
+"print    [setting | connection]  :: print property (setting/connection) "
+"value(s)\n"
+"back                             :: go to upper level\n"
+"help/?   [<command>]             :: print this help or command description\n"
+"quit                             :: exit nmcli\n"
+msgstr ""
+"---[ قائمة الخصائص ]---\n"
+"set      [<قيمة>]                  :: تعيين قيمة جديدة\n"
+"add      [<قيمة>]                  :: إضافة خيار جديد إلى الخاصية\n"
+"change                           :: تغيير القيمة الحالية\n"
+"remove   [<فهرس> | <خيار>]       :: إزالة القيمة\n"
+"describe                         :: وصف الخاصية\n"
+"print    [setting | connection]  :: عرض قيم (الإعداد/الاتصال)\n"
+"back                             :: العودة إلى المستوى السابق\n"
+"help/?   [<أمر>]                :: عرض هذه المساعدة أو وصف الأمر\n"
+"quit                             :: الخروج من nmcli\n"
+
+#: src/nmcli/connections.c:7273
+msgid ""
+"set [<value>]  :: set new value\n"
+"\n"
+"This command sets provided <value> to this property\n"
+msgstr ""
+"set [<قيمة>]  :: تعيين قيمة جديدة\n"
+"\n"
+"يُستخدم هذا الأمر لتعيين <قيمة> المقدمة إلى هذه الخاصية\n"
+
+#: src/nmcli/connections.c:7277
+msgid ""
+"add [<value>]  :: append new value to the property\n"
+"\n"
+"This command adds provided <value> to this property, if the property is of a "
+"container type. For single-valued properties the property value is replaced "
+"(same as 'set').\n"
+msgstr ""
+"add [<قيمة>]  :: إلحاق قيمة جديدة بهذه الخاصية\n"
+"\n"
+"إذا كانت الخاصية من نوع حاوية، فسيضيف هذا الأمر <قيمة> المقدمة إلى هذه "
+"الخاصية. بالنسبة للخصائص أحادية القيمة، ستستبدل القيمة (مثل \"set\").\n"
+
+#: src/nmcli/connections.c:7283
+msgid ""
+"change  :: change current value\n"
+"\n"
+"Displays current value and allows editing it.\n"
+msgstr ""
+"change  :: تغيير القيمة الحالية\n"
+"\n"
+"يعرض القيمة الحالية ويسمح بتحريرها.\n"
+
+#: src/nmcli/connections.c:7288
+msgid ""
+"remove [<value>|<index>|<option name>]  :: delete the value\n"
+"\n"
+"Removes the property value. For single-valued properties, this sets the\n"
+"property back to its default value. For container-type properties, this "
+"removes\n"
+"all the values of that property or you can specify an argument to remove "
+"just\n"
+"a single item or option. The argument is either a value or index of the item "
+"to\n"
+"remove, or an option name (for properties with named options).\n"
+"\n"
+"Examples: nmcli ipv4.dns> remove 8.8.8.8\n"
+"          nmcli ipv4.dns> remove 2\n"
+"          nmcli bond.options> remove downdelay\n"
+"\n"
+msgstr ""
+"remove [<قيمة>|<فهرس>|<اسم_الخيار>]  :: إزالة قيمة الخاصية\n"
+"\n"
+"يزيل قيمة الخاصية. بالنسبة للخصائص أحادية القيمة، سيعيد تعيين الخاصية إلى "
+"قيمتها الافتراضية. بالنسبة لخصائص الحاوية، سيؤدي هذا إلى إزالة جميع قيم\n"
+"الخاصية، أو يمكنك تحديد وسيطة لإزالة عنصر أو خيار واحد فقط. يمكن أن تكون "
+"الوسيطة هي قيمة العنصر المراد إزالته أو فهرسه، أو\n"
+"اسم الخيار (للخصائص التي تحتوي على خيارات مسماة).\n"
+"\n"
+"أمثلة: nmcli ipv4.dns> remove 8.8.8.8\n"
+"      nmcli ipv4.dns> remove 2\n"
+"      nmcli bond.options> remove downdelay\n"
+"\n"
+
+#: src/nmcli/connections.c:7299
+msgid ""
+"describe  :: describe property\n"
+"\n"
+"Shows property description. You can consult nm-settings(5) manual page to "
+"see all NM settings and properties.\n"
+msgstr ""
+"describe  :: وصف الخاصية\n"
+"\n"
+"يعرض وصف الخاصية. يمكنك الرجوع إلى صفحة الدليل nm-settings(5) لعرض جميع "
+"إعدادات وخصائص مدير الشبكة (NetworkManager).\n"
+
+#: src/nmcli/connections.c:7304
+msgid ""
+"print [property|setting|connection]  :: print property (setting, connection) "
+"value(s)\n"
+"\n"
+"Shows property value. Providing an argument you can also display values for "
+"the whole setting or connection.\n"
+msgstr ""
+"print [property|setting|connection]  :: عرض قيم الخاصية (الإعداد، الاتصال)\n"
+"\n"
+"يعرض الخاصية. بتوفير وسيطة، يمكنك أيضًا عرض قيم الإعداد أو الاتصال بأكمله.\n"
+
+#: src/nmcli/connections.c:7313
+msgid ""
+"help/? [<command>]  :: help for nmcli commands\n"
+"\n"
+msgstr ""
+"help/? [<أمر>]  :: مساعدة أمر nmcli\n"
+"\n"
+
