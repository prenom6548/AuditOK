-	$(CC)  -shared -o lib/$@ $(patsubst %.o,obj/%.o,$(notdir $(OBJECTS))) $(LD_FLAG)
-	@echo "finish $(PROJECT)"
-
-.c.o:
-	@mkdir -p obj
-	$(CC) -c $< $(CFLAG) -o obj/$(patsubst %.c,%.o,$(notdir $<))
-
-clean:
-	-rm -rf obj lib
-	@echo "clean up"
