-OPTION += -Wstrict-overflow=1
-OPTION += -Wstrict-aliasing=2
-OPTION += -Wswitch -Wswitch-default
-
-CFLAG   =  -Wall -DNDEBUG -O2 $(OPTION)
-
-SOURCES=$(wildcard src/*.c)
-
