<?xml version="1.0" encoding="UTF-8"?>
<xbel version="1.0" dbusName="org.example.bookmarks" app:profile="work"
      xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks"
      xmlns:mime="http://www.freedesktop.org/standards/shared-mime-info"
      xmlns:app="https://example.org/xbel/app">
  <title>Root Bookmarks</title>
  <bookmark id="docs" href="file:///home/user/Documents" showintoolbar="yes" app:priority="high">
    <title>Docs</title>
    <desc>Documents folder</desc>
    <bookmark:icon name="folder-documents"
                   href="file:///usr/share/icons/breeze/places/64/folder-documents.svg"
                   type="image/svg+xml"/>
    <mime:mime-type type="inode/directory"/>
    <info>
      <metadata owner="http://freedesktop.org">
        <bookmark:groups>
          <bookmark:group>pluma</bookmark:group>
        </bookmark:groups>
        <bookmark:applications>
          <bookmark:application name="Firefox" exec="'firefox-esr %u'" modified="2026-02-06T09:50:28.485017Z" count="1"/>
          <bookmark:application name="Pluma" exec="'pluma %u'" modified="2026-02-06T09:50:33.347434Z" count="1"/>
        </bookmark:applications>
      </metadata>
      <metadata owner="https://example.org/bookmark-ext" xmlns:ext="https://example.org/bookmark-ext/schema">
        <ext:rating score="5">favorite</ext:rating>
        <ext:flags>
          <ext:public>true</ext:public>
        </ext:flags>
      </metadata>
    </info>
    <metadata owner="http://www.kde.org">
      <time_added>1234567890</time_added>
      <visit_count>5</visit_count>
    </metadata>
  </bookmark>
  <folder folded="no" toolbar="yes" app:color="blue">
    <title>Favorites</title>
    <bookmark href="https://example.com">
      <title>Example</title>
      <description>Example site</description>
    </bookmark>
    <alias ref="docs" app:aliasType="quicklink"/>
    <separator app:marker="main"/>
  </folder>
</xbel>
