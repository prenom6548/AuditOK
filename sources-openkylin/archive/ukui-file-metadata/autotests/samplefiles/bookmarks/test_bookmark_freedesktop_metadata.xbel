<?xml version="1.0" encoding="UTF-8"?>
<xbel version="1.0"
      xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks"
      xmlns:mime="http://www.freedesktop.org/standards/shared-mime-info">
  <bookmark href="file:///tmp/freedesktop-meta">
    <title>Freedesktop Metadata Bookmark</title>
    <desc>Spec-defined freedesktop metadata placement</desc>
    <bookmark:icon name="legacy-icon" href="file:///tmp/legacy-icon.svg" type="image/svg+xml"/>
    <mime:mime-type type="text/plain"/>
    <info>
      <metadata owner="http://freedesktop.org">
        <bookmark:icon name="folder-remote"
                       href="file:///usr/share/icons/hicolor/64x64/places/folder-remote.png"
                       type="image/png"/>
        <mime:mime-type type="inode/directory"/>
        <bookmark:private>true</bookmark:private>
        <bookmark:groups>
          <bookmark:group>files</bookmark:group>
        </bookmark:groups>
        <bookmark:applications>
          <bookmark:application name="Files" count="3"/>
          <bookmark:application name="Viewer" exec="'viewer %u'"/>
        </bookmark:applications>
      </metadata>
    </info>
  </bookmark>
</xbel>
