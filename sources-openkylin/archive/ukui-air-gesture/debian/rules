#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release

override_dh_auto_install:
	dh_auto_install

override_dh_dwz:
	dh_dwz --exclude=venv

override_dh_strip:
	dh_strip --exclude=venv
override_dh_shlibdeps:
	dh_shlibdeps --exclude=venv
