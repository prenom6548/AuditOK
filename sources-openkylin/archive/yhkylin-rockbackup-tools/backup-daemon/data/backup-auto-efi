            #  excludes="${excludes} --exclude=/var/cache/kylin-system-updater"
            excludes="${excludes} --exclude=/var/lib/kylin-system-updater/remain"
        fi
    fi
    # 兼容以前的老备份数据，后面可以尝试去掉此条件的逻辑
