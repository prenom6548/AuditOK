<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
    <interface name="org.ukui.NotificationSettings">
        <method name="IsAlarmSoundAllowed">
            <arg name="alarm_sound_allowed" type="b" direction="out"/>
        </method>
        <method name="IsSoundAllowed">
            <arg name="desktop_entry" type="s" direction="in"/>
            <arg name="sound_allowed" type="b" direction="out"/>
        </method>
        <method name="IsDND">
            <arg name="dnd" type="b" direction="out"/>
        </method>
        <method name="SetDND">
            <arg name="enable" type="b" direction="in"/>
        </method>
        <signal name="AlarmSoundAllowedChanged">
            <arg name="alarm_sound_allowed" type="b" direction="out"/>
        </signal>
        <signal name="DNDChanged">
            <arg name="dnd" type="b" direction="out"/>
        </signal>
    </interface>
</node>
