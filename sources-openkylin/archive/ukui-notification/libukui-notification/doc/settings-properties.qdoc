/*!
    \namespace UkuiNotification::SettingsProperty
    \inmodule UkuiNotification
    \brief 包含通知设置属性的枚举和类型定义.
*/

/*!
    \enum UkuiNotification::SettingsProperty::Property
    The Property enum contains all settings property types.

    \value Invalid = 0                      无效值
    \value ScheduleTurnOnDND                是否在计划时间范围内自动开启勿扰模式，bool类型，默认值false
    \value ScheduleTurnOnDNDTime            勿扰模式开启时间，QTime类型，默认值00:00
    \value ScheduleTurnOffDNDTime           勿扰模式结束时间，QTime类型，默认值00:00
    \value DNDWhileMultiScreen              是否多屏启动时是否启动勿扰模式，bool类型，默认值false
    \value DNDWhileFullScreen               是否全屏状态下是否启动勿扰模式，bool类型，默认值false
    \value NotifyAlarmWhileDND              是否勿扰模式下是否允许闹钟提示，bool类型，默认值false

    \value ReceiveNotificationsFromApps     是否获取来自应用程序的通知，bool类型，默认值true
    \value AllowNotify                      是否接收当前应用通知，bool类型，默认值true
    \value AllowSound                       是否打开通知提示声，bool类型，默认值true
    \value ShowContentOnLockScreen          是否锁屏界面是否显示通知内容信息，bool类型，默认值false
    \value ShowNotificationOnLockScreen     是否锁屏界面是否显示通知，bool类型，默认值false
    \value ConfigurationSource = 100        用于标记配置来源
 */

/*!
    \typedef PropertyMap
    \relates UkuiNotification::SettingsProperty

    同 QMap<Property, QVariant>, 用于存储应用的通知设置属性和值 .
*/

/*!
    \variable UkuiNotification::GLOBAL_SETTINGS
    \brief 包含通知全局配置属性的列表.
*/

/*!
    \variable UkuiNotification::SINGLE_APPLICATION_SETTINGS
    \brief 包含单个应用的通知配置属性的列表.
*/