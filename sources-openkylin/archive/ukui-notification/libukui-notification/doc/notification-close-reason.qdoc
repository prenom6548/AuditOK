/*!
    \class UkuiNotification::NotificationCloseReason
    \inmodule UkuiNotification
    \inheaderfile notification-close-reason.h
    \brief 表示通知关闭原因的类，提供了枚举 CloseReason
*/

/*!
    \enum NotificationCloseReason::CloseReason
    表示通知关闭原因的枚举
    \value Expired 通知已过期
    \value DismissedByUser 通知被用户关闭
    \value Revoked 通知被发送者通过调用 CloseNotification 接口关闭
    \value Undefined 未定义
*/