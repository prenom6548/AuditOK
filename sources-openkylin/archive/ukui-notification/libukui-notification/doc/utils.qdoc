
/*!
    \namespace UkuiNotification::Utils
    \inmodule UkuiNotification
    \brief 提供一些方便的接口.
 */

/*!
    \fn UkuiSearch::ApplicationInfo& UkuiNotification::Utils::applicationInfo()
    获取全局 UkuiSearch::ApplicationInfo 实例.
 */

/*!
    \fn QString UkuiNotification::Utils::desktopEntryFromPid(uint pid, bool isFullPath = false)
    根据进程号 \a pid 获取应用的 desktop 文件，\a isFullPath 是否获取全路径的标志位。
 */

/*!
    \fn QString UkuiNotification::Utils::displayFromPid(uint pid)
    根据进程号 \a pid 获取应用所在的 DISPLAY
 */

/*!
    \fn QString UkuiNotification::Utils::desktopEntryFromName(QString desktopFileName)
    根据 \a desktopFileName 文件名（不带后缀）获取 desktop 全路径。
 */

/*!
    \fn inline QString UkuiNotification::Utils::desktopEntry2Name(const QString& desktopFileName)
    Returns desktop 文件名（不含后缀）,从 \a desktopFileName 文件全路径截取。
 */

/*!
    \fn QString UkuiNotification::Utils::appNameForDesktopEntry(const QString& desktopFileName)
    通过 desktop 全路径获取应用名称获取应用名称。
 */

/*!
    \macro StringListDiff
    \relates UkuiNotification::Utils
    返回 a 中存在 b 中不存在的元素, 求差集
    \code
        StringListDiff(a, b)
    \endcode
 */

