/*!
    \module UkuiNotification
    \title Ukui Notification C++ Classes
    \brief 提供 Ukui Notification 开发接口的C++类实现.
*/

/*!
    \namespace UkuiNotification
    \inmodule UkuiNotification
    \keyword UkuiNotification Namespace
    \cmakepackage ukui-notification

    \brief The UkuiNotification namespace .
*/

/*!
    \page ukui-notification.html
    \title Ukui Notification

    ukui-notificaton包含UKUI桌面环境的通知服务、通知开发接口和通知控制插件。本文档重点介绍通知开发接口的使用。
    \list
        \li ukui-notification-server: 通知服务
        \li libukui-notification: 通知开发接口
        \li notification-ukcc-plugin: 通知控制插件
    \endlist

    \section1 通知服务
        ukui-notifiaction-server提供了遵循freedesktop \l{https://specifications.freedesktop.org/notification-spec/notification-spec-latest.html}{通知协议}的通知服务接口。

        \section2 支持的Capabilities
            \table 80%
            \header
                \li Capability
                \li 描述
            \row
                \li actions
                \li 支持通知操作按钮
            \row
                \li body
                \li 支持富文本内容
            \row
                \li body-hyperlinks
                \li 支持内容中的超链接
            \row
                \li persistence
                \li 支持持久化通知
            \row
                \li sound
                \li 支持通知声音提示
            \endtable

        \section2 扩展hints
            \table
            \header
                \li Hint
                \li 描述
            \row
                \li x-ukui-display
                \li 标识通知弹窗应该显示在哪个DISPLAY上
            \endtable

        \section2 扩展接口
            \table 80%
            \header
                \li 接口名称
                \li 参数
                \li 返回值
                \li 描述
            \row
                \li org.ukui.NotificationServer.UpdateUnreadMessagesNumber
                \li String desktop_entry, UInt32 number
                \li void
                \li 更新应用的未读消息数量
            \row
                \li org.ukui.NotificationServer.RegisterNotificationControl
                \li String desktop_entry
                \li void
                \li 注册应用的通知控制
            \endtable
    \section1 通知开发接口
        通知提供了接口方便其他应用注册为通知客户端，接收通知服务发来的通知以及与通知服务进行其他交互。

        \section2 使用
            CMake:
            \code
                find_package(ukui-notification
                target_link_libraries(yourapp ukui-notification))
            \endcode

            QMake:
            \code
                CONFIG += link_pkgconfig
                PKGCONFIG += ukui-notification
            \endcode

        \section2 关键接口
            \table 80%
            \header
                \li Class/NameSpace
                \li 功能描述
            \row
                \li UkuiNotification
                \li 通知系统的全局命名空间
            \row
                \li UkuiNotification::NotificationClient
                \li 通知系统客户端接口
            \row
                \li UkuiNotification::NotificationCloseReason
                \li 通知关闭原因的类，提供了枚举 CloseReason
            \row
                \li UkuiNotification::NotificationGlobalSettings
                \li 提供通知系统的全局配置管理功能
            \row
                \li UkuiNotification::PopupNotification
                \li 表示一条通知，包含一条通知消息的全部
            \row
                \li UkuiNotification::SettingsPropertiesInfo
                \li 封装通知设置属性的元数据信息
            \row
                \li UkuiNotification::SingleApplicationSettings
                \li 表示单个应用的通知设置
            \row
                \li UkuiNotification::ApplicationsSettings
                \li 提供应用程序通知设置的管理功能
            \endtable
    \section1 通知控制插件

        控制面板通知插件，方便用户设置应用通知的权限。

        \image plugin_ui.png

*/
