From: Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>
Date: Fri, 5 Jun 2026 17:15:23 +0800
Subject: local-disable-libnss-db

Disable libnss-db as the format is not compatible with the libnss-db package, and is
architecture dependent.
---
 nss/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/nss/Makefile b/nss/Makefile
index 1c48bd0..c04dde5 100644
--- a/nss/Makefile
+++ b/nss/Makefile
@@ -387,7 +387,7 @@ tests += tst-cancel-getpwuid_r
 endif
 
 # Specify rules for the nss_* modules.  We have some services.
-services		:= files db compat
+services		:= files compat
 
 extra-libs		= $(services:%=libnss_%)
 # These libraries will be built in the `others' pass rather than
