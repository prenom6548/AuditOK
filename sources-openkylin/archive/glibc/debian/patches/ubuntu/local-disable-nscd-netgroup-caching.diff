From: Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>
Date: Fri, 5 Jun 2026 17:15:24 +0800
Subject: local-disable-nscd-netgroup-caching

---
 nscd/nscd.conf | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/nscd/nscd.conf b/nscd/nscd.conf
index 487ffe4..0404bf7 100644
--- a/nscd/nscd.conf
+++ b/nscd/nscd.conf
@@ -84,7 +84,9 @@
 	shared			services	yes
 	max-db-size		services	33554432
 
-	enable-cache		netgroup	yes
+# netgroup caching is known-broken, so disable it in the default config,
+# see: https://bugs.launchpad.net/ubuntu/+source/eglibc/+bug/1068889
+	enable-cache		netgroup	no
 	positive-time-to-live	netgroup	28800
 	negative-time-to-live	netgroup	20
 	suggested-size		netgroup	211
