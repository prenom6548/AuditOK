From: Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>
Date: Fri, 5 Jun 2026 17:15:22 +0800
Subject: local-remove-manual

The GNU Libc Reference manual has to be removed for licensing reasons.
But some files have a dependency on manual/errno.texi; the easiest
solution is to drop those dependencies and make sure that MAKEINFO=:
so that no target depends on manual/*.texi files.
---
 elf/Makefile               | 3 +--
 stdio-common/Makefile      | 2 +-
 sysdeps/mach/hurd/Makefile | 2 +-
 3 files changed, 3 insertions(+), 4 deletions(-)

diff --git a/elf/Makefile b/elf/Makefile
index 11029be..959aedc 100644
--- a/elf/Makefile
+++ b/elf/Makefile
@@ -3069,9 +3069,8 @@ $(objpfx)tst-ro-dynamic-mod.so: $(objpfx)tst-ro-dynamic-mod.os \
 		$(objpfx)tst-ro-dynamic-mod.os
 
 $(objpfx)tst-rtld-list-diagnostics.out: tst-rtld-list-diagnostics.py \
-  $(..)manual/dynlink.texi $(objpfx)$(rtld-installed-name)
+  $(objpfx)$(rtld-installed-name)
 	$(PYTHON) tst-rtld-list-diagnostics.py \
-	  --manual=$(..)manual/dynlink.texi \
 	  "$(test-wrapper-env) $(objpfx)$(rtld-installed-name) --list-diagnostics" \
 	  > $@; \
 	$(evaluate-test)
diff --git a/stdio-common/Makefile b/stdio-common/Makefile
index 2109448..930a0fb 100644
--- a/stdio-common/Makefile
+++ b/stdio-common/Makefile
@@ -489,7 +489,7 @@ endif
 endif
 endif # $(run-built-tests)
 
-tests-special += $(objpfx)tst-errno-manual.out
+# tests-special += $(objpfx)tst-errno-manual.out
 
 include ../Rules
 
diff --git a/sysdeps/mach/hurd/Makefile b/sysdeps/mach/hurd/Makefile
index 9c9eb86..7ca6951 100644
--- a/sysdeps/mach/hurd/Makefile
+++ b/sysdeps/mach/hurd/Makefile
@@ -94,7 +94,7 @@ $(common-objpfx)errnos.d: $(mach-errnos-deps)
 	echo >> $@t
 	mv -f $@t $@
 
-$(hurd)/bits/errno.h: $(common-objpfx)stamp-errnos ;
+$(hurd)/bits/errno-disabled.h: $(common-objpfx)stamp-errnos ;
 $(common-objpfx)stamp-errnos: $(hurd)/errnos.awk $(errno.texinfo) \
 			      $(mach-errnos-deps) $(common-objpfx)errnos.d
 	mkdir -p $(hurd-objpfx)bits
