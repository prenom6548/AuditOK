Subject: local-sigaction

---
 sysdeps/unix/sysv/linux/arm/libc_sigaction.c | 13 ++++---------
 1 file changed, 4 insertions(+), 9 deletions(-)

diff --git a/sysdeps/unix/sysv/linux/arm/libc_sigaction.c b/sysdeps/unix/sysv/linux/arm/libc_sigaction.c
index c35a8a4..96bc198 100644
--- a/sysdeps/unix/sysv/linux/arm/libc_sigaction.c
+++ b/sysdeps/unix/sysv/linux/arm/libc_sigaction.c
@@ -22,15 +22,10 @@ extern void __default_rt_sa_restorer (void);
 
 #define SET_SA_RESTORER(kact, act)				\
  ({								\
-   if ((kact)->sa_flags & SA_RESTORER)				\
-     (kact)->sa_restorer = (act)->sa_restorer;			\
-   else								\
-     {								\
-       (kact)->sa_restorer = ((kact)->sa_flags & SA_SIGINFO)	\
-			     ? __default_rt_sa_restorer		\
-			     : __default_sa_restorer;		\
-       (kact)->sa_flags |= SA_RESTORER;				\
-     }								\
+   (kact)->sa_restorer = ((kact)->sa_flags & SA_SIGINFO)	\
+			 ? __default_rt_sa_restorer		\
+			 : __default_sa_restorer;		\
+   (kact)->sa_flags |= SA_RESTORER;				\
  })
 
 #define RESET_SA_RESTORER(act, kact)				\
