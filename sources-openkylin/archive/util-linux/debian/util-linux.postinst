#!/bin/sh
set -e

# Due to UL_REQUIRES_LINUX([more]), only set up pager alternative on linux.
OS=#DEB_HOST_ARCH_OS#
if [ "${OS}" = "linux" ] && command -v update-alternatives >/dev/null 2>&1; then
  update-alternatives --install /usr/bin/pager pager /bin/more 50 \
    --slave /usr/share/man/man1/pager.1.gz pager.1.gz \
    /usr/share/man/man1/more.1.gz
fi

#DEBHELPER#
