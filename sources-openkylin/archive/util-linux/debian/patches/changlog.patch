-
-#. type: Labeled list
-#: ../term-utils/agetty.8.adoc:286
-#, no-wrap
-msgid "u"
-msgstr "u"
-
-#. type: Plain text
-#: ../term-utils/agetty.8.adoc:288
-msgid "Insert the number of current users logged in."
-msgstr "Inserta el número de usuarios conectados en ese momento."
-
-#. type: Labeled list
-#: ../term-utils/agetty.8.adoc:289
