-#. type: Plain text
-#: ../schedutils/coresched.1.adoc:126
-msgid "*chrt*(1), *nice*(1), *renice*(1), *taskset*(1), *ptrace*(2), *sched*(7)"
-msgstr "*chrt*(1), *nice*(1), *renice*(1), *taskset*(1), *ptrace*(2), *sched*(7)"
