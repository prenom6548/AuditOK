-
-#. type: Plain text
-#: ../disk-utils/mkfs.bfs.8.adoc:16
-msgid "mkfs.bfs - make an SCO bfs filesystem"
-msgstr ""
-
-#. type: Plain text
-#: ../disk-utils/mkfs.bfs.8.adoc:20
-#, fuzzy
-#| msgid "*su* [options] [*-*] [_user_ [_argument_...]]\n"
-msgid "*mkfs.bfs* [options] _device_ [_block-count_]"
