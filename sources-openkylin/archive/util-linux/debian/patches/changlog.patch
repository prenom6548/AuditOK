-#. type: Labeled list
-#: ../misc-utils/findmnt.8.adoc:227 ../misc-utils/lsblk.8.adoc:222
-#: ../sys-utils/mount.8.adoc:1690 ../sys-utils/mountpoint.1.adoc:54
