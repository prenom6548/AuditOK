-msgstr " %s [opções] <programa> [argumentos ...]\n"
-
-#. TRANSLATORS: Keep {colon} untranslated.
-#. type: Labeled list
-#: ../schedutils/taskset.1.adoc:89
-#, no-wrap
-msgid "You can also retrieve the CPU affinity of an existing task{colon}"
