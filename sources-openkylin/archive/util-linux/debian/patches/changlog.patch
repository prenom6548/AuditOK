-msgid ""
-"int ret = ll2_write_entry (NULL, user, login_time, \"pts/0\",\n"
-" \t                   \"192.168.122.1\", NULL, &error);\n"
-msgstr ""
-"int ret = ll2_write_entry (NULL, user, login_time, \"pts/0\",\n"
-" \t                   \"192.168.122.1\", NULL, &error);\n"
