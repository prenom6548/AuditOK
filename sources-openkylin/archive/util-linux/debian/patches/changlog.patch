-#. type: Plain text
-#: ../disk-utils/fdisk.8.adoc:20
-msgid "fdisk - manipulate disk partition table"
-msgstr ""
-
-#. type: Plain text
-#: ../disk-utils/fdisk.8.adoc:24
-#, fuzzy
-#| msgid "*fdisk* [options] _device_\n"
-msgid "*fdisk* [options] _device_"
-msgstr "*fdisk* [opciones] _dispositivo_\n"
-
