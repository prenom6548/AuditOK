-#| "*mkswap*(8),\n"
-#| "*swapon*(8)\n"
-msgid "*uuidgen*(1), *mkswap*(8), *swapon*(8)"
-msgstr ""
-"*uuidgen*(1),\n"
-"*mkswap*(8),\n"
-"*swapon*(8)\n"
