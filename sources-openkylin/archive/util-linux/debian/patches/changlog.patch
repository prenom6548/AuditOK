-msgstr "*{command} new* \\-- _команда_ [_аргумент_...]"
-
-#. type: Labeled list
-#: ../schedutils/coresched.1.adoc:85
-#, no-wrap
-msgid "Copy the cookie from the current {command} process another task with pid _456_{colon}"
-msgstr ""
-
