-
-#. type: Plain text
-#: ../misc-utils/lastlog2.8.adoc:39
-msgid "Print only last login records older than _DAYS_."
-msgstr ""
-
-#. type: Labeled list
-#: ../misc-utils/lastlog2.8.adoc:40 ../sys-utils/dmesg.1.adoc:41
-#, no-wrap
