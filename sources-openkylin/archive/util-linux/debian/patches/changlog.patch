-#, fuzzy, no-wrap
-msgid "*-S*, *--scsi*"
-msgstr " -S, --scsi           exibe informação sobre dispositivos SCSI\n"
-
-#. type: Plain text
-#: ../misc-utils/lsblk.8.adoc:157
-msgid ""
-"Output info about SCSI devices only. All partitions, slaves and holder "
-"devices are ignored."
-msgstr ""
-
-#. type: Labeled list
