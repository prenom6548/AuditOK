-#, no-wrap
-msgid "BLKID_SUBLKS_UUID"
-msgstr "BLKID_SUBLKS_UUID"
-
-#. type: Plain text
-#: ../libblkid/libblkid.3.adoc:69
-msgid "UUID - filesystem UUID (lower case)"
-msgstr "UUID - Dateisystem-UUID (Kleinschreibung)"
