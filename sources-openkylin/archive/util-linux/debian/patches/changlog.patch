-msgstr ""
-
-#. type: Plain text
-#: ../misc-utils/findmnt.8.adoc:223
-msgid "overrides the default location of the _fstab_ file"
-msgstr ""
-
-#. type: Labeled list
-#: ../misc-utils/findmnt.8.adoc:224
