-
-#. type: Plain text
-#: ../misc-utils/lsblk.8.adoc:193
-msgid ""
-"Reads data directly from the device using libblkid. If unsuccessful, it "
-"continues to the next probing method."
-msgstr ""
-
-#. type: Labeled list
-#: ../misc-utils/lsblk.8.adoc:193
-#, fuzzy, no-wrap
-#| msgid "*-f*, *--fast*"
