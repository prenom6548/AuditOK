-msgid "the system status file."
-msgstr ""
-
-#. type: Labeled list
-#: ../term-utils/agetty.8.adoc:312
-#, no-wrap
-msgid "_/etc/issue_"
-msgstr "_/etc/issue_"
-
-#. type: Plain text
-#: ../term-utils/agetty.8.adoc:314
-msgid "printed before the login prompt."
-msgstr ""
-
