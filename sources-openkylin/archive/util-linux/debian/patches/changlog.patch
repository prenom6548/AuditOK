+echo -n | $TS_CMD_PIPESZ --check --get --file "/dev/stdin" 2>> $TS_ERRLOG | sed -E 's/^(.+[[:space:]])[0-9]+([[:space:]][0-9]+)$/\1DEFAULT_PIPE_SIZE\2/' >> $TS_OUTPUT
 [[ $? -ne 0 ]] && ts_logerr "expected success"
