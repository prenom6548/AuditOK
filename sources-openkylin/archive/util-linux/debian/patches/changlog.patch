-#. type: Plain text
-#: ../disk-utils/fdformat.8.adoc:69
-msgid ""
-"This utility does not handle USB floppy disk drives. Use *ufiformat*(8) "
-"instead."
-msgstr ""
-
-#. type: Plain text
-#: ../disk-utils/fdformat.8.adoc:73
-msgid "mailto:almesber@nessie.cs.id.ethz.ch[Werner Almesberger]"
-msgstr ""
