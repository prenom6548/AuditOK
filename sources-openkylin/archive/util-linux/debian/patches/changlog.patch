-#: ../disk-utils/blockdev.8.adoc:60
-#, no-wrap
-msgid "*--getdiskseq*"
-msgstr "*--getdiskseq*"
-
-#. type: Plain text
-#: ../disk-utils/blockdev.8.adoc:62
-msgid "Get disk sequence number."
-msgstr "Добавља број секвенце диска."
-
