-#, no-wrap
-msgid ""
-"# lsfd --summary=only --json \\\n"
-"\t-C 'netlink sockets':'(NAME =~ \"NETLINK:.*\")' \\\n"
-"\t-C 'unix sockets':'(NAME =~ \"UNIX:.*\")'\n"
-"{\n"
-"   \"lsfd-summary\": [\n"
-"      {\n"
-"\t \"value\": 15,\n"
-"\t \"counter\": \"netlink sockets\"\n"
-"      },{\n"
-"\t \"value\": 798,\n"
-"\t \"counter\": \"unix sockets\"\n"
-"      }\n"
-"   ]\n"
-"}\n"
-msgstr ""
