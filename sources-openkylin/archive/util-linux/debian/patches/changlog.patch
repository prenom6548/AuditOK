-#. type: Plain text
-#: ../disk-utils/fdisk.8.adoc:72
-msgid ""
-"The default list of columns may be extended if _list_ is specified in the "
-"format _{plus}list_ (e.g., *-o {plus}UUID*)."
-msgstr ""
-
-#. type: Labeled list
-#: ../disk-utils/fdisk.8.adoc:74
-#, fuzzy, no-wrap
-#| msgid "*-P*, *--pty*"
-msgid "*-s*, *--getsz*"
-msgstr "*-P*, *--pty*"
-
