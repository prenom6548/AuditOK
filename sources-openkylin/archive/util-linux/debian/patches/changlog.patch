-#: ../term-utils/setterm.1.adoc:80
-#, fuzzy, no-wrap
-msgid "*--cursor* **on**|**off**"
-msgstr " --cursor on|off               exibe o cursor\n"
-
-#. type: Plain text
-#: ../term-utils/setterm.1.adoc:82
-#, fuzzy
-msgid "Turns the terminal's cursor on or off."
-msgstr " --cursor on|off               exibe o cursor\n"
-
