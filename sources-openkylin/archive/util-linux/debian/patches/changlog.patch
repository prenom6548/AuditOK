-#. type: Plain text
-#: ../disk-utils/partx.8.adoc:142
-msgid "*addpart*(8), *delpart*(8), *fdisk*(8), *parted*(8), *partprobe*(8)"
-msgstr "*addpart*(8), *delpart*(8), *fdisk*(8), *parted*(8), *partprobe*(8)"
