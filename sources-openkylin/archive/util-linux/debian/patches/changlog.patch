-#, fuzzy, no-wrap
-#| msgid "*-h*, *--help*"
-msgid "*-M*, *--merge*"
-msgstr "*-h*, *--help*"
-
-#. type: Plain text
-#: ../misc-utils/lsblk.8.adoc:81
-msgid ""
-"Group parents of sub-trees to provide more readable output for RAIDs and "
