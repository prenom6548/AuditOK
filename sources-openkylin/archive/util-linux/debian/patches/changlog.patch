-
-#. type: delimited block .
-#: ../lsfd-cmd/lsfd.1.adoc:680
-#, no-wrap
-msgid "# lsfd -Q 'NAME =~ \".\\*/dconf/.*\"'\n"
-msgstr ""
-
-#. type: Labeled list
-#: ../lsfd-cmd/lsfd.1.adoc:682
-#, no-wrap
-msgid "List files opened in a QEMU virtual machine: "
