-msgid "*--getiomin*"
-msgstr "*--getiomin*"
-
-#. type: Plain text
-#: ../disk-utils/blockdev.8.adoc:71
-msgid "Get minimum I/O size."
-msgstr "ermittelt die minimale E/A-Größe."
