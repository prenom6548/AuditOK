-#, no-wrap
-msgid "BLKID_SUBLKS_LABELRAW"
-msgstr "BLKID_SUBLKS_LABELRAW"
-
-#. type: Plain text
-#: ../libblkid/libblkid.3.adoc:65
-msgid "LABEL_RAW - raw label from FS superblock"
-msgstr "LABEL_RAW - Rohbezeichnung aus dem Superblock des Dateisystems"
-
-#. type: Labeled list
