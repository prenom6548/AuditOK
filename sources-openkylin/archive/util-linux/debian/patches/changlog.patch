-
-#. type: delimited block .
-#: ../lsfd-cmd/lsfd.1.adoc:685
-#, no-wrap
-msgid "# lsfd -Q '(COMMAND =~ \".\\*qemu.*\") and (FD >= 0)'\n"
-msgstr ""
-
-#. type: Labeled list
-#: ../lsfd-cmd/lsfd.1.adoc:687
-#, no-wrap
-msgid "List timerfd files expired within 0.5 seconds: "
