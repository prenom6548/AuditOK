-msgstr "partx --show - /dev/sdb3"
-
-#. type: Plain text
-#: ../disk-utils/partx.8.adoc:115
-msgid ""
-"Lists all subpartitions on _/dev/sdb3_ (the device is used as whole-disk)."
-msgstr ""
-
-#. type: Labeled list
-#: ../disk-utils/partx.8.adoc:116
