-#, no-wrap
-msgid "*-c*"
-msgstr ""
-
-#. type: Plain text
-#: ../disk-utils/mkfs.bfs.8.adoc:52
-msgid "Option *-V* only works as *--version* when it is the only option."
-msgstr ""
-
-#. type: Plain text
-#: ../disk-utils/mkfs.bfs.8.adoc:56
-msgid ""
