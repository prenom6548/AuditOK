-#, fuzzy, no-wrap
-#| msgid "*-h*, *--help*"
-msgid "*-x*, *--hex*"
-msgstr "*-h*, *--help*"
-
-#. type: Plain text
-#: ../misc-utils/uuidgen.1.adoc:60
-msgid "Interpret name _name_ as a hexadecimal string."
-msgstr ""
-
-#. type: Plain text
-#: ../misc-utils/uuidgen.1.adoc:66
