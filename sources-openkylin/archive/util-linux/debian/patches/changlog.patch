-msgstr "*-V*, *--version*"
-
-#. type: Plain text
-#: ../misc-utils/lsblk.8.adoc:84
-msgid ""
-"Output info about device owner, group and mode. This option is equivalent to "
-"*-o NAME,SIZE,OWNER,GROUP,MODE*."
-msgstr ""
-
