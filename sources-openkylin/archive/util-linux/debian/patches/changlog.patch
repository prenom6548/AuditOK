-" # zramctl --find --size 1024M\n"
-" /dev/zram0\n"
-" # mkswap /dev/zram0\n"
-" # swapon /dev/zram0\n"
-" ...\n"
-" # swapoff /dev/zram0\n"
-" # zramctl --reset /dev/zram0\n"
-msgstr ""
-" # zramctl --find --size 1024M\n"
-" /dev/zram0\n"
-" # mkswap /dev/zram0\n"
-" # swapon /dev/zram0\n"
-" ...\n"
-" # swapoff /dev/zram0\n"
-" # zramctl --reset /dev/zram0\n"
