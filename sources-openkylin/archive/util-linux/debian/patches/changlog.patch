-#: ../term-utils/agetty.8.adoc:140
-#, fuzzy
-msgid "Change root to the specified directory."
-msgstr "a alteração de diretório para raiz do sistema falhou"
-
-#. type: Labeled list
-#: ../term-utils/agetty.8.adoc:141
-#, fuzzy, no-wrap
-msgid "*-R*, *--hangup*"
