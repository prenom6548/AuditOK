-msgstr "sed 's/#.*//' /etc/fstab | column --table --table-columns SOURCE,TARGET,TYPE,OPTIONS,PASS,FREQ --table-right PASS,FREQ\n"
-
-#. type: Plain text
-#: ../text-utils/column.1.adoc:221
