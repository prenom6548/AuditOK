-msgid ""
-"time_t login_time = time(0); // Get the system time\n"
-"char   *error = NULL;\n"
-"const  char *user = \"root\";\n"
-msgstr ""
-"time_t login_time = time(0); // Добавља системско време\n"
-"char   *error = NULL;\n"
-"const  char *user = \"root\";\n"
