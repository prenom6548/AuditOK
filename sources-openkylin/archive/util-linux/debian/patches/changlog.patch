-#, no-wrap
-msgid "*--getra*"
-msgstr "*--getra*"
-
-#. type: Plain text
-#: ../disk-utils/blockdev.8.adoc:83
-msgid "Print readahead (in 512-byte sectors)."
-msgstr "gibt den Readahead-Wert aus (in 512-Byte-Sektoren)."
