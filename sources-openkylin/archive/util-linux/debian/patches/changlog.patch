-#| "*talk*(1),\n"
-#| "*write*(1),\n"
-#| "*shutdown*(8)\n"
-msgid "*mesg*(1), *talk*(1), *write*(1), *shutdown*(8)"
-msgstr ""
-"*mesg*(1),\n"
-"*talk*(1),\n"
-"*write*(1),\n"
-"*shutdown*(8)\n"
