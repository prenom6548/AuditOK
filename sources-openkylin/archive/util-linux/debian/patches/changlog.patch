-msgstr ""
-
-#. type: Labeled list
-#: ../sys-utils/mount.8.adoc:1578
-#, fuzzy, no-wrap
-msgid "**verity.fecoffset=**__offset__"
-msgstr "<tam> e <posição>"
-
-#. type: delimited block _
-#: ../sys-utils/mount.8.adoc:1580
-msgid ""
