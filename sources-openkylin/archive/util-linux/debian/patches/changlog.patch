-#, fuzzy, no-wrap
-msgid "*--half-bright* **on**|**off**"
-msgstr " --half-bright on|off          escurecido\n"
-
-#. type: Plain text
-#: ../term-utils/setterm.1.adoc:97
-msgid ""
