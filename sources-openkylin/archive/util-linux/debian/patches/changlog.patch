-#: ../misc-utils/enosys.1.adoc:82 ../misc-utils/lsclocks.1.adoc:103
-#: ../misc-utils/waitpid.1.adoc:56
-msgid "mailto:thomas@t-8ch.de[Thomas Weißschuh]"
-msgstr "mailto:thomas@t-8ch.de[Thomas Weißschuh]"
-
