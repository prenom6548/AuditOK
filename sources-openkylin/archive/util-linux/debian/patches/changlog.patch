-
-#. type: Plain text
-#: ../disk-utils/cfdisk.8.adoc:141 ../disk-utils/fdisk.8.adoc:211
-#: ../disk-utils/mkfs.minix.8.adoc:74 ../disk-utils/mkswap.8.adoc:102
