-#: ../misc-utils/fadvise.1.adoc:2
-#, no-wrap
-msgid "fadvise(1)"
-msgstr "fadvise(1)"
-
-#. type: Plain text
-#: ../misc-utils/fadvise.1.adoc:12
-msgid "fadvise - utility to use the posix_fadvise system call"
-msgstr ""
-
-#. type: Plain text
-#: ../misc-utils/fadvise.1.adoc:16
-msgid "*fadvise* [*-a* _advice_] [*-o* _offset_] [*-l* _length_] _filename_"
-msgstr ""
-
-#. type: Plain text
