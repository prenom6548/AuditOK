-#, no-wrap
-msgid ""
-"uuidd -p /tmp/uuidd.pid -s /tmp/uuidd.socket\n"
-"uuidd -d -r -n 42 -s /tmp/uuidd.socket\n"
-"uuidd -d -k -s /tmp/uuidd.socket\n"
-msgstr ""
-"uuidd -p /tmp/uuidd.pid -s /tmp/uuidd.socket\n"
-"uuidd -d -r -n 42 -s /tmp/uuidd.socket\n"
-"uuidd -d -k -s /tmp/uuidd.socket\n"
-
