-#: ../term-utils/agetty.8.adoc:315
-#, no-wrap
-msgid "_/etc/os-release /usr/lib/os-release_"
-msgstr "_/etc/os-release /usr/lib/os-release_"
-
-#. type: Plain text
-#: ../term-utils/agetty.8.adoc:317
-msgid "operating system identification data."
-msgstr ""
-
