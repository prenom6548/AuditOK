-msgid "*sfdisk --list --label-nested=mbr /dev/sda*"
-msgstr "*sfdisk --backup /dev/sda*\n"
-
-#. type: Plain text
-#: ../disk-utils/sfdisk.8.adoc:440
-msgid "Print protective MBR on device with GPT disk label."
-msgstr ""
-
-#. type: Labeled list
-#: ../disk-utils/sfdisk.8.adoc:441
-#, fuzzy, no-wrap
