-msgstr "Controlor pentru sursa de impulsuri pe secundă (PPS) a liniei seriale."
-
-#. type: Labeled list
-#: ../sys-utils/ldattach.8.adoc:71
-#, no-wrap
-msgid "*GSM0710*(*21*)"
-msgstr "*GSM0710*(*21*)"
-
-#. type: Plain text
