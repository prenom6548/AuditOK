-#. type: Table
-#: ../lib/terminal-colors.d.5.adoc:113
-#, no-wrap
-msgid ""
-"|*\\a* |Bell (ASCII 7)\n"
-"|*\\b* |Backspace (ASCII 8)\n"
-"|*\\e* |Escape (ASCII 27)\n"
-"|*\\f* |Form feed (ASCII 12)\n"
-"|*\\n* |Newline (ASCII 10)\n"
-"|*\\r* |Carriage Return (ASCII 13)\n"
-"|*\\t* |Tab (ASCII 9)\n"
-"|*\\v* |Vertical Tab (ASCII 11)\n"
-"|*\\?* |Delete (ASCII 127)\n"
-"|*\\_* |Space\n"
-"|*\\\\* |Backslash (\\)\n"
-"|*\\^* |Caret (^)\n"
-"|*\\#* |Hash mark (#)\n"
