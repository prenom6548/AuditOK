-msgstr "*raw* _/dev/raw/raw<N>_ _/dev/<dispositivo-de-bloco>_\n"
-
-#. type: Plain text
-#: ../disk-utils/raw.8.adoc:20
-#, fuzzy
-#| msgid "*raw* *-q* _/dev/raw/raw<N>_\n"
-msgid "*raw* *-q* _/dev/raw/raw<N>_"
-msgstr "*raw* *-q* _/dev/raw/raw<N>_\n"
-
-#. type: Plain text
