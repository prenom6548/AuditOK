-msgstr "# lsfd  -Q 'TYPE == \"UNIX-STREAM\" && UNIX.PATH == \"@/tmp/.X11-unix/X0\"' -oUNIX.PATH,PID,COMMAND,FD,SOCK.STATE,ENDPOINTS\n"
