-#. type: Plain text
-#: ../liblastlog2/man/ll2_write_entry.3.adoc:13
-msgid "ll2_write_entry - Writes a new entry into the database."
-msgstr "ll2_write_entry - scrie o nouă intrare în baza de date"
-
-#. type: Plain text
