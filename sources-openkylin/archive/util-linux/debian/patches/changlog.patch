-#, no-wrap
-msgid "*-J*, *--json*"
-msgstr ""
-
-#. type: Plain text
-#: ../lsfd-cmd/lsfd.1.adoc:46 ../misc-utils/fincore.1.adoc:49
-#: ../misc-utils/findmnt.8.adoc:86 ../misc-utils/lsclocks.1.adoc:28
-#: ../misc-utils/lslocks.8.adoc:45 ../misc-utils/uuidparse.1.adoc:52
