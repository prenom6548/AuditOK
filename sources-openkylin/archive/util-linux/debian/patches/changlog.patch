-
-#. type: Plain text
-#: ../sys-utils/swapon.8.adoc:112
-#, fuzzy
-msgid "usage or syntax error"
-msgstr "Erro de uso ou de sintaxe"
-
-#. type: Plain text
-#: ../sys-utils/swapon.8.adoc:115
-#, fuzzy
-msgid "all swapoff failed on *--all*"
