-
-#. type: Labeled list
-#: ../sys-utils/prlimit.1.adoc:69
-#, no-wrap
-msgid "*-e*, *--nice*[**=**_limits_]"
-msgstr "*-e*, *--nice*[**=**_ограничења_]"
-
-#. type: Plain text
-#: ../sys-utils/prlimit.1.adoc:71
