-
-#. type: Plain text
-#: ../libblkid/libblkid.3.adoc:122
-msgid "BOOT_SYSTEM_ID - ISO9660 boot system identifier"
-msgstr "BOOT_SYSTEM_ID - ISO9660 одредник система подизања"
-
