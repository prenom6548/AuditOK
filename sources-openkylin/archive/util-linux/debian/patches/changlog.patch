-#: ../sys-utils/dmesg.1.adoc:69
-#, no-wrap
-msgid "*-H*, *--human*"
-msgstr "*-H*, *--human*"
-
-#. type: Plain text
-#: ../sys-utils/dmesg.1.adoc:71
-msgid ""
-"Enable human-readable output. See also *--color*, *--reltime* and *--"
-"nopager*."
-msgstr ""
-
