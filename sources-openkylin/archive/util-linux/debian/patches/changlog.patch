-
-#. type: Labeled list
-#: ../misc-utils/cal.1.adoc:161
-#, no-wrap
-msgid "*weeknumber*"
-msgstr ""
-
-#. type: Plain text
-#: ../misc-utils/cal.1.adoc:163
-msgid "The week number requested by the --week=<number> command line option."
-msgstr ""
-
-#. type: Labeled list
-#: ../misc-utils/cal.1.adoc:164
-#, no-wrap
-msgid "*weeks*"
-msgstr ""
-
-#. type: Plain text
-#: ../misc-utils/cal.1.adoc:166
-msgid "The number of the week."
