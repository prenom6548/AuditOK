-#: ../liblastlog2/man/ll2_write_entry.3.adoc:34
-#, no-wrap
-msgid ""
-"time_t login_time = time(0); // Get the system time\n"
-"char   *error = NULL;\n"
-"const  char *user = \"root\";\n"
