-#. type: delimited block .
-#: ../lsfd-cmd/lsfd.1.adoc:700
-#, no-wrap
-msgid "# lsfd  -Q 'TYPE == \"UNIX-STREAM\" && UNIX.PATH == \"@/tmp/.X11-unix/X0\"' -oUNIX.PATH,PID,COMMAND,FD,SOCK.STATE,ENDPOINTS\n"
-msgstr ""
