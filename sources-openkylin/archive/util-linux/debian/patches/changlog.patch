-#, no-wrap
-msgid "choom(1)"
-msgstr "choom(1)"
-
-#. type: Plain text
-#: ../sys-utils/choom.1.adoc:12
-msgid "choom - display and adjust OOM-killer score."
-msgstr ""
-
-#. type: Plain text
-#: ../sys-utils/choom.1.adoc:14
-#, fuzzy
-#| msgid "*choom* *-p* _PID_\n"
-msgid "*choom* *-p* _PID_"
