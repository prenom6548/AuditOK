-msgid ""
-"*fadvise* [*-a* _advice_] [*-o* _offset_] [*-l* _length_] -d _file-"
-"descriptor_"
-msgstr ""
-
-#. type: Plain text
-#: ../misc-utils/fadvise.1.adoc:23
-msgid ""
-"*fadvise* is a simple command wrapping *posix_fadvise*(2) system call that "
-"is for predeclaring an access pattern for file data."
-msgstr ""
-
