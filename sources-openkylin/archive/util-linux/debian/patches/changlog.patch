 ts_init_subtest "pipe-max-size"
-echo -n | $TS_CMD_PIPESZ --check --stdin >> $TS_OUTPUT 2>> $TS_ERRLOG
-[[ $? -ne 0 ]] && ts_logerr "expected success"
-ts_finalize_subtest
+pipeMaxSizeErrFile="$(mktemp)"
+echo -n | $TS_CMD_PIPESZ --check --stdin >> $TS_OUTPUT 2> "$pipeMaxSizeErrFile"
+pipeMaxSizeRc=$?
+cat "$pipeMaxSizeErrFile" >> "$TS_ERRLOG"
+if [ $pipeMaxSizeRc -ne 0 ] && grep -q "Operation not permitted" "$pipeMaxSizeErrFile"; then
+	rm -f "$pipeMaxSizeErrFile"
+	ts_skip_subtest "cannot set pipe buffer size without privileges"
+else
+	rm -f "$pipeMaxSizeErrFile"
+	[[ $pipeMaxSizeRc -ne 0 ]] && ts_logerr "expected success"
+	ts_finalize_subtest
+fi
 
