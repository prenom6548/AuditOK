-msgstr ""
-
-#. type: Plain text
-#: ../misc-utils/findmnt.8.adoc:226
-msgid "overrides the default location of the _mtab_ file"
-msgstr ""
-
-#. type: Labeled list
-#: ../misc-utils/findmnt.8.adoc:227 ../misc-utils/lsblk.8.adoc:222
