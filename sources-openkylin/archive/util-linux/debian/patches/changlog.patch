-#| msgid "*-D*, *--df*"
-msgid "*-I*, *--dfi*"
-msgstr "*-D*, *--df*"
-
-#. type: Plain text
-#: ../misc-utils/findmnt.8.adoc:74
-#, fuzzy
-#| msgid ""
-#| "Imitate the output of *df*(1). This option is equivalent to *-o SOURCE,"
-#| "FSTYPE,SIZE,USED,AVAIL,USE%,TARGET* but excludes all pseudo filesystems. "
-#| "Use *--all* to print all filesystems."
