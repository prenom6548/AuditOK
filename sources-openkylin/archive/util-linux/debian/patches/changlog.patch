-#. type: Plain text
-#: ../disk-utils/fdisk.8.adoc:20
-msgid "fdisk - manipulate disk partition table"
-msgstr ""
-
-#. type: Plain text
-#: ../disk-utils/fdisk.8.adoc:24
-#, fuzzy
