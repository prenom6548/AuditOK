-#. type: Labeled list
-#: ../sys-utils/swapon.8.adoc:133
-#, no-wrap
-msgid "_/dev/sd??_"
-msgstr "_/dev/sd??_"
-
-#. type: Plain text
-#: ../sys-utils/swapon.8.adoc:135
-#, fuzzy
-msgid "standard paging devices"
-msgstr "Habilita dispositivos e arquivos para paginação e troca (swapping).\n"
-
-#. type: Plain text
-#: ../sys-utils/swapon.8.adoc:138
