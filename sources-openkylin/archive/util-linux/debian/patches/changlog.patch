-#: ../login-utils/su.1.adoc:36
-#, fuzzy, no-wrap
-#| msgid "*-c*, **--command**=__command__"
-msgid "*-c*, *--command* __command__"
-msgstr "*-c*, **--command**=__příkaz__"
-
