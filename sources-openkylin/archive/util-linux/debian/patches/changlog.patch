-msgid "For NextStep CDROMs (block_size == 2048), read-only."
-msgstr "Pour les CD-ROM NeXTStep (block_size == 2048) (lecture seule)."
-
-#. type: Labeled list
-#: ../sys-utils/mount.8.adoc:1501
-#, no-wrap
-msgid "*openstep*"
-msgstr "*openstep*"
