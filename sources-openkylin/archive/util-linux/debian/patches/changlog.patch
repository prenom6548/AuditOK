-msgid "*-s*, *--speed* _value_"
-msgstr "*-s*, *--speed* _보전송율_"
-
-#. type: Plain text
-#: ../sys-utils/ldattach.8.adoc:105
-msgid ""
-"Set the speed (the baud rate) of the serial line to the specified _value_."
-msgstr ""
-
-#. type: Labeled list
