-"\t-C 'unix sockets':'(NAME =~ \"UNIX:.*\")'\n"
-"VALUE COUNTER\n"
-"   57 netlink sockets\n"
-" 1552 unix sockets\n"
-msgstr ""
-
-#. type: Labeled list
-#: ../lsfd-cmd/lsfd.1.adoc:714
-#, no-wrap
-msgid "Do the same but print in JSON format: "
