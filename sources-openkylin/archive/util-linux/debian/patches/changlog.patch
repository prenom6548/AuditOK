-#: ../sys-utils/dmesg.1.adoc:66
-msgid "*dmesg --facility=daemon*"
-msgstr ""
-
-#. type: Plain text
-#: ../sys-utils/dmesg.1.adoc:68
-msgid ""
-"will print messages from system daemons only. For all supported facilities "
-"see the *--help* output."
-msgstr ""
