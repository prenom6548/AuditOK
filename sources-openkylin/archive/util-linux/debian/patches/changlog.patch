-msgstr "*-P*, *--numeric-perms*"
-
-#. type: Plain text
-#: ../sys-utils/lsipc.1.adoc:96
-msgid "Print numeric permissions in PERMS column."
-msgstr ""
-
-#. type: Plain text
-#: ../sys-utils/lsipc.1.adoc:110
-msgid "if a serious error occurs."
-msgstr ""
-
-#. type: Plain text
-#: ../sys-utils/lsipc.1.adoc:114
