-#: ../disk-utils/fsck.8.adoc:163
-msgid "mailto:tytso@mit.edu[Theodore Ts'o], mailto:kzak@redhat.com[Karel Zak]"
-msgstr "mailto:tytso@mit.edu[Theodore Ts'o], mailto:kzak@redhat.com[Karel Zak]"
-
