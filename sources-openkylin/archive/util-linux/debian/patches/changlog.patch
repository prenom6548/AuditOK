-#, no-wrap
-msgid "*-q*"
-msgstr "*-q*"
-
-#. type: Plain text
-#: ../disk-utils/blockdev.8.adoc:35
-msgid "Be quiet."
-msgstr "출력하지 않음."
-
-#. type: Labeled list
-#: ../disk-utils/blockdev.8.adoc:36 ../disk-utils/mkfs.cramfs.8.adoc:35
