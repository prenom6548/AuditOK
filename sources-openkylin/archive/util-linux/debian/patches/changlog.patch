-#, no-wrap
-msgid "*-M*"
-msgstr ""
-
-#. type: Plain text
-#: ../disk-utils/fsck.8.adoc:96
-msgid ""
-"Do not check mounted filesystems and return an exit status of 0 for mounted "
-"filesystems."
-msgstr ""
-
-#. type: Labeled list
-#: ../disk-utils/fsck.8.adoc:97
-#, no-wrap
-msgid "*-N*"
-msgstr ""
-
-#. type: Plain text
-#: ../disk-utils/fsck.8.adoc:99
-msgid "Don't execute, just show what would be done."
-msgstr ""
-
