name: "ensemble-embd_cn-clip_512-uint8-text"
platform: "ensemble"
max_batch_size: 0
input [
  {
    name: "product_reviews"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]
output [
  {
    name: "unnorm_text_features"
    data_type: TYPE_FP32
    dims: [ 1024 ]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "tokenizer_cn-clip_512-uint8-text"
      model_version: 1
      input_map {  key: "product_reviews"
        value: "product_reviews"
      }
      output_map {  key: "input_ids"
        value: "input_ids"
      }
    },
    {
      model_name: "embd_cn-clip_512-uint8-text"
      model_version: 1
      input_map {
        key: "text"
        value: "input_ids"
      }
      output_map {
        key: "unnorm_text_features"
        value: "unnorm_text_features"
      }
    }
  ]
}
