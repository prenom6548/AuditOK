name: "embd_cn-clip_512-uint8-image"
platform: "onnxruntime_onnx"
default_model_filename: "vit-b-16.img.QUInt8.onnx"
max_batch_size : 0
input [
  {
    name: "image"
    data_type: TYPE_FP32
    format: FORMAT_NCHW
    dims: [ 3, 224, 224 ]
    reshape { shape: [ 1, 3, 224, 224 ] }
  }
]
output [
  {
    name: "unnorm_image_features"
    data_type: TYPE_FP32
    dims: [ 1024 ]
    reshape { shape: [ 1, 1024 ] }
  }
]
parameters: {
  key: "limit_cpu_usage"
  value: {
    string_value: "true"
  }
}
