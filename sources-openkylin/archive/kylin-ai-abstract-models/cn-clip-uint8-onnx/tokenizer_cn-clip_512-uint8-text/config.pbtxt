name: "tokenizer_cn-clip_512-uint8-text"
backend: "python"
input [
    {
      name: "product_reviews"
      data_type: TYPE_STRING
      dims: [ 1 ]
    }
]
output [
    {
      name: "input_ids"
      data_type: TYPE_INT64
      dims: [ -1 ]
    },
    {
      name: "attention_mask"
      data_type: TYPE_INT64
      dims: [ -1 ]
    }
]
