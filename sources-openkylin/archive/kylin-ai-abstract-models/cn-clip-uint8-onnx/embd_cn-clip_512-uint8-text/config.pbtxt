name: "embd_cn-clip_512-uint8-text"
platform: "onnxruntime_onnx"
default_model_filename: "vit-b-16.txt.QUInt8.onnx"
max_batch_size : 0
input [
  {
    name: "text"
    data_type: TYPE_INT64
    dims: [ 512 ]
    reshape { shape: [ 1, 512 ] }
  }
]
output [
  {
    name: "unnorm_text_features"
    data_type: TYPE_FP32
    dims: [ 1024 ]
    reshape { shape: [ 1, 1024 ] }
  }
]
parameters: {
  key: "limit_cpu_usage"
  value: {
    string_value: "true"
  }
}
