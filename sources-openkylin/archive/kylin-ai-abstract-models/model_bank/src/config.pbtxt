backend: "model_bank"
# backend file : libtriton_model_bank.so
input [
    {
      name: "engine"
      data_type: TYPE_STRING
      dims: [ -1 ]
    },
    {
      name: "key"
      data_type: TYPE_STRING
      dims: [ -1 ]
    }
]
output [
    {
      name: "value"
      data_type: TYPE_STRING
      dims: [ -1 ]
    }
]
