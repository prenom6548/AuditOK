#!/bin/sh
set -e

# 创建目录函数（如果不存在）
create_dir() {
    if [ ! -d "$1" ]; then
        mkdir -p "$1"
        # 可选：设置权限和所有者（根据实际需求调整）
        # chmod 755 "$1"
        # chown root:root "$1"
    fi
}

# 创建指定的目录
create_dir "/opt/appdata/kylin-ai/model-repository"
create_dir "/usr/share/kylin-ai/model-repository"

# 必须以 exit 0 结束，表示成功
exit 0