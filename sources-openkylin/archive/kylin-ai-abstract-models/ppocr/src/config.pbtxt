backend: "ocr"
# backend file : libtriton_ocr.so
max_batch_size: 0
input [
  {
    name: "IN0"
    data_type: TYPE_UINT8
    dims: [ -1, -1, -1 ]
  }
]
output [
  {
    name: "OUT0"
    data_type: TYPE_UINT8
    dims: [ -1 ]
  }
]
instance_group [
  {
    kind: KIND_CPU
  }
]
parameters: {
  key: "det_model"
  value: {
    string_value: "model_det.onnx"
  }
}
parameters: {
  key: "rec_model"
  value: {
    string_value: "model_rec.onnx"
  }
}
parameters: {
  key: "dictionary_file"
  value: {
    string_value: "ppocr_keys_v1.txt"
  }
}
