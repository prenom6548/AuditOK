name: "ensemble-embd_gte-base_uint8-text"
platform: "ensemble"
max_batch_size: 0
input [
  {
    name: "product_reviews"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]
output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [ -1, -1, 768]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "tokenizer_gte-base_uint8-text"
      model_version: 1
      input_map {  key: "product_reviews"
        value: "product_reviews"
      }
      output_map {  key: "input_ids"
        value: "input_ids"
      }
      output_map {  key: "attention_mask"
        value: "attention_mask"
      }
    },
    {
      model_name: "embd_gte-base_uint8-text"
      model_version: 1
      input_map {
        key: "input_ids"
        value: "input_ids"
      }
      input_map { 
        key: "attention_mask" 
        value: "attention_mask" 
      }
      output_map { 
        key: "logits" 
        value: "logits" 
      } 
    }
  ]
}
