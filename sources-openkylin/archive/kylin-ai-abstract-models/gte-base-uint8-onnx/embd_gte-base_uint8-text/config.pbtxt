name: "embd_gte-base_uint8-text"
platform: "onnxruntime_onnx"
default_model_filename: "gte-base-multilingual-model_QUInt8.onnx"
max_batch_size : 0
input [
  {
      name: "input_ids"
      data_type: TYPE_INT64
      dims: [ -1 ]
      reshape { shape: [ 1, -1 ] }
    },
    {
      name: "attention_mask"
      data_type: TYPE_INT64
      dims: [ -1 ]
      reshape { shape: [ 1, -1 ] }
    }
]
output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [ -1, -1, 768 ]
  }
]
parameters: {
  key: "limit_cpu_usage"
  value: {
    string_value: "true"
  }
}
