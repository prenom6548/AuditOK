#!/usr/bin/make -f

QT_SELECT=5

build-arch:

build-indep:

build:
	make all

clean:
	make clean
	dh_clean

binary-arch:

binary-indep:

binary:
	make install-mo DESTDIR=debian/openkylin-language-pack-fr PREFIX=/usr
	dh_installdeb
	dh_installchangelogs
	dh_compress
	dh_gencontrol
	dh_md5sums
	dh_builddeb
