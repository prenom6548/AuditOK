+#if !defined(UKUI_LOG4QT) && defined(KY_SDK_KABASE)
+static void kysdkMessageOutput(QtMsgType type,
+                               const QMessageLogContext &context,
+                               const QString &msg)
+{
+    int level = KLOG_DEBUG;
+    switch (type) {
+    case QtInfoMsg:
+        level = KLOG_INFO;
+        break;
+    case QtWarningMsg:
+        level = KLOG_WARNING;
+        break;
+    case QtCriticalMsg:
+        level = KLOG_ERROR;
+        break;
+    case QtFatalMsg:
+        level = KLOG_CRIT;
+        break;
+    default:
+        break;
+    }
+
+    // kylog supplies the [user.LEVEL], timestamp and PID prefix. Keep the
+    // Qt source location in the message to match the existing log format.
+    QByteArray text = msg.toUtf8();
+    text += " (";
+    text += context.file ? context.file : "";
+    text += ':';
+    text += QByteArray::number(context.line);
+    text += ',';
+    text += context.function ? context.function : "";
+    text += ')';
+
+    kdk_logger_write(level,
+                     context.file ? context.file : "",
+                     context.function ? context.function : "",
+                     context.line,
+                     "%s",
+                     text.constData());
+}
+#endif
