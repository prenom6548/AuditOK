+      qEnvironmentVariableIsEmpty("PAG_NO_DELAYED_TRIM");
+  if (!enabled) {
+    return;
+  }
+  // 30s 先收、60s 收尾、180s 慢场景兜底（单发，完成后不再触发）
+  static const int kTrimDelaysMs[3] = {30000, 60000, 180000};
+  static QPointer<QTimer> trimTimer[3];  // QPointer：qApp 销毁时自动置空，防悬垂
+  for (int i = 0; i < 3; ++i) {
+    if (!trimTimer[i]) {
+      trimTimer[i] = new QTimer(app);
+      trimTimer[i]->setSingleShot(true);
+      QTimer::connect(trimTimer[i], &QTimer::timeout, app, [i]() {
+        const long rssBefore = currentRssKb();
+        malloc_trim(0);
+        qDebug().noquote().nospace()
+            << "[PAG_MEM] delayed-trim rss=" << rssBefore
+            << "KB -> " << currentRssKb() << "KB";
+      });
+    }
+    trimTimer[i]->start(kTrimDelaysMs[i]);
+  }
+}
