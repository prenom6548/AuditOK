+    // 桌面右键菜单无 QWidget 父级（桌面是 QML 窗口），朗读器焦点不会自动跟到菜单项。
+    // 不靠朗读器自己跟，而是菜单项被高亮时（hovered，鼠标/键盘均触发）主动对【该项】发
+    // 焦点事件（setChild 指向具体项索引），逐项读出；菜单弹出后对首个非分隔项补发一次。
+    QMetaObject::Connection hoveredConn = connect(this, &QMenu::hovered, this, [this](QAction *action) {
+        if (!action || action->isSeparator())
+            return;
+        int idx = actions().indexOf(action);
+        if (idx < 0)
+            return;
+        QAccessibleEvent ev(this, QAccessible::Focus);
+        ev.setChild(idx);
+        QAccessible::updateAccessibility(&ev);
+    });
+    QTimer::singleShot(0, this, [this]() {
+        for (int i = 0; i < actions().count(); ++i) {
+            QAction *a = actions().at(i);
+            if (a && !a->isSeparator()) {
+                QAccessibleEvent ev(this, QAccessible::Focus);
+                ev.setChild(i);
+                QAccessible::updateAccessibility(&ev);
+                break;
+            }
+        }
+    });
+    QAction *result = QMenu::exec(pos);
+    disconnect(hoveredConn);
+    return result;
 }
 
