+bool FileUtils::isIntelligentSpaceUri(const QString &uri)
+{
+    static const QString intelligentSpaceRoot = QStringLiteral("idm:///");
+    if (!uri.startsWith(intelligentSpaceRoot)) {
+        return false;
+    }
+
+    // IDM 根目录和它的直接子空间属于智能空间主视图；
+    // 包含更多路径层级的是聚合文件，应保留其真实文件属性。
+    const QString relativePath = uri.mid(intelligentSpaceRoot.size());
+    return !relativePath.contains('/');
+}
