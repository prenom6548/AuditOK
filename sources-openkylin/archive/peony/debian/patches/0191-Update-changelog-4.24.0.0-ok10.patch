+bool DesktopWindowManager::checkSessionLockStatus()
+{
+    // 交叉确认源 org.gnome.SessionManager（ukui-session 维护的锁屏状态，
+    // 后端服务未注册期间仍可用）；新会话初始为 UNDEFINED，仅明确态可决策
+    const QDBusReply<int> reply = QDBusConnection::sessionBus().call(
+            QDBusMessage::createMethodCall(
+                    QStringLiteral("org.gnome.SessionManager"),
+                    QStringLiteral("/org/gnome/SessionManager"),
+                    QStringLiteral("org.gnome.SessionManager"),
+                    QStringLiteral("GetScreenLockStatus")),
+            QDBus::Block, 1000); // 显式超时：ukui-session 异常挂起时避免 GUI 线程长时间阻塞
+    if (!reply.isValid()) {
+        return false;
+    }
+    const int status = reply.value();
+#if 0
+    qDebug().noquote().nospace()
+            << "[PAG_UNLOCK_STATE] event=session-state-check s=" << status;
+#endif
+    // SCREEN_UNLOCK=3：明确未锁定 → 补播；SCREEN_LOCK=1/SCREEN_SAVER_LOCK=2：明确锁定 → 预加载
+    if (status == 3) {
+        m_initialUnlockRecoveryTriggered = true;
+        startUnlockAnimation(true);
+        return true;
+    }
+    if (status == 1 || status == 2) {
+        handleScreenLockSignal("session-state-lock");
+        return true;
+    }
+    return false; // SCREEN_SAVER=0 / UNDEFINED=4：无法确认，交由重试
+}
