+QString DesktopItemProxyModel::uriAt(int row) const
+{
+    const QModelIndex modelIndex = index(row, 0);
+    return modelIndex.isValid() ? modelIndex.data(Qt::UserRole).toString() : QString();
+}
+
+int DesktopItemProxyModel::indexOfUri(const QString &uri) const
+{
+    if (uri.isEmpty()) {
+        return -1;
+    }
+    for (int row = 0; row < rowCount(); ++row) {
+        if (uriAt(row) == uri) {
+            return row;
+        }
+    }
+    return -1;
+}
+
+QStringList DesktopItemProxyModel::allUris() const
+{
+    QStringList uris;
+    uris.reserve(rowCount());
+    for (int row = 0; row < rowCount(); ++row) {
+        const QString uri = uriAt(row);
+        if (!uri.isEmpty()) {
+            uris.append(uri);
+        }
+    }
+    return uris;
+}
+
+QVariantMap DesktopItemProxyModel::itemDataAt(int row) const
+{
+    QVariantMap itemData;
+    const QModelIndex modelIndex = index(row, 0);
+    if (!modelIndex.isValid()) {
+        return itemData;
+    }
+
+    const QHash<int, QByteArray> roles = roleNames();
+    for (auto it = roles.constBegin(); it != roles.constEnd(); ++it) {
+        itemData.insert(QString::fromUtf8(it.value()), data(modelIndex, it.key()));
+    }
+    itemData.insert(QStringLiteral("row"), row);
+    return itemData;
+}
