+bool PAGRenderThread::matches(qulonglong generation, qulonglong windowEpoch,
+                              qulonglong visibilityEpoch) const {
+  return generation == generation_ && windowEpoch == windowEpoch_ &&
+         visibilityEpoch == visibilityEpoch_;
+}
