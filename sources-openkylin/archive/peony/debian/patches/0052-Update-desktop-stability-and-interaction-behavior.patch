index 0000000..bb8a02e
--- /dev/null
+++ b/libpeony-qt/quick-look/quick-look-plugin-manager.cpp
@@ -0,0 +1,144 @@
+/*
+ * Peony-Qt's Library
+ *
+ * Copyright (C) 2020, KylinSoft Co., Ltd.
+ *
