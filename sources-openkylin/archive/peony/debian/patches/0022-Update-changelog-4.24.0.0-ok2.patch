+void TabWidget::slot_mountRemoved(const QString &mountUri)
+{
+    if (mountUri.isEmpty())
+        return;
+
+    // e.g. "gphoto2://HUAWEI_HDC_Device_5JV0226227020213/" -> scheme="gphoto2", host="HUAWEI_..."
+    QString scheme = mountUri.section("://", 0, 0);
+    QString host = mountUri.section("://", 1).section('/', 0, 0);
+    if (host.isEmpty() || scheme.isEmpty())
+        return;
+
+    // match "gphoto2:host=HUAWEI_..." (fuse path) or "gphoto2://HUAWEI_..." (scheme uri)
+    QString fusePattern = scheme + ":host=" + host;
+    QString schemePattern = scheme + "://" + host;
+
+    for (int index = 0; index < m_stack->count(); index++)
+    {
+        int currentIndex = this->currentIndex();
+        auto container = qobject_cast<Peony::DirectoryViewContainer *>(m_stack->widget(index));
+        if (!container)
+            continue;
+
+        QString uri = container->getCurrentUri();
+        if (uri.isEmpty() || uri == "computer:///" || uri == "file:///" || uri == "filesafe:///")
+            continue;
+
+        if (!uri.contains(fusePattern) && !uri.contains(schemePattern))
+            continue;
+
+        qDebug()<<"slot_mountRemoved mountUri:"<<mountUri<<" matched uri:"<<uri<<" index:"<<index;
+        if((Peony::GlobalSettings::getInstance()->getValue("LAST_FOCUS_PEONY_WINID") == dynamic_cast<MainWindow *>(this->topLevelWidget())->winId()
+            ||KWindowSystem::hasWId(dynamic_cast<MainWindow *>(this->topLevelWidget())->winId())
+            ||QApplication::topLevelWidgets().contains(this->topLevelWidget()))
+                && index == currentIndex){
+            if (uri.startsWith("filesafe:///"))
+                this->goToUri("filesafe:///", true, true);
+            else
+                this->goToUri("computer:///", true, true);
+        }
+        else{
+            qDebug()<<"remove tab  uri:"<<uri<<", index:"<<index;
+            removeTab(index);
+            index--;
+        }
+    }
+}
