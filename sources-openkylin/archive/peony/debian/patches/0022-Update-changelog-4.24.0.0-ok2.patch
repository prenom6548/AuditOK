+void PlatformWindow::beginDesktopWidgetCrossScreenPreview()
+{
+    const QVariantMap info = DesktopWindowManager::getInstance()->desktopWidgetCrossScreenDragInfo();
+    if (!info.value(QStringLiteral("active")).toBool()) {
+        return;
+    }
+
+    m_crossScreenPreviewActive = true;
+    m_crossScreenPreviewGridUnit = info.value(QStringLiteral("gridUnitSize")).toInt();
+    m_crossScreenPreviewOldX = -1;
+    m_crossScreenPreviewOldY = -1;
+    m_crossScreenPreviewUsedRect = QRect();
+    updateDragResizeUsedRegion();
+}
+
+void PlatformWindow::applyCrossScreenPreviewIconRelayout(QQuickItem *ghost, QQuickItem *dragIndicator)
+{
+    if (!m_crossScreenPreviewActive || !rootItem() || !ghost) {
+        return;
+    }
+
+    QQuickItem *posSource = (dragIndicator && dragIndicator->isVisible()) ? dragIndicator : ghost;
+    const QPointF topLeft = posSource->mapToItem(rootItem(), QPointF(-HORIZON_MARGIN, -VERTICAL_MARGIN));
+    m_crossScreenPreviewUsedRect = QRect(topLeft.toPoint(),
+                                         QSize(int(posSource->width()), int(posSource->height())));
+    m_crossScreenPreviewUsedRect = m_crossScreenPreviewUsedRect.adjusted(-WIDGET_PADDING, -WIDGET_PADDING,
+                                                                         WIDGET_PADDING, WIDGET_PADDING);
+    updateDesktopWidgetsUsedRegion();
+}
+
+void PlatformWindow::endDesktopWidgetCrossScreenPreview()
+{
+    m_crossScreenPreviewActive = false;
+    m_crossScreenPreviewGridUnit = 0;
+    m_crossScreenPreviewOldX = -1;
+    m_crossScreenPreviewOldY = -1;
+    m_crossScreenPreviewUsedRect = QRect();
+
+    if (!rootItem()) {
+        return;
+    }
+
+    if (auto *dragIndicator = rootItem()->findChild<QQuickItem *>(QStringLiteral("dragIndicatorRect"))) {
+        dragIndicator->setVisible(false);
+    }
+
+    // 预览结束，恢复被挤占的桌面图标位置
+    updateDesktopWidgetsUsedRegion();
+}
+
+void PlatformWindow::previewDesktopWidgetDragPosition(int visualLeft, int layoutY)
+{
+    const QVariantMap info = DesktopWindowManager::getInstance()->desktopWidgetCrossScreenDragInfo();
+    if (!info.value(QStringLiteral("active")).toBool() || !rootItem()) {
+        return;
+    }
+
+    const int widgetWidth = info.value(QStringLiteral("width")).toInt();
+    const int widgetHeight = info.value(QStringLiteral("height")).toInt();
+    const bool layoutWithGrid = info.value(QStringLiteral("layoutWithGrid")).toBool();
+    if (widgetWidth <= 0 || widgetHeight <= 0) {
+        return;
+    }
+
+    auto *ghost = rootItem()->findChild<QQuickItem *>(QStringLiteral("crossScreenDragGhost"));
+    auto *dragIndicator = rootItem()->findChild<QQuickItem *>(QStringLiteral("dragIndicatorRect"));
+    auto *proxyModel = rootItem()->findChild<WidgetsProxyModel *>();
+    if (!ghost || !dragIndicator) {
+        return;
+    }
+
+    m_crossScreenPreviewActive = true;
+    m_crossScreenPreviewGridUnit = info.value(QStringLiteral("gridUnitSize")).toInt();
+
+    const int layoutWidth = m_currentWidgetsLayoutWidth;
+    const int layoutHeight = m_currentWidgetsLayoutHeight;
+    // widgetsLayout 内鼠标坐标为视觉左上角，desktopWidget.x 为镜像逻辑坐标
+    const int configX = layoutWidth - widgetWidth - visualLeft;
+
+    ghost->setWidth(widgetWidth);
+    ghost->setHeight(widgetHeight);
+    ghost->setX(configX);
+    ghost->setY(layoutY);
+
+    dragIndicator->setWidth(widgetWidth);
+    dragIndicator->setHeight(widgetHeight);
+
+    if (checkItemIntersected(ghost)) {
+        dragIndicator->setVisible(true);
+        if (!adjustIntersectedItem(ghost, dragIndicator, layoutWidth, layoutWithGrid)) {
+            if (m_crossScreenPreviewOldX >= 0) {
+                dragIndicator->setX(m_crossScreenPreviewOldX);
+                dragIndicator->setY(m_crossScreenPreviewOldY);
+            }
+        } else {
+            m_crossScreenPreviewOldX = int(dragIndicator->x());
+            m_crossScreenPreviewOldY = int(dragIndicator->y());
+        }
+        applyCrossScreenPreviewIconRelayout(ghost, dragIndicator);
+        return;
+    }
+
+    const bool outOfBounds = configX < 0 || layoutY < 0
+        || configX + widgetWidth > layoutWidth
+        || layoutY + widgetHeight > layoutHeight;
+    if (outOfBounds) {
+        dragIndicator->setVisible(true);
+    } else {
+        dragIndicator->setVisible(false);
+        m_crossScreenPreviewOldX = configX;
+        m_crossScreenPreviewOldY = layoutY;
+    }
+
+    if (layoutWithGrid && proxyModel && layoutWidth > 0) {
+        adjustGridLayoutWidget(ghost, nullptr, false, dragIndicator, proxyModel, layoutWidth);
+    } else if (dragIndicator->isVisible()) {
+        dragIndicator->setX(configX);
+        dragIndicator->setY(layoutY);
+
+        if (configX < 0) {
+            dragIndicator->setX(0);
+        } else if (configX + widgetWidth > layoutWidth) {
+            dragIndicator->setX(layoutWidth - widgetWidth);
+        }
+
+        if (layoutY < 0) {
+            dragIndicator->setY(0);
+        } else if (layoutY + widgetHeight > layoutHeight) {
+            dragIndicator->setY(layoutHeight - widgetHeight);
+        }
+    }
+
+    applyCrossScreenPreviewIconRelayout(ghost, dragIndicator);
 }
 
