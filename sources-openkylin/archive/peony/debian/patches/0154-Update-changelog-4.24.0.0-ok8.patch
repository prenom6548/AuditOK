+
+void ThemeStyle::updateHighlightColors()
+{
+    QColor baseColor;
+    if (qApp) {
+        QVariant light = qApp->property("highlight-active");
+        QBrush brush = light.value<QBrush>();
+        baseColor = brush.color();
+    }
+
+    QColor newHighlight = baseColor;
+    newHighlight.setAlpha(255 * 0.8);
+    QColor newMidlight = baseColor;
+    newMidlight.setAlpha(255 * 0.5);
+
+    if (m_highlightColor != newHighlight) {
+        m_highlightColor = newHighlight;
+        Q_EMIT highlightColorChanged();
+    }
+    if (m_midlightColor != newMidlight) {
+        m_midlightColor = newMidlight;
+        Q_EMIT midlightColorChanged();
+    }
 }
 
