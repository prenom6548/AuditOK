+/*! 判定路径是否为可播放的视频壁纸：后缀 .mp4 或 ISOBMFF 魔数（ftyp，offset 4）
+ *  cover: AccountsService 复制用户壁纸到 /var/lib/.../backgrounds/<user>（无扩展名）
+ *  时也能识别，避免冷启动被误判为静态图（QML Image 解码失败 + 视频永不启动） */
+static bool looksLikeVideoWallpaper(const QString &path)
+{
+    const QString lower = path.toLower();
+    if (lower.endsWith(QLatin1String(".mp4"))) {
+        return true;
+    }
+    QFile f(path);
+    if (!f.open(QIODevice::ReadOnly)) {
+        return false;
+    }
+    const QByteArray head = f.read(16);
+    return head.size() >= 12 && head.mid(4, 4) == QByteArrayLiteral("ftyp");
+}
