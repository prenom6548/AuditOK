+static gchar **
+collect_directories_from_xdg_data_dirs (const gchar **directories)
+{
+  GPtrArray *paths;
+
+  paths = g_ptr_array_new ();
+
+  if (directories != NULL)
+    {
+      for (gint i = 0; directories[i] != NULL; i++)
+        g_ptr_array_add (paths, g_strdup (directories[i]));
+    }
+
+  const gchar *xdg_data_dirs = g_getenv ("XDG_DATA_DIRS");
+  if (xdg_data_dirs == NULL || *xdg_data_dirs == '\0')
+    xdg_data_dirs = "/usr/local/share:/usr/share";
+
+  gchar **xdg_components = g_strsplit (xdg_data_dirs, ":", -1);
+  for (gint i = 0; xdg_components[i] != NULL; i++)
+    {
+      gchar *trimmed = g_strstrip (xdg_components[i]);
+      if (*trimmed == '\0')
+        continue;
+      if (!(g_str_has_prefix (trimmed, "/usr/")
+            || g_str_has_prefix (trimmed, "/opt/")))
+        continue;
+
+      gchar *actions_path = g_build_filename (trimmed, "polkit-1", "actions", NULL);
+      gboolean found = FALSE;
+      for (guint j = 0; j < paths->len; j++)
+        {
+          const gchar *existing = g_ptr_array_index (paths, j);
+          if (g_strcmp0 (existing, actions_path) == 0)
+            {
+              found = TRUE;
+              break;
+            }
+        }
+      if (!found)
+        g_ptr_array_add (paths, actions_path);
+      else
+        g_free (actions_path);
+    }
+  g_strfreev (xdg_components);
+
+  g_ptr_array_add (paths, NULL);
+  return (gchar **) g_ptr_array_free (paths, FALSE);
+}
+
