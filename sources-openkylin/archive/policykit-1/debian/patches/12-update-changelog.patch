+/* Append polkit-1/rules.d paths from $XDG_DATA_DIRS (system prefix filter). */
+static void
+append_rules_dirs_from_xdg_data_dirs (PolkitBackendJsAuthority *authority)
+{
+  const gchar *xdg_data_dirs;
+  gchar **components;
+  gint orig_len;
+  gint max_add;
+  gint cur;
+  gint i;
+  gint j;
+
+  xdg_data_dirs = g_getenv ("XDG_DATA_DIRS");
+  if (xdg_data_dirs == NULL || *xdg_data_dirs == '\0')
+    xdg_data_dirs = "/usr/local/share:/usr/share";
+
+  components = g_strsplit (xdg_data_dirs, ":", -1);
+
+  orig_len = 0;
+  while (authority->priv->rules_dirs[orig_len] != NULL)
+    orig_len++;
+
+  max_add = 0;
+  for (i = 0; components[i] != NULL; i++)
+    {
+      gchar *trimmed;
+
+      trimmed = g_strstrip (components[i]);
+      if (*trimmed == '\0')
+        continue;
+      if (!(g_str_has_prefix (trimmed, "/usr/")
+            || g_str_has_prefix (trimmed, "/opt/")
+            || g_str_has_prefix (trimmed, "/lib/")
+            || g_str_has_prefix (trimmed, "/var/")))
+        continue;
+      max_add++;
+    }
+
+  authority->priv->rules_dirs = g_realloc (authority->priv->rules_dirs,
+                                           sizeof (gchar *) * (orig_len + max_add + 1));
+
+  cur = orig_len;
+  for (i = 0; components[i] != NULL; i++)
+    {
+      gchar *trimmed;
+      gchar *rules_path;
+      gboolean found;
+
+      trimmed = g_strstrip (components[i]);
+      if (*trimmed == '\0')
+        continue;
+      if (!(g_str_has_prefix (trimmed, "/usr/")
+            || g_str_has_prefix (trimmed, "/opt/")
+            || g_str_has_prefix (trimmed, "/lib/")
+            || g_str_has_prefix (trimmed, "/var/")))
+        continue;
+
+      rules_path = g_build_filename (trimmed, "polkit-1", "rules.d", NULL);
+
+      found = FALSE;
+      for (j = 0; j < cur; j++)
+        {
+          if (g_strcmp0 (authority->priv->rules_dirs[j], rules_path) == 0)
+            {
+              found = TRUE;
+              break;
+            }
+        }
+      if (!found)
+        authority->priv->rules_dirs[cur++] = rules_path;
+      else
+        g_free (rules_path);
+    }
+  authority->priv->rules_dirs[cur] = NULL;
+  g_strfreev (components);
+}
