    "cmds": [
      {
        "value": "上一首",
        "cmd": "nohup kylin-music -b > /dev/null 2>&1 &"
      },
      {
        "value": "下一首",
        "cmd": "nohup kylin-music -n > /dev/null 2>&1 &"
