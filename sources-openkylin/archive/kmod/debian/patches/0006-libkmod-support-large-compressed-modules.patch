From: Andrea Righi <andrea.righi@canonical.com>
Date: Fri, 17 Apr 2026 07:52:59 +0000
Subject: fallback to user-space module loading with large modules

---
 libkmod/libkmod-module.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libkmod/libkmod-module.c b/libkmod/libkmod-module.c
index 0d74100..392919c 100644
--- a/libkmod/libkmod-module.c
+++ b/libkmod/libkmod-module.c
@@ -709,7 +709,7 @@ KMOD_EXPORT int kmod_module_insert_module(struct kmod_module *mod, unsigned int
 	}
 
 	err = do_finit_module(mod, flags, args);
-	if (err == -ENOSYS)
+	if (err == -ENOSYS || err == -ENOMEM)
 		err = do_init_module(mod, flags, args);
 
 	if (err < 0)
