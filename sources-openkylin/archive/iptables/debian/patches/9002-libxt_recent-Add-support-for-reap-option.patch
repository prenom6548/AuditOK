From: Tim Gardner <tim.gardner@canonical.com>
Date: Fri, 3 Apr 2026 15:42:43 +0800
Subject: Fix support for reap option.

Origin: 79ddbf202a06e6f018e087a328c2ca91e65a8463
Last-Update: <2013-06-07>
---
 extensions/libxt_recent.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/extensions/libxt_recent.c b/extensions/libxt_recent.c
index 0221d44..fc83a4d 100644
--- a/extensions/libxt_recent.c
+++ b/extensions/libxt_recent.c
@@ -170,10 +170,16 @@ static void recent_parse(struct xt_option_call *cb)
 
 static void recent_check(struct xt_fcheck_call *cb)
 {
+	struct xt_recent_mtinfo *info = cb->data;
+
 	if (!(cb->xflags & F_ANY_OP))
 		xtables_error(PARAMETER_PROBLEM,
 			"recent: you must specify one of `--set', `--rcheck' "
 			"`--update' or `--remove'");
+
+	if ((info->check_set & XT_RECENT_REAP) && !info->seconds)
+		xtables_error(PARAMETER_PROBLEM,
+			"recent: you must specify `--seconds' with `--reap'");
 }
 
 static void recent_print(const void *ip, const struct xt_entry_match *match,
