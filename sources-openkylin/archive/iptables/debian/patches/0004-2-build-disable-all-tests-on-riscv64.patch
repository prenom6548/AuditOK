From: zhoukangyu <zhoukangyu@kylinos.cn>
Date: Thu, 16 Apr 2026 02:30:44 +0000
Subject: !2 build: disable all tests on riscv64

Merge pull request !2 from zhoukangyu/openkylin/huanghe
---
 Makefile.am  | 5 +++++
 configure.ac | 5 +++++
 2 files changed, 10 insertions(+)

diff --git a/Makefile.am b/Makefile.am
index d0ba059..4c9d8bf 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -34,4 +34,9 @@ tarball:
 config.status: extensions/GNUmakefile.in \
 	include/xtables-version.h.in
 
+# riscv64 ：disable test
+if RISCV64_BUILD
+TESTS =
+else
 TESTS = xlate-test.py iptables-test.py iptables/tests/shell/run-tests.sh
+endif
\ No newline at end of file
diff --git a/configure.ac b/configure.ac
index 2d38a4d..a2ddb8c 100644
--- a/configure.ac
+++ b/configure.ac
@@ -15,6 +15,11 @@ AM_PROG_CC_C_O
 m4_ifdef([AM_PROG_AR], [AM_PROG_AR])
 LT_INIT([disable-static])
 
+AC_CANONICAL_HOST
+RISCV64_BUILD=no
+AS_CASE([$host], [riscv64*], [RISCV64_BUILD=yes])
+AM_CONDITIONAL([RISCV64_BUILD], [test "$RISCV64_BUILD" = "yes"])
+
 AC_ARG_WITH([kernel],
 	AS_HELP_STRING([--with-kernel=PATH],
 	[Path to kernel source/build directory]),
