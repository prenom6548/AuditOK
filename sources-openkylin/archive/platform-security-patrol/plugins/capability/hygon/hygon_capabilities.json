{
    "external_tools": [
        {
            "name": "hag",
            "description": "Hygon HAG Tool, is a command-line utility for managing security features on Hygon CPUs",
            "check_command": "hag",
            "install_guide": "sudo wget -c https://download.sourcefind.cn:65024/directlink/8/c86-devkit/previous-release/bin/hag -O /usr/local/bin/hag && sudo chmod +x /usr/local/bin/hag",
            "verify_command": "sudo hag general check"
        }
    ],
    "Hygon C86-3G": {
        "cap_matrix": [
            {
                "cap_name": "csv1",
                "disable_info": {
                    "supported": false,
                    "method": "CSV is a hardware-level memory encryption feature. It can only be disabled through BIOS settings if the firmware provides such option."
                },
                "dependencies": {
                    "cpu": {
                        "requirements": [
                            {"name": "model", "value": ["Hygon C86-3G"], "operator": "==", "status": "support", "type": "cpu_model"}
                        ]
                    },
                    "firmware": {
                        "alternatives": [
                            {
                                "conditions": [
                                    {"name": "firmware_version", "value": ["1837"], "operator": ">=", "status": "support", "type": "firmware"}
                                ]
                            },
                            {
                                "conditions": [
                                    {"name": "bios_vendor", "value": ["OEM"], "operator": "==", "status": "support", "type": "firmware"},
                                    {"name": "bios_version", "value": ["CZYH052908"], "operator": "==", "status": "support", "type": "firmware"}
                                ]
                            }
                        ]
                    },
                    "os": {
                        "requirements": [
                            {"name": "CONFIG_AMD_MEM_ENCRYPT", "value": ["y"], "operator": "==", "status": "support", "type": "kernel_config"},
                            {"name": "CONFIG_KVM_AMD_SEV", "value": ["y"], "operator": "==", "status": "support", "type": "kernel_config"},
