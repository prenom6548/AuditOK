#!/bin/bash
#DEBHELPER#

SHARED_DIRECTORY=/var/lib/samba/usershares
if [ "`ls -A $SHARED_DIRECTORY`" = "" ]; then
        echo "No share folders in current host, disable smbd and nmbd..."
        systemctl stop smbd.service
        systemctl disable smbd.service
        systemctl stop nmbd.service
        systemctl disable nmbd.service
        systemctl daemon-reload
else
        echo "Exists share folders, enable smbd and nmbd..."
        systemctl enable smbd.service
        systemctl start smbd.service
        systemctl enable nmbd.service
        systemctl start nmbd.service
        systemctl daemon-reload
fi

echo "Copy the config files to the dbus directory..."
if [ -f "/usr/share/peony-extensions/kylin-config/org.ukui.samba.share.config.yaml" ]; then
    mkdir -p /etc/kylin-config/basic/
    cp /usr/share/peony-extensions/kylin-config/org.ukui.samba.share.config.yaml /etc/kylin-config/basic/org.ukui.samba.share.config.yaml
fi

if [ -f "/usr/share/peony-extensions/kylin-config/org.ukui.samba.share.config.limit" ]; then
    mkdir -p /etc/dbus-1/conf/
    cp /usr/share/peony-extensions/kylin-config/org.ukui.samba.share.config.limit /etc/dbus-1/conf/org.ukui.samba.share.config.limit
fi

if [ -f "/usr/share/peony-extensions/kylin-config/org.ukui.samba.share.config.limit.verify" ]; then
    mkdir -p /etc/dbus-1/conf/
    cp /usr/share/peony-extensions/kylin-config/org.ukui.samba.share.config.limit.verify /etc/dbus-1/conf/org.ukui.samba.share.config.limit.verify
fi

exit 0
