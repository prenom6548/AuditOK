  "Id": "org.ukui.desktop-image-widget",
  "Icon": "kylin-photo-viewer",
  "Name": "Desktop Image",
  "Name[zh_CN]": "桌面图片",
  "Tooltip": "Show chosen image on desktop",
  "Tooltip[zh_CN]": "在桌面显示选择的图片",
  "Description": "A desktop widget to choose and display a local image",
  "Description[zh_CN]": "可选择并显示本地图片的桌面小插件",
  "Version": "1.0",
  "Website": "https://ukui.org",
  "BugReport": "https://gitee.com/openkylin/peony/issues",
  "ShowIn": "Desktop",
  "Contents": {
    "Main": "main.qml",
    "I18n": "translations/org.ukui.desktop-image-widget",
    "Layer": 1,
    "Dragable": true,
    "Resizable": false,
    "SizePolicy": 1,
    "DoDecoration": true,
    "DoBlur": true,
    "ShowInManager": true,
    "SizeHint": [4, 2],
    "GridUnitSize": 76,
    "ManagerVariants": [
      {
        "id": "small",
        "name": "Desktop Image",
        "name[zh_CN]": "桌面图片",
        "description": "Displays an image you choose",
        "description[zh_CN]": "展示您选择的图片",
        "sizeHint": [2, 2],
        "previewSize": [96, 96],
        "desktopSize": [136, 136],
        "previewMain": "small.qml",
        "fixedResizable": false
      },
      {
        "id": "medium",
        "name": "Desktop Image",
        "name[zh_CN]": "桌面图片",
        "description": "Displays an image you choose",
        "description[zh_CN]": "展示您选择的图片",
        "sizeHint": [4, 2],
        "previewSize": [209, 96],
        "desktopSize": [296, 136],
        "previewMain": "medium.qml",
        "fixedResizable": false
      },
      {
        "id": "large",
        "name": "Desktop Image",
        "name[zh_CN]": "桌面图片",
        "description": "Displays an image you choose",
        "description[zh_CN]": "展示您选择的图片",
        "sizeHint": [4, 4],
        "previewSize": [209, 209],
        "desktopSize": [296, 296],
        "previewMain": "large.qml",
        "fixedResizable": false
      }
    ]
  }
}
