    "Main": "main.qml",
    "I18n": "translations/org.ukui.desktop-clock-widget",
    "Layer": 1,
    "Dragable": true,
    "Resizable": false,
    "SizePolicy": 1,
    "DoDecoration": true,
    "DoBlur": true,
    "ShowInManager": true,
    "SizeHint": [4, 2],
    "GridUnitSize": 76,
    "ManagerVariants": [
      {
        "id": "small",
        "name": "Desktop Clock",
        "name[zh_CN]": "桌面时钟",
        "description": "Shows the current time on an analog clock face",
        "description[zh_CN]": "以模拟表盘显示当前时间",
        "sizeHint": [2, 2],
        "previewSize": [96, 96],
        "desktopSize": [136, 136],
        "previewMain": "small.qml",
        "fixedResizable": false
      },
      {
        "id": "medium",
        "name": "Desktop Clock",
        "name[zh_CN]": "桌面时钟",
        "description": "Shows the current date and time",
        "description[zh_CN]": "显示当前日期和时间",
        "sizeHint": [4, 2],
        "previewSize": [209, 96],
        "desktopSize": [296, 136],
        "previewMain": "medium.qml",
        "fixedResizable": false
      },
      {
        "id": "large",
        "name": "Desktop Clock",
        "name[zh_CN]": "桌面时钟",
        "description": "Shows the current time with an analog dial and hour markers",
        "description[zh_CN]": "以模拟表盘与时刻标记显示当前时间",
        "sizeHint": [4, 4],
        "previewSize": [209, 209],
        "desktopSize": [296, 296],
        "previewMain": "large.qml",
        "fixedResizable": false
      }
    ]
