<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/">
        <file alias="dpinyin.dict">res/dpinyin.dict</file>
    </qresource>
    <qresource prefix="/org/ukui/desktopclock">
        <file alias="fonts/DMSerifDisplay-Regular.ttf">fonts/DMSerifDisplay-Regular.ttf</file>
        <file alias="hands/clock_hand_hour.svg">res/hands/clock_hand_hour.svg</file>
        <file alias="hands/clock_hand_minute.svg">res/hands/clock_hand_minute.svg</file>
        <file alias="hands/clock_hand_second.svg">res/hands/clock_hand_second.svg</file>
        <file alias="icons/small-symbolic.svg">res/icons/small-symbolic.svg</file>
        <file alias="icons/medium-symbolic.svg">res/icons/medium-symbolic.svg</file>
        <file alias="icons/large-symbolic.svg">res/icons/large-symbolic.svg</file>
    </qresource>
</RCC>
