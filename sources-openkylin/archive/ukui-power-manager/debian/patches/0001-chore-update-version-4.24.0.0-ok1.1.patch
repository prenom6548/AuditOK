-batdrv_chargeonce () {
-    # charge battery to stop threshold once
-    # use pre-determined method and sysfiles from global parms
-    # global params: $_batdrv_plugin, $_bm_thresh, $_bat_str, $_bf_start, $_bf_stop
-    # rc: 0=ok/
