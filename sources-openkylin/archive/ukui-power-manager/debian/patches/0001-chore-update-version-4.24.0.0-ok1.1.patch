-batdrv_select_battery () {
-    # determine battery acpidir and sysfiles
-    # $1: BAT0/DEF
-    # # rc: 0=bat exists/1=bat non-existent
-    # retval: $_bat_str:    BAT0
-    #         $_bt_cfg_bat: config suffix (BAT0);
