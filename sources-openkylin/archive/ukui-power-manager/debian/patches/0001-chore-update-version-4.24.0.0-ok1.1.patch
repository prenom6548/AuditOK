-    if [ -n "$minfreq" ] && [ "$minfreq" != "0" ]; then
-        conf=1
-        ec=0
-        for cpu in "${CPUD}"/cpu*/cpufreq/scaling_min_freq; do
-            if [ -f "$cpu" ] && ! write_sysf "$minfreq" "$cpu"; then
-                echo_debug "pm" "set_cpu_scaling_min_max_freq($1).min.write_error: $cpu $minfreq; rc=$?"
