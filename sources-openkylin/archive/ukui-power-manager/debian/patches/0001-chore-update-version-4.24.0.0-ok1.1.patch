-
-get_disk_state () {
-    # get disk power state -- $1: dev; retval: $_disk_state
-    _disk_state=$($HDPARM -C "/dev/$1" 2> /dev/null | awk -F ':' '/drive state is/ { gsub(/ /,"",$2); print $2; }')
