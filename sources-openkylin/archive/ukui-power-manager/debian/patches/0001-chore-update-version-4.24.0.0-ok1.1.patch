-    if [ -n "$maxfreq" ] && [ "$maxfreq" != "0" ]; then
-        conf=1
-        ec=0
-        for cpu in "${CPUD}"/cpu*/cpufreq/scaling_max_freq; do
-            if [ -f "$cpu" ] && ! write_sysf "$maxfreq" "$cpu"; then
-                echo_debug "pm" "set_cpu_scaling_min_max_freq($1).max.write_error: $cpu $maxfreq; rc=$?"
-                ec=$((ec+1))
-            fi
-        done
