-    printf '%s\n' "${model:-unknown}"
-
-    return 0
-}
-
-print_disk_firmware () {
-    # print firmware version --- $1: dev
-    local firmware
-
-    firmware=$($HDPARM -I "/dev/$1" 2> /dev/null | grep 'Firmware Revision' | \
