-}
-
-set_cpu_scaling_governor () {
-    # set CPU scaling governor -- $1: 0=ac mode, 1=battery mode
-    local cfg cpu ec gov
-
-    if [ "$1" = "1" ]; then
-        gov=${CPU_SCALING_GOVERNOR_ON_BAT:-}
