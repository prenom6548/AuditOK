#!/bin/bash
set -e

multiarch=$(/usr/bin/dpkg-architecture -qDEB_TARGET_MULTIARCH)
path="/usr/lib/${multiarch}/ukui-control-center/libpower.so"

case "$1" in
    remove|purge)
        # 清除 preinst 中创建的 divert
        dpkg-divert --package ukui-power-manager \
                    --rename --remove \
                    --divert "${path}.old" "${path}" || true
        ;;
esac

exit 0