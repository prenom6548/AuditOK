officePptPowersavePcieAspm = powersave

officeWordPerformancePcieAspm = default
officeWordBalancePcieAspm = default
officeWordPowersavePcieAspm = powersave

officeExcelPerformancePcieAspm = default
officeExcelBalancePcieAspm = default
officeExcelPowersavePcieAspm = powersave

videoPerformancePcieAspm = default
videoBalancePcieAspm = default
videoPowersavePcieAspm = powersave


