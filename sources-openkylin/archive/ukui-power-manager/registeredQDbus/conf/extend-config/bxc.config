[Brand-generic-config]

[product]
NZ275D = 1
A001 = 1

[NZ275D]
balanceModeReduceFrequency = 1
balanceModeMaxFrequency = 2400000

#系统空闲时仅保留cpu-0
#performanceIdleReserveCpu0 = 0
balanceIdleReserveCpu0 = 1
powersaveIdleReserveCpu0 = 1

#非空闲状态动态开关cpu核心 采样时间-关核频率-开核频率-保留核心数
#performanceAutoSwitchCpuCore = 30000-50-70-1
#balanceAutoSwitchCpuCore = 30000-50-70-1
#powersaveAutoSwitchCpuCore = 30000-50-70-2

[A001]
#intelAudioMode = 0-0-0   //注释掉， 改用下面的配置方式
defaultPerformanceSndHdaIntel=0
defaultBalanceSndHdaIntel=0
defaultPowersaveSndHdaIntel=0
idlePerformanceSndHdaIntel=0
idleBalanceSndHdaIntel=0
idlePowersaveSndHdaIntel=0
longidlePerformanceSndHdaIntel=0
longidleBalanceSndHdaIntel=0
longidlePowersaveSndHdaIntel=0
meetingPerformanceSndHdaIntel=0
meetingBalanceSndHdaIntel=0
meetingPowersaveSndHdaIntel=0
officePptPerformanceSndHdaIntel=0
officePptBalanceSndHdaIntel=0
officePptPowersaveSndHdaIntel=0
officeWordPerformanceSndHdaIntel=0
officeWordBalanceSndHdaIntel=0
officeWordPowersaveSndHdaIntel=0
officeExcelPerformanceSndHdaIntel=0
officeExcelBalanceSndHdaIntel=0
officeExcelPowersaveSndHdaIntel=0
videoPerformanceSndHdaIntel=0
videoBalanceSndHdaIntel=0
videoPowersaveSndHdaIntel=0
