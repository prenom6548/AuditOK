[Brand-generic-config]


[product]
LXKT-ZXE-N46 = 1
LXKT-ZXE-N70 = 1
LXKT-ZXEG-N6 = 1
LXKT-ZXEP-X1 = 1
LXKT-ZXG-N8P = 1

[LXKT-ZXE-N46]
brightnessNode = acpi_video1

[LXKT-ZXE-N70]
brightnessNode = lenovo_backlight

[LXKT-ZXEG-N6]
brightnessNode = lenovo_backlight
balanceModeReduceFrequency = 1

#系统空闲时仅保留cpu-0
#performanceIdleReserveCpu0 = 1
balanceIdleReserveCpu0 = 1
#powersaveIdleReserveCpu0 = 0

#非空闲状态动态开关cpu核心 采样时间-关核频率-开核频率-保留核心数
#balanceAutoSwitchCpuCore = 30000-50-70-2
powersaveAutoSwitchCpuCore = 30000-50-70-2

[LXKT-ZXEP-X1]
brightnessNode = zx_backlight


#总线设备自动挂前
#busDeviceAutoSuspend = "iic:pci:sata"
#busDeviceAutoSuspend = ""

[LXKT-ZXG-N8P2]
CustomedCpuFreq = 1


customedPerformanceMaxFreqAc = 3400000
customedPerformanceMinFreqAc = 800000
performanceModeAc = userspace

customedBalanceMaxFreqAc = 3400000
customedBlanceMinFreqAc = 800000
balanceModeAc = userspace


customedPowerSaveMaxFreqAc = 3400000
customedPowerSaveMinFreqAc = 80000
powerSaveModeAc = userspace



customedPerformanceMaxFreqDc = 3400000
customedPerformanceMinFreqDc = 800000
performanceModeDc = userspace

customedBalanceMaxFreqDc = 2300000
customedBlanceMinFreqDc = 800000
balanceModeDc = userspace

customedPowerSaveMaxFreqDc = 800000
customedPowerSaveMinFreqDc = 800000
powerSaveModeDc = userspace



[LXKT-ZXG-N8P]
CustomedCpuFreq = 2

customedPerformanceFreqAc = 3500000
performanceModeAc = userspace

customedBalanceFreqAc = 3500000
balanceModeAc = userspace

customedPowerSaveFreqAc = 3500000
powerSaveModeAc = userspace

customedPerformanceFreqDc = 3500000
performanceModeDc = userspace

customedBalanceFreqDc = 2300000
balanceModeDc = userspace

customedPowerSaveFreqDc = 800000
powerSaveModeDc = userspace

