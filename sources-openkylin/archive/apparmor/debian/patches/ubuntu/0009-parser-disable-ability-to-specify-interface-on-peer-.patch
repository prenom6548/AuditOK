From: Georgia Garcia <georgia.garcia@canonical.com>
Date: Tue, 31 Mar 2026 14:26:31 -0300
Subject: [PATCH 09/13] parser: disable ability to specify interface on peer
 for net rules

Signed-off-by: Georgia Garcia <georgia.garcia@canonical.com>
(cherry picked from commit 49921773d35512feec568f5318c73ec8c7227701)
Signed-off-by: John Johansen <john.johansen@canonical.com>
---
 parser/network.cc | 6 ++++++
 parser/network.h  | 1 +
 2 files changed, 7 insertions(+)

diff --git a/parser/network.cc b/parser/network.cc
index 054787f..a1e43c0 100644
--- a/parser/network.cc
+++ b/parser/network.cc
@@ -471,6 +471,9 @@ network_rule::network_rule(perm32_t perms_p, struct cond_entry *conds,
 
 	move_conditionals(conds, local);
 	move_conditionals(peer_conds, peer);
+	if (peer.iface)
+		yyerror("interface cannot be set for peer in network rules\n");
+	peer.iface = local.iface;
 	free_cond_list(conds);
 	free_cond_list(peer_conds);
 
@@ -512,6 +515,9 @@ network_rule::network_rule(perm32_t perms_p, const char *family, const char *typ
 
 	move_conditionals(conds, local);
 	move_conditionals(peer_conds, peer);
+	if (peer.iface)
+		yyerror("interface cannot be set for peer in network rules\n");
+	peer.iface = local.iface;
 	free_cond_list(conds);
 	free_cond_list(peer_conds);
 
diff --git a/parser/network.h b/parser/network.h
index 30906ae..48ff853 100644
--- a/parser/network.h
+++ b/parser/network.h
@@ -179,6 +179,7 @@ public:
 	network_rule(perm32_t perms_p, unsigned int family, unsigned int type);
 	~network_rule() override
 	{
+		peer.iface = NULL; /* stores the same pointer as local */
 		peer.free_conds();
 		local.free_conds();
 		if (allow) {
