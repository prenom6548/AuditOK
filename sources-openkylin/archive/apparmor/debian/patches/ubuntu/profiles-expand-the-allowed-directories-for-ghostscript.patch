From: Ryan Lee <ryan.lee@canonical.com>
Date: Tue, 31 Mar 2026 15:28:07 -0700
Subject: [PATCH] profiles: expand the allowed directories for ghostscript

Fixes: https://bugs.launchpad.net/bugs/2144896

Signed-off-by: Ryan Lee <ryan.lee@canonical.com>
---
 profiles/apparmor.d/gs | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/profiles/apparmor.d/gs b/profiles/apparmor.d/gs
index 42a1208..38898a6 100644
--- a/profiles/apparmor.d/gs
+++ b/profiles/apparmor.d/gs
@@ -30,8 +30,11 @@ profile gs /usr/bin/gs {
   # allow read access to paperspec
   file r /etc/paperspecs,
 
-  # allow access to files with selected extensions under HOME
+  # allow access to files with selected extensions under HOME and
+  # common mount locations
   owner file rw @{HOME}/**.@{gs_file_ext},
+  owner file rw /mnt/**.@{gs_file_ext},
+  owner file rw /media/*/**.@{gs_file_ext},
 
   # allow access to local printer devices
   file rw @{print_devices},
