From: Ryan Lee <ryan.lee@canonical.com>
Date: Mon, 1 Jun 2026 14:28:32 +0800
Subject: profiles: fix openvpn profile for usage of DCO

Fixes: https://bugs.launchpad.net/bugs/2146980
---
 profiles/apparmor.d/openvpn | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/profiles/apparmor.d/openvpn b/profiles/apparmor.d/openvpn
index f79410f..fe1289e 100644
--- a/profiles/apparmor.d/openvpn
+++ b/profiles/apparmor.d/openvpn
@@ -25,6 +25,9 @@ profile openvpn /usr/sbin/openvpn flags=(attach_disconnected) {
   capability setuid,
   capability setgid,
 
+  # Needed for OpenVPN DCO; see LP: #2146980
+  capability setpcap,
+
   # Network access rules
   network inet dgram,
   network inet6 dgram,
