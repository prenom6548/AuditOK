From: Ryan Lee <ryan.lee@canonical.com>
Date: Mon, 1 Jun 2026 14:28:32 +0800
Subject: Add abstractions/consoles to more profiles besides dig

---
 profiles/apparmor.d/hostname            | 4 ++++
 profiles/apparmor.d/locale              | 4 ++++
 profiles/apparmor.d/nslookup            | 4 ++++
 profiles/apparmor.d/systemd-detect-virt | 4 ++++
 profiles/apparmor.d/tshark              | 4 ++++
 profiles/apparmor.d/unix-chkpwd         | 4 ++++
 6 files changed, 24 insertions(+)

diff --git a/profiles/apparmor.d/hostname b/profiles/apparmor.d/hostname
index 794dba1..a943521 100644
--- a/profiles/apparmor.d/hostname
+++ b/profiles/apparmor.d/hostname
@@ -19,6 +19,10 @@ profile hostname @{bin}/@{exec} {
   include <abstractions/base>
   include <abstractions/nameservice-strict>
 
+  # Temporarily needed until fd delegation lands
+  # Also needed while delegation from unconfined is broken
+  include <abstractions/consoles>
+
   # set hostname, -F
   capability sys_admin,
   
diff --git a/profiles/apparmor.d/locale b/profiles/apparmor.d/locale
index 826aad0..cfd6d0f 100644
--- a/profiles/apparmor.d/locale
+++ b/profiles/apparmor.d/locale
@@ -18,6 +18,10 @@ abi <abi/5.0>,
 profile locale /usr/bin/locale {
   include <abstractions/base>
 
+  # Temporarily needed until fd delegation lands
+  # Also needed while delegation from unconfined is broken
+  include <abstractions/consoles>
+
   file r /usr/share/i18n/charmaps/,
   file r /usr/share/i18n/charmaps/*,
   file mr /usr/bin/locale,
diff --git a/profiles/apparmor.d/nslookup b/profiles/apparmor.d/nslookup
index c35fcc1..3dcc77d 100644
--- a/profiles/apparmor.d/nslookup
+++ b/profiles/apparmor.d/nslookup
@@ -19,6 +19,10 @@ profile nslookup /usr/bin/nslookup {
   include <abstractions/nameservice-strict>
   include <abstractions/terminfo>
 
+  # Temporarily needed until fd delegation lands
+  # Also needed while delegation from unconfined is broken
+  include <abstractions/consoles>
+
   # Requested on < plucky by libuv (bind9 dependency), no functional impact from denial
   deny capability sys_admin,
 
diff --git a/profiles/apparmor.d/systemd-detect-virt b/profiles/apparmor.d/systemd-detect-virt
index 7c40ffa..4fde682 100644
--- a/profiles/apparmor.d/systemd-detect-virt
+++ b/profiles/apparmor.d/systemd-detect-virt
@@ -9,6 +9,10 @@ include <tunables/global>
 # See comments on /proc/@{pid}/ns/{cgroup,pid} for why we need the flag
 profile systemd-detect-virt /usr/bin/systemd-detect-virt flags=(attach_disconnected.path=/apparmor/disconnected/) {
   include <abstractions/base>
+
+  # Temporarily needed until fd delegation lands
+  # Also needed while delegation from unconfined is broken
+  include <abstractions/consoles>
   
   /usr/bin/systemd-detect-virt mr,
   
diff --git a/profiles/apparmor.d/tshark b/profiles/apparmor.d/tshark
index c7328eb..5cb5e32 100644
--- a/profiles/apparmor.d/tshark
+++ b/profiles/apparmor.d/tshark
@@ -18,6 +18,10 @@ profile tshark /usr/bin/tshark {
   include <abstractions/nameservice>
   include <abstractions/user-tmp>
 
+  # Temporarily needed until fd delegation lands
+  # Also needed while delegation from unconfined is broken
+  include <abstractions/consoles>
+
   capability dac_read_search,
 
   signal send peer=tshark//dumpcap,
diff --git a/profiles/apparmor.d/unix-chkpwd b/profiles/apparmor.d/unix-chkpwd
index 5f74fd6..94f2268 100644
--- a/profiles/apparmor.d/unix-chkpwd
+++ b/profiles/apparmor.d/unix-chkpwd
@@ -15,6 +15,10 @@ profile unix-chkpwd /{,usr/}{,s}bin/unix_chkpwd {
   include <abstractions/base>
   include <abstractions/nameservice>
 
+  # Temporarily needed until fd delegation lands
+  # Also needed while delegation from unconfined is broken
+  include <abstractions/consoles>
+
   # To write records to the kernel auditing log.
   capability audit_write,
   # To read shadow with 000 permissions.
