From: Ryan Lee <ryan.lee@canonical.com>
Date: Mon, 1 Jun 2026 14:28:32 +0800
Subject: Add a coreutils tunable for both GNU and Rust coreutils paths

---
 profiles/apparmor.d/tunables/coreutils | 3 +++
 profiles/apparmor.d/tunables/global    | 1 +
 2 files changed, 4 insertions(+)
 create mode 100644 profiles/apparmor.d/tunables/coreutils

diff --git a/profiles/apparmor.d/tunables/coreutils b/profiles/apparmor.d/tunables/coreutils
new file mode 100644
index 0000000..7e7f555
--- /dev/null
+++ b/profiles/apparmor.d/tunables/coreutils
@@ -0,0 +1,3 @@
+# The usr/bin/gnu rule deliberately doesn't have a trailing slash
+# This is to support paths like /usr/bin/ls -> /usr/bin/gnuls
+@{coreutil_dirs}=/{bin/,usr/bin/,usr/bin/gnu,usr/lib/cargo/bin/coreutils/}
diff --git a/profiles/apparmor.d/tunables/global b/profiles/apparmor.d/tunables/global
index 70e8864..2b8b99e 100644
--- a/profiles/apparmor.d/tunables/global
+++ b/profiles/apparmor.d/tunables/global
@@ -22,6 +22,7 @@ include <tunables/xdg-user-dirs>
 include <tunables/share>
 include <tunables/etc>
 include <tunables/run>
+include <tunables/coreutils>
 
 # Also, include files in tunables/global.d for site-specific adjustments
 include if exists <tunables/global.d>
