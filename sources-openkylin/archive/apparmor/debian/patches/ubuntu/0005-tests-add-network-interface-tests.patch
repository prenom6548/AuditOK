diff --git a/tests/regression/apparmor/net_iface.sh b/tests/regression/apparmor/net_iface.sh
new file mode 100755
index 0000000..a184942
--- /dev/null
+++ b/tests/regression/apparmor/net_iface.sh
@@ -0,0 +1,190 @@
+#! /bin/bash
+#Copyright (C) 2022 Canonical, Ltd.
+#
+#This program is free software; you can redistribute it and/or
+#modify it under the terms of the GNU General Public License as
+#published by the Free Software Foundation, version 2 of the
+#License.
+
+#=NAME net_iface
+#=DESCRIPTION
+# This test verifies if network interface mediation is working
+#=END
+
+pwd=`dirname $0`
+pwd=`cd $pwd ; /bin/pwd`
+
+bin=$pwd
+
+. "$bin/prologue.inc"
+
+requires_kernel_features network_v9_skb/iface
+requires_parser_support "network interface=eth0,"
+
+settest net_inet_rcv
+
+sender="$bin/net_inet_snd"
+receiver="$bin/net_inet_rcv"
+
+ipv6_subnet=2001:db8:acad::1/64
+bind_ipv6=2001:db8:acad::cf32
+remote_ipv6=2001:db8:acad::a0f9
+
+bind_ipv4=203.0.113.10
+remote_ipv4=203.0.113.200
+
+interface0=tapaatest0
+interface1=tapaatest1
+
+socat_pids=()
+for iface in $interface0 $interface1; do
+	ip tuntap add dev $iface mode tap
+	sysctl -w net.ipv6.conf.$iface.accept_dad=0 >/dev/null # prevent ipv6 from being tentative
+	ip addr add $bind_ipv4/24 dev $iface
+	ip addr add $remote_ipv4/24 dev $iface
+	ip -6 addr add $bind_ipv6/64 dev $iface
+	ip -6 addr add $remote_ipv6/64 dev $iface
+	ip link set $iface up
+	socat /dev/null,ignoreeof TUN,tun-name=$iface,iff-up=1,tun-type=tap 2>/dev/null &
+	socat_pids+=($!)
+	sleep 0.5
+done
+
+
+cleanup()
+{
+	for pid in ${socat_pids[@]}; do kill $pid; done
+	for iface in $interface0 $interface1; do
+		ip tuntap del dev $iface mode tap
+		ip link show $iface 2>/dev/null
+		if [ $? -eq 0 ]; then
+			echo "Failure removing tap interface $iface"
+		fi
+	done
+}
+
+do_onexit="cleanup"
+
+do_test()
+{
+	local desc="NETWORK IFACE ($1)"
+	shift
+	runchecktest "$desc" "$@"
+}
+
+
+do_tests()
+{
+	prefix="$1"
+	expect_rcv=$2
+	expect_snd=$3
+	bind_ip=$4
+	bind_port=$5
+	remote_ip=$6
+	remote_port=$7
+	protocol=$8
+	iface=$9
+	generate_profile=${10}
+
+	settest net_inet_rcv
+	$generate_profile
+	do_test "$prefix - root" $expect_rcv --bind_ip $bind_ip --bind_port $bind_port --remote_ip $remote_ip --remote_port $remote_port --protocol $protocol --interface $iface --timeout 5 --sender "$sender"
+
+	settest -u "foo" net_inet_rcv
+	$generate_profile
+	do_test "$prefix - user" $expect_rcv --bind_ip $bind_ip --bind_port $bind_port --remote_ip $remote_ip --remote_port $remote_port --protocol $protocol --interface $iface --timeout 5 --sender "$sender"
+
+
+}
+
+bind_port=3456
+while lsof -i:$bind_port >/dev/null; do
+	let bind_port=$bind_port+1
+done
+
+let remote_port=$bind_port+50
+while lsof -i:$remote_port >/dev/null; do
+	let remote_port=$remote_port+1
+done
+
+#TODO: CHANGE XFAILS TO FAIL
+
+for prot in udp tcp; do
+	# make sure both interfaces work
+	generate_profile=""
+	do_tests "ipv4 $prot $interface0 unconfined" pass pass $bind_ipv4 $bind_port $remote_ipv4 $remote_port $prot $interface0 "$generate_profile"
+	do_tests "ipv4 $prot $interface1 unconfined" pass pass $bind_ipv4 $bind_port $remote_ipv4 $remote_port $prot $interface1 "$generate_profile"
+
+	generate_profile="genprofile network $sender:px -- image=$sender network"
+	do_tests "ipv4 $prot $interface0 no conds" pass pass $bind_ipv4 $bind_port $remote_ipv4 $remote_port $prot $interface0 "$generate_profile"
+	generate_profile="genprofile network $sender:px -- image=$sender network"
+	do_tests "ipv4 $prot $interface1 no conds" pass pass $bind_ipv4 $bind_port $remote_ipv4 $remote_port $prot $interface1 "$generate_profile"
+
+	generate_profile="genprofile network;interface=$interface0 $sender:px -- image=$sender network;interface=$interface0"
+	do_tests "ipv4 $prot $interface0 no conds" pass pass $bind_ipv4 $bind_port $remote_ipv4 $remote_port $prot $interface0 "$generate_profile"
+	do_tests "ipv4 $prot $interface1 no conds" xfail xfail $bind_ipv4 $bind_port $remote_ipv4 $remote_port $prot $interface1 "$generate_profile"
+
+	#=
+	setsockopt_rules="network;(setopt,getopt);ip=0.0.0.0;port=0;interface=$interface0" # INADDR_ANY
+	rcv_rules="network;ip=$bind_ipv4;interface=$interface0;peer=(ip=none)"
+	snd_rules="network;ip=$remote_ipv4;interface=$interface0;peer=(ip=none)"
+
+	# port range tests
+	let invalid1=$bind_port-1
+	let end_range=$bind_port+10
+	let invalid2=$bind_port+11
+
+	for test_port in $(seq $bind_port $end_range); do
+	    generate_profile="genprofile network;ip=$bind_ipv4;port=$bind_port-$end_range;interface=$interface0 $setsockopt_rules $sender:px -- image=$sender network $setsockopt_rules $snd_rules"
+	    do_tests "ipv4 $prot $interface0 port range $test_port generic perms" pass pass $bind_ipv4 $test_port $remote_ipv4 $remote_port $prot $interface0 "$generate_profile"
+	    do_tests "ipv4 $prot $interface1 port range $test_port generic perms" xfail xfail $bind_ipv4 $test_port $remote_ipv4 $remote_port $prot $interface1 "$generate_profile"
+	done
+
+	generate_profile="genprofile network;ip=$bind_ipv4;port=$bind_port-$end_range;interface=$interface0 $setsockopt_rules $sender:px -- image=$sender network $setsockopt_rules $snd_rules"
+	do_tests "ipv4 $prot port range $invalid1 generic perms" xfail xfail $bind_ipv4 $invalid1 $remote_ipv4 $remote_port $prot $interface0 "$generate_profile"
+
+	generate_profile="genprofile network;ip=$bind_ipv4;port=$bind_port-$end_range;interface=$interface0 $setsockopt_rules $sender:px -- image=$sender network $setsockopt_rules $snd_rules"
+	do_tests "ipv4 $prot port range $invalid2 generic perms" xfail xfail $bind_ipv4 $invalid2 $remote_ipv4 $remote_port $prot $interface0 "$generate_profile"
+	# end of port range tests
+
+	generate_profile="genprofile network;ip=$bind_ipv4;port=$bind_port;interface=$interface0;peer=(ip=$remote_ipv4,port=$remote_port) $setsockopt_rules $rcv_rules $sender:px -- image=$sender network;ip=$remote_ipv4;port=$remote_port;peer=(ip=$bind_ipv4,port=$bind_port) $setsockopt_rules $snd_rules"
+	do_tests "ipv4 $prot $interface0 generic perms" pass pass $bind_ipv4 $bind_port $remote_ipv4 $remote_port $prot $interface0 "$generate_profile"
+	do_tests "ipv4 $prot $interface1 generic perms" xfail xfail $bind_ipv4 $bind_port $remote_ipv4 $remote_port $prot $interface1 "$generate_profile"
+
+	generate_profile="genprofile network;(connect,receive,send);ip=$bind_ipv4;port=$bind_port;interface=$interface0;peer=(ip=$remote_ipv4,port=$remote_port) $setsockopt_rules $rcv_rules $sender:px -- image=$sender network;ip=$remote_ipv4;port=$remote_port;peer=(ip=$bind_ipv4,port=$bind_port) $setsockopt_rules $snd_rules"
+	do_tests "ipv4 $prot $interface0 specific perms" pass pass $bind_ipv4 $bind_port $remote_ipv4 $remote_port $prot $interface0 "$generate_profile"
+	do_tests "ipv4 $prot $interface1 specific perms" xfail xfail $bind_ipv4 $bind_port $remote_ipv4 $remote_port $prot $interface1 "$generate_profile"
+
+
+	removeprofile
+
+	# ipv6 tests
+	# make sure both interfaces work
+	generate_profile=""
+	do_tests "ipv6 $prot $interface0 unconfined" pass pass $bind_ipv6 $bind_port $remote_ipv6 $remote_port $prot $interface0 "$generate_profile"
+	do_tests "ipv6 $prot $interface1 unconfined" pass pass $bind_ipv6 $bind_port $remote_ipv6 $remote_port $prot $interface1 "$generate_profile"
+
+	generate_profile="genprofile network $sender:px -- image=$sender network"
+	do_tests "ipv6 $prot $interface0 no conds" pass pass $bind_ipv6 $bind_port $remote_ipv6 $remote_port $prot $interface0 "$generate_profile"
+	do_tests "ipv6 $prot $interface1 no conds" pass pass $bind_ipv6 $bind_port $remote_ipv6 $remote_port $prot $interface1 "$generate_profile"
+
+	setsockopt_rules="network;(setopt,getopt);ip=::0;port=0;interface=$interface0" # IN6ADDR_ANY_INIT
+	rcv_rules="network;ip=$bind_ipv6;interface=$interface0;peer=(ip=none)"
+	snd_rules="network;ip=$remote_ipv6;interface=$interface0;peer=(ip=none)"
+
+	generate_profile="genprofile network;ip=$bind_ipv6;port=$bind_port;interface=$interface0;peer=(ip=$remote_ipv6,port=$remote_port) $setsockopt_rules $rcv_rules $sender:px -- image=$sender network;ip=$remote_ipv6;port=$remote_port;interface=$interface0;peer=(ip=$bind_ipv6,port=$bind_port) $setsockopt_rules $snd_rules"
+	do_tests "ipv6 $prot $interface0 generic perms" pass pass $bind_ipv6 $bind_port $remote_ipv6 $remote_port $prot $interface0 "$generate_profile"
+	do_tests "ipv6 $prot $interface1 generic perms" xfail xfail $bind_ipv6 $bind_port $remote_ipv6 $remote_port $prot $interface1 "$generate_profile"
+
+
+	if [ "$(parser_supports 'all,')" = "true" ]; then
+	    generate_profile="genprofile all -- image=$sender all"
+	    do_tests "ipv4 $prot allow all" pass pass $bind_ipv4 $bind_port $remote_ipv4 $remote_port $prot $interface0 "$generate_profile"
+
+	    generate_profile="genprofile all -- image=$sender all"
+	    do_tests "ipv6 $prot allow all" pass pass $bind_ipv6 $bind_port $remote_ipv6 $remote_port $prot $interface0 "$generate_profile"
+	fi
+
+	# needs to be done for the next loop iteration
+	removeprofile
+done
