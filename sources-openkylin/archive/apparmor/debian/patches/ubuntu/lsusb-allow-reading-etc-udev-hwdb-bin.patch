From: Christian Boltz <apparmor@cboltz.de>
Date: Sat, 11 Apr 2026 20:22:54 +0200
Subject: [PATCH] lsusb: allow reading /etc/udev/hwdb.bin

From 67f1eb7cb45fb24fccd6ee50f94b809f216314f5 Mon Sep 17 00:00:00 2001
Origin: https://gitlab.com/apparmor/apparmor/-/merge_requests/2045
Fixes: https://bugs.launchpad.net/apparmor/+bug/2148047

Fixes: https://bugs.launchpad.net/apparmor/+bug/2148047
---
 profiles/apparmor.d/lsusb | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/profiles/apparmor.d/lsusb b/profiles/apparmor.d/lsusb
index 9f0349b..a4ad916 100644
--- a/profiles/apparmor.d/lsusb
+++ b/profiles/apparmor.d/lsusb
@@ -22,6 +22,9 @@ profile lsusb /usr/bin/lsusb {
 
   # Needed for additional information gathered under sudo
   capability net_admin,
+
+  /etc/udev/hwdb.bin r,
+
   /dev/bus/usb/@{d}@{d}@{d}/@{d}@{d}@{d} rw,
 
   /dev/ r,
