From: Ryan Lee <ryan.lee@canonical.com>
Date: Mon, 1 Jun 2026 14:28:32 +0800
Subject: utils: only display non-snap, userns notifications for aa-notify

===================================================================
---
 utils/notify.conf | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/utils/notify.conf b/utils/notify.conf
index 0186e04..029dbad 100644
--- a/utils/notify.conf
+++ b/utils/notify.conf
@@ -43,8 +43,8 @@ ignore_denied_capability="sudo,su"
 # message_footer="For more information visit https://foo.com"
 
 # OPTIONAL - custom notification filtering
-# filter.profile=""
-# filter.operation=""
+filter.profile="^(?!snap[._-])"
+filter.operation="userns"
 # filter.name=""
 # filter.denied=""
 # filter.family=""
