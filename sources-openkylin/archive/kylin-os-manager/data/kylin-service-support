#!/bin/bash

have_m_arg=false
for arg in "$@"; do
    if [ "$arg" == "-m" ]; then
        have_m_arg=true
        break
    fi
done

if [ "$have_m_arg" == "true" ]; then
    /usr/bin/kylin-os-manager --jumpTab ServiceSupport --pluginMessage ProblemFeedback
else
    /usr/bin/kylin-os-manager --jumpTab ServiceSupport
fi
