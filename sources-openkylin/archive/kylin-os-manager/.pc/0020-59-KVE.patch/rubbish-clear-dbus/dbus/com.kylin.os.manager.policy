<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>

  <vendor>kylin os manager</vendor>
  <vendor_url>www.kylinos.cn</vendor_url>
  <icon_name>kylin-os-manager</icon_name>

  <action id="com.kylin.os.manager.action">
    <description>system level settings</description>
    <message>kylin os manager cleanup requires authorization</message>
    <message xml:lang="zh">麒麟管家垃圾清理需要授权</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

</policyconfig>
