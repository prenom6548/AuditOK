+    InternalMode m_internalMode;
+    /**
+     * @brief 部分 desktop 的名字与二进制的名字不一致，此处对这部分二进制做一下映射。
+     * @note <二进制名, desktop 名>
+     */
+    QHash<QString, QString> exec_desktop_map_;
+    quint64 annex_size_max_limit_;    // 附件最大大小限制
+};
+
+#endif
diff --git a/plugins/service-support/service-support-mini/src/passivitywidget.cpp b/plugins/service-support/service-support-mini/src/passivitywidget.cpp
