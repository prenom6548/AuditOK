+QString ScanFilesListPage::calculatedSize(_Float64 size)
+{
+    int num = 0;
+    QString suffixStr = "B";
+    if (size > 1024) {
+        for (int i = 0; size > 1024; i++) {
+            size = size / 1024;
+            num = i + 1;
+            if (num == 1) {
+                suffixStr = "KB";
+            } else if(num == 2) {
+                suffixStr = "MB";
+            } else if(num == 3) {
+                suffixStr = "GB";
+                break;
+            }
+        }
+    }
+    QString tmpSize = QString::number(size, 'f', 1) + suffixStr;
+    return tmpSize;    
+}
