+QString ScanFilesListPage::getFileType(QString filePath)
+{
+    auto info = Peony::FileInfo::fromUri("file://" + filePath);
+    QString mimeType = info->mimeType();
+    if (mimeType.isEmpty()) {
+        Peony::FileInfoJob job(info);
+        job.querySync();
+        mimeType = info->mimeType();
+    }
+    return info->fileType();
+}
