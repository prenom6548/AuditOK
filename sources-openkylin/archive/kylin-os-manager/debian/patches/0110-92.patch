+}
+EventNotifyMonitor *EventNotifyMonitor::getInstance()
+{
+    static EventNotifyMonitor *instance = nullptr;
+    static QThread *thread;
+    if (nullptr == instance) {
+        instance = new EventNotifyMonitor();
+        thread = new QThread();
