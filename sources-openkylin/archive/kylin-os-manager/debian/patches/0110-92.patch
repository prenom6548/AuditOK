-void ToolBoxWidget::startApp(QListWidgetItem *item)
-{
-    if (item->whatsThis() == "end") {
-        return;
-    }
-
-    kom::BuriedPoint::uploadMessage(kom::PluginsToolBox, "StartApp", item->whatsThis());
-    QProcess::startDetached(item->whatsThis());
-
-    return;
-}
