+    DNSSD, // dnssd://${æ‰“å°æœºåç§°}._ipp._tcp.local/?uuid=${UUID}
+    SERIAL,
+    PARALLEL,
+    SMB,
+    USB,
+    CUPS_PDF,
+    CUPS_BRF,
