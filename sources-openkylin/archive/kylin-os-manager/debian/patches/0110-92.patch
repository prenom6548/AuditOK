+    if (index > 0) {
+        for (int i = 0; i < m_saveFileList.length(); i++) {
+            if ( i ==  index) {
+                file.write(&success, 1);
+            } else {
+                char tmp = (char)m_historyProcess[i];
+                file.write(&tmp, 1);
+            }
+        }
+
+    }else {
+        file.write(&success, 1);
+    }
+
+    file.close();
+}
