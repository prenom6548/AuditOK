+void ShredDialog::initDbus()
+{
+    for (int i = 0; i < 4; i++) {
+        getKeyPathFromSys(i);
+    }
+
+    QString boxPath = QDir::homePath() + "/.box";
+
+    if (m_keyPath.length() < 1) {
+        m_keyPath = m_defaultKeyPath;
+    } else {
+        if (!m_keyPath.contains(boxPath)) {
+            QFileInfo fileinfo(boxPath);
+            if (fileinfo.exists()) {
+                m_keyPath.append(boxPath);
+            }
+        }
+    }
+}
