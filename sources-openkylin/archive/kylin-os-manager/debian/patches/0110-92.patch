+    m_cleanupPage->setCleanUpFail(failList);
+
+}
+
+void MainWindow::closeEvent(QCloseEvent *event)
+{
+    // å…³é—­çª—å£æ—¶ï¼Œå…ˆåˆ¤æ–­æ˜¯å¦æ­£åœ¨æ‰«ææ–‡ä»¶
+    if (m_isScaningFile) {
+        event->ignore();
+        m_scanFilePage->slotStopScan();
+    }
+}
