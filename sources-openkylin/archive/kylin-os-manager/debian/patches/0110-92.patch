+#ifndef DEVICE_MAP_H
+#define DEVICE_MAP_H
+
+#include <QString>
+#include <QStringList>
+#include <QMap>
+#include <QObject>
+
+// old json format:
+// {
+//     "HP-LaserJet-M506": {
+//         "deviceId": "MFG:Hewlett-Packard;CMD:PJL,PCLXL,PCL,PDF,POSTSCRIPT;CID:HPLJPDLV1;MDL:HP LaserJet M506;CLS:PRINTER;DES:HP LaserJet M506;MCT:PR;MCL:EN;MCV:2.3;",
