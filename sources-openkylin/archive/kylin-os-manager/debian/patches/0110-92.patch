+QString HotplugDevDriverFinder::apiServerAddressGet()
+{
+    kom::Configure conf;
+    QString domain = conf.value(CONFIG_DEVICE_MANAGER, CONFIG_DEVICE_MANAGER_DOMAIN).toString();
+    if (domain == "") {
+        return "api.kylinos.cn";
+    }
+    return domain;
+}
