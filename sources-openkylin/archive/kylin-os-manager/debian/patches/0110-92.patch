+void deviceIdToDeviceInfo(DeviceInformation &info)
+{
+    if (info.ieee1284ID.isEmpty()) {
+        return ;
+    }
+    device_id_s id;
+    parse_device_id(QTC(info.ieee1284ID), &id);
+    if (info.vendor.isEmpty()) {
+        info.vendor = id.mfg;
+    }
+    if (info.model.isEmpty()) {
+        info.model = id.mdl;
+    }
+    if (info.serial.isEmpty()) {
+        info.serial = id.sern;
+    }
+}
