-    item->setWhatsThis("end");
-    m_appWidget->addItem(item);
-
-    AppItem *widget = new AppItem(m_appWidget);
-    widget->setStayHope();
-    widget->setSizeIncrement(QSize(BoxSize::ItemWidth, BoxSize::ItemHeight));
-
-    m_appWidget->setItemWidget(item, widget);
-
-    return;
-}
