+void ObtainSystemInformation::save(QList<SystemInfo> list)
+{
+    if (list.isEmpty()) {
+        qDebug() << "ObtainSystemInformationï¼šæ•´æœºä¿¡æ¯ä¸ºç©º";
+        return;
+    }
+    QFile file(SYSTEM_INFOMATION_FILE_PATH);
+    if (!file.open(QIODevice::WriteOnly | QIODevice::Text | QIODevice::Truncate)) {
+        qDebug() << "ObtainSystemInformationï¼šæ‰“å¼€æ–‡ä»¶å¤±è´¥";
+        return;
+    }
+    qDebug() << "ObtainSystemInformationï¼šæ•°æ®è¡Œæ•° " << list.length();
+    for (SystemInfo info : list) {
+        QString left = info.first;
+        //        if (left.length() < 4) {
+        //            left += "\t";
+        //        }
+        QString w = left + "\t" + info.second + "\n";
+        file.write(w.toLocal8Bit());
+    }
+    qDebug() << "ObtainSystemInformationï¼šå†™å…¥å®Œæˆ";
+    file.close();
+}
