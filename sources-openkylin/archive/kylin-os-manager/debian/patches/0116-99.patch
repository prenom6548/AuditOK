+QColor Utils::CurrentPlaceholderTextColor() {
+    QColor color;
+    auto theme = CurrentTheme();
+    switch (theme) {
+        case K::Utils::Theme::kUkuiDark: {
+            color.setRed(255);
+            color.setGreen(255);
+            color.setBlue(255);
+            color.setAlphaF(0.35);
+            break;
+        }
+        default: {
+            color.setRed(0);
+            color.setGreen(0);
+            color.setBlue(0);
+            color.setAlphaF(0.35);
+            break;
+        }
+    }
+
+    return color;
+}
