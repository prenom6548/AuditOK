-void UkuiPrinterManager::getInkInfo(UkuiUsbPrinter& printer)
-{
-    if (printer.device_uri.isEmpty()) {
-        return ;
-    }
-
-    const char* attributes[] = {
-        "marker-change-time",
-        "marker-colors",
-        "marker-high-levels",
-        "marker-levels",
-        "marker-low-levels",
-        "marker-message",
-        "marker-names",
-        "marker-types",
-    };
-
-    ipp_t *request = ippNewRequest(CUPS_GET_PRINTERS);
-    ipp_t *answer;
-    ipp_attribute_t *attr;
