-        this->m_mpDeviceInformationMap.remove(qstr);
-    }
-    // qDebug() << "remove a painter!";
-    QString path = QString("/sys") + qstr;
-    // qDebug() << path;
-    emit this->findUsbDisconnect(path);
-    return true;
-}
