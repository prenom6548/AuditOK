+    m_notFindDriverNum = 0;
+
+    m_devList.clear();
+    for (int i = 0; i < m_installableListWidget->count(); ++i) {
+        m_installableListWidget->takeItem(i);
+    }
+    for (int i = 0; i < m_upgradableListWidget->count(); ++i) {
