+static QString getUserName()
+{
+    uid_t uid;
+    uid_t NO_UID = -1;
+    struct passwd *pw;
+
+    errno = 0;
+    uid = geteuid ();
+    if (uid == -1 && errno) {
+        qDebug () << "get uid error";
+        return "";
+    }
+    pw = getpwuid (uid);
+    if (!pw) {
+        qDebug ("cannot find name for user ID %lu", (unsigned long int) uid);
+        return "";
+    }
+    return QString(pw->pw_name);
+}
