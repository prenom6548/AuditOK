-static bool driverExist(QString driverName) {
-    QString cmd = "modinfo " + driverName;
-    QProcess proc;
-    proc.start(cmd);
-    proc.waitForFinished();
-    QString output = QString(proc.readAllStandardOutput());
-    if (output == "") {
-        return true;
-    } else {
-        return false;
-    }
-}
