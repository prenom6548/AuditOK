+void DriverInstallWidget::setContent() {
+    if (g_infogetter->m_getsucceed) {
+        checkUpgradable();
+
+        addGraphicCardContent();
+        addPrinterContent();
+        addScannerContent();
+        addBluetoothContent();
+        addSoundCardContent();
+        addNetworkCardContent();
+        addInputHwContent();
+        addVideoContent();
+        getOtherContent();
+        QList<HardWareInfo> devList = DATABASE_INSTANCE.getDataList();
+        addDeleteItem(devList);
+        caculateAndSetPageSize();
+        emit g_signal->updateInstallContentSucceed();    // ç”±æ£€æµ‹é¡µé¢åˆ‡æ¢åˆ°å®‰è£…é¡µé¢
+
+    }
+    emit g_signal->switchInstallPage();    // ç”±æ£€æµ‹é¡µé¢åˆ‡æ¢åˆ°å®‰è£…é¡µé¢
+}
