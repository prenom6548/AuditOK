+function remove_first_stack_address() {
+    local file_name=$1
+    awk -v keyword="Stack trace of thread" '{
+        if ($0 ~ keyword) {
+            flag=1
+            next
+        }
+        if (flag && /^[[:space:]]*#[^[:space:]]/) {
+            split($0, arr, /[[:space:]]+|\+|\(|\)/)
+            print arr[2] " " arr[4] " " "(" arr[6] ")"
+        }
+        if (flag && !/^[[:space:]]*#[^[:space:]]/) {
+            exit
+        }
+    }' "${file_name}" | awk '{print $1, $2, $3, $4}' | while read -r num symbol lparen lib rparen; do
+        demangled=$(c++filt <<<"$symbol")
+        echo "$num $demangled $lparen $lib $rparen"
+    done
+}
