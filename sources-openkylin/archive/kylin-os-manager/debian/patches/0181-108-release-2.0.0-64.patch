+QString ScanFilesListPage::getFileType(const QString &filePath)
+{
+    QString fileType;
+    QString uri = "file://" + filePath;
+
+    auto file = std::shared_ptr<GFile>(g_file_new_for_uri(uri.toUtf8().constData()), GobjectDeleter);
+    auto cancellable = std::shared_ptr<GCancellable>(g_cancellable_new(), GobjectDeleter);
+
+    GError *err = nullptr;
+    auto info = std::shared_ptr<GFileInfo>(
+        g_file_query_info(
+            file.get(),
+            "standard::*," "time::*," "access::*," "mountable::*," "metadata::*," "trash::*," G_FILE_ATTRIBUTE_ID_FILE,
+            G_FILE_QUERY_INFO_NONE,
+            cancellable.get(),
+            &err
+        ),
+        GobjectDeleter
+    );
+
+    if (err) {
+        qDebug() << err->code << err->message;
+        g_error_free(err);
+        return fileType;
+    }
+
+    QString mime_type_string = g_file_info_get_content_type(info.get());
+    if (mime_type_string.isEmpty()) {
+        if (g_file_info_has_attribute(info.get(), "standard::fast-content-type")) {
+            mime_type_string = g_file_info_get_attribute_string(info.get(), "standard::fast-content-type");
+        }
+    }
+
+    if (!mime_type_string.isEmpty()) {
+        char *content_type = g_content_type_get_description(mime_type_string.toUtf8().constData());
+        fileType = content_type;
+        g_free (content_type);
+        content_type = nullptr;
+    }
+
+    return fileType;
 }
 
