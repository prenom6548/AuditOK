+    QString rules = filePath.readAll();
+    QStringList tmpRuls = rules.split("\n");
+    bool shouldRuleFiles = false;
+    for (const QString &rule: tmpRuls) {
+        if (!rule.startsWith(" ")) {
+            shouldRuleFiles = false;
+            if (rule == str) {
+                shouldRuleFiles = true;
+            }
+        }
+        if (shouldRuleFiles) {
+            QString tmp = rule;
+            tmp = tmp.split(" ").last();
+            list.append(tmp);
+        }
     }
+    list.removeAll(str);
+    return list;
