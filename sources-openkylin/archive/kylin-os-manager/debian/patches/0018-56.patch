+
+void HardWareInfoWidget::refreshCPUInfo(TreeItem *item11, TreeItem *item12, TreeItem *item13) {
+    // CPU 频率
+    QString MHz;
+    QProcess proc;
+    QString cmd = "lscpu";
+    proc.setEnvironment(QStringList() << "LANGUAGE=en_us");
+    proc.start(cmd);
+    proc.waitForFinished();
+    QStringList outPut = QString(proc.readAllStandardOutput()).split("\n");
+    for (int i = 0; i < outPut.length(); ++i) {
+        if (QString(outPut[i]).contains("CPU MHz:")) {
+            MHz = QString(QString(outPut[i]).split("CPU MHz:")[1]).trimmed();
+            break;
+        }
+    }
+    double num = MHz.toDouble();
+    QString frequency = QString::number(num, 'f', 2) + " MHz";
+    item11->setLabelText(frequency);
+
+    // CPU 使用率
+    QFile file("/proc/stat");
+    if (file.open(QIODevice::ReadOnly | QIODevice::Text)) {
+        QTextStream in(&file);
+        QString line = in.readLine(); // 读取第一行数据
+        QStringList values = line.split(" ", QString::SkipEmptyParts);
+
+        // 计算总的CPU时间
+        quint64 totalCPUTime = 0;
+        for (int i = 1; i < values.size(); ++i)
+            totalCPUTime += values[i].toULongLong();
+
+        // 计算CPU使用率
+        quint64 idleTime = values[4].toULongLong(); // 空闲时间
+        double cpuUsage = 100.0 - ((idleTime * 100.0) / totalCPUTime);
+        // 输出CPU使用率
+        QString usage = QString::number(cpuUsage, 'f', 2) + "%";
+        item12->setLabelText(usage);
+
+        file.close();
+    }
+
+    // CPU 温度
+    int i = 1;
+    double temperature = 0;
+    QString path = "/sys/class/thermal/thermal_zone" + QString::number(i) + "/temp";
+    while (QFile(path).exists()) {
+        QProcess process;
+        process.start("cat", QStringList() << path);
+        process.waitForFinished();
+        QTextStream stream(&process);
+        QString temperatureStr = stream.readAll().trimmed();
+        temperature += temperatureStr.toFloat() / 1000;
+        i++;
+        path = "/sys/class/thermal/thermal_zone" + QString::number(i) + "/temp";
+    }
+    temperature = temperature / (i - 1);
+    QString temp = QString::number(temperature, 'f', 1) + "°C";
+    item13->setLabelText(temp);
 }
 
 
