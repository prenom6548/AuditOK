+void DriverUninstallWidget::addDeleteItem(QList<HardWareInfo> hwList) {
+    for (int i = 0; i < hwList.length(); ++i) {
+        QString driver = hwList.at(i).driver_now;
+        QString driverVersion = getDriverVersion(driver.remove(";")).trimmed();
+        // 未添加过且版本号一致
+        if(getDriverVersion(driver).trimmed() != driverVersion){
+            return;
+        }
+        if ((!m_devList.contains(hwList.at(i).model)) && driverVersion == hwList.at(i).driver_version_now.trimmed()) {
+            m_devList.append(hwList.at(i).model);
+            m_item = new UninstallItem(hwList[i]);
+            QListWidgetItem *aItem = new QListWidgetItem(m_listWidget);
+            aItem->setSizeHint(QSize(0, ITEMHEIGET));
+            m_listWidget->addItem(aItem);
+            m_listWidget->setItemWidget(aItem, m_item);
+        }
+    }
+}
 
