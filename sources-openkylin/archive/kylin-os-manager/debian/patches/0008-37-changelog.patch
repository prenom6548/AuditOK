+
+void ChooseSysWidget::slotCannelWinRadio()
+{
+    // åˆ¤æ–­å½“å‰ç‚¹å‡»çŠ¶æ€ï¼ŒLinux 1 Win 0ï¼ŒLinux 0 Win 0ï¼ŒLinux 0 Win 1
+    if (m_isClickWin) {
