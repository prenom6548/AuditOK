-        if (error)
-            g_error_free(error);
-        return;
-    }
-
-    while ((info = g_file_enumerator_next_file(enumerator, NULL, NULL)) != NULL) {
-        const char *name;
-        char *uri;
-        GFile *child;
-
-        name = g_file_info_get_name(info);
