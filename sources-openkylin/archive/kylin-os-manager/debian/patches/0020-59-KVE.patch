+QStringList FeedbackManagerLogic::getFileNameFromDir(const QString &arg) const {
+    QStringList tmp;
+    QFileInfo info(arg);
+    QString path = info.absolutePath();
+    tmp = QDir(path).entryList(QStringList() << QString(info.fileName() + "*"), QDir::Files | QDir::Readable, QDir::Name);
+    for (QString &str : tmp) {
+        str = path + "/" + str;
+    }
+    return tmp;
+}
