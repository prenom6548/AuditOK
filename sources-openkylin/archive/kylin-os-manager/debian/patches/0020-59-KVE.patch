-    GFile *file;
-    GFileEnumerator *enumerator;
-    GFileInfo *info;
-    GError *error = NULL;
-
-    file = g_file_new_for_uri("trash:");
-    enumerator = g_file_enumerate_children(file, G_FILE_ATTRIBUTE_STANDARD_NAME, G_FILE_QUERY_INFO_NOFOLLOW_SYMLINKS,
