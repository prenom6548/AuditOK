-            elif self._type == float:
-                getfunc = getattr(self._configparser, 'getfloat')
-            elif self._type == bool:
-                getfunc = getattr(self._configparser, 'getboolean')
-            else:
-                getfunc = getattr(self._configparser, 'get')
-
-            value = getfunc(section, option)
