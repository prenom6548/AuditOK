+    def __init__(self):
+        self.key = "kylin"
+        # 需要replace进行检索的模块
+        self.replaceConfigModuleList = ["memory","graphicsCard","networkCard",
+            "hardDisk", "monitor", "soundCard", "keyboard", "mouse", "bluetooth","camera"]
+        # 配置即显示的模块
+        self.directConfigModuleList = ["battery","motherboard","processor"]
