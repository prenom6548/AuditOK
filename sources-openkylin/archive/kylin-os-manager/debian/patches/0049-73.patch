+    def chkIsMainDisk(self, devName):
+        if len(devName) <= 0 :
+            return "0"
+        status, output = subprocess.getstatusoutput("lsblk -b "+devName)
+        if status :
+            return "0"
+        for line in output.split("\n"):
+            value = line.split()
+            if len(value) >= 7 and value[6]:
+                if value[6] == "/" :
+                    return "1"
+        return "0"
+
+    def chkIsSSD(self, devFileName):
