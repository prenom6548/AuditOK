+### END LICENSE
+
+
+from threading import Thread
+
+
+class KAThread(Thread):
+
+    def __init__(self, func, cbfunc, args):
+        '''
+        :param func: 可调用的对象
+        :param args: 可调用对象的参数
+        '''
+        Thread.__init__(self)
+        self.func = func
+        self.args = args
+        self.cbfunc = cbfunc
+        self.result = ""
+
+    def run(self):
+        self.result = self.func(*self.args)
+        if self.cbfunc :
+            self.cbfunc(1, self.result)
+
+    def getResult(self):
+        return self.result
+
+if __name__ == "__main__":
+    pass
+
