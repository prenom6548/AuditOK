+                        community = tmp.split('=')[1].replace('"', '').replace('\n', '')
+                    elif line.startswith("DISTRIB_DESCRIPTION"):
+                        tmp = line
+                        # kobe: remove '"' and '\n'
+                        community1 = tmp.split('=')[1].replace('"', '').replace('\n', '')
