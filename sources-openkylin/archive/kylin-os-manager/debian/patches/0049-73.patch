+                tempCapacity = tempCapacity.replace("GB", "G")
+                outLine += "-" + tempCapacity
+            if isSSD :
+                outLine += "-PCIe"
+            else :
+                outLine += "-SATA"
+            nIndex = nIndex + 1
+        return outLine
