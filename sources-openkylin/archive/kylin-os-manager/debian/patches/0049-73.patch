+    @dbus.service.method(INTERFACE, in_signature='', out_signature='b')
+    def hide_temperature_page(self):
+        status, output = subprocess.getstatusoutput("sensors")
+        if( status != -1 ):
+            for line in output.split("\n"):
+                if "coretemp-isa" in line:
+                    return True
+            return False
+
+    @dbus.service.method(INTERFACE, in_signature='', out_signature='b')
+    def hide_fan_page(self):
+        faninfo = KAFanInfo()
+        return faninfo.getCpuFanEnable()
+
+    @dbus.service.method(INTERFACE, in_signature='', out_signature='b')
+    def hide_cpufm_page(self):
+        path = '/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq'
+        if os.path.exists(path):
+            return True
+        elif os.path.exists("/proc/cpuinfo"):
+            #动态调频没有的情况下走/proc/cpuinfo
+
+            args = ["cat /proc/cpuinfo | grep -i 'cpu MHz'"]
+            pipe = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE , shell=True)
+            output = pipe.stdout.readlines()
+
+            cpuFreq = ""
+            if len(output) != 0:
+                return True
+            else:
+                return False
+        else:
+            return False
