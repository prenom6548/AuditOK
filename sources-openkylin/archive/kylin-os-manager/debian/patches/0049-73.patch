+def myctoascii(buf):
+    ch = bytes(buf.encode('utf-8'))
+    asci = binascii.b2a_hex(ch)
+    asci = int(asci,16)
+    return asci
+
+def mystrip(s):
+    if(len(s) == 0):
+        return s
+    while len(s) > 0 and myctoascii(s[0]) <= 32:
+        s = s[1: ]
+    k = len(s)
+    while len(s) > 0 and myctoascii(s[k-1]) <= 32:
+        s = s[ :k-1]
+        k = len(s)
+    i = 0
+    while i < len(s):
+        if myctoascii(s[i]) < 32:
+            s = s[ :i] + s[i+1: ]
+            i -= 1
+        i += 1
+    return s
