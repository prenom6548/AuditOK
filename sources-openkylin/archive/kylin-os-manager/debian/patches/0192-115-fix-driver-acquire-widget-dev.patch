@@ -0,0 +1,14 @@
+[Unit]
+Description=kylin os manager driver acquirer
+After=dbus.service
+
+[Service]
+Type=simple
+User=root
+Group=root
+ExecStart=/usr/bin/kylin-os-manager-driver-acquirer
+Restart=on-failure
+RestartSec=2
+
+[Install]
+WantedBy=default.target
