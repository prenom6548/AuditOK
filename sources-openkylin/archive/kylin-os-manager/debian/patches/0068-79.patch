diff --git a/plugins/fault_diagnosis/component/user_experience_dialog.cpp b/plugins/fault_diagnosis/component/user_experience_dialog.cpp
new file mode 100644
index 0000000..7a76c10
--- /dev/null
+++ b/plugins/fault_diagnosis/component/user_experience_dialog.cpp
@@ -0,0 +1,49 @@
+#include "user_experience_dialog.h"
+#include <QVariant>
+
+namespace K {
+
+UserExperienceDialog::UserExperienceDialog(QWidget *parent)
+    : QMessageBox(parent),
+      feedback_btn_(new QPushButton(this)),
+      fixed_btn_(new QPushButton(this))
+{
+    setText(tr("Please confirm if your issue has been fixed?"));
+    setIcon(QMessageBox::Icon::Question);
+
+    feedback_btn_->resize(96, 36);
+    feedback_btn_->setText(tr("Feedback"));
+    connect(feedback_btn_, &QPushButton::clicked, this, &UserExperienceDialog::on_Feedback);
+
+    fixed_btn_->resize(96, 36);
+    fixed_btn_->setText(tr("Fixed"));
+    fixed_btn_->setProperty("isImportant", true);
+    connect(fixed_btn_, &QPushButton::clicked, this, &UserExperienceDialog::on_Fixed);
+
+    addButton(feedback_btn_, QMessageBox::ButtonRole::NoRole);
+    addButton(fixed_btn_, QMessageBox::ButtonRole::YesRole);
+}
+
+void UserExperienceDialog::on_Feedback() const {
+    if (feedback_callback_) {
+        feedback_callback_();
+    }
+}
+
+void UserExperienceDialog::on_Fixed() {
+    accept();
+
+    if (fixed_callback_) {
+        fixed_callback_();
+    }
+}
+
+void UserExperienceDialog::SetFeedBackCallback(FeedBackCallback &&callback) {
+    feedback_callback_ = callback;
+}
+
+void UserExperienceDialog::SetFixedCallback(FixedCallback &&callback) {
+    fixed_callback_ = callback;
+}
+
+}
diff --git a/plugins/fault_diagnosis/component/user_experience_dialog.h b/plugins/fault_diagnosis/component/user_experience_dialog.h
new file mode 100644
index 0000000..df543d2
--- /dev/null
+++ b/plugins/fault_diagnosis/component/user_experience_dialog.h
@@ -0,0 +1,33 @@
+#ifndef KYLIN_OS_MANAGER_PLUGINS_FAULT_DIAGNOSIS_COMPONENT_USER_EXPERIENCE_DIALOG_H
+#define KYLIN_OS_MANAGER_PLUGINS_FAULT_DIAGNOSIS_COMPONENT_USER_EXPERIENCE_DIALOG_H
+
+#include <functional>
+#include <QMessageBox>
+#include <QPushButton>
+
+namespace K {
+
+class UserExperienceDialog: public QMessageBox {
+    Q_OBJECT
+public:
+    using FeedBackCallback = std::function<void()>;
+    using FixedCallback = std::function<void()>;
+
+    UserExperienceDialog(QWidget *parent = nullptr);
+    void SetFeedBackCallback(FeedBackCallback &&callback);
+    void SetFixedCallback(FixedCallback &&callback);
+
+private Q_SLOTS:
+    void on_Feedback() const;
+    void on_Fixed();
+
+private:
+    QPushButton *       feedback_btn_;
+    QPushButton *       fixed_btn_;
+    FeedBackCallback    feedback_callback_;
+    FixedCallback       fixed_callback_;
+};
+
+}
+
+#endif
