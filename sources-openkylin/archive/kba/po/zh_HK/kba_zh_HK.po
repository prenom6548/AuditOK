msgid "Where is the city where you were born?"
msgstr "您出生的城市在哪裡？"

msgid "What is your mother's name?"
msgstr "您母親叫什麼名字？"

msgid "What is your father's name?"
msgstr "您父親叫什麼名字？"

msgid "When is your birthday?"
msgstr "您的生日是什麼時候？"

msgid "When is your mother's birthday?"
msgstr "您母親的生日是什麼時候？"

msgid "When is your father's birthday?"
msgstr "您父親的生日是什麼時候？"

msgid "Which team do you like the most?"
msgstr "您最喜歡哪個球隊？"

msgid "What was your childhood nickname?"
msgstr "您童年時代的綽號是什麼？"

msgid "What is the name of your first pet?"
msgstr "您的第一個寵物叫什麼？"

msgid "What is the name of your alma mater?"
msgstr "您母校的名稱是什麼？"
