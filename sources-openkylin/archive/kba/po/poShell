#!/bin/sh

#运行编译po文件
msgfmt zh_CN/kba_zh_CN.po -o zh_CN/kba.mo
sudo cp zh_CN/kba.mo /usr/share/locale/zh_CN/LC_MESSAGES/kba.mo

msgfmt bo_CN/kba_bo_CN.po -o bo_CN/kba.mo
sudo cp bo_CN/kba.mo /usr/share/locale/bo_CN/LC_MESSAGES/kba.mo

msgfmt mn_MN/kba_mn_MN.po -o mn_MN/kba.mo
sudo cp mn_MN/kba.mo /usr/share/locale/mn_MN/LC_MESSAGES/kba.mo

msgfmt zh_HK/kba_zh_HK.po -o zh_HK/kba.mo
sudo cp zh_HK/kba.mo /usr/share/locale/zh_HK/LC_MESSAGES/kba.mo
