msgid "Where is the city where you were born?"
msgstr "ཁྱོད་སྐྱེས་པའི་གྲོང་ཁྱེར་གང་ན་ཡོད།"

msgid "What is your mother's name?"
msgstr "ཁྱེད་ཀྱི་ཨ་མའི་མིང་ལ་ཅི་ཟེར།"

msgid "What is your father's name?"
msgstr "ཁྱོད་ཀྱི་ཨ་ཕའི་མིང་ལ་ཅི་ཟེར།"

msgid "When is your birthday?"
msgstr "ཁྱོད་ཀྱི་སྐྱེས་སྐར་ག་དུས་རེད།"

msgid "When is your mother's birthday?"
msgstr "ཁྱེད་ཀྱི་ཨ་མའི་སྐྱེས་སྐར་ག་དུས་ཡིན་ནམ།"

msgid "When is your father's birthday?"
msgstr "ཁྱོད་ཀྱི་ཨ་ཕའི་སྐྱེས་སྐར་ག་དུས་རེད།"

msgid "Which team do you like the most?"
msgstr "ཁྱེད་རང་སྤོ་ལོ་རུ་ཁག་གང་ལ་དགའ།"

msgid "What was your childhood nickname?"
msgstr "ཁྱེད་རང་བྱིས་དུས་ཀྱི་དུས་རབས་ཀྱི་མིང་ཆུང་ཆུང་ཅི་ཞིག་ཡིན།"

msgid "What is the name of your first pet?"
msgstr "ཁྱེད་ཀྱི་གཅེས་དངོས་དང་པོའི་མིང་ལ་ཅི་ཟེར།"

msgid "What is the name of your alma mater?"
msgstr "ཁྱེད་ཀྱི་མ་ཡུམ་སློབ་གྲྭའི་མིང་ཅི་ཡིན།"
