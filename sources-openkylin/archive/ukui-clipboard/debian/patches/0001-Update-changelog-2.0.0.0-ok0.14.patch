+
+void ClipboardTray::setkeepAbove(bool arg)
+{
+    if (arg != m_keepAbove) {
+        m_keepAbove = arg;
+        emit keepAboveChanged();
+        if (arg) {
+            m_helper->setWindowState(UkuiWindowHelper::States(0xff) | UkuiWindowHelper::State::KeepAbove);
+        } else {
+            m_helper->setWindowState(UkuiWindowHelper::States(0xff));
+        }
+    }
+}
