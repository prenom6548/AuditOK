+        l_int32 h = 0;
+        boxGetGeometry(box, &x, &y, &w, &h);
+        api->SetRectangle(x, y - 1, w, h + 1);
         char* ocrResult = api->GetUTF8Text();
         textResult.push_back(std::string(ocrResult));
