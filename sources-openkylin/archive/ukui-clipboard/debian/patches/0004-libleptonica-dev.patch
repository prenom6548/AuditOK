diff --git a/interface.h b/interface.h
index c5a1763..c0d2d8d 100644
--- a/interface.h
+++ b/interface.h
@@ -21,22 +21,28 @@ std::vector<std::string> getText(tesseract::TessBaseAPI *api) {
