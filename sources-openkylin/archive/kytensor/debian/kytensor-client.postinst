#!/bin/sh
# postinst script for libtriton-client

sed -i 's|<grpcpp/impl/proto_utils.h>|<grpcpp/impl/codegen/proto_utils.h>|g' /usr/include/triton/client/grpc_service.grpc.pb.h
sed -i 's|<grpcpp/impl/server_callback_handlers.h>|<grpcpp/impl/codegen/server_callback_handlers.h>|g' /usr/include/triton/client/grpc_service.grpc.pb.h

# DEBHELPER#