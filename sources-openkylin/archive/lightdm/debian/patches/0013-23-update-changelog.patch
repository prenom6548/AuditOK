Merge pull request !23 from 杨敏/openkylin/huanghe
---
 data/pam/lightdm                | 5 ++++-
 data/pam/lightdm-autologin      | 2 +-
 src/session-child.c             | 3 ---
 tests/scripts/language-env.conf | 2 ++
 4 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/data/pam/lightdm b/data/pam/lightdm
index f7f77d4..589a274 100644
--- a/data/pam/lightdm
+++ b/data/pam/lightdm
@@ -3,9 +3,12 @@
 # Block login if they are globally disabled
 auth      requisite pam_nologin.so
 
+# Allow members of the nopasswdlogin group to login without a password
+auth      sufficient pam_succeed_if.so user ingroup nopasswdlogin
+
 # Load environment from /etc/environment and ~/.pam_environment
 session      required pam_env.so readenv=1
-session      required pam_env.so readenv=1 envfile=/etc/default/locale
+session      required pam_env.so readenv=1 user_readenv=1 envfile=/etc/default/locale
 
 @include common-auth
 
diff --git a/data/pam/lightdm-autologin b/data/pam/lightdm-autologin
index d90ae06..88079bf 100644
--- a/data/pam/lightdm-autologin
+++ b/data/pam/lightdm-autologin
@@ -7,7 +7,7 @@ auth      requisite pam_nologin.so
 
 # Load environment from /etc/environment and ~/.pam_environment
 session      required pam_env.so readenv=1
-session      required pam_env.so readenv=1 envfile=/etc/default/locale
+session      required pam_env.so readenv=1 user_readenv=1 envfile=/etc/default/locale
 
 # Allow access without authentication
 auth      required pam_succeed_if.so user != root quiet_success
diff --git a/src/session-child.c b/src/session-child.c
index 3b593d9..2d2051a 100644
--- a/src/session-child.c
+++ b/src/session-child.c
@@ -847,9 +847,6 @@ session_child_run (int argc, char **argv)
         /* Reset SIGPIPE handler so the child has default behaviour (we disabled it at LightDM start) */
         signal (SIGPIPE, SIG_DFL);
 
-        /* Reset SIGPIPE handler so the child has default behaviour (we disabled it at LightDM start) */
-        signal (SIGPIPE, SIG_DFL);
-
         /* Run the command */
         execve (command_argv[0], command_argv, pam_getenvlist (pam_handle));
         _exit (EXIT_FAILURE);
diff --git a/tests/scripts/language-env.conf b/tests/scripts/language-env.conf
index c3e7396..4aedf02 100644
--- a/tests/scripts/language-env.conf
+++ b/tests/scripts/language-env.conf
@@ -28,6 +28,8 @@ user-session=default
 #?SESSION-X-0 READ-ENV NAME=LANG VALUE=en_AU
 #?*SESSION-X-0 READ-ENV NAME=GDM_LANG
 #?SESSION-X-0 READ-ENV NAME=GDM_LANG VALUE=en_AU
+#?*SESSION-X-0 READ-ENV NAME=LANGUAGE
+#?SESSION-X-0 READ-ENV NAME=LANGUAGE VALUE=en_AU:en
 
 # Cleanup
 #?*STOP-DAEMON
