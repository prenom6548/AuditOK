+    if (session_get_is_stopping (priv->active_session))
+    {
+        priv->activation_check_source_id = 0;
+        g_object_unref (seat);
+        return FALSE; /* session stopped, no need to continue */
+    }
+
+    /* Check if the activated session is actually on the active VT yet */
+    DisplayServer *ds = session_get_display_server (priv->active_session);
+    if (!ds)
+    {
+        /* No display server yet; keep waiting */
+        return TRUE;
+    }
+
+    gint expected_vt = display_server_get_vt (ds);
+    gint current_vt = vt_get_active ();
+    if (expected_vt < 0 || expected_vt != current_vt)
+    {
+        /* Not active yet; continue polling */
+        return TRUE;
+    }
+
+    /* If session has started running, check if ukui-session process is running.
+     * Check every 5 seconds, maximum 6 times (30 seconds total). */
+    if (!IS_GREETER_SESSION (priv->active_session) && session_get_is_run (priv->active_session))
+    {
+        /* If not in gated Wayland scenario, stop this timer and keep default behavior */
+        if (!should_apply_wayland_commit_behavior (seat, priv->active_session))
+        {
+            priv->activation_check_source_id = 0;
+            g_object_unref (seat);
+            return FALSE;
+        }
+
+        gboolean session_ready = FALSE;
+        
+        /* 只有ukui-session进程启动后，才认为会话启动完成。如果是其他会话，30s后登录界面也会退出，因此
+	 * 这里暂时不判断其他进程。如果需要，可将should_apply_wayland_commit_behavior函数中对wayland类型
+	 * 会话的判断改为kylin-wlcom */
+        const gchar *username = session_get_username (priv->active_session);
+        if (username)
+        {
+            if (detectProcessByName ((char *)"ukui-session", (char *)username) == 0)
+            {
+                l_debug (seat, "Found ukui-session process");
+                session_ready = TRUE;
+            }
+        }
+        
+        if (session_ready)
+        {
+            l_debug (seat, "ukui-session is running, exiting greeter");
+            process_greeters_after_session_ready (seat, priv->active_session);
+            priv->activation_check_source_id = 0;
+            g_object_unref (seat);
+            return FALSE;
+        }
+
+        /* Check if we've exceeded maximum retry count (6 times = 30 seconds) */
+        priv->greeter_owner_check_count++;
+        if (priv->greeter_owner_check_count >= 6)
+        {
+            l_debug (seat, "ukui-session check timeout after 6 attempts, exiting greeter");
+            process_greeters_after_session_ready (seat, priv->active_session);
+            priv->activation_check_source_id = 0;
+            g_object_unref (seat);
+            return FALSE;
+        }
+
+        l_debug (seat, "ukui-session not found yet, check %d/6", priv->greeter_owner_check_count);
+        return TRUE; /* keep polling */
+    }
+
+    /* Session not running yet, continue polling */
+    return TRUE;
+}
