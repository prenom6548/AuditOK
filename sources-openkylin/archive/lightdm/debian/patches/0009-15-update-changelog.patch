+#define RELEASE_DISPLAY_SIGNAL (SIGRTMAX)
+#define ACQUIRE_DISPLAY_SIGNAL (SIGRTMAX - 1)
+
+// 当前设置的VT编号（用于信号处理）
+static gint current_vt_for_signal_handlers = -1;
+
+// 挂起信号处理：通知内核释放显示
+static void
+on_release_display(int sig) {
+    if (current_vt_for_signal_handlers < 0)
+        return;
+    g_autofree gchar *tty_path = g_strdup_printf ("/dev/tty%d", current_vt_for_signal_handlers);
+    int fd = open(tty_path, O_RDWR | O_NOCTTY);
+    if (fd >= 0) {
+        ioctl(fd, VT_RELDISP, 1);
+        close(fd);
+    }
+}
+
+// 恢复信号处理：通知内核重新获取显示
+static void
+on_acquire_display(int sig) {
+    if (current_vt_for_signal_handlers < 0)
+        return;
+    g_autofree gchar *tty_path = g_strdup_printf ("/dev/tty%d", current_vt_for_signal_handlers);
+    int fd = open(tty_path, O_RDWR | O_NOCTTY);
+    if (fd >= 0) {
+        ioctl(fd, VT_RELDISP, VT_ACKACQ);
+        close(fd);
+    }
+}
+
+/**
+ * Set VT to non-refresh mode (graphics mode with VT_PROCESS).
+ * This prevents the VT from being cleared when switching away.
+ * 
+ * @param vt_number The VT number to configure (must be >= 1)
+ * @return 0 on success, non-zero on error
+ */
+gint
+vt_set_non_refresh_mode (gint vt_number)
+{
+#ifdef __linux__
+    if (getuid () != 0)
+        return 1;
+
+    if (vt_number < 1)
+        return 1;
+
+    g_autofree gchar *tty_path = g_strdup_printf ("/dev/tty%d", vt_number);
+    g_debug ("Setting VT %d to non-refresh mode", vt_number);
+
+    int fd = open(tty_path, O_RDWR | O_NOCTTY);
+    if (fd < 0)
+    {
+        g_warning ("Error opening %s: %s", tty_path, strerror (errno));
+        return 1;
+    }
+
+    /* Set graphics mode */
+    if (ioctl(fd, KDSETMODE, KD_GRAPHICS) < 0)
+    {
+        g_warning ("Error setting KD_GRAPHICS mode on %s: %s", tty_path, strerror (errno));
+        close(fd);
+        return 1;
+    }
+
+    /* Set VT_PROCESS mode with signal handlers */
+    struct vt_mode mode = {0};
+    mode.mode = VT_PROCESS;
+    mode.relsig = RELEASE_DISPLAY_SIGNAL;
+    mode.acqsig = ACQUIRE_DISPLAY_SIGNAL;
+    if (ioctl(fd, VT_SETMODE, &mode) < 0)
+    {
+        g_warning ("Error setting VT_PROCESS mode on %s: %s", tty_path, strerror (errno));
+        close(fd);
+        return 1;
+    }
+
+    close(fd);
+
+    /* Update current VT for signal handlers and set up signal handlers */
+    current_vt_for_signal_handlers = vt_number;
+    signal(RELEASE_DISPLAY_SIGNAL, on_release_display);
+    signal(ACQUIRE_DISPLAY_SIGNAL, on_acquire_display);
+
+    return 0;
+#else
+    return 1;
+#endif
+}
+
