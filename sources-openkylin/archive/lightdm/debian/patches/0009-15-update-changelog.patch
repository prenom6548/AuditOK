+// find and replace fisrt substring from original string, if not found return NULL
+static gchar* replace_first_substring(Seat *seat, const gchar* str_orig, const gchar* old_substr, const gchar* new_substr)
+{
+    if (!str_orig || !old_substr || !new_substr) {
+        return NULL;
+    }
+    gsize old_substr_len = strlen(old_substr);
+    gsize new_substr_len = strlen(new_substr);
+    gchar* result = NULL;
+    gsize result_len = 0;
+    gsize i = 0;
+
+    if (g_strstr_len(str_orig, strlen(str_orig), old_substr) != NULL) {
+        // 计算新字符串的总长度
+        result_len = strlen(str_orig) + (new_substr_len - old_substr_len);
+        result = g_malloc0(result_len + 1); // +1 for the null terminator
+
+        if (result == NULL) {
+            l_debug (seat, "Memory allocation failed");
+            return NULL; // In practice, you should handle this error more gracefully
+        }
+
+        i = 0;
+        const gchar* p = str_orig;
+        gboolean is_replaced = FALSE;
+        while (*p) {
+            if (!is_replaced && g_strstr_len(p, strlen(p), old_substr) == p) {
+                strcpy(&result[i], new_substr);
+                i += new_substr_len;
+                p += old_substr_len;
+                is_replaced = TRUE;
+            } else {
+                result[i++] = *p++;
+            }
+        }
+        result[i] = '\0';
+        return result;
+    } else {
+        return NULL;
+    }
+}
