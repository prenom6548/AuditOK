+static int get_allow_switch_user_from_conf2 (void) 
+{
+    static int allow_switch_user = -1;
+    if (allow_switch_user != -1) {
+        return allow_switch_user;
+    }
+
+    KSettings *setting = kdk_conf2_new("lightdm.powermanager", NULL);
+    if (!setting) {
+        syslog(LOG_DEBUG, "load conf2 failed!!");
+        return allow_switch_user;
+    }
+
+    if (!kdk_conf2_has_key(setting, "switch-user")) {
+        kdk_conf2_ksettings_destroy(setting);
+        syslog(LOG_DEBUG, "could not find switch user key!!");
+        return allow_switch_user;
+    }
+    allow_switch_user = kdk_conf2_get_default_boolean(setting, "switch-user");
+    syslog(LOG_DEBUG, "kdkconf2 switch-user:%d:%s\n", allow_switch_user, allow_switch_user ? "True" : "False");
+    kdk_conf2_ksettings_destroy(setting);
+    return allow_switch_user;
+}
+
+static int get_greeter_hide_users_from_conf2 (void) 
+{
+    static int greeter_hide_users = -1;
+    if (greeter_hide_users != -1) {
+        return greeter_hide_users;
+    }
+
+    KSettings *setting = kdk_conf2_new("lightdm.powermanager", NULL);
+    if (!setting) {
+        syslog(LOG_DEBUG, "load conf2 failed!!");
+        return greeter_hide_users;
+    }
+
+    if (!kdk_conf2_has_key(setting, "greeter-hide-users")) {
+        kdk_conf2_ksettings_destroy(setting);
+        syslog(LOG_DEBUG, "could not find hide users key!!");
+        return greeter_hide_users;
+    }
+    greeter_hide_users = kdk_conf2_get_default_boolean(setting, "greeter-hide-users");
+    syslog(LOG_DEBUG, "kdkconf2 greeter-hide-users:%d:%s\n", greeter_hide_users, greeter_hide_users ? "True" : "False");
+    kdk_conf2_ksettings_destroy(setting);
+    return greeter_hide_users;
+}
+
