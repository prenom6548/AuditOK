+static int
+get_uid_by_name (const char *username, uid_t *out_uid)
+{
+    struct passwd *pwd;
+
+    g_return_val_if_fail (username != NULL, -1);
+    g_return_val_if_fail (out_uid != NULL, -1);
+
+    pwd = getpwnam (username);
+    if (pwd == NULL)
+        return -1;
+
+    *out_uid = pwd->pw_uid;
+    return 0;
+}
+
+int detectProcessByName(char * processName, char * userName)
+{
+    FILE* fp = NULL;
+    int buffSize = 100;
+    char buf[buffSize];
+    char command[150];
+    uid_t uid;
+    memset(buf, 0, sizeof(buf));
+    memset(command, 0, sizeof(command));
+
+    if (get_uid_by_name (userName, &uid) < 0)
+        return -1;
+
+    if(snprintf(command, sizeof(command), "ps -u %d | grep %s", (int) uid, processName) < 0)
+        return -1;
+
+    if((fp = popen(command,"r")) == NULL)
+        return -2;
+
+    if((fgets(buf, buffSize, fp))!= NULL)
+    {
+        pclose(fp);
+        fp = NULL;
+        if(NULL != strstr(buf, processName))
+            return 0;
+    }
+
+    if(fp){
+        pclose(fp);
+        fp = NULL;
+    }
+
+    return -3;
+}
+
+int killProcess(char *processName, char * userName)
+{
+    FILE* fp = NULL;
+    int buffSize = 100;
+    char buf[buffSize];
+    char command[150];
+    uid_t uid;
+    memset(buf, 0, sizeof(buf));
+    memset(command, 0, sizeof(command));
+
+    int p = NULL;
+
+    if (get_uid_by_name (userName, &uid) < 0)
+        return -1;
+
+    if (snprintf(command, sizeof(command), "ps -u %d | grep %s", (int) uid, processName) < 0)
+        return -1;
+
+    if ((fp = popen(command, "r")) == NULL)
+        return -2;
+
+    if ((fgets(buf, buffSize, fp)) != NULL)
+    {
+        pclose(fp);
+        fp = NULL;
+        if (strtok(buf, " ") == NULL)
+            return -3;
+        if (strlen(strtok(buf, " ")) == 0)
+            return -3;
+
+        p=atoi(strtok(buf, " "));
+        if (p == 0)
+            return -3;
+
+        int ret = kill(p, 9);
+        if(0==ret)
+            return 0;
+        else
+            return -4;
+    }
+
+    if(fp){
+        pclose(fp);
+        fp = NULL;
+    }
+
+    return -5;
+}
