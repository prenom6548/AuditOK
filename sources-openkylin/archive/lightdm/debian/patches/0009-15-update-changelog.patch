+static gboolean
+get_show_greeter_prompt()
+{
+    // load greeter prompt file
+    g_autoptr(GError) error = NULL;
+    g_autoptr(GKeyFile) greeter_prompt_file = g_key_file_new ();
+    gboolean result = g_key_file_load_from_file (greeter_prompt_file, "/usr/share/ukui-greeter/ukui-greeter.conf", G_KEY_FILE_NONE, &error);
+    if (error) {
+        g_debug ("Failed to load greeter prompt file %s", error->message);
+    }
+    if (!result) {
+        return false;
+    }
+    bool show_prompt = g_key_file_get_boolean(greeter_prompt_file, "Greeter", "showLoginPrompt", NULL);
+    if (!show_prompt) {
+        return false;
+    }
+    g_autofree gchar *prompt_title = g_key_file_get_string(greeter_prompt_file, "Greeter", "promptTitle", NULL);
+    if (!prompt_title || prompt_title[0] == '\0') {
+        return false;
+    }
+    g_autofree gchar *prompt_text = g_key_file_get_string(greeter_prompt_file, "Greeter", "promptText", NULL);
+    if (!prompt_text || prompt_text[0] == '\0') {
+        g_autofree gchar *prompt_text_file_path = g_key_file_get_string(greeter_prompt_file, "Greeter", "promptTextFilePath", NULL);
+        if (!prompt_text_file_path || prompt_text_file_path[0] == '\0') {
+            return false;
+        }
