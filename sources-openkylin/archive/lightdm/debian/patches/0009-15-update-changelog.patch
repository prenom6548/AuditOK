@@ -36,6 +41,107 @@ G_DEFINE_TYPE_WITH_PRIVATE (Configuration, config, G_TYPE_OBJECT)
 
 static Configuration *configuration_instance = NULL;
 
+
+static gboolean hasCheck = FALSE;
+static gboolean is990 = FALSE;
+
+#define HARDWARE_FILE "/proc/hardware"
+#define CMDLINE_FILE "/proc/cmdline"
+
+static gboolean is_oem_info_contains(gchar *session, gchar *key_word)
+{
+    if (!session || session[0] == '\0' || !key_word || key_word[0] == '\0') {
+        return FALSE;
+    }
+    GPtrArray *args_dmidecode = NULL;
+    gchar *stdout_dmidecode = NULL;
+    gint exit_status;
+
+    args_dmidecode = g_ptr_array_new ();
+    g_ptr_array_add(args_dmidecode, (gpointer)"/usr/sbin/dmidecode");
+    g_ptr_array_add(args_dmidecode, (gpointer)"-t");
+    g_ptr_array_add(args_dmidecode, (gpointer)"11");
+    g_ptr_array_add(args_dmidecode, NULL);
+
+    if (!g_spawn_sync(NULL, (char**)args_dmidecode->pdata, NULL, 
+                    G_SPAWN_STDERR_TO_DEV_NULL, NULL, NULL, 
+                    &stdout_dmidecode, NULL, &exit_status, NULL) || exit_status != 0) {
+        if (stdout_dmidecode)
+            g_free(stdout_dmidecode);
+        g_ptr_array_free (args_dmidecode, TRUE);
+        return FALSE;
+    }
+
+    if (stdout_dmidecode) {
+        //g_debug("check oem info:%s--%s:%s\n", stdout_dmidecode, session, key_word);
+        g_auto(GStrv) oem_infos = g_strsplit (stdout_dmidecode, "\n", -1);
+        g_ptr_array_free (args_dmidecode, TRUE);
+        g_free(stdout_dmidecode);
+        for (int i = 0; oem_infos[i]; i++) {
+            if (g_strstr_len(oem_infos[i], strlen(oem_infos[i]), session)
+                && g_strstr_len(oem_infos[i], strlen(oem_infos[i]), key_word)) {
+                return TRUE;
+            }
+        }
+        return FALSE;
+    }
+    g_ptr_array_free (args_dmidecode, TRUE);
+    return FALSE;
+}
+
+gboolean config_get_is990()
+{
+    if(hasCheck)
+        return is990;
+    
+    hasCheck = TRUE;	
+
+    if (is_oem_info_contains("String 4", "PGUX")) {  // PANGUX
+        is990 = TRUE;
+        g_debug("Is HW PGUX");
+    } else {
+        FILE *file;
+        char buf[1024];
+
+        if( (file = fopen(HARDWARE_FILE, "r")) == NULL) {
+            is990 = FALSE;
+            return is990;
+        }
+        memset(buf, 0, sizeof(buf));
+        fgets(buf, sizeof(buf), file);
+        fclose(file);
+
+        //由于fgets会保存一个换行符导致字符串匹配失败，因此使用strstr来代替
+        if(strcasestr(buf, "kirin")){
+            is990 = TRUE;
+        }else if(strcasestr(buf, "pangu") && strcasestr(buf, "m900")){
+            is990 = TRUE;
+        }else{
+            is990 = FALSE;
+        }
+    }
+    return is990;
+}
+
+gboolean config_get_is_install_mode()
+{
+    FILE *file;
+    if( (file = fopen(CMDLINE_FILE, "r")) == NULL) {
+        return FALSE;
+    }
+
+    char buf[2048] = {0};
+    fgets(buf, sizeof(buf), file);
+    fclose(file);
+
+    // 匹配boot=casper表示安装模式
+    if(strcasestr(buf, "boot=casper")){
+        return TRUE;
+    }else{
+        return FALSE;
+    }
+}
+
 Configuration *
 config_get_instance (void)
 {
@@ -386,9 +492,13 @@ config_init (Configuration *config)
     g_hash_table_insert (config->priv->seat_keys, "autologin-guest", GINT_TO_POINTER (KEY_SUPPORTED));
     g_hash_table_insert (config->priv->seat_keys, "autologin-user", GINT_TO_POINTER (KEY_SUPPORTED));
     g_hash_table_insert (config->priv->seat_keys, "autologin-user-timeout", GINT_TO_POINTER (KEY_SUPPORTED));
+    g_hash_table_insert (config->priv->seat_keys, "autologin-greeter-timeout", GINT_TO_POINTER (KEY_SUPPORTED));
     g_hash_table_insert (config->priv->seat_keys, "autologin-in-background", GINT_TO_POINTER (KEY_SUPPORTED));
     g_hash_table_insert (config->priv->seat_keys, "autologin-session", GINT_TO_POINTER (KEY_SUPPORTED));
     g_hash_table_insert (config->priv->seat_keys, "exit-on-failure", GINT_TO_POINTER (KEY_SUPPORTED));
+    /* Wayland greeter black-screen handling */
+    g_hash_table_insert (config->priv->seat_keys, "delay-greeter-exit", GINT_TO_POINTER (KEY_SUPPORTED));
+    g_hash_table_insert (config->priv->seat_keys, "draw-background", GINT_TO_POINTER (KEY_SUPPORTED));
     g_hash_table_insert (config->priv->seat_keys, "xdg-seat", GINT_TO_POINTER (KEY_DEPRECATED));
 
     g_hash_table_insert (config->priv->xdmcp_keys, "enabled", GINT_TO_POINTER (KEY_SUPPORTED));
