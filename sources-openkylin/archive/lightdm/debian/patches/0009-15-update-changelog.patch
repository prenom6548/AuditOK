+static void
+restart_lightdm_service (Seat *seat)
+{
+    g_autoptr(GError) error = NULL;
+    g_autoptr(GDBusConnection) connection = g_bus_get_sync (G_BUS_TYPE_SYSTEM, NULL, &error);
+    
+    if (error)
+    {
+        l_debug (seat, "Failed to get system bus for restarting lightdm.service: %s", error->message);
+        return;
+    }
+    
+    if (!connection)
+    {
+        l_debug (seat, "Failed to get system bus connection for restarting lightdm.service");
+        return;
+    }
+    
+    l_debug (seat, "Restarting lightdm.service via systemd dbus interface");
+    
+    /* Call RestartUnit method on systemd Manager interface
+     * Method signature: RestartUnit(ss) -> o
+     * Parameters: unit name, mode
+     * Returns: job object path
+     */
+    g_autoptr(GVariant) result = g_dbus_connection_call_sync (connection,
+                                                              "org.freedesktop.systemd1",
+                                                              "/org/freedesktop/systemd1",
+                                                              "org.freedesktop.systemd1.Manager",
+                                                              "RestartUnit",
+                                                              g_variant_new ("(ss)", "lightdm.service", "replace"),
+                                                              G_VARIANT_TYPE ("(o)"),
+                                                              G_DBUS_CALL_FLAGS_NONE,
+                                                              -1,
+                                                              NULL,
+                                                              &error);
+    
+    if (error)
+    {
+        l_debug (seat, "Failed to restart lightdm.service via systemd dbus: %s", error->message);
+    }
+    else
+    {
+        l_debug (seat, "Successfully called systemd to restart lightdm.service");
+    }
+}
