+/* One-shot callback to exit greeter after a fixed delay (5s). Re-checks state
+ * before stopping greeter to handle logout/cancel between scheduling and fire. */
+static gboolean
+greeter_exit_after_delay_cb (gpointer user_data)
+{
+    Seat *seat = SEAT(user_data);
+    SeatPrivate *priv = seat_get_instance_private (seat);
+
+    /* Clear source id first to avoid double-remove */
+    priv->greeter_exit_delay_source_id = 0;
+
+    if (!priv->active_session)
+    {
+        g_object_unref (seat);
+        return FALSE;
+    }
+
+    /* If session is stopping or VT no longer matches, abort */
+    if (session_get_is_stopping (priv->active_session))
+    {
+        g_object_unref (seat);
+        return FALSE;
+    }
+
+    DisplayServer *ds = session_get_display_server (priv->active_session);
+    if (ds)
+    {
+        gint expected_vt = display_server_get_vt (ds);
+        gint current_vt = vt_get_active ();
+        if (expected_vt >= 0 && expected_vt != current_vt)
+        {
+            g_object_unref (seat);
+            return FALSE;
+        }
+    }
+
+    if (!session_get_is_run (priv->active_session))
+    {
+        g_object_unref (seat);
+        return FALSE;
+    }
+
+    /* Proceed to stop greeter now */
+    process_greeters_after_session_ready (seat, priv->active_session);
