+ */
+#ifndef JSON_H
+#define JSON_H
+
+#include <QTextStream>
+#include <qjsonobject.h>
+#include <QJsonDocument>
+#include <QFile>
+#include <string>
+#include <syslog.h>
+
+/**
+* @brief jsonæ–‡ä»¶çš„ç±»åž‹
+*/
+enum class JsonType
+{
+    JSON_TYPE_SOUNDEFFECT = 0, // å¼€æœºéŸ³æ•ˆç±»åž‹çš„jsonæ–‡ä»¶
+    JSON_TYPE_USERINFO,        // ç”¨æˆ·ä¿¡æ¯ç±»åž‹çš„jsonæ–‡ä»¶
+    JSON_TYPE_UNKNOWN          // æœªçŸ¥ç±»åž‹çš„jsonæ–‡ä»¶
+};
+
+class IJson
+{
+public:
+    IJson(const QString& name, const JsonType& type) : m_filename(name), m_type(type)
+    {
+        load();
+    }
+
+    virtual ~IJson()
+    {
+        save();
+    }
+
+    /**
+    * @brief  åˆå§‹åŒ–jsonæ–‡ä»¶
+    */
+    virtual void init() = 0;
+
+    /**
+    * @brief  åˆ é™¤jsonæ–‡ä»¶ä¸­é”®ä¸ºkeyçš„é”®å€¼å¯¹
+    *
+    * @param  key éœ€è¦åˆ é™¤çš„é”®
+    */
+    virtual void remove(const QString& key) = 0;
+
+    /**
+    * @brief  åœ¨jsonæ–‡ä»¶æ’å…¥é”®å€¼å¯¹
+    *
+    * @param  key æ’å…¥çš„é”®
+    *         value æ’å…¥çš„å€¼
+    */
+    virtual void insert(const QString& key, const QJsonValue& value) = 0;
+
+    /**
+    * @brief  èŽ·å–jsonæ–‡ä»¶æŒ‡å®šé”®å€¼
+    *
+    * @param  key èŽ·å–çš„é”®
+    * @return
+    */
+    virtual QJsonValue getValue(QString key) const = 0;
+
+    void update()
+    {
+        save();
+    }
+
+private:
+    void load()
+    {
+        QFile file(m_filename);
+        if (!file.open(QFile::ReadWrite)) {
+            return;
+        }
+
+        QTextStream m_textStream(&file);
+        QString str = m_textStream.readAll();
+        file.close();
+
+        QJsonParseError jsonError;
+        QJsonDocument doc = QJsonDocument::fromJson(str.toUtf8(), &jsonError);
+
+        if (jsonError.error != QJsonParseError::NoError) {
+            return;
+        }
+
+        m_rootObj = doc.object();
+    }
+
+    void save() {
+        QJsonDocument doc(m_rootObj);
+        QFile file(m_filename);
+        if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+            syslog(LOG_ERR, "open %s failed, %s", m_filename.toLatin1().data(), strerror(errno));
+            return;
+        }
+
+        QTextStream m_textStream(&file);
+        m_textStream.setCodec("UTF-8");
+        m_textStream << doc.toJson();
+        file.close();
+    }
+
+protected:
+    QString m_filename;
+    QJsonObject m_rootObj;
+    JsonType m_type;
+};
+
+
+#endif // IJSON_H
