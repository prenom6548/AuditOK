+int DataManagementService::doGetFeatureStatus(int &errorCode)
+{
+    FeatureStatus featureStatus = EmbeddingTaskManager::getInstance()->checkEmbeddingFeatureStatus();
+    int status = -1;
+    // 如果dbus getFeatureStatus接口定义更新，或者FeatureStatus更新此处需同步更新
+    // dbus 接口定义见 src/datamanagement/datamanagementprocessor.xml
+    switch (featureStatus) {
+    case FeatureStatus::Available:
+        status = 0;
+        break;
+    case FeatureStatus::NotInstalled:
+        status = 1;
+        break;
+    case FeatureStatus::NotSupported:
+        status = 2;
+        break;
+    default:
+        break;
+    }
+
+    if (-1 == status) {
+        errorCode = DATA_MANAGEMENT_UNKNOWN_ERROR;
+    }
+
+    return status;
+}
