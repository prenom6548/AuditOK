+        PyErr_Print();
+        Py_XDECREF(pyIds);
+        Py_XDECREF(args_tuple);
+        return vectorDates;
+    }
+
+    Py_XDECREF(pyIds);
+    Py_XDECREF(args_tuple);
+    vectorDates = convertPyObjectToVectorVectorData(result);
+    return vectorDates;
