#!/bin/sh

set -e

deb-systemd-helper --user enable kylin-ai-business-framework-service.service

# create python virtual env install python depends to venv
python3 -m venv /usr/share/kylin-ai-business-framework/python-env
. /usr/share/kylin-ai-business-framework/python-env/bin/activate

# Check the architecture and install depends
ARCH=$(uname -m)
if [ "$ARCH" = "x86_64" ]; then
    echo "Detected x86_64 architecture. Installing packages from amd64 directory."
    pip3 install /usr/share/kylin-ai-business-framework/python-depends/amd64/*
elif [ "$ARCH" = "aarch64" ]; then
    echo "Detected aarch64 architecture. Installing packages from arm64 directory."
    pip3 install /usr/share/kylin-ai-business-framework/python-depends/arm64/*
else
    echo "Unsupported architecture: $ARCH"
fi

deactivate

#DEBHELPER#
