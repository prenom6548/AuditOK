<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
    <interface name="org.openkylin.aisdk.DataManagementProcessor">

        <!--
          @brief similarity search
          @param [in] content of the search, a json string, has at least a 'text' key
          @param [in] uid of the user, a int
          @param [out] search result, a json with 'filepath' key and 'similarity' key
          @param [out] error message returned
        -->
        <method name="similaritySearch">
            <arg name="searchConditions" type="s" direction="in" />
            <arg name="uid" type="i" direction="in" />
            <arg name="searchResult" type="s" direction="out" />
            <arg name="errorMsg" type="i" direction="out" />
        </method>

        <!--
          @brief add text file to user data
          @param [in] text files info, a json with 'filepath' key and 'fileformat' key
          @param [in] uid of the user, a int
          @param [out] error message returned
        -->
        <method name="addTextFiles">
            <arg name="fileinfos" type="s" direction="in" />
            <arg name="uid" type="i" direction="in" />
            <arg name="errorMsg" type="i" direction="out" />
        </method>

        <!--
          @brief add image file to user data
          @param [in] image files info, a json with 'filepath' key and 'fileformat' key
          @param [in] uid of the user, a int
          @param [out] error message returned
        -->
        <method name="addImageFiles">
            <arg name="fileinfos" type="s" direction="in" />
            <arg name="uid" type="i" direction="in" />
            <arg name="errorMsg" type="i" direction="out" />
        </method>

        <!--
          @brief delete files from user data
          @param [in] files need delete, a json with 'filepath' key
          @param [in] uid of the user, a int
          @param [out] error message returned
        -->
        <method name="deleteFiles">
            <arg name="fileinfos" type="s" direction="in" />
            <arg name="uid" type="i" direction="in" />
            <arg name="errorMsg" type="i" direction="out" />
        </method>

        <!--
          @brief update file name from user data
          @param [in] files need update, a json with 'old_filepath' key and 'new_filepath' key
          @param [in] uid of the user, a int
          @param [out] error message returned
        -->
        <method name="updateFilesName">
            <arg name="fileinfos" type="s" direction="in" />
            <arg name="uid" type="i" direction="in" />
            <arg name="errorMsg" type="i" direction="out" />
        </method>

        <!--
          @brief update file content data from user data
          @param [in] files need update, a json string with 'filepath' key
          @param [in] uid of the user, a int
          @param [out] error message returned
        -->
        <method name="updateFilesContentData">
            <arg name="fileinfos" type="s" direction="in" />
            <arg name="uid" type="i" direction="in" />
            <arg name="errorMsg" type="i" direction="out" />
        </method>

        <!--
          @brief get user all files info
          @param [in] all files info of user, a json string with 'filepath' key and 'timestamp' key
          @param [in] uid of the user, a int
          @param [out] error message returned
        -->
        <method name="getAllFileinfos">
            <arg name="fileinfos" type="s" direction="out" />
            <arg name="uid" type="i" direction="in" />
            <arg name="errorMsg" type="i" direction="out" />
        </method>

    </interface>
</node>
