include (../codec/kylinimagecodec/kylinimagecodec.pro)
#include (../codec/plugins/OCR/OCR.pri)
QT       += core gui
QT       += dbus quickcontrols2
QT       += x11extras KWindowSystem printsupport network quick quickwidgets sql
greaterThan(QT_MAJOR_VERSION, 4): QT += widgets
CONFIG += no_keywords
CONFIG += link_pkgconfig
CONFIG += c++11 c++17
QMAKE_LFLAGS += -Wl,--gc-sections -Wl,--as-needed

#这个是QT内嵌的版本号关键字，只能使用a.b.c.d纯数字形式，与changelog中的版本号不完全一致
VERSION = 1.3.1.4
DEFINES += APP_VERSION=\\\"$$VERSION\\\"
##定义一个字符串，可以将版本号数字之后的部分添加进去
DEFINES += APP_VERSION_DETAIL=\\\"$$VERSION-ok13\\\"

QMAKE_CXXFLAGS += -g

#INCLUDEPATH += \
#/usr/include/glib-2.0/ \
#/usr/lib/x86_64-linux-gnu/glib-2.0/include/ \

#适配sdk
PKGCONFIG += kysdk-qtwidgets kysdk-waylandhelper kysdk-log kysdk-config kysdk-utils kysdk-datacollect kysdk-ukuiwindowhelper

#sdk不一样的版本路径有更改
INCLUDEPATH += /usr/include/kabase/
INCLUDEPATH += /usr/include/kysdk/applications/kabase/kylin_system/
INCLUDEPATH += /usr/include/kabase/kylin_system/
INCLUDEPATH += /usr/include/kysdk/applications/kabase/
INCLUDEPATH += /usr/include/kysdk/applications/ukuiwindowhelper/

LIBS += -ldl -lukui-log4qt -lpthread
LIBS +=-lX11

TARGET = kylin-photo-viewer
TEMPLATE = app

PKGCONFIG += gsettings-qt

DEFINES += QT_DEPRECATED_WARNINGS

PKGCONFIG +=gio-2.0 peony
LIBS +=-lgio-2.0 -lpeony
#kylin-image-codec
#INCLUDEPATH += /usr/include/kylin-image-codec/
#LIBS += -lkylinimagecodec \

#opencv
INCLUDEPATH += /usr/include/opencv4/
LIBS += -lopencv_core \
        -lopencv_imgcodecs \
        -lopencv_imgproc \
        -lopencv_highgui \

contains(QMAKE_HOST.arch, x86_64){
DEFINES += USE_ONNXRUNTIME
INCLUDEPATH += /usr/include/onnxruntime
PKGCONFIG += libonnxruntime
#LIBS += -L/usr/lib -lonnxruntime
}

contains(QMAKE_HOST.arch, aarch64){
DEFINES += USE_ONNXRUNTIME
INCLUDEPATH += /usr/include/onnxruntime
PKGCONFIG += libonnxruntime
#LIBS += -L/usr/lib -lonnxruntime
}

DEFINES += SUPPORTSCANNER

target.path = /usr/bin
target.source +=$$TARGET
INSTALLS += target

SOURCES += main.cpp \
    controller/core/coreinteraction.cpp \
