<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.ukui.groupmanager.interface">
    <method name="getGroup">
      <arg type="av" direction="out"/>
    </method>
    <method name="getPasswd">
      <arg type="av" direction="out"/>
    </method>
    <method name="add">
      <arg type="b" direction="out"/>
      <arg name="groupName" type="s" direction="in"/>
      <arg name="groupId" type="s" direction="in"/>
    </method>
    <method name="set">
      <arg type="b" direction="out"/>
      <arg name="groupName" type="s" direction="in"/>
      <arg name="groupId" type="s" direction="in"/>
    </method>
    <method name="del">
      <arg type="b" direction="out"/>
      <arg name="groupName" type="s" direction="in"/>
    </method>
    <method name="addUserToGroup">
      <arg type="b" direction="out"/>
      <arg name="groupName" type="s" direction="in"/>
      <arg name="userNameList" type="as" direction="in"/>
    </method>
    <method name="delUserFromGroup">
      <arg type="b" direction="out"/>
      <arg name="groupName" type="s" direction="in"/>
      <arg name="userNameList" type="as" direction="in"/>
    </method>
    <method name="changeOtherUserPasswd">
      <arg type="b" direction="out"/>
      <arg name="username" type="s" direction="in"/>
      <arg name="pwd" type="s" direction="in"/>
    </method>
    <method name="createUser">
      <arg type="b" direction="out"/>
      <arg name="name" type="s" direction="in"/>
      <arg name="fullname" type="s" direction="in"/>
      <arg name="accounttype" type="i" direction="in"/>
      <arg name="faceicon" type="s" direction="in"/>
    </method>
    <method name="setNoPwdLoginStatus">
      <arg type="b" direction="out"/>
      <arg name="status" type="b" direction="in"/>
      <arg name="username" type="s" direction="in"/>
    </method>
    <method name="getNoPwdLoginStatus">
      <arg type="s" direction="out"/>
    </method>
    <method name="setAutomaticLogin">
      <arg type="b" direction="out"/>
      <arg name="objpath" type="s" direction="in"/>
      <arg name="enabled" type="b" direction="in"/>
    </method>
    <method name="setIconFile">
      <arg type="b" direction="out"/>
      <arg name="username" type="s" direction="in"/>
      <arg name="objpath" type="s" direction="in"/>
      <arg name="filename" type="s" direction="in"/> 
    </method>
    <method name="setIconFileRename">
      <arg type="b" direction="out"/>
      <arg name="filename" type="s" direction="in"/>
      <arg name="refilename" type="s" direction="in"/>
      <arg name="objpath" type="s" direction="in"/>
    </method>
    <method name="delIconFile">
      <arg type="b" direction="out"/>
      <arg name="filenameList" type="as" direction="in"/>
      <arg name="objpath" type="s" direction="in"/>
    </method>
    <method name="setAccountType">
      <arg type="b" direction="out"/>
      <arg name="objpath" type="s" direction="in"/>
      <arg name="accountType" type="i" direction="in"/>
    </method>
    <method name="deleteUser">
      <arg type="b" direction="out"/>
      <arg name="id" type="x" direction="in"/>
      <arg name="removeFiles" type="b" direction="in"/>
    </method>
    <method name="isPasswordMinAgeReached">
      <arg type="b" direction="out"/>
      <arg name="username" type="s" direction="in"/>
    </method>
  </interface>
</node>
