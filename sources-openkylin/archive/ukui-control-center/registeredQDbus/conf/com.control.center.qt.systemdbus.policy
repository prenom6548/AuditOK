<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>

  <vendor>KYLINOS</vendor>
  <vendor_url>http://www.kylinos.cn</vendor_url>
  <icon_name>ues</icon_name>

  <action id="org.control.center.qt.systemdbus.action">
    <description>UserInfo</description>
    <description xml:lang="zh">账户信息</description>
    <description xml:lang="bo">ཐོ་ཁུངས་ཆ་འཕྲིན་</description>
    <description xml:lang="ug_CN">ھېسابات ئۇچۇرى </description>
    <message>Authorization required to modify user data.</message>
    <message xml:lang="zh">需要授权以修改用户数据</message>
    <message xml:lang="bo">སྤྱོད་མཁན་གྱི་གཞི་གྲངས་ལ་བརྟེན་ནས་བཟོ་བཅོས་བྱེད་དབང་བསྐུར་དགོས་།</message>
    <message xml:lang="ug_CN">خېرىدارلارنىڭ سانلىق مەلۇماتىنى ئۆزگەرتىش ھوقۇقى بېرىش كېرەك</message>
    <message xml:lang="ms_MY">Kebenaran diperlukan untuk mengubah suai data pengguna.</message>
    <message xml:lang="vi_VN">Cần có ủy quyền để sửa đổi dữ liệu người dùng.</message>
    <message xml:lang="th_TH">จําเป็นต้องมีการอนุญาตเพื่อแก้ไขข้อมูลผู้ใช้</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.control.center.qt.systemdbus.action.ntp">
    <description>Ntp server address</description>
    <description xml:lang="zh">时间服务器</description>
    <description xml:lang="bo">དུས་ཚོད་ཞབས་ཞུ་ཆས་</description>
    <message>To change the ntp server address, you need to authenticate.</message>
    <message xml:lang="zh">需要通过管理员认证后才可以修改时间服务器</message>
    <message xml:lang="bo">དོ་དམ་པ་དཔང་དངོས་བདེན་པ་ཡིན་པའི་ར་སྤྲད་བརྒྱད་དགོས་།</message>
    <message xml:lang="ms_MY">Anda perlu lulus pengesahan pentadbir sebelum anda boleh mengubah suai pelayan masa.</message>
    <message xml:lang="vi_VN">Bạn cần vượt qua xác thực quản trị viên trước khi có thể sửa đổi máy chủ thời gian.</message>
    <message xml:lang="th_TH">คุณต้องผ่านการรับรองความถูกต้องของผู้ดูแลระบบก่อนจึงจะสามารถปรับเปลี่ยนเซิร์ฟเวอร์เวลาได้</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.control.center.qt.systemdbus.action.timezone">
    <description>Set TimeZone</description>
    <description xml:lang="zh">时区</description>
    <description xml:lang="bo">དུས་ཚོད་ཞབས་ཞུ་ཆས་</description>
    <message>To change the time zone, you need to authenticate.</message>
    <message xml:lang="zh">需要通过管理员认证后才可以修改时区</message>
    <message xml:lang="bo">ངོ་དོ་དམ་པ་ཁས་ལེན་བྱས་པའི་རྗེས་ད་གཟོད་བཟོ་བཅོས་དུས་ཁུལ།</message>
    <message xml:lang="ms_MY">Anda perlu lulus pengesahan pentadbir sebelum anda boleh mengubah suai pelayan masa.</message>
    <message xml:lang="vi_VN">Bạn cần vượt qua xác thực quản trị viên trước khi có thể sửa đổi máy chủ thời gian.</message>
    <message xml:lang="th_TH">คุณต้องผ่านการรับรองความถูกต้องของผู้ดูแลระบบก่อนจึงจะสามารถปรับเปลี่ยนเซิร์ฟเวอร์เวลาได้</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.control.center.qt.systemdbus.action.autologin">
    <description>auto login</description>
    <description xml:lang="zh">自动登录</description>
    <description xml:lang="bo">ཐོ་རང་འགོད།་</description>
    <description xml:lang="ug_CN">ئاپتوماتىك كىرىش</description>
    <message>Change auto login, you need to authenticate.</message>
    <message xml:lang="zh">修改自动登录需要认证</message>
    <message xml:lang="bo">དོ་དམ་པ་དཔང་དངོས་བདེན་པ་ཡིན་པའི་ར་སྤྲད་བརྒྱད་དགོས་།</message>
    <message xml:lang="ug_CN">ئاپتوماتىك تىزىملىتىشنى ئۆزگەرتىش ئۈچۈن ئىسپاتلاش كېرەك</message>
    <message xml:lang="ms_MY">Pengesahan diperlukan untuk mengubah suai log masuk automatik.</message>
    <message xml:lang="vi_VN">Xác thực là bắt buộc để sửa đổi đăng nhập tự động.</message>
    <message xml:lang="th_TH">จําเป็นต้องมีการรับรองความถูกต้องเพื่อแก้ไขการเข้าสู่ระบบอัตโนมัติ</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.control.center.qt.systemdbus.action.pid">
    <description>set pid</description>
    <description xml:lang="zh">设置PID</description>
    <description xml:lang="bo">གསར་འཛུགས་།</description>
    <message>To set the pid, you need to authenticate.</message>
    <message xml:lang="zh">需要通过管理员认证后才可以设置PID</message>
    <message xml:lang="bo">དོ་དམ་པ་དཔང་དངོས་བདེན་པ་ཡིན་པའི་ར་སྤྲད་བརྒྱད་དགོས་།</message>
    <message xml:lang="ms_MY">Anda perlu lulus pengesahan pentadbir sebelum anda boleh menyediakan PID.</message>
    <message xml:lang="vi_VN">Bạn cần vượt qua xác thực quản trị viên trước khi có thể thiết lập PID.</message>
    <message xml:lang="th_TH">คุณต้องผ่านการรับรองความถูกต้องของผู้ดูแลระบบก่อนจึงจะสามารถตั้งค่า PID ได้</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.control.center.qt.systemdbus.action.grub">
    <description>set grub</description>
    <description xml:lang="zh">Grub 设置</description>
    <description xml:lang="zh_HK">Grub 設置</description>
    <description xml:lang="mn">Grub ᠪᠠᠶᠢᠷᠢᠯᠠᠭᠤᠯᠬᠤ</description>
    <message>To set the grub settings, you need to authenticate.</message>
    <message xml:lang="zh">需要通过管理员认证后才可以设置 Grub 设置</message>
    <message xml:lang="zh_HK">需要通過管理員認證後才可以設置 Grub 設置</message>
    <message xml:lang="bo">དོ་དམ་པས་དཔང་དངོས་བདེན་པ་ཡིན་པའི་ར་སྤྲོད་བརྒྱུད་རྗེས་ད་གཟོད་འཛུགས་ཆོག་གི་Grubབཀོད་སྒྲིག་བཅས་བྱ་དགོས།</message>
    <message xml:lang="mn">ᠬᠠᠮᠢᠶᠠᠷᠤᠭᠴᠢ ᠶᠢᠨ ᠭᠡᠷᠡᠴᠢᠯᠡᠭᠡ ᠶᠢ ᠥᠩᠭᠡᠷᠡᠭᠡᠭᠰᠡᠨ ᠦ ᠳᠠᠷᠠᠭ᠎ᠠ ᠰᠠᠶ ᠢ Grub ᠪᠠᠶᠢᠷᠢᠯᠠᠭᠤᠯᠬᠤ</message>
    <message xml:lang="ms_MY">Pengesahan pentadbir diperlukan sebelum anda boleh menyediakan tetapan Grub.</message>
    <message xml:lang="vi_VN">Cần xác thực quản trị viên trước khi bạn có thể thiết lập cài đặt Grub.</message>
    <message xml:lang="th_TH">คุณต้องมีการตรวจสอบสิทธิ์ผู้ดูแลระบบก่อนจึงจะสามารถตั้งค่า Grub ได้</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.control.center.qt.systemdbus.action.hostname">
    <description>set host name</description>
    <description xml:lang="zh">设置主机名</description>
    <description xml:lang="zh_HK">設置主機名</description>
    <message>To set the hostname, you need to authenticate.</message>
    <message xml:lang="zh">需要通过管理员认证后才可以设置主机名</message>
    <message xml:lang="zh_HK">需要通過管理員認證後才可以設置主機名</message>
    <message xml:lang="bo">དོ་དམ་པས་དཔང་དངོས་བདེན་པ་ཡིན་པའི་ར་སྤྲོད་བརྒྱུད་རྗེས་ད་གཟོད་འཕྲུལ་འཁོར་གྱི་མིང་བཀོད་སྒྲིག་བྱས་ཆོག་།</message>
    <message xml:lang="ms_MY">Anda perlu lulus pengesahan pentadbir sebelum anda boleh menetapkan nama hos.</message>
    <message xml:lang="vi_VN">Bạn cần vượt qua xác thực quản trị viên trước khi có thể đặt tên máy chủ.</message>
    <message xml:lang="th_TH">คุณต้องผ่านการตรวจสอบสิทธิ์ผู้ดูแลระบบก่อนจึงจะสามารถตั้งค่าชื่อโฮสต์ได้</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.control.center.qt.systemdbus.action.packageinstall">
    <description>install package</description>
    <description xml:lang="zh">安装软件包</description>
    <message>Authentication is required to install software packages.</message>
    <message xml:lang="zh">安装软件包需要管理员认证</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.control.center.qt.systemdbus.action.packageuninstall">
    <description>uninstall package</description>
    <description xml:lang="zh">卸载软件包</description>
    <message>Authentication is required to uninstall software packages.</message>
    <message xml:lang="zh">卸载软件包需要管理员认证</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  <action id="org.control.center.qt.systemdbus.action.remote">
    <description>Remote Desktop</description>
    <description xml:lang="zh">远程桌面</description>
    <description xml:lang="zh_HK">遠端桌面</description>
    <description xml:lang="mn">ᠠᠯᠤᠰ ᠰᠢᠷᠡᠭᠡᠨ ᠨᠢᠭᠤᠷ</description>
    <message>To set the remote desktop settings, you need to authenticate.</message>
    <message xml:lang="zh">需要通过管理员认证后才可以修改远程桌面设置</message>
    <message xml:lang="zh_HK">需要通過管理員認證後才可以修改遠端桌面設置</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
