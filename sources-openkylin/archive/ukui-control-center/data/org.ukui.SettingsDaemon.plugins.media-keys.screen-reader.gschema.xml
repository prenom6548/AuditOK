<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="ukui-control-center">
    <schema id="org.ukui.SettingsDaemon.plugins.media-keys.screen-reader" path="/org/ukui/SettingsDaemon/plugins/media-keys/screen-reader/">
    <key name="command" type="s">
      <default>'gdbus call --session --dest org.ukui.ukcc.session --object-path /Accessibility --method org.ukui.ukcc.session.Accessibility.toggleScreenReader'</default>
      <summary>Enable or disable screen reader</summary>
      <description>Enable or disable screen reader.</description>
    </key>
    <key name="shortcutkey-screen-reader" type="s">
      <default>'&lt;win&gt;&lt;alt&gt;s'</default>
      <summary>Keyboard shortcut used to Enable or disable screen reader</summary>
      <description>Keyboard shortcut used to Enable or disable screen reader.</description>
    </key>
  </schema>
</schemalist>
