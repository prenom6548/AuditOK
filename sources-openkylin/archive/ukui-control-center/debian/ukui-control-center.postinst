#!/bin/sh

set -e

glib-compile-schemas /usr/share/glib-2.0/schemas/

chmod u+s /usr/bin/changeuserpwd

# Make the secure password protocol available to desktop-launched processes.
environment_file=/etc/environment
if [ -f "$environment_file" ]; then
    if grep -q '^UKCC_SECURE_MODE_FOR_LOGINOPTION=' "$environment_file"; then
        sed -i 's/^UKCC_SECURE_MODE_FOR_LOGINOPTION=.*/UKCC_SECURE_MODE_FOR_LOGINOPTION=1/' "$environment_file"
    else
        printf '\nUKCC_SECURE_MODE_FOR_LOGINOPTION=1\n' >> "$environment_file"
    fi
else
    printf 'UKCC_SECURE_MODE_FOR_LOGINOPTION=1\n' > "$environment_file"
fi

#DEBHELPER#

if [ -x /usr/share/kylin-system-updater/kylin-reboot-required ];then
	/usr/share/kylin-system-updater/kylin-reboot-required
fi

# 启动服务
#systemctl enable ukui-group-manager.service
#systemctl start  ukui-group-manager.service

#DEBHELPER#
