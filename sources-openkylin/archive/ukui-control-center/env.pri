PROJECT_ROOTDIR = $$PWD
PROJECT_COMPONENTLIBS = $$PWD/cclibs
PLUGIN_INSTALL_DIRS    = $$[QT_INSTALL_LIBS]/ukui-control-center
PLUGIN_INSTALL_UPDATE = $$[QT_INSTALL_LIBS]/ukui-control-center/V2.0
SUB_PLUGIN_INSTALL_DIRS = $$[QT_INSTALL_LIBS]
DEFINES += SUB_PLUGIN_INSTALL_DIRS='\\"$${SUB_PLUGIN_INSTALL_DIRS}\\"'
DEFINES += SP2 BUILD_NO_SPLICE_SCREEN Nile
DEFINES += OPENKYLIN
#DEFINES += CZDZDYY
#DEFINES += CXDZDYY
