# Low-level USB device add trigger
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{ID_USB_INTERFACES}=="*:0701??:*", RUN+="/usr/share/kylin-printer/kylin-printer-applet-start usbadd_%p"
# Low-level USB device remove trigger
ACTION=="remove", SUBSYSTEM=="usb", ENV{INTERFACE}=="7/1/*", RUN+="/usr/share/kylin-printer/kylin-printer-applet-start usbremove_%p"
