[Icon Theme]
Name=ukui-icon-theme-dawnlight
Comment=Icon theme for UKUI ,from moka.
Inherits=ukui-icon-theme-default,gnome,hicolor,Adwaita

# Directory list
Directories=8x8/emblems,16x16/apps,16x16/devices,16x16/places,24x24/apps,24x24/devices,24x24/places,32x32/apps,32x32/devices,32x32/places,32x32/mimetypes,48x48/apps,48x48/devices,48x48/places,64x64/apps,64x64/devices,64x64/places,96x96/apps,96x96/devices,96x96/places,128x128/apps,128x128/categories,128x128/devices,128x128/emblems,128x128/mimetypes,128x128/places,128x128/status,256x256/apps,256x256/devices,256x256/places,scalable/apps,scalable/categories,scalable/devices,scalable/emblems,scalable/mimetypes,scalable/places,scalable/status

