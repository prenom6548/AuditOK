+    if (!m_listPriority.contains(BioT_FingerVein)) {
+        m_listPriority.push_back(BioT_FingerVein);
+    }
+    if (!m_listPriority.contains(-1)) {
+        m_listPriority.push_back(-1);  // 密码类型
