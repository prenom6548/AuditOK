+        if (ret.type() == QDBusMessage::ErrorMessage) {
+            qWarning() << ret.errorMessage();
+        } else {
+            const QDBusArgument &arg = ret.arguments().at(0).value<QDBusArgument>();
+            qDebug() << arg.currentType();
+
+            arg.beginMap();
+            while (!arg.atEnd()) {
+                QString key;
+                QVariant value;
+                arg.beginMapEntry();
+                arg >> key >> value;
+                arg.endMapEntry();
+                if (key == "CanSwitch") {
+                    nCanSwitch = value.toBool() ? 1 : 0;
+                    break;
+                }
+            }
+            arg.endMap();
+            if (nCanSwitch != -1) {
+                return (bool)(nCanSwitch);
+            }
+        }
+    }
