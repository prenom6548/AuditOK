+++ b/src/common/xdgdirs.cpp
@@ -0,0 +1,336 @@
+/* BEGIN_COMMON_COPYRIGHT_HEADER
+ * (c)LGPL2+
+ *
+ * Copyright: 2010-2011 Razor team
+ *            Copyright (C) Copyright 2021 KylinSoft Co., Ltd.
+ * Authors:
