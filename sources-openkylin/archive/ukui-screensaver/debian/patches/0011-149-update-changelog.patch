+                PhotoCorver* photoCover = item->widget()->findChild<PhotoCorver*>();
+                if (photoCover) {
+                    photoCover->setClickStatus(false);
+                }
+            }
+        }
+    }
+    if (path == DEFAULT_PHOTO_PATH) {
+        path = LOCAL_WALLPAPER_PATH;
+    }
+    m_albunWidget->setDefaultPath(path);
+}
