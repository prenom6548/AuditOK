+
+XdgDesktopFileData::XdgDesktopFileData() : mFileName()
+                                         , mIsValid(false)
+                                         , mValidIsChecked(false)
+                                         , mIsShow()
+                                         , mItems()
+                                         , mType(XdgDesktopFile::UnknownType)
+{
+}
