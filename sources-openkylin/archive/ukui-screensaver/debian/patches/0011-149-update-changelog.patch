+QList<QScreen *> effectiveScreens(const QList<QScreen *> &screens)
+{
+    if (screens.size() <= 1) {
+        return screens;
+    }
+    QList<QScreen *> filtered;
+    filtered.reserve(screens.size());
+    for (QScreen *screen : screens) {
+        if (!isPlaceholderScreen(screen)) {
+            filtered.append(screen);
+        }
+    }
+    if (filtered.isEmpty()) {
+        return screens;
+    }
+    return filtered;
+}
