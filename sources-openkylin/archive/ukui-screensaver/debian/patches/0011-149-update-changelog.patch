+/************************************************
+ This is an overloaded function.
+ ************************************************/
+bool XdgDesktopFile::startDetached(const QString& url) const
+{
+    if (url.isEmpty()) {
+        return startDetached(QStringList());
+    } else {
+        return startDetached(QStringList(url));
+    }
+}
