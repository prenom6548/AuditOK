+{
+    Q_OBJECT
+public:
+    explicit AdaptiveLabel(QWidget *parent = nullptr);
+
+    void setPixmap(const QPixmap &pixmap);
+
+    void setScale(float scale);
+
+protected:
+    void paintEvent(QPaintEvent *event) override;
+
