+{
+    initData();
+    if (type == "ukui") {
+        m_upperInterface->getGSettingsInstance()->SetLockScreenConf(KEY_MODE, "default-ukui");
+    } else if (type == "custom") {
+        m_upperInterface->getGSettingsInstance()->SetLockScreenConf(KEY_MODE, "default-ukui-custom");
+    }
+    Q_EMIT changed("screensaverType");
+}
+
