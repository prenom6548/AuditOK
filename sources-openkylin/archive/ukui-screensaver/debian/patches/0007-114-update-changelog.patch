+	//------------------------------------------------------------------------------
+	static void
+	note( std::ostream& out, int no, Elf_Word type, const std::string& name )
+	{
+		out << "  [" << DUMP_DEC_FORMAT( 2 ) << no << "] "
+			<< DUMP_HEX_FORMAT( 8 ) << type << " " << DUMP_STR_FORMAT( 1 )
+			<< name << std::endl;
