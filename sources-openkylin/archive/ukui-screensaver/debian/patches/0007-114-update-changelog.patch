+		convertor.setup( e_ident[EI_DATA] );
+		header = create_header( e_ident[EI_CLASS], e_ident[EI_DATA] );
+		if ( 0 == header ) {
+			return false;
+		}
+		if ( !header->load( stream ) ) {
+			return false;
+		}
