+
+    QByteArray publicKey;
+
+    rsac.generateKeyPair(privateKey, publicKey, 1024);
+
+
+
+    // 检查生成的密钥是否非空
+
+    EXPECT_FALSE(privateKey.isEmpty());
+
+    EXPECT_FALSE(publicKey.isEmpty());
+
+
+
+    // 这里可以添加额外的检查来验证密钥的有效性
+
+    // 例如，使用OpenSSL函数解析生成的密钥并检查其属性
