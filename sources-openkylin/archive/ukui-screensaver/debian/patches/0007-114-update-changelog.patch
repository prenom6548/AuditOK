+				<< " " << DUMP_HEX_FORMAT( 8 ) << seg->get_physical_address()
+				<< " " << DUMP_HEX_FORMAT( 8 ) << seg->get_file_size() << " "
+				<< DUMP_HEX_FORMAT( 8 ) << seg->get_memory_size() << " "
+				<< DUMP_STR_FORMAT( 8 ) << str_segment_flag( seg->get_flags() )
