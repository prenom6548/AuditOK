+				<< " " << DUMP_HEX_FORMAT( 16 ) << seg->get_virtual_address()
+				<< " " << DUMP_HEX_FORMAT( 16 ) << seg->get_physical_address()
+				<< " " << DUMP_STR_FORMAT( 16 )
+				<< str_segment_flag( seg->get_flags() ) << " " << std::endl
+				<< "                       " << DUMP_HEX_FORMAT( 16 )
