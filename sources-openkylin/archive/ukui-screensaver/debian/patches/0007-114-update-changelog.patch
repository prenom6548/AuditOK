+        Q_EMIT onlineButtonClicked();
+    });
+    connect(m_resetBtn, &QPushButton::clicked, this, [=](){
+        Q_EMIT resetButtonClicked();
+    });
+#ifdef Nile
+    QDBusConnection::sessionBus().connect("com.ukui.bluetooth",
