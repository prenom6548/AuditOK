+++ b/src/ukccplugins/screenlock/pictureunit.cpp
@@ -0,0 +1,124 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*-
+ *
+ * Copyright (C) 2019 KylinSoft  Co., Ltd.
+ *
