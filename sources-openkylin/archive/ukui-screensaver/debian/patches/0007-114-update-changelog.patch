index 0000000..04e746e
--- /dev/null
+++ b/tests/kt-test-utils/cpp-stub-ext/stub-shadow.h
@@ -0,0 +1,171 @@
+
+#ifndef STUBSHADOW_H
+#define STUBSHADOW_H
+/*
+ * Author:     Zhang Yu <clauszy@163.com>
+ * Maintainer: Zhang Yu <clauszy@163.com>
+ *
+ * MIT License
+ *
