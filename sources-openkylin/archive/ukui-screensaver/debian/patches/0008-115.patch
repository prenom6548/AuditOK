+void MMediaPlaylist::playError()
+{
+    //å½“å‰ä»…åœ¨å­˜åœ¨æ’­æ”¾åˆ—è¡¨ä¸­çš„åª’ä½“æœ¬åœ°æ–‡ä»¶è¢«åˆ é™¤æ—¶è§¦å‘
+    //æ’­æ”¾å¼‚å¸¸æ—¶ï¼Œè½®è¯¢æ‰€æœ‰åˆ—è¡¨ä¸­çš„åª’ä½“æ–‡ä»¶æ˜¯å¦å­˜åœ¨
+    for (auto url : m_playerList) {
+        //å¦‚æœå‘ç°åˆ—è¡¨ä¸­æœ‰åª’ä½“æ–‡ä»¶æ²¡è¢«åˆ é™¤
+        if (QFileInfo::exists(url.toLocalFile())) {
+            //å¦‚æœæ˜¯å•æ›²å¾ªç¯åˆ™åˆ‡æ¢ä¸‹ä¸€é¦–
+            if (m_playbackMode == CurrentItemInLoop) {
+                next();
+            }
+            //æŒ‰æ’­æ”¾å®Œæˆå¤„ç†
+            palyFinish();
+            return;
+        }
+    }
+    //åˆ—è¡¨ä¸­æ‰€æœ‰åª’ä½“çš„æœ¬åœ°æ–‡ä»¶å…¨éƒ¨è¢«åˆ é™¤äº†
+    Q_EMIT currentIndexChanged(-1);
