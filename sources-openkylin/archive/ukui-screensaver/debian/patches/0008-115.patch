+    if (lenPlaylist == 0) {
+        // æ’­æ”¾åˆ—è¡¨æ²’æœ‰æ­Œæ›²ï¼Œæ­¤æ—¶ä¸åº”æœ‰å¯ç”¨å€¼
+        return -1;
