+void MPRISSaverWidget::onBtnPreview()
+{
+    m_labelBopian->startRotationAnimation();
+    if (m_bSaverMedia) {
+        playController::getInstance().previousSong();
+        return ;
+    }
+    if (!m_mprisDbusClient) {
+        return;
+    }
+    m_mprisDbusClient->Previous();
