+        return DB_OP_SUCC;//ä½ç½®æ²¡å˜åŒ–ï¼Œä¸ç”¨å¤„ç†
+    }
+
+    //è·å–æ­Œæ›²çš„indexä¿¡æ¯
+    int oldIndex = 0, newIndex = 0;
