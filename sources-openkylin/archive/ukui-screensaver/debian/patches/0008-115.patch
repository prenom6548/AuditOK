+                return DB_OP_ADD_REPEAT;
+            }
+
+            QSqlQuery addSongToLocal(m_database);
+            QString addSongString = QString("insert into %1 (%2) values('%3','%4','%5','%6','%7','%8','%9')").
+                    arg(ALLMUSIC).
+                    arg(SHOWCONTEXTS).
+                    arg(inPutStringHandle(fileData.filepath)).
