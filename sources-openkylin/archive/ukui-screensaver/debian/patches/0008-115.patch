+            return checkListRes;
+        }
+    }
+    else
+    {
+        int checkLocalRes = checkIfSongExistsInLocalMusic(fileData.filepath);
+        if(checkLocalRes == SONG_NOT_FOUND)
+        {
+            int addLocalRes;
+            addLocalRes = addMusicToLocalMusic(fileData);
