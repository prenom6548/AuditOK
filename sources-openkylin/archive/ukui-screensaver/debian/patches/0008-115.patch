+
+void MMediaPlaylist::palyFinish()
+{
+    //å¦‚æœæ²¡æœ‰å¾…æ’­æ”¾çš„åª’ä½“åˆ™ä¸å¤„ç†
+    if (m_index < 0) {
+        return;
+    }
+
+    //å¦‚æœå¾ªç¯æ¨¡å¼ä¸æ˜¯å•æ›²å¾ªç¯åˆ™åˆ‡æ¢ä¸‹ä¸€é¦–
+    if (m_playbackMode != CurrentItemInLoop) {
