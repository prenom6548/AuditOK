+        mpv_event *event = mpv_wait_event(m_mpvPlayer, 0);
+        if (event->event_id == MPV_EVENT_NONE) {
+            break;
+        }
+        handle_mpv_event(event);
+    }
+}
+
+void MMediaPlayer::handle_mpv_event(mpv_event *event)
+{
+    switch (event->event_id) {
+        case MPV_EVENT_PROPERTY_CHANGE: { //å±æ€§æ”¹å˜äº‹ä»¶
+            mpv_event_property *prop = (mpv_event_property *)event->data;
+            //æ’­æ”¾æ—¶ï¼Œæ—¶é—´æ”¹å˜äº‹ä»¶
+            if (strcmp(prop->name, "time-pos") == 0) {
+                if (prop->format == MPV_FORMAT_DOUBLE) {
+                    //å°†æ’­æ”¾çŠ¶æ€è®¾ç½®ä¸ºæ’­æ”¾ä¸­
+                    if (m_state == StoppedState) {
+                        changeState(PlayingState);
+                    }
+                    // è·å¾—æ’­æ”¾æ—¶é—´
+                    double time = *(double *)prop->data;
+                    //å°†å•ä½æ¢ç®—ä¸ºæ¯«ç§’
+                    m_position = time * 1000;
+                    Q_EMIT positionChanged(m_position);
+                } else if (prop->format == MPV_FORMAT_NONE) {
+                    //å½“å‰æ—¶é•¿è·ç¦»æ€»æ—¶é•¿ä¸è¶…è¿‡500æ¯«ç§’åˆ¤æ–­æ’­æ”¾ç»“æŸ
+                    if ( m_duration!=0 && (m_duration - m_position < 500)) {
+                        m_duration = 0;
+                        m_position = 0;
+                        //æ’­æ”¾ç»“æŸ
+                        Q_EMIT playFinish();
+                    } else {
+                        //åˆ‡æ­Œ
+                        changeState(StoppedState);
+                    }
+                }
+            }
+        }
+        break;
+    case MPV_EVENT_PLAYBACK_RESTART:{ //åˆå§‹åŒ–å®Œæˆäº‹ä»¶
+        //è·å–æ€»æ—¶é•¿
+        m_duration = getProperty("duration").toDouble() *1000;//å•ä½æ¢ç®—ä¸ºæ¯«ç§’
+        Q_EMIT durationChanged(m_duration);
+    }
+        break;
+    case MPV_EVENT_IDLE:{ //æ’­æ”¾å™¨ç©ºé—²äº‹ä»¶ï¼Œåªæœ‰åˆšå¯åŠ¨æ—¶ã€æ’­æ”¾å®Œæˆæ—¶ã€æ­Œæ›²å¼‚å¸¸æ—¶ä¼šè¿›å…¥æ­¤åˆ†æ”¯
+        QString playlist = getProperty("playlist");
+        if (!playlist.contains(',')) { //æ’é™¤æ’­æ”¾å®Œæˆ
+            if (playlist.length() > 2) { //æ’é™¤åˆšå¯åŠ¨
+                //æ­Œæ›²æ’­æ”¾å¼‚å¸¸
+                Q_EMIT playErrorMsg(Damage);
+            }
+        }
+    }
+        break;
+        //MPVä¼šæ¦‚ç‡é”™è¯¯çš„å‘é€æ­¤ä¿¡å·ï¼Œå¯¼è‡´æ²¡æ’­æ”¾å®Œä¹Ÿè·³è½¬åˆ°ä¸‹ä¸€é¦–
+//    case MPV_EVENT_END_FILE:{ //æ’­æ”¾ç»“æŸäº‹ä»¶
+//        if (m_position != 0) {
+//            //é‡ç½®å‚æ•°
+//            m_duration = 0;
+//            m_position = 0;
+//            //æ’­æ”¾ç»“æŸ
+//            Q_EMIT playFinish();
+//        }
+//    }
+//        break;
+        default: ;
+    }
+}
+
+// å›è°ƒå‡½æ•°
+static void wakeup(void *ctx)
+{
+    // æ­¤å›è°ƒå¯ä»ä»»ä½•mpvçº¿ç¨‹è°ƒç”¨ï¼ˆä½†ä¹Ÿå¯ä»¥ä»è°ƒç”¨mpv APIçš„çº¿ç¨‹é€’å½’åœ°è¿”å›ï¼‰
+    // åªæ˜¯éœ€è¦é€šçŸ¥è¦å”¤é†’çš„Qt GUIçº¿ç¨‹ï¼ˆä»¥ä¾¿å®ƒå¯ä»¥ä½¿ç”¨mpv_wait_eventï¼ˆï¼‰ï¼‰ï¼Œå¹¶å°½å¿«è¿”å›
+    MMediaPlayer *mvpPlayer = (MMediaPlayer *)ctx;
+    Q_EMIT mvpPlayer->mpvEvents();
+}
+
+void MMediaPlayer::createMvpplayer()
+{
+    // åˆ›å»ºmpvå®ä¾‹
+    setlocale(LC_NUMERIC,"C");
+    m_mpvPlayer = mpv_create();
+    if (m_mpvPlayer == nullptr) {
+        qDebug()<<"åˆ›å»ºæ’­æ”¾æ¨¡å—å¤±è´¥ï¼";
+        this->deleteLater();
+        return;
+    }
+    //ç¦ç”¨è§†é¢‘æµ
+    setProperty("vid", "no");
+    //æ¥æ”¶äº‹ä»¶
+    connect(this, &MMediaPlayer::mpvEvents, this, &MMediaPlayer::onMpvEvents, Qt::QueuedConnection);
+    mpv_set_wakeup_callback(m_mpvPlayer, wakeup, this);
+    //ç»‘å®šäº‹ä»¶
+    mpv_observe_property(m_mpvPlayer, 0, "time-pos", MPV_FORMAT_DOUBLE);
+    // åˆ¤æ–­mpvå®ä¾‹æ˜¯å¦æˆåŠŸåˆå§‹åŒ–
+    if (mpv_initialize(m_mpvPlayer) < 0) {
+        qDebug()<<"åˆå§‹åŒ–å¤±è´¥ï¼";
+        this->deleteLater();
+    }
+}
+
+void MMediaPlayer::setProperty(const QString &name, const QString &value)
+{
+    mpv_set_option_string(m_mpvPlayer, name.toLatin1().data(), value.toLatin1().data());
+}
+
+QString MMediaPlayer::getProperty(const QString &name) const
+{
+    return (QString)mpv_get_property_string(m_mpvPlayer, name.toLatin1().data());
+}
+
+void MMediaPlayer::changeState(MMediaPlayer::State stateNow)
+{
+    //å¾…è®¾ç½®çš„å¾ªç¯æ¨¡å¼å’Œè®¾ç½®ä¹‹å‰ä¸€è‡´åˆ™ä¸å¤„ç†
+    if (m_state == stateNow ) {
+        return;
+    }
+    m_state = stateNow;
+
+    Q_EMIT stateChanged(m_state);
+}
+
+void MMediaPlayer::autoPlay(MMediaPlaylist::PlaybackMode playbackMode)
+{
+    //å¦‚æœæ˜¯å•æ›²å¾ªç¯æ¨¡å¼
+    if (playbackMode == MMediaPlaylist::PlaybackMode::CurrentItemInLoop) {
+        //æ’­æ”¾å®Œæ¯•è‡ªåŠ¨åˆ‡æ­Œï¼ˆå€Ÿç”¨æ’­æ”¾ç‚¹æ”¹å˜æ—¶é—´é€»è¾‘å¾ªç¯ï¼‰
+        m_positionChangeed = true;
+    }
+    truePlay("0");
+}
