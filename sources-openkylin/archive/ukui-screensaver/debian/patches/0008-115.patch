+// customalbumviewer.h
+#ifndef CUSTOMALBUMVIEWER_H
+#define CUSTOMALBUMVIEWER_H
+
+#include <QWidget>
+#include <QTimer>
+#include <QDir>
+#include <QLabel>
+#include <QVBoxLayout>
+#include <QHBoxLayout>
+
+class CustomAlbumViewer : public QWidget
+{
+    Q_OBJECT
+
+public:
+    CustomAlbumViewer(QWidget *parent = nullptr);
+    ~CustomAlbumViewer();
+
+    void loadImages(const QStringList &directoryPaths);
