+
+void MMediaPlaylist::playErrorMsg(int Damage)
+{
+    if (Damage == -2) {
+        if (mediaCount() == 0) {
+               return;
+        }
+        if (m_playerList.isEmpty()) {
+               return;
+           }
+        if (m_index < 0) {
+               return;
+           }
+        if (m_index >= m_playerList.length()) {
+               m_index = 0;
+           }
+    }
