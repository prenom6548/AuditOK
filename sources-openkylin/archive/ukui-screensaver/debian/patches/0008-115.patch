+        return qvariant_cast<double>(property("Rate"));
+    }
+    inline void setRate(double value)
+    {
+        setProperty("Rate", QVariant::fromValue(value));
+    }
+
+    Q_PROPERTY(bool Shuffle READ shuffle WRITE setShuffle NOTIFY ShuffleChanged)
