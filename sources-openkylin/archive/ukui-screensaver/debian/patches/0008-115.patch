+void MMediaPlaylist::next()
+{
+    //å¼‚å¸¸æƒ…å†µï¼šæ’­æ”¾åˆ—è¡¨ä¸ºç©º
+    if (m_playerList.isEmpty()) {
+        return;
+    }
+    //å¼‚å¸¸æƒ…å†µï¼šæ— å½“å‰æ’­æ”¾åª’ä½“
+    if (m_index < 0) {
+        return;
+    }
+    switch (m_playbackMode) {
+    case Random:
+        m_index=randomIndex();
+        //å¼‚å¸¸æƒ…å†µï¼šæ— å½“å‰æ’­æ”¾åª’ä½“
+        if (m_index < 0) {
+            return;
+        }
+
+        break;
+    case Sequential:
+        m_index++;
+        if (m_index >= m_playerList.length()) {
+           m_index = m_playerList.length() - 1;
+        }
+        break;
+    default:
+        m_index++;
+        if (m_index >= m_playerList.length()) {
