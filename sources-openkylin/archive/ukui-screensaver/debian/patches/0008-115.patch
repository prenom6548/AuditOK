+                {
+                    int tempIndex           = getBetweenSongIndexFromLocal.value(0).toInt();
+                    QString tempFilepath    = outPutStringHandle(getBetweenSongIndexFromLocal.value(1).toString());
+
+                    QSqlQuery updateSongIndexFromLocal(m_database);
