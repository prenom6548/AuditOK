<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
    <interface name="com.kylin.AiRuntime.GenAiNlpService">
        <method name="init">
            <arg name="sessionId" type="i" direction="out" />
            <arg name="errorCode" type="i" direction="out" />
            <arg name="config" type="s" direction="in" />
        </method>
        <method name="destroy">
            <arg name="sessionId" type="i" direction="in" />
        </method>
        <method name="chat">
            <arg name="sessionId" type="i" direction="in" />
            <arg name="question" type="s" direction="in" />
        </method>
        <method name="clearChatMessage">
            <arg name="sessionId" type="i" direction="in" />
        </method>
        <method name="stopChat">
            <arg name="sessionId" type="i" direction="in" />
        </method>
        <method name="addSystemMessage">
            <arg name="sessionId" type="i" direction="in" />
            <arg name="message" type="s" direction="in" />
        </method>
        <method name="setChatSystemPromptId">
            <arg name="sessionId" type="i" direction="in" />
            <arg name="promptId" type="i" direction="in" />
        </method>
        <method name="chatWithHistoryMessages">
            <arg name="sessionId" type="i" direction="in" />
            <arg name="messages" type="s" direction="in" />
        </method>
    </interface>
</node>
