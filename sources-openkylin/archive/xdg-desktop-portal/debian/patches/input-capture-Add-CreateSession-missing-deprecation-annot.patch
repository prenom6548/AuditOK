From: tytan652 <tytan652@tytanium.xyz>
Date: Sat, 11 Apr 2026 17:56:05 +0200
Subject: input-capture: Add CreateSession missing deprecation annotation

Origin: https://github.com/flatpak/xdg-desktop-portal/pull/1967
---
 data/org.freedesktop.portal.InputCapture.xml | 1 +
 src/input-capture.c                          | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/data/org.freedesktop.portal.InputCapture.xml b/data/org.freedesktop.portal.InputCapture.xml
index 8b65e30..28a8b39 100644
--- a/data/org.freedesktop.portal.InputCapture.xml
+++ b/data/org.freedesktop.portal.InputCapture.xml
@@ -111,6 +111,7 @@
           this application may not capture events of that capability.
     -->
     <method name="CreateSession">
+      <annotation name="org.freedesktop.DBus.Deprecated" value="true"/>
       <arg type="s" name="parent_window" direction="in"/>
       <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
       <arg type="a{sv}" name="options" direction="in"/>
diff --git a/src/input-capture.c b/src/input-capture.c
index e400e08..6ecc6e6 100644
--- a/src/input-capture.c
+++ b/src/input-capture.c
@@ -355,7 +355,9 @@ handle_create_session (XdpDbusInputCapture   *object,
                                               g_object_ref (request));
     }
 
+  G_GNUC_BEGIN_IGNORE_DEPRECATIONS
   xdp_dbus_input_capture_complete_create_session (object, invocation, request->id);
+  G_GNUC_END_IGNORE_DEPRECATIONS
 
   return G_DBUS_METHOD_INVOCATION_HANDLED;
 }
