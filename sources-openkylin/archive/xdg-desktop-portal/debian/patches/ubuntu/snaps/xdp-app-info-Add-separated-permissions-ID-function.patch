+const char * xdp_app_info_get_permissions_id (XdpAppInfo *app_info);
+
 const char * xdp_app_info_get_instance (XdpAppInfo *app_info);
 
 const char * xdp_app_info_get_engine (XdpAppInfo *app_info);
