Subject: xdp-utils: Avoid complex checks on snap permission IDs

Origin: https://github.com/flatpak/xdg-desktop-portal/pull/1764
---
 src/xdp-utils.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/xdp-utils.c b/src/xdp-utils.c
index 59c17c6..482bcb5 100644
--- a/src/xdp-utils.c
+++ b/src/xdp-utils.c
@@ -513,6 +513,9 @@ xdp_is_valid_app_id (const char *string)
 gboolean
 xdp_is_valid_permissions_id (const char *string)
 {
+  if (g_str_has_prefix (string, "snap."))
+    return TRUE;
+
   return xdp_is_valid_app_id (string);
 }
 
