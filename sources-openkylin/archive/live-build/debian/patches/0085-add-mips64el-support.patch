From: =?utf-8?b?6LCi54Kc?= <xiewei@kylinos.cn>
Date: Wed, 27 May 2020 08:57:19 +0800
Subject: add mips64el support

---
 functions/defaults.sh             |  4 ++++
 scripts/build/lb_binary_grub2-efi | 22 +++++++++++++++++++---
 2 files changed, 23 insertions(+), 3 deletions(-)
 mode change 100644 => 100755 scripts/build/lb_binary_grub2-efi

diff --git a/functions/defaults.sh b/functions/defaults.sh
index 713190b..c026c5e 100755
--- a/functions/defaults.sh
+++ b/functions/defaults.sh
@@ -696,6 +696,10 @@ Set_defaults ()
 			# Assume we'll have a generic kernel for arm64 some day:
 			LB_LINUX_FLAVOURS="${LB_LINUX_FLAVOURS:-generic}"
 			;;
+		mips64el)
+			# Assume we'll have a generic kernel for mips64el some day:
+			LB_LINUX_FLAVOURS="${LB_LINUX_FLAVOURS:-generic}"
+			;;
 		armel)
 			case "${LB_MODE}" in
                                 ubuntu|kubuntu)
diff --git a/scripts/build/lb_binary_grub2-efi b/scripts/build/lb_binary_grub2-efi
old mode 100644
new mode 100755
index 4fbaf6a..5b410b3
--- a/scripts/build/lb_binary_grub2-efi
+++ b/scripts/build/lb_binary_grub2-efi
@@ -41,7 +41,7 @@ Check_lockfile .lock
 Create_lockfile .lock
 
 # Check architecture
-Check_architectures amd64 arm64
+Check_architectures amd64 arm64 mips64el
 Check_crossarchitectures
 
 # Checking depends
@@ -54,8 +54,12 @@ case ${ARCHITECTURE} in
                 Check_package chroot/usr/bin/grub-mkimage grub-efi-arm64
 		Check_package chroot/sbin/mkfs.vfat dosfstools
                 ;;
+        'mips64el')
+                Check_package chroot/usr/bin/grub-mkimage grub-efi-mips64el
+		Check_package chroot/sbin/mkfs.vfat dosfstools
+                ;;
         *)
-                Echo_message "not amd64 or arm64, grub2-efi exit"
+                Echo_message "not amd64 or arm64 or mips64el, grub2-efi exit"
                 exit 0
                 ;;
 esac
@@ -68,7 +72,7 @@ Install_package
 
 case ${LB_BINARY_IMAGES} in
         iso*)
-		if [ ! -d chroot/usr/lib/grub/x86_64-efi ] && [ ! -d chroot/usr/lib/grub/arm64-efi ];then
+		if [ ! -d chroot/usr/lib/grub/x86_64-efi ] && [ ! -d chroot/usr/lib/grub/arm64-efi ] && [ ! -d chroot/usr/lib/grub/mips64el-efi ];then
                         exit 0
 		fi
                 ;;
@@ -199,6 +203,10 @@ case ${ARCHITECTURE} in
 		Grub_live_entry "Try ${ORIGIN} without installing" "/casper/Image" "/casper/initrd.img" "boot=casper rootwait ro locale=zh_CN KEYBOARDTYPE=pc KEYTABLE=us ignore_uuid quiet splash"
 		Grub_live_entry "Install ${ORIGIN}" "/casper/Image" "/casper/initrd.img" "boot=casper only-ubiquity rootwait ro locale=zh_CN KEYBOARDTYPE=pc KEYTABLE=us ignore_uuid quiet splash"
 		;;
+	'mips64el')
+		Grub_live_entry "Try ${ORIGIN} without installing" "/casper/vmlinuz" "/casper/initrd.img" "console=tty1 boot=casper quiet splash loglevel=0 audit=0"
+		Grub_live_entry "Install ${ORIGIN}" "/casper/vmlinuz" "/casper/initrd.img" "console=tty1 boot=casper quiet splash loglevel=0 only-ubiquity audit=0"
+		;;
 esac
 
 LINUX_LIVE="$(/bin/echo ${LINUX_LIVE} | sed -e 's|binary||g' -e 's|//|/|g')"
@@ -275,6 +283,9 @@ case ${LB_BINARY_IMAGES} in
                         'arm64')
                                 FILES="chroot/usr/lib/grub/arm64-efi chroot/usr/share/grub/*.pf2"
                                 ;;
+			'mips64el')
+				FILES="chroot/usr/lib/grub/mips64el-efi chroot/usr/share/grub/*.pf2"
+				;;
                 esac
                 ;;
 esac
@@ -311,6 +322,11 @@ elif  [ -d chroot/usr/lib/grub/arm64-efi ];then
     KY_EFI_NAME="arm64-efi"
     KY_BOOT_EFI_NAME="BOOTAA64.EFI"
     KY_GRUB_EFI_NAME="grubaa64.efi"
+elif  [ -d chroot/usr/lib/grub/mips64el-efi ];then
+    KY_EFI="/usr/lib/grub/mips64el-efi"
+    KY_EFI_NAME="mips64el-efi"
+    KY_BOOT_EFI_NAME="BOOTMIPS.EFI"
+    KY_GRUB_EFI_NAME="grubmips64.efi"
 fi
 
 mkdir -p binary/boot/grub
