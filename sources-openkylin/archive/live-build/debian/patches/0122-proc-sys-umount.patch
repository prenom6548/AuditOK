---
 scripts/build/lb_binary_chroot | 4 ++--
 scripts/build/lb_chroot_proc   | 4 ++--
 scripts/build/lb_chroot_sysfs  | 2 +-
 3 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/scripts/build/lb_binary_chroot b/scripts/build/lb_binary_chroot
index a39691c..8453987 100755
--- a/scripts/build/lb_binary_chroot
+++ b/scripts/build/lb_binary_chroot
@@ -43,7 +43,7 @@ if [ -f chroot/proc/version ]
 then
 	if [ "${LB_USE_FAKEROOT}" != "true" ]
 	then
-		${LB_ROOT_COMMAND} umount chroot/proc
+		${LB_ROOT_COMMAND} umount -l chroot/proc
 	else
 		rm -rf chroot/proc
 		mkdir -p chroot/proc
@@ -54,7 +54,7 @@ if [ -d chroot/sys/kernel ]
 then
 	if [ "${LB_USE_FAKEROOT}" != "true" ]
 	then
-		${LB_ROOT_COMMAND} umount chroot/sys
+		${LB_ROOT_COMMAND} umount -l chroot/sys
 	else
 		rm -rf chroot/sys
 		mkdir -p chroot/sys
diff --git a/scripts/build/lb_chroot_proc b/scripts/build/lb_chroot_proc
index 4ceb088..bb9b7aa 100755
--- a/scripts/build/lb_chroot_proc
+++ b/scripts/build/lb_chroot_proc
@@ -49,7 +49,7 @@ case "${1}" in
 			mkdir -p chroot/proc
 
 			# Mounting /proc
-			${LB_ROOT_COMMAND} mount proc-live -t proc chroot/proc
+			${LB_ROOT_COMMAND} mount -t proc /proc chroot/proc
 		else
 			rm -rf chroot/proc
 			ln -s /proc chroot/
@@ -80,7 +80,7 @@ case "${1}" in
 			#fuser -km chroot/proc
 			if [ -e chroot/proc/version ]
 			then
-				${LB_ROOT_COMMAND} umount chroot/proc
+				${LB_ROOT_COMMAND} umount -l chroot/proc
 			fi
 		else
 			rm -rf chroot/proc
diff --git a/scripts/build/lb_chroot_sysfs b/scripts/build/lb_chroot_sysfs
index 048f1aa..6af1c79 100755
--- a/scripts/build/lb_chroot_sysfs
+++ b/scripts/build/lb_chroot_sysfs
@@ -74,7 +74,7 @@ case "${1}" in
 			#fuser -km chroot/sys
 			if [ -e chroot/sys/class ]
 			then
-				${LB_ROOT_COMMAND} umount chroot/sys
+				${LB_ROOT_COMMAND} umount -l chroot/sys
 			fi
 		else
 			rm -rf chroot/sys
