-		ubuntu)
+		ubuntu|kylin|openkylin)
 			LB_FIRMWARE_CHROOT="${LB_FIRMWARE_CHROOT:-false}"
 			LB_FIRMWARE_BINARY="${LB_FIRMWARE_BINARY:-false}"
 			;;
