From: Xie Wei <xiewei@kylinos.cn>
Date: Thu, 5 Jun 2025 19:07:46 +0800
Subject: =?utf-8?b?5pSv5oyB55Sf5oiQ5YyF5ZCr5aSn5LqONEfmlofku7bnmoRpc28=?=

---
 scripts/build/lb_binary_iso | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/scripts/build/lb_binary_iso b/scripts/build/lb_binary_iso
index 05a263f..0c3fba1 100755
--- a/scripts/build/lb_binary_iso
+++ b/scripts/build/lb_binary_iso
@@ -86,7 +86,7 @@ then
 fi
 
 # Handle genisoimage generic options
-GENISOIMAGE_OPTIONS="-J -r -T -joliet-long -allow-leading-dots -l"
+GENISOIMAGE_OPTIONS="-J -r -T -joliet-long -allow-leading-dots -l -input-charset UTF-8"
 XORRISO_OPTIONS=""
 
 # Handle genisoimage live-build specific options
@@ -189,6 +189,12 @@ then
 	XORRISO_OPTIONS="${XORRISO_OPTIONS} -append_partition 2 0xef binary/boot/grub/efi.img -partition_cyl_align all"
 fi
 
+# check if has file which large than 4GB.
+if [ $(find binary -size +4096M | wc -l) -gt 0 ]
+then
+	GENISOIMAGE_OPTIONS="${GENISOIMAGE_OPTIONS} -allow-limited-size -iso-level 3"
+fi
+
 if [ "${ARCHITECTURE}" = "amd64" ]
 then
 	XORRISO_OPTIONS="${XORRISO_OPTIONS} -isohybrid-gpt-basdat -isohybrid-apm-hfsplus"
@@ -230,11 +236,15 @@ if [ "${LB_BINARY_IMAGES}" = "iso-xorr" ]
 then
 cat >> binary.sh << EOF
 
+echo "xorriso -as genisoimage ${GENISOIMAGE_OPTIONS} -o ${IMAGE} binary ${XORRISO_OPTIONS}" > binary/.disk/genisoimage_params.txt
+
 xorriso -as genisoimage ${GENISOIMAGE_OPTIONS} -o ${IMAGE} binary ${XORRISO_OPTIONS}
 EOF
 else
 cat >> binary.sh << EOF
 
+echo "genisoimage ${GENISOIMAGE_OPTIONS} ${GENISOIMAGE_OPTIONS_EXTRA} -o ${IMAGE} binary" > binary/.disk/genisoimage_params.txt
+
 genisoimage ${GENISOIMAGE_OPTIONS} ${GENISOIMAGE_OPTIONS_EXTRA} -o ${IMAGE} binary
 EOF
 fi
