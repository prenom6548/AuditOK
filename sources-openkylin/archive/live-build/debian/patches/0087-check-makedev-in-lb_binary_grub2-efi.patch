From: =?utf-8?b?6LCi54Kc?= <xiewei@kylinos.cn>
Date: Wed, 27 May 2020 09:38:06 +0800
Subject: check makedev in lb_binary_grub2-efi

---
 scripts/build/lb_binary_grub2-efi | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/scripts/build/lb_binary_grub2-efi b/scripts/build/lb_binary_grub2-efi
index 5b410b3..af653ed 100755
--- a/scripts/build/lb_binary_grub2-efi
+++ b/scripts/build/lb_binary_grub2-efi
@@ -49,14 +49,17 @@ case ${ARCHITECTURE} in
         'amd64')
                 Check_package chroot/usr/bin/grub-mkimage grub-efi-amd64
 		Check_package chroot/sbin/mkfs.vfat dosfstools
+		Check_package chroot/sbin/MAKEDEV makedev
                 ;;
         'arm64')
                 Check_package chroot/usr/bin/grub-mkimage grub-efi-arm64
 		Check_package chroot/sbin/mkfs.vfat dosfstools
+		Check_package chroot/sbin/MAKEDEV makedev
                 ;;
         'mips64el')
                 Check_package chroot/usr/bin/grub-mkimage grub-efi-mips64el
 		Check_package chroot/sbin/mkfs.vfat dosfstools
+		Check_package chroot/sbin/MAKEDEV makedev
                 ;;
         *)
                 Echo_message "not amd64 or arm64 or mips64el, grub2-efi exit"
