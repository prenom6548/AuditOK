---
 scripts/build/lb_ostree_commit | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/scripts/build/lb_ostree_commit b/scripts/build/lb_ostree_commit
index 8cfa75e..baa8c1d 100755
--- a/scripts/build/lb_ostree_commit
+++ b/scripts/build/lb_ostree_commit
@@ -44,6 +44,11 @@ if [ ! -f chroot/chroot/etc/ostree-release ]; then
 	exit 0
 fi
 
+if [ "${LB_MODE}" = "openkylin" ]; then
+	Echo_message "openkylin版本不生成不可变系统分支"
+	exit 0
+fi
+
 ostree_file_path="/usr/bin/ostree" # 将路径更改为要检查的文件路径
 if [ -f "$ostree_file_path" ] && [ -x "$ostree_file_path" ]; then
     Echo_message "ostree 命令存在"
@@ -159,7 +164,11 @@ ostree summary --repo=./repo -u
 
 #echo "---------->>>>>>>>>000000 8"
 
-ostree-push --repo=./repo $LB_OSTREE_USER_NAME@$LB_OSTREE_IP:$LB_OSTREE_WARE_ADDRESS/$os_version_name $ostree_branch_name
+if [ -f config/ostree ]; then
+	ostree-push --repo=./chroot/repo $LB_OSTREE_USER_NAME@$LB_OSTREE_IP:$LB_OSTREE_WARE_ADDRESS/$os_version_name $ostree_push_branch_name
+else
+	Echo_message "config/ostree文件不存在，跳过ostree-push"	
+fi
 
 mv ./usr_etc_file/* chroot/chroot/usr/etc/
 rm -r usr_etc_file
