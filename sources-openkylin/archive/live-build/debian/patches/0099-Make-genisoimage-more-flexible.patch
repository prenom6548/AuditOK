From: =?utf-8?b?6LCi54Kc?= <xiewei@kylinos.cn>
Date: Tue, 25 Jan 2022 14:18:16 +0800
Subject: Make genisoimage more flexible

---
 scripts/build/lb_binary_iso | 2 +-
 scripts/build/lb_config     | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/scripts/build/lb_binary_iso b/scripts/build/lb_binary_iso
index 2d3436e..f552399 100755
--- a/scripts/build/lb_binary_iso
+++ b/scripts/build/lb_binary_iso
@@ -234,7 +234,7 @@ EOF
 else
 cat >> binary.sh << EOF
 
-genisoimage ${GENISOIMAGE_OPTIONS} -o ${IMAGE} binary
+genisoimage ${GENISOIMAGE_OPTIONS} ${GENISOIMAGE_OPTIONS_EXTRA} -o ${IMAGE} binary
 EOF
 fi
 
diff --git a/scripts/build/lb_config b/scripts/build/lb_config
index 857e2cc..65f714f 100755
--- a/scripts/build/lb_config
+++ b/scripts/build/lb_config
@@ -1113,6 +1113,7 @@ APT_OPTIONS="${APT_OPTIONS}"
 APTITUDE_OPTIONS="${APTITUDE_OPTIONS}"
 GZIP_OPTIONS="${GZIP_OPTIONS}"
 ISOHYBRID_OPTIONS="${ISOHYBRID_OPTIONS}"
+GENISOIMAGE_OPTIONS_EXTRA="${GENISOIMAGE_OPTIONS_EXTRA}"
 EOF
 
 # Creating lb_bootstrap_* configuration
