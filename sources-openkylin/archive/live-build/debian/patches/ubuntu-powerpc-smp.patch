From: Adam Conrad <adconrad@ubuntu.com>
Date: Wed, 25 May 2022 18:22:00 +0800
Subject: Switch Ubuntu from powerpc to powerpc-smp kernel

Forwarded: no
---
 functions/defaults.sh                    | 4 ++--
 scripts/build/lb_binary_debian-installer | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/functions/defaults.sh b/functions/defaults.sh
index 1ad0205..7d64ef0 100755
--- a/functions/defaults.sh
+++ b/functions/defaults.sh
@@ -803,11 +803,11 @@ Set_defaults ()
 				ubuntu|kubuntu)
 					case "${LIST}" in
 						stripped|minimal)
-							LB_LINUX_FLAVOURS="${LB_LINUX_FLAVOURS:-powerpc}"
+							LB_LINUX_FLAVOURS="${LB_LINUX_FLAVOURS:-powerpc-smp}"
 							;;
 
 						*)
-							LB_LINUX_FLAVOURS="${LB_LINUX_FLAVOURS:-powerpc powerpc64-smp}"
+							LB_LINUX_FLAVOURS="${LB_LINUX_FLAVOURS:-powerpc-smp generic}"
 							;;
 					esac
 					;;
diff --git a/scripts/build/lb_binary_debian-installer b/scripts/build/lb_binary_debian-installer
index cc94a84..1414075 100755
--- a/scripts/build/lb_binary_debian-installer
+++ b/scripts/build/lb_binary_debian-installer
@@ -395,7 +395,7 @@ then
 			DI_REQ_PACKAGES="yaboot"
 			case "${LB_MODE}" in
 				ubuntu|kubuntu)
-					DI_PACKAGES="${DI_REQ_PACKAGES} linux-image-powerpc linux-image-powerpc64-smp"
+					DI_PACKAGES="${DI_REQ_PACKAGES} linux-image-powerpc-smp linux-image-generic"
 					;;
 
 				*)
