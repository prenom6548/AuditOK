From: =?utf-8?b?6LCi54Kc?= <xiewei@kylinos.cn>
Date: Tue, 2 Feb 2021 15:03:10 +0800
Subject: change efiboot.img to FAT12

---
 scripts/build/lb_binary_grub2-efi | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/scripts/build/lb_binary_grub2-efi b/scripts/build/lb_binary_grub2-efi
index b8a7534..e6aaea7 100755
--- a/scripts/build/lb_binary_grub2-efi
+++ b/scripts/build/lb_binary_grub2-efi
@@ -48,7 +48,7 @@ Check_crossarchitectures
 case ${ARCHITECTURE} in
 		'amd64'|'arm64'|'mips64el'|'loongarch64')
 			Check_package chroot/usr/bin/grub-mkimage grub-efi-${ARCHITECTURE}
-			Check_package chroot/sbin/mkfs.vfat dosfstools
+			Check_package chroot/sbin/mkfs.fat dosfstools
 			Check_package chroot/sbin/MAKEDEV makedev
 			;;
         *)
@@ -344,8 +344,8 @@ input_efi_dir=${KY_EFI}
 core_efi_img=\$(mktemp)
 efi_mount_tmp=\$(mktemp -d)
 grub-mkimage -p /boot/grub -o \${core_efi_img} -O ${KY_EFI_NAME} -d \${input_efi_dir} ${GRUB_MODS}
-dd if=/dev/zero of=efi.img bs=1M count=100
-mkfs.vfat efi.img
+dd if=/dev/zero of=efi.img bs=1M count=28
+mkfs.fat -F12 efi.img
 mount -o loop efi.img \${efi_mount_tmp}
 mkdir -p \${efi_mount_tmp}/EFI/BOOT/
 cp \${core_efi_img} \${efi_mount_tmp}/EFI/BOOT/${KY_BOOT_EFI_NAME}
