修复kaiming目录路径，新版本中/opt是符号链接
---
 scripts/build/lb_ostree_commit | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/scripts/build/lb_ostree_commit b/scripts/build/lb_ostree_commit
index 70f7d9a..d75d218 100644
--- a/scripts/build/lb_ostree_commit
+++ b/scripts/build/lb_ostree_commit
@@ -88,12 +88,12 @@ if [ -L chroot/chroot/usr/etc/systemd/system/graphical.target.wants/kylin-os-ins
 fi
 
 # 忽略安装开明包的目录
-if [ -d chroot/chroot/opt/kaiming ]; then
-    echo "/opt/kaiming" >> chroot/skip-files.txt
+if [ -d chroot/chroot/var/opt/kaiming ]; then
+    echo "/var/opt/kaiming" >> chroot/skip-files.txt
 fi
 
-if [ -d chroot/chroot/opt/kaiming-ok ]; then
-    echo "/opt/kaiming-ok" >> chroot/skip-files.txt
+if [ -d chroot/chroot/var/opt/kaiming-ok ]; then
+    echo "/var/opt/kaiming-ok" >> chroot/skip-files.txt
 fi
 
 while read os_release_file_line
