V11-2602-RC5版本龙芯架构因光盘源缺少loongarch64架构索引文件报错

Bug: 470775
From: kylin
Severity: Moderate
Changelog-Bug: #470775 V11-2602-RC5版本龙芯架构因光盘源缺少loongarch64架构索引文件报错
Change-Id: Idaa218457212e2aa6e735bdc9a9f74715815fae4
---
 scripts/build/lb_binary_package-lists | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/scripts/build/lb_binary_package-lists b/scripts/build/lb_binary_package-lists
index dcc1a4b..0171d55 100755
--- a/scripts/build/lb_binary_package-lists
+++ b/scripts/build/lb_binary_package-lists
@@ -224,6 +224,14 @@ then
 
 		fi
 
+		# bug#470775，loong64架构光盘源要增加loongarch64架构
+		if [ "${LB_ARCHITECTURES}" = "loong64" ]
+		then
+			mkdir -p dists/${LB_PARENT_DISTRIBUTION}/${SECTION}/binary-loongarch64
+			touch dists/${LB_PARENT_DISTRIBUTION}/${SECTION}/binary-loongarch64/Packages
+			gzip -9 -c dists/${LB_PARENT_DISTRIBUTION}/${SECTION}/binary-loongarch64/Packages > dists/${LB_PARENT_DISTRIBUTION}/${SECTION}/binary-loongarch64/Packages.gz
+		fi
+
 		mkdir -p dists/${LB_PARENT_DISTRIBUTION}/${SECTION}/binary-${LB_ARCHITECTURES}
 		apt-ftparchive packages pool/${SECTION} > dists/${LB_PARENT_DISTRIBUTION}/${SECTION}/binary-${LB_ARCHITECTURES}/Packages
 		gzip -9 -c dists/${LB_PARENT_DISTRIBUTION}/${SECTION}/binary-${LB_ARCHITECTURES}/Packages > dists/${LB_PARENT_DISTRIBUTION}/${SECTION}/binary-${LB_ARCHITECTURES}/Packages.gz
