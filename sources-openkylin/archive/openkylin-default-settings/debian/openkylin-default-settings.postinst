#!/bin/sh
set -e

FILE_NAME=/etc/apt/sources.list
FILE_MD5=fb7f2a0e9a06692bd34eb45c6df10a89
DISTRIBUTION_FILE=/usr/lib/firefox/distribution/distribution.ini
DISTRIBUTION_BACKUP=/usr/lib/firefox/distribution/distribution.ini.backup
FONTCONFIG_AVAIL=/usr/share/fontconfig/conf.avail/64-openkylin-prefer-cjk.conf
FONTCONFIG_LINK=/etc/fonts/conf.d/64-openkylin-prefer-cjk.conf

if [ "$1" = configure ]; then
    mkdir -p /etc/fonts/conf.d
    ln -sf $FONTCONFIG_AVAIL $FONTCONFIG_LINK

    md5=`md5sum $FILE_NAME | awk '{print $1}'`
    if [ "$md5" = "$FILE_MD5" ]; then
        sed -i '/yangtze-proposed/d' $FILE_NAME
    fi
fi

if [ -e $DISTRIBUTION_FILE ]; then
    mv $DISTRIBUTION_FILE $DISTRIBUTION_BACKUP
fi

#DEBHELPER#

