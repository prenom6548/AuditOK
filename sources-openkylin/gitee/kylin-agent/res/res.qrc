<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/">
        <!-- PNG icons -->
        <file alias="expand.svg">expand.svg</file>
        <file alias="close.svg">close.svg</file>
        <file alias="settings.svg">settings.svg</file>
        <file alias="maximize.svg">maximize.svg</file>
        <file alias="minimize.svg">minimize.svg</file>
        <file alias="newchat.svg">newchat.svg</file>
        <file alias="newchat2.svg">newchat2.svg</file>
        <file alias="stop.png">stop.png</file>
        <file alias="ai-agent.png">ai-agent.png</file>
        <file alias="asst.png">asst.png</file>
        <file alias="user.png">user.png</file>
        <!-- SVG icons (矢量图标，任意缩放不失真) -->
		<file alias="download.svg">download.svg</file>
		<file alias="fix.svg">fix.svg</file>
		<file alias="attachment.svg">attachment.svg</file>
		<file alias="voice.svg">voice.svg</file>
		<file alias="voice_recognizing.gif">voice_recognizing.gif</file>
        <file alias="send.svg">send.svg</file>
        <file alias="send_disable.svg">send_disable.svg</file>
        <file alias="normal.svg">normal.svg</file>
        <file alias="speed.svg">speed.svg</file>
        <file alias="preview.svg">preview.svg</file>
        <file alias="copy.svg">copy.svg</file>
        <file alias="play.svg">play.svg</file>
        <file alias="detail.svg">detail.svg</file>
        <file alias="check.svg">check.svg</file>
        <file alias="copy-success.svg">copy-success.svg</file>
        <file alias="edit.svg">edit.svg</file>
    </qresource>
</RCC>
