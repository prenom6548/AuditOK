#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # 刷新共享库链接缓存
        if [ -x /sbin/ldconfig ]; then
            ldconfig
        fi
        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
