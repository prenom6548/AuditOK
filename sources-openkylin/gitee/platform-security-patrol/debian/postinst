#!/bin/sh
set -e

case "$1" in
    configure)
        # 确保日志目录权限正确
        if [ -d /var/log/plat-sec-patrol ]; then
            chmod 755 /var/log/plat-sec-patrol
        fi
        # ldconfig 由 debhelper 自动触发生成，无需手动调用
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
