#!/bin/sh
set -e

case "$1" in
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # ldconfig 由 debhelper 自动触发生成，无需手动调用
        ;;

    purge)
        # 完全卸载时清理日志目录
        rm -rf /var/log/plat-sec-patrol 2>/dev/null || true
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
