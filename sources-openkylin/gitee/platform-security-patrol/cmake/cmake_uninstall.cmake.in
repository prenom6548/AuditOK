# cmake/cmake_uninstall.cmake.in
# 由 CMakeLists.txt 的 configure_file 生成实际脚本
# 用法: make uninstall

set(MANIFEST "${CMAKE_CURRENT_BINARY_DIR}/install_manifest.txt")

if(NOT EXISTS "${MANIFEST}")
    message(FATAL_ERROR "Cannot find install manifest: ${MANIFEST}\n"
        "Did you run 'make install' first?")
endif()

file(STRINGS "${MANIFEST}" installed_files)

set(removed_dirs "")

foreach(file IN LISTS installed_files)
    if(EXISTS "${file}" OR IS_SYMLINK "${file}")
        message(STATUS "Removing: ${file}")
        file(REMOVE "${file}")
    else()
        message(STATUS "Already removed: ${file}")
    endif()

    # 收集父目录，后续统一清理空目录
    get_filename_component(dir "${file}" DIRECTORY)
    list(APPEND removed_dirs "${dir}")
endforeach()

# 去重并按路径长度降序排列（先删深层目录）
if(removed_dirs)
    list(REMOVE_DUPLICATES removed_dirs)
    list(SORT removed_dirs)
    list(REVERSE removed_dirs)

    foreach(dir IN LISTS removed_dirs)
        # 仅清理由本项目安装的目录，不碰系统目录
        if("${dir}" MATCHES "plat-sec-patrol")
            if(IS_DIRECTORY "${dir}")
                file(GLOB remaining "${dir}/*")
                if(NOT remaining)
                    message(STATUS "Removing empty directory: ${dir}")
                    file(REMOVE "${dir}")
                endif()
            endif()
        endif()
    endforeach()
endif()

message(STATUS "Uninstall complete.")
