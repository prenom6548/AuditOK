{
	"name": "config-gitee-sync",
	"displayName": "IDE配置同步(syncing gitee版)",
	"description": "%description%",
	"version": "0.0.1",
	"publisher": "KylinIDETeam",
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"clear": "remove-all ount",
		"compile": "gulp compile-extension:config-gitee-sync",
		"watch": "gulp watch-extension:config-gitee-sync",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src --ext ts"
	},
	"icon": "res/logo.png",
	"license": "MIT",
	"engines": {
		"vscode": "^1.52.0"
	},
	"bugs": "https://gitee.com/openkylin/kylin-code/issues",
	"homepage": "https://gitee.com/openkylin/kylin-code",
	"repository": {
		"type": "git",
		"url": "https://gitee.com/openkylin/kylin-code.git"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"gitee",
		"sync",
		"setting",
		"配置",
		"同步",
		"共享"
	],
	"activationEvents": [
		"*"
	],
	"contributes": {
		"commands": [
			{
				"command": "configGiteeSync.uploadSettings",
				"title": "%commands.uploadSettings%"
			},
			{
				"command": "configGiteeSync.downloadSettings",
				"title": "%commands.downloadSettings%"
			},
			{
				"command": "configGiteeSync.openSettings",
				"title": "%commands.openSettings%"
			}
		],
		"menus": {
			"file/sync": [
				{
					"command": "configGiteeSync.uploadSettings"
				},
				{
					"command": "configGiteeSync.downloadSettings"
				},
				{
					"command": "configGiteeSync.openSettings"
				}
			]
		},
		"configuration": [
			{
				"title": "%configuration.title%",
				"properties": {
					"giteeSync.excludedExtensions": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [
							"KylinIDETeam.config-gitee-sync"
						],
						"description": "%configuration.giteeSync.excludedExtensions%"
					},
					"giteeSync.excludedSettings": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"description": "%configuration.giteeSync.excludedSettings%"
					},
					"giteeSync.extensions.autoUpdate": {
						"type": "boolean",
						"default": true,
						"description": "%configuration.giteeSync.extensions.autoUpdate%"
					},
					"giteeSync.pokaYokeThreshold": {
						"type": "number",
						"default": 10,
						"description": "%configuration.giteeSync.pokaYokeThreshold%"
					},
					"giteeSync.separateKeybindings": {
						"type": "boolean",
						"default": true,
						"description": "%configuration.giteeSync.separateKeybindings%"
					}
				}
			}
		],
		"keybindings": [
			{
				"key": "",
				"command": "configGiteeSync.uploadSettings"
			},
			{
				"key": "",
				"command": "configGiteeSync.downloadSettings"
			},
			{
				"key": "",
				"command": "configGiteeSync.openSettings"
			}
		]
	},
	"devDependencies": {
		"@types/extract-zip": "1.6.2",
		"@types/fs-extra": "9.0.6",
		"@types/glob": "7.1.3",
		"@types/lodash.debounce": "4.0.6",
		"@types/lodash.pick": "4.4.6",
		"@types/micromatch": "4.0.1",
		"@types/node": "22.x",
		"@types/node-fetch": "2.5.8",
		"@types/tmp": "0.2.0",
		"glob": "7.1.6",
		"mora-scripts": "1.7.4",
		"vscode-test": "1.4.1"
	},
	"dependencies": {
		"chokidar": "3.5.0",
		"date-fns": "2.16.1",
		"extract-zip": "2.0.1",
		"fs-extra": "9.0.1",
		"jsonc-parser": "3.0.0",
		"jsondiffpatch": "0.4.1",
		"junk": "3.1.0",
		"lodash.debounce": "4.0.8",
		"lodash.pick": "4.4.0",
		"micromatch": "4.0.2",
		"node-fetch": "2.6.1",
		"tmp": "0.2.1",
		"tslib": "2.1.0"
	}
}
