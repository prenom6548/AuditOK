# syntax=docker/dockerfile:1.7

# Incremental source build of the ROS 2 Lyrical simulation variant for
# openKylin 3.0. The published ros_base image is the underlay; only the
# simulation package closure (ROS <-> Gazebo Jetty integration) is built here.

ARG ROS_BASE_IMAGE=openkylin/ros:lyrical-ros-base@sha256:bc947b2d3766a55f000c032fde697b3d6ef60e7e2975d4929ed1a3046c3e4834

FROM --platform=${TARGETPLATFORM} ${ROS_BASE_IMAGE} AS builder

ARG ROS_DISTRO=lyrical
ARG ROS_VARIANTS_REF=0.13.0
ARG BULLET_REF=3.24
ARG OCTOMAP_REF=v1.9.8
ARG FCL_REF=0.7.0
ARG ASSIMP_VERSION=6.0.4
ARG CFORTRAN_DEB_URL=https://deb.debian.org/debian/pool/main/c/cfortran/cfortran_20210827-1.1_all.deb
ARG CFORTRAN_DEB_SHA256=49e910e074b9865ad045d517e3130ce2d76c569d0ef99e744586d17c3c79b381
ARG BUILD_JOBS=2
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=${ROS_DISTRO} \
    CMAKE_POLICY_VERSION_MINIMUM=3.5 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONPATH=/opt/ros-python \
    PATH=/opt/simulation-tools/bin:${PATH}

# Keep source-management and compiler tooling out of the runtime stage.
RUN if [ "${TARGETARCH}" = "amd64" ]; then \
      printf '%s\n' \
        'Package: python3-pkg-resources' \
        'Pin: version 68.1.2-ok2' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-python.pref; \
    else \
      printf '%s\n' \
        'Package: libucx0' \
        'Pin: version 1.16.0+ds-ok1' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-ucx.pref; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        make \
        ninja-build \
        patch \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        python3-yaml \
        unzip \
        wget \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv --system-site-packages /opt/simulation-tools \
    && PYTHONPATH= /opt/simulation-tools/bin/pip install --no-cache-dir --upgrade \
        pip setuptools wheel \
    && PYTHONPATH= /opt/simulation-tools/bin/pip install --no-cache-dir \
        catkin-pkg \
        colcon-common-extensions \
        empy==4.2 \
        lark \
        rosdep \
        rosinstall-generator \
        vcstool

WORKDIR /simulation_ws

# Generate the released Lyrical closure and remove every package already in
# the ros_base underlay. The generated revisions reflect rosdistro at build
# time; separate uncached builds can pick up newer releases.
RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && ros2 pkg list | sort -u > /tmp/base-packages.txt \
    && /opt/simulation-tools/bin/rosinstall_generator simulation \
        --rosdistro "${ROS_DISTRO}" \
        --deps \
        --deps-only \
        --format repos \
        --upstream \
        --exclude $(cat /tmp/base-packages.txt) \
        > /tmp/simulation.repos \
    && mkdir -p src \
    && /opt/simulation-tools/bin/vcs import --shallow src < /tmp/simulation.repos \
    && git clone --depth 1 --branch "${ROS_VARIANTS_REF}" \
        https://github.com/ros2/variants.git src/ros2/variants \
    && rm -f /tmp/simulation.repos

# The ros_base runtime carries Bullet shared libraries, but simulation also
# needs its headers and CMake package to build DART and Gazebo physics plugins.
# openKylin publishes libfcl-dev metadata, but its required liboctomap1.9
# binary is currently absent. Build all three pinned dependencies together.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libboost-dev \
        libccd-dev \
        libeigen3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --depth 1 --branch "${BULLET_REF}" \
        https://github.com/bulletphysics/bullet3.git /tmp/bullet-src \
    && cmake -S /tmp/bullet-src -B /tmp/bullet-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/simulation-deps \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_BULLET2_DEMOS=OFF \
        -DBUILD_BULLET3=OFF \
        -DBUILD_CPU_DEMOS=OFF \
        -DBUILD_EXTRAS=OFF \
        -DBUILD_OPENGL3_DEMOS=OFF \
        -DBUILD_UNIT_TESTS=OFF \
        -DINSTALL_LIBS=ON \
        -DUSE_GRAPHICAL_BENCHMARK=OFF \
    && cmake --build /tmp/bullet-build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/bullet-build \
    && git clone --depth 1 --branch "${OCTOMAP_REF}" \
        https://github.com/OctoMap/octomap.git /tmp/octomap-src \
    && cmake -S /tmp/octomap-src -B /tmp/octomap-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/simulation-deps \
        -DCMAKE_CXX_FLAGS=-Wno-error=template-id-cdtor \
        -DBUILD_TESTING=OFF \
        -DBUILD_OCTOVIS_SUBPROJECT=OFF \
        -DBUILD_DYNAMICETD3D_SUBPROJECT=OFF \
    && cmake --build /tmp/octomap-build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/octomap-build \
    && git clone --depth 1 --branch "${FCL_REF}" \
        https://github.com/flexible-collision-library/fcl.git /tmp/fcl-src \
    && cmake -S /tmp/fcl-src -B /tmp/fcl-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/simulation-deps \
        -DCMAKE_PREFIX_PATH=/opt/simulation-deps \
        -DBUILD_TESTING=OFF \
        -DFCL_BUILD_TESTS=OFF \
        -DFCL_BUILD_EXAMPLES=OFF \
        -DFCL_BUILD_DOCUMENTATION=OFF \
    && cmake --build /tmp/fcl-build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/fcl-build \
    && rm -rf /tmp/bullet-src /tmp/bullet-build \
        /tmp/octomap-src /tmp/octomap-build /tmp/fcl-src /tmp/fcl-build

# openKylin's arm64/riscv64 libassimp-dev currently requires an unpublished
# libdraco8 binary. Keep amd64 on the distro package and provide the same
# Assimp release from source on the affected architectures.
RUN mkdir -p /opt/assimp \
    && if [ "${TARGETARCH}" != "amd64" ]; then \
         git clone --depth 1 --branch "v${ASSIMP_VERSION}" \
           https://github.com/assimp/assimp.git /tmp/assimp-src; \
         cmake -S /tmp/assimp-src -B /tmp/assimp-build -G Ninja \
           -DCMAKE_BUILD_TYPE=Release \
           -DCMAKE_INSTALL_PREFIX=/opt/assimp \
           -DBUILD_SHARED_LIBS=ON \
           -DASSIMP_BUILD_ASSIMP_TOOLS=OFF \
           -DASSIMP_BUILD_SAMPLES=OFF \
           -DASSIMP_BUILD_TESTS=OFF \
           -DASSIMP_WARNINGS_AS_ERRORS=OFF; \
         cmake --build /tmp/assimp-build --parallel "${BUILD_JOBS}"; \
         cmake --install /tmp/assimp-build; \
         rm -rf /tmp/assimp-src /tmp/assimp-build; \
       fi

# huanghe currently publishes libcfitsio-dev and libgdal-dev but omits their
# architecture-independent cfortran dependency. Install the verified Debian
# header package so gz-common keeps its required geospatial component.
RUN curl -fsSL "${CFORTRAN_DEB_URL}" -o /tmp/cfortran.deb \
    && echo "${CFORTRAN_DEB_SHA256}  /tmp/cfortran.deb" | sha256sum -c - \
    && dpkg -i /tmp/cfortran.deb \
    && rm -f /tmp/cfortran.deb

# openKylin 3.0 publishes Qt 6.10.2 Base for riscv64, but currently omits
# ShaderTools, Declarative/QML, Qt5Compat, Charts and Positioning. Gazebo GUI
# needs all of them, so build exactly those matching modules on riscv64. Use a
# DESTDIR tree both to install them into this builder and to copy the identical
# files into the runtime stage. Keep each module in its own cache layer because
# Qt Declarative is expensive to compile under QEMU.
RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        bison \
        flex \
        glslang-dev \
        libegl-dev \
        libgl-dev \
        libglx-dev \
        libvulkan-dev \
        libxkbcommon-dev \
        python3-html5lib \
        python3-ply \
        python3-regex \
        qt6-base-dev \
        qt6-base-private-dev \
        spirv-tools; \
      rm -rf /var/lib/apt/lists/*; \
      mkdir -p /usr/lib/qt6/lib/qt6/libexec; \
      ln -sf /usr/lib/qt6/libexec/qt-cmake-private \
        /usr/lib/qt6/lib/qt6/libexec/qt-cmake-private; \
      ln -sf /usr/lib/qt6/libexec/qt-cmake-private-install.cmake \
        /usr/lib/qt6/lib/qt6/libexec/qt-cmake-private-install.cmake; \
    fi

ARG QT_VERSION=6.10.2

RUN mkdir -p /opt/qt6-riscv-root \
    && if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      git clone --depth 1 --branch "v${QT_VERSION}" \
        https://github.com/qt/qtshadertools.git /tmp/qtshadertools-src; \
      mkdir -p /tmp/qtshadertools-build; \
      cd /tmp/qtshadertools-build; \
      cmake -S /tmp/qtshadertools-src -B . -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_MAKE_PROGRAM=/usr/bin/ninja \
        -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF; \
      cmake --build . --parallel "${BUILD_JOBS}"; \
      DESTDIR=/opt/qt6-riscv-root cmake --install .; \
      cp -a /opt/qt6-riscv-root/. /; \
      ldconfig; \
      cd /simulation_ws; \
      rm -rf /tmp/qtshadertools-src /tmp/qtshadertools-build; \
    fi

# Separate from BUILD_JOBS to preserve the expensive dependency cache.
# Override on builders with fewer available cores or less memory.
ARG QT_MODULE_JOBS=16

RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      git clone --depth 1 --branch "v${QT_VERSION}" \
        https://github.com/qt/qtdeclarative.git /tmp/qtdeclarative-src; \
      mkdir -p /tmp/qtdeclarative-build; \
      cd /tmp/qtdeclarative-build; \
      cmake -S /tmp/qtdeclarative-src -B . -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_MAKE_PROGRAM=/usr/bin/ninja \
        -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF; \
      cmake --build . --parallel "${QT_MODULE_JOBS}"; \
      DESTDIR=/opt/qt6-riscv-root cmake --install .; \
      cp -a /opt/qt6-riscv-root/. /; \
      ldconfig; \
      cd /simulation_ws; \
      rm -rf /tmp/qtdeclarative-src /tmp/qtdeclarative-build; \
    fi

# Qt5Compat needs ICU's development targets as well as Qt Base's runtime ICU.
# Keep this after Declarative so the completed Qt layers remain reusable.
RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      apt-get update; \
      apt-get install -y --no-install-recommends libicu-dev; \
      rm -rf /var/lib/apt/lists/*; \
    fi

RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      git clone --depth 1 --branch "v${QT_VERSION}" \
        https://github.com/qt/qt5compat.git /tmp/qt5compat-src; \
      mkdir -p /tmp/qt5compat-build; \
      cd /tmp/qt5compat-build; \
      cmake -S /tmp/qt5compat-src -B . -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_MAKE_PROGRAM=/usr/bin/ninja \
        -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF; \
      cmake --build . --parallel "${QT_MODULE_JOBS}"; \
      DESTDIR=/opt/qt6-riscv-root cmake --install .; \
      cp -a /opt/qt6-riscv-root/. /; \
      ldconfig; \
      cd /simulation_ws; \
      rm -rf /tmp/qt5compat-src /tmp/qt5compat-build; \
    fi

RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      git clone --depth 1 --branch "v${QT_VERSION}" \
        https://github.com/qt/qtcharts.git /tmp/qtcharts-src; \
      mkdir -p /tmp/qtcharts-build; \
      cd /tmp/qtcharts-build; \
      cmake -S /tmp/qtcharts-src -B . -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_MAKE_PROGRAM=/usr/bin/ninja \
        -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF; \
      cmake --build . --parallel "${QT_MODULE_JOBS}"; \
      DESTDIR=/opt/qt6-riscv-root cmake --install .; \
      cp -a /opt/qt6-riscv-root/. /; \
      ldconfig; \
      cd /simulation_ws; \
      rm -rf /tmp/qtcharts-src /tmp/qtcharts-build; \
    fi

RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      git clone --depth 1 --branch "v${QT_VERSION}" \
        https://github.com/qt/qtpositioning.git /tmp/qtpositioning-src; \
      mkdir -p /tmp/qtpositioning-build; \
      cd /tmp/qtpositioning-build; \
      cmake -S /tmp/qtpositioning-src -B . -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_MAKE_PROGRAM=/usr/bin/ninja \
        -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF; \
      cmake --build . --parallel "${QT_MODULE_JOBS}"; \
      DESTDIR=/opt/qt6-riscv-root cmake --install .; \
      cp -a /opt/qt6-riscv-root/. /; \
      ldconfig; \
      cd /simulation_ws; \
      rm -rf /tmp/qtpositioning-src /tmp/qtpositioning-build; \
    fi

# The openKylin riscv64 OGRE 1.9 packages are published without their zzip
# runtime dependency. Supply that exact package from Debian and verify it.
# Its only dependencies are libc6 >= 2.33 and zlib1g, both provided here.
ARG RISCV64_ZZIP_DEB_URL=https://deb.debian.org/debian/pool/main/z/zziplib/libzzip-0-13t64_0.13.78+dfsg.1-0.1_riscv64.deb
ARG RISCV64_ZZIP_DEB_SHA256=0849ee85d642fbea544e627fea7ba1729f3d6ad1d691235d25ef5d874c62f04e
ARG RISCV64_LIBRUBY_DEB_URL=https://ports.ubuntu.com/ubuntu-ports/pool/main/r/ruby-defaults/libruby_3.2~ubuntu1_riscv64.deb
ARG RISCV64_LIBRUBY_DEB_SHA256=03648454aabc083bb26f405733ca7b1b7adc1d2064987ff9020cf2b5f1b50bb9
ARG RISCV64_RUBY_DEB_URL=https://ports.ubuntu.com/ubuntu-ports/pool/main/r/ruby-defaults/ruby_3.2~ubuntu1_riscv64.deb
ARG RISCV64_RUBY_DEB_SHA256=e9ce70ffb4437373b806dc057d1b0ed013d88d81f5273d9b1e369cc9b6f5592e
ARG RISCV64_RUBYGEMS_DEB_URL=https://ports.ubuntu.com/ubuntu-ports/pool/main/r/rubygems/ruby-rubygems_3.4.20-1_all.deb
ARG RISCV64_RUBYGEMS_DEB_SHA256=9cb6041d902b74fd6e9373b24922e788bc2d1ed4360705ca6b53945d67b32087
ARG RISCV64_GLSLC_DEB_URL=https://deb.debian.org/debian/pool/main/s/shaderc/glslc_2025.2-1_riscv64.deb
ARG RISCV64_GLSLC_DEB_SHA256=71a7e292d0f0c296190369ff2f123590f95f0609cb337c8e3a0b6d98952a06f7
ARG RISCV64_LIBSHADERC_DEB_URL=https://deb.debian.org/debian/pool/main/s/shaderc/libshaderc1_2025.2-1_riscv64.deb
ARG RISCV64_LIBSHADERC_DEB_SHA256=b355628e960924542174d57a5eb4413b65b5ac192aacc27ab69d4d31ca461dfc
ARG RISCV64_LIBSHADERC_DEV_DEB_URL=https://deb.debian.org/debian/pool/main/s/shaderc/libshaderc-dev_2025.2-1_riscv64.deb
ARG RISCV64_LIBSHADERC_DEV_DEB_SHA256=65e4f3ee22f956138bc34658f640f345acc92a2799de3f9388dcb8dbe48215d6
ARG RISCV64_ZZIP_DEV_DEB_URL=https://deb.debian.org/debian/pool/main/z/zziplib/libzzip-dev_0.13.78+dfsg.1-0.1_riscv64.deb
ARG RISCV64_ZZIP_DEV_DEB_SHA256=acb259a79d01a43d58b9742caa5a118aae62dcfa5951d63b68e1343ff6a9810d

RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      curl -fsSL "${RISCV64_ZZIP_DEB_URL}" -o /tmp/libzzip.deb; \
      echo "${RISCV64_ZZIP_DEB_SHA256}  /tmp/libzzip.deb" | sha256sum -c -; \
      dpkg -i /tmp/libzzip.deb; \
      rm -f /tmp/libzzip.deb; \
      curl -fsSL "${RISCV64_LIBRUBY_DEB_URL}" -o /tmp/libruby.deb; \
      curl -fsSL "${RISCV64_RUBY_DEB_URL}" -o /tmp/ruby.deb; \
      curl -fsSL "${RISCV64_RUBYGEMS_DEB_URL}" -o /tmp/ruby-rubygems.deb; \
      curl -fsSL "${RISCV64_GLSLC_DEB_URL}" -o /tmp/glslc.deb; \
      curl -fsSL "${RISCV64_LIBSHADERC_DEB_URL}" -o /tmp/libshaderc1.deb; \
      curl -fsSL "${RISCV64_LIBSHADERC_DEV_DEB_URL}" -o /tmp/libshaderc-dev.deb; \
      curl -fsSL "${RISCV64_ZZIP_DEV_DEB_URL}" -o /tmp/libzzip-dev.deb; \
      echo "${RISCV64_LIBRUBY_DEB_SHA256}  /tmp/libruby.deb" | sha256sum -c -; \
      echo "${RISCV64_RUBY_DEB_SHA256}  /tmp/ruby.deb" | sha256sum -c -; \
      echo "${RISCV64_RUBYGEMS_DEB_SHA256}  /tmp/ruby-rubygems.deb" | sha256sum -c -; \
      echo "${RISCV64_GLSLC_DEB_SHA256}  /tmp/glslc.deb" | sha256sum -c -; \
      echo "${RISCV64_LIBSHADERC_DEB_SHA256}  /tmp/libshaderc1.deb" | sha256sum -c -; \
      echo "${RISCV64_LIBSHADERC_DEV_DEB_SHA256}  /tmp/libshaderc-dev.deb" | sha256sum -c -; \
      echo "${RISCV64_ZZIP_DEV_DEB_SHA256}  /tmp/libzzip-dev.deb" | sha256sum -c -; \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        /tmp/libruby.deb /tmp/ruby.deb /tmp/ruby-rubygems.deb \
        /tmp/glslc.deb /tmp/libshaderc1.deb /tmp/libshaderc-dev.deb \
        /tmp/libzzip-dev.deb; \
      rm -f /tmp/libruby.deb /tmp/ruby.deb /tmp/ruby-rubygems.deb \
        /tmp/glslc.deb /tmp/libshaderc1.deb /tmp/libshaderc-dev.deb \
        /tmp/libzzip-dev.deb; \
      ruby --version; \
      glslc --version; \
    fi

# openKylin does not publish Poco for riscv64. Build the commonly shipped
# libpoco-dev component set from the signed upstream release commit.
ARG POCO_COMMIT=96d182a99303fb068575294b36f0cc20da2e7b25
ARG POCO_BUILD_JOBS=8

RUN mkdir -p /opt/poco \
    && if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      git clone --filter=blob:none https://github.com/pocoproject/poco.git /tmp/poco-src; \
      git -C /tmp/poco-src checkout --detach "${POCO_COMMIT}"; \
      test "$(git -C /tmp/poco-src rev-parse HEAD)" = "${POCO_COMMIT}"; \
      cmake -S /tmp/poco-src -B /tmp/poco-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/poco \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -DENABLE_TESTS=OFF -DENABLE_SAMPLES=OFF \
        -DENABLE_DATA=OFF -DENABLE_MONGODB=OFF -DENABLE_REDIS=OFF \
        -DENABLE_PROMETHEUS=OFF -DENABLE_APACHECONNECTOR=OFF \
        -DENABLE_PAGECOMPILER=OFF -DENABLE_ACTIVERECORD=OFF \
        -DENABLE_PDF=OFF -DENABLE_SEVENZIP=OFF \
        -DPOCO_UNBUNDLED=OFF; \
      cmake --build /tmp/poco-build --parallel "${POCO_BUILD_JOBS}"; \
      cmake --install /tmp/poco-build; \
      rm -rf /tmp/poco-src /tmp/poco-build; \
    fi

# Use Ubuntu Noble rosdep keys as a package-name mapping, then resolve packages
# from openKylin's own repositories. This does not imply Ubuntu ABI compatibility.
# Capture exec dependencies separately for the runtime.
ARG ROSDEP_SKIP_KEYS="ament_uncrustify asio benchmark bullet clang-format console_bridge cppcheck fcl ffmpeg-dev fzf gmock libbenchmark-dev libbullet-dev libconsole-bridge-dev libfcl-dev libgmock-dev liblttng-ust-dev liblz4-dev liboctomap-dev liborocos-kdl liborocos-kdl-dev liborocos-kdl1.5 libpostproc-dev libspdlog-dev libxml2-utils lttng-tools lttng-ust octomap pybind11 pybind11-dev pydocstyle spdlog uncrustify python3-argcomplete python3-catkin-pkg python3-catkin-pkg-modules python3-colcon-common-extensions python3-empy python3-flake8 python3-flake8-blind-except python3-flake8-builtins python3-flake8-class-newline python3-flake8-comprehensions python3-flake8-deprecated python3-flake8-import-order python3-flake8-quotes python3-lark-parser python3-lxml python3-mypy python3-osrf-pycommon python3-pycodestyle python3-pyflakes python3-pytest python3-rosdep python3-rosdistro python3-rosdistro-modules python3-rospkg python3-rospkg-modules python3-setuptools python3-typing-extensions python3-vcstool"
ARG RISCV64_QT_ROSDEP_SKIP_KEYS="libqt6charts6 libqt6core5compat6 libqt6positioning6 libqt6qml6 libqt6quick6 qml6-module-qt-labs-folderlistmodel qml6-module-qt-labs-platform qml6-module-qt-labs-settings qml6-module-qt5compat-graphicaleffects qml6-module-qtcharts qml6-module-qtcore qml6-module-qtpositioning qml6-module-qtqml qml6-module-qtqml-models qml6-module-qtqml-workerscript qml6-module-qtquick qml6-module-qtquick-controls qml6-module-qtquick-dialogs qml6-module-qtquick-layouts qml6-module-qtquick-templates qml6-module-qtquick-window qt6-5compat-dev qt6-charts-dev qt6-declarative-dev qt6-declarative-dev-tools qt6-declarative-private-dev qt6-positioning-dev qt6-qmltooling-plugins qt6-shadertools-dev qt6-shadertools-dev-tools"

# Gazebo Sim's vendored Backward-cpp prefers libdw when it is available.
# Keep libdw-dev in both dependency sets; riscv64 lacks the alternative
# libdwarf-dev package, so only that unused alternative is skipped there.
RUN export DISABLE_GROUPS_WORKAROUND=1 ROS_OS_OVERRIDE=ubuntu:noble \
    && . /opt/ros/${ROS_DISTRO}/setup.sh \
    && mkdir -p /etc/ros/rosdep/sources.list.d \
    && if [ ! -e /etc/ros/rosdep/sources.list.d/20-default.list ]; then \
         /opt/simulation-tools/bin/rosdep init; \
       fi \
    && /opt/simulation-tools/bin/rosdep update --rosdistro "${ROS_DISTRO}" \
    && /opt/simulation-tools/bin/colcon list \
        --packages-up-to simulation \
        --paths-only \
        | sort -u > /tmp/simulation-paths.txt \
    && apt-mark showmanual | sort -u > /tmp/manual-before-exec.txt \
    && rosdep_skip_keys="${ROSDEP_SKIP_KEYS}" \
    && if [ "${TARGETARCH}" != "amd64" ]; then \
         rosdep_skip_keys="${rosdep_skip_keys} assimp assimp-dev libassimp-dev"; \
       fi \
    && if [ "${TARGETARCH}" = "riscv64" ]; then \
         rosdep_skip_keys="${rosdep_skip_keys} ${RISCV64_QT_ROSDEP_SKIP_KEYS} glslc libdwarf-dev libpoco-dev libshaderc-dev libzzip-dev ruby"; \
       fi \
    && apt-get update \
    && xargs /opt/simulation-tools/bin/rosdep install \
        --from-paths \
        --ignore-src \
        --rosdistro "${ROS_DISTRO}" \
        --os=ubuntu:noble \
        --dependency-types exec \
        --skip-keys "${rosdep_skip_keys}" \
        -y < /tmp/simulation-paths.txt \
    && apt-mark showmanual | sort -u > /tmp/manual-after-exec.txt \
    && comm -13 /tmp/manual-before-exec.txt /tmp/manual-after-exec.txt \
        > /tmp/simulation-runtime-packages.txt \
    && if [ "${TARGETARCH}" = "riscv64" ]; then \
         printf '%s\n' qt6-base-dev qt6-base-private-dev libqt6svg6 \
           >> /tmp/simulation-runtime-packages.txt; \
       fi \
    && sort -u -o /tmp/simulation-runtime-packages.txt \
        /tmp/simulation-runtime-packages.txt

RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        libavcodec-dev \
        libavdevice-dev \
        libavfilter-dev \
        libavformat-dev \
        libavutil-dev \
        libgtest-dev \
        libswresample-dev \
        libswscale-dev \
        libyaml-cpp-dev \
    && export DISABLE_GROUPS_WORKAROUND=1 ROS_OS_OVERRIDE=ubuntu:noble \
    && rosdep_skip_keys="${ROSDEP_SKIP_KEYS}" \
    && if [ "${TARGETARCH}" != "amd64" ]; then \
         rosdep_skip_keys="${rosdep_skip_keys} assimp assimp-dev libassimp-dev"; \
       fi \
    && if [ "${TARGETARCH}" = "riscv64" ]; then \
         rosdep_skip_keys="${rosdep_skip_keys} ${RISCV64_QT_ROSDEP_SKIP_KEYS} glslc libdwarf-dev libpoco-dev libshaderc-dev libzzip-dev ruby"; \
       fi \
    && xargs /opt/simulation-tools/bin/rosdep install \
        --from-paths \
        --ignore-src \
        --rosdistro "${ROS_DISTRO}" \
        --os=ubuntu:noble \
        --dependency-types build \
        --dependency-types buildtool \
        --dependency-types build_export \
        --dependency-types buildtool_export \
        --skip-keys "${rosdep_skip_keys}" \
        -y < /tmp/simulation-paths.txt \
    && rm -rf /var/lib/apt/lists/*

# The Gazebo vendor packages fetch and build Jetty's libraries from their
# pinned release sources. Keeping a merged overlay makes the final image easy
# to compose while retaining ros_base unchanged as the underlay.
RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && export CMAKE_PREFIX_PATH="/opt/poco:/opt/assimp:/opt/simulation-deps:${CMAKE_PREFIX_PATH}" \
    && export LD_LIBRARY_PATH="/opt/assimp/lib64:${LD_LIBRARY_PATH}" \
    && export LDFLAGS="-Wl,-rpath-link,/opt/assimp/lib64 ${LDFLAGS}" \
    && DISABLE_GROUPS_WORKAROUND=1 /opt/simulation-tools/bin/colcon build \
        --merge-install \
        --install-base /opt/ros-simulation/${ROS_DISTRO} \
        --packages-up-to simulation \
        --parallel-workers "${BUILD_JOBS}" \
        --event-handlers console_direct+ \
        --cmake-args \
          -DBUILD_TESTING=OFF \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
          -DTRACETOOLS_DISABLED=ON \
          -Dpybind11_DIR=/opt/ros-python/pybind11/share/cmake/pybind11 \
    && rm -rf src build log


FROM --platform=${TARGETPLATFORM} ${ROS_BASE_IMAGE} AS runtime

ARG ROS_DISTRO=lyrical
ARG TARGETARCH
ARG CFORTRAN_DEB_URL=https://deb.debian.org/debian/pool/main/c/cfortran/cfortran_20210827-1.1_all.deb
ARG CFORTRAN_DEB_SHA256=49e910e074b9865ad045d517e3130ce2d76c569d0ef99e744586d17c3c79b381
ARG RISCV64_ZZIP_DEB_URL=https://deb.debian.org/debian/pool/main/z/zziplib/libzzip-0-13t64_0.13.78+dfsg.1-0.1_riscv64.deb
ARG RISCV64_ZZIP_DEB_SHA256=0849ee85d642fbea544e627fea7ba1729f3d6ad1d691235d25ef5d874c62f04e
ARG RISCV64_LIBRUBY_DEB_URL=https://ports.ubuntu.com/ubuntu-ports/pool/main/r/ruby-defaults/libruby_3.2~ubuntu1_riscv64.deb
ARG RISCV64_LIBRUBY_DEB_SHA256=03648454aabc083bb26f405733ca7b1b7adc1d2064987ff9020cf2b5f1b50bb9
ARG RISCV64_RUBY_DEB_URL=https://ports.ubuntu.com/ubuntu-ports/pool/main/r/ruby-defaults/ruby_3.2~ubuntu1_riscv64.deb
ARG RISCV64_RUBY_DEB_SHA256=e9ce70ffb4437373b806dc057d1b0ed013d88d81f5273d9b1e369cc9b6f5592e
ARG RISCV64_RUBYGEMS_DEB_URL=https://ports.ubuntu.com/ubuntu-ports/pool/main/r/rubygems/ruby-rubygems_3.4.20-1_all.deb
ARG RISCV64_RUBYGEMS_DEB_SHA256=9cb6041d902b74fd6e9373b24922e788bc2d1ed4360705ca6b53945d67b32087
ARG RISCV64_GLSLC_DEB_URL=https://deb.debian.org/debian/pool/main/s/shaderc/glslc_2025.2-1_riscv64.deb
ARG RISCV64_GLSLC_DEB_SHA256=71a7e292d0f0c296190369ff2f123590f95f0609cb337c8e3a0b6d98952a06f7
ARG RISCV64_LIBSHADERC_DEB_URL=https://deb.debian.org/debian/pool/main/s/shaderc/libshaderc1_2025.2-1_riscv64.deb
ARG RISCV64_LIBSHADERC_DEB_SHA256=b355628e960924542174d57a5eb4413b65b5ac192aacc27ab69d4d31ca461dfc
ARG RISCV64_LIBSHADERC_DEV_DEB_URL=https://deb.debian.org/debian/pool/main/s/shaderc/libshaderc-dev_2025.2-1_riscv64.deb
ARG RISCV64_LIBSHADERC_DEV_DEB_SHA256=65e4f3ee22f956138bc34658f640f345acc92a2799de3f9388dcb8dbe48215d6
ARG RISCV64_ZZIP_DEV_DEB_URL=https://deb.debian.org/debian/pool/main/z/zziplib/libzzip-dev_0.13.78+dfsg.1-0.1_riscv64.deb
ARG RISCV64_ZZIP_DEV_DEB_SHA256=acb259a79d01a43d58b9742caa5a118aae62dcfa5951d63b68e1343ff6a9810d

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=${ROS_DISTRO} \
    ROS_VERSION=2 \
    ROS_PYTHON_VERSION=3 \
    PYTHONPATH=/opt/ros-python \
    QT_X11_NO_MITSHM=1 \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp

COPY --from=builder /tmp/simulation-runtime-packages.txt /tmp/simulation-runtime-packages.txt

RUN if [ "${TARGETARCH}" = "amd64" ]; then \
      printf '%s\n' \
        'Package: python3-pkg-resources' \
        'Pin: version 68.1.2-ok2' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-python.pref; \
    else \
      printf '%s\n' \
        'Package: libucx0' \
        'Pin: version 1.16.0+ds-ok1' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-ucx.pref; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -fsSL "${CFORTRAN_DEB_URL}" -o /tmp/cfortran.deb \
    && echo "${CFORTRAN_DEB_SHA256}  /tmp/cfortran.deb" | sha256sum -c - \
    && dpkg -i /tmp/cfortran.deb \
    && rm -f /tmp/cfortran.deb \
    && if [ "${TARGETARCH}" = "riscv64" ]; then \
         curl -fsSL "${RISCV64_ZZIP_DEB_URL}" -o /tmp/libzzip.deb; \
         echo "${RISCV64_ZZIP_DEB_SHA256}  /tmp/libzzip.deb" | sha256sum -c -; \
         dpkg -i /tmp/libzzip.deb; \
         rm -f /tmp/libzzip.deb; \
         curl -fsSL "${RISCV64_LIBRUBY_DEB_URL}" -o /tmp/libruby.deb; \
         curl -fsSL "${RISCV64_RUBY_DEB_URL}" -o /tmp/ruby.deb; \
         curl -fsSL "${RISCV64_RUBYGEMS_DEB_URL}" -o /tmp/ruby-rubygems.deb; \
         curl -fsSL "${RISCV64_GLSLC_DEB_URL}" -o /tmp/glslc.deb; \
         curl -fsSL "${RISCV64_LIBSHADERC_DEB_URL}" -o /tmp/libshaderc1.deb; \
         curl -fsSL "${RISCV64_LIBSHADERC_DEV_DEB_URL}" -o /tmp/libshaderc-dev.deb; \
         curl -fsSL "${RISCV64_ZZIP_DEV_DEB_URL}" -o /tmp/libzzip-dev.deb; \
         echo "${RISCV64_LIBRUBY_DEB_SHA256}  /tmp/libruby.deb" | sha256sum -c -; \
         echo "${RISCV64_RUBY_DEB_SHA256}  /tmp/ruby.deb" | sha256sum -c -; \
         echo "${RISCV64_RUBYGEMS_DEB_SHA256}  /tmp/ruby-rubygems.deb" | sha256sum -c -; \
         echo "${RISCV64_GLSLC_DEB_SHA256}  /tmp/glslc.deb" | sha256sum -c -; \
         echo "${RISCV64_LIBSHADERC_DEB_SHA256}  /tmp/libshaderc1.deb" | sha256sum -c -; \
         echo "${RISCV64_LIBSHADERC_DEV_DEB_SHA256}  /tmp/libshaderc-dev.deb" | sha256sum -c -; \
         echo "${RISCV64_ZZIP_DEV_DEB_SHA256}  /tmp/libzzip-dev.deb" | sha256sum -c -; \
         apt-get install -y --no-install-recommends \
           /tmp/libruby.deb /tmp/ruby.deb /tmp/ruby-rubygems.deb \
           /tmp/glslc.deb /tmp/libshaderc1.deb /tmp/libshaderc-dev.deb \
           /tmp/libzzip-dev.deb; \
         rm -f /tmp/libruby.deb /tmp/ruby.deb /tmp/ruby-rubygems.deb \
           /tmp/glslc.deb /tmp/libshaderc1.deb /tmp/libshaderc-dev.deb \
           /tmp/libzzip-dev.deb; \
         ruby --version; \
         glslc --version; \
       fi \
    && xargs -r apt-get install -y --no-install-recommends \
        < /tmp/simulation-runtime-packages.txt \
    && apt-get install -y --no-install-recommends \
        libavcodec62 \
        libavdevice62 \
        libavfilter11 \
        libavformat62 \
        libavutil60 \
        libswresample6 \
        libswscale9 \
    && rm -rf /var/lib/apt/lists/* \
        /tmp/simulation-runtime-packages.txt

COPY --from=builder /opt/ros-simulation/${ROS_DISTRO} /opt/ros-simulation/${ROS_DISTRO}
COPY --from=builder /opt/simulation-deps /opt/simulation-deps
COPY --from=builder /opt/assimp /opt/assimp
COPY --from=builder /opt/poco /opt/poco
COPY --from=builder /opt/qt6-riscv-root/ /
COPY ros_entrypoint.sh /ros_entrypoint.sh

RUN printf '%s\n' /opt/assimp/lib /opt/assimp/lib64 \
        > /etc/ld.so.conf.d/assimp.conf \
    && printf '%s\n' /opt/simulation-deps/lib /opt/simulation-deps/lib64 \
        > /etc/ld.so.conf.d/simulation-deps.conf \
    && printf '%s\n' /opt/poco/lib > /etc/ld.so.conf.d/poco.conf \
    && chmod 0755 /ros_entrypoint.sh \
    && ldconfig

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
