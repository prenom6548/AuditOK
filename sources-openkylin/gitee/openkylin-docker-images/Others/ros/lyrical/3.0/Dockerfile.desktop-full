# syntax=docker/dockerfile:1.7

# Complete ROS 2 Lyrical desktop_full on openKylin 3.0.
# Platforms: linux/amd64, linux/arm64, linux/riscv64.
# Build/export all platforms: docker buildx build --platform linux/amd64,linux/arm64,linux/riscv64 -f Dockerfile.lyrical-desktop-full-ok30 -t openkylin/ros:lyrical-desktop-full --output type=oci,dest=lyrical-desktop-full.oci.tar .
# Use build_lyrical_desktop_full.sh per platform for checkpointed builds and runtime validation.
# Chain: openKylin -> ros_base -> desktop + perception -> desktop_full.
# Adapted from this project's Base, Desktop, Perception and Simulation recipes.
# No prebuilt openkylin/ros image is required. Preserve the base APT sources.
# Validate builds and runtime on each target architecture before release.

ARG OPENKYLIN_IMAGE=openkylin/openkylin:3.0

FROM --platform=${BUILDPLATFORM} tonistiigi/binfmt@sha256:400a4873b838d1b89194d982c45e5fb3cda4593fbfd7e08a02e76b03b21166f0 AS cmake-emulator

FROM --platform=${TARGETPLATFORM} ${OPENKYLIN_IMAGE} AS base-deps

SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

ARG ROS_DISTRO=lyrical
ARG ROS2_REPOS_REF=release-lyrical-20260522
ARG ROS_VARIANTS_REF=0.13.0
ARG FZF_VERSION=0.74.1
ARG BULLET_VERSION=3.24
ARG OROCOS_KDL_VERSION=1.5.1
ARG PYKDL_PYBIND11_VERSION=2.13.6
ARG BUILD_JOBS=2
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=${ROS_DISTRO} \
    CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS} \
    MAKEFLAGS="-j${BUILD_JOBS}" \
    CMAKE_POLICY_VERSION_MINIMUM=3.5 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PATH=/opt/ros-tools/bin:${PATH}

# The published 3.0 image already contains a few core packages from
# huanghe-proposed (notably the t64 ABI transition). Keep both repositories
# enabled so apt can select a self-consistent dependency set. The amd64
# proposed index currently advertises python3-pkg-resources 78 without its
# python3-autocommand dependency, so pin the complete main-repository build.
RUN if [ "${TARGETARCH}" = "amd64" ]; then \
      printf '%s\n' \
        'Package: python3-pkg-resources' \
        'Pin: version 68.1.2-ok2' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-python.pref; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        libacl1-dev \
        libcurl4-openssl-dev \
        libeigen3-dev \
        libgtest-dev \
        libsqlite3-dev \
        libssl-dev \
        libtinyxml2-dev \
        libxml2-dev \
        libxslt1-dev \
        libyaml-cpp-dev \
        libyaml-dev \
        make \
        ninja-build \
        patch \
        pkg-config \
        python3 \
        python3-cryptography \
        python3-dev \
        python3-netifaces \
        python3-numpy \
        python3-pip \
        python3-psutil \
        python3-venv \
        python3-yaml \
        unzip \
        wget \
    && rm -rf /var/lib/apt/lists/*

# openKylin 3.0 does not package the complete ROS development toolchain.
# Keep build-only Python tools isolated from the runtime interpreter.
RUN python3 -m venv --system-site-packages /opt/ros-tools \
    && /opt/ros-tools/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    && /opt/ros-tools/bin/pip install --no-cache-dir \
        catkin-pkg \
        colcon-common-extensions \
        empy==4.2 \
        lark \
        rosdep \
        vcstool

# Standalone Asio is header-only. openKylin 3.0 does not publish libasio-dev
# consistently across all targets, so install the upstream headers explicitly.
RUN git clone --depth 1 --branch asio-1-30-2 \
        https://github.com/chriskohlhoff/asio.git /tmp/asio \
    && cp -a /tmp/asio/asio/include/. /usr/local/include/ \
    && rm -rf /tmp/asio

# ros_base adds tf2's Bullet conversions. openKylin 3.0 does not publish the
# Ubuntu-compatible libbullet-dev package, so build the Noble-equivalent 3.24
# release once and carry only its shared libraries into the runtime image.
RUN git clone --depth 1 --branch "${BULLET_VERSION}" \
        https://github.com/bulletphysics/bullet3.git /tmp/bullet3 \
    && cmake -S /tmp/bullet3 -B /tmp/bullet3/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_BULLET2_DEMOS=OFF \
        -DBUILD_BULLET3=OFF \
        -DBUILD_CPU_DEMOS=OFF \
        -DBUILD_EXTRAS=OFF \
        -DBUILD_OPENGL3_DEMOS=OFF \
        -DBUILD_UNIT_TESTS=OFF \
        -DINSTALL_LIBS=ON \
        -DUSE_GRAPHICAL_BENCHMARK=OFF \
    && cmake --build /tmp/bullet3/build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/bullet3/build \
    && rm -rf /tmp/bullet3

# tf2 also depends on Orocos KDL, whose Ubuntu development package is absent
# from openKylin. Build the same stable ABI from its upstream release tag.
RUN git clone --depth 1 --branch "v${OROCOS_KDL_VERSION}" \
        --recurse-submodules --shallow-submodules \
        https://github.com/orocos/orocos_kinematics_dynamics.git /tmp/orocos-kdl \
    && git -C /tmp/orocos-kdl/python_orocos_kdl/pybind11 fetch \
        --depth 1 origin "v${PYKDL_PYBIND11_VERSION}" \
    && git -C /tmp/orocos-kdl/python_orocos_kdl/pybind11 checkout \
        FETCH_HEAD \
    && cmake -S /tmp/orocos-kdl/orocos_kdl -B /tmp/orocos-kdl/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DBUILD_MODELS=OFF \
        -DENABLE_TESTS=OFF \
    && cmake --build /tmp/orocos-kdl/build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/orocos-kdl/build \
    && ROS_PYTHON_VERSION=3 cmake \
        -S /tmp/orocos-kdl/python_orocos_kdl \
        -B /tmp/orocos-kdl/python-build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DPYTHON_EXECUTABLE=/usr/bin/python3 \
    && cmake --build /tmp/orocos-kdl/python-build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/orocos-kdl/python-build \
    && rm -rf /tmp/orocos-kdl

# rosbag2 compression needs LZ4. openKylin publishes the runtime library but
# not a consistent development package on every target, so build the Noble
# version as a shared library and copy it into the runtime stage.
RUN git clone --depth 1 --branch v1.9.4 \
        https://github.com/lz4/lz4.git /tmp/lz4 \
    && cmake -S /tmp/lz4/build/cmake -B /tmp/lz4/cmake-build -G Ninja \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DBUILD_SHARED_LIBS=ON \
        -DLZ4_BUILD_CLI=OFF \
        -DLZ4_BUILD_LEGACY_LZ4C=OFF \
    && cmake --build /tmp/lz4/cmake-build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/lz4/cmake-build \
    && rm -rf /tmp/lz4

# ros2cli uses fzf for interactive selection. Install the matching official
# binary for every target architecture and verify it before extraction.
RUN case "${TARGETARCH}" in \
        amd64) FZF_SHA256="df53438be5f51e151bb4044d78fda72bdfe209e3ecd2baecae48e8dea370c81b" ;; \
        arm64) FZF_SHA256="f22204dd1a091d43e102268d062fd53b47133c8d8581671ee5eb225b75e31183" ;; \
        riscv64) FZF_SHA256="a647e12d907c650d963b5a4b5887bcba0307578a68deb37917142903a1c217d6" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
      esac \
    && curl -fsSL \
        "https://github.com/junegunn/fzf/releases/download/v${FZF_VERSION}/fzf-${FZF_VERSION}-linux_${TARGETARCH}.tar.gz" \
        -o /tmp/fzf.tar.gz \
    && echo "${FZF_SHA256}  /tmp/fzf.tar.gz" \
        | sha256sum -c - \
    && tar -xzf /tmp/fzf.tar.gz -C /usr/local/bin fzf \
    && chmod 0755 /usr/local/bin/fzf \
    && rm -f /tmp/fzf.tar.gz

WORKDIR /ros2_ws

# Use the source manifest attached to the first stable Lyrical release and add
# the variant metapackage, which is not included in ros2.repos itself. Mimick,
# performance_test_fixture, osrf_testing_tools_cpp, and the uncrustify wrappers
# are referenced only by test/lint dependencies. Mimick has no RISC-V
# trampoline implementation, while the vendor uncrustify configure binary can
# also select instructions unavailable in the Buildx RISC-V emulator.
RUN curl -fsSL \
        "https://raw.githubusercontent.com/ros2/ros2/${ROS2_REPOS_REF}/ros2.repos" \
        -o /tmp/ros2.repos \
    && mkdir -p src \
    && vcs import --shallow src < /tmp/ros2.repos \
    && git clone --depth 1 --branch "${ROS_VARIANTS_REF}" \
        https://github.com/ros2/variants.git src/ros2/variants \
    && touch src/ros2/rmw_connextdds/COLCON_IGNORE \
    && touch src/ros2/rmw_cyclonedds/COLCON_IGNORE \
    && touch src/ros2/rmw_zenoh/COLCON_IGNORE \
    && touch src/ros2/mimick_vendor/COLCON_IGNORE \
    && touch src/ros2/performance_test_fixture/COLCON_IGNORE \
    && touch src/osrf/osrf_testing_tools_cpp/COLCON_IGNORE \
    && touch src/ament/ament_lint/ament_uncrustify/COLCON_IGNORE \
    && touch src/ament/uncrustify_vendor/COLCON_IGNORE \
    && rm -f /tmp/ros2.repos

# rosdep is told to use Ubuntu Noble mappings because openKylin is not a
# recognized rosdep OS. Most huanghe package names follow those mappings. The
# skipped keys are either installed with pip, supplied above, or built by ROS
# vendor packages from the imported source tree.
RUN pip install --no-cache-dir \
        flake8 \
        flake8-blind-except \
        flake8-builtins \
        flake8-class-newline \
        flake8-comprehensions \
        flake8-deprecated \
        flake8-import-order \
        flake8-quotes \
        lxml \
        osrf-pycommon \
        pybind11 \
        pydocstyle \
        pydot \
        typing-extensions

RUN export DISABLE_GROUPS_WORKAROUND=1 ROS_OS_OVERRIDE=ubuntu:noble \
    && rosdep init \
    && rosdep update --rosdistro "${ROS_DISTRO}" \
    && apt-get update \
    && BASE_PATHS="$(colcon list --packages-up-to ros_base --paths-only | tr '\n' ' ')" \
    && rosdep install --from-paths ${BASE_PATHS} \
        --ignore-src \
        --rosdistro "${ROS_DISTRO}" \
        --os=ubuntu:noble \
        --dependency-types build \
        --dependency-types buildtool \
        --dependency-types build_export \
        --dependency-types buildtool_export \
        --dependency-types exec \
        --skip-keys "libpcl-dev libpcl-features libpcl-features1.14 libpcl-filters libpcl-filters1.14 libpcl-segmentation libpcl-segmentation1.14 libpcl-surface libpcl-surface1.14 ament_uncrustify asio benchmark bullet clang-format console_bridge cppcheck fmt fzf gmock libbenchmark-dev libbullet-dev libconsole-bridge-dev libfmt-dev libgmock-dev liblttng-ust-dev liblz4-dev liborocos-kdl liborocos-kdl-dev liborocos-kdl1.5 libspdlog-dev libxml2-utils lttng-tools lttng-ust pybind11 pybind11-dev pydocstyle spdlog uncrustify python3-argcomplete python3-catkin-pkg python3-catkin-pkg-modules python3-colcon-common-extensions python3-empy python3-flake8 python3-flake8-blind-except python3-flake8-builtins python3-flake8-class-newline python3-flake8-comprehensions python3-flake8-deprecated python3-flake8-import-order python3-flake8-quotes python3-lark-parser python3-lxml python3-mypy python3-osrf-pycommon python3-pycodestyle python3-pydot python3-pyflakes python3-pykdl python3-pytest python3-rosdep python3-rosdistro python3-rosdistro-modules python3-rospkg python3-rospkg-modules python3-setuptools python3-typing-extensions python3-vcstool" \
        -y

FROM base-deps AS base-builder

COPY export_ros_sources.py /tmp/export_ros_sources.py

ARG TARGETARCH

COPY --from=cmake-emulator /usr/bin/qemu-riscv64 /usr/local/libexec/qemu-riscv64-cmake
COPY cmake_lyrical_desktop_full_riscv.sh /tmp/cmake_riscv_qemu.sh
RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      mv /usr/bin/cmake /usr/bin/cmake.real \
      && install -m 0755 /tmp/cmake_riscv_qemu.sh /usr/bin/cmake \
      && /usr/bin/cmake --version; \
    fi

# Build from clean stage-local directories. Persisting colcon's build/install
# trees across BuildKit runs can leak removed packages into the final prefix.
RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      export CMAKE_BUILD_PARALLEL_LEVEL="${BUILD_JOBS}"; \
      export MAKEFLAGS="-j${BUILD_JOBS} -l${BUILD_JOBS}"; \
    fi \
    && DISABLE_GROUPS_WORKAROUND=1 colcon build \
        --merge-install \
        --install-base /opt/ros/${ROS_DISTRO} \
        --packages-up-to ros_base \
        --parallel-workers "${BUILD_JOBS}" \
        --event-handlers console_direct+ \
        --cmake-args \
          -DBUILD_TESTING=OFF \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
          -DTRACETOOLS_DISABLED=ON \
          -Dpybind11_DIR=/opt/ros-tools/lib/python3.12/site-packages/pybind11/share/cmake/pybind11 \
    && mkdir -p /opt/ros/${ROS_DISTRO}/share/desktop-full-build \
    && /opt/ros-tools/bin/colcon list --packages-up-to ros_base --names-only > /opt/ros/${ROS_DISTRO}/share/desktop-full-build/packages.txt \
    && python3 /tmp/export_ros_sources.py src /opt/ros/${ROS_DISTRO}/share/desktop-full-build/sources.repos \
    && mkdir -p /opt/ros-staged \
    && cp -a /opt/ros/${ROS_DISTRO} /opt/ros-staged/${ROS_DISTRO} \
    && rm -rf src


FROM --platform=${TARGETPLATFORM} ${OPENKYLIN_IMAGE} AS base-runtime

SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

ARG ROS_DISTRO=lyrical
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=${ROS_DISTRO} \
    ROS_VERSION=2 \
    ROS_PYTHON_VERSION=3 \
    PYTHONPATH=/opt/ros-python \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp

RUN if [ "${TARGETARCH}" = "amd64" ]; then \
      printf '%s\n' \
        'Package: python3-pkg-resources' \
        'Pin: version 68.1.2-ok2' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-python.pref; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        graphviz \
        libacl1 \
        libcurl4t64 \
        libgcc-s1 \
        libpython3.12t64 \
        libsqlite3-0 \
        libssl3t64 \
        libstdc++6 \
        libtinyxml2-10 \
        libyaml-0-2 \
        libyaml-cpp0.8 \
        python3 \
        python3-cryptography \
        python3-netifaces \
        python3-numpy \
        python3-packaging \
        python3-psutil \
        python3-yaml \
    && rm -rf /var/lib/apt/lists/*

COPY --from=base-builder /opt/ros-staged/${ROS_DISTRO} /opt/ros/${ROS_DISTRO}
COPY --from=base-builder /opt/ros-tools/lib/python3.12/site-packages /opt/ros-python
COPY --from=base-builder /usr/local/lib/libBullet*.so* /usr/local/lib/
COPY --from=base-builder /usr/local/lib/libLinearMath.so* /usr/local/lib/
COPY --from=base-builder /usr/local/lib/liblz4.so* /usr/local/lib/
COPY --from=base-builder /usr/local/lib/liborocos-kdl.so* /usr/local/lib/
COPY --from=base-builder /usr/local/lib/python3.12/dist-packages/PyKDL*.so /opt/ros-python/
COPY sitecustomize.py /opt/ros-python/sitecustomize.py
COPY --from=base-builder /usr/local/bin/fzf /usr/local/bin/fzf
COPY ros_entrypoint.sh /ros_entrypoint.sh

# Python console scripts generated during the source build retain the venv's
# absolute shebang.  The runtime uses the ABI-compatible system Python, so keep
# that build-time path as a lightweight compatibility link.
RUN mkdir -p /opt/ros-tools/bin \
    && ln -s /usr/bin/python3 /opt/ros-tools/bin/python3 \
    && ldconfig \
    && chmod 0755 /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]

FROM base-runtime AS desktop-builder

COPY export_ros_sources.py /tmp/export_ros_sources.py

ARG ROS_DISTRO=lyrical
ARG ROS_VARIANTS_REF=0.13.0
ARG OROCOS_KDL_VERSION=1.5.1
ARG PCL_REF=pcl-1.14.0
ARG BUILD_JOBS=2
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=${ROS_DISTRO} \
    CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS} \
    MAKEFLAGS="-j${BUILD_JOBS}" \
    CMAKE_POLICY_VERSION_MINIMUM=3.5 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONPATH=/opt/ros-python \
    PATH=/opt/desktop-tools/bin:${PATH}

# Install only the compiler and source-management tools here. Desktop's
# external runtime and build dependencies are resolved separately below so
# the runtime package set can be reproduced in the final stage.
RUN if [ "${TARGETARCH}" = "amd64" ]; then \
      printf '%s\n' \
        'Package: python3-pkg-resources' \
        'Pin: version 68.1.2-ok2' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-python.pref; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        make \
        ninja-build \
        patch \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        python3-yaml \
        unzip \
        wget \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv --system-site-packages /opt/desktop-tools \
    && PYTHONPATH= /opt/desktop-tools/bin/pip install --no-cache-dir --upgrade \
        pip setuptools wheel \
    && PYTHONPATH= /opt/desktop-tools/bin/pip install --no-cache-dir \
        catkin-pkg \
        colcon-common-extensions \
        empy==4.2 \
        lark \
        rosdep \
        rosinstall-generator \
        vcstool

COPY --from=cmake-emulator /usr/bin/qemu-riscv64 /usr/local/libexec/qemu-riscv64-cmake
COPY cmake_lyrical_desktop_full_riscv.sh /tmp/cmake_riscv_qemu.sh
RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      mv /usr/bin/cmake /usr/bin/cmake.real \
      && install -m 0755 /tmp/cmake_riscv_qemu.sh /usr/bin/cmake; \
    fi

WORKDIR /desktop_ws

# Generate the released Lyrical closure for desktop and perception, excluding
# every package already present in the ros_base underlay. This also covers
# desktop repositories which are intentionally absent from ros2/ros2.repos,
# including rqt_common_plugins and teleop_twist_keyboard.
RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && ros2 pkg list | sort -u > /tmp/base-packages.txt \
    && /opt/desktop-tools/bin/rosinstall_generator desktop perception \
        --rosdistro "${ROS_DISTRO}" \
        --deps \
        --deps-only \
        --format repos \
        --upstream \
        --exclude $(cat /tmp/base-packages.txt) \
        > /tmp/desktop.repos \
    && mkdir -p src \
    && /opt/desktop-tools/bin/vcs import --shallow src < /tmp/desktop.repos \
    && git clone --depth 1 --branch "${ROS_VARIANTS_REF}" \
        https://github.com/ros2/variants.git src/ros2/variants \
    && for package in $(cat /tmp/base-packages.txt); do \
         if [ -d "src/ros2/variants/${package}" ]; then \
           touch "src/ros2/variants/${package}/COLCON_IGNORE"; \
         fi; \
       done \
    && rm -f /tmp/desktop.repos

# openKylin provides the PyQt5 half of Ubuntu Noble's python3-qt-bindings
# mapping but not PySide2. Install the equivalent supported provider directly.
RUN if [ "${TARGETARCH}" != "amd64" ]; then \
      printf '%s\n' \
        'Package: libucx0' \
        'Pin: version 1.16.0+ds-ok1' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-ucx.pref; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        graphviz \
        libgraphviz-dev \
        libopencv-dev \
        libqt5opengl5 \
        libqt5opengl5-dev \
        libqt5widgets5 \
        pyqt5-dev \
        python3-pyqt5 \
        python3-pyqt5.qtsvg \
        python3-pyqtbuild \
        python3-pkg-resources \
        python3-setuptools \
        python3-sip-dev \
        python3-sipbuild \
        qtbase5-dev \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/desktop-python \
    && if [ "${TARGETARCH}" = "riscv64" ]; then \
         graphviz_multiarch="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"; \
         graphviz_libdir="/usr/lib/${graphviz_multiarch}/graphviz"; \
         git clone --depth 1 --branch pygraphviz-2.0.1 \
           https://github.com/pygraphviz/pygraphviz.git /tmp/pygraphviz; \
         sed -i \
           -e '/"gvplugin_neato_layout",/d' \
           -e 's/libraries.append("gvplugin_gd")/pass/' \
           -e '/libraries.append("gvplugin_pango")/d' \
           /tmp/pygraphviz/setup.py; \
         LDFLAGS="-L${graphviz_libdir} -Wl,-rpath,${graphviz_libdir}" \
           PYTHONPATH= /opt/desktop-tools/bin/pip install -v --no-cache-dir \
             --target /opt/desktop-python /tmp/pygraphviz \
         && rm -rf /tmp/pygraphviz; \
       else \
         PYTHONPATH= /opt/desktop-tools/bin/pip install -v --no-cache-dir \
           --target /opt/desktop-python pygraphviz; \
       fi

ARG FLANN_REF=1.9.2
# openKylin currently has no PCL binary packages. Build the PCL components
# required by pcl_ros while keeping visualization and hardware backends off.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libboost-filesystem-dev \
        libboost-iostreams-dev \
        libboost-serialization-dev \
        libboost-system-dev \
        libboost-thread-dev \
        libeigen3-dev \
        liblz4-dev \
        libopencv-dev \
        libyaml-cpp-dev \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${FLANN_REF}" \
        https://github.com/flann-lib/flann.git /tmp/flann-src \
    && cmake -S /tmp/flann-src -B /tmp/flann-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/flann \
        -DBUILD_C_BINDINGS=OFF \
        -DBUILD_CUDA_LIB=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_MATLAB_BINDINGS=OFF \
        -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_TESTS=OFF \
    && cmake --build /tmp/flann-build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/flann-build \
    && rm -rf /tmp/flann-src /tmp/flann-build

RUN \
    if [ ! -d /tmp/pcl-cache/src/.git ]; then \
        git clone --depth 1 --branch "${PCL_REF}" \
            https://github.com/PointCloudLibrary/pcl.git /tmp/pcl-cache/src; \
    fi \
    && git -C /tmp/pcl-cache/src reset --hard "${PCL_REF}" \
    && git -C /tmp/pcl-cache/src clean -fdx \
    && sed -i \
        -e 's/this->offset\[i\] = node.offset\[i\]/this->off[i] = node.off[i]/' \
        /tmp/pcl-cache/src/surface/include/pcl/surface/3rdparty/poisson4/octree_poisson.hpp \
    && sed -i \
        -e 's/Resize(this->m_N, this->m_M)/Resize(this->rows, this->_maxEntriesPerRow)/' \
        -e 's/Min( this->Rows(), this->Columns() )/(this->rows < this->_maxEntriesPerRow ? this->rows : this->_maxEntriesPerRow)/' \
        -e 's/M.Columns()/bb.Dimensions()/' \
        /tmp/pcl-cache/src/surface/include/pcl/surface/3rdparty/poisson4/sparse_matrix.hpp \
    && cmake -S /tmp/pcl-cache/src -B /tmp/pcl-cache/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/pcl \
        -DCMAKE_PREFIX_PATH=/opt/flann \
        -DFLANN_DIR=/opt/flann/lib/cmake/flann \
        -DPCL_ENABLE_AVX=OFF \
        -DPCL_ENABLE_SSE=OFF \
        -DPCL_ONLY_CORE_POINT_TYPES=ON \
        -DBUILD_2d=ON \
        -DBUILD_apps=OFF \
        -DBUILD_common=ON \
        -DBUILD_examples=OFF \
        -DBUILD_features=ON \
        -DBUILD_filters=ON \
        -DBUILD_global_tests=OFF \
        -DBUILD_io=ON \
        -DBUILD_kdtree=ON \
        -DBUILD_ml=ON \
        -DBUILD_octree=ON \
        -DBUILD_keypoints=OFF \
        -DBUILD_recognition=OFF \
        -DBUILD_registration=OFF \
        -DBUILD_sample_consensus=ON \
        -DBUILD_search=ON \
        -DBUILD_segmentation=ON \
        -DBUILD_stereo=OFF \
        -DBUILD_surface=ON \
        -DBUILD_tools=OFF \
        -DBUILD_tracking=OFF \
        -DBUILD_visualization=OFF \
        -DWITH_CUDA=OFF \
        -DWITH_LIBUSB=OFF \
        -DWITH_OPENGL=OFF \
        -DWITH_OPENNI=OFF \
        -DWITH_OPENNI2=OFF \
        -DWITH_PCAP=OFF \
        -DWITH_QHULL=OFF \
        -DWITH_VTK=OFF \
    && cmake --build /tmp/pcl-cache/build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/pcl-cache/build \
    && rm -rf /tmp/pcl-cache

# The arm64/riscv64 libassimp-dev package in openKylin currently depends on
# an unpublished libdraco8 binary. Build the same Assimp release portably so
# mesh loading remains available on every target architecture.
ARG ASSIMP_VERSION=6.0.4
RUN git clone --depth 1 --branch "v${ASSIMP_VERSION}" \
        https://github.com/assimp/assimp.git /tmp/assimp-src \
    && cmake -S /tmp/assimp-src -B /tmp/assimp-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/assimp \
        -DBUILD_SHARED_LIBS=ON \
        -DASSIMP_BUILD_ASSIMP_TOOLS=OFF \
        -DASSIMP_BUILD_SAMPLES=OFF \
        -DASSIMP_BUILD_TESTS=OFF \
        -DASSIMP_WARNINGS_AS_ERRORS=OFF \
    && cmake --build /tmp/assimp-build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/assimp-build \
    && rm -rf /tmp/assimp-src /tmp/assimp-build

# openKylin currently has no python3-matplotlib candidate on arm64/riscv64.
# Keep the portable Python desktop stack in the existing overlay instead;
# PyPI provides wheels where available and builds the small native modules on
# architectures without wheels.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3-cycler \
        python3-dateutil \
        python3-pil \
        python3-pyparsing \
    && if [ "${TARGETARCH}" = "riscv64" ]; then \
         apt-get install -y --no-install-recommends \
           libfreetype-dev libpng-dev meson python3-mesonpy; \
         PYTHONPATH= /opt/desktop-tools/bin/pip install --no-cache-dir \
           certifi cppy meson-python packaging setuptools-scm; \
         PYTHONPATH= /opt/desktop-tools/bin/pip install --no-cache-dir \
           --ignore-installed pybind11; \
         PYTHONPATH= /opt/desktop-tools/bin/pip install --no-cache-dir \
           --no-deps --no-build-isolation --target /opt/desktop-python \
           kiwisolver==1.4.9 contourpy==1.3.3; \
         PYTHONPATH= /opt/desktop-tools/bin/pip install --no-cache-dir \
           --no-deps --no-build-isolation --target /opt/desktop-python \
           fonttools pydantic==1.10.24; \
         PYTHONPATH=/opt/desktop-python /opt/desktop-tools/bin/pip install --no-cache-dir \
           --no-deps --no-build-isolation --target /opt/desktop-python \
           matplotlib==3.9.4; \
       else \
         SKIP_CYTHON=1 PYTHONPATH= /opt/desktop-tools/bin/pip install --no-cache-dir --upgrade \
           --target /opt/desktop-python \
           fonttools matplotlib==3.8.4 pydantic==1.10.24; \
       fi \
    && rm -rf /var/lib/apt/lists/*

# Resolve external execution dependencies first and record their top-level APT
# packages. Installing that list in the runtime stage lets APT reconstruct the
# complete shared-library dependency set without copying the compiler toolchain.
RUN export DISABLE_GROUPS_WORKAROUND=1 ROS_OS_OVERRIDE=ubuntu:noble \
    && . /opt/ros/${ROS_DISTRO}/setup.sh \
    && mkdir -p /etc/ros/rosdep/sources.list.d \
    && printf '%s\n' \
        'libopencv-contrib-dev:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-core:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-core-dev:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-dev:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-highgui:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-imgcodecs:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-imgcodecs-dev:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-imgproc:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-imgproc-dev:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-videoio:' \
        '  ubuntu: [libopencv-dev]' \
        > /etc/ros/rosdep/openkylin-desktop.yaml \
    && printf '%s\n' \
        'yaml file:///etc/ros/rosdep/openkylin-desktop.yaml' \
        > /etc/ros/rosdep/sources.list.d/10-openkylin-desktop.list \
    && if [ ! -e /etc/ros/rosdep/sources.list.d/20-default.list ]; then \
         /opt/desktop-tools/bin/rosdep init; \
       fi \
    && /opt/desktop-tools/bin/rosdep update --rosdistro "${ROS_DISTRO}" \
    && /opt/desktop-tools/bin/colcon list \
        --packages-up-to desktop perception \
        --paths-only \
        | sort -u > /tmp/desktop-paths.txt \
    && apt-mark showmanual | sort -u > /tmp/manual-before-exec.txt \
    && apt-get update \
    && xargs /opt/desktop-tools/bin/rosdep install \
        --from-paths \
        --ignore-src \
        --rosdistro "${ROS_DISTRO}" \
        --os=ubuntu:noble \
        --dependency-types exec \
        --skip-keys "libpcl-dev libpcl-features libpcl-features1.14 libpcl-filters libpcl-filters1.14 libpcl-segmentation libpcl-segmentation1.14 libpcl-surface libpcl-surface1.14 ament_uncrustify asio assimp assimp-dev benchmark bullet clang-format console_bridge cppcheck fmt fzf gmock libassimp-dev libbenchmark-dev libbullet-dev libconsole-bridge-dev libfmt-dev libgmock-dev liblttng-ust-dev liblz4-dev libopencv-core406t64 libopencv-imgcodecs406t64 libopencv-imgproc406t64 liborocos-kdl liborocos-kdl-dev liborocos-kdl1.5 libpcl-all-dev libpcl-common libpcl-common1.14 libpcl-io libpcl-io1.14 libqt5-concurrent libqt5-core libqt5-gui libqt5-network libqt5-opengl libqt5-opengl-dev libqt5-printsupport libqt5-sql libqt5-test libqt5-widgets libqt5-xml libqt5core5t64 libqt5gui5t64 libqt5network5t64 libqt5opengl5t64 libqt5printsupport5t64 libqt5sql5t64 libqt5test5t64 libqt5widgets5t64 libqt5xml5t64 libqtconcurrent libqtcore libqtgui libqtopengl libqtwidgets libspdlog-dev libxml2-utils lttng-tools lttng-ust pybind11 pybind11-dev pydocstyle spdlog uncrustify python3-argcomplete python3-catkin-pkg python3-catkin-pkg-modules python3-colcon-common-extensions python3-empy python3-flake8 python3-flake8-blind-except python3-flake8-builtins python3-flake8-class-newline python3-flake8-comprehensions python3-flake8-deprecated python3-flake8-import-order python3-flake8-quotes python3-lark-parser python3-lxml python3-matplotlib python3-mypy python3-osrf-pycommon python3-pycodestyle python3-pydantic python3-pydot python3-pyflakes python3-pygraphviz python3-pykdl python3-pytest python3-qt-bindings python3-rosdep python3-rosdistro python3-rosdistro-modules python3-rospkg python3-rospkg-modules python3-setuptools python3-typing-extensions python3-vcstool" \
        -y < /tmp/desktop-paths.txt \
    && apt-mark showmanual | sort -u > /tmp/manual-after-exec.txt \
    && comm -13 /tmp/manual-before-exec.txt /tmp/manual-after-exec.txt \
        > /tmp/desktop-runtime-packages.txt

# Install build and build-export dependencies after the runtime package list
# has been captured. Ubuntu Noble rosdep mappings match openKylin huanghe and
# its anything3.0 repository for the desktop stack.
RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && apt-get update \
    && apt-get install -y --no-install-recommends libgtest-dev libyaml-cpp-dev \
    && export DISABLE_GROUPS_WORKAROUND=1 ROS_OS_OVERRIDE=ubuntu:noble \
    && xargs /opt/desktop-tools/bin/rosdep install \
        --from-paths \
        --ignore-src \
        --rosdistro "${ROS_DISTRO}" \
        --os=ubuntu:noble \
        --dependency-types build \
        --dependency-types buildtool \
        --dependency-types build_export \
        --dependency-types buildtool_export \
        --skip-keys "libpcl-dev libpcl-features libpcl-features1.14 libpcl-filters libpcl-filters1.14 libpcl-segmentation libpcl-segmentation1.14 libpcl-surface libpcl-surface1.14 ament_uncrustify asio assimp assimp-dev benchmark bullet clang-format console_bridge cppcheck fmt fzf gmock libassimp-dev libbenchmark-dev libbullet-dev libconsole-bridge-dev libfmt-dev libgmock-dev liblttng-ust-dev liblz4-dev libopencv-core406t64 libopencv-imgcodecs406t64 libopencv-imgproc406t64 liborocos-kdl liborocos-kdl-dev liborocos-kdl1.5 libpcl-all-dev libpcl-common libpcl-common1.14 libpcl-io libpcl-io1.14 libqt5-concurrent libqt5-core libqt5-gui libqt5-network libqt5-opengl libqt5-opengl-dev libqt5-printsupport libqt5-sql libqt5-test libqt5-widgets libqt5-xml libqt5core5t64 libqt5gui5t64 libqt5network5t64 libqt5opengl5t64 libqt5printsupport5t64 libqt5sql5t64 libqt5test5t64 libqt5widgets5t64 libqt5xml5t64 libqtconcurrent libqtcore libqtgui libqtopengl libqtwidgets libspdlog-dev libxml2-utils lttng-tools lttng-ust pybind11 pybind11-dev pydocstyle spdlog uncrustify python3-argcomplete python3-catkin-pkg python3-catkin-pkg-modules python3-colcon-common-extensions python3-empy python3-flake8 python3-flake8-blind-except python3-flake8-builtins python3-flake8-class-newline python3-flake8-comprehensions python3-flake8-deprecated python3-flake8-import-order python3-flake8-quotes python3-lark-parser python3-lxml python3-matplotlib python3-mypy python3-osrf-pycommon python3-pycodestyle python3-pydantic python3-pydot python3-pyflakes python3-pygraphviz python3-pykdl python3-pytest python3-qt-bindings python3-rosdep python3-rosdistro python3-rosdistro-modules python3-rospkg python3-rospkg-modules python3-setuptools python3-typing-extensions python3-vcstool" \
        -y < /tmp/desktop-paths.txt \
    && git clone --depth 1 --branch "v${OROCOS_KDL_VERSION}" \
        https://github.com/orocos/orocos_kinematics_dynamics.git \
        /tmp/orocos-kdl \
    && cmake -S /tmp/orocos-kdl/orocos_kdl \
        -B /tmp/orocos-kdl/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/orocos-kdl \
        -DBUILD_MODELS=OFF \
        -DENABLE_TESTS=OFF \
    && cmake --build /tmp/orocos-kdl/build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/orocos-kdl/build \
    && rm -rf /tmp/orocos-kdl \
    && rm -rf /var/lib/apt/lists/*

# Keep desktop as an overlay. Its generated setup file records the ros_base
# underlay at /opt/ros/lyrical, which is identical in the final image.
RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && export CMAKE_PREFIX_PATH="/opt/flann:/opt/orocos-kdl:/opt/assimp:/opt/pcl:${CMAKE_PREFIX_PATH}" \
    && export CPATH="/opt/orocos-kdl/include:${CPATH}" \
    && export LD_LIBRARY_PATH="/opt/assimp/lib64:${LD_LIBRARY_PATH}" \
    && export LDFLAGS="-Wl,-rpath-link,/opt/assimp/lib64 ${LDFLAGS}" \
    && DISABLE_GROUPS_WORKAROUND=1 /opt/desktop-tools/bin/colcon build \
        --merge-install \
        --install-base /opt/ros-desktop/${ROS_DISTRO} \
        --packages-up-to desktop perception \
        --parallel-workers "${BUILD_JOBS}" \
        --event-handlers console_direct+ \
        --cmake-args \
          -DBUILD_TESTING=OFF \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
          -DTRACETOOLS_DISABLED=ON \
          -Dpybind11_DIR=/opt/ros-python/pybind11/share/cmake/pybind11 \
    && mkdir -p /opt/ros-desktop/${ROS_DISTRO}/share/desktop-full-build \
    && /opt/desktop-tools/bin/colcon list --packages-up-to desktop perception --names-only > /opt/ros-desktop/${ROS_DISTRO}/share/desktop-full-build/packages.txt \
    && python3 /tmp/export_ros_sources.py src /opt/ros-desktop/${ROS_DISTRO}/share/desktop-full-build/sources.repos \
    && rm -rf src build log


# PyGraphviz 2.0 assumes that wheel builds bundle every Graphviz plugin. The
# openKylin riscv64 Graphviz packages use the system plugin loader and omit the
# optional neato/gd/pango plugin libraries, so build a system-context variant.
# Keep this in a separate stage so the expensive ROS/PCL/Assimp layers remain
# reusable when only this compatibility shim changes.
FROM desktop-builder AS desktop-python

ARG TARGETARCH

RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      graphviz_multiarch="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"; \
      graphviz_libdir="/usr/lib/${graphviz_multiarch}/graphviz"; \
      git clone --depth 1 --branch pygraphviz-2.0.1 \
        https://github.com/pygraphviz/pygraphviz.git /tmp/pygraphviz-fixed; \
      sed -i \
        -e '/"gvplugin_neato_layout",/d' \
        -e 's/libraries.append("gvplugin_gd")/pass/' \
        -e '/libraries.append("gvplugin_pango")/d' \
        /tmp/pygraphviz-fixed/setup.py; \
      for wrapper_source in \
        /tmp/pygraphviz-fixed/pygraphviz/graphviz.i \
        /tmp/pygraphviz-fixed/pygraphviz/graphviz_wrap.c; do \
        if [ -f "${wrapper_source}" ]; then \
          sed -i \
            '/^GVC_t \*gvContextWithBuiltins(void) {$/,/^}$/c\GVC_t *gvContextWithBuiltins(void) {\n    return gvContext();\n}' \
            "${wrapper_source}"; \
        fi; \
      done; \
      rm -rf /opt/desktop-python-fixed; \
      LDFLAGS="-L${graphviz_libdir} -Wl,-rpath,${graphviz_libdir}" \
        PYTHONPATH= /opt/desktop-tools/bin/pip install -v --no-cache-dir \
          --target /opt/desktop-python-fixed /tmp/pygraphviz-fixed; \
      rm -rf /opt/desktop-python/pygraphviz \
        /opt/desktop-python/pygraphviz-*.dist-info; \
      cp -a /opt/desktop-python-fixed/. /opt/desktop-python/; \
      rm -rf /opt/desktop-python-fixed /tmp/pygraphviz-fixed; \
    fi


FROM base-runtime AS desktop-runtime

ARG ROS_DISTRO=lyrical
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=${ROS_DISTRO} \
    ROS_VERSION=2 \
    ROS_PYTHON_VERSION=3 \
    PYTHONPATH=/opt/desktop-python:/opt/ros-python \
    QT_X11_NO_MITSHM=1 \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp

COPY --from=desktop-builder /tmp/desktop-runtime-packages.txt /tmp/desktop-runtime-packages.txt

RUN if [ "${TARGETARCH}" = "amd64" ]; then \
      printf '%s\n' \
        'Package: python3-pkg-resources' \
        'Pin: version 68.1.2-ok2' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-python.pref; \
    else \
      printf '%s\n' \
        'Package: libucx0' \
        'Pin: version 1.16.0+ds-ok1' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-ucx.pref; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        graphviz \
        libboost-filesystem-dev \
        libboost-iostreams-dev \
        libboost-serialization-dev \
        libboost-system-dev \
        libboost-thread-dev \
        libeigen3-dev \
        libgraphviz-dev \
        libopencv-dev \
        libqt5opengl5 \
        libqt5opengl5-dev \
        libqt5widgets5 \
        libyaml-cpp-dev \
        pyqt5-dev \
        python3-cycler \
        python3-dateutil \
        python3-pil \
        python3-pyqt5 \
        python3-pyqt5.qtsvg \
        python3-pyqtbuild \
        python3-pyparsing \
        python3-pkg-resources \
        python3-setuptools \
        python3-sip-dev \
        python3-sipbuild \
        qtbase5-dev \
    && xargs -r apt-get install -y --no-install-recommends \
        < /tmp/desktop-runtime-packages.txt \
    && rm -rf /var/lib/apt/lists/* \
        /tmp/desktop-runtime-packages.txt

COPY --from=desktop-builder /opt/ros-desktop/${ROS_DISTRO} /opt/ros-desktop/${ROS_DISTRO}
COPY --from=desktop-python /opt/desktop-python /opt/desktop-python
COPY --from=desktop-builder /opt/assimp /opt/assimp
COPY --from=desktop-builder /opt/orocos-kdl /opt/orocos-kdl
COPY --from=desktop-builder /opt/flann /opt/flann
COPY --from=desktop-builder /opt/pcl /opt/pcl
COPY ros_entrypoint.sh /ros_entrypoint.sh

RUN mkdir -p /opt/desktop-tools/bin \
    && ln -s /usr/bin/python3 /opt/desktop-tools/bin/python3 \
    && printf '%s\n' /opt/assimp/lib64 > /etc/ld.so.conf.d/assimp.conf \
    && printf '%s\n' /opt/orocos-kdl/lib > /etc/ld.so.conf.d/orocos-kdl.conf \
    && printf '%s\n' /opt/pcl/lib > /etc/ld.so.conf.d/pcl.conf \
    && printf '%s\n' /opt/flann/lib /opt/flann/lib64 > /etc/ld.so.conf.d/flann.conf \
    && chmod 0755 /ros_entrypoint.sh \
    && ldconfig

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]

# GDAL's amd64 development package requires JPEG 8 headers. The repository
# does not declare their conflict with JPEG 6 headers inherited from OpenCV.
# Remove only the two old development packages; retain both runtime ABIs.
# apt tries to unpack the replacement before removing its undeclared conflict.
# Remove those headers first, then immediately restore/check dependencies.
FROM desktop-runtime AS full-base
ARG TARGETARCH
RUN if [ "${TARGETARCH}" = "amd64" ] || [ "${TARGETARCH}" = "arm64" ]; then \
      apt-get update \
      && dpkg --remove --force-depends libjpeg-dev libjpeg62-turbo-dev \
      && apt-get install -y --no-install-recommends libjpeg-turbo8-dev \
      && apt-get check \
      && rm -rf /var/lib/apt/lists/*; \
    fi

FROM full-base AS full-source-deps

COPY export_ros_sources.py /tmp/export_ros_sources.py

ARG ROS_DISTRO=lyrical
ARG ROS_VARIANTS_REF=0.13.0
ARG BULLET_REF=3.24
ARG OCTOMAP_REF=v1.9.8
ARG FCL_REF=0.7.0
ARG ASSIMP_VERSION=6.0.4
ARG CFORTRAN_DEB_URL=https://deb.debian.org/debian/pool/main/c/cfortran/cfortran_20210827-1.1_all.deb
ARG CFORTRAN_DEB_SHA256=49e910e074b9865ad045d517e3130ce2d76c569d0ef99e744586d17c3c79b381
ARG BUILD_JOBS=2
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=${ROS_DISTRO} \
    CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS} \
    MAKEFLAGS="-j${BUILD_JOBS}" \
    CMAKE_POLICY_VERSION_MINIMUM=3.5 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONPATH=/opt/desktop-python:/opt/ros-python \
    PATH=/opt/simulation-tools/bin:${PATH}

# Keep source-management and compiler tooling out of the runtime stage.
RUN if [ "${TARGETARCH}" = "amd64" ]; then \
      printf '%s\n' \
        'Package: python3-pkg-resources' \
        'Pin: version 68.1.2-ok2' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-python.pref; \
    else \
      printf '%s\n' \
        'Package: libucx0' \
        'Pin: version 1.16.0+ds-ok1' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-ucx.pref; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        make \
        ninja-build \
        patch \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        python3-yaml \
        unzip \
        wget \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv --system-site-packages /opt/simulation-tools \
    && PYTHONPATH= /opt/simulation-tools/bin/pip install --no-cache-dir --upgrade \
        pip setuptools wheel \
    && PYTHONPATH= /opt/simulation-tools/bin/pip install --no-cache-dir \
        catkin-pkg \
        colcon-common-extensions \
        empy==4.2 \
        lark \
        rosdep \
        rosinstall-generator \
        vcstool

COPY --from=desktop-builder /etc/ros/rosdep/ /etc/ros/rosdep/

COPY --from=cmake-emulator /usr/bin/qemu-riscv64 /usr/local/libexec/qemu-riscv64-cmake
COPY cmake_lyrical_desktop_full_riscv.sh /tmp/cmake_riscv_qemu.sh
RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      mv /usr/bin/cmake /usr/bin/cmake.real \
      && install -m 0755 /tmp/cmake_riscv_qemu.sh /usr/bin/cmake; \
    fi

WORKDIR /simulation_ws

# Generate the released Lyrical closure and remove every package already in
# the desktop/perception underlay. The generated revisions reflect rosdistro at build
# time; separate uncached builds can pick up newer releases.
RUN . /opt/ros-desktop/${ROS_DISTRO}/setup.sh \
    && ros2 pkg list | sort -u > /tmp/base-packages.txt \
    && /opt/simulation-tools/bin/rosinstall_generator desktop_full \
        --rosdistro "${ROS_DISTRO}" \
        --deps \
        --deps-only \
        --format repos \
        --upstream \
        --exclude $(cat /tmp/base-packages.txt) \
        > /tmp/simulation.repos \
    && mkdir -p src \
    && /opt/simulation-tools/bin/vcs import --shallow src < /tmp/simulation.repos \
    && git clone --depth 1 --branch "${ROS_VARIANTS_REF}" \
        https://github.com/ros2/variants.git src/ros2/variants \
    && for package in $(cat /tmp/base-packages.txt); do \
         if [ -d "src/ros2/variants/${package}" ]; then \
           touch "src/ros2/variants/${package}/COLCON_IGNORE"; \
         fi; \
       done \
    && rm -f /tmp/simulation.repos

# The ros_base runtime carries Bullet shared libraries, but simulation also
# needs its headers and CMake package to build DART and Gazebo physics plugins.
# openKylin publishes libfcl-dev metadata, but its required liboctomap1.9
# binary is currently absent. Build all three pinned dependencies together.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libboost-dev \
        libccd-dev \
        libeigen3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --depth 1 --branch "${BULLET_REF}" \
        https://github.com/bulletphysics/bullet3.git /tmp/bullet-src \
    && cmake -S /tmp/bullet-src -B /tmp/bullet-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/simulation-deps \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_BULLET2_DEMOS=OFF \
        -DBUILD_BULLET3=OFF \
        -DBUILD_CPU_DEMOS=OFF \
        -DBUILD_EXTRAS=OFF \
        -DBUILD_OPENGL3_DEMOS=OFF \
        -DBUILD_UNIT_TESTS=OFF \
        -DINSTALL_LIBS=ON \
        -DUSE_GRAPHICAL_BENCHMARK=OFF \
    && cmake --build /tmp/bullet-build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/bullet-build \
    && git clone --depth 1 --branch "${OCTOMAP_REF}" \
        https://github.com/OctoMap/octomap.git /tmp/octomap-src \
    && cmake -S /tmp/octomap-src -B /tmp/octomap-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/simulation-deps \
        -DCMAKE_CXX_FLAGS=-Wno-error=template-id-cdtor \
        -DBUILD_TESTING=OFF \
        -DBUILD_OCTOVIS_SUBPROJECT=OFF \
        -DBUILD_DYNAMICETD3D_SUBPROJECT=OFF \
    && cmake --build /tmp/octomap-build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/octomap-build \
    && git clone --depth 1 --branch "${FCL_REF}" \
        https://github.com/flexible-collision-library/fcl.git /tmp/fcl-src \
    && cmake -S /tmp/fcl-src -B /tmp/fcl-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/simulation-deps \
        -DCMAKE_PREFIX_PATH=/opt/simulation-deps \
        -DBUILD_TESTING=OFF \
        -DFCL_BUILD_TESTS=OFF \
        -DFCL_BUILD_EXAMPLES=OFF \
        -DFCL_BUILD_DOCUMENTATION=OFF \
    && cmake --build /tmp/fcl-build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/fcl-build \
    && rm -rf /tmp/bullet-src /tmp/bullet-build \
        /tmp/octomap-src /tmp/octomap-build /tmp/fcl-src /tmp/fcl-build

# Assimp is inherited from desktop-runtime on every architecture.

# huanghe currently publishes libcfitsio-dev and libgdal-dev but omits their
# architecture-independent cfortran dependency. Install the verified Debian
# header package so gz-common keeps its required geospatial component.
RUN curl -fsSL "${CFORTRAN_DEB_URL}" -o /tmp/cfortran.deb \
    && echo "${CFORTRAN_DEB_SHA256}  /tmp/cfortran.deb" | sha256sum -c - \
    && dpkg -i /tmp/cfortran.deb \
    && rm -f /tmp/cfortran.deb

# openKylin 3.0 publishes Qt 6.10.2 Base for riscv64, but currently omits
# ShaderTools, Declarative/QML, Qt5Compat, Charts and Positioning. Gazebo GUI
# needs all of them, so build exactly those matching modules on riscv64. Use a
# DESTDIR tree both to install them into this builder and to copy the identical
# files into the runtime stage. Keep each module in its own cache layer because
# Qt Declarative is expensive to compile under QEMU.
RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        bison \
        flex \
        glslang-dev \
        libegl-dev \
        libgl-dev \
        libglx-dev \
        libvulkan-dev \
        libxkbcommon-dev \
        python3-html5lib \
        python3-ply \
        python3-regex \
        qt6-base-dev \
        qt6-base-private-dev \
        spirv-tools; \
      rm -rf /var/lib/apt/lists/*; \
      mkdir -p /usr/lib/qt6/lib/qt6/libexec; \
      ln -sf /usr/lib/qt6/libexec/qt-cmake-private \
        /usr/lib/qt6/lib/qt6/libexec/qt-cmake-private; \
      ln -sf /usr/lib/qt6/libexec/qt-cmake-private-install.cmake \
        /usr/lib/qt6/lib/qt6/libexec/qt-cmake-private-install.cmake; \
    fi

ARG QT_VERSION=6.10.2

RUN mkdir -p /opt/qt6-riscv-root \
    && if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      git clone --depth 1 --branch "v${QT_VERSION}" \
        https://github.com/qt/qtshadertools.git /tmp/qtshadertools-src; \
      mkdir -p /tmp/qtshadertools-build; \
      cd /tmp/qtshadertools-build; \
      cmake -S /tmp/qtshadertools-src -B . -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_MAKE_PROGRAM=/usr/bin/ninja \
        -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF; \
      cmake --build . --parallel "${BUILD_JOBS}"; \
      DESTDIR=/opt/qt6-riscv-root cmake --install .; \
      cp -a /opt/qt6-riscv-root/. /; \
      ldconfig; \
      cd /simulation_ws; \
      rm -rf /tmp/qtshadertools-src /tmp/qtshadertools-build; \
    fi

# Separate from BUILD_JOBS to preserve the expensive dependency cache.
# Override on builders with fewer available cores or less memory.
ARG QT_MODULE_JOBS=2

RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      git clone --depth 1 --branch "v${QT_VERSION}" \
        https://github.com/qt/qtdeclarative.git /tmp/qtdeclarative-src; \
      mkdir -p /tmp/qtdeclarative-build; \
      cd /tmp/qtdeclarative-build; \
      cmake -S /tmp/qtdeclarative-src -B . -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_MAKE_PROGRAM=/usr/bin/ninja \
        -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF; \
      cmake --build . --parallel "${QT_MODULE_JOBS}"; \
      DESTDIR=/opt/qt6-riscv-root cmake --install .; \
      cp -a /opt/qt6-riscv-root/. /; \
      ldconfig; \
      cd /simulation_ws; \
      rm -rf /tmp/qtdeclarative-src /tmp/qtdeclarative-build; \
    fi

# Qt5Compat needs ICU's development targets as well as Qt Base's runtime ICU.
# Keep this after Declarative so the completed Qt layers remain reusable.
RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      apt-get update; \
      apt-get install -y --no-install-recommends libicu-dev; \
      rm -rf /var/lib/apt/lists/*; \
    fi

RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      git clone --depth 1 --branch "v${QT_VERSION}" \
        https://github.com/qt/qt5compat.git /tmp/qt5compat-src; \
      mkdir -p /tmp/qt5compat-build; \
      cd /tmp/qt5compat-build; \
      cmake -S /tmp/qt5compat-src -B . -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_MAKE_PROGRAM=/usr/bin/ninja \
        -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF; \
      cmake --build . --parallel "${QT_MODULE_JOBS}"; \
      DESTDIR=/opt/qt6-riscv-root cmake --install .; \
      cp -a /opt/qt6-riscv-root/. /; \
      ldconfig; \
      cd /simulation_ws; \
      rm -rf /tmp/qt5compat-src /tmp/qt5compat-build; \
    fi

RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      git clone --depth 1 --branch "v${QT_VERSION}" \
        https://github.com/qt/qtcharts.git /tmp/qtcharts-src; \
      mkdir -p /tmp/qtcharts-build; \
      cd /tmp/qtcharts-build; \
      cmake -S /tmp/qtcharts-src -B . -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_MAKE_PROGRAM=/usr/bin/ninja \
        -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF; \
      cmake --build . --parallel "${QT_MODULE_JOBS}"; \
      DESTDIR=/opt/qt6-riscv-root cmake --install .; \
      cp -a /opt/qt6-riscv-root/. /; \
      ldconfig; \
      cd /simulation_ws; \
      rm -rf /tmp/qtcharts-src /tmp/qtcharts-build; \
    fi

RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      git clone --depth 1 --branch "v${QT_VERSION}" \
        https://github.com/qt/qtpositioning.git /tmp/qtpositioning-src; \
      mkdir -p /tmp/qtpositioning-build; \
      cd /tmp/qtpositioning-build; \
      cmake -S /tmp/qtpositioning-src -B . -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_MAKE_PROGRAM=/usr/bin/ninja \
        -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF; \
      cmake --build . --parallel "${QT_MODULE_JOBS}"; \
      DESTDIR=/opt/qt6-riscv-root cmake --install .; \
      cp -a /opt/qt6-riscv-root/. /; \
      ldconfig; \
      cd /simulation_ws; \
      rm -rf /tmp/qtpositioning-src /tmp/qtpositioning-build; \
    fi

# The openKylin riscv64 OGRE 1.9 packages are published without their zzip
# runtime dependency. Supply that exact package from Debian and verify it.
# Its only dependencies are libc6 >= 2.33 and zlib1g, both provided here.
ARG RISCV64_ZZIP_DEB_URL=https://deb.debian.org/debian/pool/main/z/zziplib/libzzip-0-13t64_0.13.78+dfsg.1-0.1_riscv64.deb
ARG RISCV64_ZZIP_DEB_SHA256=0849ee85d642fbea544e627fea7ba1729f3d6ad1d691235d25ef5d874c62f04e
ARG RISCV64_LIBRUBY_DEB_URL=https://ports.ubuntu.com/ubuntu-ports/pool/main/r/ruby-defaults/libruby_3.2~ubuntu1_riscv64.deb
ARG RISCV64_LIBRUBY_DEB_SHA256=03648454aabc083bb26f405733ca7b1b7adc1d2064987ff9020cf2b5f1b50bb9
ARG RISCV64_RUBY_DEB_URL=https://ports.ubuntu.com/ubuntu-ports/pool/main/r/ruby-defaults/ruby_3.2~ubuntu1_riscv64.deb
ARG RISCV64_RUBY_DEB_SHA256=e9ce70ffb4437373b806dc057d1b0ed013d88d81f5273d9b1e369cc9b6f5592e
ARG RISCV64_RUBYGEMS_DEB_URL=https://ports.ubuntu.com/ubuntu-ports/pool/main/r/rubygems/ruby-rubygems_3.4.20-1_all.deb
ARG RISCV64_RUBYGEMS_DEB_SHA256=9cb6041d902b74fd6e9373b24922e788bc2d1ed4360705ca6b53945d67b32087
ARG RISCV64_GLSLC_DEB_URL=https://deb.debian.org/debian/pool/main/s/shaderc/glslc_2025.2-1_riscv64.deb
ARG RISCV64_GLSLC_DEB_SHA256=71a7e292d0f0c296190369ff2f123590f95f0609cb337c8e3a0b6d98952a06f7
ARG RISCV64_LIBSHADERC_DEB_URL=https://deb.debian.org/debian/pool/main/s/shaderc/libshaderc1_2025.2-1_riscv64.deb
ARG RISCV64_LIBSHADERC_DEB_SHA256=b355628e960924542174d57a5eb4413b65b5ac192aacc27ab69d4d31ca461dfc
ARG RISCV64_LIBSHADERC_DEV_DEB_URL=https://deb.debian.org/debian/pool/main/s/shaderc/libshaderc-dev_2025.2-1_riscv64.deb
ARG RISCV64_LIBSHADERC_DEV_DEB_SHA256=65e4f3ee22f956138bc34658f640f345acc92a2799de3f9388dcb8dbe48215d6
ARG RISCV64_ZZIP_DEV_DEB_URL=https://deb.debian.org/debian/pool/main/z/zziplib/libzzip-dev_0.13.78+dfsg.1-0.1_riscv64.deb
ARG RISCV64_ZZIP_DEV_DEB_SHA256=acb259a79d01a43d58b9742caa5a118aae62dcfa5951d63b68e1343ff6a9810d

RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      curl -fsSL "${RISCV64_ZZIP_DEB_URL}" -o /tmp/libzzip.deb; \
      echo "${RISCV64_ZZIP_DEB_SHA256}  /tmp/libzzip.deb" | sha256sum -c -; \
      dpkg -i /tmp/libzzip.deb; \
      rm -f /tmp/libzzip.deb; \
      curl -fsSL "${RISCV64_LIBRUBY_DEB_URL}" -o /tmp/libruby.deb; \
      curl -fsSL "${RISCV64_RUBY_DEB_URL}" -o /tmp/ruby.deb; \
      curl -fsSL "${RISCV64_RUBYGEMS_DEB_URL}" -o /tmp/ruby-rubygems.deb; \
      curl -fsSL "${RISCV64_GLSLC_DEB_URL}" -o /tmp/glslc.deb; \
      curl -fsSL "${RISCV64_LIBSHADERC_DEB_URL}" -o /tmp/libshaderc1.deb; \
      curl -fsSL "${RISCV64_LIBSHADERC_DEV_DEB_URL}" -o /tmp/libshaderc-dev.deb; \
      curl -fsSL "${RISCV64_ZZIP_DEV_DEB_URL}" -o /tmp/libzzip-dev.deb; \
      echo "${RISCV64_LIBRUBY_DEB_SHA256}  /tmp/libruby.deb" | sha256sum -c -; \
      echo "${RISCV64_RUBY_DEB_SHA256}  /tmp/ruby.deb" | sha256sum -c -; \
      echo "${RISCV64_RUBYGEMS_DEB_SHA256}  /tmp/ruby-rubygems.deb" | sha256sum -c -; \
      echo "${RISCV64_GLSLC_DEB_SHA256}  /tmp/glslc.deb" | sha256sum -c -; \
      echo "${RISCV64_LIBSHADERC_DEB_SHA256}  /tmp/libshaderc1.deb" | sha256sum -c -; \
      echo "${RISCV64_LIBSHADERC_DEV_DEB_SHA256}  /tmp/libshaderc-dev.deb" | sha256sum -c -; \
      echo "${RISCV64_ZZIP_DEV_DEB_SHA256}  /tmp/libzzip-dev.deb" | sha256sum -c -; \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        /tmp/libruby.deb /tmp/ruby.deb /tmp/ruby-rubygems.deb \
        /tmp/glslc.deb /tmp/libshaderc1.deb /tmp/libshaderc-dev.deb \
        /tmp/libzzip-dev.deb; \
      rm -f /tmp/libruby.deb /tmp/ruby.deb /tmp/ruby-rubygems.deb \
        /tmp/glslc.deb /tmp/libshaderc1.deb /tmp/libshaderc-dev.deb \
        /tmp/libzzip-dev.deb; \
      ruby --version; \
      glslc --version; \
    fi

# openKylin does not publish Poco for riscv64. Build the commonly shipped
# libpoco-dev component set from the signed upstream release commit.
ARG POCO_COMMIT=96d182a99303fb068575294b36f0cc20da2e7b25
ARG POCO_BUILD_JOBS=2

RUN mkdir -p /opt/poco \
    && if [ "${TARGETARCH}" = "riscv64" ]; then \
      set -eux; \
      git clone --filter=blob:none https://github.com/pocoproject/poco.git /tmp/poco-src; \
      git -C /tmp/poco-src checkout --detach "${POCO_COMMIT}"; \
      test "$(git -C /tmp/poco-src rev-parse HEAD)" = "${POCO_COMMIT}"; \
      cmake -S /tmp/poco-src -B /tmp/poco-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/poco \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -DENABLE_TESTS=OFF -DENABLE_SAMPLES=OFF \
        -DENABLE_DATA=OFF -DENABLE_MONGODB=OFF -DENABLE_REDIS=OFF \
        -DENABLE_PROMETHEUS=OFF -DENABLE_APACHECONNECTOR=OFF \
        -DENABLE_PAGECOMPILER=OFF -DENABLE_ACTIVERECORD=OFF \
        -DENABLE_PDF=OFF -DENABLE_SEVENZIP=OFF \
        -DPOCO_UNBUNDLED=OFF; \
      cmake --build /tmp/poco-build --parallel "${POCO_BUILD_JOBS}"; \
      cmake --install /tmp/poco-build; \
      rm -rf /tmp/poco-src /tmp/poco-build; \
    fi

# Use Ubuntu Noble rosdep keys as a package-name mapping, then resolve packages
# from openKylin's own repositories. This does not imply Ubuntu ABI compatibility.
# Capture exec dependencies separately for the runtime.
ARG ROSDEP_SKIP_KEYS="assimp assimp-dev libassimp-dev ament_uncrustify asio benchmark bullet clang-format console_bridge cppcheck fcl ffmpeg-dev fzf gmock libbenchmark-dev libbullet-dev libconsole-bridge-dev libfcl-dev libgmock-dev liblttng-ust-dev liblz4-dev liboctomap-dev liborocos-kdl liborocos-kdl-dev liborocos-kdl1.5 libpostproc-dev libspdlog-dev libxml2-utils lttng-tools lttng-ust octomap pybind11 pybind11-dev pydocstyle spdlog uncrustify python3-argcomplete python3-catkin-pkg python3-catkin-pkg-modules python3-colcon-common-extensions python3-empy python3-flake8 python3-flake8-blind-except python3-flake8-builtins python3-flake8-class-newline python3-flake8-comprehensions python3-flake8-deprecated python3-flake8-import-order python3-flake8-quotes python3-lark-parser python3-lxml python3-mypy python3-osrf-pycommon python3-pycodestyle python3-pyflakes python3-pytest python3-rosdep python3-rosdistro python3-rosdistro-modules python3-rospkg python3-rospkg-modules python3-setuptools python3-typing-extensions python3-vcstool"
ARG RISCV64_QT_ROSDEP_SKIP_KEYS="libqt6charts6 libqt6core5compat6 libqt6positioning6 libqt6qml6 libqt6quick6 qml6-module-qt-labs-folderlistmodel qml6-module-qt-labs-platform qml6-module-qt-labs-settings qml6-module-qt5compat-graphicaleffects qml6-module-qtcharts qml6-module-qtcore qml6-module-qtpositioning qml6-module-qtqml qml6-module-qtqml-models qml6-module-qtqml-workerscript qml6-module-qtquick qml6-module-qtquick-controls qml6-module-qtquick-dialogs qml6-module-qtquick-layouts qml6-module-qtquick-templates qml6-module-qtquick-window qt6-5compat-dev qt6-charts-dev qt6-declarative-dev qt6-declarative-dev-tools qt6-declarative-private-dev qt6-positioning-dev qt6-qmltooling-plugins qt6-shadertools-dev qt6-shadertools-dev-tools"

# Gazebo Sim's vendored Backward-cpp prefers libdw when it is available.
# Keep libdw-dev in both dependency sets; riscv64 lacks the alternative
# libdwarf-dev package, so only that unused alternative is skipped there.
# Replace conflicting JPEG development headers before GDAL's dependencies.
# Keep this after the source dependencies to preserve their build cache.
RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      apt-get update \
      && dpkg --remove --force-depends libjpeg-dev libjpeg62-turbo-dev \
      && apt-get install -y --no-install-recommends libjpeg-turbo8-dev \
      && apt-get check \
      && rm -rf /var/lib/apt/lists/*; \
    fi

# Export source dependency cache before network-dependent rosdep operations.
FROM full-source-deps AS full-deps

RUN export DISABLE_GROUPS_WORKAROUND=1 ROS_OS_OVERRIDE=ubuntu:noble \
    && . /opt/ros-desktop/${ROS_DISTRO}/setup.sh \
    && mkdir -p /etc/ros/rosdep/sources.list.d \
    && if [ ! -e /etc/ros/rosdep/sources.list.d/20-default.list ]; then \
         /opt/simulation-tools/bin/rosdep init; \
       fi \
    && if [ "${TARGETARCH}" = "amd64" ] || [ "${TARGETARCH}" = "arm64" ] || [ "${TARGETARCH}" = "riscv64" ]; then \
         printf '%s\n' '{"libqt6-gui":{"ubuntu":{"noble":["libqt6gui6"]}},"libqt6gui6t64":{"ubuntu":{"noble":["libqt6gui6"]}},"libqt6-opengl":{"ubuntu":{"noble":["libqt6opengl6"]}},"libqt6opengl6t64":{"ubuntu":{"noble":["libqt6opengl6"]}},"libqt6-widgets":{"ubuntu":{"noble":["libqt6widgets6"]}},"libqt6widgets6t64":{"ubuntu":{"noble":["libqt6widgets6"]}}}' > /etc/ros/rosdep/openkylin-qt6.yaml; \
         printf '%s\n' 'yaml file:///etc/ros/rosdep/openkylin-qt6.yaml' \
           > /etc/ros/rosdep/sources.list.d/00-openkylin-qt6.list; \
       fi \
    && (for attempt in 1 2 3 4 5 6 7 8; do \
          if /opt/simulation-tools/bin/rosdep update --rosdistro "${ROS_DISTRO}"; then exit 0; fi; \
          echo "rosdep update failed on attempt ${attempt}/8" >&2; \
          sleep 15; \
        done; exit 1) \
    && /opt/simulation-tools/bin/colcon list \
        --packages-up-to desktop_full \
        --paths-only \
        | sort -u > /tmp/simulation-paths.txt \
    && apt-mark showmanual | sort -u > /tmp/manual-before-exec.txt \
    && rosdep_skip_keys="${ROSDEP_SKIP_KEYS}" \
    && if [ "${TARGETARCH}" != "amd64" ]; then \
         rosdep_skip_keys="${rosdep_skip_keys} assimp assimp-dev libassimp-dev"; \
       fi \
    && if [ "${TARGETARCH}" = "riscv64" ]; then \
         rosdep_skip_keys="${rosdep_skip_keys} ${RISCV64_QT_ROSDEP_SKIP_KEYS} glslc libdwarf-dev libpoco-dev libshaderc-dev libzzip-dev ruby"; \
       fi \
    && apt-get update \
    && xargs /opt/simulation-tools/bin/rosdep install \
        --from-paths \
        --ignore-src \
        --rosdistro "${ROS_DISTRO}" \
        --os=ubuntu:noble \
        --dependency-types exec \
        --skip-keys "libpcl-dev libpcl-features libpcl-features1.14 libpcl-filters libpcl-filters1.14 libpcl-segmentation libpcl-segmentation1.14 libpcl-surface libpcl-surface1.14 ${rosdep_skip_keys}" \
        -y < /tmp/simulation-paths.txt \
    && apt-mark showmanual | sort -u > /tmp/manual-after-exec.txt \
    && comm -13 /tmp/manual-before-exec.txt /tmp/manual-after-exec.txt \
        > /tmp/simulation-runtime-packages.txt \
    && if [ "${TARGETARCH}" = "riscv64" ]; then \
         printf '%s\n' qt6-base-dev qt6-base-private-dev libqt6svg6 \
           >> /tmp/simulation-runtime-packages.txt; \
       fi \
    && sort -u -o /tmp/simulation-runtime-packages.txt \
        /tmp/simulation-runtime-packages.txt

RUN . /opt/ros-desktop/${ROS_DISTRO}/setup.sh \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        libavcodec-dev \
        libavdevice-dev \
        libavfilter-dev \
        libavformat-dev \
        libavutil-dev \
        libgtest-dev \
        libswresample-dev \
        libswscale-dev \
        libyaml-cpp-dev \
    && export DISABLE_GROUPS_WORKAROUND=1 ROS_OS_OVERRIDE=ubuntu:noble \
    && rosdep_skip_keys="${ROSDEP_SKIP_KEYS}" \
    && if [ "${TARGETARCH}" != "amd64" ]; then \
         rosdep_skip_keys="${rosdep_skip_keys} assimp assimp-dev libassimp-dev"; \
       fi \
    && if [ "${TARGETARCH}" = "riscv64" ]; then \
         rosdep_skip_keys="${rosdep_skip_keys} ${RISCV64_QT_ROSDEP_SKIP_KEYS} glslc libdwarf-dev libpoco-dev libshaderc-dev libzzip-dev ruby"; \
       fi \
    && xargs /opt/simulation-tools/bin/rosdep install \
        --from-paths \
        --ignore-src \
        --rosdistro "${ROS_DISTRO}" \
        --os=ubuntu:noble \
        --dependency-types build \
        --dependency-types buildtool \
        --dependency-types build_export \
        --dependency-types buildtool_export \
        --skip-keys "libpcl-dev libpcl-features libpcl-features1.14 libpcl-filters libpcl-filters1.14 libpcl-segmentation libpcl-segmentation1.14 libpcl-surface libpcl-surface1.14 ${rosdep_skip_keys}" \
        -y < /tmp/simulation-paths.txt \
    && rm -rf /var/lib/apt/lists/*

FROM full-deps AS full-builder

# Recognize RV64's LP64 ABI in the pinned Ogre Next release.
RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      printf '%s\n' '--- a/OgreMain/include/OgrePlatform.h' \
        '+++ b/OgreMain/include/OgrePlatform.h' \
        '@@ -79,7 +79,8 @@' \
        '  || defined(__ppc64__) \' \
        '  || defined(__arm64__) || defined(__aarch64__) || defined(_M_ARM64) \' \
        '  || defined(__mips64) || defined(__mips64_) \' \
        '- || defined(__alpha__) || defined(__ia64__) || defined(__e2k__) || defined(__s390__) || defined(__s390x__)' \
        '+ || defined(__alpha__) || defined(__ia64__) || defined(__e2k__) || defined(__s390__) || defined(__s390x__) \' \
        '+ || (defined(__riscv) && __riscv_xlen == 64)' \
        ' #   define OGRE_ARCH_TYPE OGRE_ARCHITECTURE_64' \
        ' #else' \
        ' #   define OGRE_ARCH_TYPE OGRE_ARCHITECTURE_32' \
        > src/gz_ogre_next_vendor/patches/0003-riscv64-architecture.patch \
      && sed -i '/^  PATCHES$/a\    patches/0003-riscv64-architecture.patch' src/gz_ogre_next_vendor/CMakeLists.txt; \
    fi

# Ogre Next has no RISC-V SIMD backend; use its supported scalar implementation.
RUN if [ "${TARGETARCH}" = "riscv64" ]; then \
      test -f src/gz_ogre_next_vendor/CMakeLists.txt \
      && grep -Fq 'set(EXTRA_CMAKE_FLAGS)' src/gz_ogre_next_vendor/CMakeLists.txt \
      && sed -i 's/set(EXTRA_CMAKE_FLAGS)/set(EXTRA_CMAKE_FLAGS -DOGRE_SIMD_NEON:BOOL=FALSE -DOGRE_SIMD_SSE2:BOOL=FALSE)/' src/gz_ogre_next_vendor/CMakeLists.txt; \
    fi

# rosinstall_generator also imports src/variants through simulation's closure.
# Prefer our explicitly pinned variants checkout for the final metapackages.
RUN if [ -d src/variants ] && [ -d src/ros2/variants ]; then \
      touch src/variants/COLCON_IGNORE; \
    fi

# RViz in the Desktop underlay uses Qt 5. Gazebo also installs Qt 6, so
# this plugin must not auto-select Qt 6 and mix the two Qt ABIs.
RUN test -f src/imu_tools/rviz_imu_plugin/CMakeLists.txt \
    && sed -i 's/find_package(QT NAMES Qt6 Qt5 /find_package(QT NAMES Qt5 /' \
        src/imu_tools/rviz_imu_plugin/CMakeLists.txt

# The Gazebo vendor packages fetch and build Jetty's libraries from their
# pinned release sources. Keeping a merged overlay makes the final image easy
# to compose while retaining ros_base unchanged as the underlay.
RUN . /opt/ros-desktop/${ROS_DISTRO}/setup.sh \
    && export CMAKE_PREFIX_PATH="/opt/flann:/opt/pcl:/opt/orocos-kdl:/opt/poco:/opt/assimp:/opt/simulation-deps:${CMAKE_PREFIX_PATH}" \
    && export LD_LIBRARY_PATH="/opt/assimp/lib64:${LD_LIBRARY_PATH}" \
    && export LDFLAGS="-Wl,-rpath-link,/opt/assimp/lib64 ${LDFLAGS}" \
    && DISABLE_GROUPS_WORKAROUND=1 /opt/simulation-tools/bin/colcon build \
        --merge-install \
        --install-base /opt/ros-simulation/${ROS_DISTRO} \
        --packages-up-to desktop_full \
        --parallel-workers "${BUILD_JOBS}" \
        --event-handlers console_direct- console_cohesion- console_start_end+ console_stderr+ \
        --cmake-args \
          -DBUILD_TESTING=OFF \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
          -DTRACETOOLS_DISABLED=ON \
          -Dpybind11_DIR=/opt/ros-python/pybind11/share/cmake/pybind11 \
    && mkdir -p /opt/ros-simulation/${ROS_DISTRO}/share/desktop-full-build \
    && /opt/simulation-tools/bin/colcon list --packages-up-to desktop_full --names-only > /opt/ros-simulation/${ROS_DISTRO}/share/desktop-full-build/packages.txt \
    && python3 /tmp/export_ros_sources.py src /opt/ros-simulation/${ROS_DISTRO}/share/desktop-full-build/sources.repos \
    && rm -rf src build log


# colcon's installed package registry records what the successful build actually
# installed, including plain CMake libraries. Re-running dependency selection
# without the build's environment can add test-only/group dependencies.
FROM base-runtime AS package-manifests
COPY --from=base-builder /opt/ros/lyrical/share/colcon-core/packages/ /tmp/installed/base/
COPY --from=desktop-builder /opt/ros-desktop/lyrical/share/colcon-core/packages/ /tmp/installed/desktop/
COPY --from=full-builder /opt/ros-simulation/lyrical/share/colcon-core/packages/ /tmp/installed/full/
RUN mkdir -p /manifests \
    && for part in base desktop full; do \
         find "/tmp/installed/$part" -maxdepth 1 -type f -printf '%f\n' \
           | sort -u > "/manifests/$part.txt"; \
         test -s "/manifests/$part.txt"; \
         printf '%s installed packages: ' "$part"; wc -l < "/manifests/$part.txt"; \
       done

# System OpenCV uses the NumPy 1 C ABI. Pin a Python 3.12-compatible NumPy
# for the final image independently of the source-build tool environments.
FROM desktop-python AS runtime-numpy
RUN PYTHONPATH= /opt/desktop-tools/bin/pip install --no-cache-dir --no-deps \
      --target /opt/numpy-compat numpy==1.26.4

FROM full-base AS runtime-core

ARG ROS_DISTRO=lyrical
ARG TARGETARCH
ARG CFORTRAN_DEB_URL=https://deb.debian.org/debian/pool/main/c/cfortran/cfortran_20210827-1.1_all.deb
ARG CFORTRAN_DEB_SHA256=49e910e074b9865ad045d517e3130ce2d76c569d0ef99e744586d17c3c79b381
ARG RISCV64_ZZIP_DEB_URL=https://deb.debian.org/debian/pool/main/z/zziplib/libzzip-0-13t64_0.13.78+dfsg.1-0.1_riscv64.deb
ARG RISCV64_ZZIP_DEB_SHA256=0849ee85d642fbea544e627fea7ba1729f3d6ad1d691235d25ef5d874c62f04e
ARG RISCV64_LIBRUBY_DEB_URL=https://ports.ubuntu.com/ubuntu-ports/pool/main/r/ruby-defaults/libruby_3.2~ubuntu1_riscv64.deb
ARG RISCV64_LIBRUBY_DEB_SHA256=03648454aabc083bb26f405733ca7b1b7adc1d2064987ff9020cf2b5f1b50bb9
ARG RISCV64_RUBY_DEB_URL=https://ports.ubuntu.com/ubuntu-ports/pool/main/r/ruby-defaults/ruby_3.2~ubuntu1_riscv64.deb
ARG RISCV64_RUBY_DEB_SHA256=e9ce70ffb4437373b806dc057d1b0ed013d88d81f5273d9b1e369cc9b6f5592e
ARG RISCV64_RUBYGEMS_DEB_URL=https://ports.ubuntu.com/ubuntu-ports/pool/main/r/rubygems/ruby-rubygems_3.4.20-1_all.deb
ARG RISCV64_RUBYGEMS_DEB_SHA256=9cb6041d902b74fd6e9373b24922e788bc2d1ed4360705ca6b53945d67b32087
ARG RISCV64_GLSLC_DEB_URL=https://deb.debian.org/debian/pool/main/s/shaderc/glslc_2025.2-1_riscv64.deb
ARG RISCV64_GLSLC_DEB_SHA256=71a7e292d0f0c296190369ff2f123590f95f0609cb337c8e3a0b6d98952a06f7
ARG RISCV64_LIBSHADERC_DEB_URL=https://deb.debian.org/debian/pool/main/s/shaderc/libshaderc1_2025.2-1_riscv64.deb
ARG RISCV64_LIBSHADERC_DEB_SHA256=b355628e960924542174d57a5eb4413b65b5ac192aacc27ab69d4d31ca461dfc
ARG RISCV64_LIBSHADERC_DEV_DEB_URL=https://deb.debian.org/debian/pool/main/s/shaderc/libshaderc-dev_2025.2-1_riscv64.deb
ARG RISCV64_LIBSHADERC_DEV_DEB_SHA256=65e4f3ee22f956138bc34658f640f345acc92a2799de3f9388dcb8dbe48215d6
ARG RISCV64_ZZIP_DEV_DEB_URL=https://deb.debian.org/debian/pool/main/z/zziplib/libzzip-dev_0.13.78+dfsg.1-0.1_riscv64.deb
ARG RISCV64_ZZIP_DEV_DEB_SHA256=acb259a79d01a43d58b9742caa5a118aae62dcfa5951d63b68e1343ff6a9810d

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=${ROS_DISTRO} \
    ROS_VERSION=2 \
    ROS_PYTHON_VERSION=3 \
    PYTHONPATH=/opt/desktop-python:/opt/ros-python \
    QT_X11_NO_MITSHM=1 \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Match the RISC-V builder's JPEG header replacement in the runtime layer.
# Keep both runtime ABIs; remove only the undeclared development-file conflict.
RUN if [ "${TARGETARCH}" = "riscv64" ]; then       apt-get update       && dpkg --remove --force-depends libjpeg-dev libjpeg62-turbo-dev       && apt-get install -y --no-install-recommends libjpeg-turbo8-dev       && apt-get check       && rm -rf /var/lib/apt/lists/*;     fi

COPY --from=full-builder /tmp/simulation-runtime-packages.txt /tmp/simulation-runtime-packages.txt

RUN if [ "${TARGETARCH}" = "amd64" ]; then \
      printf '%s\n' \
        'Package: python3-pkg-resources' \
        'Pin: version 68.1.2-ok2' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-python.pref; \
    else \
      printf '%s\n' \
        'Package: libucx0' \
        'Pin: version 1.16.0+ds-ok1' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-ucx.pref; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -fsSL "${CFORTRAN_DEB_URL}" -o /tmp/cfortran.deb \
    && echo "${CFORTRAN_DEB_SHA256}  /tmp/cfortran.deb" | sha256sum -c - \
    && dpkg -i /tmp/cfortran.deb \
    && rm -f /tmp/cfortran.deb \
    && if [ "${TARGETARCH}" = "riscv64" ]; then \
         curl -fsSL "${RISCV64_ZZIP_DEB_URL}" -o /tmp/libzzip.deb; \
         echo "${RISCV64_ZZIP_DEB_SHA256}  /tmp/libzzip.deb" | sha256sum -c -; \
         dpkg -i /tmp/libzzip.deb; \
         rm -f /tmp/libzzip.deb; \
         curl -fsSL "${RISCV64_LIBRUBY_DEB_URL}" -o /tmp/libruby.deb; \
         curl -fsSL "${RISCV64_RUBY_DEB_URL}" -o /tmp/ruby.deb; \
         curl -fsSL "${RISCV64_RUBYGEMS_DEB_URL}" -o /tmp/ruby-rubygems.deb; \
         curl -fsSL "${RISCV64_GLSLC_DEB_URL}" -o /tmp/glslc.deb; \
         curl -fsSL "${RISCV64_LIBSHADERC_DEB_URL}" -o /tmp/libshaderc1.deb; \
         curl -fsSL "${RISCV64_LIBSHADERC_DEV_DEB_URL}" -o /tmp/libshaderc-dev.deb; \
         curl -fsSL "${RISCV64_ZZIP_DEV_DEB_URL}" -o /tmp/libzzip-dev.deb; \
         echo "${RISCV64_LIBRUBY_DEB_SHA256}  /tmp/libruby.deb" | sha256sum -c -; \
         echo "${RISCV64_RUBY_DEB_SHA256}  /tmp/ruby.deb" | sha256sum -c -; \
         echo "${RISCV64_RUBYGEMS_DEB_SHA256}  /tmp/ruby-rubygems.deb" | sha256sum -c -; \
         echo "${RISCV64_GLSLC_DEB_SHA256}  /tmp/glslc.deb" | sha256sum -c -; \
         echo "${RISCV64_LIBSHADERC_DEB_SHA256}  /tmp/libshaderc1.deb" | sha256sum -c -; \
         echo "${RISCV64_LIBSHADERC_DEV_DEB_SHA256}  /tmp/libshaderc-dev.deb" | sha256sum -c -; \
         echo "${RISCV64_ZZIP_DEV_DEB_SHA256}  /tmp/libzzip-dev.deb" | sha256sum -c -; \
         apt-get install -y --no-install-recommends \
           /tmp/libruby.deb /tmp/ruby.deb /tmp/ruby-rubygems.deb \
           /tmp/glslc.deb /tmp/libshaderc1.deb /tmp/libshaderc-dev.deb \
           /tmp/libzzip-dev.deb; \
         rm -f /tmp/libruby.deb /tmp/ruby.deb /tmp/ruby-rubygems.deb \
           /tmp/glslc.deb /tmp/libshaderc1.deb /tmp/libshaderc-dev.deb \
           /tmp/libzzip-dev.deb; \
         ruby --version; \
         glslc --version; \
       fi \
    && xargs -r apt-get install -y --no-install-recommends \
        < /tmp/simulation-runtime-packages.txt \
    && apt-get install -y --no-install-recommends \
        libccd2 \
        libavcodec62 \
        libavdevice62 \
        libavfilter11 \
        libavformat62 \
        libavutil60 \
        libswresample6 \
        libswscale9 \
    && rm -rf /var/lib/apt/lists/* \
        /tmp/simulation-runtime-packages.txt

COPY --from=full-builder /opt/ros-simulation/${ROS_DISTRO} /opt/ros-simulation/${ROS_DISTRO}
COPY --from=full-builder /opt/simulation-deps /opt/simulation-deps
COPY --from=full-builder /opt/poco /opt/poco
COPY --from=full-builder /opt/qt6-riscv-root/ /
COPY ros_entrypoint.sh /ros_entrypoint.sh

RUN mkdir -p /opt/simulation-tools/bin \
    && ln -sf /usr/bin/python3 /opt/simulation-tools/bin/python3 \
    && printf '%s\n' /opt/assimp/lib /opt/assimp/lib64 \
        > /etc/ld.so.conf.d/assimp.conf \
    && printf '%s\n' /opt/simulation-deps/lib /opt/simulation-deps/lib64 \
        > /etc/ld.so.conf.d/simulation-deps.conf \
    && printf '%s\n' /opt/poco/lib > /etc/ld.so.conf.d/poco.conf \
    && chmod 0755 /ros_entrypoint.sh \
    && ldconfig

# Remove the previous NumPy tree before copying, so COPY cannot merge ABI versions.
RUN rm -rf /opt/desktop-python/numpy /opt/desktop-python/numpy.libs \
      /opt/desktop-python/numpy-*.dist-info
COPY --from=runtime-numpy /opt/numpy-compat/ /opt/desktop-python/

COPY --from=package-manifests /manifests/base.txt /opt/ros/lyrical/share/desktop-full-build/packages.txt
COPY --from=package-manifests /manifests/desktop.txt /opt/ros-desktop/lyrical/share/desktop-full-build/packages.txt
COPY --from=package-manifests /manifests/full.txt /opt/ros-simulation/lyrical/share/desktop-full-build/packages.txt

# Ogre's OctreeZone plugin links against PCZSceneManager in the plugin
# directory; it must be resolvable independently of RViz's dlopen order.
RUN ogre_plugin="$(find /opt/ros-desktop/${ROS_DISTRO}/opt/rviz_ogre_vendor \
      -type f -name 'Plugin_PCZSceneManager.so*' -print -quit)" \
    && test -n "$ogre_plugin" \
    && dirname "$ogre_plugin" > /etc/ld.so.conf.d/rviz-ogre-plugins.conf \
    && ldconfig

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]

LABEL org.opencontainers.image.title="ROS 2 Lyrical Desktop Full on openKylin 3.0"
LABEL org.opencontainers.image.ref.name="openkylin/ros:lyrical-desktop-full"
RUN /ros_entrypoint.sh bash -ec 'for p in ros_base desktop perception simulation desktop_full pcl_ros rviz2 ros_gz_sim_demos; do ros2 pkg prefix "$p"; done'

# Supplemental Python bindings reuse the completed Gazebo libraries.
FROM full-builder AS python-bindings-base
COPY build_gazebo_python_bindings.sh /tmp/build_gazebo_python_bindings.sh

FROM python-bindings-base AS python-bindings-math
COPY gz-math9_9.3.0.tar.gz /tmp/gz-math9_9.3.0.tar.gz
RUN echo "9e957d024a8ce7a94dfb4a33f6425077b33526a0f0e2385ae93c25f88ff8cfb7  /tmp/gz-math9_9.3.0.tar.gz" | sha256sum -c - \
    && mkdir -p /tmp/gz-python/math \
    && tar -xzf /tmp/gz-math9_9.3.0.tar.gz -C /tmp/gz-python/math --strip-components=1 \
    && bash /tmp/build_gazebo_python_bindings.sh math \
    && rm -f /tmp/gz-math9_9.3.0.tar.gz

FROM python-bindings-math AS python-bindings-transport
COPY gz_transport_vendor-source.tar.gz /tmp/gz_transport_vendor-source.tar.gz
RUN echo "cd471d9d7e4b5392b1cd6f1be90130da75a83e2b1e4c540215658c8b0d741828  /tmp/gz_transport_vendor-source.tar.gz" | sha256sum -c - \
    && mkdir -p /tmp/gz-python/transport \
    && tar -xzf /tmp/gz_transport_vendor-source.tar.gz -C /tmp/gz-python/transport \
    && bash /tmp/build_gazebo_python_bindings.sh transport \
    && rm -f /tmp/gz_transport_vendor-source.tar.gz

FROM python-bindings-transport AS python-bindings-sdformat
COPY sdformat_vendor-source.tar.gz /tmp/sdformat_vendor-source.tar.gz
RUN echo "525b414d5ae44d76970ce0cfaabc041b7fb424058280dbbb370f26946944235a  /tmp/sdformat_vendor-source.tar.gz" | sha256sum -c - \
    && mkdir -p /tmp/gz-python/sdformat \
    && tar -xzf /tmp/sdformat_vendor-source.tar.gz -C /tmp/gz-python/sdformat \
    && bash /tmp/build_gazebo_python_bindings.sh sdformat \
    && rm -f /tmp/sdformat_vendor-source.tar.gz

FROM python-bindings-sdformat AS python-bindings-sim
COPY gz_sim_vendor-source.tar.gz /tmp/gz_sim_vendor-source.tar.gz
COPY gz_sim_python_standalone.cmake /tmp/gz_sim_python_standalone.cmake
RUN echo "e6aae1c70ecde2046d49f04b2d5304b49bdbdc89da0aba7a54dd3e8c3139098e  /tmp/gz_sim_vendor-source.tar.gz" | sha256sum -c - \
    && mkdir -p /tmp/gz-python/sim \
    && tar -xzf /tmp/gz_sim_vendor-source.tar.gz -C /tmp/gz-python/sim \
    && cp /tmp/gz_sim_python_standalone.cmake /tmp/gz-python/sim/CMakeLists.txt \
    && bash /tmp/build_gazebo_python_bindings.sh sim \
    && rm -f /tmp/gz_sim_vendor-source.tar.gz

FROM python-bindings-sim AS python-bindings-check
# The vendor hook uses lib/python, but openKylin installs generated messages in lib64/python.
ENV PYTHONPATH=/opt/ros-simulation/lyrical/opt/gz_msgs_vendor/lib64/python:${PYTHONPATH}
COPY --from=cmake-emulator /usr/bin/qemu-aarch64 /usr/bin/qemu-riscv64 /checks/emulators/
COPY validate_lyrical_gazebo_python_bindings.sh /checks/validate_lyrical_gazebo_python_bindings.sh
RUN bash /checks/validate_lyrical_gazebo_python_bindings.sh

# This is the default build target: the complete runtime, with tested Python APIs.
FROM runtime-core AS runtime
COPY --from=python-bindings-check /opt/gazebo-python /opt/gazebo-python
ENV PYTHONPATH=/opt/gazebo-python/lib/python:/opt/ros-simulation/lyrical/opt/gz_msgs_vendor/lib64/python:/opt/desktop-python:/opt/ros-python
