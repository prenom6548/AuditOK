# syntax=docker/dockerfile:1.7

# Incremental source build of the ROS 2 Lyrical perception variant for
# openKylin 3.0. The published ros_base image is the underlay and the
# perception-only package closure is installed into a separate overlay.

ARG ROS_BASE_IMAGE=openkylin/ros:lyrical-ros-base@sha256:bc947b2d3766a55f000c032fde697b3d6ef60e7e2975d4929ed1a3046c3e4834

FROM --platform=${TARGETPLATFORM} ${ROS_BASE_IMAGE} AS builder

ARG ROS_DISTRO=lyrical
ARG ROS_VARIANTS_REF=0.13.0
ARG PCL_REF=pcl-1.14.0
ARG FLANN_REF=1.9.2
ARG OROCOS_KDL_VERSION=1.5.1
ARG BUILD_JOBS=2
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=${ROS_DISTRO} \
    CMAKE_POLICY_VERSION_MINIMUM=3.5 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONPATH=/opt/ros-python \
    PATH=/opt/perception-tools/bin:${PATH}

RUN if [ "${TARGETARCH}" = "amd64" ]; then \
      printf '%s\n' \
        'Package: python3-pkg-resources' \
        'Pin: version 68.1.2-ok2' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-python.pref; \
    else \
      printf '%s\n' \
        'Package: libucx0' \
        'Pin: version 1.16.0+ds-ok1' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-ucx.pref; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        make \
        ninja-build \
        patch \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        python3-yaml \
        unzip \
        wget \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv --system-site-packages /opt/perception-tools \
    && PYTHONPATH= /opt/perception-tools/bin/pip install --no-cache-dir --upgrade \
        pip setuptools wheel \
    && PYTHONPATH= /opt/perception-tools/bin/pip install --no-cache-dir \
        catkin-pkg \
        colcon-common-extensions \
        empy==4.2 \
        lark \
        rosdep \
        rosinstall-generator \
        vcstool

WORKDIR /perception_ws

RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && ros2 pkg list | sort -u > /tmp/base-packages.txt \
    && /opt/perception-tools/bin/rosinstall_generator perception \
        --rosdistro "${ROS_DISTRO}" \
        --deps \
        --deps-only \
        --format repos \
        --upstream \
        --exclude $(cat /tmp/base-packages.txt) \
        > /tmp/perception.repos \
    && mkdir -p src \
    && /opt/perception-tools/bin/vcs import --shallow src < /tmp/perception.repos \
    && git clone --depth 1 --branch "${ROS_VARIANTS_REF}" \
        https://github.com/ros2/variants.git src/ros2/variants \
    && rm -f /tmp/perception.repos

# openKylin currently has no PCL binary packages. Build the PCL components
# required by pcl_ros while keeping visualization and hardware backends off.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libboost-filesystem-dev \
        libboost-iostreams-dev \
        libboost-serialization-dev \
        libboost-system-dev \
        libboost-thread-dev \
        libeigen3-dev \
        liblz4-dev \
        libopencv-dev \
        libyaml-cpp-dev \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${FLANN_REF}" \
        https://github.com/flann-lib/flann.git /tmp/flann-src \
    && cmake -S /tmp/flann-src -B /tmp/flann-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/flann \
        -DBUILD_C_BINDINGS=OFF \
        -DBUILD_CUDA_LIB=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_MATLAB_BINDINGS=OFF \
        -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_TESTS=OFF \
    && cmake --build /tmp/flann-build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/flann-build \
    && rm -rf /tmp/flann-src /tmp/flann-build

RUN --mount=type=cache,id=ros-lyrical-pcl-${TARGETARCH},target=/tmp/pcl-cache \
    if [ ! -d /tmp/pcl-cache/src/.git ]; then \
        git clone --depth 1 --branch "${PCL_REF}" \
            https://github.com/PointCloudLibrary/pcl.git /tmp/pcl-cache/src; \
    fi \
    && git -C /tmp/pcl-cache/src reset --hard "${PCL_REF}" \
    && git -C /tmp/pcl-cache/src clean -fdx \
    && sed -i \
        -e 's/this->offset\[i\] = node.offset\[i\]/this->off[i] = node.off[i]/' \
        /tmp/pcl-cache/src/surface/include/pcl/surface/3rdparty/poisson4/octree_poisson.hpp \
    && sed -i \
        -e 's/Resize(this->m_N, this->m_M)/Resize(this->rows, this->_maxEntriesPerRow)/' \
        -e 's/Min( this->Rows(), this->Columns() )/(this->rows < this->_maxEntriesPerRow ? this->rows : this->_maxEntriesPerRow)/' \
        -e 's/M.Columns()/bb.Dimensions()/' \
        /tmp/pcl-cache/src/surface/include/pcl/surface/3rdparty/poisson4/sparse_matrix.hpp \
    && cmake -S /tmp/pcl-cache/src -B /tmp/pcl-cache/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/pcl \
        -DCMAKE_PREFIX_PATH=/opt/flann \
        -DFLANN_DIR=/opt/flann/lib/cmake/flann \
        -DPCL_ENABLE_AVX=OFF \
        -DPCL_ENABLE_SSE=OFF \
        -DPCL_ONLY_CORE_POINT_TYPES=ON \
        -DBUILD_2d=ON \
        -DBUILD_apps=OFF \
        -DBUILD_common=ON \
        -DBUILD_examples=OFF \
        -DBUILD_features=ON \
        -DBUILD_filters=ON \
        -DBUILD_global_tests=OFF \
        -DBUILD_io=ON \
        -DBUILD_kdtree=ON \
        -DBUILD_ml=ON \
        -DBUILD_octree=ON \
        -DBUILD_keypoints=OFF \
        -DBUILD_recognition=OFF \
        -DBUILD_registration=OFF \
        -DBUILD_sample_consensus=ON \
        -DBUILD_search=ON \
        -DBUILD_segmentation=ON \
        -DBUILD_stereo=OFF \
        -DBUILD_surface=ON \
        -DBUILD_tools=OFF \
        -DBUILD_tracking=OFF \
        -DBUILD_visualization=OFF \
        -DWITH_CUDA=OFF \
        -DWITH_LIBUSB=OFF \
        -DWITH_OPENGL=OFF \
        -DWITH_OPENNI=OFF \
        -DWITH_OPENNI2=OFF \
        -DWITH_PCAP=OFF \
        -DWITH_QHULL=OFF \
        -DWITH_VTK=OFF \
    && cmake --build /tmp/pcl-cache/build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/pcl-cache/build

# camera_calibration depends on matplotlib. Build its small native Python
# dependencies on riscv64 because openKylin does not publish that package there.
RUN mkdir -p /opt/perception-python \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3-cycler \
        python3-dateutil \
        python3-numpy \
        python3-pil \
        python3-pyparsing \
    && if [ "${TARGETARCH}" = "riscv64" ]; then \
         apt-get install -y --no-install-recommends \
           libfreetype-dev libpng-dev meson python3-mesonpy; \
         PYTHONPATH= /opt/perception-tools/bin/pip install --no-cache-dir \
           certifi cppy meson-python packaging setuptools-scm; \
         PYTHONPATH= /opt/perception-tools/bin/pip install --no-cache-dir \
           --ignore-installed pybind11; \
         PYTHONPATH= /opt/perception-tools/bin/pip install --no-cache-dir \
           --no-deps --no-build-isolation --target /opt/perception-python \
           kiwisolver==1.4.9 contourpy==1.3.3; \
         PYTHONPATH= /opt/perception-tools/bin/pip install --no-cache-dir \
           --no-deps --no-build-isolation --target /opt/perception-python \
           fonttools; \
         PYTHONPATH=/opt/perception-python /opt/perception-tools/bin/pip install --no-cache-dir \
           --no-deps --no-build-isolation --target /opt/perception-python \
           matplotlib==3.9.4; \
       else \
         SKIP_CYTHON=1 PYTHONPATH= /opt/perception-tools/bin/pip install --no-cache-dir --upgrade \
           --no-deps --target /opt/perception-python fonttools matplotlib==3.8.4; \
       fi \
    && rm -rf /opt/perception-python/numpy /opt/perception-python/numpy-*.dist-info \
    && rm -rf /var/lib/apt/lists/*

ARG ROSDEP_SKIP_KEYS="ament_uncrustify asio benchmark bullet clang-format console_bridge cppcheck fmt fzf gmock libbenchmark-dev libbullet-dev libconsole-bridge-dev libfmt-dev libgmock-dev liblttng-ust-dev liblz4-dev libopencv-core406t64 libopencv-imgcodecs406t64 libopencv-imgproc406t64 liborocos-kdl liborocos-kdl-dev liborocos-kdl1.5 libpcl-all-dev libpcl-common libpcl-common1.14 libpcl-dev libpcl-features libpcl-features1.14 libpcl-filters libpcl-filters1.14 libpcl-io libpcl-io1.14 libpcl-segmentation libpcl-segmentation1.14 libpcl-surface libpcl-surface1.14 libspdlog-dev libxml2-utils lttng-tools lttng-ust pybind11 pybind11-dev pydocstyle spdlog uncrustify python3-argcomplete python3-catkin-pkg python3-catkin-pkg-modules python3-colcon-common-extensions python3-empy python3-flake8 python3-flake8-blind-except python3-flake8-builtins python3-flake8-class-newline python3-flake8-comprehensions python3-flake8-deprecated python3-flake8-import-order python3-flake8-quotes python3-lark-parser python3-lxml python3-matplotlib python3-mypy python3-osrf-pycommon python3-pycodestyle python3-pyflakes python3-pytest python3-rosdep python3-rosdistro python3-rosdistro-modules python3-rospkg python3-rospkg-modules python3-setuptools python3-typing-extensions python3-vcstool"

# Resolve execution dependencies first and record the top-level APT packages
# needed to reconstruct the runtime stage without the compiler toolchain.
RUN export DISABLE_GROUPS_WORKAROUND=1 ROS_OS_OVERRIDE=ubuntu:noble \
    && . /opt/ros/${ROS_DISTRO}/setup.sh \
    && mkdir -p /etc/ros/rosdep/sources.list.d \
    && printf '%s\n' \
        'libopencv-contrib-dev:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-core:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-core-dev:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-dev:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-highgui:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-imgcodecs:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-imgcodecs-dev:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-imgproc:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-imgproc-dev:' \
        '  ubuntu: [libopencv-dev]' \
        'libopencv-videoio:' \
        '  ubuntu: [libopencv-dev]' \
        > /etc/ros/rosdep/openkylin-perception.yaml \
    && printf '%s\n' \
        'yaml file:///etc/ros/rosdep/openkylin-perception.yaml' \
        > /etc/ros/rosdep/sources.list.d/10-openkylin-perception.list \
    && if [ ! -e /etc/ros/rosdep/sources.list.d/20-default.list ]; then \
         /opt/perception-tools/bin/rosdep init; \
       fi \
    && /opt/perception-tools/bin/rosdep update --rosdistro "${ROS_DISTRO}" \
    && /opt/perception-tools/bin/colcon list \
        --packages-up-to perception \
        | awk '{print $2}' \
        | sort -u > /tmp/perception-paths.txt \
    && apt-mark showmanual | sort -u > /tmp/manual-before-exec.txt \
    && apt-get update \
    && xargs /opt/perception-tools/bin/rosdep install \
        --from-paths \
        --ignore-src \
        --rosdistro "${ROS_DISTRO}" \
        --os=ubuntu:noble \
        --dependency-types exec \
        --skip-keys "${ROSDEP_SKIP_KEYS}" \
        -y < /tmp/perception-paths.txt \
    && apt-mark showmanual | sort -u > /tmp/manual-after-exec.txt \
    && comm -13 /tmp/manual-before-exec.txt /tmp/manual-after-exec.txt \
        > /tmp/perception-runtime-packages.txt

RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && apt-get update \
    && apt-get install -y --no-install-recommends libgtest-dev \
    && export DISABLE_GROUPS_WORKAROUND=1 ROS_OS_OVERRIDE=ubuntu:noble \
    && xargs /opt/perception-tools/bin/rosdep install \
        --from-paths \
        --ignore-src \
        --rosdistro "${ROS_DISTRO}" \
        --os=ubuntu:noble \
        --dependency-types build \
        --dependency-types buildtool \
        --dependency-types build_export \
        --dependency-types buildtool_export \
        --skip-keys "${ROSDEP_SKIP_KEYS}" \
        -y < /tmp/perception-paths.txt \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "v${OROCOS_KDL_VERSION}" \
        https://github.com/orocos/orocos_kinematics_dynamics.git /tmp/orocos-kdl \
    && cmake -S /tmp/orocos-kdl/orocos_kdl -B /tmp/orocos-kdl/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/orocos-kdl \
        -DBUILD_MODELS=OFF -DENABLE_TESTS=OFF \
    && cmake --build /tmp/orocos-kdl/build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/orocos-kdl/build \
    && rm -rf /tmp/orocos-kdl

RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && export CMAKE_PREFIX_PATH="/opt/orocos-kdl:/opt/pcl:/opt/flann:${CMAKE_PREFIX_PATH}" \
    && export CPATH="/opt/orocos-kdl/include:${CPATH}" \
    && DISABLE_GROUPS_WORKAROUND=1 /opt/perception-tools/bin/colcon build \
        --merge-install \
        --install-base /opt/ros-perception/${ROS_DISTRO} \
        --packages-up-to perception \
        --parallel-workers "${BUILD_JOBS}" \
        --event-handlers console_direct+ \
        --cmake-args \
          -DBUILD_TESTING=OFF \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
          -DTRACETOOLS_DISABLED=ON \
          -Dpybind11_DIR=/opt/ros-python/pybind11/share/cmake/pybind11 \
    && rm -rf src build log


FROM --platform=${TARGETPLATFORM} ${ROS_BASE_IMAGE} AS runtime

ARG ROS_DISTRO=lyrical
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=${ROS_DISTRO} \
    ROS_VERSION=2 \
    ROS_PYTHON_VERSION=3 \
    PYTHONPATH=/opt/perception-python:/opt/ros-python \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp

COPY --from=builder /tmp/perception-runtime-packages.txt /tmp/perception-runtime-packages.txt

RUN if [ "${TARGETARCH}" = "amd64" ]; then \
      printf '%s\n' \
        'Package: python3-pkg-resources' \
        'Pin: version 68.1.2-ok2' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-python.pref; \
    else \
      printf '%s\n' \
        'Package: libucx0' \
        'Pin: version 1.16.0+ds-ok1' \
        'Pin-Priority: 1001' \
        > /etc/apt/preferences.d/openkylin-ucx.pref; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        libboost-filesystem-dev \
        libboost-iostreams-dev \
        libboost-serialization-dev \
        libboost-system-dev \
        libboost-thread-dev \
        libeigen3-dev \
        libopencv-dev \
        libyaml-cpp-dev \
        python3-cycler \
        python3-dateutil \
        python3-pil \
        python3-pyparsing \
        python3-pkg-resources=68.1.2-ok2 \
        python3-setuptools=68.1.2-ok2 \
    && xargs -r apt-get install -y --no-install-recommends \
        < /tmp/perception-runtime-packages.txt \
    && rm -rf /var/lib/apt/lists/* \
        /tmp/perception-runtime-packages.txt

COPY --from=builder /opt/ros-perception/${ROS_DISTRO} /opt/ros-perception/${ROS_DISTRO}
COPY --from=builder /opt/perception-python /opt/perception-python
COPY --from=builder /opt/flann /opt/flann
COPY --from=builder /opt/pcl /opt/pcl
COPY --from=builder /opt/orocos-kdl /opt/orocos-kdl
COPY ros_entrypoint.sh /ros_entrypoint.sh

RUN mkdir -p /opt/perception-tools/bin \
    && ln -s /usr/bin/python3 /opt/perception-tools/bin/python3 \
    && printf '%s\n' /opt/flann/lib > /etc/ld.so.conf.d/flann.conf \
    && printf '%s\n' /opt/pcl/lib > /etc/ld.so.conf.d/pcl.conf \
    && printf '%s\n' /opt/orocos-kdl/lib > /etc/ld.so.conf.d/orocos-kdl.conf \
    && chmod 0755 /ros_entrypoint.sh \
    && ldconfig

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
