#!/usr/bin/env bash
set -euo pipefail

uid="$(id -u)"
user_name="$(id -un)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${uid}}"

if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "${XDG_RUNTIME_DIR}/bus" ]]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
fi

if [[ -z "${WAYLAND_DISPLAY:-}" && -d "${XDG_RUNTIME_DIR}" ]]; then
  for sock in "${XDG_RUNTIME_DIR}"/wayland-*; do
    if [[ -S "$sock" ]]; then
      export WAYLAND_DISPLAY="$(basename "$sock")"
      break
    fi
  done
fi

if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
  if command -v loginctl >/dev/null 2>&1; then
    while read -r session _ uid_col user_col _; do
      [[ "${uid_col:-}" == "$uid" || "${user_col:-}" == "$user_name" ]] || continue
      display="$(loginctl show-session "$session" -p Display --value 2>/dev/null || true)"
      if [[ -n "$display" ]]; then
        export DISPLAY="$display"
        break
      fi
    done < <(loginctl list-sessions --no-legend 2>/dev/null || true)
  fi
fi

if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
  if [[ -S /tmp/.X11-unix/X1 ]]; then
    export DISPLAY=":1"
  elif [[ -S /tmp/.X11-unix/X0 ]]; then
    export DISPLAY=":0"
  else
    for sock in /tmp/.X11-unix/X*; do
      if [[ -S "$sock" ]]; then
        export DISPLAY=":${sock##*/X}"
        break
      fi
    done
  fi
fi

if [[ -z "${XAUTHORITY:-}" ]]; then
  if [[ -f "${HOME}/.Xauthority" ]]; then
    export XAUTHORITY="${HOME}/.Xauthority"
  elif [[ -f "${XDG_RUNTIME_DIR}/gdm/Xauthority" ]]; then
    export XAUTHORITY="${XDG_RUNTIME_DIR}/gdm/Xauthority"
  fi
fi

if [[ -z "${XDG_SESSION_TYPE:-}" ]]; then
  if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    export XDG_SESSION_TYPE=wayland
  elif [[ -n "${DISPLAY:-}" ]]; then
    export XDG_SESSION_TYPE=x11
  fi
fi

if [[ "${XDG_SESSION_TYPE:-}" == "wayland" && -z "${DISPLAY:-}" ]]; then
  export GDK_BACKEND=wayland
  export QT_QPA_PLATFORM=wayland
elif [[ -n "${DISPLAY:-}" ]]; then
  export GDK_BACKEND=x11
  export QT_QPA_PLATFORM=xcb
fi

if [[ "${1:-}" == "--print-env" ]]; then
  printf "DISPLAY=%s\n" "${DISPLAY:-}"
  printf "WAYLAND_DISPLAY=%s\n" "${WAYLAND_DISPLAY:-}"
  printf "XDG_SESSION_TYPE=%s\n" "${XDG_SESSION_TYPE:-}"
  printf "XAUTHORITY=%s\n" "${XAUTHORITY:-}"
  printf "XDG_RUNTIME_DIR=%s\n" "${XDG_RUNTIME_DIR:-}"
  printf "DBUS_SESSION_BUS_ADDRESS=%s\n" "${DBUS_SESSION_BUS_ADDRESS:-}"
  exit 0
fi

exec python3 "${HOME}/.local/share/kylin-cua/run/kylin-cua.py" "$@"
