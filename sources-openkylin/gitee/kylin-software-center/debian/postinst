#!/bin/sh

set -e

# Clean up the old database
for user in `ls /home/`
do
    path="/home/"$user"/.cache/uksc/uksc.db"
    if [ -f "$path" ]; then
        rm $path*
    fi
done
if [ -f "/root/.cache/uksc/uksc.db" ];then
    rm "/root/.cache/uksc/uksc.db"
fi

# Clean up the old conf
for user in `ls /home/`
do
    path="/home/"$user"/.cache/uksc/kylin-software-center.conf"
    if [ -f "$path" ]; then
        rm $path*
    fi
done

autostar="/etc/xdg/autostart/kylin-software-center-autostart.desktop"
if [ -f "$autostar" ]; then
    rm $autostar
fi

chmod 775 /usr/lib/python3/dist-packages/kylin_software_center_daemon/start_systemdbus.py
chmod 777 /usr/share/kylin-software-center/backend/service/password.txt
chmod 777 /usr/share/kylin-software-center/kylin-software-center.py
chmod 774 /usr/share/kylin-software-center/kylin-software-center.conf
#DEBHELPER#

exit 0
