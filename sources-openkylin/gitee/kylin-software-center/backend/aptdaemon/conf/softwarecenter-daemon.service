[Unit]
Description=Run kylin-software-center dbus daemon
After=dbus.service docker.service

[Service]
Type=dbus
BusName=com.kylin.softwarecenter
ExecStart=/usr/bin/kylin-software-center-daemon
User=root
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
Alias=dbus-com.kylin.softwarecenter.service