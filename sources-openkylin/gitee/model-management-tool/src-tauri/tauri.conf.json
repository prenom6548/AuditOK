{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "model-management-tool",
  "version": "1.0.1",
  "identifier": "org.openkylin.model-management-tool",
  "mainBinaryName": "model-management-tool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "模型管理工具",
        "decorations": false,
        "devtools": true,
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "linux": {
      "deb": {
        "desktopTemplate": "deb.desktop.template"
      }
    },
    "icon": [
      "icons/icon.svg",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
