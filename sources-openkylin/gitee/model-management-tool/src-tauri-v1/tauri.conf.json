{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://127.0.0.1:1420",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "model-management-tool",
    "version": "1.0.1"
  },
  "tauri": {
    "allowlist": {
      "window": {
        "all": true
      }
    },
    "windows": [
      {
        "title": "模型管理工具",
        "decorations": false,
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": ["deb"],
      "identifier": "org.openkylin.model-management-tool",
      "deb": {
        "desktopTemplate": "../src-tauri/deb.desktop.template"
      },
      "icon": [
        "../src-tauri/icons/icon.svg",
        "../src-tauri/icons/24x24.png",
        "../src-tauri/icons/32x32.png",
        "../src-tauri/icons/64x64.png",
        "../src-tauri/icons/128x128.png",
        "../src-tauri/icons/128x128@2x.png",
        "../src-tauri/icons/icon.png"
      ]
    }
  }
}
