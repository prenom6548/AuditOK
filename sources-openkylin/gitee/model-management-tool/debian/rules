#!/usr/bin/make -f

# Rust/Node 工具链优先使用 rustup / nvm 安装的版本
ifneq (,$(wildcard $(HOME)/.cargo/bin))
export PATH := $(HOME)/.cargo/bin:$(PATH)
endif
NVM_BIN := $(firstword $(wildcard $(HOME)/.nvm/versions/node/*/bin))
ifneq (,$(NVM_BIN))
export PATH := $(NVM_BIN):$(PATH)
endif

# 按系统可用的 webkit2gtk 版本自动选择构建链（V10 -> Tauri 1，V11 -> Tauri 2）
HAVE_WK41 := $(shell pkg-config --exists webkit2gtk-4.1 && echo yes)
ifeq ($(HAVE_WK41),yes)
export KYLIN_VERSION := v11
TAURI_DIR := src-tauri
else
export KYLIN_VERSION := v10
TAURI_DIR := src-tauri-v1
endif

PKG := debian/model-management-tool

%:
	dh $@ --buildsystem=none

override_dh_auto_build:
	@command -v cargo >/dev/null || { echo "错误：未找到 cargo，请先安装 Rust 工具链（rustup）"; exit 1; }
	@command -v npm >/dev/null || { echo "错误：未找到 npm，请先安装 Node.js（建议 >= 18）"; exit 1; }
	npm ci --prefer-offline --no-audit --no-fund || npm install --prefer-offline --no-audit --no-fund
	npm run build
	# custom-protocol：发布模式，前端资源内嵌；否则按 dev 模式回退连接 127.0.0.1:1420
	cargo build --release --locked --features custom-protocol --manifest-path $(TAURI_DIR)/Cargo.toml

override_dh_auto_install:
	install -D -m 0755 $(TAURI_DIR)/target/release/model-management-tool \
		$(PKG)/usr/bin/model-management-tool
	install -D -m 0644 src-tauri/deb.desktop.template \
		$(PKG)/usr/share/applications/model-management-tool.desktop
	install -D -m 0644 src-tauri/icons/24x24.png $(PKG)/usr/share/icons/hicolor/24x24/apps/model-management-tool.png
	install -D -m 0644 src-tauri/icons/32x32.png $(PKG)/usr/share/icons/hicolor/32x32/apps/model-management-tool.png
	install -D -m 0644 src-tauri/icons/64x64.png $(PKG)/usr/share/icons/hicolor/64x64/apps/model-management-tool.png
	install -D -m 0644 src-tauri/icons/128x128.png $(PKG)/usr/share/icons/hicolor/128x128/apps/model-management-tool.png
	install -D -m 0644 src-tauri/icons/128x128@2x.png $(PKG)/usr/share/icons/hicolor/256x256/apps/model-management-tool.png
	install -D -m 0644 src-tauri/icons/icon.svg $(PKG)/usr/share/icons/hicolor/scalable/apps/model-management-tool.svg

override_dh_auto_clean:
	rm -rf dist $(PKG) debian/.debhelper debian/files debian/debhelper-build-stamp debian/*.substvars debian/*.debhelper

# Rust 产物无需 dwz 压缩调试信息
override_dh_dwz:

# release 构建无调试信息，跳过生成空的 dbgsym 包
override_dh_strip:
	dh_strip --no-automatic-dbgsym
