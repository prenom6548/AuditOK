# 源码打包时忽略构建产物与本地缓存目录
# （tar-ignore 透传给 tar --exclude；本机 dpkg 较老，
#  原生格式的 tar 包需依赖该选项排除大目录）
tar-ignore = .git
tar-ignore = node_modules
tar-ignore = dist
tar-ignore = target
tar-ignore = .npm-cache
tar-ignore = image
tar-ignore = image.tar.gz
tar-ignore = rust_out
extend-diff-ignore = "(^|/)(node_modules|dist|target|\.npm-cache|image)(/|$)"
