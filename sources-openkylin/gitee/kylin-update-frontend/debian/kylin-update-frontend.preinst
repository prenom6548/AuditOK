#!/bin/bash

set -e

#path="/usr/lib/`/usr/bin/dpkg-architecture -qDEB_TARGET_MULTIARCH`/ukui-control-center/libupgrade.so"
#dpkg-divert --package kylin-system-updater  --rename --divert "$path"".old" --add $path

path1="/usr/bin/kylin-updatefinish-notify"
dpkg-divert --package kylin-system-updater --rename --divert "$path1"".old" --add $path1

path2="/usr/share/ukui-control-center/upgrade/kylin-need-logout.conf"
path3="/usr/share/ukui-control-center/upgrade/kylin-need-reboot.conf"

dpkg-divert --package kylin-system-updater --rename --divert "$path2"".old" --add $path2
dpkg-divert --package kylin-system-updater --rename --divert "$path3"".old" --add $path3

