#: src/notifications.c:42 src/notifications.c:58 src/notifications.c:75
msgid "Update Finished!"
msgstr "تم التحديث بنجاح"

#: src/notifications.c:59
msgid "It's suggested to reboot immediately."
msgstr ""
"اكتمل هذا التحديث، وسيتم تطبيق التحديثات بعد إعادة تشغيل النظام. هل تريد "
"إعادة تشغيل النظام؟"

#: src/notifications.c:63
msgid "Reboot"
msgstr "إعادة التشغيل الآن"

#: src/notifications.c:64 src/notifications.c:82
msgid "Closed"
msgstr "إعادة التشغيل لاحقاً"

#: src/notifications.c:76
msgid "It's suggested to logout immediately."
msgstr ""
"اكتمل هذا التحديث، وسيتم تطبيق التحديثات بعد تسجيل الخروج من النظام. هل تريد "
"تسجيل الخروج من النظام؟"

#: src/notifications.c:81
msgid "Logout"
msgstr "تسجيل الخروج الآن"
