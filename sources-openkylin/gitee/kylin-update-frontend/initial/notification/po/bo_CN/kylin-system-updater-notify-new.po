#: src/notifications.c:42 src/notifications.c:58 src/notifications.c:75
msgid "Update Finished!"
msgstr "གསར་སྒྱུར་ལེགས་འགྲུབ་བྱུང་ཡོད།"

#: src/notifications.c:59
msgid "It's suggested to reboot immediately."
msgstr ""
"ཐེངས་འདིའི་གསར་བརྗེ་ལེགས་འགྲུབ་བྱུང་ཟིན་པས་མ་ལག་གཙོ་བོར་བཟུང་ནས་བཀོལ་སྤྱོད་གསར་སྒྱུར་བྱེད་རྒྱུ་རེད། མ་"
"ལག་བསྐྱར་དུ་ཕྱེ་ཡོད་དམ།"

#: src/notifications.c:63
msgid "Reboot"
msgstr "ལམ་སང་བསྐྱར་དུ་སྒོ་འབྱེད་དགོས།"

#: src/notifications.c:64 src/notifications.c:82
msgid "Closed"
msgstr "ཅུང་ཙམ་འགོར་རྗེས་བསྐྱར་དུ་སྒོ་ཕྱེ།།"

#: src/notifications.c:76
msgid "It's suggested to logout immediately."
msgstr ""
"ཐེངས་འདིའི་གསར་སྒྱུར་ལེགས་འགྲུབ་བྱུང་བ་དང་མ་ལག་ཐོ་ཁོངས་ནས་གསར་སྒྱུར་བཀོལ་སྤྱོད་བྱེད་རྒྱུ་རེད། ཐོ་ཁོངས་ནས་"
"སུབ་པ་ཡིན་ནམ།"

#: src/notifications.c:81
msgid "Logout"
msgstr "འཕྲལ་མར་ཐོ་ཁོངས་ནས་བསུབ་དགོས།"
