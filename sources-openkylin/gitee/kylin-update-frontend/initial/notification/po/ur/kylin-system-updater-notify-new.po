#: src/notifications.c:42 src/notifications.c:58 src/notifications.c:75
msgid "Update Finished!"
msgstr "اپ ڈیٹ کامیابی سے مکمل"

#: src/notifications.c:59
msgid "It's suggested to reboot immediately."
msgstr ""
"موجودہ اپ ڈیٹ مکمل ہو چکی ہے، سسٹم ریسٹارٹ کے بعد اپ ڈیٹ لاگو کرے گا۔ کیا "
"سسٹم کو ریسٹارٹ کیا جائے؟"

#: src/notifications.c:63
msgid "Reboot"
msgstr "ابھی ریسٹارٹ کریں"

#: src/notifications.c:64 src/notifications.c:82
msgid "Closed"
msgstr "بعد میں ریسٹارٹ کریں"

#: src/notifications.c:76
msgid "It's suggested to logout immediately."
msgstr ""
"موجودہ اپ ڈیٹ مکمل ہو چکی ہے، سسٹم لاگ آؤٹ کے بعد اپ ڈیٹ لاگو کرے گا۔ کیا "
"سسٹم سے لاگ آؤٹ کیا جائے؟"

#: src/notifications.c:81
msgid "Logout"
msgstr "ابھی لاگ آؤٹ کریں"
