#!/usr/bin/env python3
"""Kylin Agent Runtime CLI launcher."""

import os
import sys
from pathlib import Path

if __name__ == "__main__":
    project_root = Path(__file__).resolve().parent
    for candidate in (
        project_root / ".venv" / "bin" / "python",
        project_root / "venv" / "bin" / "python",
    ):
        if candidate.is_file() and candidate.resolve() != Path(sys.executable).resolve():
            os.execv(
                str(candidate),
                [str(candidate), "-m", "kylin_agent_runtime_cli.main", *sys.argv[1:]],
            )

    from kylin_agent_runtime_cli.main import main

    main()
