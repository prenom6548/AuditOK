  <diagram id="extensions" name="04-工具插件与数据">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2150" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="extensions_0" />
        <mxCell id="extensions_1" parent="extensions_0" />
        <mxCell id="x_title" value="工具发现、Agent级工具、插件/记忆与持久化真实关系" style="text;html=1;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;" vertex="1" parent="extensions_1"><mxGeometry x="575" y="20" width="1000" height="50" as="geometry" /></mxCell>
        <mxCell id="x_builtin" value="内置工具
discover_builtin_tools()
扫描 tools/*.py register()" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=14;" vertex="1" parent="extensions_1"><mxGeometry x="80" y="110" width="330" height="105" as="geometry" /></mxCell>
        <mxCell id="x_mcp" value="MCP 工具
入口显式发现
外部 MCP servers" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=14;" vertex="1" parent="extensions_1"><mxGeometry x="480" y="110" width="330" height="105" as="geometry" /></mxCell>
        <mxCell id="x_plugin_tools" value="通用插件工具
ctx.register_tool(...)
pre/post tool hooks" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=14;" vertex="1" parent="extensions_1"><mxGeometry x="880" y="110" width="330" height="105" as="geometry" /></mxCell>
        <mxCell id="x_registry" value="Tool Registry
schema / handler / check_fn / availability" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=16;" vertex="1" parent="extensions_1"><mxGeometry x="510" y="300" width="760" height="90" as="geometry" /></mxCell>
        <mxCell id="x_filter" value="toolsets + enabled/disabled
环境变量 check_fn → 本轮 tools schemas" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=14;" vertex="1" parent="extensions_1"><mxGeometry x="510" y="460" width="760" height="90" as="geometry" /></mxCell>
        <mxCell id="x_model" value="模型返回 tool_calls" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=16;" vertex="1" parent="extensions_1"><mxGeometry x="640" y="625" width="500" height="70" as="geometry" /></mxCell>
        <mxCell id="x_skills" value="Skills
skill loader / slash command
作为上下文或用户消息注入
不经过 Tool Registry 执行" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=14;" vertex="1" parent="extensions_1"><mxGeometry x="1430" y="110" width="350" height="125" as="geometry" /></mxCell>
        <mxCell id="x_memory_mgr" value="MemoryManager / Provider
prefetch_all → 上下文
sync_all / queue_prefetch_all
provider 自带工具由 manager 处理" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=14;" vertex="1" parent="extensions_1"><mxGeometry x="1430" y="310" width="350" height="150" as="geometry" /></mxCell>
        <mxCell id="x_context" value="上下文组装
