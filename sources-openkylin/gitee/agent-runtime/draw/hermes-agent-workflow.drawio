  <diagram id="agent-loop" name="02-Agent单轮循环">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="2050" math="0" shadow="0">
      <root>
        <mxCell id="agent-loop_0" />
        <mxCell id="agent-loop_1" parent="agent-loop_0" />
        <mxCell id="a_title" value="AIAgent 单轮任务执行、Loop 与 TODO 完成门禁" style="text;html=1;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;" vertex="1" parent="agent-loop_1"><mxGeometry x="560" y="20" width="980" height="50" as="geometry" /></mxCell>
        <mxCell id="a_start" value="收到 user_message + history / images / task_id" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="830" y="95" width="440" height="65" as="geometry" /></mxCell>
        <mxCell id="a_init" value="回合初始化
确保 DB/session，恢复 todo，重建 memory cadence
设置 task_id、预算、interrupt 状态" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="760" y="220" width="580" height="105" as="geometry" /></mxCell>
        <mxCell id="a_hooks" value="pre_llm_call 插件钩子
可注入 context，也可返回 direct final response" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="760" y="390" width="580" height="90" as="geometry" /></mxCell>
        <mxCell id="a_direct" value="插件直接返回？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="900" y="540" width="300" height="115" as="geometry" /></mxCell>
        <mxCell id="a_ctx" value="构造模型上下文
系统提示、history、skills、memory prefetch、TODO/委派反馈、工具 schemas" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="700" y="715" width="700" height="105" as="geometry" /></mxCell>
        <mxCell id="a_budget" value="还有迭代预算？
max_iterations / IterationBudget / grace call" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="900" y="880" width="300" height="125" as="geometry" /></mxCell>
        <mxCell id="a_prepare" value="API 调用前处理
压缩、模型路由、修复历史 tool_call、guardrail 状态" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="760" y="1070" width="580" height="95" as="geometry" /></mxCell>
        <mxCell id="a_api" value="调用 Provider / Model
streaming、reasoning、usage、fallback client" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="760" y="1235" width="580" height="95" as="geometry" /></mxCell>
        <mxCell id="a_api_ok" value="API 成功？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="900" y="1395" width="300" height="115" as="geometry" /></mxCell>
        <mxCell id="a_parse" value="解析 assistant message
content / reasoning / tool_calls / finish_reason" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="760" y="1575" width="580" height="95" as="geometry" /></mxCell>
        <mxCell id="a_has_tools" value="包含 tool_calls？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="900" y="1735" width="300" height="115" as="geometry" /></mxCell>
        <mxCell id="a_finish" value="收尾与最终响应
TODO 状态复核、_persist_session、memory sync、post hooks" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="760" y="1910" width="580" height="95" as="geometry" /></mxCell>
        <mxCell id="a_validate" value="校验/编排 tool_calls
白名单、JSON 修复、去重
限制 delegate_task 并发" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="110" y="1550" width="430" height="115" as="geometry" /></mxCell>
        <mxCell id="a_todo_rule" value="TODO 编排门禁
要求先建计划、分支任务先 delegate_task
delegate 返回后必须 todo 更新" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="110" y="1720" width="430" height="130" as="geometry" /></mxCell>
        <mxCell id="a_execute" value="执行工具
agent/tool_executor.py
todo/memory/delegate_task 先被拦截
普通工具再进 handle_function_call()" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="110" y="1900" width="430" height="130" as="geometry" /></mxCell>
        <mxCell id="a_feedback" value="拒绝最终回答
仍有 pending/in_progress TODO 时
注入反馈让模型继续执行" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="1580" y="1710" width="410" height="120" as="geometry" /></mxCell>
        <mxCell id="a_error" value="错误分类与恢复
退避、清连接、上下文压缩
切换 fallback provider/model" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="1580" y="1325" width="410" height="130" as="geometry" /></mxCell>
        <mxCell id="a_limit" value="预算耗尽或中断
生成受控结束/总结
修复未闭合 tool_call" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="1580" y="900" width="410" height="120" as="geometry" /></mxCell>
        <mxCell id="a_end" value="返回 final_response / messages / completed" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=14;" vertex="1" parent="agent-loop_1"><mxGeometry x="830" y="2025" width="440" height="65" as="geometry" /></mxCell>
        <mxCell id="ae1" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=24;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FFFFFF;fontSize=13;" edge="1" parent="agent-loop_1" source="a_start" target="a_init"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae2" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=24;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FFFFFF;fontSize=13;" edge="1" parent="agent-loop_1" source="a_init" target="a_hooks"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae3" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=24;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FFFFFF;fontSize=13;" edge="1" parent="agent-loop_1" source="a_hooks" target="a_direct"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae4" value="否" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=24;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FFFFFF;fontSize=13;" edge="1" parent="agent-loop_1" source="a_direct" target="a_ctx"><mxGeometry relative="1" as="geometry" /></mxCell>
