        <mxCell id="x_agent_level" value="Agent 级工具？
todo / memory / delegate_task
或 memory_manager 工具" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=14;" vertex="1" parent="extensions_1"><mxGeometry x="835" y="770" width="280" height="135" as="geometry" /></mxCell>
