[Unit]
Description=kylin-system-updater dbus daemon
StartLimitIntervalSec=0

[Service]
Type=dbus
Restart=always
RestartSec=3
BusName=com.kylin.systemupgrade
Environment="GI_TYPELIB_PATH=/opt/update-module/current/usr/lib/aarch64-linux-gnu/girepository-1.0"
Environment="LD_LIBRARY_PATH=/opt/update-module/current/usr/lib/aarch64-linux-gnu"
ExecStart=/bin/sh -c '[ -x /opt/update-module/current/usr/share/kylin-system-updater/kylin-system-updater ] && exec /opt/update-module/current/usr/share/kylin-system-updater/kylin-system-updater || exec /usr/share/kylin-system-updater/kylin-system-updater'

[Install]
WantedBy=multi-user.target