msgid "Unable to access the source management server, please try again later"
msgstr ""
"Impossible d'accéder au serveur de gestion des sources, veuillez réessayer "
"plus tard."

msgid "Access to the source management server timed out, please try again later"
msgstr ""
"Délai d'attente dépassé lors de l'accès au serveur de gestion des sources, "
"veuillez réessayer plus tard."

msgid "Check if your network requires authentication?"
msgstr "Vérifiez si votre réseau nécessite une authentification."

msgid "Check your source public key signature"
msgstr "Vérifiez la signature numérique de vos sources."

msgid "update important list occur Exception"
msgstr ""
"Une anomalie est survenue lors de la récupération des mises à jour push, "
"veuillez réessayer plus tard."

msgid "You need to be root to run this application"
msgstr "Les privilèges root sont requis pour l'exécution."

msgid "There is an exception in the update package."
msgstr "Le paquet de mise à jour présente une anomalie !"

msgid "You request the removal of a system-essential package."
msgstr "Vous avez demandé la suppression d'un paquet essentiel au système."

msgid "This update cannot detect the upgradeable package."
msgstr "Aucun paquet à mettre à jour n'a été détecté pour cette mise à jour."

msgid "read important list failed"
msgstr ""
"Impossible de lire la liste des mises à jour push, veuillez réessayer plus "
"tard."

msgid "Priority Upgrade Package being updated"
msgstr "Mise à jour de la configuration des groupes en cours."

msgid "Exceptions of Priority Upgrade."
msgstr "Anomalie lors de la mise à jour prioritaire."

msgid "Due to the presence of deleted packages."
msgstr "En raison de la présence de paquets supprimés."

msgid "The system update configuration file is read abnormally, please check if the system update configuration file format is correct."
msgstr ""
"Anomalie lors de la lecture du fichier de configuration des mises à jour "
"système, veuillez vérifier que le format du fichier de configuration des "
"mises à jour système est correct."

msgid "Installation progress: "
msgstr "Progression de l'installation : "

msgid "Installation successful, about to shut down"
msgstr "Installation réussie, arrêt imminent."

msgid "Installation failed, about to shut down"
msgstr "Échec de l'installation, arrêt imminent."

msgid "groups JSON ConfigPkgs install failed"
msgstr "Impossible d'installer le fichier de configuration des groupes."

msgid "Installtion timeout to exit Due to inactivity"
msgstr "Arrêt de l'installation en raison d'un dépassement du délai d'attente."

msgid "Command execution error"
msgstr "Erreur lors de l'exécution de la commande."

msgid "Unsupported architecture"
msgstr "Architecture incompatible."

msgid "Other Error"
msgstr "Autres erreurs."

msgid "dependency is not satisfied"
msgstr "Dépendances non satisfaites."

msgid "dependency is not satisfied will download"
msgstr "Dépendances non satisfaites."

msgid "Disk space is insufficient, please clean the disk and then upgrade"
msgstr ""
"Espace disque insuffisant, veuillez libérer de l'espace disque avant de "
"procéder à la mise à jour."

msgid "Network anomaly, can't check for updates!"
msgstr "Anomalie réseau, impossible de vérifier les mises à jour !"

msgid "Check for update exceptions!"
msgstr "Anomalie lors de la vérification des mises à jour !"

msgid "Check for update exceptions,fix system APT environment error."
msgstr ""
"Anomalie lors de la vérification des mises à jour, une erreur est survenue "
"lors de la réparation de l'environnement APT du système."

msgid "The system APT environment is abnormal, please check the system APT environment."
msgstr ""
"Anomalie lors de la réparation de l'environnement APT du système, veuillez "
"vérifier l'environnement APT du système."

msgid "Priority upgrade status exception."
msgstr "Anomalie de l'état de la mise à jour prioritaire."

msgid "Upgrade configuration acquisition exception."
msgstr "Anomalie lors de la récupération de la configuration de mise à jour."

msgid "Please check your network connection and retry."
msgstr "Veuillez vérifier votre connexion réseau avant de réessayer."

msgid "Please check your source list and retry."
msgstr "Veuillez vérifier votre liste de sources avant de réessayer."

msgid "Checking network connection"
msgstr "Vérification de la connexion réseau en cours."

msgid "Updating Source Template"
msgstr "Mise à jour du modèle de sources en cours."

msgid "Update Manager upgrade is complete, please restart the setting panel before performing the system update."
msgstr ""
"Mise à jour du gestionnaire de mises à jour terminée, veuillez redémarrer et "
"accéder à Paramètres > Mise à jour pour effectuer la mise à jour du système."

msgid "Update Manager exception, please restart the setting panel before performing the system update."
msgstr ""
"Anomalie du gestionnaire de mises à jour, veuillez redémarrer et accéder à "
"Paramètres > Mise à jour pour effectuer la mise à jour du système."

msgid "Uninstallation completed"
msgstr "Désinstallation terminée."

msgid "Package validation failed and installation was rejected."
msgstr "Échec de la vérification du paquet, installation refusée."

msgid "Other tasks are being updated and upgraded, please uninstall them later."
msgstr ""
"D'autres tâches de mise à jour sont en cours, veuillez réessayer la "
"désinstallation plus tard."

#: ../aptdaemon/worker/aptworker.py:1353
msgid "The following packages have unmet dependencies:"
msgstr "Dépendances non satisfaites pour les paquets suivants :"

#: ../aptdaemon/worker/aptworker.py:1406
msgid "but it is a virtual package"
msgstr "Mais il s'agit d'un paquet virtuel."

#: ../aptdaemon/worker/aptworker.py:1409
msgid "but it is not installed"
msgstr "Mais %s n'est pas installé."

#: ../aptdaemon/worker/aptworker.py:1411
msgid "but it is not going to be installed"
msgstr "Mais impossible d'installer %s."

#. TRANSLATORS: %s is a version number
#: ../aptdaemon/worker/aptworker.py:1415
#, python-format
msgid "but %s is installed"
msgstr "Mais %s est déjà installé."

#. TRANSLATORS: %s is a version number
#: ../aptdaemon/worker/aptworker.py:1419
#, python-format
msgid "but %s is to be installed"
msgstr "Mais %s va être installé."

#: ../SystemUpdater/Core/enums.py:763
msgid "Kylin System Updater"
msgstr "Gestionnaire de mises à jour Kylin"

#: ../SystemUpdater/Core/enums.py:609
msgid "Kylin Installer"
msgstr "Installateur Kylin"

#: ../SystemUpdater/Core/enums.py:610
msgid "Kylin Uninstaller"
msgstr "Désinstallateur Kylin"

#: ../SystemUpdater/Core/enums.py:611
msgid "Kylin Background Upgrade"
msgstr "Mise à jour silencieuse"

#: ../SystemUpdater/Core/enums.py:612
msgid "Kylin Software Center"
msgstr "Magasin de logiciels"

#: ../SystemUpdater/UpdateManagerDbus.py:355
msgid " requires authentication to uninstall software packages."
msgstr " Authentification requise pour désinstaller le paquet"

#. 验签失败，提权
#: ../SystemUpdater/UpdateManager.py:463
msgid " requires authentication to install software packages."
msgstr " Authentification requise pour installer le paquet"

#: ../SystemUpdater/Core/utils.py:750
msgid "Authentication success."
msgstr "Authentification réussie"

#: ../SystemUpdater/Core/utils.py:753
msgid "Authentication failure."
msgstr "Échec de l'authentification"

#: ../SystemUpdater/Core/enums.py:101
msgid "Deb format exception, read local deb file error."
msgstr "Format de paquet invalide, échec de la lecture."

#: ../SystemUpdater/Core/enums.py:102
msgid "Install deb error."
msgstr "Échec de l'installation du paquet."

msgid "Upgrade System"
msgstr "Mise à niveau complète"

msgid "kylin-unattended-upgrade"
msgstr "Mises à jour automatiques"

msgid "Please check the system time and synchronize the system time before updating."
msgstr ""
"Veuillez vérifier l'heure du système et la synchroniser avant de procéder à "
"la mise à jour."

msgid "The package is unsigned, refuses to install."
msgstr "Le paquet n'est pas signé, installation refusée."

msgid "Program exception, please contact the administrator to solve."
msgstr ""
"Exécution anormale du programme, veuillez contacter l'administrateur pour "
"résoudre le problème."

msgid "Exceptions to running the check script."
msgstr "Anomalie lors de l'exécution du script de vérification."

msgid "Installing or removing software packages."
msgstr "Installation ou désinstallation de paquets en cours."

msgid "The system is installing updates. Please do not turn off your computer. "
msgstr ""
"Le système installe les mises à jour, veuillez ne pas éteindre l'ordinateur. "

msgid "If the device is less than 50% charged, please charge it before updating the system."
msgstr ""
"La batterie de l'appareil est inférieure à 50 %, veuillez le recharger avant "
"d'effectuer la mise à jour du système."

msgid "Application installation control policy not enabled ."
msgstr "Le contrôle de l'installation des applications n'est pas activé."

msgid "Installation failed! Application is not in the software whitelist list!"
msgstr "Échec de l'installation ! Le paquet n'est pas dans la liste blanche !"

msgid "Installation failed! Application is in the software blacklist list!"
msgstr "Échec de l'installation ! Le paquet est dans la liste noire !"

msgid "Application installation in unknown mode ."
msgstr "Stratégie de contrôle de l'installation des applications inconnue."

msgid "Other tasks are being updated and upgraded, please try again later."
msgstr ""
"D'autres tâches de mise à jour sont en cours, veuillez réessayer plus tard."

msgid "Cancel Upgrade"
msgstr "Annuler la mise à niveau"

msgid "There is no way to rollback to the previous version, there is nothing to rollback."
msgstr ""
"Impossible de revenir à la version précédente, aucune restauration possible."

msgid "Check for update exceptions! Please verify that the system deployment is complete."
msgstr ""
"Anomalie lors de la vérification des mises à jour ! Veuillez vérifier si le "
"déploiement du système est complet."

msgid "Update push is abnormal, and the corresponding branch information cannot be found on the server."
msgstr ""
"Anomalie lors de la distribution des mises à jour, les informations de la "
"branche correspondante sont introuvables sur le serveur."

msgid "Name of the repository deployed by the current system is empty."
msgstr ""
"Anomalie lors de la vérification des mises à jour, les informations du dépôt "
"de la branche de déploiement actuelle du système sont vides."

#: ../SystemUpdater/Core/utils.py:753
msgid "Cancel authentication."
msgstr "Annuler l'authentification"

msgid "System upgrade error"
msgstr "Anomalie de la mise à jour du système"

msgid "The installation process is abnormally shut down or down."
msgstr "Arrêt anormal ou panne survenue lors du processus d'installation."

msgid "The new version of the system is deployed abnormally and cannot be upgraded."
msgstr ""
"Anomalie lors du déploiement de la nouvelle version du système, mise à "
"niveau impossible."

msgid "The system update is successful and your computer will reboot in %s s"
msgstr ""
"Mise à jour du système réussie, votre ordinateur va redémarrer dans %s "
"secondes."

msgid "System update is abnormal and your computer will reboot in %s s"
msgstr ""
"Anomalie lors de la mise à jour du système, votre ordinateur va redémarrer "
"dans %s secondes."

msgid "The system update is successful and your computer will shutdown in %s s"
msgstr ""
"Mise à jour du système réussie, votre ordinateur va s'éteindre dans %s "
"secondes."

msgid "System update is abnormal and your computer will shutdown in %s s"
msgstr ""
"Anomalie lors de la mise à jour du système, votre ordinateur va s'éteindre "
"dans %s secondes."
