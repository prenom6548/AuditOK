msgid "Unable to access the source management server, please try again later"
msgstr ""
"ရင်းမြစ်စီမံခန့်ခွဲမှုဆာဗာသို့ ဝင်ရောက်၍မရပါ၊ ကျေးဇူးပြု၍ နောက်မှ "
"ထပ်မံကြိုးစားပါ။"

msgid "Access to the source management server timed out, please try again later"
msgstr ""
"ရင်းမြစ်စီမံခန့်ခွဲမှုဆာဗာသို့ ဝင်ရောက်ရာတွင် အချိန်ကုန်ဆုံးသွားပါသည်၊ "
"ကျေးဇူးပြု၍ နောက်မှ ထပ်မံကြိုးစားပါ။"

msgid "Check if your network requires authentication?"
msgstr "သင့်ကွန်ရက်တွင် အထောက်အထားစိစစ်မှု လိုအပ်ပါသလား။"

msgid "Check your source public key signature"
msgstr "သင့်ရင်းမြစ်၏ ဒစ်ဂျစ်တယ်လက်မှတ်ကို စစ်ဆေးပါ။"

msgid "update important list occur Exception"
msgstr ""
"တွန်းပို့မှုရယူရာတွင် ချို့ယွင်းချက်ဖြစ်ပေါ်နေပါသည်၊ ကျေးဇူးပြု၍ နောက်မှ "
"ထပ်မံကြိုးစားပါ။"

msgid "You need to be root to run this application"
msgstr "သင်သည် root ခွင့်ပြုချက်ဖြင့် လုပ်ဆောင်ရန် လိုအပ်ပါသည်။"

msgid "There is an exception in the update package."
msgstr "အပ်ဒိတ်ပက်ကေ့ဂျ်တွင် ချို့ယွင်းချက်ရှိနေပါသည်။"

msgid "You request the removal of a system-essential package."
msgstr ""
"သင်သည် စနစ်အတွက် မရှိမဖြစ်လိုအပ်သော ဆော့ဖ်ဝဲပက်ကေ့ဂျ်တစ်ခုကို ဖယ်ရှားရန် "
"တောင်းဆိုထားပါသည်။"

msgid "This update cannot detect the upgradeable package."
msgstr ""
"ယခုအပ်ဒိတ်တွင် အဆင့်မြှင့်တင်နိုင်သော ဆော့ဖ်ဝဲပက်ကေ့ဂျ်များကို "
"ရှာဖွေတွေ့ရှိခြင်း မရှိပါ။"

msgid "read important list failed"
msgstr ""
"တွန်းပို့အဆင့်မြှင့်တင်မှုစာရင်းကို ဖတ်ရှု၍မရပါ၊ ကျေးဇူးပြု၍ နောက်မှ "
"ထပ်မံကြိုးစားပါ။"

msgid "Priority Upgrade Package being updated"
msgstr "အုပ်စုဖွဲ့ပြင်ဆင်မှုကို အပ်ဒိတ်လုပ်နေပါသည်။"

msgid "Exceptions of Priority Upgrade."
msgstr "ဦးစားပေးအဆင့်မြှင့်တင်မှုတွင် ချို့ယွင်းချက်ရှိနေပါသည်။"

msgid "Due to the presence of deleted packages."
msgstr "ဖယ်ရှားထားသော ဆော့ဖ်ဝဲပက်ကေ့ဂျ်များ ရှိနေသောကြောင့်"

msgid "The system update configuration file is read abnormally, please check if the system update configuration file format is correct."
msgstr ""
"စနစ်အပ်ဒိတ်ပြင်ဆင်မှုဖိုင်ကို ဖတ်ရှုရာတွင် ချို့ယွင်းချက်ဖြစ်ပေါ်နေပါသည်၊ "
"ကျေးဇူးပြု၍ စနစ်အပ်ဒိတ်ပြင်ဆင်မှုဖိုင်ပုံစံ မှန်ကန်ခြင်းရှိမရှိ စစ်ဆေးပါ။"

msgid "Installation progress: "
msgstr "အင်စတောလုပ်ဆောင်မှု တိုးတက်နှုန်း- "

msgid "Installation successful, about to shut down"
msgstr "အင်စတောလုပ်ဆောင်မှု အောင်မြင်ပါသည်၊ မကြာမီ စက်ပိတ်တော့မည်ဖြစ်ပါသည်။"

msgid "Installation failed, about to shut down"
msgstr "အင်စတောလုပ်ဆောင်မှု မအောင်မြင်ပါ၊ မကြာမီ စက်ပိတ်တော့မည်ဖြစ်ပါသည်။"

msgid "groups JSON ConfigPkgs install failed"
msgstr "အုပ်စုဖွဲ့ပြင်ဆင်မှုဖိုင်ကို အင်စတောလုပ်ဆောင်၍ မရပါ။"

msgid "Installtion timeout to exit Due to inactivity"
msgstr "အင်စတောလုပ်ဆောင်ရာတွင် အချိန်ကုန်ဆုံးသွားသောကြောင့် ထွက်ခွာပါသည်။"

msgid "Command execution error"
msgstr "အမိန့်ပေးလုပ်ဆောင်ရာတွင် အမှားပြနေပါသည်။"

msgid "Unsupported architecture"
msgstr "စနစ်ဗိသုကာပုံစံ မကိုက်ညီပါ။"

msgid "Other Error"
msgstr "အခြားအမှားများ"

msgid "dependency is not satisfied"
msgstr "မှီခိုမှုဆက်နွယ်ချက်များ မပြည့်မီပါ။"

msgid "dependency is not satisfied will download"
msgstr "မှီခိုမှုဆက်နွယ်ချက်များ မပြည့်မီပါ။"

msgid "Disk space is insufficient, please clean the disk and then upgrade"
msgstr ""
"ဒစ်စနေရာ လုံလောက်မှုမရှိပါ၊ ကျေးဇူးပြု၍ ဒစ်စကို ရှင်းလင်းပြီးမှ "
"အဆင့်မြှင့်တင်အပ်ဒိတ်လုပ်ပါ။"

msgid "Network anomaly, can't check for updates!"
msgstr "ကွန်ရက်ချို့ယွင်းနေသဖြင့် အပ်ဒိတ်များကို စစ်ဆေး၍မရပါ။"

msgid "Check for update exceptions!"
msgstr "အပ်ဒိတ်စစ်ဆေးရာတွင် ချို့ယွင်းချက်ဖြစ်ပေါ်နေပါသည်။"

msgid "Check for update exceptions,fix system APT environment error."
msgstr ""
"အပ်ဒိတ်စစ်ဆေးရာတွင် ချို့ယွင်းချက်ဖြစ်ပေါ်နေပြီး၊ စနစ် APT ပတ်ဝန်းကျင်ကို "
"ပြင်ဆင်ရာတွင် အမှားပြနေပါသည်။"

msgid "The system APT environment is abnormal, please check the system APT environment."
msgstr ""
"စနစ် APT ပတ်ဝန်းကျင် ပြင်ဆင်ရာတွင် ချို့ယွင်းချက်ဖြစ်ပေါ်နေပါသည်၊ ကျေးဇူးပြု၍"
" စနစ် APT ပတ်ဝန်းကျင်ကို စစ်ဆေးပါ။"

msgid "Priority upgrade status exception."
msgstr "ဦးစားပေးအဆင့်မြှင့်တင်မှု အခြေအနေတွင် ချို့ယွင်းချက်ရှိနေပါသည်။"

msgid "Upgrade configuration acquisition exception."
msgstr ""
"အဆင့်မြှင့်တင်မှု ပြင်ဆင်ချက်များ ရယူရာတွင် ချို့ယွင်းချက်ဖြစ်ပေါ်နေပါသည်။"

msgid "Please check your network connection and retry."
msgstr "ကျေးဇူးပြု၍ သင့်ကွန်ရက်ချိတ်ဆက်မှုကို စစ်ဆေးပြီးမှ ထပ်မံကြိုးစားပါ။"

msgid "Please check your source list and retry."
msgstr "ကျေးဇူးပြု၍ သင့်ရင်းမြစ်စာရင်းကို စစ်ဆေးပြီးမှ ထပ်မံကြိုးစားပါ။"

msgid "Checking network connection"
msgstr "ကွန်ရက်ချိတ်ဆက်မှုကို စစ်ဆေးနေပါသည်။"

msgid "Updating Source Template"
msgstr "ရင်းမြစ်ပုံစံခွက်ကို အပ်ဒိတ်လုပ်နေပါသည်။"

msgid "Update Manager upgrade is complete, please restart the setting panel before performing the system update."
msgstr ""
"အပ်ဒိတ်မန်နေဂျာ အဆင့်မြှင့်တင်မှု ပြီးဆုံးပါပြီ၊ ကျေးဇူးပြု၍ "
"ဆက်တင်များ-အပ်ဒိတ် ကို ပြန်လည်စတင်ပြီးမှ စနစ်အပ်ဒိတ်ကို ဆက်လက်လုပ်ဆောင်ပါ။"

msgid "Update Manager exception, please restart the setting panel before performing the system update."
msgstr ""
"အပ်ဒိတ်မန်နေဂျာတွင် ချို့ယွင်းချက်ရှိနေပါသည်၊ ကျေးဇူးပြု၍ ဆက်တင်များ-အပ်ဒိတ် "
"ကို ပြန်လည်စတင်ပြီးမှ စနစ်အပ်ဒိတ်ကို ဆက်လက်လုပ်ဆောင်ပါ။"

msgid "Uninstallation completed"
msgstr "ဖယ်ရှားမှု ပြီးဆုံးပါပြီ။"

msgid "Package validation failed and installation was rejected."
msgstr ""
"ဆော့ဖ်ဝဲပက်ကေ့ဂျ် စိစစ်အတည်ပြုမှု မအောင်မြင်ပါ၊ အင်စတောလုပ်ဆောင်ရန် "
"ငြင်းပယ်ပါသည်။"

msgid "Other tasks are being updated and upgraded, please uninstall them later."
msgstr ""
"အခြားတာဝန်များသည် အပ်ဒိတ်နှင့် အဆင့်မြှင့်တင်မှု လုပ်ဆောင်နေဆဲဖြစ်ပါသည်၊ "
"ကျေးဇူးပြု၍ နောက်မှ ဖယ်ရှားပါ။"

#: ../aptdaemon/worker/aptworker.py:1353
msgid "The following packages have unmet dependencies:"
msgstr "အောက်ပါဆော့ဖ်ဝဲပက်ကေ့ဂျ်များ၏ မပြည့်မီသော မှီခိုမှုဆက်နွယ်ချက်များ-"

#: ../aptdaemon/worker/aptworker.py:1406
msgid "but it is a virtual package"
msgstr "သို့သော် ၎င်းသည် ဗာချူဝယ်ဆော့ဖ်ဝဲပက်ကေ့ဂျ် ဖြစ်ပါသည်။"

#: ../aptdaemon/worker/aptworker.py:1409
msgid "but it is not installed"
msgstr "သို့သော် %s ကို အင်စတောလုပ်ဆောင်ထားခြင်း မရှိပါ။"

#: ../aptdaemon/worker/aptworker.py:1411
msgid "but it is not going to be installed"
msgstr "သို့သော် %s ကို အင်စတောလုပ်ဆောင်၍ မရပါ။"

