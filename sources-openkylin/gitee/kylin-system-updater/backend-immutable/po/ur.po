msgid "Unable to access the source management server, please try again later"
msgstr ""
"سورس مینجمنٹ سرور تک رسائی ممکن نہیں، براہ کرم بعد میں دوبارہ کوشش کریں۔"

msgid "Access to the source management server timed out, please try again later"
msgstr ""
"سورس مینجمنٹ سرور تک رسائی کا وقت ختم ہو گیا، براہ کرم بعد میں دوبارہ کوشش "
"کریں۔"

msgid "Check if your network requires authentication?"
msgstr "کیا آپ کے نیٹ ورک کو توثیق کی ضرورت ہے؟"

msgid "Check your source public key signature"
msgstr "اپنے سورس کے ڈیجیٹل دستخط چیک کریں۔"

msgid "update important list occur Exception"
msgstr "پش حاصل کرنے میں خرابی پیش آئی، براہ کرم بعد میں دوبارہ کوشش کریں۔"

msgid "You need to be root to run this application"
msgstr "اسے چلانے کے لیے آپ کو روٹ مراعات کی ضرورت ہے۔"

msgid "There is an exception in the update package."
msgstr "اپڈیٹ پیکج میں خرابی موجود ہے!"

msgid "You request the removal of a system-essential package."
msgstr "آپ نے سسٹم کے ایک ضروری پیکج کو حذف کرنے کی درخواست کی ہے۔"

msgid "This update cannot detect the upgradeable package."
msgstr "اس اپڈیٹ میں اپ گریڈ کے قابل پیکجز کا پتہ نہیں چل سکا۔"

msgid "read important list failed"
msgstr "پش اپ گریڈ کی فہرست پڑھنے سے قاصر، براہ کرم بعد میں دوبارہ کوشش کریں۔"

msgid "Priority Upgrade Package being updated"
msgstr "گروپ کنفیگریشن اپ ڈیٹ کی جا رہی ہے۔"

msgid "Exceptions of Priority Upgrade."
msgstr "ترجیحی اپ گریڈ میں خرابی۔"

msgid "Due to the presence of deleted packages."
msgstr "حذف شدہ پیکجز کی موجودگی کی وجہ سے۔"

msgid "The system update configuration file is read abnormally, please check if the system update configuration file format is correct."
msgstr ""
"سسٹم اپڈیٹ کنفیگریشن فائل پڑھنے میں خرابی، براہ کرم چیک کریں کہ سسٹم اپڈیٹ "
"کنفیگریشن فائل کی فارمیٹ درست ہے یا نہیں۔"

msgid "Installation progress: "
msgstr "انسٹالیشن کی پیشرفت: "

msgid "Installation successful, about to shut down"
msgstr "انسٹالیشن کامیاب، عنقریب شٹ ڈاؤن ہو گا۔"

msgid "Installation failed, about to shut down"
msgstr "انسٹالیشن ناکام، عنقریب شٹ ڈاؤن ہو گا۔"

msgid "groups JSON ConfigPkgs install failed"
msgstr "گروپ کنفیگریشن فائل انسٹال کرنے سے قاصر۔"

msgid "Installtion timeout to exit Due to inactivity"
msgstr "انسٹالیشن ٹائم آؤٹ کی وجہ سے بند ہو گیا۔"

msgid "Command execution error"
msgstr "کمانڈ پر عملدرآمد میں خرابی۔"

msgid "Unsupported architecture"
msgstr "آرکیٹیکچر مطابقت نہیں رکھتا۔"

msgid "Other Error"
msgstr "دیگر خرابیاں۔"

msgid "dependency is not satisfied"
msgstr "ڈپینڈینسیز پوری نہیں ہوئیں۔"

msgid "dependency is not satisfied will download"
msgstr "ڈپینڈینسیز پوری نہیں ہوئیں۔"

msgid "Disk space is insufficient, please clean the disk and then upgrade"
msgstr "ڈسک کی جگہ ناکافی ہے، براہ کرم اپ گریڈ کرنے سے پہلے ڈسک کو صاف کریں۔"

msgid "Network anomaly, can't check for updates!"
msgstr "نیٹ ورک میں خرابی، اپڈیٹس چیک کرنے سے قاصر!"

msgid "Check for update exceptions!"
msgstr "اپڈیٹس چیک کرنے میں خرابی!"

msgid "Check for update exceptions,fix system APT environment error."
msgstr ""
"اپڈیٹس چیک کرنے میں خرابی، سسٹم APT ماحول کی مرمت کے دوران خرابی پیش آئی۔"

msgid "The system APT environment is abnormal, please check the system APT environment."
msgstr "سسٹم APT ماحول کی مرمت میں خرابی، براہ کرم سسٹم APT ماحول چیک کریں۔"

msgid "Priority upgrade status exception."
msgstr "ترجیحی اپ گریڈ کی حالت میں خرابی۔"

msgid "Upgrade configuration acquisition exception."
msgstr "اپ گریڈ کنفیگریشن حاصل کرنے میں خرابی۔"

msgid "Please check your network connection and retry."
msgstr "براہ کرم اپنا نیٹ ورک کنکشن چیک کریں اور دوبارہ کوشش کریں۔"

msgid "Please check your source list and retry."
msgstr "براہ کرم اپنی سورس لسٹ چیک کریں اور دوبارہ کوشش کریں۔"

msgid "Checking network connection"
msgstr "نیٹ ورک کنکشن چیک کیا جا رہا ہے۔"

msgid "Updating Source Template"
msgstr "سورس ٹیمپلیٹ اپ ڈیٹ کیا جا رہا ہے۔"

msgid "Update Manager upgrade is complete, please restart the setting panel before performing the system update."
msgstr ""
"اپڈیٹ مینیجر کی اپ گریڈ مکمل ہو گئی، براہ کرم سسٹم اپڈیٹ کرنے سے پہلے سیٹنگز-"
"اپڈیٹ کو دوبارہ شروع کریں۔"

msgid "Update Manager exception, please restart the setting panel before performing the system update."
msgstr ""
"اپڈیٹ مینیجر میں خرابی، براہ کرم سسٹم اپڈیٹ کرنے سے پہلے سیٹنگز-اپڈیٹ کو "
"دوبارہ شروع کریں۔"

msgid "Uninstallation completed"
msgstr "ان انسٹالیشن مکمل ہو گئی۔"

msgid "Package validation failed and installation was rejected."
msgstr "پیکج کی تصدیق ناکام، انسٹالیشن مسترد کر دی گئی۔"

msgid "Other tasks are being updated and upgraded, please uninstall them later."
msgstr ""
"دیگر ٹاسکس اپڈیٹ اور اپ گریڈ ہو رہے ہیں، براہ کرم بعد میں ان انسٹال کریں۔"

#: ../aptdaemon/worker/aptworker.py:1353
msgid "The following packages have unmet dependencies:"
msgstr "درج ذیل پیکجز کے لیے غیر پوری شدہ ڈپینڈینسیز:"

#: ../aptdaemon/worker/aptworker.py:1406
msgid "but it is a virtual package"
msgstr "لیکن یہ ایک ورچوئل پیکج ہے۔"

#: ../aptdaemon/worker/aptworker.py:1409
msgid "but it is not installed"
msgstr "لیکن %s انسٹال نہیں ہے۔"

#: ../aptdaemon/worker/aptworker.py:1411
msgid "but it is not going to be installed"
msgstr "لیکن %s انسٹال کرنے سے قاصر۔"

#. TRANSLATORS: %s is a version number
#: ../aptdaemon/worker/aptworker.py:1415
#, python-format
msgid "but %s is installed"
msgstr "لیکن %s پہلے سے انسٹال ہے۔"

#. TRANSLATORS: %s is a version number
#: ../aptdaemon/worker/aptworker.py:1419
#, python-format
msgid "but %s is to be installed"
msgstr "لیکن %s انسٹال کیا جائے گا۔"

#: ../SystemUpdater/Core/enums.py:763
msgid "Kylin System Updater"
msgstr "کیولن اپڈیٹر"

#: ../SystemUpdater/Core/enums.py:609
msgid "Kylin Installer"
msgstr "کیولن انسٹالر"

#: ../SystemUpdater/Core/enums.py:610
msgid "Kylin Uninstaller"
msgstr "کیولن ان انسٹالر"

#: ../SystemUpdater/Core/enums.py:611
msgid "Kylin Background Upgrade"
msgstr "خاموش اپڈیٹ"

#: ../SystemUpdater/Core/enums.py:612
msgid "Kylin Software Center"
msgstr "سافٹ ویئر اسٹور"

#: ../SystemUpdater/UpdateManagerDbus.py:355
msgid " requires authentication to uninstall software packages."
msgstr " پیکج کو ان انسٹال کرنے کے لیے تصدیق درکار ہے"

#. 验签失败，提权
#: ../SystemUpdater/UpdateManager.py:463
msgid " requires authentication to install software packages."
msgstr " پیکج انسٹال کرنے کے لیے تصدیق درکار ہے"

#: ../SystemUpdater/Core/utils.py:750
msgid "Authentication success."
msgstr "تصدیق کامیاب"

#: ../SystemUpdater/Core/utils.py:753
msgid "Authentication failure."
msgstr "تصدیق ناکام"

#: ../SystemUpdater/Core/enums.py:101
msgid "Deb format exception, read local deb file error."
msgstr "پیکج کا فارمیٹ غیر معمولی ہے، پڑھنے میں ناکامی۔"

#: ../SystemUpdater/Core/enums.py:102
msgid "Install deb error."
msgstr "پیکج انسٹال کرنے میں ناکامی۔"

msgid "Upgrade System"
msgstr "مکمل اپ گریڈ"

msgid "kylin-unattended-upgrade"
msgstr "خودکار اپ ڈیٹ"

msgid "Please check the system time and synchronize the system time before updating."
msgstr ""
"براہ کرم سسٹم کا وقت چیک کریں، اپ ڈیٹ کرنے سے پہلے سسٹم کے وقت کو مطابقت "
"پذیر بنائیں۔"

msgid "The package is unsigned, refuses to install."
msgstr "پیکج دستخط شدہ نہیں ہے، انسٹالیشن مسترد کر دی گئی۔"

msgid "Program exception, please contact the administrator to solve."
msgstr ""
"پروگرام کا اجرا غیر معمولی ہے، براہ کرم حل کے لیے ایڈمنسٹریٹر سے رابطہ کریں۔"

msgid "Exceptions to running the check script."
msgstr "چیک اسکرپٹ چلاتے وقت غیر معمولی خرابی پیش آئی۔"

msgid "Installing or removing software packages."
msgstr "پیکجز انسٹال یا حذف کیے جا رہے ہیں۔"

msgid "The system is installing updates. Please do not turn off your computer. "
msgstr "سسٹم اپ ڈیٹس انسٹال کر رہا ہے، براہ کرم کمپیوٹر بند نہ کریں۔ "

msgid "If the device is less than 50% charged, please charge it before updating the system."
msgstr ""
"ڈیوائس کی بیٹری 50% سے کم ہے، براہ کرم سسٹم اپ ڈیٹ کرنے سے پہلے چارج کریں۔"

msgid "Application installation control policy not enabled ."
msgstr "ایپ انسٹالیشن کنٹرول فعال نہیں ہے۔"

msgid "Installation failed! Application is not in the software whitelist list!"
msgstr "انسٹالیشن ناکام! پیکج وائٹ لسٹ میں نہیں ہے!"

msgid "Installation failed! Application is in the software blacklist list!"
msgstr "انسٹالیشن ناکام! پیکج بلیک لسٹ میں ہے!"

msgid "Application installation in unknown mode ."
msgstr "ایپ انسٹالیشن کنٹرول پالیسی نامعلوم ہے۔"

msgid "Other tasks are being updated and upgraded, please try again later."
msgstr ""
"دیگر ٹاسکس اپ ڈیٹ اور اپ گریڈ ہو رہے ہیں، براہ کرم بعد میں دوبارہ کوشش کریں"

msgid "Cancel Upgrade"
msgstr "اپ گریڈ منسوخ کریں"

msgid "There is no way to rollback to the previous version, there is nothing to rollback."
msgstr ""
"پچھلے ورژن پر واپس نہیں جا سکتے، رول بیک کے لیے کوئی مواد دستیاب نہیں ہے۔"

msgid "Check for update exceptions! Please verify that the system deployment is complete."
msgstr ""
"اپ ڈیٹ چیک کرنے میں خرابی! براہ کرم چیک کریں کہ سسٹم کی ڈپلائمنٹ مکمل ہے یا "
"نہیں۔"

msgid "Update push is abnormal, and the corresponding branch information cannot be found on the server."
msgstr "اپ ڈیٹ پش میں خرابی، سرور پر متعلقہ برانچ کی معلومات نہیں ملیں۔"

msgid "Name of the repository deployed by the current system is empty."
msgstr ""
"اپ ڈیٹ چیک کرنے میں خرابی، موجودہ سسٹم ڈپلائمنٹ برانچ ریپوزٹری کی ملکیت کی "
"معلومات خالی ہیں۔"

#: ../SystemUpdater/Core/utils.py:753
msgid "Cancel authentication."
msgstr "تصدیق منسوخ کریں"

msgid "System upgrade error"
msgstr "سسٹم اپ ڈیٹ میں خرابی"

msgid "The installation process is abnormally shut down or down."
msgstr "انسٹالیشن کے عمل کے دوران غیر معمولی شٹ ڈاؤن یا کریش پیش آیا۔"

msgid "The new version of the system is deployed abnormally and cannot be upgraded."
msgstr "نئے ورژن کی سسٹم ڈپلائمنٹ غیر معمولی ہے، اپ گریڈ نہیں کیا جا سکتا۔"

msgid "The system update is successful and your computer will reboot in %s s"
msgstr "سسٹم اپ ڈیٹ کامیاب، آپ کا کمپیوٹر %s سیکنڈ میں دوبارہ شروع ہو جائے گا۔"

msgid "System update is abnormal and your computer will reboot in %s s"
msgstr ""
"سسٹم اپ ڈیٹ میں خرابی، آپ کا کمپیوٹر %s سیکنڈ میں دوبارہ شروع ہو جائے گا۔"

msgid "The system update is successful and your computer will shutdown in %s s"
msgstr "سسٹم اپ ڈیٹ کامیاب، آپ کا کمپیوٹر %s سیکنڈ میں بند ہو جائے گا۔"

msgid "System update is abnormal and your computer will shutdown in %s s"
msgstr "سسٹم اپ ڈیٹ میں خرابی، آپ کا کمپیوٹر %s سیکنڈ میں بند ہو جائے گا۔"
