#. TRANSLATORS: download size of updates, e.g. "2.3 MB"
#: ../DistUpgrade/utils.py:436 ../UpdateManager/Core/utils.py:436
#, python-format
msgid "%.1f MB"
msgstr ""

#. TRANSLATORS: %s is a country
#: ../DistUpgrade/distro.py:206 ../DistUpgrade/distro.py:436
#, python-format
msgid "Server for %s"
msgstr "Servidor de %s"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../DistUpgrade/distro.py:224 ../DistUpgrade/distro.py:230
#: ../DistUpgrade/distro.py:246
msgid "Main server"
msgstr "Servidor principal"

#: ../DistUpgrade/distro.py:250
msgid "Custom servers"
msgstr "Servidor personalizado"

#: ../DistUpgrade/DistUpgradeAptCdrom.py:142
msgid "Could not calculate sources.list entry"
msgstr "No se pueden calcular las entradas de sources.list"

#: ../DistUpgrade/DistUpgradeAptCdrom.py:251
msgid ""
"Unable to locate any package files, perhaps this is not a Ubuntu Disc or the "
"wrong architecture?"
msgstr ""
"No se ha podido localizar ningún archivo de paquete. ¿Quizás este no es un "
"CD de Ubuntu o su arquitectura es incorrecta?"

#: ../DistUpgrade/DistUpgradeAptCdrom.py:294
msgid "Failed to add the CD"
msgstr "Error al añadir el CD"

#: ../DistUpgrade/DistUpgradeAptCdrom.py:295
#, python-format
msgid ""
"There was a error adding the CD, the upgrade will abort. Please report this "
"as a bug if this is a valid Ubuntu CD.\n"
"\n"
"The error message was:\n"
"'%s'"
msgstr ""
"Error al añadir el CD, actualización cancelada. Si este es un CD de Ubuntu "
"válido, por favor informe de este error.\n"
"\n"
"El mensaje de error es:\n"
"'%s'"

#: ../DistUpgrade/DistUpgradeCache.py:151
msgid "Remove package in bad state"
msgid_plural "Remove packages in bad state"
msgstr[0] "Desinstalar paquetes en estado anómalo"
msgstr[1] ""

#: ../DistUpgrade/DistUpgradeCache.py:154
#, python-format
msgid ""
"The package '%s' is in an inconsistent state and needs to be reinstalled, "
"but no archive can be found for it. Do you want to remove this package now "
"to continue?"
msgid_plural ""
"The packages '%s' are in an inconsistent state and need to be reinstalled, "
"but no archives can be found for them. Do you want to remove these packages "
"now to continue?"
msgstr[0] ""
"El paquete «%s» está en un estado inconsistente y necesita ser reinstalado, "
"pero no se ha encontrado el archivo correspondiente. ¿Desea eliminar este "
"paquete ahora para continuar?"
msgstr[1] ""

#. FIXME: not ideal error message, but we just reuse a
#. existing one here to avoid a new string
#: ../DistUpgrade/DistUpgradeCache.py:255
msgid "The server may be overloaded"
msgstr "El servidor podría estar sobrecargado"

#: ../DistUpgrade/DistUpgradeCache.py:368
msgid "Broken packages"
msgstr "Paquetes rotos"

#: ../DistUpgrade/DistUpgradeCache.py:369
msgid ""
"Your system contains broken packages that couldn't be fixed with this "
"software. Please fix them first using synaptic or apt-get before proceeding."
msgstr ""
"Su sistema contiene paquetes rotos que este software no puede reparar. Por "
"favor, repárelos con Synaptic o apt-get antes de continuar."

#. FIXME: change the text to something more useful
#: ../DistUpgrade/DistUpgradeCache.py:693
#, python-format
msgid ""
"An unresolvable problem occurred while calculating the upgrade:\n"
"%s\n"
"\n"
" This can be caused by:\n"
" * Upgrading to a pre-release version of Ubuntu\n"
" * Running the current pre-release version of Ubuntu\n"
" * Unofficial software packages not provided by Ubuntu\n"
"\n"
msgstr ""
"Ha ocurrido un problema irresoluble al preparar la actualización:\n"
"%s\n"
"\n"
" Esto podría deberse a las siguientes causas:\n"
" * Actualización a una versión preliminar de Ubuntu\n"
" * Ejecución de una versión preliminar actual de Ubuntu\n"
" * Paquetes no oficiales no proporcionados por Ubuntu\n"
"\n"

#: ../DistUpgrade/DistUpgradeCache.py:703
msgid "This is most likely a transient problem, please try again later."
msgstr ""
"Es muy probable que haya ocurrido un problema de transmisión. Por favor, "
"inténtelo de nuevo más tarde."

#: ../DistUpgrade/DistUpgradeCache.py:706
msgid ""
"If none of this applies, then please report this bug using the command "
"'ubuntu-bug update-manager' in a terminal."
msgstr ""
"Si no se ha aplicado ningún cambio, puede informar de este error "
"introduciendo el comando 'ubuntu-bug update-manager' en la terminal."

#: ../DistUpgrade/DistUpgradeCache.py:711
#: ../UpdateManager/UpdateManager.py:1031
msgid "Could not calculate the upgrade"
msgstr "No se puede calcular la actualización"

#: ../DistUpgrade/DistUpgradeCache.py:762
msgid "Error authenticating some packages"
msgstr "Error en la autenticación de algunos paquetes"

#: ../DistUpgrade/DistUpgradeCache.py:763
msgid ""
"It was not possible to authenticate some packages. This may be a transient "
"network problem. You may want to try again later. See below for a list of "
"unauthenticated packages."
msgstr ""
"Algunos paquetes no han podido superar la verificación de firma. Esto podría "
"ser un problema temporal de red, puede intentarlo de nuevo más tarde. A "
"continuación se muestra la lista de paquetes no autenticados."

#: ../DistUpgrade/DistUpgradeCache.py:783
#, python-format
msgid ""
"The package '%s' is marked for removal but it is in the removal blacklist."
msgstr ""
"El paquete «%s» está marcado para ser eliminado, pero se encuentra en la "
"lista negra de eliminaciones."

#: ../DistUpgrade/DistUpgradeCache.py:787
#, python-format
msgid "The essential package '%s' is marked for removal."
msgstr "El paquete esencial «%s» está marcado para ser eliminado."

#: ../DistUpgrade/DistUpgradeCache.py:796
#, python-format
msgid "Trying to install blacklisted version '%s'"
msgstr "Intento de instalar la versión «%s» de la lista negra"

#: ../DistUpgrade/DistUpgradeCache.py:914
#, python-format
msgid "Can't install '%s'"
msgstr "No se puede instalar '%s'"

#: ../DistUpgrade/DistUpgradeCache.py:915
msgid ""
"It was impossible to install a required package. Please report this as a bug "
"using 'ubuntu-bug update-manager' in a terminal."
msgstr ""
"No se ha podido instalar un paquete esencial. Por favor, informe de este "
"error introduciendo el comando 'ubuntu-bug update-manager' en la terminal."

#. FIXME: provide a list
#: ../DistUpgrade/DistUpgradeCache.py:926
msgid "Can't guess meta-package"
msgstr "No se puede adivinar el metapaquete"

#: ../DistUpgrade/DistUpgradeCache.py:927
msgid ""
"Your system does not contain a ubuntu-desktop, kubuntu-desktop, xubuntu-"
"desktop or edubuntu-desktop package and it was not possible to detect which "
"version of Ubuntu you are running.\n"
" Please install one of the packages above first using synaptic or apt-get "
"before proceeding."
msgstr ""
"Su sistema no tiene instalado el paquete ubuntu-desktop, kubuntu-desktop o "
"eubuntu-desktop, por lo que no se puede determinar la versión de Ubuntu en "
"ejecución.\n"
" Por favor, instale primero uno de los paquetes mencionados usando Synaptic "
"o APT."

#: ../DistUpgrade/DistUpgradeController.py:114
msgid "Reading cache"
msgstr "Leyendo la caché"

#: ../DistUpgrade/DistUpgradeController.py:223
msgid "Unable to get exclusive lock"
msgstr "No se ha podido obtener el bloqueo exclusivo"

#: ../DistUpgrade/DistUpgradeController.py:224
msgid ""
"This usually means that another package management application (like apt-get "
"or aptitude) already running. Please close that application first."
msgstr ""
"Esto suele significar que otro gestor de paquetes (como apt-get o aptitude) "
"se está ejecutando. Por favor, cierre primero ese programa."

#: ../DistUpgrade/DistUpgradeController.py:257
msgid "Upgrading over remote connection not supported"
msgstr "No se admite la actualización mediante conexión remota"

#: ../DistUpgrade/DistUpgradeController.py:258
msgid ""
"You are running the upgrade over a remote ssh connection with a frontend "
"that does not support this. Please try a text mode upgrade with 'do-release-"
"upgrade'.\n"
"\n"
"The upgrade will abort now. Please try without ssh."
msgstr ""
"Está actualizando mediante SSH remoto, y la interfaz no admite este método. "
"Por favor, intente actualizar en modo texto mediante el comando 'do-release-"
"upgrade'.\n"
"\n"
"La actualización se cerrará ahora. Por favor, inténtelo sin usar ssh."

#: ../DistUpgrade/DistUpgradeController.py:272
msgid "Continue running under SSH?"
msgstr "¿Continuar la ejecución bajo SSH?"

#: ../DistUpgrade/DistUpgradeController.py:273
#, python-format
msgid ""
"This session appears to be running under ssh. It is not recommended to "
"perform a upgrade over ssh currently because in case of failure it is harder "
"to recover.\n"
"\n"
"If you continue, an additional ssh daemon will be started at port '%s'.\n"
"Do you want to continue?"
msgstr ""
"Esta sesión parece estar ejecutándose bajo SSH. Actualmente no se recomienda "
"realizar la actualización a través de SSH, ya que es más difícil de "
"recuperar en caso de fallo.\n"
"\n"
"Si elige continuar, se establecerá un demonio SSH adicional en el puerto "
"'%s'.\n"
"¿Desea continuar?"

#: ../DistUpgrade/DistUpgradeController.py:287
msgid "Starting additional sshd"
msgstr "Habilitando el demonio ssh adicional"

#: ../DistUpgrade/DistUpgradeController.py:288
#, python-format
msgid ""
"To make recovery in case of failure easier, an additional sshd will be "
"started on port '%s'. If anything goes wrong with the running ssh you can "
"still connect to the additional one.\n"
msgstr ""
"Para facilitar la recuperación en caso de fallo, se abrirá un demonio ssh "
"adicional en el puerto «%s». Si el ssh actualmente en ejecución sufre un "
"error, aún podrá conectarse a través de este ssh adicional.\n"

#: ../DistUpgrade/DistUpgradeController.py:296
#, python-format
msgid ""
"If you run a firewall, you may need to temporarily open this port. As this "
"is potentially dangerous it's not done automatically. You can open the port "
"with e.g.:\n"
"'%s'"
msgstr ""
"Si está ejecutando un cortafuegos, es posible que necesite abrir este puerto "
"temporalmente. Esto puede ser algo peligroso, por lo que no se ha realizado "
"automáticamente. Puede abrir el puerto con un comando similar a este:\n"
"%s"

#: ../DistUpgrade/DistUpgradeController.py:368
#: ../DistUpgrade/DistUpgradeController.py:413
msgid "Can not upgrade"
msgstr "No se puede actualizar"

#: ../DistUpgrade/DistUpgradeController.py:369
#, python-format
msgid "An upgrade from '%s' to '%s' is not supported with this tool."
msgstr "Esta herramienta no admite la actualización de '%s' a ‘%s'."

#: ../DistUpgrade/DistUpgradeController.py:378
msgid "Sandbox setup failed"
msgstr "Error al instalar el sandbox"

#: ../DistUpgrade/DistUpgradeController.py:379
msgid "It was not possible to create the sandbox environment."
msgstr "No se puede crear el entorno sandbox"

#: ../DistUpgrade/DistUpgradeController.py:385
msgid "Sandbox mode"
msgstr "Modo sandbox"

#: ../DistUpgrade/DistUpgradeController.py:386
#, python-format
msgid ""
"This upgrade is running in sandbox (test) mode. All changes are written to "
"'%s' and will be lost on the next reboot.\n"
"\n"
"*No* changes written to a system directory from now until the next reboot "
"are permanent."
msgstr ""
"Esta actualización se ejecuta en modo sandbox (pruebas), todos los cambios "
"se escribirán en '%s' y se perderán tras reiniciar.\n"
"\n"
"A partir de ahora, los cambios en los directorios del sistema *dejarán de "
"existir* tras reiniciar."

#: ../DistUpgrade/DistUpgradeController.py:414
msgid ""
"Your python install is corrupted. Please fix the '/usr/bin/python' symlink."
msgstr ""
"Su instalación de python es incorrecta, por favor corrija el enlace "
"simbólico «/usr/bin/python»."

#: ../DistUpgrade/DistUpgradeController.py:440
msgid "Package 'debsig-verify' is installed"
msgstr "Paquete «debsig-verify» instalado"

#: ../DistUpgrade/DistUpgradeController.py:441
msgid ""
"The upgrade can not continue with that package installed.\n"
"Please remove it with synaptic or 'apt-get remove debsig-verify' first and "
"run the upgrade again."
msgstr ""
"No se puede continuar con la actualización debido a que el paquete "
"mencionado está instalado.\n"
"Por favor, use el gestor de paquetes Synaptic para eliminarlo, o "
"desinstálelo primero usando «sudo apt-get remove debsig-verify» y vuelva a "
"intentar la actualización."

#: ../DistUpgrade/DistUpgradeController.py:453
#, python-format
msgid "Can not write to '%s'"
msgstr "No se puede escribir en '%s'"

#: ../DistUpgrade/DistUpgradeController.py:454
#, python-format
msgid ""
"Its not possible to write to the system directory '%s' on your system. The "
"upgrade can not continue.\n"
"Please make sure that the system directory is writable."
msgstr ""
"No se puede escribir en su directorio de sistema %s, la actualización no "
"puede continuar.\n"
"Por favor, asegúrese de que el directorio del sistema tenga permisos de "
"escritura."

#: ../DistUpgrade/DistUpgradeController.py:465
msgid "Include latest updates from the Internet?"
msgstr "¿Incluir las últimas actualizaciones desde la red?"

#: ../DistUpgrade/DistUpgradeController.py:466
msgid ""
"The upgrade system can use the internet to automatically download the latest "
"updates and install them during the upgrade.  If you have a network "
"connection this is highly recommended.\n"
"\n"
"The upgrade will take longer, but when it is complete, your system will be "
"fully up to date.  You can choose not to do this, but you should install the "
"latest updates soon after upgrading.\n"
"If you answer 'no' here, the network is not used at all."
msgstr ""
"La actualización del sistema puede descargar e instalar automáticamente los "
"archivos de actualización más recientes desde la red. Si hay conexión de red "
"disponible, se recomienda encarecidamente activar esta opción.\n"
"\n"
"El tiempo de actualización puede aumentar, pero al finalizar, su sistema "
"estará actualizado. También puede elegir actualizar el sistema después de "
"que termine la actualización.\n"
"Si elige \"No\", no se usará la red."

#: ../DistUpgrade/DistUpgradeController.py:686
#, python-format
msgid "disabled on upgrade to %s"
msgstr "Se ha deshabilitado la actualización a %s"

#: ../DistUpgrade/DistUpgradeController.py:713
msgid "No valid mirror found"
msgstr "No se ha encontrado ninguna réplica disponible"

#: ../DistUpgrade/DistUpgradeController.py:714
#, python-format
msgid ""
"While scanning your repository information no mirror entry for the upgrade "
"was found. This can happen if you run a internal mirror or if the mirror "
"information is out of date.\n"
"\n"
"Do you want to rewrite your 'sources.list' file anyway? If you choose 'Yes' "
"here it will update all '%s' to '%s' entries.\n"
"If you select 'No' the upgrade will cancel."
msgstr ""
"No se ha encontrado información de actualización al escanear los "
"repositorios. Es posible que esté utilizando una réplica interna o que la "
"información de la réplica haya caducado.\n"
"\n"
"¿Desea reescribir el archivo \"sources.list\" de todos modos? Si elige \"Sí\""
", se actualizarán todos los \"%s\" a \"%s\"."

#. hm, still nothing useful ...
#: ../DistUpgrade/DistUpgradeController.py:734
msgid "Generate default sources?"
msgstr "¿Generar los orígenes predeterminados?"

#: ../DistUpgrade/DistUpgradeController.py:735
#, python-format
msgid ""
"After scanning your 'sources.list' no valid entry for '%s' was found.\n"
"\n"
"Should default entries for '%s' be added? If you select 'No', the upgrade "
"will cancel."
msgstr ""
"No se han encontrado entradas disponibles para \"%s\" tras escanear \"sources"
".list\".\n"
"\n"
"¿Desea añadir las entradas predeterminadas para \"%s\"? Si elige \"No\", se "
"cancelará la actualización."

#: ../DistUpgrade/DistUpgradeController.py:770
msgid "Repository information invalid"
msgstr "Información de repositorio no válida"

#: ../DistUpgrade/DistUpgradeController.py:771
msgid ""
"Upgrading the repository information resulted in a invalid file so a bug "
"reporting process is being started."
msgstr ""
"Se ha devuelto un archivo no válido al actualizar los orígenes de software. "
"Se ha iniciado el proceso de informe de errores."

#: ../DistUpgrade/DistUpgradeController.py:778
msgid "Third party sources disabled"
msgstr "Orígenes de terceros deshabilitados"

#: ../DistUpgrade/DistUpgradeController.py:779
msgid ""
"Some third party entries in your sources.list were disabled. You can re-"
"enable them after the upgrade with the 'software-properties' tool or your "
"package manager."
msgstr ""
"Algunos orígenes de terceros en su sources.list están deshabilitados. Puede "
"volver a habilitarlos después de la actualización utilizando la herramienta "
"\"Orígenes de software\" o el gestor de paquetes."

#: ../DistUpgrade/DistUpgradeController.py:819
msgid "Package in inconsistent state"
msgid_plural "Packages in inconsistent state"
msgstr[0] "Conflicto de paquetes"
msgstr[1] ""

#: ../DistUpgrade/DistUpgradeController.py:822
#, python-format
msgid ""
"The package '%s' is in an inconsistent state and needs to be reinstalled, "
"but no archive can be found for it. Please reinstall the package manually or "
"remove it from the system."
msgid_plural ""
"The packages '%s' are in an inconsistent state and need to be reinstalled, "
"but no archive can be found for them. Please reinstall the packages manually "
"or remove them from the system."
msgstr[0] ""
"El paquete \"%s\" está en estado de conflicto y necesita ser reinstalado, "
"pero no se ha podido encontrar su archivo. Por favor, reinstale este paquete "
"manualmente o elimínelo del sistema."
msgstr[1] ""

#: ../DistUpgrade/DistUpgradeController.py:870
msgid "Error during update"
msgstr "Error durante la actualización"

#: ../DistUpgrade/DistUpgradeController.py:871
msgid ""
"A problem occurred during the update. This is usually some sort of network "
"problem, please check your network connection and retry."
msgstr ""
"Error durante el proceso de actualización. Esto suele deberse a problemas de "
"red. Por favor, compruebe su conexión de red e inténtelo de nuevo."

#. print("on_button_install_clicked")
#: ../DistUpgrade/DistUpgradeController.py:880
#: ../UpdateManager/UpdateManager.py:757
msgid "Not enough free disk space"
msgstr "Espacio en disco insuficiente"

#: ../DistUpgrade/DistUpgradeController.py:881
#, python-format
msgid ""
"The upgrade has aborted. The upgrade needs a total of %s free space on disk "
"'%s'. Please free at least an additional %s of disk space on '%s'. Empty "
"your trash and remove temporary packages of former installations using 'sudo "
"apt-get clean'."
msgstr ""
"La actualización ha sido interrumpida. Esta actualización requiere %s de "
"espacio libre en el disco %s. Por favor, libere al menos %s de espacio en el "
"disco %s. Puede vaciar la papelera y usar el comando \"sudo apt-get clean\" "
"para eliminar los archivos temporales de instalaciones anteriores."

#. calc the dist-upgrade and see if the removals are ok/expected
#. do the dist-upgrade
#: ../DistUpgrade/DistUpgradeController.py:910
#: ../DistUpgrade/DistUpgradeController.py:1692
msgid "Calculating the changes"
msgstr "Calculando los cambios"

#. ask the user
#: ../DistUpgrade/DistUpgradeController.py:942
msgid "Do you want to start the upgrade?"
msgstr "¿Desea iniciar la actualización?"

#: ../DistUpgrade/DistUpgradeController.py:1008
msgid "Upgrade canceled"
msgstr "Actualización cancelada"

#: ../DistUpgrade/DistUpgradeController.py:1009
msgid ""
"The upgrade will cancel now and the original system state will be restored. "
"You can resume the upgrade at a later time."
msgstr ""
"La actualización se cancelará y el sistema se restaurará a su estado "
"original. Podrá continuar con la actualización más adelante."

#: ../DistUpgrade/DistUpgradeController.py:1015
#: ../DistUpgrade/DistUpgradeController.py:1149
msgid "Could not download the upgrades"
msgstr "No se pueden descargar los paquetes de actualización"

#: ../DistUpgrade/DistUpgradeController.py:1016
msgid ""
"The upgrade has aborted. Please check your Internet connection or "
"installation media and try again. All files downloaded so far have been kept."
msgstr ""
"Se ha interrumpido la actualización. Por favor, compruebe su conexión a "
"Internet o el medio de instalación e inténtelo de nuevo. Todos los archivos "
"descargados se han guardado."

#. FIXME: strings are not good, but we are in string freeze
#. currently
#: ../DistUpgrade/DistUpgradeController.py:1100
#: ../DistUpgrade/DistUpgradeController.py:1137
#: ../DistUpgrade/DistUpgradeController.py:1242
msgid "Error during commit"
msgstr "Error al confirmar"

#. generate a new cache
#: ../DistUpgrade/DistUpgradeController.py:1102
#: ../DistUpgrade/DistUpgradeController.py:1139
#: ../DistUpgrade/DistUpgradeController.py:1281
msgid "Restoring original system state"
msgstr "Restaurando el estado original del sistema"

#: ../DistUpgrade/DistUpgradeController.py:1103
#: ../DistUpgrade/DistUpgradeController.py:1118
#: ../DistUpgrade/DistUpgradeController.py:1140
msgid "Could not install the upgrades"
msgstr "No se puede instalar la actualización"

#. invoke the frontend now and show a error message
#: ../DistUpgrade/DistUpgradeController.py:1108
msgid ""
"The upgrade has aborted. Your system could be in an unusable state. A "
"recovery will run now (dpkg --configure -a)."
msgstr ""
"Actualización cancelada. Su sistema podría estar en un estado inestable. "
"Restaurando (dpkg --configure -a)."

#: ../DistUpgrade/DistUpgradeController.py:1113
#, python-format
msgid ""
"\n"
"\n"
"Please report this bug in a browser at http://bugs.launchpad.net/ubuntu/"
"+source/update-manager/+filebug and attach the files in /var/log/dist-"
"upgrade/ to the bug report.\n"
"%s"
msgstr ""
"\n"
"\n"
"Por favor, informe de este error usando un navegador en http://bugs.launchpad"
".net/ubuntu/+source/update-manager/+filebug y adjunte al informe los "
"archivos de /var/log/dist-upgrade/.\n"
"%s"

#: ../DistUpgrade/DistUpgradeController.py:1150
msgid ""
"The upgrade has aborted. Please check your Internet connection or "
"installation media and try again. "
msgstr ""
"Actualización cancelada. Por favor, compruebe su conexión a Internet o el "
"medio de instalación e inténtelo de nuevo. "

#: ../DistUpgrade/DistUpgradeController.py:1230
msgid "Remove obsolete packages?"
msgstr "¿Eliminar paquetes obsoletos?"

#: ../DistUpgrade/DistUpgradeController.py:1231
#: ../DistUpgrade/DistUpgrade.ui.h:8
msgid "_Keep"
msgstr "_Mantener"

#: ../DistUpgrade/DistUpgradeController.py:1231
msgid "_Remove"
msgstr "_Eliminar"

#: ../DistUpgrade/DistUpgradeController.py:1243
msgid ""
"A problem occurred during the clean-up. Please see the below message for "
"more information. "
msgstr ""
"Ha habido un problema durante la limpieza. Consulte los siguientes mensajes "
"para obtener más información. "

#. FIXME: instead of error out, fetch and install it
#. here
#: ../DistUpgrade/DistUpgradeController.py:1319
msgid "Required depends is not installed"
msgstr "Dependencias requeridas no instaladas"

#: ../DistUpgrade/DistUpgradeController.py:1320
#, python-format
msgid "The required dependency '%s' is not installed. "
msgstr "La dependencia requerida \"%s\" no está instalada. "

#. sanity check (check for ubuntu-desktop, brokenCache etc)
#. then open the cache (again)
#: ../DistUpgrade/DistUpgradeController.py:1588
#: ../DistUpgrade/DistUpgradeController.py:1653
msgid "Checking package manager"
msgstr "Comprobando el gestor de paquetes"

#: ../DistUpgrade/DistUpgradeController.py:1593
msgid "Unable to get group configuration package, Please check if the configuration package exists in the software source repository."
msgstr ""
"No se ha podido obtener el paquete de configuración de grupo. Por favor, "
"compruebe si el paquete de configuración de grupo existe en los repositorios "
"de orígenes de software."

#: ../DistUpgrade/DistUpgradeController.py:1593
msgid "Unable to install group configuration package, Please check the configuration package related dependencies."
msgstr ""
"No se ha podido instalar el paquete de configuración de grupo. Por favor, "
"compruebe las dependencias relacionadas con el paquete de configuración de "
"grupo."

msgid "Unable to perform priority upgrade, please check the dependency related to the priority upgrade package."
msgstr ""
"No se ha podido realizar la actualización prioritaria. Por favor, compruebe "
"las dependencias relacionadas con los paquetes de actualización prioritaria."

#: ../DistUpgrade/DistUpgradeController.py:1594
msgid ""
"Preparing the system for the upgrade failed so a bug reporting process is "
