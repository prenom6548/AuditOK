#: ../DistUpgrade/DistUpgradeViewText.py:173
#, python-format
msgid "No longer supported: %s\n"
msgstr "ບໍ່ຮອງຮັບອີກຕໍ່ໄປ: %s\n"

#: ../DistUpgrade/DistUpgradeViewText.py:178
#, python-format
msgid "Remove: %s\n"
msgstr "ລຶບອອກ: %s\n"

#: ../DistUpgrade/DistUpgradeViewText.py:188
#, python-format
msgid "Install: %s\n"
msgstr "ຕິດຕັ້ງ: %s\n"

#: ../DistUpgrade/DistUpgradeViewText.py:193
#, python-format
msgid "Upgrade: %s\n"
msgstr "ອັບເກຣດ: %s\n"

#: ../DistUpgrade/DistUpgradeViewText.py:210
msgid "Continue [Yn] "
msgstr "ສືບຕໍ່ [Yn] "

#: ../DistUpgrade/DistUpgradeViewText.py:231
msgid ""
"To finish the upgrade, a restart is required.\n"
"If you select 'y' the system will be restarted."
msgstr ""
"ເພື່ອໃຫ້ການອັບເກຣດສຳເລັດ, ຈຳເປັນຕ້ອງເລີ່ມຕົ້ນລະບົບໃໝ່.\n"
"ຖ້າທ່ານເລືອກ \"ແມ່ນ\", ລະບົບຈະເລີ່ມຕົ້ນໃໝ່."

#: ../DistUpgrade/DistUpgrade.ui.h:1
msgid "_Cancel Upgrade"
msgstr "ຍົກເລີກການອັບເກຣດ"

#: ../DistUpgrade/DistUpgrade.ui.h:2
msgid "_Resume Upgrade"
msgstr "ສືບຕໍ່ການອັບເກຣດ (_R)"

#: ../DistUpgrade/DistUpgrade.ui.h:3
msgid ""
"<b><big>Cancel the running upgrade?</big></b>\n"
"\n"
"The system could be in an unusable state if you cancel the upgrade. You are "
"strongly adviced to resume the upgrade."
msgstr ""
"<b><big>ຍົກເລີກການອັບເກຣດທີ່ກຳລັງດຳເນີນການຢູ່?</big></b>\n"
"ຖ້າທ່ານຍົກເລີກການອັບເກຣດ, ລະບົບອາດຈະບໍ່ສະຖຽນ. ແນະນຳໃຫ້ທ່ານສືບຕໍ່ການອັບເກຣດ."

#: ../DistUpgrade/DistUpgrade.ui.h:6
msgid "_Start Upgrade"
msgstr "ເລີ່ມຕົ້ນການອັບເກຣດ (_R)"

#: ../DistUpgrade/DistUpgrade.ui.h:9
msgid "_Replace"
msgstr "ແທນທີ່ (_R)"

#: ../DistUpgrade/DistUpgrade.ui.h:10
msgid "Difference between the files"
msgstr "ຄວາມແຕກຕ່າງລະຫວ່າງໄຟລ໌"

#: ../DistUpgrade/DistUpgrade.ui.h:11
msgid "_Report Bug"
msgstr "ລາຍງານຂໍ້ຜິດພາດ (_R)"

#: ../DistUpgrade/DistUpgrade.ui.h:12
msgid "_Continue"
msgstr "ສືບຕໍ່ (_C)"

#: ../DistUpgrade/DistUpgrade.ui.h:13
msgid "<b><big>Start the upgrade?</big></b>"
msgstr "<b><big>ເລີ່ມຕົ້ນການອັບເກຣດ?</big></b>"

#: ../DistUpgrade/DistUpgrade.ui.h:15
msgid ""
"<b><big>Restart the system to complete the upgrade</big></b>\n"
"\n"
"Please save your work before continuing."
msgstr ""
"<b><big>ເລີ່ມຕົ້ນລະບົບໃໝ່ເພື່ອໃຫ້ການອັບເກຣດສຳເລັດ</big></b>\n"
"\n"
"ກະລຸນາບັນທຶກວຽກຂອງທ່ານກ່ອນສືບຕໍ່."

#: ../DistUpgrade/DistUpgrade.ui.h:18
msgid "Distribution Upgrade"
msgstr "ການອັບເກຣດລຸ້ນ"

#: ../DistUpgrade/DistUpgrade.ui.h:19
msgid "<b><big>Upgrading Ubuntu to version 12.10</big></b>"
msgstr "<b><big>ກຳລັງອັບເກຣດ Ubuntu ເປັນເວີຊັນ 12.10</big></b>"

#: ../DistUpgrade/DistUpgrade.ui.h:20
msgid "    "
msgstr ""

#: ../DistUpgrade/DistUpgrade.ui.h:22
msgid "Setting new software channels"
msgstr "ກຳນົດແຫຼ່ງຊອບແວໃໝ່"

#: ../DistUpgrade/DistUpgrade.ui.h:24
msgid "Restarting the computer"
msgstr "ລະບົບກຳລັງເລີ່ມຕົ້ນໃໝ່"

#: ../DistUpgrade/DistUpgrade.ui.h:27
msgid "Terminal"
msgstr "ເທີມິນອນ"

#: ../UpdateManager/backend/InstallBackendSynaptic.py:64
msgid "Please wait, this can take some time."
msgstr "ກະລຸນາລໍຖ້າ, ຈະໃຊ້ເວລາໜ້ອຍໜຶ່ງ."

