msgid "You need to be root to run this application"
msgstr "Для запуска необходимы права root"

msgid "There is an exception in the update package."
msgstr "Обнаружена ошибка в пакетах обновлений!"

msgid "You request the removal of a system-essential package."
msgstr "Вы запросили удаление пакета, необходимого для работы системы."

msgid "This update cannot detect the upgradeable package."
msgstr ""
"В ходе этого обновления не удалось обнаружить пакеты, доступные для "
"обновления."

msgid "read important list failed"
msgstr ""
"Не удалось прочитать список доступных обновлений, повторите попытку позже"

msgid "Priority Upgrade Package being updated"
msgstr "Обновление конфигурации групп"

msgid "Exceptions of Priority Upgrade."
msgstr "Ошибка при приоритетном обновлении"

msgid "Due to the presence of deleted packages."
msgstr "Из-за наличия удаляемых пакетов"

msgid "The system update configuration file is read abnormally, please check if the system update configuration file format is correct."
msgstr ""
"Ошибка при чтении файла конфигурации обновлений системы, пожалуйста, "
"проверьте правильность формата файла конфигурации обновлений системы."

msgid "Installation progress: "
msgstr "Ход установки: "

msgid "Installation successful, about to shut down"
msgstr "Установка успешно завершена, выполняется выключение"

msgid "Installation failed, about to shut down"
msgstr "Ошибка установки, выполняется выключение"

msgid "groups JSON ConfigPkgs install failed"
msgstr "Не удалось установить файл конфигурации групп"

msgid "Installtion timeout to exit Due to inactivity"
msgstr "Выход из-за тайм-аута установки"

msgid "Command execution error"
msgstr "Ошибка выполнения команды"

msgid "Unsupported architecture"
msgstr "Несоответствие архитектуры"

msgid "Other Error"
msgstr "Другие ошибки"

msgid "dependency is not satisfied"
msgstr "Неудовлетворенные зависимости"

msgid "dependency is not satisfied will download"
msgstr "Неудовлетворенные зависимости"

msgid "Disk space is insufficient, please clean the disk and then upgrade"
msgstr "Недостаточно места на диске, очистите диск перед обновлением."

msgid "Network anomaly, can't check for updates!"
msgstr "Сбой сети, невозможно проверить наличие обновлений!"

msgid "Check for update exceptions!"
msgstr "Сбой при проверке обновлений!"

msgid "Check for update exceptions,fix system APT environment error."
msgstr "Сбой при проверке обновлений, ошибка при восстановлении среды APT."

msgid "The system APT environment is abnormal, please check the system APT environment."
msgstr "Сбой при восстановлении среды APT, проверьте среду APT системы."

msgid "Priority upgrade status exception."
msgstr "Ошибка состояния приоритетного обновления."

msgid "Upgrade configuration acquisition exception."
msgstr "Ошибка получения конфигурации обновления."

msgid "Please check your network connection and retry."
msgstr "Проверьте подключение к сети и повторите попытку."

msgid "Please check your source list and retry."
msgstr "Проверьте список источников и повторите попытку."

msgid "Checking network connection"
msgstr "Проверка подключения к сети"

msgid "Updating Source Template"
msgstr "Обновление шаблонов источников"

msgid "Update Manager upgrade is complete, please restart the setting panel before performing the system update."
msgstr ""
"Обновление менеджера обновлений завершено. Перезапустите «Настройки» — "
"«Обновление» перед обновлением системы."

msgid "Uninstallation completed"
msgstr "Удаление завершено."

msgid "Package validation failed and installation was rejected."
msgstr "Сбой проверки пакета, установка отклонена."

msgid "Other tasks are being updated and upgraded, please uninstall them later."
msgstr "Выполняются другие задачи по обновлению, повторите удаление позже."

