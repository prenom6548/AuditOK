msgid ""
"After your package information was updated the essential package '%s' can "
"not be found anymore so a bug reporting process is being started."
msgstr ""
"После обновления информации о пакетах не удалось найти базовый пакет "
"(essential) «%s», поэтому будет запущен процесс отчета об ошибке."

msgid "<b><big>Upgrading Ubuntu to version 12.04</big></b>"
msgstr "<b><big>Выполняется обновление Ubuntu до версии 12.04</big></b>"

msgid "%(count)s update has been selected."
msgid_plural "%(count)s updates have been selected."
msgstr[0] "Выбрано %(count)s обновлений."
