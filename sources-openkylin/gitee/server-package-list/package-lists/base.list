# openKylin 最小公共基础软件包。
#
# 该列表由 normal 和 server 镜像共同依赖，不作为直接发布的镜像 profile。
# 此处只保留各类镜像共同需要的系统基础能力。

# 核心系统
base-files
base-passwd
bash
bsdutils
coreutils
dash
debianutils
diffutils
dpkg
e2fsprogs
findutils
grep
gzip
hostname
init-system-helpers
init
libc-bin
login
mount
ncurses-base
ncurses-bin
perl-base
sed
tar
util-linux
debconf
debconf-i18n
kmod
locales
lsb-release
mawk
passwd
tzdata
udev
systemd
systemd-sysv
xz-utils

# 启动与 initramfs 支撑
busybox-static
cpio

# 基础网络
ca-certificates
dhcpcd-base
iproute2
iputils-ping
netbase
openssh-client
systemd-resolved
curl

# 包管理、安全与访问控制基础
adduser
gnupg
libpam-systemd
sudo

# 基础运维
apt
dbus
file
less
logrotate
media-types
procps
psmisc
sensible-utils
time
vim
